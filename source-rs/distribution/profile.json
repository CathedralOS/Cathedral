{
  "name": "Cathedral desktop",
  "stage": "early-boot",
  "boot_entry": "kernel/boot/uefi/main.rs",
  "boot_package": "cathedral-boot-uefi",
  "target": "x86_64-unknown-uefi",
  "user_programs": {
    "hello": {
      "package": "cathedral-hello",
      "entry": "distribution/lab/hello/main.rs",
      "target": "x86_64-unknown-none"
    },
    "ipc": {
      "package": "cathedral-ipc-lab",
      "entry": "distribution/lab/ipc/main.rs",
      "target": "x86_64-unknown-none"
    },
    "supervision": {
      "package": "cathedral-supervision-lab",
      "entry": "distribution/lab/supervision/main.rs",
      "target": "x86_64-unknown-none"
    },
    "display_service": {
      "package": "cathedral-display-service",
      "entry": "platform/services/display/main.rs",
      "target": "x86_64-unknown-none",
      "features": [
        "lab"
      ]
    },
    "display_lab": {
      "package": "cathedral-display-lab",
      "entry": "distribution/lab/display/main.rs",
      "target": "x86_64-unknown-none"
    },
    "memory": {
      "package": "cathedral-memory-lab",
      "entry": "distribution/lab/memory/main.rs",
      "target": "x86_64-unknown-none"
    },
    "rendering": {
      "package": "cathedral-rendering-lab",
      "entry": "distribution/lab/rendering/main.rs",
      "target": "x86_64-unknown-none",
      "features": [
        "guest"
      ]
    },
    "shared_memory": {
      "package": "cathedral-shared-memory-lab",
      "entry": "distribution/lab/shared-memory/main.rs",
      "target": "x86_64-unknown-none"
    },
    "devices": {
      "package": "cathedral-device-lab",
      "entry": "distribution/lab/devices/main.rs",
      "target": "x86_64-unknown-none"
    }
  },
  "startup": {
    "label_migration": "distribution/migrations/readable-labels.txt",
    "app_close_migration": true,
    "initial": {
      "package": "cathedral-desktop",
      "entry": "distribution/desktop/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "shell"
      ]
    },
    "executables": [
      {
        "package": "cathedral-startup-recovery",
        "entry": "distribution/desktop/recovery/main.rs",
        "target": "x86_64-unknown-none"
      }
    ],
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1129270608,
        "framebuffer": true,
        "shared_pages": 512,
        "ipc_channels": 0
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1296127058,
        "keyboard": true,
        "features": [
          "absolute-pointer"
        ],
        "ipc_channels": 0
      },
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 0,
        "ipc_channels": 84,
        "private_pages": 640,
        "shared_pages": 1280
      },
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "ipc_channels": 0,
        "private_pages": 128,
        "shared_pages": 64
      }
    ],
    "links": [
      [
        3,
        4
      ],
      [
        3,
        4
      ]
    ],
    "dynamic_tasks": 10,
    "programs": [
      {
        "package": "cathedral-chooser",
        "entry": "distribution/applications/chooser/main.rs",
        "target": "x86_64-unknown-none",
        "display_title": "LAUNCHER"
      },
      {
        "folder": true
      },
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "inside": 1,
        "display_title": "USER TEMPLATE"
      },
      {
        "package": "cathedral-chooser",
        "entry": "distribution/applications/chooser/main.rs",
        "target": "x86_64-unknown-none",
        "inside": 2,
        "display_title": "LAUNCHER"
      },
      {
        "package": "cathedral-notes",
        "entry": "distribution/applications/notes/main.rs",
        "target": "x86_64-unknown-none",
        "inside": 2,
        "display_title": "NOTES"
      },
      {
        "package": "cathedral-colors",
        "entry": "distribution/applications/colors/main.rs",
        "target": "x86_64-unknown-none",
        "inside": 2,
        "display_title": "COLORS"
      }
    ],
    "realm_programs": [
      {
        "path": "Background",
        "package": "cathedral-background",
        "entry": "distribution/applications/background/main.rs",
        "target": "x86_64-unknown-none",
        "display_title": "BACKGROUND"
      },
      {
        "path": "Split",
        "package": "cathedral-split",
        "entry": "distribution/applications/split/main.rs",
        "target": "x86_64-unknown-none",
        "display_title": "SPLIT"
      },
      {
        "path": "Split/Notes",
        "package": "cathedral-notes",
        "entry": "distribution/applications/notes/main.rs",
        "target": "x86_64-unknown-none",
        "display_title": "NOTES"
      }
    ]
  }
}
