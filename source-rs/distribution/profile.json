{
  "name": "Cathedral Rust lab",
  "stage": "early-boot",
  "boot_entry": "kernel/boot/uefi/main.rs",
  "boot_package": "cathedral-boot-uefi",
  "target": "x86_64-unknown-uefi",
  "user_programs": {
    "hello": {
      "package": "cathedral-hello",
      "entry": "distribution/programs/hello/main.rs",
      "target": "x86_64-unknown-none"
    },
    "ipc": {
      "package": "cathedral-ipc-lab",
      "entry": "distribution/programs/ipc/main.rs",
      "target": "x86_64-unknown-none"
    },
    "supervision": {
      "package": "cathedral-supervision-lab",
      "entry": "distribution/programs/supervision/main.rs",
      "target": "x86_64-unknown-none"
    },
    "display_service": {
      "package": "cathedral-display-service",
      "entry": "platform/services/display/main.rs",
      "target": "x86_64-unknown-none",
      "features": [
        "lab"
      ]
    },
    "display_lab": {
      "package": "cathedral-display-lab",
      "entry": "distribution/programs/display/main.rs",
      "target": "x86_64-unknown-none"
    }
  },
  "startup": {
    "initial": {
      "package": "cathedral-init",
      "entry": "distribution/init/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true
    },
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "framebuffer": true,
        "argument": 0,
        "clock": true
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "keyboard": true,
        "clock": true
      },
      {
        "package": "cathedral-status",
        "entry": "distribution/applications/status/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true
      },
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true
      }
    ],
    "links": [
      [
        3,
        1
      ],
      [
        3,
        2
      ],
      [
        3,
        4
      ]
    ]
  }
}
