{
  "name": "Cathedral desktop",
  "stage": "early-boot",
  "boot_entry": "kernel/boot/uefi/main.rs",
  "boot_package": "cathedral-boot-uefi",
  "target": "x86_64-unknown-uefi",
  "user_programs": {
    "hello": {
      "package": "cathedral-hello",
      "entry": "distribution/lab/hello/main.rs",
      "target": "x86_64-unknown-none"
    },
    "ipc": {
      "package": "cathedral-ipc-lab",
      "entry": "distribution/lab/ipc/main.rs",
      "target": "x86_64-unknown-none"
    },
    "supervision": {
      "package": "cathedral-supervision-lab",
      "entry": "distribution/lab/supervision/main.rs",
      "target": "x86_64-unknown-none"
    },
    "display_service": {
      "package": "cathedral-display-service",
      "entry": "platform/services/display/main.rs",
      "target": "x86_64-unknown-none",
      "features": [
        "lab"
      ]
    },
    "display_lab": {
      "package": "cathedral-display-lab",
      "entry": "distribution/lab/display/main.rs",
      "target": "x86_64-unknown-none"
    },
    "memory": {
      "package": "cathedral-memory-lab",
      "entry": "distribution/lab/memory/main.rs",
      "target": "x86_64-unknown-none"
    },
    "rendering": {
      "package": "cathedral-rendering-lab",
      "entry": "distribution/lab/rendering/main.rs",
      "target": "x86_64-unknown-none",
      "features": [
        "guest"
      ]
    },
    "shared_memory": {
      "package": "cathedral-shared-memory-lab",
      "entry": "distribution/lab/shared-memory/main.rs",
      "target": "x86_64-unknown-none"
    },
    "devices": {
      "package": "cathedral-device-lab",
      "entry": "distribution/lab/devices/main.rs",
      "target": "x86_64-unknown-none"
    }
  },
  "startup": {
    "initial": {
      "package": "cathedral-desktop",
      "entry": "distribution/desktop/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "shell"
      ]
    },
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1129270608,
        "framebuffer": true,
        "shared_pages": 64
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1296127058,
        "keyboard": true
      },
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 0,
        "ipc_channels": 20,
        "private_pages": 128,
        "shared_pages": 128
      },
      {
        "package": "cathedral-database-storage",
        "entry": "platform/services/storage/database/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "ipc_channels": 0,
        "private_pages": 64,
        "shared_pages": 8
      }
    ],
    "links": [
      [
        3,
        4
      ],
      [
        3,
        4
      ]
    ],
    "executables": [
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 0
      },
      {
        "package": "cathedral-notes",
        "entry": "distribution/applications/notes/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 2
      },
      {
        "package": "cathedral-desktop",
        "entry": "distribution/desktop/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 2,
        "features": [
          "shell"
        ]
      }
    ],
    "dynamic_tasks": 4
  }
}
