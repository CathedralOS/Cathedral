// Compile-only acceptance root that makes every named x86 exception vector
// visible in the typed artifact without establishing an interrupt entry.

use {facts}/x86_exception_vectors.omg;

data X86ExceptionVectorSnapshot {
    vector_count: u8;
    vectors: [u8; 32];
}

machine x86_exception_vector_snapshot() -> X86ExceptionVectorSnapshot {
    X86ExceptionVectorSnapshot {
        vector_count: |x86_exception_vectors|::X86_EXCEPTION_VECTOR_COUNT,
        vectors: [
            |x86_exception_vectors|::X86_EXCEPTION_DIVIDE_ERROR,
            |x86_exception_vectors|::X86_EXCEPTION_DEBUG,
            |x86_exception_vectors|::X86_EXCEPTION_NON_MASKABLE_INTERRUPT,
            |x86_exception_vectors|::X86_EXCEPTION_BREAKPOINT,
            |x86_exception_vectors|::X86_EXCEPTION_OVERFLOW,
            |x86_exception_vectors|::X86_EXCEPTION_BOUND_RANGE_EXCEEDED,
            |x86_exception_vectors|::X86_EXCEPTION_INVALID_OPCODE,
            |x86_exception_vectors|::X86_EXCEPTION_DEVICE_NOT_AVAILABLE,
            |x86_exception_vectors|::X86_EXCEPTION_DOUBLE_FAULT,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_09,
            |x86_exception_vectors|::X86_EXCEPTION_INVALID_TSS,
            |x86_exception_vectors|::X86_EXCEPTION_SEGMENT_NOT_PRESENT,
            |x86_exception_vectors|::X86_EXCEPTION_STACK_SEGMENT_FAULT,
            |x86_exception_vectors|::X86_EXCEPTION_GENERAL_PROTECTION,
            |x86_exception_vectors|::X86_EXCEPTION_PAGE_FAULT,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_15,
            |x86_exception_vectors|::X86_EXCEPTION_X87_FLOATING_POINT,
            |x86_exception_vectors|::X86_EXCEPTION_ALIGNMENT_CHECK,
            |x86_exception_vectors|::X86_EXCEPTION_MACHINE_CHECK,
            |x86_exception_vectors|::X86_EXCEPTION_SIMD_FLOATING_POINT,
            |x86_exception_vectors|::X86_EXCEPTION_VIRTUALIZATION,
            |x86_exception_vectors|::X86_EXCEPTION_CONTROL_PROTECTION,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_22,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_23,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_24,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_25,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_26,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_27,
            |x86_exception_vectors|::AMD_EXCEPTION_HYPERVISOR_INJECTION,
            |x86_exception_vectors|::AMD_EXCEPTION_VMM_COMMUNICATION,
            |x86_exception_vectors|::AMD_EXCEPTION_SECURITY,
            |x86_exception_vectors|::X86_EXCEPTION_RESERVED_31
        ],
    }
}

data Main {
}

machine Main::main(&mut self) {
}
