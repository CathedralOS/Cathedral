{
  "name": "Private notes through recursive matrices",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-desktop",
      "entry": "distribution/desktop/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "notes"
      ]
    },
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1129270608,
        "framebuffer": true,
        "shared_pages": 64
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1296127058,
        "keyboard": true
      },
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 0,
        "ipc_channels": 20,
        "private_pages": 128,
        "shared_pages": 128
      },
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "ipc_channels": 0,
        "private_pages": 128,
        "shared_pages": 64
      }
    ],
    "links": [
      [
        3,
        4
      ],
      [
        3,
        4
      ]
    ],
    "executables": [
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 0
      },
      {
        "package": "cathedral-notes",
        "entry": "distribution/applications/notes/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 2
      }
    ],
    "dynamic_tasks": 4
  }
}
