{
  "name": "Independent three-peer matrix with no stock desktop dependency",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "target": "x86_64-unknown-none",
      "clock": true,
      "package": "cathedral-matrix-composition-lab",
      "entry": "distribution/lab/matrix-composition/main.rs",
      "ipc_channels": 1
    },
    "launches": [
      {
        "target": "x86_64-unknown-none",
        "clock": true,
        "package": "cathedral-three-peer-matrix",
        "entry": "distribution/lab/matrix-composition/matrix/main.rs",
        "ipc_channels": 11
      },
      {
        "target": "x86_64-unknown-none",
        "clock": true,
        "package": "cathedral-matrix-composition-lab",
        "entry": "distribution/lab/matrix-composition/main.rs",
        "argument": 1
      },
      {
        "target": "x86_64-unknown-none",
        "clock": true,
        "package": "cathedral-matrix-composition-lab",
        "entry": "distribution/lab/matrix-composition/main.rs",
        "argument": 1
      },
      {
        "target": "x86_64-unknown-none",
        "clock": true,
        "package": "cathedral-matrix-composition-lab",
        "entry": "distribution/lab/matrix-composition/main.rs",
        "argument": 1
      }
    ],
    "links": []
  }
}
