{
  "name": "Private revision pins, reclamation and bulk reads",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-objects-lab",
      "entry": "distribution/lab/objects/main.rs",
      "target": "x86_64-unknown-none",
      "features": [
        "retention"
      ]
    },
    "launches": [
      {
        "package": "cathedral-database-storage",
        "entry": "platform/services/storage/database/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "private_pages": 64,
        "shared_pages": 4
      },
      {
        "package": "cathedral-objects-lab",
        "entry": "distribution/lab/objects/main.rs",
        "target": "x86_64-unknown-none",
        "private_pages": 4,
        "argument": 1,
        "features": [
          "retention"
        ],
        "shared_pages": 4
      },
      {
        "package": "cathedral-objects-lab",
        "entry": "distribution/lab/objects/main.rs",
        "target": "x86_64-unknown-none",
        "private_pages": 4,
        "argument": 1,
        "features": [
          "retention"
        ],
        "shared_pages": 4
      }
    ],
    "links": [
      [
        2,
        1
      ],
      [
        3,
        1
      ]
    ]
  }
}
