{
  "name": "Private revision pins, reclamation and bulk reads",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-objects-lab",
      "entry": "distribution/lab/objects/main.rs",
      "target": "x86_64-unknown-none",
      "features": [
        "retention"
      ],
      "clock": true,
      "private_pages": 1,
      "shared_pages": 1,
      "ipc_channels": 1
    },
    "launches": [
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "private_pages": 83,
        "shared_pages": 7,
        "ipc_channels": 3
      },
      {
        "package": "cathedral-objects-lab",
        "entry": "distribution/lab/objects/main.rs",
        "target": "x86_64-unknown-none",
        "private_pages": 5,
        "argument": 1,
        "features": [
          "retention"
        ],
        "shared_pages": 5,
        "clock": true,
        "ipc_channels": 1
      },
      {
        "package": "cathedral-objects-lab",
        "entry": "distribution/lab/objects/main.rs",
        "target": "x86_64-unknown-none",
        "private_pages": 5,
        "argument": 1,
        "features": [
          "retention"
        ],
        "shared_pages": 5,
        "clock": true,
        "ipc_channels": 1
      }
    ],
    "links": [
      [
        2,
        1
      ],
      [
        3,
        1
      ]
    ]
  }
}
