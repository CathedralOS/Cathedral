{
  "name": "Cathedral integrated matrix-owned desktop",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-matrix-lab",
      "entry": "distribution/lab/matrix/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "desktop"
      ]
    },
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1129270608,
        "framebuffer": true,
        "shared_pages": 4
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1296127058,
        "keyboard": true
      },
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1398034258,
        "ipc_channels": 20,
        "private_pages": 4,
        "shared_pages": 8
      },
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "ipc_channels": 0
      }
    ],
    "links": [
      [
        3,
        4
      ],
      [
        3,
        4
      ]
    ],
    "executables": [
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 0
      },
      {
        "package": "cathedral-matrix-lab",
        "entry": "distribution/lab/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 2,
        "features": [
          "desktop"
        ]
      }
    ],
    "dynamic_tasks": 4
  }
}
