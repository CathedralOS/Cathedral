{
  "name": "Executable-authorized dynamic process admission",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-channels-lab",
      "entry": "distribution/lab/channels/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "ipc_channels": 8,
      "cpu_budget_us": 50000,
      "private_pages": 16,
      "shared_pages": 16,
      "features": [
        "dynamic-admission"
      ]
    },
    "launches": [
      {
        "package": "cathedral-channels-lab",
        "entry": "distribution/lab/channels/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1,
        "ipc_channels": 0,
        "features": [
          "dynamic-admission"
        ]
      },
      {
        "package": "cathedral-channels-lab",
        "entry": "distribution/lab/channels/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 9,
        "ipc_channels": 0,
        "features": [
          "dynamic-admission"
        ]
      }
    ],
    "dynamic_tasks": 5
  }
}
