{
  "name": "Cathedral recursive matrix storage delegation",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-desktop",
      "entry": "distribution/desktop/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "storage-lab"
      ],
      "private_pages": 2,
      "shared_pages": 2,
      "ipc_channels": 2
    },
    "launches": [
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 0,
        "ipc_channels": 28,
        "shared_pages": 345,
        "private_pages": 25
      },
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1,
        "ipc_channels": 11,
        "shared_pages": 14,
        "private_pages": 6
      },
      {
        "package": "cathedral-desktop",
        "entry": "distribution/desktop/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1,
        "features": [
          "storage-lab"
        ],
        "private_pages": 4,
        "shared_pages": 4,
        "ipc_channels": 3
      },
      {
        "package": "cathedral-desktop",
        "entry": "distribution/desktop/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1,
        "features": [
          "storage-lab"
        ],
        "private_pages": 4,
        "shared_pages": 4,
        "ipc_channels": 3
      },
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "private_pages": 131,
        "shared_pages": 67,
        "ipc_channels": 3
      }
    ],
    "links": [
      [
        1,
        5
      ],
      [
        1,
        5
      ]
    ],
    "dynamic_tasks": 2,
    "programs": [
      {
        "package": "cathedral-desktop",
        "entry": "distribution/desktop/main.rs",
        "target": "x86_64-unknown-none",
        "features": [
          "storage-lab"
        ]
      }
    ]
  }
}
