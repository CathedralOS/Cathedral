{
  "name": "Database matrix recovery and timing proof",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-desktop",
      "entry": "distribution/desktop/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "desktop",
        "database-probes",
        "trace-storage"
      ]
    },
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1129270608,
        "framebuffer": true,
        "shared_pages": 4
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1296127058,
        "keyboard": true
      },
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1398034258,
        "ipc_channels": 20,
        "private_pages": 4,
        "shared_pages": 8,
        "features": [
          "trace-storage"
        ]
      },
      {
        "package": "cathedral-database-storage",
        "entry": "platform/services/storage/database/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "ipc_channels": 0,
        "features": [
          "catalog",
          "recovery-lab",
          "trace-storage"
        ],
        "private_pages": 64
      }
    ],
    "links": [
      [
        3,
        4
      ],
      [
        3,
        4
      ]
    ],
    "executables": [
      {
        "package": "cathedral-matrix-service",
        "entry": "platform/services/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 0,
        "features": [
          "trace-storage"
        ]
      },
      {
        "package": "cathedral-desktop",
        "entry": "distribution/desktop/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 2,
        "features": [
          "desktop",
          "database-probes",
          "trace-storage"
        ]
      }
    ],
    "dynamic_tasks": 4
  }
}
