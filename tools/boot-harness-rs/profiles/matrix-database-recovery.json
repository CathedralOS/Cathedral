{
  "name": "Database matrix recovery and timing proof",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-desktop",
      "entry": "distribution/desktop/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "desktop",
        "database-probes",
        "trace-storage"
      ]
    },
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1129270608,
        "framebuffer": true,
        "shared_pages": 5,
        "private_pages": 1,
        "ipc_channels": 1
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1296127058,
        "keyboard": true,
        "private_pages": 1,
        "shared_pages": 1,
        "ipc_channels": 1
      },
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 0,
        "ipc_channels": 24,
        "private_pages": 20,
        "shared_pages": 12,
        "features": [
          "trace-storage"
        ]
      },
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "ipc_channels": 2,
        "features": [
          "recovery-lab",
          "trace-storage"
        ],
        "private_pages": 130,
        "shared_pages": 66
      }
    ],
    "links": [
      [
        3,
        4
      ],
      [
        3,
        4
      ]
    ],
    "executables": [
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 0,
        "features": [
          "trace-storage"
        ]
      },
      {
        "package": "cathedral-desktop",
        "entry": "distribution/desktop/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 2,
        "features": [
          "desktop",
          "database-probes",
          "trace-storage"
        ]
      }
    ],
    "dynamic_tasks": 4
  }
}
