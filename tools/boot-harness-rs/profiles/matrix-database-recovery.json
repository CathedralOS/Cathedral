{
  "name": "Database matrix recovery and timing proof",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-desktop",
      "entry": "distribution/desktop/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true,
      "argument": 0,
      "features": [
        "desktop",
        "database-probes",
        "trace-storage"
      ],
      "private_pages": 4,
      "shared_pages": 3,
      "ipc_channels": 8
    },
    "launches": [
      {
        "package": "cathedral-display-service",
        "entry": "platform/services/display/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1129270608,
        "framebuffer": true,
        "shared_pages": 6,
        "private_pages": 2,
        "ipc_channels": 2
      },
      {
        "package": "cathedral-input-service",
        "entry": "platform/services/input/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1296127058,
        "keyboard": true,
        "private_pages": 2,
        "shared_pages": 2,
        "ipc_channels": 2
      },
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 0,
        "ipc_channels": 37,
        "private_pages": 33,
        "shared_pages": 25,
        "features": [
          "trace-storage"
        ]
      },
      {
        "package": "cathedral-storage-service",
        "entry": "platform/services/storage/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "disk": true,
        "ipc_channels": 3,
        "features": [
          "recovery-lab",
          "trace-storage"
        ],
        "private_pages": 131,
        "shared_pages": 67
      }
    ],
    "links": [
      [
        3,
        4
      ],
      [
        3,
        4
      ]
    ],
    "executables": [
      {
        "package": "cathedral-stock-matrix",
        "entry": "distribution/matrix/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 0,
        "features": [
          "trace-storage"
        ]
      },
      {
        "package": "cathedral-desktop",
        "entry": "distribution/desktop/main.rs",
        "target": "x86_64-unknown-none",
        "argument": 2,
        "features": [
          "desktop",
          "database-probes",
          "trace-storage"
        ]
      }
    ],
    "dynamic_tasks": 4
  }
}
