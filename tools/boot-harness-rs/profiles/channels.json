{
  "name": "Ordinary IPC, startup bundles and recursive child admission",
  "target": "x86_64-unknown-uefi",
  "boot_package": "cathedral-boot-uefi",
  "startup": {
    "initial": {
      "package": "cathedral-channels-lab",
      "entry": "distribution/lab/channels/main.rs",
      "target": "x86_64-unknown-none",
      "clock": true
    },
    "launches": [
      {
        "package": "cathedral-channels-lab",
        "entry": "distribution/lab/channels/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1
      },
      {
        "package": "cathedral-channels-lab",
        "entry": "distribution/lab/channels/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 2
      },
      {
        "package": "cathedral-channels-lab",
        "entry": "distribution/lab/channels/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 2
      },
      {
        "package": "cathedral-channels-lab",
        "entry": "distribution/lab/channels/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 2
      },
      {
        "package": "cathedral-channels-lab",
        "entry": "distribution/lab/channels/main.rs",
        "target": "x86_64-unknown-none",
        "clock": true,
        "argument": 1
      }
    ]
  }
}
