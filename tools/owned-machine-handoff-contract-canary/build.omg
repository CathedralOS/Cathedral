// Isolated source frontier for the already-implemented owned-machine handoff.

use {core}/memory/extent.omg as cathedral_extent;
use {omega}/language/core/extent.omg;

machine build(b: &mut Build) {
    b.depend("boot", path("boot"));
    b.depend("uefi", path("uefi"));
    b.depend("core", path("core"));
    b.accept_boundary<|extent|::ExtentRootProvider>();
    b.select_provider<|extent|::ExtentRootProvider, |cathedral_extent|::CathedralExtentRootProvider>();
    b.freestanding = true;
}
