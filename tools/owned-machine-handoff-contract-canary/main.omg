// Compile-only host for own_machine. This supplies its existing receiver
// shape without importing or selecting the transitional firmware entry.

use {boot}/firmware/ownership/ownership.omg;
use {uefi}/uefi.omg;
use {uefi}/boot_services.omg;
use {omega}/language/core/assembly.omg;
use {omega}/language/core/extent.omg;

data Main {
    boot_svc: |boot_services|::BootServices;
    memory: |extent|::ExtentRootProvider;
    map_buf: |ownership|::UefiMemoryMapStorage;
}

machine Main::main(&mut self) {
}
