// Isolated checked frontier for Cathedral's zero page-table-page validator.

machine build(builder: &mut Build) {
    builder.package("cathedral-x86-empty-page-table-canary");
    builder.depend_as("core", Source::Path {
        location: "core"
    });
    builder.depend_as("facts", Source::Path {
        location: "facts"
    });
    builder.freestanding = true;
}
