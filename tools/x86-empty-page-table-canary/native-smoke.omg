// Native hard-root smoke: importing Cathedral's complete x86 page-table core
// must lower even though this host-only entry point exercises no paging authority.

use {std}/console.omg;
use {arch}/isa/x86_64/memory/memory.omg;

data Main {
    console: |console|::Console;
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
