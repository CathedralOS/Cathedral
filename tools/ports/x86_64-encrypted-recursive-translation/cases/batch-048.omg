let configured0:bool=|memory_encryption|::configure(&mut profile,|memory_encryption|::Configuration::SharedBit { position:63 });
let observation:|recursive_translation|::RecursiveTranslation=|encrypted_recursive_translation|::translate_words(&profile,18446623141479811772,4097,8193,16385,18446744073709551615);
