use {x86}/encrypted_recursive_translation.omg;
use {x86}/recursive_translation.omg;
use {x86}/translation.omg;
use {x86}/memory_encryption.omg;
machine scenario()->i32 {
 let profile:|memory_encryption|::State=|memory_encryption|::initial();
 let configured:bool=|memory_encryption|::configure(&mut profile,|memory_encryption|::Configuration::EncryptedBit {position:47});
 let observation:|recursive_translation|::RecursiveTranslation=|encrypted_recursive_translation|::translate_words(&profile,140737488355328,129,0,0,128);
 transition observation {
  |recursive_translation|::RecursiveTranslation::Result {value} -> check(value)
  _ -> (1)
 }
 state check(value:|translation|::Translation) {
  transition value in |translation|::Translation::InvalidVirtual {true -> (0) _ -> (1)}
 }
}
const RESULT:i32=scenario();
machine require_success(value:i32) requires value==0; {}
data Main{}
machine Main::main(&mut self){require_success(RESULT);}
