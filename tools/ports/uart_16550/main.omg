machine test_baud() -> bool {
    baud_to_integer(baud_from_integer(115200)) == 115200 &&
    baud_to_integer(baud_from_integer(57600)) == 57600 &&
    baud_to_integer(baud_from_integer(38400)) == 38400 &&
    baud_to_integer(baud_from_integer(9600)) == 9600 &&
    baud_to_integer(baud_from_integer(4800)) == 4800 &&
    baud_to_integer(baud_from_integer(2400)) == 2400 &&
    baud_to_integer(baud_from_integer(1200)) == 1200 &&
    baud_to_integer(baud_from_integer(600)) == 600 &&
    baud_to_integer(baud_from_integer(300)) == 300 &&
    baud_to_integer(baud_from_integer(150)) == 150 &&
    baud_to_integer(baud_from_integer(110)) == 110 &&
    baud_to_integer(baud_from_integer(0)) == 0 &&
    baud_to_integer(baud_from_integer(42)) == 42 &&
    baud_to_integer(baud_from_integer(4294967295)) == 4294967295 &&
    baud_to_integer(BaudRate::Custom { value: 9600 }) == 9600 &&
    calc_baud_rate(1843200, 1, false, 0).value == 115200 &&
    calc_divisor(1843200, 115200, false, 0).value == 1 &&
    calc_frequency(115200, 1, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 2, false, 0).value == 57600 &&
    calc_divisor(1843200, 57600, false, 0).value == 2 &&
    calc_frequency(57600, 2, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 3, false, 0).value == 38400 &&
    calc_divisor(1843200, 38400, false, 0).value == 3 &&
    calc_frequency(38400, 3, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 6, false, 0).value == 19200 &&
    calc_divisor(1843200, 19200, false, 0).value == 6 &&
    calc_frequency(19200, 6, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 9, false, 0).value == 12800 &&
    calc_divisor(1843200, 12800, false, 0).value == 9 &&
    calc_frequency(12800, 9, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 12, false, 0).value == 9600 &&
    calc_divisor(1843200, 9600, false, 0).value == 12 &&
    calc_frequency(9600, 12, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 15, false, 0).value == 7680 &&
    calc_divisor(1843200, 7680, false, 0).value == 15 &&
    calc_frequency(7680, 15, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 16, false, 0).value == 7200 &&
    calc_divisor(1843200, 7200, false, 0).value == 16 &&
    calc_frequency(7200, 16, false, 0).value == 1843200 &&
    calc_baud_rate(1843200, 73, false, 0).error == 4 &&
    calc_divisor(1843200, 7211, false, 0).error == 4 &&
    calc_divisor(1843200, 0, false, 0).error == 1 &&
    calc_baud_rate(0, 1, false, 0).error == 1 &&
    calc_baud_rate(1843200, 1, true, 16).error == 2 &&
    calc_baud_rate(1843200, 0xffffffff, false, 0).error == 3 &&
    calc_divisor(0xfffffff0, 1, false, 0).error == 5 &&
    calc_frequency(0xffffffff, 1, false, 0).error == 3 &&
    calc_baud_rate(1843200, 1, true, 1).value == 57600 &&
    calc_baud_rate(1843200, 1, false, 0xffffffff).value == 115200
}
machine test_bits() -> bool {
    fifo_trigger_level(set_fifo_trigger_level(0, 0)) == 0 &&
    set_fifo_trigger_level(0, 0) == 0 &&
    word_length(set_word_length(0, 0)) == 0 &&
    fifo_from_raw_bits(fifo_to_raw_bits(0)) == 0 &&
    word_from_raw_bits(word_to_raw_bits(0)) == 0 &&
    word_to_integer(word_from_integer(5)) == 5 &&
    fifo_trigger_level(set_fifo_trigger_level(0, 1)) == 1 &&
    set_fifo_trigger_level(0, 1) == 64 &&
    word_length(set_word_length(0, 1)) == 1 &&
    fifo_from_raw_bits(fifo_to_raw_bits(1)) == 1 &&
    word_from_raw_bits(word_to_raw_bits(1)) == 1 &&
    word_to_integer(word_from_integer(6)) == 6 &&
    fifo_trigger_level(set_fifo_trigger_level(0, 2)) == 2 &&
    set_fifo_trigger_level(0, 2) == 128 &&
    word_length(set_word_length(0, 2)) == 2 &&
    fifo_from_raw_bits(fifo_to_raw_bits(2)) == 2 &&
    word_from_raw_bits(word_to_raw_bits(2)) == 2 &&
    word_to_integer(word_from_integer(7)) == 7 &&
    fifo_trigger_level(set_fifo_trigger_level(0, 3)) == 3 &&
    set_fifo_trigger_level(0, 3) == 192 &&
    word_length(set_word_length(0, 3)) == 3 &&
    fifo_from_raw_bits(fifo_to_raw_bits(3)) == 3 &&
    word_from_raw_bits(word_to_raw_bits(3)) == 3 &&
    word_to_integer(word_from_integer(8)) == 8 &&
    parity(set_parity(0, 0)) == 0 &&
    set_parity(0, 0) == 0 &&
    parity_from_raw_bits(parity_to_raw_bits(0)) == 0 &&
    parity(set_parity(0, 1)) == 1 &&
    set_parity(0, 1) == 8 &&
    parity_from_raw_bits(parity_to_raw_bits(1)) == 1 &&
    parity(set_parity(0, 3)) == 3 &&
    set_parity(0, 3) == 24 &&
    parity_from_raw_bits(parity_to_raw_bits(3)) == 3 &&
    parity(set_parity(0, 5)) == 5 &&
    set_parity(0, 5) == 40 &&
    parity_from_raw_bits(parity_to_raw_bits(5)) == 5 &&
    parity(set_parity(0, 7)) == 7 &&
    set_parity(0, 7) == 56 &&
    parity_from_raw_bits(parity_to_raw_bits(7)) == 7 &&
    parity_from_raw_bits(0) == 0 &&
    parity_from_raw_bits(2) == 0 &&
    parity_from_raw_bits(4) == 0 &&
    parity_from_raw_bits(6) == 0 &&
    set_fifo_trigger_level(9, 2) == 137 &&
    set_word_length(132, 2) == 134 &&
    set_word_length(set_word_length(0, 3), 0) == 0 &&
    set_parity(131, 3) == 155 &&
    set_parity(set_parity(0, 7), 1) == 8 &&
    set_parity(set_parity(0, 1), 3) == 24 &&
    pdf(set_pdf(0, 0)) == 0 &&
    pdf(set_pdf(0, 15)) == 15 &&
    set_pdf(16, 5) == 21 &&
    pdf(set_pdf(set_pdf(0, 15), 0)) == 0 &&
    parity_from_raw_bits(249) == 1 &&
    parity_from_raw_bits(251) == 3 &&
    fifo_from_raw_bits(252) == 0 &&
    fifo_from_raw_bits(253) == 1 &&
    set_fifo_trigger_level(set_fifo_trigger_level(0, 3), 1) == 64 &&
    word_from_integer(0) == 3 &&
    word_from_integer(4) == 3 &&
    word_from_integer(9) == 3 &&
    word_from_integer(255) == 3 &&
    !has_error(0) &&
    !has_error(1) &&
    !has_error(32) &&
    !has_error(64) &&
    has_error(2) &&
    has_error(4) &&
    has_error(8) &&
    has_error(16) &&
    has_error(128)
}
machine test_interrupt() -> bool {
    interrupt_type(1) == 255 &&
    interrupt_type(255) == 255 &&
    interrupt_type(15) == 255 &&
    interrupt_type(8) == 255 &&
    interrupt_type(6) == 3 &&
    interrupt_type(4) == 2 &&
    interrupt_type(12) == 6 &&
    interrupt_type(2) == 1 &&
    interrupt_type(0) == 0 &&
    interrupt_type(14) == 7 &&
    interrupt_type(10) == 5 &&
    interrupt_type(244) == interrupt_type(4) &&
    interrupt_priority(3) < interrupt_priority(2) &&
    interrupt_priority(2) == interrupt_priority(6) &&
    interrupt_priority(1) < interrupt_priority(0) &&
    interrupt_priority(7) < interrupt_priority(5) &&
    has_pending_interrupt(0) &&
    !has_pending_interrupt(255)
}
machine test_constructors() -> bool {
    valid_port_base(1016) &&
    valid_port_base(65527) &&
    valid_port_base(65528) &&
    !valid_port_base(65529) &&
    !valid_port_base(65535) &&
    valid_mmio_base(4096, 1) &&
    valid_mmio_base(4096, 2) &&
    valid_mmio_base(4096, 4) &&
    valid_mmio_base(4096, 8) &&
    valid_mmio_base(4096, 16) &&
    valid_mmio_base(4096, 32) &&
    valid_mmio_base(4096, 64) &&
    valid_mmio_base(4096, 128) &&
    !valid_mmio_base(4096, 0) &&
    !valid_mmio_base(4096, 3) &&
    !valid_mmio_base(4096, 5) &&
    !valid_mmio_base(4096, 6) &&
    !valid_mmio_base(4096, 7) &&
    !valid_mmio_base(4096, 9) &&
    !valid_mmio_base(0, 1) &&
    valid_mmio_base(0xfffffffffffffff8, 1) &&
    !valid_mmio_base(0xfffffffffffffff9, 1) &&
    register_offset(7, 32).valid &&
    !register_offset(7, 64).valid &&
    !register_offset(8, 1).valid &&
    register_offset(7, 4).bytes == 28
}
machine test_io_decisions() -> bool {
    ready_to_receive(1) &&
    !ready_to_receive(32) &&
    ready_to_send(0, 0, 0, false) == 1 &&
    ready_to_send(32, 0, 0, false) == 0 &&
    ready_to_send(32, 0, 0, true) == 2 &&
    ready_to_send(32, 16, 0, true) == 0 &&
    ready_to_send(32, 0, 16, true) == 0 &&
    try_send_error(2) == 1 &&
    check_connected(0) == 1 &&
    check_connected(32) == 2 &&
    check_connected(48) == 0 &&
    send_count(0, true, 0) == 0 &&
    send_count(17, true, 0) == 16 &&
    send_count(17, false, 0) == 1 &&
    send_count(16, true, 2) == 0 &&
    tty_byte(8).length == 3 &&
    tty_byte(127).bytes[1] == 32 &&
    tty_byte(10).bytes[0] == 13 &&
    tty_byte(10).bytes[1] == 10 &&
    tty_byte(65).bytes[0] == 65 &&
    tty_byte(65).length == 1
}
machine test_plans() -> bool {
    init_step(default_config(), (calc_divisor(1843200, 38400, false, 0).value & 65535) as u16, 7).value == 3 &&
    register_offset(0, 1).bytes == 0 && register_offset(0, 4).bytes == 0 &&
    init_step(default_config(), 12, 0).kind == 1 &&
    init_step(default_config(), 12, 0).offset == 7 &&
    init_step(default_config(), 12, 0).value == 66 &&
    init_step(default_config(), 12, 1).kind == 3 &&
    init_step(default_config(), 12, 1).offset == 7 &&
    init_step(default_config(), 12, 1).value == 66 &&
    init_step(default_config(), 12, 2).kind == 1 &&
    init_step(default_config(), 12, 2).offset == 7 &&
    init_step(default_config(), 12, 2).value == 115 &&
    init_step(default_config(), 12, 3).kind == 3 &&
    init_step(default_config(), 12, 3).offset == 7 &&
    init_step(default_config(), 12, 3).value == 115 &&
    init_step(default_config(), 12, 4).kind == 1 &&
    init_step(default_config(), 12, 4).offset == 3 &&
    init_step(default_config(), 12, 4).value == 0 &&
    init_step(default_config(), 12, 5).kind == 1 &&
    init_step(default_config(), 12, 5).offset == 1 &&
    init_step(default_config(), 12, 5).value == 0 &&
    init_step(default_config(), 12, 6).kind == 1 &&
    init_step(default_config(), 12, 6).offset == 3 &&
    init_step(default_config(), 12, 6).value == 128 &&
    init_step(default_config(), 12, 7).kind == 1 &&
    init_step(default_config(), 12, 7).offset == 0 &&
    init_step(default_config(), 12, 7).value == 12 &&
    init_step(default_config(), 12, 8).kind == 1 &&
    init_step(default_config(), 12, 8).offset == 1 &&
    init_step(default_config(), 12, 8).value == 0 &&
    init_step(default_config(), 12, 9).kind == 1 &&
    init_step(default_config(), 12, 9).offset == 3 &&
    init_step(default_config(), 12, 9).value == 0 &&
    init_step(default_config(), 12, 10).kind == 1 &&
    init_step(default_config(), 12, 10).offset == 3 &&
    init_step(default_config(), 12, 10).value == 3 &&
    init_step(default_config(), 12, 11).kind == 1 &&
    init_step(default_config(), 12, 11).offset == 2 &&
    init_step(default_config(), 12, 11).value == 199 &&
    init_step(default_config(), 12, 12).kind == 1 &&
    init_step(default_config(), 12, 12).offset == 4 &&
    init_step(default_config(), 12, 12).value == 11 &&
    init_step(default_config(), 12, 13).kind == 4 &&
    init_step(default_config(), 12, 13).offset == 5 &&
    init_step(default_config(), 12, 13).value == 64 &&
    init_step(default_config(), 12, 14).kind == 2 &&
    init_step(default_config(), 12, 14).offset == 5 &&
    init_step(default_config(), 12, 14).value == 0 &&
    init_step(default_config(), 12, 15).kind == 2 &&
    init_step(default_config(), 12, 15).offset == 6 &&
    init_step(default_config(), 12, 15).value == 0 &&
    init_step(default_config(), 12, 16).kind == 1 &&
    init_step(default_config(), 12, 16).offset == 1 &&
    init_step(default_config(), 12, 16).value == 0 &&
    init_step(default_config(), 12, 17).kind == 0 &&
    init_step(default_config(), 12, 17).offset == 0 &&
    init_step(default_config(), 12, 17).value == 0 &&
    action_response(init_step(default_config(), 12, 1), 0) == 2 &&
    action_response(init_step(default_config(), 12, 1), 66) == 0 &&
    action_response(init_step(default_config(), 12, 13), 32) == 1 &&
    action_response(init_step(default_config(), 12, 13), 64) == 0 &&
    divisor_step(1, 3).value == 131 &&
    divisor_step(4, 131).value == 131 &&
    send_probe(1, false, 32, 0).kind == 0 &&
    send_probe(1, true, 32, 0).offset == 4 &&
    send_probe(2, true, 32, 16).kind == 0 &&
    send_probe(2, true, 32, 0).offset == 6 &&
    dump_divisor(ConfigRegisterDump { dll: 0x34, dlm: 0x12 }) == 0x1234 &&
    dump_baud_rate(ConfigRegisterDump { dll: 3 }, default_config()).value == 38400
}
machine test_result() -> i32 {
    transition test_baud() && test_bits() && test_interrupt() && test_constructors() && test_io_decisions() && test_plans() { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
