use {uart}/baud.omg;
use {uart}/errors.omg;
use {uart}/enum_ordinals.omg;
// SPDX-License-Identifier: MIT OR Apache-2.0
// Adapted upstream spec/constructor tests plus local boundary/plan cases.
use {uart}/pure.omg;
use {uart}/plans.omg;
machine test_baud() -> bool {
    |baud|::baud_to_integer(|baud|::baud_from_integer(115200)) == 115200 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(57600)) == 57600 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(38400)) == 38400 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(9600)) == 9600 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(4800)) == 4800 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(2400)) == 2400 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(1200)) == 1200 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(600)) == 600 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(300)) == 300 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(150)) == 150 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(110)) == 110 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(0)) == 0 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(42)) == 42 &&
    |baud|::baud_to_integer(|baud|::baud_from_integer(4294967295)) == 4294967295 &&
    |baud|::baud_to_integer(|baud|::BaudRate::Custom { value: 9600 }) == 9600 &&
    |pure|::calc_baud_rate(1843200, 1, false, 0).value == 115200 &&
    |pure|::calc_divisor(1843200, 115200, false, 0).value == 1 &&
    |pure|::calc_frequency(115200, 1, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 2, false, 0).value == 57600 &&
    |pure|::calc_divisor(1843200, 57600, false, 0).value == 2 &&
    |pure|::calc_frequency(57600, 2, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 3, false, 0).value == 38400 &&
    |pure|::calc_divisor(1843200, 38400, false, 0).value == 3 &&
    |pure|::calc_frequency(38400, 3, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 6, false, 0).value == 19200 &&
    |pure|::calc_divisor(1843200, 19200, false, 0).value == 6 &&
    |pure|::calc_frequency(19200, 6, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 9, false, 0).value == 12800 &&
    |pure|::calc_divisor(1843200, 12800, false, 0).value == 9 &&
    |pure|::calc_frequency(12800, 9, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 12, false, 0).value == 9600 &&
    |pure|::calc_divisor(1843200, 9600, false, 0).value == 12 &&
    |pure|::calc_frequency(9600, 12, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 15, false, 0).value == 7680 &&
    |pure|::calc_divisor(1843200, 7680, false, 0).value == 15 &&
    |pure|::calc_frequency(7680, 15, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 16, false, 0).value == 7200 &&
    |pure|::calc_divisor(1843200, 7200, false, 0).value == 16 &&
    |pure|::calc_frequency(7200, 16, false, 0).value == 1843200 &&
    |pure|::calc_baud_rate(1843200, 73, false, 0).error == 4 &&
    |pure|::calc_divisor(1843200, 7211, false, 0).error == 4 &&
    |pure|::calc_divisor(1843200, 0, false, 0).error == 1 &&
    |pure|::calc_baud_rate(0, 1, false, 0).error == 1 &&
    |pure|::calc_baud_rate(1843200, 1, true, 16).error == 2 &&
    |pure|::calc_baud_rate(1843200, 0xffffffff, false, 0).error == 3 &&
    |pure|::calc_divisor(0xfffffff0, 1, false, 0).error == 5 &&
    |pure|::calc_frequency(0xffffffff, 1, false, 0).error == 3 &&
    |pure|::calc_baud_rate(1843200, 1, true, 1).value == 57600 &&
    |pure|::calc_baud_rate(1843200, 1, false, 0xffffffff).value == 115200
}
machine test_bits() -> bool {
    |pure|::fifo_trigger_level(|pure|::set_fifo_trigger_level(0, 0)) == 0 &&
    |pure|::set_fifo_trigger_level(0, 0) == 0 &&
    |pure|::word_length(|pure|::set_word_length(0, 0)) == 0 &&
    |pure|::fifo_from_raw_bits(|pure|::fifo_to_raw_bits(0)) == 0 &&
    |pure|::word_from_raw_bits(|pure|::word_to_raw_bits(0)) == 0 &&
    |pure|::word_to_integer(|pure|::word_from_integer(5)) == 5 &&
    |pure|::fifo_trigger_level(|pure|::set_fifo_trigger_level(0, 1)) == 1 &&
    |pure|::set_fifo_trigger_level(0, 1) == 64 &&
    |pure|::word_length(|pure|::set_word_length(0, 1)) == 1 &&
    |pure|::fifo_from_raw_bits(|pure|::fifo_to_raw_bits(1)) == 1 &&
    |pure|::word_from_raw_bits(|pure|::word_to_raw_bits(1)) == 1 &&
    |pure|::word_to_integer(|pure|::word_from_integer(6)) == 6 &&
    |pure|::fifo_trigger_level(|pure|::set_fifo_trigger_level(0, 2)) == 2 &&
    |pure|::set_fifo_trigger_level(0, 2) == 128 &&
    |pure|::word_length(|pure|::set_word_length(0, 2)) == 2 &&
    |pure|::fifo_from_raw_bits(|pure|::fifo_to_raw_bits(2)) == 2 &&
    |pure|::word_from_raw_bits(|pure|::word_to_raw_bits(2)) == 2 &&
    |pure|::word_to_integer(|pure|::word_from_integer(7)) == 7 &&
    |pure|::fifo_trigger_level(|pure|::set_fifo_trigger_level(0, 3)) == 3 &&
    |pure|::set_fifo_trigger_level(0, 3) == 192 &&
    |pure|::word_length(|pure|::set_word_length(0, 3)) == 3 &&
    |pure|::fifo_from_raw_bits(|pure|::fifo_to_raw_bits(3)) == 3 &&
    |pure|::word_from_raw_bits(|pure|::word_to_raw_bits(3)) == 3 &&
    |pure|::word_to_integer(|pure|::word_from_integer(8)) == 8 &&
    |pure|::parity(|pure|::set_parity(0, 0)) == 0 &&
    |pure|::set_parity(0, 0) == 0 &&
    |pure|::parity_from_raw_bits(|pure|::parity_to_raw_bits(0)) == 0 &&
    |pure|::parity(|pure|::set_parity(0, 1)) == 1 &&
    |pure|::set_parity(0, 1) == 8 &&
    |pure|::parity_from_raw_bits(|pure|::parity_to_raw_bits(1)) == 1 &&
    |pure|::parity(|pure|::set_parity(0, 3)) == 3 &&
    |pure|::set_parity(0, 3) == 24 &&
    |pure|::parity_from_raw_bits(|pure|::parity_to_raw_bits(3)) == 3 &&
    |pure|::parity(|pure|::set_parity(0, 5)) == 5 &&
    |pure|::set_parity(0, 5) == 40 &&
    |pure|::parity_from_raw_bits(|pure|::parity_to_raw_bits(5)) == 5 &&
    |pure|::parity(|pure|::set_parity(0, 7)) == 7 &&
    |pure|::set_parity(0, 7) == 56 &&
    |pure|::parity_from_raw_bits(|pure|::parity_to_raw_bits(7)) == 7 &&
    |pure|::parity_from_raw_bits(0) == 0 &&
    |pure|::parity_from_raw_bits(2) == 0 &&
    |pure|::parity_from_raw_bits(4) == 0 &&
    |pure|::parity_from_raw_bits(6) == 0 &&
    |pure|::set_fifo_trigger_level(9, 2) == 137 &&
    |pure|::set_word_length(132, 2) == 134 &&
    |pure|::set_word_length(|pure|::set_word_length(0, 3), 0) == 0 &&
    |pure|::set_parity(131, 3) == 155 &&
    |pure|::set_parity(|pure|::set_parity(0, 7), 1) == 8 &&
    |pure|::set_parity(|pure|::set_parity(0, 1), 3) == 24 &&
    |pure|::pdf(|pure|::set_pdf(0, 0)) == 0 &&
    |pure|::pdf(|pure|::set_pdf(0, 15)) == 15 &&
    |pure|::set_pdf(16, 5) == 21 &&
    |pure|::pdf(|pure|::set_pdf(|pure|::set_pdf(0, 15), 0)) == 0 &&
    |pure|::parity_from_raw_bits(249) == 1 &&
    |pure|::parity_from_raw_bits(251) == 3 &&
    |pure|::fifo_from_raw_bits(252) == 0 &&
    |pure|::fifo_from_raw_bits(253) == 1 &&
    |pure|::set_fifo_trigger_level(|pure|::set_fifo_trigger_level(0, 3), 1) == 64 &&
    |pure|::word_from_integer(0) == 3 &&
    |pure|::word_from_integer(4) == 3 &&
    |pure|::word_from_integer(9) == 3 &&
    |pure|::word_from_integer(255) == 3 &&
    !|pure|::has_error(0) &&
    !|pure|::has_error(1) &&
    !|pure|::has_error(32) &&
    !|pure|::has_error(64) &&
    |pure|::has_error(2) &&
    |pure|::has_error(4) &&
    |pure|::has_error(8) &&
    |pure|::has_error(16) &&
    |pure|::has_error(128)
}
machine test_interrupt() -> bool {
    |pure|::interrupt_type(1) == 255 &&
    |pure|::interrupt_type(255) == 255 &&
    |pure|::interrupt_type(15) == 255 &&
    |pure|::interrupt_type(8) == 255 &&
    |pure|::interrupt_type(6) == 3 &&
    |pure|::interrupt_type(4) == 2 &&
    |pure|::interrupt_type(12) == 6 &&
    |pure|::interrupt_type(2) == 1 &&
    |pure|::interrupt_type(0) == 0 &&
    |pure|::interrupt_type(14) == 7 &&
    |pure|::interrupt_type(10) == 5 &&
    |pure|::interrupt_type(244) == |pure|::interrupt_type(4) &&
    |pure|::interrupt_priority(3) < |pure|::interrupt_priority(2) &&
    |pure|::interrupt_priority(2) == |pure|::interrupt_priority(6) &&
    |pure|::interrupt_priority(1) < |pure|::interrupt_priority(0) &&
    |pure|::interrupt_priority(7) < |pure|::interrupt_priority(5) &&
    |pure|::has_pending_interrupt(0) &&
    !|pure|::has_pending_interrupt(255)
}
machine test_constructors() -> bool {
    |pure|::valid_port_base(1016) &&
    |pure|::valid_port_base(65527) &&
    |pure|::valid_port_base(65528) &&
    !|pure|::valid_port_base(65529) &&
    !|pure|::valid_port_base(65535) &&
    |pure|::valid_mmio_base(4096, 1) &&
    |pure|::valid_mmio_base(4096, 2) &&
    |pure|::valid_mmio_base(4096, 4) &&
    |pure|::valid_mmio_base(4096, 8) &&
    |pure|::valid_mmio_base(4096, 16) &&
    |pure|::valid_mmio_base(4096, 32) &&
    |pure|::valid_mmio_base(4096, 64) &&
    |pure|::valid_mmio_base(4096, 128) &&
    !|pure|::valid_mmio_base(4096, 0) &&
    !|pure|::valid_mmio_base(4096, 3) &&
    !|pure|::valid_mmio_base(4096, 5) &&
    !|pure|::valid_mmio_base(4096, 6) &&
    !|pure|::valid_mmio_base(4096, 7) &&
    !|pure|::valid_mmio_base(4096, 9) &&
    !|pure|::valid_mmio_base(0, 1) &&
    |pure|::valid_mmio_base(0xfffffffffffffff8, 1) &&
    !|pure|::valid_mmio_base(0xfffffffffffffff9, 1) &&
    |pure|::register_offset(7, 32).valid &&
    !|pure|::register_offset(7, 64).valid &&
    !|pure|::register_offset(8, 1).valid &&
    |pure|::register_offset(7, 4).bytes == 28
}
machine test_io_decisions() -> bool {
    |pure|::ready_to_receive(1) &&
    !|pure|::ready_to_receive(32) &&
    |pure|::ready_to_send(0, 0, 0, false) == 1 &&
    |pure|::ready_to_send(32, 0, 0, false) == 0 &&
    |pure|::ready_to_send(32, 0, 0, true) == 2 &&
    |pure|::ready_to_send(32, 16, 0, true) == 0 &&
    |pure|::ready_to_send(32, 0, 16, true) == 0 &&
    |pure|::try_send_error(2) == 1 &&
    |pure|::check_connected(0) == 1 &&
    |pure|::check_connected(32) == 2 &&
    |pure|::check_connected(48) == 0 &&
    |pure|::send_count(0, true, 0) == 0 &&
    |pure|::send_count(17, true, 0) == 16 &&
    |pure|::send_count(17, false, 0) == 1 &&
    |pure|::send_count(16, true, 2) == 0 &&
    |pure|::tty_byte(8).length == 3 &&
    |pure|::tty_byte(127).bytes[1] == 32 &&
    |pure|::tty_byte(10).bytes[0] == 13 &&
    |pure|::tty_byte(10).bytes[1] == 10 &&
    |pure|::tty_byte(65).bytes[0] == 65 &&
    |pure|::tty_byte(65).length == 1
}
machine test_plans() -> bool {
    |plans|::init_step(|pure|::default_config(), (|pure|::calc_divisor(1843200, 38400, false, 0).value & 65535) as u16, 7).value == 3 &&
    |pure|::register_offset(0, 1).bytes == 0 && |pure|::register_offset(0, 4).bytes == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 0).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 0).offset == 7 &&
    |plans|::init_step(|pure|::default_config(), 12, 0).value == 66 &&
    |plans|::init_step(|pure|::default_config(), 12, 1).kind == 3 &&
    |plans|::init_step(|pure|::default_config(), 12, 1).offset == 7 &&
    |plans|::init_step(|pure|::default_config(), 12, 1).value == 66 &&
    |plans|::init_step(|pure|::default_config(), 12, 2).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 2).offset == 7 &&
    |plans|::init_step(|pure|::default_config(), 12, 2).value == 115 &&
    |plans|::init_step(|pure|::default_config(), 12, 3).kind == 3 &&
    |plans|::init_step(|pure|::default_config(), 12, 3).offset == 7 &&
    |plans|::init_step(|pure|::default_config(), 12, 3).value == 115 &&
    |plans|::init_step(|pure|::default_config(), 12, 4).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 4).offset == 3 &&
    |plans|::init_step(|pure|::default_config(), 12, 4).value == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 5).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 5).offset == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 5).value == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 6).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 6).offset == 3 &&
    |plans|::init_step(|pure|::default_config(), 12, 6).value == 128 &&
    |plans|::init_step(|pure|::default_config(), 12, 7).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 7).offset == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 7).value == 12 &&
    |plans|::init_step(|pure|::default_config(), 12, 8).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 8).offset == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 8).value == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 9).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 9).offset == 3 &&
    |plans|::init_step(|pure|::default_config(), 12, 9).value == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 10).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 10).offset == 3 &&
    |plans|::init_step(|pure|::default_config(), 12, 10).value == 3 &&
    |plans|::init_step(|pure|::default_config(), 12, 11).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 11).offset == 2 &&
    |plans|::init_step(|pure|::default_config(), 12, 11).value == 199 &&
    |plans|::init_step(|pure|::default_config(), 12, 12).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 12).offset == 4 &&
    |plans|::init_step(|pure|::default_config(), 12, 12).value == 11 &&
    |plans|::init_step(|pure|::default_config(), 12, 13).kind == 4 &&
    |plans|::init_step(|pure|::default_config(), 12, 13).offset == 5 &&
    |plans|::init_step(|pure|::default_config(), 12, 13).value == 64 &&
    |plans|::init_step(|pure|::default_config(), 12, 14).kind == 2 &&
    |plans|::init_step(|pure|::default_config(), 12, 14).offset == 5 &&
    |plans|::init_step(|pure|::default_config(), 12, 14).value == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 15).kind == 2 &&
    |plans|::init_step(|pure|::default_config(), 12, 15).offset == 6 &&
    |plans|::init_step(|pure|::default_config(), 12, 15).value == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 16).kind == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 16).offset == 1 &&
    |plans|::init_step(|pure|::default_config(), 12, 16).value == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 17).kind == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 17).offset == 0 &&
    |plans|::init_step(|pure|::default_config(), 12, 17).value == 0 &&
    |plans|::action_response(|plans|::init_step(|pure|::default_config(), 12, 1), 0) == 2 &&
    |plans|::action_response(|plans|::init_step(|pure|::default_config(), 12, 1), 66) == 0 &&
    |plans|::action_response(|plans|::init_step(|pure|::default_config(), 12, 13), 32) == 1 &&
    |plans|::action_response(|plans|::init_step(|pure|::default_config(), 12, 13), 64) == 0 &&
    |plans|::divisor_step(1, 3).value == 131 &&
    |plans|::divisor_step(4, 131).value == 131 &&
    |plans|::send_probe(1, false, 32, 0).kind == 0 &&
    |plans|::send_probe(1, true, 32, 0).offset == 4 &&
    |plans|::send_probe(2, true, 32, 16).kind == 0 &&
    |plans|::send_probe(2, true, 32, 0).offset == 6 &&
    |pure|::dump_divisor(|pure|::ConfigRegisterDump { dll: 0x34, dlm: 0x12 }) == 0x1234 &&
    |pure|::dump_baud_rate(|pure|::ConfigRegisterDump { dll: 3 }, |pure|::default_config()).value == 38400
}
machine test_result() -> i32 {
    transition test_baud() && test_bits() && test_interrupt() && test_constructors() && test_io_decisions() && test_plans() { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
