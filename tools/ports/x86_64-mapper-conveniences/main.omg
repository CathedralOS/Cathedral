machine frame_0() -> bool {
let checked: MappedFrameCheck = mapper_conveniences::mapped_frame(8192, 4096);
let observed: MappedFrameCheck = mapper_conveniences::frame_from_translation(Translation::Mapped { frame: 8192, size: 4096, offset: 1, flags: 0 });
frame_is(checked, 8192, 4096) && frame_is(observed, 8192, 4096) && number_is(mapper_conveniences::identity_page(12288, 4096), 12288)
}
machine translation_0_0() -> bool {
let result: NumberResult = mapper_conveniences::translated_address_pinned(Translation::Mapped { frame: 8192, size: 4096, offset: 0, flags: 0 });
number_is(result, 8192)
}
