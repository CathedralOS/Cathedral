use {x86}/memory_encryption.omg;
use {x86}/encrypted_cleanup_ranges.omg;
use {x86}/encrypted_cleanup_recursive.omg;
use {x86}/cleanup_ranges.omg;
use {x86}/cleanup_branch.omg;
use {x86}/recursive_cleanup.omg;
// disabled / False / two-roots-around-self
machine test_result()->i32 {
    let profile: |memory_encryption|::State = |memory_encryption|::initial();
    let words:[u64;4]=[0,0,0,0]; let ids:[u64;4]=[262144,0,0,0]; let others:[bool;4]=[true,false,false,false];
    let cursor:|cleanup_ranges|::Cursor=|encrypted_cleanup_ranges|::begin(549755813888,1099511627776,2);
    let value:|cleanup_ranges|::RangeStep=|encrypted_cleanup_ranges|::step(profile,cursor,&words,&ids,&others);
    let next:u64=value.cursor.next_page; let last:u64=value.cursor.last_page; let budget:u64=value.cursor.budget;
    transition value.has_plan==true && value.cursor.status in |cleanup_ranges|::RangeStatus::Active && next==1099511627776 && last==1099511627776 && budget==1 && value.branch.retire_count==0 && value.branch.write_mask==0 && value.branch.visited==1 && value.branch.outcome in |cleanup_branch|::CleanupOutcome::Ready && value.branch.words[0]==0 && value.branch.words[1]==0 && value.branch.words[2]==0 && value.branch.words[3]==0 && value.branch.frames_to_retire[0]==0 && value.branch.frames_to_retire[1]==0 && value.branch.frames_to_retire[2]==0 {true -> (0) _ -> (1)}
}

const TEST_RESULT:i32=test_result();
machine require_success(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_success(TEST_RESULT);}
