use {x86}/memory_encryption.omg;
use {x86}/encrypted_cleanup_branch.omg;
use {x86}/encrypted_cleanup_ranges.omg;
use {x86}/encrypted_cleanup_recursive.omg;
use {x86}/cleanup_branch.omg;
use {x86}/cleanup_ranges.omg;
use {x86}/recursive_cleanup.omg;
machine test_result()->i32 {
let profile:|memory_encryption|::State=|memory_encryption|::initial();
_ = |memory_encryption|::configure(&mut profile,|memory_encryption|::Configuration::EncryptedBit{position:47});
_ = |memory_encryption|::configure(&mut profile,|memory_encryption|::Configuration::SharedBit{position:48});
let mark:u64=422212465065984;
let first_words:[u64;4]=[65537|mark,131073|mark,196609|mark,0];
let first_ids:[u64;4]=[262144,65536,131072,196608]; let first_others:[bool;4]=[true,false,true,false];
let cursor:|cleanup_ranges|::Cursor=|encrypted_cleanup_ranges|::begin(0,2097152,9);
let first:|cleanup_ranges|::RangeStep=|encrypted_cleanup_ranges|::step(profile,cursor,&first_words,&first_ids,&first_others);
let words:[u64;4]=[65537|mark,131073|mark,327681|mark,0];
let ids:[u64;4]=[262144,65536,131072,458752];let others:[bool;4]=[true,false,false,false];
let second:|cleanup_ranges|::RangeStep=|encrypted_cleanup_ranges|::step(profile,first.cursor,&words,&ids,&others);
transition second.cursor.status {
 |cleanup_ranges|::RangeStatus::CaptureMismatch{expected,supplied} -> checked(&first,&second,expected,supplied)
 _ -> (1)
}
state checked(first:&|cleanup_ranges|::RangeStep,second:&|cleanup_ranges|::RangeStep,expected:u64,supplied:u64) {
 let next:u64=second.cursor.next_page; let budget:u64=second.cursor.budget;
 transition expected==327680 && supplied==458752 && first.branch.retire_count==1 && first.branch.frames_to_retire[0]==196608 && first.branch.write_mask==4 && first.branch.words[2]==0 && second.branch.retire_count==0 && second.branch.write_mask==0 && next==2097152 && budget==8 && second.branch.words[2]==422212465393665 {true -> (0) _ -> (1)}
}
}

const TEST_RESULT:i32=test_result();
machine require_success(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_success(TEST_RESULT);}
