use {x86}/memory_encryption.omg;
use {x86}/encrypted_cleanup_ranges.omg;
use {x86}/encrypted_cleanup_recursive.omg;
use {x86}/cleanup_ranges.omg;
use {x86}/cleanup_branch.omg;
use {x86}/recursive_cleanup.omg;
// shared47 / False / p4-nonpresent
machine test_result()->i32 {
    let profile: |memory_encryption|::State = |memory_encryption|::initial();
    _ = |memory_encryption|::configure(&mut profile, |memory_encryption|::Configuration::SharedBit { position: 47 });
    let words:[u64;4]=[140737488420864,0,0,0]; let ids:[u64;4]=[262144,0,0,0]; let others:[bool;4]=[false,false,false,false];
    let cursor:|cleanup_ranges|::Cursor=|encrypted_cleanup_ranges|::begin(0,0,4);
    let value:|cleanup_ranges|::RangeStep=|encrypted_cleanup_ranges|::step(profile,cursor,&words,&ids,&others);
    let next:u64=value.cursor.next_page; let last:u64=value.cursor.last_page; let budget:u64=value.cursor.budget;
    transition value.has_plan==true && value.cursor.status in |cleanup_ranges|::RangeStatus::Done && next==0 && last==0 && budget==3 && value.branch.retire_count==0 && value.branch.write_mask==0 && value.branch.visited==1 && value.branch.outcome in |cleanup_branch|::CleanupOutcome::Ready && value.branch.words[0]==140737488420864 && value.branch.words[1]==0 && value.branch.words[2]==0 && value.branch.words[3]==0 && value.branch.frames_to_retire[0]==0 && value.branch.frames_to_retire[1]==0 && value.branch.frames_to_retire[2]==0 {true -> (0) _ -> (1)}
}

const TEST_RESULT:i32=test_result();
machine require_success(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_success(TEST_RESULT);}
