use x86::memory_encryption;
use x86::memory_encryption::State;
use x86::memory_encryption::Configuration;
use x86::encrypted_cleanup_ranges;
use x86::encrypted_cleanup_recursive;
use x86::cleanup_ranges::Cursor;
use x86::cleanup_ranges::RangeStep;
use x86::cleanup_ranges::RangeStatus;
use x86::cleanup_branch::CleanupOutcome;
use x86::recursive_cleanup::RecursiveCursor;
use x86::recursive_cleanup::RecursiveStep;
// encrypted12 / False / two-roots-around-self
machine test_result()->i32 {
    let profile: State = memory_encryption::initial();
    _ = memory_encryption::configure(&mut profile, Configuration::EncryptedBit { position: 12 });
    let words:[u64;4]=[327681,393217,458753,0]; let ids:[u64;4]=[262144,327680,393216,458752]; let others:[bool;4]=[false,false,false,false];
    let cursor:Cursor=encrypted_cleanup_ranges::begin(1099511627776,1099511627776,1);
    let value:RangeStep=encrypted_cleanup_ranges::step(profile,cursor,&words,&ids,&others);
    let next:u64=value.cursor.next_page; let last:u64=value.cursor.last_page; let budget:u64=value.cursor.budget;
    transition value.has_plan==true && value.cursor.status in RangeStatus::Done && next==1099511627776 && last==1099511627776 && budget==0 && value.branch.retire_count==3 && value.branch.write_mask==7 && value.branch.visited==4 && value.branch.outcome in CleanupOutcome::Ready && value.branch.words[0]==0 && value.branch.words[1]==0 && value.branch.words[2]==0 && value.branch.words[3]==0 && value.branch.frames_to_retire[0]==458752 && value.branch.frames_to_retire[1]==393216 && value.branch.frames_to_retire[2]==327680 {true -> (0) _ -> (1)}
}

const TEST_RESULT:i32=test_result();
machine require_success(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_success(TEST_RESULT);}
