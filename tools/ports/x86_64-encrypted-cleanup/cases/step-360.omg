use {x86}/memory_encryption.omg;
use {x86}/encrypted_cleanup_ranges.omg;
use {x86}/encrypted_cleanup_recursive.omg;
use {x86}/cleanup_ranges.omg;
use {x86}/cleanup_branch.omg;
use {x86}/recursive_cleanup.omg;
// shared63 / True / two-roots-around-self
machine test_result()->i32 {
    let profile: |memory_encryption|::State = |memory_encryption|::initial();
    _ = |memory_encryption|::configure(&mut profile, |memory_encryption|::Configuration::SharedBit { position: 63 });
    let words:[u64;4]=[129,18446744073709551615,17,33]; let ids:[u64;4]=[0,1,2,3]; let others:[bool;4]=[false,false,false,false];
    let cursor:|recursive_cleanup|::RecursiveCursor=|encrypted_cleanup_recursive|::begin(549755813888,1099511627776,2,1);
    let value:|recursive_cleanup|::RecursiveStep=|encrypted_cleanup_recursive|::step(profile,cursor,&words,&ids,&others);
    let next:u64=value.cursor.range.next_page; let last:u64=value.cursor.range.last_page; let budget:u64=value.cursor.range.budget;
    transition value.has_plan==false && value.cursor.range.status in |cleanup_ranges|::RangeStatus::Active && next==1099511627776 && last==1099511627776 && budget==1 && value.branch.retire_count==0 && value.branch.write_mask==0 && value.branch.visited==0 && value.cursor.recursive_index==1 && value.branch.words[0]==0 && value.branch.words[1]==0 && value.branch.words[2]==0 && value.branch.words[3]==0 && value.branch.frames_to_retire[0]==0 && value.branch.frames_to_retire[1]==0 && value.branch.frames_to_retire[2]==0 {true -> (0) _ -> (1)}
}

const TEST_RESULT:i32=test_result();
machine require_success(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_success(TEST_RESULT);}
