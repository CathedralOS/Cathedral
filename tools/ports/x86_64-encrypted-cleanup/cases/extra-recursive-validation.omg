use {x86}/memory_encryption.omg;
use {x86}/encrypted_cleanup_branch.omg;
use {x86}/encrypted_cleanup_ranges.omg;
use {x86}/encrypted_cleanup_recursive.omg;
use {x86}/cleanup_branch.omg;
use {x86}/cleanup_ranges.omg;
use {x86}/recursive_cleanup.omg;
machine test_result()->i32 {
let profile:|memory_encryption|::State=|memory_encryption|::initial();
_ = |memory_encryption|::configure(&mut profile,|memory_encryption|::Configuration::EncryptedBit{position:47});
_ = |memory_encryption|::configure(&mut profile,|memory_encryption|::Configuration::SharedBit{position:48});
let mark:u64=422212465065984;
let words:[u64;4]=[65537|mark,131073|mark,196609|mark,0];
let ids:[u64;4]=[262144,65536,131072,196608];let others:[bool;4]=[true,false,false,false];
let cursor:|recursive_cleanup|::RecursiveCursor=|encrypted_cleanup_recursive|::begin(0,0,0,511);
let resumed:|recursive_cleanup|::RecursiveCursor=|encrypted_cleanup_recursive|::resume(cursor,18446744073709551615);
let value:|recursive_cleanup|::RecursiveStep=|encrypted_cleanup_recursive|::step(profile,resumed,&words,&ids,&others);
let bad:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::RecursiveCursor{range:|cleanup_ranges|::Cursor{next_page:0,last_page:0,budget:9,status:|cleanup_ranges|::RangeStatus::Active},recursive_index:512};
let invalid:|recursive_cleanup|::RecursiveStep=|encrypted_cleanup_recursive|::step(profile,bad,&words,&ids,&others);
let kept:|recursive_cleanup|::RecursiveCursor=|encrypted_cleanup_recursive|::resume(bad,3);
let budget:u64=value.cursor.range.budget;
transition value.cursor.range.status in |cleanup_ranges|::RangeStatus::Done && budget==18446744073709551614 && value.branch.retire_count==3 && value.cursor.recursive_index==511 && !invalid.has_plan && invalid.cursor.range.status in |cleanup_ranges|::RangeStatus::InvalidRange && kept.range.status in |cleanup_ranges|::RangeStatus::InvalidRange {true -> (0) _ -> (1)}
}

const TEST_RESULT:i32=test_result();
machine require_success(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_success(TEST_RESULT);}
