use x86_values::register_operands;
use x86_values::register_operands::ObservedPriority;
use x86_values::addresses::NumberResult;
use facts::x86_registers::PriorityClass;
use facts::x86_tlb_operands::Pcid;
machine rejected(value: NumberResult) -> bool {
    transition value { NumberResult::Rejected -> (true) _ -> (false) }
}
machine test_result() -> i32 {
    let zero: NumberResult = register_operands::cr8_operand(ObservedPriority::Class { value: PriorityClass { raw: 0 } });
    let large: NumberResult = register_operands::cr8_operand(ObservedPriority::Class { value: PriorityClass { raw: 16 } });
    let maximum: NumberResult = register_operands::cr8_operand(ObservedPriority::Class { value: PriorityClass { raw: 255 } });
    let invalid_frame: NumberResult = register_operands::cr3_pcid_operand(1, Pcid { value: 4095 }, true);
    transition rejected(zero) && rejected(large) && rejected(maximum) && rejected(invalid_frame) {
        true -> (0) _ -> (1)
    }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
