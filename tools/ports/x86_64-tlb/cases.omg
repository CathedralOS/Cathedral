module cases;
use x86_values::tlb_operands;
use x86_values::tlb_operands::PcidResult;
use x86_values::tlb_operands::BroadcastResult;
use x86_values::tlb_operands::BroadcastRequest;
use x86_values::tlb_operands::PageSelection;
use x86_values::tlb_operands::PcidSelection;
use x86_values::tlb_operands::AsidSelection;
use x86_values::tlb_operands::RangeStep;
use facts::x86_tlb_operands::Pcid;
use facts::x86_tlb_operands::InvlpgbLimits;
machine pcid_is(result: PcidResult, expected: u16, valid: bool) -> bool { transition result { PcidResult::Valid { pcid } -> (valid && tlb_operands::pcid_value(pcid) == expected) PcidResult::TooBig { value } -> (!valid && value == expected) } }
pub machine pcid_cases() -> bool { pcid_is(tlb_operands::pcid_new(0), 0, true) && pcid_is(tlb_operands::pcid_new(1), 1, true) && pcid_is(tlb_operands::pcid_new(2), 2, true) && pcid_is(tlb_operands::pcid_new(63), 63, true) && pcid_is(tlb_operands::pcid_new(64), 64, true) && pcid_is(tlb_operands::pcid_new(255), 255, true) && pcid_is(tlb_operands::pcid_new(256), 256, true) && pcid_is(tlb_operands::pcid_new(4094), 4094, true) && pcid_is(tlb_operands::pcid_new(4095), 4095, true) && pcid_is(tlb_operands::pcid_new(4096), 4096, false) && pcid_is(tlb_operands::pcid_new(4097), 4097, false) && pcid_is(tlb_operands::pcid_new(8191), 8191, false) && pcid_is(tlb_operands::pcid_new(32767), 32767, false) && pcid_is(tlb_operands::pcid_new(65535), 65535, false) }
machine regs_are(value: BroadcastResult, rax: u64, ecx: u32, edx: u32) -> bool { transition value { BroadcastResult::Ready { registers } -> (registers.rax == rax && registers.ecx == ecx && registers.edx == edx) _ -> (false) } }
machine broadcast_0() -> bool {
let request: BroadcastRequest = BroadcastRequest { pages: PageSelection::All, pcid: PcidSelection::Any, asid: AsidSelection::Any, include_global: false, final_only: false, include_nested: false };
let result: BroadcastResult = tlb_operands::broadcast_prepare(request, InvlpgbLimits { count_max: 65535, nested: true, nasid: 65536 });
regs_are(result, 0, 0, 0)
}
machine broadcast_1() -> bool {
let request: BroadcastRequest = BroadcastRequest { pages: PageSelection::Pages { address: 305418240, extra_count: 2, stride: 4096 }, pcid: PcidSelection::Any, asid: AsidSelection::Any, include_global: false, final_only: false, include_nested: false };
let result: BroadcastResult = tlb_operands::broadcast_prepare(request, InvlpgbLimits { count_max: 65535, nested: true, nasid: 65536 });
regs_are(result, 305418241, 2, 0)
}
machine broadcast_2() -> bool {
