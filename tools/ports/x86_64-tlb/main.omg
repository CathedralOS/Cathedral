use {facts}/x86_tlb_operands.omg;
use {x86_values}/tlb_operands.omg;
use cases.omg;
machine operand_is(value: |tlb_operands|::InvpcidOperand, expected_kind: u8, pcid: u64, address: u64) -> bool {
    transition value { |tlb_operands|::InvpcidOperand::Ready { kind, descriptor } -> check(kind, descriptor, expected_kind, pcid, address) _ -> (false) }
    state check(actual: u8, descriptor: |x86_tlb_operands|::InvpcidDescriptor, expected_kind: u8, pcid: u64, address: u64) { actual == expected_kind && descriptor.pcid == pcid && descriptor.address == address }
}
machine invpcid_cases() -> bool {
    let a: |tlb_operands|::InvpcidOperand = |tlb_operands|::invpcid_prepare(|tlb_operands|::InvPcidCommand::Address { address: 0x1234, pcid: |x86_tlb_operands|::Pcid { value: 9 } });
    let b: |tlb_operands|::InvpcidOperand = |tlb_operands|::invpcid_prepare(|tlb_operands|::InvPcidCommand::Single { pcid: |x86_tlb_operands|::Pcid { value: 4095 } });
    let c: |tlb_operands|::InvpcidOperand = |tlb_operands|::invpcid_prepare(|tlb_operands|::InvPcidCommand::All);
    let d: |tlb_operands|::InvpcidOperand = |tlb_operands|::invpcid_prepare(|tlb_operands|::InvPcidCommand::AllExceptGlobal);
    let invalid: |tlb_operands|::InvpcidOperand = |tlb_operands|::invpcid_prepare(|tlb_operands|::InvPcidCommand::Address { address: 0x800000000000, pcid: |x86_tlb_operands|::Pcid { value: 0 } });
    let high: u64 = 0xffff800000001234;
    let raw: |x86_tlb_operands|::InvpcidDescriptor = |x86_tlb_operands|::InvpcidDescriptor { pcid: 4095, address: high };
    let bytes: [u8; 16] = |tlb_operands|::encode_invpcid(&raw);
    let decoded: |x86_tlb_operands|::InvpcidDescriptor = |tlb_operands|::decode_invpcid(&bytes);
    operand_is(a, 0, 9, 0x1234) && operand_is(b, 1, 4095, 0) && operand_is(c, 2, 0, 0) && operand_is(d, 3, 0, 0) &&
    invalid in |tlb_operands|::InvpcidOperand::InvalidAddress && bytes[0] == 255 && bytes[1] == 15 && bytes[2] == 0 && bytes[3] == 0 && bytes[4] == 0 && bytes[5] == 0 && bytes[6] == 0 && bytes[7] == 0 &&
    bytes[8] == 52 && bytes[9] == 18 && bytes[10] == 0 && bytes[11] == 0 && bytes[12] == 0 && bytes[13] == 128 && bytes[14] == 255 && bytes[15] == 255 &&
    decoded.pcid == 4095 && decoded.address == high
}
machine limits_are(value: |tlb_operands|::LimitsResult) -> bool {
    transition value { |tlb_operands|::LimitsResult::Observed { limits } -> (limits.count_max == 65535 && limits.nested && limits.nasid == 123456) _ -> (false) }
}
machine asid_error_is(value: |tlb_operands|::BroadcastResult) -> bool {
    transition value { |tlb_operands|::BroadcastResult::AsidOutOfRange { value, nasid } -> (value == 2 && nasid == 2) _ -> (false) }
}
machine count_error_is(value: |tlb_operands|::BroadcastResult) -> bool {
    transition value { |tlb_operands|::BroadcastResult::CountTooLarge { value, maximum } -> (value == 2 && maximum == 1) _ -> (false) }
}
machine privilege_error_is(value: |tlb_operands|::LimitsResult) -> bool {
    transition value { |tlb_operands|::LimitsResult::PrivilegeNotZero { cpl } -> (cpl == 3) _ -> (false) }
}
machine invalid_cases() -> bool {
    let observed: |tlb_operands|::LimitsResult = |tlb_operands|::limits_from_observations(0, 2097160, 4294967295, 123456);
    let denied: |tlb_operands|::LimitsResult = |tlb_operands|::limits_from_observations(3, 8, 1, 1);
    let absent: |tlb_operands|::LimitsResult = |tlb_operands|::limits_from_observations(0, 0, 1, 1);
    let limits: |x86_tlb_operands|::InvlpgbLimits = |x86_tlb_operands|::InvlpgbLimits { count_max: 1, nested: false, nasid: 2 };
    let base: |tlb_operands|::BroadcastRequest = |tlb_operands|::broadcast_default();
    let nested: |tlb_operands|::BroadcastRequest = |tlb_operands|::with_nested(base);
    let asid: |tlb_operands|::BroadcastRequest = |tlb_operands|::with_asid(base, 2);
    let count: |tlb_operands|::BroadcastRequest = |tlb_operands|::with_pages(base, |tlb_operands|::PageSelection::Pages { address: 4096, extra_count: 2, stride: 4096 });
    let giant: |tlb_operands|::BroadcastRequest = |tlb_operands|::with_pages(base, |tlb_operands|::PageSelection::Pages { address: 0, extra_count: 0, stride: 1073741824 });
    let misaligned: |tlb_operands|::BroadcastRequest = |tlb_operands|::with_pages(base, |tlb_operands|::PageSelection::Pages { address: 4097, extra_count: 0, stride: 4096 });
    let n: |tlb_operands|::BroadcastResult = |tlb_operands|::broadcast_prepare(nested, limits);
    let a: |tlb_operands|::BroadcastResult = |tlb_operands|::broadcast_prepare(asid, limits);
    let c: |tlb_operands|::BroadcastResult = |tlb_operands|::broadcast_prepare(count, limits);
    let g: |tlb_operands|::BroadcastResult = |tlb_operands|::broadcast_prepare(giant, limits);
    let m: |tlb_operands|::BroadcastResult = |tlb_operands|::broadcast_prepare(misaligned, limits);
    limits_are(observed) && privilege_error_is(denied) && absent in |tlb_operands|::LimitsResult::Unsupported &&
    n in |tlb_operands|::BroadcastResult::NestedUnsupported && asid_error_is(a) && count_error_is(c) &&
    g in |tlb_operands|::BroadcastResult::InvalidPageGeometry && m in |tlb_operands|::BroadcastResult::InvalidPageGeometry
}
machine test_result() -> i32 {
    transition |cases|::pcid_cases() && |cases|::broadcast_cases() && |cases|::range_cases() && invpcid_cases() && invalid_cases() { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
