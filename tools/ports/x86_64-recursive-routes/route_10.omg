    transition checks::route(CapturedPath { table_ids:[16384, 0, 8192, 0], words:[128, 8193, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[131, 8193, 0, 0], ids:[16384, 0, 8192, 0], indices:[292, 13, 0, 0], writes:1, zeros:0, calls:0, visited:1, code:2, location:1, payload:0, result_word:131, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4096, 8193, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8195, 3221225603, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:7, zeros:0, calls:0, visited:3, code:0, location:2, payload:3221225472, result_word:3221225603, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4225, 8193, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4227, 8193, 0, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:1, zeros:0, calls:0, visited:1, code:2, location:1, payload:0, result_word:4227, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 0, 0], words:[4097, 0, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 0, 0, 0], ids:[16384, 4096, 0, 0], indices:[292, 13, 0, 0], writes:1, zeros:0, calls:1, visited:2, code:6, location:1, payload:0, result_word:0, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 0, 0], words:[4097, 128, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 131, 0, 0], ids:[16384, 4096, 0, 0], indices:[292, 13, 0, 0], writes:3, zeros:0, calls:0, visited:2, code:2, location:1, payload:0, result_word:131, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4097, 8192, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8195, 3221225603, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:7, zeros:0, calls:0, visited:3, code:0, location:2, payload:3221225472, result_word:3221225603, result_write:true }) { true -> (0) _ -> (1) }
