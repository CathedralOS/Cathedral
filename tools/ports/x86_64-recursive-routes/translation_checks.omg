use {x86}/recursive_translation.omg;
use {x86}/translation.omg;
pub machine check(va: u64, p4: u64, p3: u64, p2: u64, p1: u64,
    tag: u64, expected_frame: u64, expected_size: u64, expected_offset: u64, expected_flags: u64) -> bool {
    let outcome: |recursive_translation|::RecursiveTranslation = |recursive_translation|::translate_words(va, p4, p3, p2, p1);
    transition outcome {
        |recursive_translation|::RecursiveTranslation::InvalidLeafHugePage -> (tag == 3 && expected_frame == 0 && expected_size == 0 && expected_offset == 0 && expected_flags == 0)
        |recursive_translation|::RecursiveTranslation::Result { value } -> result(value, tag, expected_frame, expected_size, expected_offset, expected_flags)
    }
    state result(value: |translation|::Translation, tag: u64, expected_frame: u64, expected_size: u64, expected_offset: u64, expected_flags: u64) -> bool {
        let empty: bool = expected_frame == 0 && expected_size == 0 && expected_offset == 0 && expected_flags == 0;
        transition value {
            |translation|::Translation::NotMapped -> (tag == 1 && empty)
            |translation|::Translation::InvalidVirtual -> (tag == 5 && empty)
            |translation|::Translation::InvalidRootHugePage -> (tag == 2 && empty)
            |translation|::Translation::Mapped { frame, size, offset, flags } -> (tag == 0 && frame == expected_frame && size == expected_size && offset == expected_offset && flags == expected_flags)
        }
    }
}
