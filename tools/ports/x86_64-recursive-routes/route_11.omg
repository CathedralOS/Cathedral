machine test_result() -> i32 {
    transition checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4097, 8321, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8323, 0, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:3, zeros:0, calls:0, visited:2, code:2, location:1, payload:0, result_word:8323, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4097, 8193, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8195, 3221225603, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:7, zeros:0, calls:0, visited:3, code:0, location:2, payload:3221225472, result_word:3221225603, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4097, 8193, 512, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8195, 512, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:3, zeros:0, calls:0, visited:3, code:4, location:2, payload:3221225472, result_word:512, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 2147487744], words:[4097, 8193, 2147487745, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8195, 2147487745, 0], ids:[16384, 4096, 8192, 2147487744], indices:[292, 13, 0, 0], writes:3, zeros:0, calls:0, visited:3, code:4, location:2, payload:3221225472, result_word:2147487745, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 2147487744], words:[4097, 8193, 2147487873, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8195, 2147487873, 0], ids:[16384, 4096, 8192, 2147487744], indices:[292, 13, 0, 0], writes:3, zeros:0, calls:0, visited:3, code:4, location:2, payload:3221225472, result_word:2147487873, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 2147483648], words:[4097, 8193, 2147483777, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Unmap, Expected { words:[4097, 8193, 0, 0], ids:[16384, 4096, 8192, 2147483648], indices:[292, 13, 0, 0], writes:4, zeros:0, calls:0, visited:3, code:0, location:2, payload:2147483648, result_word:0, result_write:true }) { true -> (0) _ -> (1) }
