use checks;
use checks::Expected;
use x86::mapping_routes::CapturedPath;
use x86::mapping_routes::AllocationInputs;
use x86::mapping_routes::Request;
use x86::mapping_plans::FrameSupply;
machine test_result() -> i32 {
    transition checks::route(CapturedPath { table_ids:[16384, 4096, 0, 12288], words:[4097, 0, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 0, 12289, 512], ids:[16384, 4096, 0, 12288], indices:[292, 13, 0, 0], writes:1, zeros:0, calls:1, visited:2, code:6, location:1, payload:0, result_word:0, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 0, 12288], words:[4097, 0, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Supplied { address:8192 }, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:3 }, Expected { words:[4099, 8195, 3221225603, 512], ids:[16384, 4096, 8192, 12288], indices:[292, 13, 0, 0], writes:7, zeros:4, calls:1, visited:3, code:0, location:2, payload:3221225472, result_word:3221225603, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4097, 8193, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:128, parent_flags:3 }, Expected { words:[4099, 8195, 3221225600, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:7, zeros:0, calls:0, visited:3, code:0, location:2, payload:3221225472, result_word:3221225600, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 2147483648], words:[4097, 8193, 2147483777, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::Update { new_flags:18446744073709551615 }, Expected { words:[4097, 8193, 18446744073709551615, 0], ids:[16384, 4096, 8192, 2147483648], indices:[292, 13, 0, 0], writes:4, zeros:0, calls:0, visited:3, code:0, location:2, payload:2147483648, result_word:18446744073709551615, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 2147483648], words:[4097, 8193, 2147483777, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::SetParent { level:2, table_flags:0 }, Expected { words:[4097, 8193, 2147483777, 0], ids:[16384, 4096, 8192, 2147483648], indices:[292, 13, 0, 0], writes:0, zeros:0, calls:0, visited:0, code:2, location:0, payload:0, result_word:0, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 4096, 8192, 0], words:[4097, 8193, 0, 0] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 2097152, Request::SetParent { level:2, table_flags:3 }, Expected { words:[4097, 8193, 0, 0], ids:[16384, 4096, 8192, 0], indices:[292, 13, 0, 0], writes:0, zeros:0, calls:0, visited:0, code:2, location:0, payload:0, result_word:0, result_write:false }) { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
