use checks;
use checks::Expected;
use x86::mapping_routes::CapturedPath;
use x86::mapping_routes::AllocationInputs;
use x86::mapping_routes::Request;
use x86::mapping_plans::FrameSupply;
machine test_result() -> i32 {
    transition checks::route(CapturedPath { table_ids:[16384, 0, 8192, 12288], words:[0, 8193, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Supplied { address:4096 }, FrameSupply::Supplied { address:8192 }, FrameSupply::Supplied { address:12288 }] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:2 }, Expected { words:[4099, 8195, 3221225603, 512], ids:[16384, 4096, 8192, 12288], indices:[292, 13, 0, 0], writes:7, zeros:6, calls:2, visited:3, code:0, location:2, payload:3221225472, result_word:3221225603, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 0, 8192, 12288], words:[0, 8193, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Supplied { address:4096 }, FrameSupply::Supplied { address:8192 }, FrameSupply::Supplied { address:12288 }] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:128 }, Expected { words:[0, 8193, 12289, 512], ids:[16384, 0, 8192, 12288], indices:[292, 13, 0, 0], writes:0, zeros:0, calls:1, visited:1, code:5, location:1, payload:0, result_word:0, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 0, 8192, 12288], words:[0, 8193, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Supplied { address:4096 }, FrameSupply::Supplied { address:8192 }, FrameSupply::Supplied { address:12288 }] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:129 }, Expected { words:[0, 8193, 12289, 512], ids:[16384, 0, 8192, 12288], indices:[292, 13, 0, 0], writes:0, zeros:0, calls:1, visited:1, code:5, location:1, payload:0, result_word:0, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 0, 8192, 12288], words:[0, 8193, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Supplied { address:4096 }, FrameSupply::Supplied { address:8192 }, FrameSupply::Supplied { address:12288 }] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:7 }, Expected { words:[4103, 8199, 3221225603, 512], ids:[16384, 4096, 8192, 12288], indices:[292, 13, 0, 0], writes:7, zeros:6, calls:2, visited:3, code:0, location:2, payload:3221225472, result_word:3221225603, result_write:true }) &&
        checks::route(CapturedPath { table_ids:[16384, 0, 8192, 12288], words:[0, 8193, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Supplied { address:4096 }, FrameSupply::Supplied { address:8192 }, FrameSupply::Supplied { address:12288 }] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:18446744073709551615 }, Expected { words:[0, 8193, 12289, 512], ids:[16384, 0, 8192, 12288], indices:[292, 13, 0, 0], writes:0, zeros:0, calls:1, visited:1, code:5, location:1, payload:0, result_word:0, result_write:false }) &&
        checks::route(CapturedPath { table_ids:[16384, 0, 8192, 12288], words:[0, 8193, 12289, 512] }, AllocationInputs { frames:[FrameSupply::Supplied { address:4096 }, FrameSupply::Supplied { address:8192 }, FrameSupply::Supplied { address:12288 }] }, 18446623141389139968, 2097152, Request::Map { frame:3221225472, flags:3, parent_flags:4096 }, Expected { words:[4099, 12291, 3221225603, 512], ids:[16384, 4096, 12288, 12288], indices:[292, 13, 0, 0], writes:7, zeros:6, calls:2, visited:3, code:0, location:2, payload:3221225472, result_word:3221225603, result_write:true }) { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
