        checks::route(CapturedPath { table_ids:[16384, 0, 8192, 12288], words:[128, 8193, 12289, 2147483777] }, AllocationInputs { frames:[FrameSupply::Unavailable, FrameSupply::Unavailable, FrameSupply::Unavailable] }, 18446623141389139968, 4096, Request::Update { new_flags:3 }, Expected { words:[128, 8193, 12289, 2147483651], ids:[16384, 0, 8192, 12288], indices:[292, 13, 0, 0], writes:8, zeros:0, calls:0, visited:4, code:0, location:2, payload:2147483648, result_word:2147483651, result_write:true }) &&
