use {x86}/recursive_routes.omg;
use {x86}/mapping_routes.omg;
use {x86}/mapping_plans.omg;
use translation_checks.omg;
machine invalid_page() -> bool {
    let path: |mapping_routes|::CapturedPath = |mapping_routes|::CapturedPath {};
    let allocations: |mapping_routes|::AllocationInputs = |mapping_routes|::AllocationInputs {};
    let result: |mapping_routes|::RoutePlan = |recursive_routes|::plan(&path, &allocations, 1, 4096, |mapping_routes|::Request::Unmap);
    transition result.outcome {
        |mapping_routes|::Outcome::InvalidInput -> (result.edits.write_mask == 0 && result.edits.allocation_calls == 0 && result.edits.visited == 0)
        _ -> (false)
    }
}
machine mismatch_after_write() -> bool {
    let path: |mapping_routes|::CapturedPath = |mapping_routes|::CapturedPath { table_ids: [16384, 8192, 8192, 12288], words: [4097, 8193, 12289, 0] };
    let allocations: |mapping_routes|::AllocationInputs = |mapping_routes|::AllocationInputs {};
    let result: |mapping_routes|::RoutePlan = |recursive_routes|::plan(&path, &allocations, 0, 4096, |mapping_routes|::Request::Map { frame: 32768, flags: 3, parent_flags: 3 });
    transition result.outcome {
        |mapping_routes|::Outcome::CaptureMismatch { expected, supplied } -> (expected == 4096 && supplied == 8192 && result.edits.words[0] == 4099 && result.edits.write_mask == 1 && result.edits.zero_mask == 0 && result.edits.allocation_calls == 0 && result.edits.visited == 1)
        _ -> (false)
    }
}
machine invalid_allocation() -> bool {
    let path: |mapping_routes|::CapturedPath = |mapping_routes|::CapturedPath {};
    let allocations: |mapping_routes|::AllocationInputs = |mapping_routes|::AllocationInputs { frames: [|mapping_plans|::FrameSupply::Supplied { address: 1 }, |mapping_plans|::FrameSupply::Unavailable, |mapping_plans|::FrameSupply::Unavailable] };
    let result: |mapping_routes|::RoutePlan = |recursive_routes|::plan(&path, &allocations, 0, 4096, |mapping_routes|::Request::Map { frame: 32768, flags: 3, parent_flags: 0 });
    let clean: bool = result.edits.write_mask == 0 && result.edits.zero_mask == 0 && result.edits.allocation_calls == 1 && result.edits.visited == 1;
    transition result.outcome {
        |mapping_routes|::Outcome::ChildFailure { child } -> invalid_child(child, clean)
        _ -> (false)
    }
    state invalid_child(child: |mapping_plans|::ChildPlan, clean: bool) -> bool {
        transition child { |mapping_plans|::ChildPlan::InvalidSuppliedFrame -> (clean && child.word == 0 && !child.write) _ -> (false) }
    }
}
machine test_result() -> i32 {
    transition invalid_page() && mismatch_after_write() && invalid_allocation() &&
        |translation_checks|::check(140737488355328, 4097, 8193, 12289, 32769, 5, 0, 0, 0, 0) {
        true -> (0) _ -> (1)
    }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
