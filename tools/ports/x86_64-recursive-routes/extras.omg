use x86::recursive_routes;
use x86::mapping_routes::CapturedPath;
use x86::mapping_routes::AllocationInputs;
use x86::mapping_routes::Request;
use x86::mapping_routes::RoutePlan;
use x86::mapping_routes::Outcome;
use x86::mapping_plans::FrameSupply;
use x86::mapping_plans::ChildPlan;
use translation_checks;
machine invalid_page() -> bool {
    let path: CapturedPath = CapturedPath {};
    let allocations: AllocationInputs = AllocationInputs {};
    let result: RoutePlan = recursive_routes::plan(&path, &allocations, 1, 4096, Request::Unmap);
    transition result.outcome {
        Outcome::InvalidInput -> (result.edits.write_mask == 0 && result.edits.allocation_calls == 0 && result.edits.visited == 0)
        _ -> (false)
    }
}
machine mismatch_after_write() -> bool {
    let path: CapturedPath = CapturedPath { table_ids: [16384, 8192, 8192, 12288], words: [4097, 8193, 12289, 0] };
    let allocations: AllocationInputs = AllocationInputs {};
    let result: RoutePlan = recursive_routes::plan(&path, &allocations, 0, 4096, Request::Map { frame: 32768, flags: 3, parent_flags: 3 });
    transition result.outcome {
        Outcome::CaptureMismatch { expected, supplied } -> (expected == 4096 && supplied == 8192 && result.edits.words[0] == 4099 && result.edits.write_mask == 1 && result.edits.zero_mask == 0 && result.edits.allocation_calls == 0 && result.edits.visited == 1)
        _ -> (false)
    }
}
machine invalid_allocation() -> bool {
    let path: CapturedPath = CapturedPath {};
    let allocations: AllocationInputs = AllocationInputs { frames: [FrameSupply::Supplied { address: 1 }, FrameSupply::Unavailable, FrameSupply::Unavailable] };
    let result: RoutePlan = recursive_routes::plan(&path, &allocations, 0, 4096, Request::Map { frame: 32768, flags: 3, parent_flags: 0 });
    let clean: bool = result.edits.write_mask == 0 && result.edits.zero_mask == 0 && result.edits.allocation_calls == 1 && result.edits.visited == 1;
    transition result.outcome {
        Outcome::ChildFailure { child } -> invalid_child(child, clean)
        _ -> (false)
    }
    state invalid_child(child: ChildPlan, clean: bool) -> bool {
        transition child { ChildPlan::InvalidSuppliedFrame -> (clean && child.word == 0 && !child.write) _ -> (false) }
    }
}
machine test_result() -> i32 {
    transition invalid_page() && mismatch_after_write() && invalid_allocation() &&
        translation_checks::check(140737488355328, 4097, 8193, 12289, 32769, 5, 0, 0, 0, 0) {
        true -> (0) _ -> (1)
    }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
