use {x86}/translation.omg;
use {x86}/addresses.omg;
machine equal(result:|addresses|::NumberResult,expected:u64)->bool {
    transition result { |addresses|::NumberResult::Value { value } -> (value == expected) _ -> (false) }
}
machine table_result()->i32 {
    let mapped:|translation|::Translation=|translation|::translate_words(0xdeadbeef,4097,8193,12289,0xcafe0003);
    let address:|addresses|::NumberResult=|translation|::translated_address(mapped);
    let good:bool=equal(address,0xcafe0eef);
    let absent:|addresses|::NumberResult=|translation|::translated_address(|translation|::Translation::NotMapped);
    let bad_size:|addresses|::NumberResult=|translation|::translated_address(|translation|::Translation::Mapped { frame:0,size:0,offset:0,flags:0 });
    let bad_offset:|addresses|::NumberResult=|translation|::translated_address(|translation|::Translation::Mapped { frame:0,size:4096,offset:4096,flags:0 });
    let bad_frame:|addresses|::NumberResult=|translation|::translated_address(|translation|::Translation::Mapped { frame:1,size:4096,offset:0,flags:0 });
    let too_high:|addresses|::NumberResult=|translation|::translated_address(|translation|::Translation::Mapped { frame:4503599627370496,size:4096,offset:0,flags:0 });
    transition good && absent in |addresses|::NumberResult::Rejected && bad_size in |addresses|::NumberResult::Rejected &&
        bad_offset in |addresses|::NumberResult::Rejected && bad_frame in |addresses|::NumberResult::Rejected && too_high in |addresses|::NumberResult::Rejected {
        true -> (0) _ -> (1)
    }
}
const RESULT:i32=table_result();
machine require_success(value:i32) requires value == 0; {}
data Main{}
machine Main::main(&mut self){require_success(RESULT);}
