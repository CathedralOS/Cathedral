use x86::page_tables;
use x86::addresses::NumberResult;
use facts::x86_page_table_entry;
machine equal(result: NumberResult, expected: u64) -> bool {
    transition result { NumberResult::Value { value } -> (value == expected) _ -> (false) }
}
machine table_result() -> i32 {
    let mut table: [X86PageTableEntry; 512];
    let first_write: bool = page_tables::write_word(&mut table, 0, 0x12345003);
    let last_write: bool = page_tables::write_word(&mut table, 511, 0x8000000000000000);
    let outside_write: bool = page_tables::write_word(&mut table, 512, 1);
    let far_write: bool = page_tables::write_word(&mut table, 18446744073709551615, 1);
    let first: NumberResult = page_tables::read_word(&table, 0);
    let middle: NumberResult = page_tables::read_word(&table, 255);
    let last: NumberResult = page_tables::read_word(&table, 511);
    let outside: NumberResult = page_tables::read_word(&table, 512);
    let dirty: bool = page_tables::is_empty(&table);
    let first_ok: bool = equal(first, 0x12345003);
    let middle_ok: bool = equal(middle, 0);
    let last_ok: bool = equal(last, 0x8000000000000000);
    transition first_write && last_write && !outside_write && !far_write &&
        first_ok && middle_ok && last_ok && outside in NumberResult::Rejected && !dirty {
        true -> (0) _ -> (1)
    }
}
const RESULT: i32 = table_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(RESULT); }
