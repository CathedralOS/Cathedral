machine scenario()->i32 {
let check0:bool=row0();
let check1:bool=row1();
let check2:bool=row2();
let check3:bool=row3();
let check4:bool=row4();
let check5:bool=row5();
transition check0 && check1 && check2 && check3 && check4 && check5 { true -> (0) _ -> (1) } }
const RESULT:i32=scenario();
machine require_success(value:i32) requires value==0; {}
data Main{}
machine Main::main(&mut self){require_success(RESULT);}
