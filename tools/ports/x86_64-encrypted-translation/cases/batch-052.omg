let configured0:bool=memory_encryption::configure(&mut profile,Configuration::EncryptedBit { position:47 });
let configured1:bool=memory_encryption::configure(&mut profile,Configuration::SharedBit { position:48 });
let configured2:bool=memory_encryption::configure(&mut profile,Configuration::EncryptedBit { position:47 });
let value:Translation=encrypted_translation::translate_words(&profile,3735928559,4225,0,0,0);
let good:bool=matches_encrypted_result(value,2,0,0,0,0);
let path:CapturedPath=CapturedPath { table_ids:[0,4096,8192,16384],words:[4225,0,0,0] };
let walk:CapturedWalk=encrypted_translation::walk_path(&profile,3735928559,&path);
let same:bool=captured(walk,2,0,0,0,0);
good && same
}
