use {x86}/encrypted_translation.omg;
use {x86}/memory_encryption.omg;
use {x86}/translation.omg;
use {x86}/mapping_routes.omg;
machine matches_encrypted_result(value:|translation|::Translation, kind:u8, want_frame:u64, want_size:u64, want_offset:u64, want_flags:u64)->bool {
 transition value {
  |translation|::Translation::NotMapped -> (kind==0)
  |translation|::Translation::InvalidRootHugePage -> (kind==2)
  |translation|::Translation::Mapped { frame, size, offset, flags } ->
   (kind==1 && frame==want_frame && size==want_size && offset==want_offset && flags==want_flags)
  _ -> (false)
 }
}
machine captured(observation:|translation|::CapturedWalk, kind:u8, frame:u64, size:u64, offset:u64, flags:u64)->bool {
 transition observation {
  |translation|::CapturedWalk::Result { value } -> check(value,kind,frame,size,offset,flags)
  _ -> (false)
 }
 state check(inner:|translation|::Translation,kind:u8,frame:u64,size:u64,offset:u64,flags:u64) {
  let valid:bool=matches_encrypted_result(inner,kind,frame,size,offset,flags);valid
 }
}
machine row0()->bool {
let profile:|memory_encryption|::State=|memory_encryption|::initial();
let configured0:bool=|memory_encryption|::configure(&mut profile,|memory_encryption|::Configuration::EncryptedBit { position:12 });
let value:|translation|::Translation=|encrypted_translation|::translate_words(&profile,18446623141479811772,0,16385,32769,320257118830339);
let good:bool=matches_encrypted_result(value,0,0,0,0,0);
let path:|mapping_routes|::CapturedPath=|mapping_routes|::CapturedPath { table_ids:[0,8192,16384,32768],words:[0,16385,32769,320257118830339] };
let walk:|translation|::CapturedWalk=|encrypted_translation|::walk_path(&profile,18446623141479811772,&path);
let same:bool=captured(walk,0,0,0,0,0);
good && same
}
