let value:Translation=encrypted_translation::translate_words(&profile,3735928559,8193,16385,18446744073709551615,0);
let good:bool=matches_encrypted_result(value,1,4503599625273344,2097152,900847,18442240474082189311);
let path:CapturedPath=CapturedPath { table_ids:[0,8192,16384,32768],words:[8193,16385,18446744073709551615,0] };
let walk:CapturedWalk=encrypted_translation::walk_path(&profile,3735928559,&path);
let same:bool=captured(walk,1,4503599625273344,2097152,900847,18442240474082189311);
good && same
}
