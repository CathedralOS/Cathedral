let path:CapturedPath=CapturedPath { table_ids:[0,4096,8192,16384],words:[4097,8193,16385,18446744073709551615] };
let walk:CapturedWalk=encrypted_translation::walk_path(&profile,18446623141479811772,&path);
let same:bool=captured(walk,1,4503599625269248,4096,2748,18442240474084282367);
