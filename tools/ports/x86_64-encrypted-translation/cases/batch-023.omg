let good:bool=matches_encrypted_result(value,1,4503598553628672,1073741824,90671804,18442240474084282367);
let path:CapturedPath=CapturedPath { table_ids:[0,4096,8192,16384],words:[4097,18446744073709551615,0,0] };
let walk:CapturedWalk=encrypted_translation::walk_path(&profile,18446623141479811772,&path);
