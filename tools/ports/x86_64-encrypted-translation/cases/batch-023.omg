let value:Translation=encrypted_translation::translate_words(&profile,18446623141479811772,4097,8193,16385,2097664);
let good:bool=matches_encrypted_result(value,1,0,4096,2748,2097664);
let path:CapturedPath=CapturedPath { table_ids:[0,4096,8192,16384],words:[4097,8193,16385,2097664] };
let walk:CapturedWalk=encrypted_translation::walk_path(&profile,18446623141479811772,&path);
let same:bool=captured(walk,1,0,4096,2748,2097664);
good && same
}
