let value:Translation=encrypted_translation::translate_words(&profile,3735928559,4097,8193,16385,320258192568067);
let good:bool=matches_encrypted_result(value,1,320257118822400,4096,3823,1073745667);
let path:CapturedPath=CapturedPath { table_ids:[0,4096,8192,16384],words:[4097,8193,16385,320258192568067] };
let walk:CapturedWalk=encrypted_translation::walk_path(&profile,3735928559,&path);
let same:bool=captured(walk,1,320257118822400,4096,3823,1073745667);
good && same
}
