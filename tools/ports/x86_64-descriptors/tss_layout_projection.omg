use {facts}/x86_descriptors.omg;
use {facts}/x86_descriptor_layouts.omg;
data Main { tss: |x86_descriptor_layouts|::TaskStateSegmentLayout<|x86_descriptors|::TaskStateSegment>; }
machine Main::main(&mut self) -> i32 {
    self.tss.iomap_base = 104;
    transition self.tss.iomap_base == 104 { true -> (0) _ -> (1) }
}
