use {facts}/x86_descriptors.omg;
use {facts}/x86_descriptor_layouts.omg;
data Main { pointer: |x86_descriptor_layouts|::DescriptorTablePointerLayout<|x86_descriptors|::DescriptorTablePointer>; }
machine Main::main(&mut self) -> i32 {
    self.pointer.limit = 7;
    transition self.pointer.limit == 7 { true -> (0) _ -> (1) }
}
