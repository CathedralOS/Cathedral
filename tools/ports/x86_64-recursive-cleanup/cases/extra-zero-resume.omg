use {values}/recursive_cleanup.omg;
use {values}/cleanup_ranges.omg;
machine test()->i32 {
let words:[u64;4]=[0,0,0,0];let ids:[u64;4]=[16384,0,0,0];let others:[bool;4]=[true,false,false,false];
let c:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::begin(0,0,0,0);let paused:|recursive_cleanup|::RecursiveStep=|recursive_cleanup|::step(c,&words,&ids,&others);let resumed:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::resume(paused.cursor,1);let result:|recursive_cleanup|::RecursiveStep=|recursive_cleanup|::step(resumed,&words,&ids,&others);
transition paused.cursor.range.status in |cleanup_ranges|::RangeStatus::Exhausted && !paused.has_plan && result.cursor.range.status in |cleanup_ranges|::RangeStatus::Done && !result.has_plan && result.cursor.recursive_index==0 {true -> (0) _ -> (1)}
}
const RESULT:i32=test();machine require_ok(value:i32) requires value==0;{}data Main{}machine Main::main(&mut self){require_ok(RESULT);}
