use {values}/recursive_cleanup.omg;
use {values}/cleanup_ranges.omg;
machine test()->i32 {
let words:[u64;4]=[0,0,0,0];let ids:[u64;4]=[16384,0,0,0];let others:[bool;4]=[true,false,false,false];
let c:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::begin(0,0,2,0);let result:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::resume(c,99);
transition result.range.status in |cleanup_ranges|::RangeStatus::Active && result.range.budget==2 && result.recursive_index==0 {true -> (0) _ -> (1)}
}
const RESULT:i32=test();machine require_ok(value:i32) requires value==0;{}data Main{}machine Main::main(&mut self){require_ok(RESULT);}
