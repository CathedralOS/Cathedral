use {values}/recursive_cleanup.omg;
use {values}/cleanup_ranges.omg;
machine test()->u64 {
 let maximum:u64=0xffffffffffffffff;
 let words:[u64;4]=[0,0,0,0];let ids:[u64;4]=[16384,0,0,0];let others:[bool;4]=[true,false,false,false];
 let cursor:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::begin(0,0,maximum,1);
 let result:|recursive_cleanup|::RecursiveStep=|recursive_cleanup|::step(cursor,&words,&ids,&others);
 let remaining:u64=result.cursor.range.budget;
 transition result.cursor.range.status in |cleanup_ranges|::RangeStatus::Done && remaining==0xfffffffffffffffe {true -> (0) _ -> (1)}
}
const RESULT:u64=test();machine require_ok(value:u64) requires value==0;{}data Main{}machine Main::main(&mut self){require_ok(RESULT);}
