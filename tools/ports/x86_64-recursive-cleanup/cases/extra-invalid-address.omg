use {values}/recursive_cleanup.omg;
use {values}/cleanup_ranges.omg;
machine test()->i32 {
let words:[u64;4]=[0,0,0,0];let ids:[u64;4]=[16384,0,0,0];let others:[bool;4]=[true,false,false,false];
let c:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::begin(140737488355328,140737488355328,2,0);let result:|recursive_cleanup|::RecursiveStep=|recursive_cleanup|::step(c,&words,&ids,&others);
transition result.cursor.range.status in |cleanup_ranges|::RangeStatus::InvalidRange && !result.has_plan {true -> (0) _ -> (1)}
}
const RESULT:i32=test();machine require_ok(value:i32) requires value==0;{}data Main{}machine Main::main(&mut self){require_ok(RESULT);}
