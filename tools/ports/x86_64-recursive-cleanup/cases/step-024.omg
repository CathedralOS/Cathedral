use values::recursive_cleanup::begin;
use values::recursive_cleanup::step;
use values::recursive_cleanup::RecursiveCursor;
use values::recursive_cleanup::RecursiveStep;
use values::cleanup_ranges::RangeStatus;
use values::cleanup_branch::CleanupOutcome;
// gap-ordinary
machine test()->i32 {
let words:[u64;4]=[20481,24577,28673,0];let ids:[u64;4]=[16384,20480,24576,28672];let others:[bool;4]=[true,false,false,false];
let cursor:RecursiveCursor=begin(18446603336221196288,18446603336221196288,2,0);let value:RecursiveStep=step(cursor,&words,&ids,&others);
let next:u64=value.cursor.range.next_page;let last:u64=value.cursor.range.last_page;let budget:u64=value.cursor.range.budget;
transition value.has_plan==true && value.cursor.range.status in RangeStatus::Done && next==18446603336221196288 && last==18446603336221196288 && budget==1 && value.cursor.recursive_index==0 && value.branch.retire_count==3 && value.branch.write_mask==7 && value.branch.visited==4 && value.branch.outcome in CleanupOutcome::Ready && value.branch.words[0]==0 && value.branch.words[1]==0 && value.branch.words[2]==0 && value.branch.words[3]==0 && value.branch.frames_to_retire[0]==28672 && value.branch.frames_to_retire[1]==24576 && value.branch.frames_to_retire[2]==20480 {true -> (0) _ -> (1)}
}
const RESULT:i32=test();
machine require_ok(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_ok(RESULT);}
