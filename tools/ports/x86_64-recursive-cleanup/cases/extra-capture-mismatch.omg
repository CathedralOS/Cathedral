use {values}/recursive_cleanup.omg;
use {values}/cleanup_ranges.omg;
machine test()->i32 {
let words:[u64;4]=[0,0,0,0];let ids:[u64;4]=[16384,0,0,0];let others:[bool;4]=[true,false,false,false];
let bad_words:[u64;4]=[4097,0,0,0];let c:|recursive_cleanup|::RecursiveCursor=|recursive_cleanup|::begin(0,0,2,1);let result:|recursive_cleanup|::RecursiveStep=|recursive_cleanup|::step(c,&bad_words,&ids,&others);
transition result.cursor.range.status in |cleanup_ranges|::RangeStatus::CaptureMismatch && result.has_plan && result.cursor.range.budget==2 && result.branch.retire_count==0 {true -> (0) _ -> (1)}
}
const RESULT:i32=test();machine require_ok(value:i32) requires value==0;{}data Main{}machine Main::main(&mut self){require_ok(RESULT);}
