    let plan: |snapshot|::ConfigPlan = |msix|::msix_control_plan(64, masked);
    let invalid: |msix|::MsixCapability = |msix|::msix_capability(0, 7, 0);
    let partial: |msix|::MsixCapability = |msix|::msix_capability(64, 0, 0);
    value.table_size == 2048 && |msix|::msix_enabled(value.control) && |msix|::msix_masked(value.control) &&
