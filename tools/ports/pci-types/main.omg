machine address_cases() -> bool {
    let full: |pci_address|::AddressResult = |pci_address|::address_new(65535, 255, 31, 7);
    full.ok && full.value.raw == 0xffffffff && |pci_address|::address_segment(full.value) == 65535 &&
    |pci_address|::address_bus(full.value) == 255 && |pci_address|::address_device(full.value) == 31 && |pci_address|::address_function(full.value) == 7 &&
    !|pci_address|::address_new(0, 0, 32, 0).ok && !|pci_address|::address_new(0, 0, 0, 8).ok && |pci_address|::address_new(0, 0, 0, 0).ok
}
machine snapshot_cases() -> bool {
    let mut value: |snapshot|::ConfigSnapshot;
    value.length = 4096;
    value.bytes[4092] = 0x12; value.bytes[4093] = 0x34; value.bytes[4094] = 0x56; value.bytes[4095] = 0x78;
    let last: |snapshot|::ReadResult = |snapshot|::snapshot_read(&value, 4092, 4);
    let mut invalid: |snapshot|::ConfigSnapshot;
    invalid.length = 4097;
    !|snapshot|::snapshot_read(&invalid, 0, 1).ok && last.ok && last.value == 0x78563412 && |snapshot|::snapshot_read(&value, 4095, 1).value == 0x78 &&
    !|snapshot|::snapshot_read(&value, 4093, 4).ok && !|snapshot|::snapshot_read(&value, 65535, 4).ok &&
    !|snapshot|::snapshot_read(&value, 0, 3).ok && !|snapshot|::write_plan(3, 2, 0).ok && !|snapshot|::write_plan(2, 4, 0).ok &&
    !|snapshot|::write_plan(0, 1, 256).ok && !|snapshot|::write_plan(4095, 2, 0).ok && |snapshot|::write_plan(4092, 4, 0xffffffff).ok
}
machine header_cases() -> bool {
    let mut value: |snapshot|::ConfigSnapshot;
    value.length = 64;
    value.bytes[0] = 0x86; value.bytes[1] = 0x80; value.bytes[2] = 0x34; value.bytes[3] = 0x12;
    value.bytes[4] = 7; value.bytes[6] = 16; value.bytes[7] = 128;
    value.bytes[8] = 9; value.bytes[9] = 48; value.bytes[10] = 3; value.bytes[11] = 12;
    value.bytes[14] = 128; value.bytes[44] = 0x11; value.bytes[46] = 0x22;
    value.bytes[52] = 0x40; value.bytes[60] = 11; value.bytes[61] = 1;
    let header: |headers|::HeaderFacts = |headers|::header_facts(&value);
    let endpoint: |headers|::EndpointHeader = |headers|::endpoint_header(&value);
    let command: |snapshot|::ConfigPlan = |headers|::update_command(5);
    let interrupt: |snapshot|::ConfigPlan = |headers|::update_interrupt(1, 1, 13);
    header.ok && header.vendor_id == 0x8086 && header.device_id == 0x1234 && header.command == 7 &&
    header.status == 0x8010 && header.revision == 9 && header.interface == 48 && header.base_class == 12 &&
    |headers|::header_kind(header) == 0 && |headers|::header_multifunction(header) && |headers|::header_device_present(header) &&
    endpoint.ok && endpoint.subsystem_vendor_id == 17 && endpoint.subsystem_id == 34 &&
    endpoint.interrupt_pin == 1 && endpoint.interrupt_line == 11 && |headers|::endpoint_capability_pointer(endpoint) == 64 &&
    command.ok && command.count == 1 && command.operations[0].width == 2 && command.operations[0].offset == 4 &&
    command.operations[0].value == 5 && interrupt.ok && interrupt.operations[0].width == 1 &&
    interrupt.operations[0].offset == 60 && !|headers|::update_interrupt(1, 2, 13).ok && !|headers|::bridge_header(&value).ok
}
machine bridge_cases() -> bool {
    let mut value: |snapshot|::ConfigSnapshot;
    value.length = 64; value.bytes[14] = 1;
    value.bytes[24] = 2; value.bytes[25] = 3; value.bytes[26] = 20; value.bytes[27] = 0xab;
    value.bytes[28] = 0x11; value.bytes[29] = 0x22; value.bytes[30] = 0x33; value.bytes[31] = 0x44;
    let bridge: |headers|::PciPciBridgeHeader = |headers|::bridge_header(&value);
    let plan: |snapshot|::ConfigPlan = |headers|::update_bus_numbers(0xab140302, |headers|::BusNumber { primary: 4, secondary: 5, subordinate: 6 });
    bridge.ok && bridge.buses.primary == 2 && bridge.buses.secondary == 3 && bridge.buses.subordinate == 20 &&
    bridge.secondary_latency_timer == 0xab && bridge.io_base == 0x11 && bridge.io_limit == 0x22 &&
    bridge.secondary_status == 0x4433 && plan.operations[0].value == 0xab060504 && !|headers|::endpoint_header(&value).ok
}
machine register_class_cases() -> bool {
    let status: |registers|::StatusRegister = |registers|::StatusRegister { raw: 0x8618 };
    let command: |registers|::CommandRegister = |registers|::command_update(|registers|::CommandRegister { raw: 0x8003 }, 2, 4);
    |registers|::status_parity_error_detected(status) && |registers|::status_has_capability_list(status) && |registers|::status_interrupt_status(status) &&
    !|registers|::status_devsel_timing(status).ok && |registers|::devsel_timing(2).ok && !|registers|::devsel_timing(255).ok &&
    command.raw == 0x8005 && |registers|::command_contains(command, 5) && !|registers|::command_contains(command, 2) &&
    |device_type|::device_type(2, 0).code == 512 && |device_type|::device_type(2, 5).code == 517 &&
    |device_type|::device_type(4, 128).code == 1152 && |device_type|::device_type(5, 128).code == 1408 &&
    |device_type|::device_type(15, 0).code == 65536 && |device_type|::device_type(15, 1).code == 3841 && |device_type|::device_type(15, 4).code == 3844 &&
    |device_type|::device_type(4, 3).code == 65536 && |device_type|::device_type(5, 2).code == 65536 && |device_type|::device_type(255, 255).code == 65536 &&
    |device_type|::usb_type(0).ok && |device_type|::usb_type(16).ok && |device_type|::usb_type(32).ok && |device_type|::usb_type(48).ok && |device_type|::usb_type(128).ok &&
    |device_type|::usb_type(254).ok && !|device_type|::usb_type(255).ok && |device_type|::usb_type(255).raw == 255
}
machine bar_cases() -> bool {
    let mem: |bars|::Bar = |bars|::bar_decode(0x80000008, 0, 0, 6);
    let wide: |bars|::Bar = |bars|::bar_decode(0x3450000c, 0x12, 2, 6);
    let io: |bars|::Bar = |bars|::bar_decode(0xc001, 0, 0, 6);
    let size: |bars|::BarSize = |bars|::bar_size(mem, 0xfffff000, 0);
    let huge: |bars|::BarSize = |bars|::bar_size(wide, 0, 0x80000000);
    let high_bit: u64 = 0x8000000000000000;
    let probe: |snapshot|::ConfigPlan = |bars|::bar_probe_plan(2, 6, 0x3450000c, 0x12);
    let write: |snapshot|::ConfigPlan = |bars|::bar_write_plan(2, 6, 0x3450000c, 0x12, 0x1234500000);
    let mut endpoint: |headers|::EndpointHeader;
    endpoint.ok = true; endpoint.bars[0] = 4; endpoint.bars[1] = 4; endpoint.bars[2] = 0x80000000;
    mem.ok && mem.kind == 2 && mem.prefetchable && mem.address == 0x80000000 && size.ok && size.bytes == 4096 &&
    huge.ok && huge.bytes == high_bit && wide.ok && wide.slots == 2 && wide.address == 0x1234500000 && io.ok && io.address == 0xc000 &&
    |bars|::bar_unwrap_io(io).ok && !|bars|::bar_unwrap_io(mem).ok && |bars|::bar_unwrap_mem(wide, size).ok &&
    !|bars|::bar_decode(4, 0, 5, 6).ok && !|bars|::bar_decode(6, 0, 0, 6).ok && !|bars|::bar_decode(0, 0, 6, 6).ok &&
    |bars|::bar_decode(0, 0, 0, 6).ok && !|bars|::bar_size(mem, 0, 0).ok && !|bars|::bar_size(mem, 0xfffff010, 0).ok &&
    |bars|::bar_size(wide, 0xffff0000, 0xffffffff).bytes == 65536 && !|bars|::bar_size(wide, 0, 0).ok &&
    probe.ok && probe.count == 6 && probe.requires_restore_on_failure && probe.requires_quiesced_decoding &&
    probe.operations[4].value == 0x12 && probe.operations[5].value == 0x3450000c &&
    write.ok && write.count == 2 && write.operations[0].value == 0x3450000c && write.operations[1].value == 0x12 &&
    !|bars|::bar_write_plan(0, 6, 0, 0, 0x100000000).ok && !|bars|::bar_write_plan(0, 6, 0, 0, 1).ok &&
    !|bars|::endpoint_bar(endpoint, 1).ok && |bars|::endpoint_bar(endpoint, 2).ok
}
machine capability_cases() -> bool {
    let mut value: |snapshot|::ConfigSnapshot;
    value.length = 256;
    value.bytes[64] = 5; value.bytes[65] = 68; value.bytes[66] = 128;
    value.bytes[68] = 0; value.bytes[69] = 72;
    value.bytes[72] = 254; value.bytes[73] = 64;
    let mut cursor: |capabilities|::CapabilityIterator = |capabilities|::capability_iterator(64);
    let first: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let skipped: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let unknown: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let cycle: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let end: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let mut exhausted: |capabilities|::CapabilityIterator = |capabilities|::capability_iterator(64);
    exhausted.steps = 48;
    let budget: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut exhausted);
    let mut bad: |capabilities|::CapabilityIterator = |capabilities|::capability_iterator(65);
    let unaligned: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut bad);
    let mut low: |capabilities|::CapabilityIterator = |capabilities|::capability_iterator(60);
    let below: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut low);
    let mut high: |capabilities|::CapabilityIterator = |capabilities|::capability_iterator(256);
    let above: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut high);
    first.status == 1 && first.id == 5 && first.control == 128 && skipped.status == 2 &&
    unknown.status == 1 && unknown.id == 254 && !|capabilities|::capability_known(254) && |capabilities|::capability_known(17) &&
    budget.status == 4 && cycle.status == 4 && end.status == 3 && cursor.steps == 3 && unaligned.status == 4 && below.status == 4 && above.status == 4
}
machine extended_cases() -> bool {
    let mut value: |snapshot|::ConfigSnapshot;
    value.length = 4096;
    value.bytes[256] = 1; value.bytes[258] = 0xc2; value.bytes[259] = 0xff;
    value.bytes[4092] = 0x23; value.bytes[4093] = 1; value.bytes[4094] = 3;
    let mut cursor: |capabilities|::CapabilityIterator = |capabilities|::extended_capability_iterator();
    let first: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let last: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let end: |capabilities|::CapabilityStep = |capabilities|::capability_next(&value, &mut cursor);
    let mut short: |snapshot|::ConfigSnapshot;
    short.length = 256;
    let mut missing: |capabilities|::CapabilityIterator = |capabilities|::extended_capability_iterator();
    let truncated: |capabilities|::CapabilityStep = |capabilities|::capability_next(&short, &mut missing);
    first.status == 1 && first.id == 1 && first.version == 2 && first.next_offset == 4092 &&
    last.status == 1 && last.id == 0x123 && last.version == 3 && last.next_offset == 0 && end.status == 3 && truncated.status == 4
}
machine msi_cases() -> bool {
    let fields32: |msi|::MsiOffsets = |msi|::msi_offsets(64, 0x106);
    let fields64: |msi|::MsiOffsets = |msi|::msi_offsets(64, 0x186);
    let plan: |snapshot|::ConfigPlan = |msi|::msi_message_plan(64, 0x186, 0xfee00000, 0x4040);
    let transformed: |msi|::ControlResult = |msi|::msi_set_multiple_message_enable(0x186, 2);
    let control: |snapshot|::ConfigPlan = |msi|::msi_control_plan(64, transformed.raw);
    let enabled: u16 = |msi|::msi_set_enabled(0x186, true);
    let disabled: u16 = |msi|::msi_set_enabled(0x187, false);
    |msi|::msi_capability(0x186).ok && !|msi|::msi_capability(0x18e).ok && !|msi|::msi_capability(0x130).ok &&
    |msi|::msi_set_multiple_message_enable(0x186, 2).ok && |msi|::msi_set_multiple_message_enable(0x186, 2).raw == 0x1a6 &&
    !|msi|::msi_set_multiple_message_enable(0x186, 4).ok && control.operations[0].width == 2 &&
    control.operations[0].offset == 66 && control.operations[0].value == 0x1a6 &&
    |msi|::msi_enabled(enabled) && !|msi|::msi_enabled(disabled) &&
    |msi|::multiple_message_support(5).count == 32 && !|msi|::multiple_message_support(6).ok &&
    fields32.ok && fields32.mask == 76 && fields32.pending == 80 && fields32.data == 72 &&
    fields64.ok && fields64.mask == 80 && fields64.pending == 84 && fields64.data == 76 &&
    !|msi|::msi_offsets(252, 0).ok && !|msi|::msi_offsets(65, 0).ok &&
    plan.ok && plan.count == 3 && plan.requires_interrupts_disabled && plan.operations[2].width == 2 &&
    plan.operations[2].offset == 76 && plan.operations[2].value == 0x4040 &&
    !|msi|::msi_message_plan(64, 0, 0x100000000, 0).ok && !|msi|::msi_message_plan(64, 0, 1, 0).ok &&
    |msi|::lapic_message_data(64, 3).raw == 0xc040 && !|msi|::lapic_message_data(64, 1).ok &&
    |msi|::msi_mask_plan(64, 0x106, 0x80000000).ok && |msi|::msi_mask_read_plan(64, 0x106).operations[0].offset == 76 &&
    |msi|::msi_pending_read_plan(64, 0x106).operations[0].offset == 80 && !|msi|::msi_pending_read_plan(64, 0x80).ok &&
    |msi|::msi_is_pending(0x80000000, 31) && !|msi|::msi_is_pending(0x80000000, 32)
}
machine msix_cases() -> bool {
