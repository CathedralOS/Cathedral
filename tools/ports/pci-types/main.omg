    pba.ok && pba.bar == 4 && pba.offset == 32768 && pba.bytes == 256 &&
    |msix|::msix_region_fits(table, 36864, true) && !|msix|::msix_region_fits(table, 36863, true) &&
    !|msix|::msix_region_fits(table, 36864, false) && !|msix|::msix_table(invalid).ok &&
    |msix|::msix_pending_bit_array(partial).bytes == 16 &&
    plan.ok && plan.operations[0].width == 2 && plan.operations[0].value == 0xc7ff && !|msix|::msix_control_plan(248, 0).ok
