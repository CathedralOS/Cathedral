// Modified translation of pinned feature/layout tests plus Cathedral boundary fixtures.
use {cathedral_virtio}/common.omg;
use {cathedral_virtio}/features.omg;
use {cathedral_virtio}/notifications.omg;
use {cathedral_virtio}/configuration.omg;
use {cathedral_virtio}/split.omg;
use {cathedral_virtio}/raw_blk.omg;
use {cathedral_virtio}/raw_net.omg;
use {cathedral_virtio}/raw_console.omg;
use {cathedral_virtio}/raw_balloon.omg;
use {cathedral_virtio}/raw_fs.omg;
use {cathedral_virtio}/raw_vsock.omg;

machine facts_cases() -> bool {
    let unknown: |common|::Id = |common|::Id { raw: 255 };
    let status: |common|::DeviceStatus = |common|::DeviceStatus { raw: 255 };
    let isr: |configuration|::IsrStatus = |configuration|::IsrStatus { raw: 255 };
    |common|::Id_known(|common|::Id { raw: 49 }) && !|common|::Id_known(unknown) && unknown.raw == 255 && !|common|::Id_known(|common|::Id { raw: 15 }) &&
    status.raw == 255 && |common|::STATUS_ACKNOWLEDGE.raw == 1 && |common|::STATUS_DRIVER.raw == 2 &&
    |common|::STATUS_DRIVER_OK.raw == 4 && |common|::STATUS_FEATURES_OK.raw == 8 && |common|::STATUS_FAILED.raw == 128 &&
    |common|::RingEventFlags_known(|common|::RingEventFlags { raw: 3 }) && !|common|::RingEventFlags_known(|common|::RingEventFlags { raw: 4 }) &&
    |configuration|::isr_queue(isr) && |configuration|::isr_configuration(isr) && |raw_console|::Device_known(|raw_console|::Device { raw: 7 }) &&
    !|raw_console|::Device_known(|raw_console|::Device { raw: 256 }) && |raw_net|::HashReport_known(|raw_net|::HashReport { raw: 9 }) &&
    !|raw_net|::HashReport_known(|raw_net|::HashReport { raw: 256 }) && |raw_blk|::PreEolInfo_known(|raw_blk|::PreEolInfo { raw: 3 }) &&
    !|raw_blk|::PreEolInfo_known(|raw_blk|::PreEolInfo { raw: 256 })
}
// All assertions from upstream features::tests::requirements_satisfied.
machine feature_requirement_cases() -> bool {
    |features|::net_requirements_satisfied(|features|::Features { low: 0x10000000 }) &&
    |features|::net_requirements_satisfied(|features|::Features { low: 1 }) &&
    !|features|::net_requirements_satisfied(|features|::Features { low: 0x400000 }) &&
    |features|::net_requirements_satisfied(|features|::Features { low: 0x420000 }) &&
    !|features|::net_requirements_satisfied(|features|::Features { low: 0x800 }) &&
    |features|::net_requirements_satisfied(|features|::Features { low: 0x801 }) &&
    |features|::net_requirements_satisfied(|features|::Features { low: 0x1801 }) &&
    !|features|::net_requirements_satisfied(|features|::Features { low: 0x2000 }) &&
    !|features|::net_requirements_satisfied(|features|::Features { low: 0x2001 }) &&
    !|features|::net_requirements_satisfied(|features|::Features { low: 0x2800 }) &&
    |features|::net_requirements_satisfied(|features|::Features { low: 0x2801 }) &&
    |features|::net_requirements_satisfied(|features|::Features { low: 0x3801 }) &&
    !|features|::net_requirements_satisfied(|features|::NET_RSS_CONTEXT) &&
    |features|::net_requirements_satisfied(|features|::Features { low: 0x1000000000020000, high: 1 }) &&
    !|features|::net_requirements_satisfied(|features|::Features { high: 2 }) &&
    !|features|::net_recommendations_satisfied(|features|::Features { low: 0x200000000000000 }) &&
    |features|::net_recommendations_satisfied(|features|::Features { low: 0x200000000020000 })
}
machine feature_word_cases() -> bool {
    let value: |features|::Features = |features|::feature_from_words(0x89abcdef, 0x12345678, 0xfedcba98, 0x80000000);
    let complement: |features|::Features = |features|::features_complement(value);
    let all: |features|::Features = |features|::features_union(value, complement);
    let empty: |features|::Features = |features|::features_intersection(value, complement);
    let cleared: |features|::Features = |features|::features_difference(all, value);
    let toggled: |features|::Features = |features|::features_toggle(value, value);
    let set: |features|::Features = |features|::features_set(empty, |features|::NET_IPSEC, true);
    let removed: |features|::Features = |features|::features_set(set, |features|::NET_IPSEC, false);
    let supported: |features|::Features = |features|::Features { low: 0x100000001, high: 64 };
    let selected: |features|::NegotiatedFeatures = |features|::negotiate_features(all, supported, |features|::COMMON_VERSION_1, true, true);
    let rejected: |features|::NegotiatedFeatures = |features|::negotiate_features(|features|::Features { low: 1 }, supported, |features|::COMMON_VERSION_1, false, true);
    |features|::feature_word(value, 0).value == 0x89abcdef && |features|::feature_word(value, 1).value == 0x12345678 &&
    |features|::feature_word(value, 2).value == 0xfedcba98 && |features|::feature_word(value, 3).value == 0x80000000 &&
    !|features|::feature_word(value, 4).ok && |features|::feature_has(value, 127) && !|features|::feature_has(value, 128) &&
    |features|::features_all(all) && |features|::features_empty(empty) && |features|::features_equal(cleared, complement) && |features|::features_empty(toggled) &&
    |features|::features_contains(set, |features|::NET_IPSEC) && |features|::features_intersects(set, |features|::NET_IPSEC) && |features|::features_empty(removed) &&
    selected.ok && selected.value.low == 0x100000001 && selected.value.high == 64 && !rejected.ok
}
machine notification_cases() -> bool {
    let value: |notifications|::NotificationData = |notifications|::notification_split(0xabcd, 0xffff);
    let packed: |notifications|::NotificationResult = |notifications|::notification_packed(0xabcd, 32767, 1);
    let changed: |notifications|::NotificationData = |notifications|::notification_with_next_idx(value, 0x1234);
    let mut assigned: |notifications|::NotificationData = value;
    |notifications|::notification_set_next_idx(&mut assigned, 7);
    value.raw == 0xffffabcd && |notifications|::notification_queue(value) == 0xabcd && |notifications|::notification_next_idx(value) == 65535 &&
    |notifications|::notification_next_off(value) == 32767 && |notifications|::notification_next_wrap(value) == 1 && packed.ok && packed.value.raw == value.raw &&
    !|notifications|::notification_packed(0, 32768, 0).ok && !|notifications|::notification_packed(0, 0, 2).ok &&
    changed.raw == 0x1234abcd && assigned.raw == 0x0007abcd &&
    |configuration|::config_observation_consistent(255, 255) && !|configuration|::config_observation_consistent(255, 0) &&
    |configuration|::combine_address(0x89abcdef, 0x12345678) == 0x1234567889abcdef &&
    |configuration|::address_low(0x1234567889abcdef) == 0x89abcdef && |configuration|::address_high(0x1234567889abcdef) == 0x12345678 &&
    |configuration|::block_queue_count(0, 2) == 512
}
machine layout_case(size: u16, event_idx: bool, avail_bytes: u32, used_bytes: u32, wire_bytes: u32) -> bool {
    let layout: |split|::SplitLayout = |split|::split_layout(size, event_idx);
    let avail: |split|::AllocationPlan = |split|::avail_allocation_plan(size, event_idx);
    let used: |split|::AllocationPlan = |split|::used_allocation_plan(size, event_idx);
    layout.avail_bytes == avail_bytes && layout.used_allocation_bytes == used_bytes && layout.used_wire_bytes == wire_bytes &&
    avail.bytes == avail_bytes && avail.alignment == 2 && avail.zero_initialize &&
    used.bytes == used_bytes && used.alignment == 4 && used.zero_initialize
}
// The six q/event combinations in each upstream allocation test, including
// non-power-of-two counts: raw layout construction is not queue admission.
machine layout_cases() -> bool {
    layout_case(255, false, 514, 2044, 2044) && layout_case(255, true, 516, 2048, 2046) &&
    layout_case(256, false, 516, 2052, 2052) && layout_case(256, true, 518, 2056, 2054) &&
    layout_case(257, false, 518, 2060, 2060) && layout_case(257, true, 520, 2064, 2062) &&
    layout_case(0, false, 4, 4, 4) && layout_case(0, true, 6, 8, 6) &&
    layout_case(65535, true, 131076, 524288, 524286)
}
machine ring_arithmetic_cases() -> bool {
    let avail: |split|::RingSlot = |split|::avail_slot(256, 65535);
    let used: |split|::RingSlot = |split|::used_slot(256, 65535);
    |split|::split_queue_size_valid(1) && |split|::split_queue_size_valid(32768) && !|split|::split_queue_size_valid(0) &&
    !|split|::split_queue_size_valid(3) && !|split|::split_queue_size_valid(32769) && !|split|::split_queue_size_valid(65535) &&
    avail.ok && avail.index == 255 && avail.byte_offset == 514 && used.byte_offset == 2044 &&
    !|split|::avail_slot(0, 0).ok && |split|::index_add(65535, 1) == 0 && |split|::index_add(65535, 65535) == 65534 &&
    |split|::index_distance(0, 65535) == 1 && |split|::index_distance(65535, 0) == 65535 &&
    |split|::event_needed(65535, 0, 65535) && !|split|::event_needed(0, 0, 65535) &&
    |split|::event_needed(9, 11, 9) && |split|::event_needed(10, 11, 9) && !|split|::event_needed(11, 11, 9) &&
    !|split|::event_needed(10, 10, 10) && |split|::split_notify(false, 0, 0, 0, 0) && !|split|::split_notify(false, 0, 1, 0, 0) &&
    |split|::split_notify(true, 65535, 1, 0, 65535)
}
machine ring_view_cases() -> bool {
    let used: |split|::RingView = |split|::used_ring_view(256, true, 2056, 0x1000);
    let event: |split|::RingView = |split|::avail_event_view(256, true, 2056, 0x1000);
    let avail: |split|::RingView = |split|::avail_ring_view(256, true, 518, 0x1000);
    let used_event: |split|::RingView = |split|::used_event_view(256, true, 518, 0x1000);
    used.ok && used.offset == 4 && used.length == 2048 && used.count == 256 && used.element_bytes == 8 &&
    event.ok && event.offset == 2052 && event.length == 2 && avail.ok && used_event.ok && used_event.offset == 516 &&
    !|split|::avail_ring_view(0, false, 0, 0).ok && !|split|::avail_ring_view(0, false, 2, 0).ok &&
    !|split|::used_ring_view(0, true, 0, 0).ok && !|split|::used_ring_view(256, true, 2056, 2).ok &&
    !|split|::avail_ring_view(256, true, 518, 1).ok && !|split|::used_ring_view(256, true, 2054, 0).ok &&
    !|split|::avail_event_view(256, false, 2052, 0).ok && !|split|::used_event_view(256, false, 516, 0).ok
}
machine descriptor_cases() -> bool {
    let value: |split|::Desc = |split|::Desc { addr: 0x0123456789abcdef, len: 0x10203040, flags: 3, next: 7 };
    let bytes: [u8; 16] = |split|::descriptor_encode(value);
    let decoded: |split|::Desc = |split|::descriptor_decode(bytes);
    let direct: |split|::Desc = |split|::Desc { addr: 0x1000, len: 4096, flags: 3, next: 7 };
    let indirect: |split|::Desc = |split|::Desc { addr: 0x1000, len: 32, flags: 4 };
    bytes[0] == 0xef && bytes[7] == 1 && bytes[8] == 0x40 && bytes[11] == 0x10 && bytes[12] == 3 && bytes[14] == 7 &&
    decoded.addr == value.addr && decoded.len == value.len && decoded.flags == value.flags && decoded.next == value.next &&
    |split|::descriptor_valid(direct, 8, false) && !|split|::descriptor_valid(direct, 4, false) &&
    |split|::descriptor_valid(indirect, 8, true) && !|split|::descriptor_valid(indirect, 8, false) &&
    !|split|::descriptor_valid(|split|::Desc { addr: 0x1000, len: 16, flags: 5 }, 8, true) &&
    !|split|::descriptor_valid(|split|::Desc { addr: 0x1008, len: 16, flags: 4 }, 8, true) &&
    !|split|::descriptor_valid(|split|::Desc { addr: 0x1000, len: 15, flags: 4 }, 8, true) &&
    !|split|::descriptor_valid(|split|::Desc { addr: 0x1000, len: 0, flags: 4 }, 8, true) &&
    !|split|::descriptor_valid(|split|::Desc { addr: 0xfffffffffffffff0, len: 16 }, 8, false) &&
    !|split|::descriptor_valid(|split|::Desc { flags: 128 }, 8, false) &&
    |split|::used_element_valid(|split|::UsedElem { id: 7, len: 4096 }, 8, 4096) &&
    !|split|::used_element_valid(|split|::UsedElem { id: 8 }, 8, 4096) && !|split|::used_element_valid(|split|::UsedElem { id: 0, len: 4097 }, 8, 4096)
}
machine test_result() -> i32 {
    transition facts_cases() && feature_requirement_cases() && feature_word_cases() && notification_cases() &&
      layout_cases() && ring_arithmetic_cases() && ring_view_cases() && descriptor_cases() { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
