use {cathedral_virtio}/features.omg;
use {cathedral_virtio}/packed.omg;
use {cathedral_virtio}/simulator.omg;

machine session_for(features: |features|::Features) -> |simulator|::DeviceSession {
    let initial: |simulator|::DeviceSession = |simulator|::DeviceSession { offered: features };
    let ack: |simulator|::SessionResult = |simulator|::device_acknowledge(initial);
    let driver: |simulator|::SessionResult = |simulator|::device_driver(ack.session);
    let negotiated: |simulator|::SessionResult = |simulator|::device_negotiate(driver.session, features, |features|::Features { low: 0x100000000 }, false);
    let ready: |simulator|::SessionResult = |simulator|::device_ready(negotiated.session);
    ready.session
}
machine negotiation_cases() -> bool {
    let features: |features|::Features = |features|::Features { low: 0x520000000, high: 64 };
    let initial: |simulator|::DeviceSession = |simulator|::DeviceSession { offered: features };
    let ack: |simulator|::SessionResult = |simulator|::device_acknowledge(initial);
    let driver: |simulator|::SessionResult = |simulator|::device_driver(ack.session);
    let negotiated: |simulator|::SessionResult = |simulator|::device_negotiate(driver.session, features, |features|::Features { low: 0x100000000 }, true);
    let ready: |simulator|::SessionResult = |simulator|::device_ready(negotiated.session);
    let reset: |simulator|::DeviceSession = |simulator|::device_reset(ready.session);
    let bad: |simulator|::SessionResult = |simulator|::device_negotiate(|simulator|::DeviceSession { status: 3, offered: |features|::Features { low: 0x100000800 } }, |features|::Features { low: 0x100000800 }, |features|::Features {}, true);
    !|simulator|::device_driver(initial).ok && !|simulator|::device_ready(initial).ok && ack.ok && ack.session.status == 1 &&
    driver.ok && driver.session.status == 3 && negotiated.ok && negotiated.session.status == 11 &&
    ready.ok && ready.session.status == 15 && ready.session.accepted.high == 64 &&
    reset.status == 0 && reset.accepted.low == 0 && reset.accepted.high == 0 && reset.offered.high == 64 &&
    !bad.ok && bad.session.status == 131 && !|simulator|::device_ready(bad.session).ok &&
    !|simulator|::device_negotiate(initial, features, |features|::Features {}, false).ok
}
machine split_cases() -> bool {
    let session: |simulator|::DeviceSession = session_for(|features|::Features { low: 0x120000000 });
    let created: |simulator|::QueueStep = |simulator|::queue_create(session, 2);
    let first: |simulator|::QueueStep = |simulator|::queue_submit(created.queue, 1, 64, true, |packed|::EventSuppress {}, 0, 1);
    let duplicate: |simulator|::QueueStep = |simulator|::queue_submit(first.queue, 1, 8, false, |packed|::EventSuppress {}, 1, 0);
    let second: |simulator|::QueueStep = |simulator|::queue_submit(first.queue, 0, 8, false, |packed|::EventSuppress {}, 1, 0);
    let full: |simulator|::QueueStep = |simulator|::queue_submit(second.queue, 0, 8, false, |packed|::EventSuppress {}, 2, 0);
    let bad_length: |simulator|::QueueStep = |simulator|::queue_process(second.queue, 65);
    let done1: |simulator|::QueueStep = |simulator|::queue_process(second.queue, 64);
    let readonly: |simulator|::QueueStep = |simulator|::queue_process(done1.queue, 1);
    let done2: |simulator|::QueueStep = |simulator|::queue_process(done1.queue, 0);
    let reap1: |simulator|::QueueStep = |simulator|::queue_reap(done2.queue);
    let reap2: |simulator|::QueueStep = |simulator|::queue_reap(reap1.queue);
    let reused: |simulator|::QueueStep = |simulator|::queue_submit(reap2.queue, 1, 0, false, |packed|::EventSuppress {}, 2, 0);
    created.ok && first.ok && first.notification && first.queue.available[0] == 1 && first.queue.descriptors[1].bytes == 64 &&
    !duplicate.ok && duplicate.queue.inflight == 1 && second.ok && second.queue.inflight == 2 && !full.ok &&
    !bad_length.ok && bad_length.queue.queued == 2 && done1.ok && done1.completion.id == 1 && done1.completion.bytes == 64 &&
    !readonly.ok && done2.ok && done2.completion.id == 0 && done2.queue.completed == 2 && done2.queue.queued == 0 &&
    reap1.ok && reap1.completion.id == 1 && reap2.ok && reap2.completion.id == 0 && reap2.queue.inflight == 0 &&
    !reap2.queue.busy[0] && !reap2.queue.busy[1] && !|simulator|::queue_reap(reap2.queue).ok && reused.ok && |simulator|::queue_well_formed(reused.queue)
}
machine packed_cases() -> bool {
    let session: |simulator|::DeviceSession = session_for(|features|::Features { low: 0x520000000 });
    let created: |simulator|::QueueStep = |simulator|::queue_create(session, 3);
    let a: |simulator|::QueueStep = |simulator|::queue_submit(created.queue, 7, 16, true, |packed|::EventSuppress {}, 0, 0);
    let b: |simulator|::QueueStep = |simulator|::queue_submit(a.queue, 5, 8, false, |packed|::EventSuppress {}, 0, 0);
    let c: |simulator|::QueueStep = |simulator|::queue_submit(b.queue, 0, 8, true, |packed|::EventSuppress {}, 0, 0);
    let d1: |simulator|::QueueStep = |simulator|::queue_process(c.queue, 16);
    let d2: |simulator|::QueueStep = |simulator|::queue_process(d1.queue, 0);
    let d3: |simulator|::QueueStep = |simulator|::queue_process(d2.queue, 8);
    let r1: |simulator|::QueueStep = |simulator|::queue_reap(d3.queue);
    let r2: |simulator|::QueueStep = |simulator|::queue_reap(r1.queue);
    let r3: |simulator|::QueueStep = |simulator|::queue_reap(r2.queue);
    let next: |simulator|::QueueStep = |simulator|::queue_submit(r3.queue, 7, 1, false, |packed|::EventSuppress {}, 0, 0);
    let completed: |simulator|::QueueStep = |simulator|::queue_process(next.queue, 0);
    let reaped: |simulator|::QueueStep = |simulator|::queue_reap(completed.queue);
    created.ok && created.queue.packed && a.ok && b.ok && c.ok && c.queue.producer.offset == 0 && c.queue.producer.wrap == 0 &&
    c.queue.descriptors[0].flags == 130 && c.queue.descriptors[1].id == 5 && c.queue.descriptors[2].id == 0 &&
    d1.ok && d1.queue.descriptors[0].flags == 32898 && d2.ok && d3.ok && d3.queue.consumer.wrap == 0 &&
    r1.ok && r1.completion.id == 7 && r2.completion.id == 5 && r3.completion.id == 0 && r3.queue.reaper.wrap == 0 &&
    next.ok && next.queue.descriptors[0].flags == 32768 && completed.ok && completed.queue.descriptors[0].flags == 0 &&
    reaped.ok && reaped.completion.id == 7 && reaped.queue.inflight == 0 && |simulator|::queue_well_formed(reaped.queue)
}
machine counter_cases() -> bool {
    let session: |simulator|::DeviceSession = session_for(|features|::Features { low: 0x100000000 });
    let created: |simulator|::QueueStep = |simulator|::queue_create(session, 2);
    let mut queue: |simulator|::QueueSimulation = created.queue;
    queue.produced = 65535; queue.consumed = 65535; queue.reaped = 65535;
    queue.producer = |packed|::Cursor { offset: 1, wrap: 0 }; queue.consumer = |packed|::Cursor { offset: 1, wrap: 0 }; queue.reaper = |packed|::Cursor { offset: 1, wrap: 0 };
    let submit: |simulator|::QueueStep = |simulator|::queue_submit(queue, 0, 0, false, |packed|::EventSuppress {}, 0, 0);
    let done: |simulator|::QueueStep = |simulator|::queue_process(submit.queue, 0);
    let reap: |simulator|::QueueStep = |simulator|::queue_reap(done.queue);
    submit.ok && submit.queue.produced == 0 && submit.queue.producer.offset == 0 && submit.queue.producer.wrap == 1 &&
    done.ok && done.queue.consumed == 0 && reap.ok && reap.queue.reaped == 0 && reap.queue.inflight == 0
}
machine notification_cases() -> bool {
    let split_session: |simulator|::DeviceSession = session_for(|features|::Features { low: 0x100000000 });
    let split_queue: |simulator|::QueueStep = |simulator|::queue_create(split_session, 1);
    let suppressed: |simulator|::QueueStep = |simulator|::queue_submit(split_queue.queue, 0, 1, false, |packed|::EventSuppress {}, 0, 1);
    let packed_session: |simulator|::DeviceSession = session_for(|features|::Features { low: 0x520000000 });
    let packed_queue: |simulator|::QueueStep = |simulator|::queue_create(packed_session, 3);
    let event: |packed|::EventSuppress = |packed|::EventSuppress { desc: |packed|::EventSuppressDesc { raw: 32768 }, flags: |packed|::EventSuppressFlags { raw: 2 } };
    let targeted: |simulator|::QueueStep = |simulator|::queue_submit(packed_queue.queue, 0, 1, false, event, 0, 0);
    let future: |packed|::EventSuppress = |packed|::EventSuppress { desc: |packed|::EventSuppressDesc { raw: 32769 }, flags: |packed|::EventSuppressFlags { raw: 2 } };
    let not_crossed: |simulator|::QueueStep = |simulator|::queue_submit(packed_queue.queue, 0, 1, false, future, 0, 0);
    let disabled: |simulator|::QueueStep = |simulator|::queue_submit(packed_queue.queue, 0, 1, false, |packed|::EventSuppress { flags: |packed|::EventSuppressFlags { raw: 1 } }, 0, 0);
    let no_event_session: |simulator|::DeviceSession = session_for(|features|::Features { low: 0x500000000 });
    let no_event_queue: |simulator|::QueueStep = |simulator|::queue_create(no_event_session, 3);
    let invalid: |simulator|::QueueStep = |simulator|::queue_submit(no_event_queue.queue, 0, 1, false, event, 0, 0);
    suppressed.ok && !suppressed.notification && targeted.ok && targeted.notification && not_crossed.ok && !not_crossed.notification &&
    disabled.ok && !disabled.notification && !invalid.ok && invalid.queue.inflight == 0 && invalid.queue.produced == 0
}
machine validation_cases() -> bool {
    let session: |simulator|::DeviceSession = session_for(|features|::Features { low: 0x100000000 });
    let created: |simulator|::QueueStep = |simulator|::queue_create(session, 2);
    let submitted: |simulator|::QueueStep = |simulator|::queue_submit(created.queue, 0, 8, true, |packed|::EventSuppress {}, 0, 0);
    let reset: |simulator|::QueueSimulation = |simulator|::queue_reset(submitted.queue);
    let mut malformed: |simulator|::QueueSimulation = created.queue; malformed.inflight = 9;
    let mut leaked: |simulator|::QueueSimulation = created.queue; leaked.busy[7] = true;
    !|simulator|::queue_create(session, 0).ok && !|simulator|::queue_create(session, 3).ok && !|simulator|::queue_create(session, 9).ok &&
    !|simulator|::queue_create(|simulator|::DeviceSession { status: 11 }, 1).ok && !|simulator|::queue_create(|simulator|::DeviceSession { status: 15 }, 1).ok && !|simulator|::queue_well_formed(leaked) && !|simulator|::queue_submit(created.queue, 2, 0, false, |packed|::EventSuppress {}, 0, 0).ok &&
    !|simulator|::queue_submit(created.queue, 8, 0, false, |packed|::EventSuppress {}, 0, 0).ok && !|simulator|::queue_process(created.queue, 0).ok &&
    !|simulator|::queue_well_formed(malformed) && !|simulator|::queue_submit(malformed, 0, 0, false, |packed|::EventSuppress {}, 0, 0).ok &&
    submitted.ok && !reset.active && reset.inflight == 0 && !reset.busy[0] && !|simulator|::queue_process(reset, 0).ok
}
machine test_result() -> i32 {
    transition negotiation_cases() && split_cases() && packed_cases() && counter_cases() && notification_cases() && validation_cases() { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
