use {cathedral_virtio}/packed.omg;
use {cathedral_virtio}/notifications.omg;

machine cursor_cases() -> bool {
    let next: |packed|::CursorResult = |packed|::advance(3, |packed|::Cursor { offset: 2, wrap: 1 }, 1);
    let multi: |packed|::CursorResult = |packed|::advance(3, |packed|::Cursor { offset: 2, wrap: 1 }, 5);
    let single: |packed|::CursorResult = |packed|::advance(1, |packed|::Cursor { wrap: 1 }, 65535);
    let max: |packed|::CursorResult = |packed|::advance(32768, |packed|::Cursor { offset: 32767, wrap: 1 }, 1);
    let delta: |packed|::DistanceResult = |packed|::distance(3, |packed|::Cursor { offset: 2, wrap: 1 }, |packed|::Cursor { offset: 1 });
    |packed|::queue_size_valid(3) && |packed|::queue_size_valid(32768) && !|packed|::queue_size_valid(0) && !|packed|::queue_size_valid(32769) &&
    next.ok && next.value.offset == 0 && next.value.wrap == 0 && multi.value.offset == 1 && multi.value.wrap == 1 &&
    single.value.offset == 0 && single.value.wrap == 0 && max.value.offset == 0 && max.value.wrap == 0 &&
    delta.ok && delta.value == 2 && !|packed|::distance(0, |packed|::Cursor {}, |packed|::Cursor {}).ok &&
    !|packed|::advance(3, |packed|::Cursor { offset: 3, wrap: 1 }, 0).ok && !|packed|::advance(1, |packed|::Cursor { wrap: 2 }, 0).ok
}
machine flag_cases() -> bool {
    let avail1: |packed|::FlagsResult = |packed|::available_flags(3, 1);
    let avail0: |packed|::FlagsResult = |packed|::available_flags(2, 0);
    let used1: |packed|::FlagsResult = |packed|::used_flags(2, 1);
    let used0: |packed|::FlagsResult = |packed|::used_flags(0, 0);
    avail1.ok && avail1.value == 131 && avail0.value == 32770 && used1.value == 32898 && used0.value == 0 &&
    |packed|::descriptor_available(avail1.value, 1) && !|packed|::descriptor_used(avail1.value, 1) &&
    |packed|::descriptor_available(avail0.value, 0) && !|packed|::descriptor_available(avail0.value, 1) &&
    |packed|::descriptor_used(used1.value, 1) && |packed|::descriptor_used(used0.value, 0) &&
    !|packed|::descriptor_used(0, 1) && !|packed|::descriptor_available(0, 1) && !|packed|::descriptor_used(0, 2) &&
    !|packed|::available_flags(128, 1).ok && !|packed|::used_flags(0, 2).ok
}
machine event_cases() -> bool {
    let all: |packed|::EventResult = |packed|::event_construct(|packed|::Cursor { offset: 32767, wrap: 1 }, 3);
    let value: |packed|::EventResult = |packed|::event_construct(|packed|::Cursor { offset: 2, wrap: 1 }, 2);
    let notification: |notifications|::NotificationResult = |notifications|::notification_packed(0x1234, 32767, 1);
    let bytes: [u8; 4] = |packed|::event_encode(all.value);
    let decoded: |packed|::EventSuppress = |packed|::event_decode(bytes);
    all.ok && all.value.desc.raw == 65535 && all.value.flags.raw == 3 &&
    |packed|::event_offset(all.value.desc) == 32767 && |packed|::event_wrap(all.value.desc) == 1 &&
    |packed|::event_flags(|packed|::EventSuppressFlags { raw: 65535 }) == 3 && |packed|::event_reserved(|packed|::EventSuppressFlags { raw: 65535 }) == 16383 &&
    bytes[0] == 255 && bytes[1] == 255 && bytes[2] == 3 && bytes[3] == 0 && decoded.desc.raw == 65535 &&
    !|packed|::event_valid(all.value, 32768, true) && |packed|::event_valid(value.value, 3, true) && !|packed|::event_valid(value.value, 3, false) &&
    !|packed|::event_valid(value.value, 2, true) && !|packed|::event_valid(|packed|::EventSuppress { flags: |packed|::EventSuppressFlags { raw: 4 } }, 3, true) &&
    !|packed|::event_construct(|packed|::Cursor { offset: 32768 }, 0).ok && !|packed|::event_construct(|packed|::Cursor { wrap: 2 }, 0).ok &&
    !|packed|::event_construct(|packed|::Cursor {}, 4).ok && notification.ok && notification.value.raw == 0xffff1234
}
machine notify_cases() -> bool {
    let old: |packed|::Cursor = |packed|::Cursor { offset: 2, wrap: 1 };
    let new: |packed|::Cursor = |packed|::Cursor { offset: 1, wrap: 0 };
    let crossed: |packed|::EventResult = |packed|::event_construct(|packed|::Cursor { offset: 0, wrap: 0 }, 2);
    let first: |packed|::EventResult = |packed|::event_construct(old, 2);
    let next: |packed|::EventResult = |packed|::event_construct(new, 2);
    let previous_epoch: |packed|::EventResult = |packed|::event_construct(|packed|::Cursor { offset: 0, wrap: 1 }, 2);
    |packed|::notify(crossed.value, 3, true, old, new).notify && |packed|::notify(first.value, 3, true, old, new).notify &&
    !|packed|::notify(next.value, 3, true, old, new).notify && !|packed|::notify(previous_epoch.value, 3, true, old, new).notify &&
    !|packed|::notify(crossed.value, 3, true, old, old).notify && !|packed|::notify(crossed.value, 3, false, old, new).ok &&
    |packed|::notify(|packed|::EventSuppress {}, 3, false, old, old).notify &&
    !|packed|::notify(|packed|::EventSuppress { flags: |packed|::EventSuppressFlags { raw: 1 } }, 3, false, old, new).notify &&
    !|packed|::notify(|packed|::EventSuppress {}, 3, true, |packed|::Cursor { wrap: 1 }, |packed|::Cursor { offset: 2 }).ok &&
    !|packed|::notify(|packed|::EventSuppress {}, 3, true, |packed|::Cursor { offset: 3 }, new).ok
}
machine descriptor_cases() -> bool {
    let value: |packed|::Desc = |packed|::Desc { addr: 0x0123456789abcdef, len: 0x10203040, id: 0x7654, flags: 0x8082 };
    let bytes: [u8; 16] = |packed|::descriptor_encode(value);
    let decoded: |packed|::Desc = |packed|::descriptor_decode(bytes);
    bytes[0] == 0xef && bytes[7] == 1 && bytes[12] == 0x54 && bytes[13] == 0x76 && bytes[14] == 0x82 && bytes[15] == 0x80 &&
    decoded.addr == value.addr && decoded.id == value.id && decoded.flags == value.flags &&
    |packed|::descriptor_valid(value, false) && |packed|::descriptor_valid(|packed|::Desc { addr: 4096, len: 32, flags: 0x84 }, true) &&
    !|packed|::descriptor_valid(|packed|::Desc { addr: 4096, len: 32, flags: 0x84 }, false) &&
    !|packed|::descriptor_valid(|packed|::Desc { len: 32, flags: 0x85 }, true) && !|packed|::descriptor_valid(|packed|::Desc { len: 15, flags: 4 }, true) &&
    !|packed|::descriptor_valid(|packed|::Desc { flags: 4 }, true) && !|packed|::descriptor_valid(|packed|::Desc { flags: 8 }, false) &&
    !|packed|::descriptor_valid(|packed|::Desc { addr: 0xffffffffffffffff, len: 1 }, false) &&
    |packed|::indirect_element_valid(|packed|::Desc { flags: 2, id: 65535 }) && !|packed|::indirect_element_valid(|packed|::Desc { flags: 0x82 }) &&
    !|packed|::indirect_element_valid(|packed|::Desc { flags: 1 }) && !|packed|::indirect_element_valid(|packed|::Desc { flags: 4 })
}
machine test_result() -> i32 {
    transition cursor_cases() && flag_cases() && event_cases() && notify_cases() && descriptor_cases() { true -> (0) _ -> (1) }
}
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
