use {x86}/gdt_storage.omg;
use {x86}/addresses.omg;
use {facts}/x86_descriptors.omg;
machine added(value: |gdt_storage|::AppendResult, expected: u16) -> bool {
 transition value { |gdt_storage|::AppendResult::Added { selector } -> (selector.raw == expected) _ -> (false) }
}
machine number(value: |addresses|::NumberResult, expected: u64) -> bool {
 transition value { |addresses|::NumberResult::Value { value } -> (value == expected) _ -> (false) }
}

machine scenario() -> i32 {
 let mut table: |gdt_storage|::Table;
 table.words[8191] = 16045690984833335023;
 let mut input: [u64; 8192];
 input[1] = 18446744073709551615;
 input[3] = 4660;
 let initialized: bool = |gdt_storage|::import_words(&mut table, &input, 4, 8);
 let result0: |gdt_storage|::AppendResult = |gdt_storage|::append(&mut table, |x86_descriptors|::Descriptor::SystemSegment { low: 70368744177749, high: 72623859790382856 });
 let pass0: bool = added(result0, 34);
 let content0: bool = table.length == 6 && table.words[0] == 0 && table.words[1] == 18446744073709551615 && table.words[2] == 0 && table.words[3] == 4660 && table.words[4] == 70368744177749 && table.words[5] == 72623859790382856 && table.words[6] == 0 && table.words[8191] == 0;
 let limit0: |addresses|::NumberResult = |gdt_storage|::limit(&table);
 let bound0: bool = number(limit0, 47);
 let result1: |gdt_storage|::AppendResult = |gdt_storage|::append(&mut table, |x86_descriptors|::Descriptor::UserSegment { low: 99 });
 let pass1: bool = added(result1, 48);
 let content1: bool = table.length == 7 && table.words[0] == 0 && table.words[1] == 18446744073709551615 && table.words[2] == 0 && table.words[3] == 4660 && table.words[4] == 70368744177749 && table.words[5] == 72623859790382856 && table.words[6] == 99 && table.words[7] == 0 && table.words[8191] == 0;
 let limit1: |addresses|::NumberResult = |gdt_storage|::limit(&table);
 let bound1: bool = number(limit1, 55);
 let result2: |gdt_storage|::AppendResult = |gdt_storage|::append(&mut table, |x86_descriptors|::Descriptor::SystemSegment { low: 100, high: 101 });
 let pass2: bool = result2 in |gdt_storage|::AppendResult::Full;
 let content2: bool = table.length == 7 && table.words[0] == 0 && table.words[1] == 18446744073709551615 && table.words[2] == 0 && table.words[3] == 4660 && table.words[4] == 70368744177749 && table.words[5] == 72623859790382856 && table.words[6] == 99 && table.words[7] == 0 && table.words[8191] == 0;
 let limit2: |addresses|::NumberResult = |gdt_storage|::limit(&table);
 let bound2: bool = number(limit2, 55);
 let result3: |gdt_storage|::AppendResult = |gdt_storage|::append(&mut table, |x86_descriptors|::Descriptor::UserSegment { low: 100 });
 let pass3: bool = added(result3, 56);
 let content3: bool = table.length == 8 && table.words[0] == 0 && table.words[1] == 18446744073709551615 && table.words[2] == 0 && table.words[3] == 4660 && table.words[4] == 70368744177749 && table.words[5] == 72623859790382856 && table.words[6] == 99 && table.words[7] == 100 && table.words[8] == 0 && table.words[8191] == 0;
 let limit3: |addresses|::NumberResult = |gdt_storage|::limit(&table);
 let bound3: bool = number(limit3, 63);
 let last: |addresses|::NumberResult = |gdt_storage|::entry(&table, 7);
 let projection: bool = number(last, 100);
 let outside: |addresses|::NumberResult = |gdt_storage|::entry(&table, 8);
 transition initialized && table.capacity == 8 && pass0 && content0 && bound0 && pass1 && content1 && bound1 && pass2 && content2 && bound2 && pass3 && content3 && bound3 && projection && outside in |addresses|::NumberResult::Rejected { true -> (0) _ -> (1) }
}
const RESULT: i32 = scenario();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(RESULT); }
