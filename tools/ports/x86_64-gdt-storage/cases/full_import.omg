use x86::gdt_storage;
use x86::gdt_storage::Table;
use x86::gdt_storage::AppendResult;
use x86::addresses::NumberResult;
use facts::x86_descriptors::Descriptor;
machine added(value: AppendResult, expected: u16) -> bool {
 transition value { AppendResult::Added { selector } -> (selector.raw == expected) _ -> (false) }
}
machine number(value: NumberResult, expected: u64) -> bool {
 transition value { NumberResult::Value { value } -> (value == expected) _ -> (false) }
}

machine scenario() -> i32 {
 let mut table: Table;
 table.words[8191] = 16045690984833335023;
 let mut input: [u64; 8192];
 input[1] = 1;
 input[2] = 2;
 input[3] = 3;
 input[4] = 4;
 input[5] = 5;
 input[6] = 6;
 input[7] = 7;
 let initialized: bool = gdt_storage::import_words(&mut table, &input, 8, 8);
 let result0: AppendResult = gdt_storage::append(&mut table, Descriptor::UserSegment { low: 42 });
 let pass0: bool = result0 in AppendResult::Full;
 let content0: bool = table.length == 8 && table.words[0] == 0 && table.words[1] == 1 && table.words[2] == 2 && table.words[3] == 3 && table.words[4] == 4 && table.words[5] == 5 && table.words[6] == 6 && table.words[7] == 7 && table.words[8] == 0 && table.words[8191] == 0;
 let limit0: NumberResult = gdt_storage::limit(&table);
 let bound0: bool = number(limit0, 63);
 let result1: AppendResult = gdt_storage::append(&mut table, Descriptor::SystemSegment { low: 43, high: 44 });
 let pass1: bool = result1 in AppendResult::Full;
 let content1: bool = table.length == 8 && table.words[0] == 0 && table.words[1] == 1 && table.words[2] == 2 && table.words[3] == 3 && table.words[4] == 4 && table.words[5] == 5 && table.words[6] == 6 && table.words[7] == 7 && table.words[8] == 0 && table.words[8191] == 0;
 let limit1: NumberResult = gdt_storage::limit(&table);
 let bound1: bool = number(limit1, 63);
 let last: NumberResult = gdt_storage::entry(&table, 7);
 let projection: bool = number(last, 7);
 let outside: NumberResult = gdt_storage::entry(&table, 8);
 transition initialized && table.capacity == 8 && pass0 && content0 && bound0 && pass1 && content1 && bound1 && projection && outside in NumberResult::Rejected { true -> (0) _ -> (1) }
}
const RESULT: i32 = scenario();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(RESULT); }
