use x86::gdt_storage;
use x86::gdt_storage::Table;
use x86::gdt_storage::AppendResult;
use x86::addresses::NumberResult;
use facts::x86_descriptors::Descriptor;
machine added(value: AppendResult, expected: u16) -> bool {
 transition value { AppendResult::Added { selector } -> (selector.raw == expected) _ -> (false) }
}
machine number(value: NumberResult, expected: u64) -> bool {
 transition value { NumberResult::Value { value } -> (value == expected) _ -> (false) }
}

machine scenario() -> i32 {
 let mut table: Table;
 table.words[8191] = 16045690984833335023;
 let mut input: [u64; 8192];
 input[1] = 283686952306183;
 input[2] = 567373904612366;
 input[3] = 851060856918549;
 input[4] = 1134747809224732;
 input[5] = 1418434761530915;
 input[6] = 1702121713837098;
 input[7] = 1985808666143281;
 input[8] = 2269495618449464;
 input[9] = 2553182570755647;
 input[10] = 2836869523061830;
 input[11] = 3120556475368013;
 input[12] = 3404243427674196;
 input[13] = 3687930379980379;
 input[14] = 3971617332286562;
 let initialized: bool = gdt_storage::import_words(&mut table, &input, 15, 64);
 let result0: AppendResult = gdt_storage::append(&mut table, Descriptor::SystemSegment { low: 170, high: 187 });
 let pass0: bool = added(result0, 120);
 let content0: bool = table.length == 17 && table.words[0] == 0 && table.words[1] == 283686952306183 && table.words[2] == 567373904612366 && table.words[3] == 851060856918549 && table.words[4] == 1134747809224732 && table.words[5] == 1418434761530915 && table.words[6] == 1702121713837098 && table.words[7] == 1985808666143281 && table.words[8] == 2269495618449464 && table.words[9] == 2553182570755647 && table.words[10] == 2836869523061830 && table.words[11] == 3120556475368013 && table.words[12] == 3404243427674196 && table.words[13] == 3687930379980379 && table.words[14] == 3971617332286562 && table.words[15] == 170 && table.words[16] == 187 && table.words[17] == 0 && table.words[8191] == 0;
 let limit0: NumberResult = gdt_storage::limit(&table);
 let bound0: bool = number(limit0, 135);
 let last: NumberResult = gdt_storage::entry(&table, 16);
 let projection: bool = number(last, 187);
 let outside: NumberResult = gdt_storage::entry(&table, 17);
 transition initialized && table.capacity == 64 && pass0 && content0 && bound0 && projection && outside in NumberResult::Rejected { true -> (0) _ -> (1) }
}
const RESULT: i32 = scenario();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(RESULT); }
