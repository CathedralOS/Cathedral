use {x86}/gdt_storage.omg;
use {x86}/addresses.omg;
use {facts}/x86_descriptors.omg;
machine added(value: |gdt_storage|::AppendResult, expected: u16) -> bool {
 transition value { |gdt_storage|::AppendResult::Added { selector } -> (selector.raw == expected) _ -> (false) }
}
machine number(value: |addresses|::NumberResult, expected: u64) -> bool {
 transition value { |addresses|::NumberResult::Value { value } -> (value == expected) _ -> (false) }
}

machine scenario() -> i32 {
 let mut table: |gdt_storage|::Table;
 table.words[8191] = 16045690984833335023;
 let initialized: bool = |gdt_storage|::initialize(&mut table, 2);
 let result0: |gdt_storage|::AppendResult = |gdt_storage|::append(&mut table, |x86_descriptors|::Descriptor::SystemSegment { low: 7, high: 9 });
 let pass0: bool = result0 in |gdt_storage|::AppendResult::Full;
 let content0: bool = table.length == 1 && table.words[0] == 0 && table.words[1] == 0 && table.words[8191] == 0;
 let limit0: |addresses|::NumberResult = |gdt_storage|::limit(&table);
 let bound0: bool = number(limit0, 7);
 let result1: |gdt_storage|::AppendResult = |gdt_storage|::append(&mut table, |x86_descriptors|::Descriptor::UserSegment { low: 7 });
 let pass1: bool = added(result1, 8);
 let content1: bool = table.length == 2 && table.words[0] == 0 && table.words[1] == 7 && table.words[2] == 0 && table.words[8191] == 0;
 let limit1: |addresses|::NumberResult = |gdt_storage|::limit(&table);
 let bound1: bool = number(limit1, 15);
 let result2: |gdt_storage|::AppendResult = |gdt_storage|::append(&mut table, |x86_descriptors|::Descriptor::UserSegment { low: 9 });
 let pass2: bool = result2 in |gdt_storage|::AppendResult::Full;
 let content2: bool = table.length == 2 && table.words[0] == 0 && table.words[1] == 7 && table.words[2] == 0 && table.words[8191] == 0;
 let limit2: |addresses|::NumberResult = |gdt_storage|::limit(&table);
 let bound2: bool = number(limit2, 15);
 let last: |addresses|::NumberResult = |gdt_storage|::entry(&table, 1);
 let projection: bool = number(last, 7);
 let outside: |addresses|::NumberResult = |gdt_storage|::entry(&table, 2);
 transition initialized && table.capacity == 2 && pass0 && content0 && bound0 && pass1 && content1 && bound1 && pass2 && content2 && bound2 && projection && outside in |addresses|::NumberResult::Rejected { true -> (0) _ -> (1) }
}
const RESULT: i32 = scenario();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(RESULT); }
