use x86::encrypted_register_operands;
use x86::encrypted_register_operands::ObservedCr3;
use x86::register_operands::ApicObservation;
use x86::memory_encryption;
use x86::memory_encryption::State;
use x86::memory_encryption::Configuration;
use x86::addresses::NumberResult;
use facts::x86_registers::Cr3Flags;
use facts::x86_registers::ApicBaseFlags;
use facts::x86_tlb_operands::Pcid;
machine matches_profile_number(result:NumberResult, valid:bool, expected:u64)->bool {
 transition result { NumberResult::Value {value} -> (valid && value==expected) _ -> (!valid) }
}
machine matches_profile_cr3(result:ObservedCr3, valid:bool, expected:u64, low:u16)->bool {
 transition result { ObservedCr3::Value {observation} -> (valid && observation.frame==expected && observation.low==low) _ -> (!valid) }
}
machine row0()->bool {
let profile:State=memory_encryption::initial();
let configured0:bool=memory_encryption::configure(&mut profile,Configuration::EncryptedBit {position:47});
let configured1:bool=memory_encryption::configure(&mut profile,Configuration::SharedBit {position:48});
let configured2:bool=memory_encryption::configure(&mut profile,Configuration::EncryptedBit {position:47});
let observation:ObservedCr3=encrypted_register_operands::cr3_observed(&profile,0);
let cr3_ok:bool=matches_profile_cr3(observation,true,0,0);
let apic:ApicObservation=encrypted_register_operands::apic_observed(&profile,0);
let apic_ok:bool=apic.frame==0 && apic.raw_flags==0 && apic.flags.raw==0;
let operand0:NumberResult=encrypted_register_operands::cr3_raw_operand(&profile,0,64188,false);
let pass0:bool=matches_profile_number(operand0,true,64188);
let operand1:NumberResult=encrypted_register_operands::cr3_raw_operand(&profile,0,64188,true);
let pass1:bool=matches_profile_number(operand1,true,9223372036854839996);
let operand2:NumberResult=encrypted_register_operands::cr3_flags_operand(&profile,0,Cr3Flags {raw:32792});
let pass2:bool=matches_profile_number(operand2,true,32792);
let operand3:NumberResult=encrypted_register_operands::cr3_pcid_operand(&profile,0,Pcid {value:2748},true);
let pass3:bool=matches_profile_number(operand3,true,9223372036854778556);
let operand4:NumberResult=encrypted_register_operands::apic_raw_operand(&profile,0,9223372036854843392);
let pass4:bool=matches_profile_number(operand4,true,9223372036854843392);
let operand5:NumberResult=encrypted_register_operands::apic_preserving_operand(&profile,48358647703818240,0,ApicBaseFlags {raw:526336});
let pass5:bool=matches_profile_number(operand5,true,48358647704344576);
cr3_ok && apic_ok && pass0 && pass1 && pass2 && pass3 && pass4 && pass5
}
