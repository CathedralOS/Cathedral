// Expected numeric results observed from pinned Rust public APIs/private mirrors.
use {values}/addresses.omg;
use {values}/mapper_topology.omg;
machine number_is(result:|addresses|::NumberResult,valid:bool,expected:u64)->bool {
 transition result {|addresses|::NumberResult::Value {value} -> compare(value,valid,expected) _ -> (!valid)}
 state compare(value:u64,valid:bool,expected:u64)->bool {valid && value==expected}
}
machine observed_is(result:|mapper_topology|::RecursiveObservation,code:u64,index:u16,frame:u64)->bool {
 transition result {
  |mapper_topology|::RecursiveObservation::InvalidAddress -> (code==5)
  |mapper_topology|::RecursiveObservation::InvalidObservedFrame -> (code==6)
  |mapper_topology|::RecursiveObservation::NotRecursive -> (code==1)
  |mapper_topology|::RecursiveObservation::NotActive {reason} -> inactive(reason,code)
  |mapper_topology|::RecursiveObservation::Observed {recursive_index,physical_frame} -> active(recursive_index,physical_frame,code,index,frame)
 }
 state inactive(reason:|mapper_topology|::InactiveReason,code:u64)->bool {transition reason {|mapper_topology|::InactiveReason::EntryNotPresent -> (code==2) |mapper_topology|::InactiveReason::EntryHugeFrame -> (code==3) |mapper_topology|::InactiveReason::DifferentFrame -> (code==4)}}
 state active(actual_index:u16,actual_frame:u64,code:u64,index:u16,frame:u64)->bool {code==0 && actual_index==index && actual_frame==frame}
}

machine test()->u64{
let r0:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446743522877890560,0,1);let c0:bool=observed_is(r0,0,510,0);
let r1:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446743522877890560,4503599627366400,9227875636482142211);let c1:bool=observed_is(r1,0,510,4503599627366400);
let r2:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446743522879987712,0,0);let c2:bool=observed_is(r2,1,510,0);
let r3:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446743522877890575,8192,8193);let c3:bool=observed_is(r3,0,510,8192);
let r4:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073709547520,8192,8195);let c4:bool=observed_is(r4,0,511,8192);
let r5:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073709547520,12288,8195);let c5:bool=observed_is(r5,4,511,12288);
let r6:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073709547520,8192,8320);let c6:bool=observed_is(r6,2,511,8192);
let r7:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073709547520,8192,8321);let c7:bool=observed_is(r7,3,511,8192);
let r8:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073709547520,0,1);let c8:bool=observed_is(r8,0,511,0);
let r9:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073709547520,4503599627366400,9227875636482142211);let c9:bool=observed_is(r9,0,511,4503599627366400);
let r10:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073707450368,0,0);let c10:bool=observed_is(r10,1,511,0);
let r11:|mapper_topology|::RecursiveObservation=|mapper_topology|::observe_recursive(18446744073709547535,8192,8193);let c11:bool=observed_is(r11,0,511,8192);
transition c0 && c1 && c2 && c3 && c4 && c5 && c6 && c7 && c8 && c9 && c10 && c11 {true -> (0) _ -> (1)}
}

const RESULT:u64=test();
machine require_ok(value:u64) requires value==0; {}
data Main{}
machine Main::main(&mut self){require_ok(RESULT);}
