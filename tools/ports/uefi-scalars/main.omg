// Translated uefi-raw Boolean/revision tests plus local scalar edge cases.
// Pure test application; see raw/scalars.PORT.md for execution evidence.
use {cathedral_uefi_raw}/scalars.omg;
use {cathedral_uefi_raw}/status.omg;
use {cathedral_uefi_raw}/revision.omg;
use {cathedral_uefi_raw}/time.omg;
use {cathedral_uefi_raw}/capsule.omg;
use {cathedral_uefi}/scalar_helpers.omg;

machine test_boolean_conversions() -> bool {
    |scalar_helpers|::boolean_from_bool(true).raw == 1 && |scalar_helpers|::boolean_from_bool(false).raw == 0 &&
    |scalar_helpers|::boolean_is_false(|scalars|::Boolean { raw: 0 }) && |scalar_helpers|::boolean_is_true(|scalars|::Boolean { raw: 1 }) &&
    |scalar_helpers|::boolean_is_true(|scalars|::Boolean { raw: 254 }) && |scalar_helpers|::boolean_is_true(|scalars|::Boolean { raw: 255 }) &&
    |scalar_helpers|::boolean_from_raw(254).raw == 254
}
machine test_boolean_order_equality_hash() -> bool {
    |scalar_helpers|::boolean_compare(|scalars|::Boolean { raw: 0 }, |scalars|::Boolean { raw: 1 }) == -1 &&
    |scalar_helpers|::boolean_compare(|scalars|::Boolean { raw: 1 }, |scalars|::Boolean { raw: 0 }) == 1 &&
    |scalar_helpers|::boolean_compare(|scalars|::Boolean { raw: 13 }, |scalars|::Boolean { raw: 7 }) == 0 &&
    |scalar_helpers|::boolean_equal(|scalars|::Boolean { raw: 0 }, |scalars|::Boolean { raw: 0 }) &&
    !|scalar_helpers|::boolean_equal(|scalars|::Boolean { raw: 0 }, |scalars|::Boolean { raw: 3 }) &&
    !|scalar_helpers|::boolean_equal(|scalars|::Boolean { raw: 7 }, |scalars|::Boolean { raw: 0 }) &&
    |scalar_helpers|::boolean_equal(|scalars|::Boolean { raw: 1 }, |scalars|::Boolean { raw: 1 }) &&
    |scalar_helpers|::boolean_equal(|scalars|::Boolean { raw: 13 }, |scalars|::Boolean { raw: 7 }) &&
    |scalar_helpers|::boolean_hash_byte(|scalars|::Boolean { raw: 1 }) == |scalar_helpers|::boolean_hash_byte(|scalars|::Boolean { raw: 13 }) &&
    |scalar_helpers|::boolean_hash_byte(|scalars|::Boolean { raw: 13 }) == |scalar_helpers|::boolean_hash_byte(|scalars|::Boolean { raw: 255 }) &&
    |scalar_helpers|::boolean_hash_byte(|scalars|::Boolean { raw: 0 }) != |scalar_helpers|::boolean_hash_byte(|scalars|::Boolean { raw: 13 })
}
machine test_status() -> bool {
    |scalar_helpers|::status_is_success(|status|::Status { raw: 0 }) && !|scalar_helpers|::status_is_warning(|status|::Status { raw: 0 }) &&
    !|scalar_helpers|::status_is_error(|status|::Status { raw: 0 }) && |scalar_helpers|::status_is_warning(|status|::Status { raw: 7 }) &&
    |scalar_helpers|::status_is_warning(|status|::Status { raw: 0x7fff_ffff_ffff_ffff }) &&
    |scalar_helpers|::status_is_error(|status|::Status { raw: 0x8000_0000_0000_0000 }) &&
    |scalar_helpers|::status_is_error(|status|::Status { raw: 0xffff_ffff_ffff_ffff }) &&
    !|scalar_helpers|::status_is_warning(|status|::Status { raw: 0x8000_0000_0000_0005 })
}
machine test_revision() -> bool {
    |scalar_helpers|::revision_new(2, 31).raw == 0x0002_001f &&
    |scalar_helpers|::revision_major(|revision|::Revision { raw: 0x0002_001f }) == 2 &&
    |scalar_helpers|::revision_minor(|revision|::Revision { raw: 0x0002_001f }) == 31 &&
    |scalar_helpers|::revision_less(|revision|::Revision { raw: 0x0001_000a }, |revision|::Revision { raw: 0x0002_0000 }) &&
    |scalar_helpers|::revision_new(65535, 65535).raw == 0xffff_ffff &&
    |scalar_helpers|::revision_major(|revision|::Revision { raw: 0xffff_ffff }) == 65535 &&
    |scalar_helpers|::revision_minor(|revision|::Revision { raw: 0xffff_ffff }) == 65535 &&
    |scalar_helpers|::revision_new(0, 0).raw == 0 && |scalar_helpers|::revision_new(2, 100).raw == 0x0002_0064
}
machine test_time() -> bool {
    let mut value: |time|::Time = |time|::Time {
        year: 1900, month: 1, day: 1, hour: 0, minute: 0, second: 0,
        nanosecond: 0, time_zone: -1440, daylight: |time|::Daylight { raw: 0 },
    };
    let lower: bool = |scalar_helpers|::time_is_valid(value);
    value.year = 9999; value.month = 12; value.day = 31; value.hour = 23;
    value.minute = 59; value.second = 59; value.nanosecond = 999999999;
    value.time_zone = 1440;
    let upper: bool = |scalar_helpers|::time_is_valid(value);
    value.time_zone = 2047;
    let local: bool = |scalar_helpers|::time_is_valid(value);
    let mut padded: |time|::Time = value; padded.pad1 = 255; padded.pad2 = 255;
    let padding_ignored: bool = |scalar_helpers|::time_equal(value, padded);
    value.year = 1899;
    let bad_year: bool = !|scalar_helpers|::time_is_valid(value); value.year = 10000;
    let large_year: bool = !|scalar_helpers|::time_is_valid(value); value.year = 2023;
    value.month = 0; let bad_month: bool = !|scalar_helpers|::time_is_valid(value); value.month = 13;
    let large_month: bool = !|scalar_helpers|::time_is_valid(value); value.month = 2;
    value.day = 0; let bad_day: bool = !|scalar_helpers|::time_is_valid(value); value.day = 32;
    let large_day: bool = !|scalar_helpers|::time_is_valid(value); value.day = 31;
    let not_calendar_validation: bool = |scalar_helpers|::time_is_valid(value);
    value.hour = 24; let bad_hour: bool = !|scalar_helpers|::time_is_valid(value); value.hour = 23;
    value.minute = 60; let bad_minute: bool = !|scalar_helpers|::time_is_valid(value); value.minute = 59;
    value.second = 60; let bad_second: bool = !|scalar_helpers|::time_is_valid(value); value.second = 59;
    value.nanosecond = 1000000000;
    let bad_nanosecond: bool = !|scalar_helpers|::time_is_valid(value); value.nanosecond = 0;
    value.time_zone = -1441; let low_zone: bool = !|scalar_helpers|::time_is_valid(value);
    value.time_zone = 1441; let high_zone: bool = !|scalar_helpers|::time_is_valid(value);
    value.time_zone = 2047; value.daylight.raw = 255;
    let no_daylight_validation: bool = |scalar_helpers|::time_is_valid(value);
    lower && upper && local && padding_ignored && bad_year && large_year &&
    bad_month && large_month && bad_day && large_day && not_calendar_validation &&
    bad_hour && bad_minute && bad_second && bad_nanosecond && low_zone && high_zone &&
    no_daylight_validation && !|scalar_helpers|::time_is_valid(|scalar_helpers|::time_invalid())
}
machine test_custom_memory_type() -> bool {
    |scalar_helpers|::memory_type_custom(0x80000000).raw == 0x80000000 &&
    |scalar_helpers|::memory_type_custom(0xffffffff).raw == 0xffffffff
}
machine test_result() -> i32 {
    transition test_boolean_conversions() && test_boolean_order_equality_hash() &&
        test_status() && test_revision() && test_time() && test_custom_memory_type() {
        true -> (0)
        _ -> (1)
    }
}

// Semantic evaluator executes the real Omega helper bodies and fixture cases.
// The checked call below must prove the computed result is exactly zero.
const TEST_RESULT: i32 = test_result();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
