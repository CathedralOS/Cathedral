use {aml}/model.omg;
use {aml}/loader.omg;
use {aml}/namespace.omg;
machine test()->u64 {let mut input:[u8;1024];input[0]=0xa3;let start:|model|::Namespace=|namespace|::empty();let result:|model|::LoadState=|loader|::load(&input,1,1,start,2,1);transition result.outcome==|model|::Outcome::Success && result.at==1 {true -> (0) _ -> (1)}}
const RESULT:u64=test();
machine ok(x:u64) requires x==0; {}
data Main {}
machine Main::main(&mut self){ok(RESULT);}
