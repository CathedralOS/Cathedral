// Original Cathedral fixtures; no firmware or external uACPI fixture content.
use {aml}/model.omg;
use {aml}/bytes.omg;

machine test()->u64 {
let mut input:[u8;1024];
input[0]=65;
input[1]=4;
input[2]=113;
input[3]=4;
input[4]=128;
input[5]=0;
input[6]=1;
let length:|model|::Read=|bytes|::pkg_length(&input,7,0);let reserved:|model|::Read=|bytes|::pkg_length(&input,7,2);let larger:|model|::Read=|bytes|::pkg_length(&input,7,4);let crossing:|model|::Envelope=|bytes|::envelope(&input,7,0);
 transition length.value==65 && length.next==2 && reserved.outcome==|model|::Outcome::BadEncoding && larger.value==4096 && crossing.outcome==|model|::Outcome::BadEncoding {true -> (0) _ -> (1)}
}
const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
