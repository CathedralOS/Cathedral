input[21]=66;
let a:PathResult=namestring(&input,22,0);let b:PathResult=namestring(&input,22,10);let r:Path=root();let invalid:PathResult=resolve(b.value,r);
 transition a.outcome==Outcome::Success && a.value.absolute && a.value.count==2 && a.next==10 && b.outcome==Outcome::Success && b.value.parents==2 && b.value.count==2 && invalid.outcome==Outcome::AboveRoot {true -> (0) _ -> (1)}
}
