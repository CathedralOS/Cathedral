let a:|model|::PathResult=|names|::namestring(&input,22,0);let b:|model|::PathResult=|names|::namestring(&input,22,10);let r:|model|::Path=|names|::root();let invalid:|model|::PathResult=|names|::resolve(b.value,r);
 transition a.outcome==|model|::Outcome::Success && a.value.absolute && a.value.count==2 && a.next==10 && b.outcome==|model|::Outcome::Success && b.value.parents==2 && b.value.count==2 && invalid.outcome==|model|::Outcome::AboveRoot {true -> (0) _ -> (1)}
