input[52]=65;
input[53]=65;
let start:Namespace=empty();let parsed:LoadState=load(&input,54,1,start,11,2);
 transition parsed.outcome==Outcome::Depth && parsed.space.count==1 && parsed.depth==8 {true -> (0) _ -> (1)}
}
const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
