// Original Cathedral fixtures; no firmware or external uACPI fixture content.
use {aml}/model.omg;
use {aml}/bytes.omg;

machine test()->u64 {
let mut input:[u8;1024];
input[0]=18;
input[1]=52;
input[2]=86;
input[3]=120;
let one:|model|::Read=|bytes|::read_le(&input,4,0,4);let truncated:|model|::Read=|bytes|::read_le(&input,3,0,4);
 transition one.outcome==|model|::Outcome::Success && one.value==0x78563412 && one.next==4 && truncated.outcome==|model|::Outcome::Truncated {true -> (0) _ -> (1)}
}
const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
