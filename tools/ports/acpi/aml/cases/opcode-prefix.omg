// Original Cathedral fixtures; no firmware or external uACPI fixture content.
use {aml}/model.omg;
use {aml}/bytes.omg;

machine test()->u64 {
let mut input:[u8;1024];
input[0]=146;
input[1]=147;
input[2]=146;
input[3]=17;
input[4]=91;
input[5]=130;
input[6]=146;
let a:|model|::Read=|bytes|::opcode(&input,7,0);let b:|model|::Read=|bytes|::opcode(&input,7,2);let c:|model|::Read=|bytes|::opcode(&input,7,4);let d:|model|::Read=|bytes|::opcode(&input,7,6);let e:|model|::Read=|bytes|::opcode(&input,5,4);
 transition a.value==0x9293 && a.next==2 && b.value==0x92 && b.next==3 && c.value==0x5b82 && d.value==0x92 && d.next==7 && e.outcome==|model|::Outcome::Truncated {true -> (0) _ -> (1)}
}
const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
