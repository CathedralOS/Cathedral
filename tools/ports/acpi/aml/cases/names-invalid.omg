// Original Cathedral fixtures; no firmware or external uACPI fixture content.
use {aml}/model.omg;
use {aml}/bytes.omg;
use {aml}/names.omg;

machine test()->u64 {
let mut input:[u8;1024];
input[0]=49;
input[1]=66;
input[2]=65;
input[3]=68;
input[4]=47;
input[5]=0;
let invalid:|model|::PathResult=|names|::namestring(&input,6,0);let zero:|model|::PathResult=|names|::namestring(&input,6,4);let short:|model|::PathResult=|names|::namestring(&input,3,0);
 transition invalid.outcome==|model|::Outcome::InvalidName && invalid.offset==0 && zero.outcome==|model|::Outcome::BadEncoding && short.outcome==|model|::Outcome::Truncated {true -> (0) _ -> (1)}
}
const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
