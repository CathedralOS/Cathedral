// Original Cathedral fixtures; no firmware or external uACPI fixture content.
use {aml}/model.omg;
use {aml}/bytes.omg;
use {aml}/names.omg;
use {aml}/namespace.omg;
use {aml}/values.omg;
use {aml}/loader.omg;

machine single(segment:u32,absolute:bool)->|model|::Path {let mut out:|model|::Path=|model|::Path {absolute:absolute,count:1};out.segments[0]=segment;out}
machine integer_is(space:|model|::Namespace,id:u64,expected:u64)->bool {
 let object:|model|::Object=|namespace|::object_at(space,id);
 transition object.value {|model|::Value::Integer {number} -> compare(number,expected) _ -> (false)}
 state compare(number:u64,expected:u64)->bool {number==expected}
}
machine package_first(space:|model|::Namespace,id:u64)->u64 {
 let object:|model|::Object=|namespace|::object_at(space,id);
 transition object.value {|model|::Value::Package {first,count} -> (first) _ -> (64)}
}
machine package_is(space:|model|::Namespace,id:u64,expected:u64)->bool {
 let object:|model|::Object=|namespace|::object_at(space,id);
 transition object.value {|model|::Value::Package {first,count} -> compare(count,expected) _ -> (false)}
 state compare(count:u64,expected:u64)->bool {count==expected}
}
machine reference_is(space:|model|::Namespace,id:u64,scope:|model|::Path)->bool {
 let object:|model|::Object=|namespace|::object_at(space,id);
 transition object.value {|model|::Value::NameReference {name,scope} -> compare(scope) _ -> (false)}
 state compare(scope:|model|::Path)->bool {scope.absolute && scope.count==1 && scope.segments[0]==0x30564544}
}
machine method_is(space:|model|::Namespace,id:u64,unit:u64,start:u64,end:u64)->bool {
 let object:|model|::Object=|namespace|::object_at(space,id);
 transition object.value {|model|::Value::Method {flags,body} -> compare(flags,body,unit,start,end) _ -> (false)}
 state compare(flags:u8,body:|model|::Span,unit:u64,start:u64,end:u64)->bool {flags==0x39 && body.unit==unit && body.start==start && body.end==end}
}

machine test()->u64 {
let mut input:[u8;1024];
input[0]=8;
input[1]=65;
input[2]=65;
input[3]=65;
input[4]=65;
input[5]=1;
let mut start:|model|::Namespace=|namespace|::empty();start.object_count=64;let full:|model|::LoadState=|loader|::load(&input,6,1,start,2,2);let exhausted:|model|::LoadState=|loader|::load(&input,6,1,start,0,2);
 transition full.outcome==|model|::Outcome::Capacity && full.space.object_count==64 && exhausted.outcome==|model|::Outcome::WorkLimit && exhausted.space.count==1 {true -> (0) _ -> (1)}
}
const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
