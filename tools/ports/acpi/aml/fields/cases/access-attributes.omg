use {aml}/model.omg;
use {aml}/field_model.omg;
use {fields}/flags.omg;

machine test()->u64 {
let initial:|field_model|::AccessResult=|flags|::decode_flags(0x52);let ordinary:|field_model|::AccessResult=|flags|::change_access(initial.access,0x85,9,false,0);let extended:|field_model|::AccessResult=|flags|::change_access(ordinary.access,5,14,true,6);let bad:|field_model|::AccessResult=|flags|::change_access(initial.access,0x12,0,false,0);let bad_extended:|field_model|::AccessResult=|flags|::change_access(initial.access,5,12,true,1);
 transition ordinary.outcome==|model|::Outcome::Success && ordinary.access.attribute_mode==2 && ordinary.access.attribute==9 && ordinary.access.flags==0x55 && ordinary.access.locked && extended.access.extended && extended.access.access_length==6 && extended.access.attribute==14 && bad.outcome==|model|::Outcome::BadEncoding && bad_extended.outcome==|model|::Outcome::BadEncoding {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
