use {aml}/model.omg;
use {aml}/field_model.omg;
use {fields}/declarations.omg;
machine pending_bank(value:|field_model|::Pending)->bool {transition value {|field_model|::Pending::BankTermArgRemainder {unparsed} -> check(unparsed) _ -> (false)} state check(span:|model|::Span)->bool {span.unit==7 && span.start==11 && span.end==21}}

machine test()->u64 {
let mut input:[u8;1024];
input[0]=91;
input[1]=135;
input[2]=19;
input[3]=82;
input[4]=69;
input[5]=71;
input[6]=48;
input[7]=66;
input[8]=78;
input[9]=75;
input[10]=48;
input[11]=114;
input[12]=1;
input[13]=1;
input[14]=0;
input[15]=1;
input[16]=66;
input[17]=78;
input[18]=75;
input[19]=49;
input[20]=8;
let scope:|model|::Path=|model|::Path {absolute:true};let result:|field_model|::DeclarationResult=|declarations|::parse_declaration(&input,21,0,7,scope,1024,32);let pending:bool=pending_bank(result.pending);
 transition result.outcome==|model|::Outcome::UnsupportedSyntax && result.next==11 && result.list.count==0 && result.declaration.field_list.end==0 && pending {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
