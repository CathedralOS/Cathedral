use aml::model::Outcome;
use aml::model::Path;
use aml::model::Span;
use aml::model::Read;
use fields::field_model::Access;
use fields::field_model::AccessType;
use fields::field_model::UpdateRule;
use fields::field_model::AccessResult;
use fields::field_model::Connection;
use fields::field_model::ListState;
use fields::field_model::DeclarationKind;
use fields::field_model::DeclarationResult;
use fields::field_model::Pending;
use fields::field_list::parse_list;

machine test()->u64 {
let mut input:[u8;1024];
let scope:Path=Path {absolute:true};let result:ListState=parse_list(&input,0,0,9,scope,0,1024,0);
 transition result.outcome==Outcome::Success && result.done && result.count==0 && result.at==0 {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
