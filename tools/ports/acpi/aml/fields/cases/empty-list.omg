use {aml}/model.omg;
use {aml}/field_model.omg;
use {fields}/field_list.omg;

machine test()->u64 {
let mut input:[u8;1024];
let scope:|model|::Path=|model|::Path {absolute:true};let result:|field_model|::ListState=|field_list|::parse_list(&input,0,0,9,scope,0,1024,0);
 transition result.outcome==|model|::Outcome::Success && result.done && result.count==0 && result.at==0 {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
