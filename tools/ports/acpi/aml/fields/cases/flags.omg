use {aml}/model.omg;
use {aml}/field_model.omg;
use {fields}/flags.omg;

machine test()->u64 {
let good:|field_model|::AccessResult=|flags|::decode_flags(0x52);let invalid_access:|field_model|::AccessResult=|flags|::decode_flags(6);let invalid_update:|field_model|::AccessResult=|flags|::decode_flags(0x60);let reserved:|field_model|::AccessResult=|flags|::decode_flags(0x80);let width:|model|::Read=|flags|::nominal_width(4);
 transition good.outcome==|model|::Outcome::Success && good.access.kind==|field_model|::AccessType::Word && good.access.locked && good.access.update==|field_model|::UpdateRule::WriteAsZeros && invalid_access.outcome==|model|::Outcome::BadEncoding && invalid_update.outcome==|model|::Outcome::BadEncoding && reserved.outcome==|model|::Outcome::BadEncoding && width.value==8 {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
