use {aml}/model.omg;
use {aml}/field_model.omg;
use {fields}/field_list.omg;

machine test()->u64 {
let mut input:[u8;1024];
input[0]=0;
input[1]=193;
input[2]=255;
input[3]=255;
input[4]=255;
input[5]=87;
input[6]=73;
input[7]=68;
input[8]=69;
input[9]=1;
let scope:|model|::Path=|model|::Path {absolute:true};let result:|field_model|::ListState=|field_list|::parse_list(&input,10,0,9,scope,0,18446744073709551615,32);
 transition result.outcome==|model|::Outcome::Success && result.fields[0].bit_offset==0xffffff1 && result.bit_offset==0xffffff2 {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
