use {aml}/model.omg;
use {aml}/field_model.omg;
use {fields}/declarations.omg;

machine test()->u64 {
let mut input:[u8;1024];
input[0]=91;
input[1]=129;
input[2]=2;
input[3]=65;
let scope:|model|::Path=|model|::Path {absolute:true};let result:|field_model|::DeclarationResult=|declarations|::parse_declaration(&input,4,0,7,scope,1024,32);
 transition result.outcome==|model|::Outcome::Truncated && result.list.count==0 {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
