use {aml}/model.omg;
use {aml}/field_model.omg;
use {fields}/field_list.omg;

machine test()->u64 {
let mut input:[u8;1024];
input[0]=65;
input[1]=65;
input[2]=65;
input[3]=65;
input[4]=8;
input[5]=66;
input[6]=66;
input[7]=66;
input[8]=66;
input[9]=8;
let scope:|model|::Path=|model|::Path {absolute:true};let result:|field_model|::ListState=|field_list|::parse_list(&input,10,0,9,scope,0,1024,1);
 transition result.outcome==|model|::Outcome::WorkLimit && result.count==1 && result.at==5 {true -> (0) _ -> (1)}
}

const TEST_RESULT:u64=test();
machine require_ok(result:u64) requires result==0; {}
data Main {}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
