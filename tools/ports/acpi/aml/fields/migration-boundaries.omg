// Original owner-migration compatibility and unresolved-boundary fixtures.
use {aml}/field_model.omg;
use {aml}/model.omg;
use {aml}/object_queries.omg;
use {reads}/read.omg;
use {reads}/model.omg as reads_model;
use {writes}/write.omg;
use {writes}/model.omg as writes_model;
use {access}/model.omg as access_model;
use {integers}/integers.omg;
use {execution}/execution_model.omg;
use {execution}/frames.omg;
use {execution}/generic_values.omg;
use {execution}/generic_target_model.omg;
use {execution}/generic_target_values.omg;

machine consumer_round_trip(expected:u64)->u64 {
 let decoded:|field_model|::AccessResult=decode_flags(1);
 let field:|field_model|::Field=|field_model|::Field {bit_offset:4,bit_length:8,access:decoded.access};
 let mut words:[u64;257];words[0]=176;words[1]=10;
 let read_result:|reads_model|::ReadResult=|read|::assemble(|field_model|::DeclarationKind::Field,&field,2,|integers|::IntegerSize::EightBytes,&words,2);
 let read_ok:bool=consumer_read(read_result,expected);
 let mut payload:[u8;256];payload[0]=171;
 let mut previous:[|access_model|::Previous;257];previous[0]=|access_model|::Previous::Value {word:15};previous[1]=|access_model|::Previous::Value {word:240};
 let write_result:|writes_model|::WriteResult=|write|::assemble(|field_model|::DeclarationKind::Field,&field,2,|integers|::IntegerSize::EightBytes,&payload,1,&previous,2);
 let write_ok:bool=consumer_write(write_result);
 transition read_ok && write_ok {true -> (0) _ -> (1)}
}
machine consumer_read(result:|reads_model|::ReadResult,expected:u64)->bool {transition result {|reads_model|::ReadResult::Integer {value,size,lock} -> (value==expected && size==|integers|::IntegerSize::EightBytes && lock==|access_model|::LockRequirement::NotRequested) _ -> (false)}}
machine consumer_write(result:|writes_model|::WriteResult)->bool {transition result {|writes_model|::WriteResult::Writes {count,records,lock} -> (count==2 && records[0].offset==0 && records[0].width==1 && records[0].value==191 && records[1].offset==1 && records[1].width==1 && records[1].value==250 && lock==|access_model|::LockRequirement::NotRequested) _ -> (false)}}
machine field_boundary(expected_type:u64)->u64 {
 let mut input:[u8;1024];let mut store:|model|::ObjectStore;
 let value:|model|::Value=|model|::Value::FieldUnit {binding:|model|::FieldBinding::Region {region_object:17},declaration:|field_model|::Declaration {},field:|field_model|::Field {bit_offset:5,bit_length:8}};
 store.space.object_count=1;store.space.objects[0]=|model|::Object {value:value,has_next:true,next:41};
 let query:|object_queries|::QueryResult=|object_queries|::object_type(&store.space,0,1);let type_ok:bool=field_type(query,expected_type);
 let scalar:|execution_model|::SlotResult=|frames|::scalar_slot(|integers|::IntegerSize::EightBytes,value);
 let admitted:|execution_model|::ExecutionOutcome=|generic_values|::validate_operand(&input,0,0,&store,|execution_model|::Operand::Object {object_id:0});
 let allowed:|execution_model|::ExecutionOutcome=|generic_values|::destination_allowed(&store,0);
 let stored:|execution_model|::BindingResult=|generic_target_values|::apply_selected(&input,0,0,|integers|::IntegerSize::EightBytes,&mut store,|generic_target_model|::TargetSelection::Named {object_id:0},|execution_model|::Operand::Integer {number:9},false);
 let copied:|execution_model|::BindingResult=|generic_target_values|::apply_selected(&input,0,0,|integers|::IntegerSize::EightBytes,&mut store,|generic_target_model|::TargetSelection::Named {object_id:0},|execution_model|::Operand::Integer {number:9},true);
 let retained:bool=field_retained(store.space.objects[0].value);
 transition type_ok && scalar.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && admitted==|execution_model|::ExecutionOutcome::UnresolvedRegion && allowed==|execution_model|::ExecutionOutcome::UnresolvedRegion && stored.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && copied.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && retained && store.space.object_count==1 && store.space.objects[0].has_next && store.space.objects[0].next==41 {true -> (0) _ -> (1)}
}
machine field_type(result:|object_queries|::QueryResult,expected:u64)->bool {transition result {|object_queries|::QueryResult::Value {object,number} -> (object==0 && number==expected) _ -> (false)}}
machine field_retained(value:|model|::Value)->bool {transition value {|model|::Value::FieldUnit {binding,declaration,field} -> retained_binding(binding,field) _ -> (false)}}

machine retained_binding(binding:|model|::FieldBinding,field:|field_model|::Field)->bool {transition binding {|model|::FieldBinding::Region {region_object} -> (region_object==17 && field.bit_offset==5 && field.bit_length==8) _ -> (false)}}
