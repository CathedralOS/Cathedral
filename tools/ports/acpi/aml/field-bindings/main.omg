use {omega}/language/core/nat.omg;
use {aml}/model.omg;
use {aml}/field_model.omg;
machine fb_bindings(a:|model|::FieldBinding,b:|model|::FieldBinding)->bool {transition a {
 |model|::FieldBinding::Region {region_object} -> region(region_object,b)
 |model|::FieldBinding::Bank {region_object,selector_object} -> bank(region_object,selector_object,b)
 |model|::FieldBinding::Index {index_object,data_object} -> index(index_object,data_object,b)}
 state region(id:u64,b:|model|::FieldBinding)->bool {transition b {|model|::FieldBinding::Region {region_object} -> (id==region_object) _ -> (false)}}
 state bank(region:u64,selector:u64,b:|model|::FieldBinding)->bool {transition b {|model|::FieldBinding::Bank {region_object,selector_object} -> (region==region_object && selector==selector_object) _ -> (false)}}
 state index(index:u64,data:u64,b:|model|::FieldBinding)->bool {transition b {|model|::FieldBinding::Index {index_object,data_object} -> (index==index_object && data==data_object) _ -> (false)}}}
machine fb_initial_space()->|model|::Namespace {let mut s:|model|::Namespace;fb_seed(&mut s,0,64);s}
machine fb_seed(s:&mut |model|::Namespace,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
{fb_seed_one(s,index);transition index<count {true -> fb_seed(s,index+1,count) _ -> {}}}
machine fb_seed_one(s:&mut |model|::Namespace,index:u64) {transition index<64 {true -> put(s,index) _ -> {}}
 state put(s:&mut |model|::Namespace,index:u64) {s.objects[index]=|model|::Object {value:|model|::Value::Integer {number:1000+index},has_next:true,next:18446744073709551615-index};}}
machine fb_paths(a:|model|::Path,b:|model|::Path)->bool {let all:bool=fb_segments(a,b,0,16,true);a.absolute==b.absolute && a.parents==b.parents && a.count==b.count && all}
machine fb_segments(a:|model|::Path,b:|model|::Path,index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let same:bool=fb_segment(a,b,index);transition index<count {true -> fb_segments(a,b,index+1,count,prior && same) _ -> (prior)}}
machine fb_segment(a:|model|::Path,b:|model|::Path,index:u64)->bool {transition index<16 {true -> (a.segments[index]==b.segments[index]) _ -> (true)}}
machine fb_spans(a:|model|::Span,b:|model|::Span)->bool {a.unit==b.unit && a.start==b.start && a.end==b.end}
machine fb_accesses(a:|field_model|::Access,b:|field_model|::Access)->bool {a.flags==b.flags && a.kind==b.kind && a.locked==b.locked && a.update==b.update && a.attribute==b.attribute && a.attribute_mode==b.attribute_mode && a.extended==b.extended && a.access_length==b.access_length}
machine fb_connections(a:|field_model|::Connection,b:|field_model|::Connection)->bool {transition a {
 |field_model|::Connection::None -> none(b) |field_model|::Connection::Name {connection_name} -> name(connection_name,b)
 |field_model|::Connection::Buffer {buffer_encoding,size_known,declared_size,initializer} -> buffer(buffer_encoding,size_known,declared_size,initializer,b)}
 state none(b:|field_model|::Connection)->bool {transition b {|field_model|::Connection::None -> (true) _ -> (false)}}
 state name(a:|model|::Path,b:|field_model|::Connection)->bool {transition b {|field_model|::Connection::Name {connection_name} -> name_same(a,connection_name) _ -> (false)}}
 state name_same(a:|model|::Path,b:|model|::Path)->bool {let result:bool=fb_paths(a,b);result}
 state buffer(a:|model|::Span,known:bool,size:u64,bytes:|model|::Span,b:|field_model|::Connection)->bool {transition b {|field_model|::Connection::Buffer {buffer_encoding,size_known,declared_size,initializer} -> buffer_same(a,known,size,bytes,buffer_encoding,size_known,declared_size,initializer) _ -> (false)}}
 state buffer_same(a:|model|::Span,ak:bool,az:u64,ai:|model|::Span,b:|model|::Span,bk:bool,bz:u64,bi:|model|::Span)->bool {let encoding:bool=fb_spans(a,b);let init:bool=fb_spans(ai,bi);encoding && init && ak==bk && az==bz}}
machine fb_declarations(a:|field_model|::Declaration,b:|field_model|::Declaration)->bool {let scope:bool=fb_paths(a.scope,b.scope);let primary:bool=fb_paths(a.primary_name,b.primary_name);let secondary:bool=fb_paths(a.secondary_name,b.secondary_name);let source:bool=fb_spans(a.source,b.source);let list:bool=fb_spans(a.field_list,b.field_list);scope && primary && secondary && source && list && a.kind==b.kind && a.bank_value==b.bank_value && a.flags==b.flags}
machine fb_fields(a:|field_model|::Field,b:|field_model|::Field)->bool {let name:bool=fb_paths(a.name,b.name);let acc:bool=fb_accesses(a.access,b.access);let connection:bool=fb_connections(a.connection,b.connection);let source:bool=fb_spans(a.source,b.source);name && acc && connection && source && a.bit_offset==b.bit_offset && a.bit_length==b.bit_length}
machine fb_values(a:|model|::Value,b:|model|::Value)->bool {transition a {
 |model|::Value::Integer {number} -> integer(number,b)
 |model|::Value::OperationRegion {space,base,length,scope} -> region(space,base,length,scope,b)
 |model|::Value::FieldUnit {binding,declaration,field} -> field(binding,declaration,field,b)
 |model|::Value::Reference {kind,object_id} -> reference(kind,object_id,b)
 _ -> (false)}
 state integer(a:u64,b:|model|::Value)->bool {transition b {|model|::Value::Integer {number} -> (a==number) _ -> (false)}}
 state region(a:u8,base_a:u64,length_a:u64,scope_a:|model|::Path,b:|model|::Value)->bool {transition b {|model|::Value::OperationRegion {space,base,length,scope} -> region_same(a,base_a,length_a,scope_a,space,base,length,scope) _ -> (false)}}
 state region_same(a:u8,ab:u64,al:u64,ap:|model|::Path,b:u8,bb:u64,bl:u64,bp:|model|::Path)->bool {let same:bool=fb_paths(ap,bp);a==b && ab==bb && al==bl && same}
 state field(a:|model|::FieldBinding,ad:|field_model|::Declaration,af:|field_model|::Field,b:|model|::Value)->bool {transition b {|model|::Value::FieldUnit {binding,declaration,field} -> field_same(a,ad,af,binding,declaration,field) _ -> (false)}}
 state field_same(a:|model|::FieldBinding,ad:|field_model|::Declaration,af:|field_model|::Field,b:|model|::FieldBinding,bd:|field_model|::Declaration,bf:|field_model|::Field)->bool {let bs:bool=fb_bindings(a,b);let ds:bool=fb_declarations(ad,bd);let fs:bool=fb_fields(af,bf);bs && ds && fs}
 state reference(a:|model|::ReferenceKind,id:u64,b:|model|::Value)->bool {transition b {|model|::Value::Reference {kind,object_id} -> (a==kind && id==object_id) _ -> (false)}}}
machine fb_objects(a:&|model|::Namespace,b:&|model|::Namespace,index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let same:bool=fb_object_one(a,b,index);transition index<count {true -> fb_objects(a,b,index+1,count,prior && same) _ -> (prior)}}
machine fb_object_one(a:&|model|::Namespace,b:&|model|::Namespace,index:u64)->bool {transition index<64 {true -> one(a.objects[index],b.objects[index]) _ -> (true)} state one(a:|model|::Object,b:|model|::Object)->bool {let same:bool=fb_values(a.value,b.value);same && a.has_next==b.has_next && a.next==b.next}}
machine fb_entries(a:&|model|::Namespace,b:&|model|::Namespace,index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let same:bool=fb_entry_one(a,b,index);transition index<count {true -> fb_entries(a,b,index+1,count,prior && same) _ -> (prior)}}
machine fb_entry_one(a:&|model|::Namespace,b:&|model|::Namespace,index:u64)->bool {transition index<32 {true -> one(a.entries[index],b.entries[index]) _ -> (true)} state one(a:|model|::Entry,b:|model|::Entry)->bool {let same:bool=fb_paths(a.path,b.path);same && a.has_level==b.has_level && a.level==b.level && a.has_object==b.has_object && a.object==b.object && a.alias==b.alias}}
machine fb_definitions(a:&|model|::MethodDefinitions,b:&|model|::MethodDefinitions,index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let same:bool=fb_definition_one(a,b,index);transition index<count {true -> fb_definitions(a,b,index+1,count,prior && same) _ -> (prior)}}
machine fb_definition_one(a:&|model|::MethodDefinitions,b:&|model|::MethodDefinitions,index:u64)->bool {transition index<64 {true -> one(a.entries[index],b.entries[index]) _ -> (true)} state one(a:|model|::MethodDefinition,b:|model|::MethodDefinition)->bool {let scope:bool=fb_paths(a.scope,b.scope);let body:bool=fb_spans(a.body,b.body);scope && body && a.present==b.present && a.object_id==b.object_id && a.flags==b.flags}}
machine fb_compare(a:&|model|::Namespace,b:&|model|::Namespace,ad:&|model|::MethodDefinitions,bd:&|model|::MethodDefinitions,actual:|model|::Outcome,expected:|model|::Outcome)->i32 {let es:bool=fb_entries(a,b,0,32,true);let os:bool=fb_objects(a,b,0,64,true);let ds:bool=fb_definitions(ad,bd,0,64,true);transition es && os && ds && a.count==b.count && a.object_count==b.object_count && actual==expected {true -> (0) _ -> (1)}}
use {aml}/object_queries.omg;
use {execution}/execution_model.omg;
use {execution}/frames.omg;
use {execution}/generic_values.omg;
use {execution}/generic_target_model.omg;
use {execution}/generic_target_values.omg;
use {integers}/integers.omg;
// Build one sentinel byte pattern and publish complete blocks under local bounds.
machine fb_seed_bytes(arena:&mut |model|::ByteArena,index:u64,count:u64) {
 let mut bytes:[u8;256];fb_seed_octets(&mut bytes,0,256);fb_seed_blocks(arena,bytes,index,count);
}
machine fb_seed_octets(bytes:&mut [u8;256],index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
{fb_seed_octet(bytes,index);transition index<count {true -> fb_seed_octets(bytes,index+1,count) _ -> {}}}
machine fb_seed_octet(bytes:&mut [u8;256],index:u64) {transition index<256 {true -> put(bytes,index) _ -> {}}
 state put(bytes:&mut [u8;256],index:u64) {bytes[index]=(index^165)as u8;}}
machine fb_seed_blocks(arena:&mut |model|::ByteArena,bytes:[u8;256],index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
{fb_seed_block(arena,bytes,index);transition index<count {true -> fb_seed_blocks(arena,bytes,index+1,count) _ -> {}}}
machine fb_seed_block(arena:&mut |model|::ByteArena,bytes:[u8;256],index:u64) {transition index<64 {true -> put(arena,bytes,index) _ -> {}}
 state put(arena:&mut |model|::ByteArena,bytes:[u8;256],index:u64) {arena.blocks[index]=|model|::ByteBlock {initialized:true,length:index+1,bytes:bytes};}}
machine fb_equal_bytes(a:&|model|::ByteArena,b:&|model|::ByteArena,index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let same:bool=fb_equal_block(a,b,index);transition index<count {true -> fb_equal_bytes(a,b,index+1,count,prior && same) _ -> (prior)}}
machine fb_equal_block(a:&|model|::ByteArena,b:&|model|::ByteArena,index:u64)->bool {transition index<64 {true -> same(a.blocks[index],b.blocks[index]) _ -> (true)}
 state same(a:|model|::ByteBlock,b:|model|::ByteBlock)->bool {let bytes:bool=fb_equal_octets(&a.bytes,&b.bytes,0,256,true);bytes && a.initialized==b.initialized && a.length==b.length}}
machine fb_equal_octets(a:&[u8;256],b:&[u8;256],index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let same:bool=fb_equal_octet(a,b,index);transition index<count {true -> fb_equal_octets(a,b,index+1,count,prior && same) _ -> (prior)}}
machine fb_equal_octet(a:&[u8;256],b:&[u8;256],index:u64)->bool {transition index<256 {true -> (a[index]==b[index]) _ -> (true)}}
machine fb_type_five(result:|object_queries|::QueryResult)->bool {transition result {|object_queries|::QueryResult::Value {object,number} -> (object==0 && number==5) _ -> (false)}}
machine fb_binding_kind(binding:|model|::FieldBinding)->|field_model|::DeclarationKind {transition binding {|model|::FieldBinding::Region {region_object} -> (|field_model|::DeclarationKind::Field) |model|::FieldBinding::Bank {region_object,selector_object} -> (|field_model|::DeclarationKind::Bank) |model|::FieldBinding::Index {index_object,data_object} -> (|field_model|::DeclarationKind::Index)}}
machine fb_boundary(binding:|model|::FieldBinding,size:|integers|::IntegerSize,control:bool)->i32 {
 let mut input:[u8;1024];let mut store:|model|::ObjectStore;store.space=fb_initial_space();store.space.object_count=3;
 let kind:|field_model|::DeclarationKind=fb_binding_kind(binding);
 let value:|model|::Value=|model|::Value::FieldUnit {binding:binding,declaration:|field_model|::Declaration {kind:kind,bank_value:18446744073709551615},field:|field_model|::Field {bit_offset:5,bit_length:8}};
 store.space.objects[0].value=value;store.space.objects[1].value=|model|::Value::Integer {number:9};store.space.objects[2].value=|model|::Value::Reference {kind:|model|::ReferenceKind::Local,object_id:0};
 fb_seed_bytes(&mut store.bytes,0,64);let mut expected:|model|::ObjectStore=store;
 let query:|object_queries|::QueryResult=|object_queries|::object_type(&store.space,0,1);let direct:bool=fb_type_five(query);
 let transparent:|object_queries|::QueryResult=|object_queries|::object_type(&store.space,2,2);let indirect:bool=fb_type_five(transparent);
 let scalar:|execution_model|::SlotResult=|frames|::scalar_slot(size,value);
 let admitted:|execution_model|::ExecutionOutcome=|generic_values|::validate_operand(&input,0,0,&store,|execution_model|::Operand::Object {object_id:0});
 let allowed:|execution_model|::ExecutionOutcome=|generic_values|::destination_allowed(&store,0);
 let stored:|execution_model|::BindingResult=|generic_target_values|::apply_selected(&input,0,0,size,&mut store,|generic_target_model|::TargetSelection::Named {object_id:0},|execution_model|::Operand::Integer {number:9},false);
 let copied:|execution_model|::BindingResult=|generic_target_values|::apply_selected(&input,0,0,size,&mut store,|generic_target_model|::TargetSelection::Named {object_id:0},|execution_model|::Operand::Object {object_id:1},true);
 let source:|execution_model|::BindingResult=|generic_target_values|::apply_selected(&input,0,0,size,&mut store,|generic_target_model|::TargetSelection::Named {object_id:1},|execution_model|::Operand::Object {object_id:0},true);
 let precedence:|execution_model|::BindingResult=|generic_target_values|::apply_selected(&input,0,0,size,&mut store,|generic_target_model|::TargetSelection::Named {object_id:0},|execution_model|::Operand::Object {object_id:64},false);
 fb_corrupt(&mut expected,control);
 let space_entries:bool=fb_entries(&store.space,&expected.space,0,32,true);let space_objects:bool=fb_objects(&store.space,&expected.space,0,64,true);let arena:bool=fb_equal_bytes(&store.bytes,&expected.bytes,0,64,true);
 transition direct && indirect && scalar.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && admitted==|execution_model|::ExecutionOutcome::UnresolvedRegion && allowed==|execution_model|::ExecutionOutcome::UnresolvedRegion && stored.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && copied.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && source.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && precedence.outcome==|execution_model|::ExecutionOutcome::UnresolvedRegion && space_entries && space_objects && arena && store.space.count==expected.space.count && store.space.object_count==expected.space.object_count {true -> (0) _ -> (1)}
}
machine fb_corrupt(store:&mut |model|::ObjectStore,control:bool) {transition control {true -> change(store) _ -> {}}state change(store:&mut |model|::ObjectStore) {store.bytes.blocks[63].bytes[255]=store.bytes.blocks[63].bytes[255]^1;}}
data Suite {}
machine Suite::region_FourBytes_positive(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Region {region_object:17},|integers|::IntegerSize::FourBytes,false);result}
machine Suite::region_FourBytes_control(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Region {region_object:17},|integers|::IntegerSize::FourBytes,true);result}
machine Suite::region_EightBytes_positive(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Region {region_object:17},|integers|::IntegerSize::EightBytes,false);result}
machine Suite::region_EightBytes_control(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Region {region_object:17},|integers|::IntegerSize::EightBytes,true);result}
machine Suite::bank_FourBytes_positive(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Bank {region_object:17,selector_object:31},|integers|::IntegerSize::FourBytes,false);result}
machine Suite::bank_FourBytes_control(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Bank {region_object:17,selector_object:31},|integers|::IntegerSize::FourBytes,true);result}
machine Suite::bank_EightBytes_positive(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Bank {region_object:17,selector_object:31},|integers|::IntegerSize::EightBytes,false);result}
machine Suite::bank_EightBytes_control(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Bank {region_object:17,selector_object:31},|integers|::IntegerSize::EightBytes,true);result}
machine Suite::index_FourBytes_positive(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Index {index_object:17,data_object:31},|integers|::IntegerSize::FourBytes,false);result}
machine Suite::index_FourBytes_control(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Index {index_object:17,data_object:31},|integers|::IntegerSize::FourBytes,true);result}
machine Suite::index_EightBytes_positive(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Index {index_object:17,data_object:31},|integers|::IntegerSize::EightBytes,false);result}
machine Suite::index_EightBytes_control(&mut self)->i32 {let result:i32=fb_boundary(|model|::FieldBinding::Index {index_object:17,data_object:31},|integers|::IntegerSize::EightBytes,true);result}
