use {aml}/field_model.omg;
use {integers}/integers.omg;
use {values}/read.omg;
data Main {words:[u64;257];}machine Main::main(&mut self){let field:|field_model|::Field=|field_model|::Field {};_ = |read|::assemble(|field_model|::DeclarationKind::Field,&field,4,|integers|::IntegerSize::EightBytes,&self.words,0);}
