use {resources}/resource_model.omg;
use {resources}/resource_parse.omg;
use {resources}/resource_template.omg;
use {resources}/resource_irq.omg;
use {resources}/resource_connections.omg;
machine test()->i32 {let mut input:[u8;4096];let pins:|resource_model|::Span=|resource_model|::Span{start:0,end:2};let r:|resource_model|::NumberResult=|resource_connections|::pin_at(&input,18446744073709551615,pins,0);transition r.outcome==|resource_model|::Outcome::InvalidState && r.value==0 {true -> (0) _ -> (1)}}
const RESULT:i32=test();
machine require_ok(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_ok(RESULT);}
