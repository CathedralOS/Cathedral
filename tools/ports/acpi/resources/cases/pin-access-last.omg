use {resources}/resource_model.omg;
use {resources}/resource_parse.omg;
use {resources}/resource_template.omg;
use {resources}/resource_irq.omg;
use {resources}/resource_connections.omg;
machine test()->i32 {let mut input:[u8;4096];input[4094]=255;input[4095]=255;let pins:|resource_model|::Span=|resource_model|::Span{start:4094,end:4096};let r:|resource_model|::NumberResult=|resource_connections|::pin_at(&input,4096,pins,0);transition r.outcome==|resource_model|::Outcome::Success && r.value==65535 {true -> (0) _ -> (1)}}
const RESULT:i32=test();
machine require_ok(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_ok(RESULT);}
