use {resources}/resource_model.omg;
use {resources}/resource_parse.omg;
use {resources}/resource_template.omg;
use {resources}/resource_irq.omg;
use {resources}/resource_connections.omg;
machine test()->i32 {let mut input:[u8;4096];input[4092]=152;input[4093]=186;input[4094]=220;input[4095]=254;let interrupts:|resource_model|::Interrupts=|resource_model|::Interrupts::Table{entries:|resource_model|::Span{start:4092,end:4096},count:1};let r:|resource_model|::NumberResult=|resource_irq|::irq_at(&input,4096,interrupts,0);transition r.outcome==|resource_model|::Outcome::Success && r.value==4275878552 {true -> (0) _ -> (1)}}
const RESULT:i32=test();
machine require_ok(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_ok(RESULT);}
