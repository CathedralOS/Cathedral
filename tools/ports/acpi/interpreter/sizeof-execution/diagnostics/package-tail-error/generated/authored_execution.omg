let mut main_path:Path=Path {absolute:true,count:1};main_path.segments[0]=1313423693;
let mut arguments:[Value;7];let result:ExecutionResult=run_program(&mut program,main_path,&arguments,0,IntegerSize::EightBytes,128);
transition prepared.outcome==Outcome::Success && result.outcome==ExecutionOutcome::Success && result.has_value && result.value.initialized && result.value.number==1 {true -> (0) _ -> (1)}
}
