store.space.objects[0].value=Value::Reference {kind:ReferenceKind::Named,object_id:1};
store.space.objects[1].value=Value::Integer {number:42};

let result:ReferenceState=resolve_object(&store.space,0,64);let good:bool=result.done && result.outcome==Outcome::Success && result.object==0 && result.visited==3;transition good {true -> (0) _ -> (1)}}
machine SizeOfMetadataSuite::type_Named_positive(&mut self)->i32 {
