store.space.objects[0].value=Value::Reference {kind:ReferenceKind::Named,object_id:1};
store.space.objects[1].value=Value::Integer {number:42};

let result:QueryResult=object_type(&store.space,0,64);let good:bool=query_equal(result,QueryResult::Value {object:1,number:1});transition good {true -> (0) _ -> (1)}}
