module second;
data Shared [copy] {right:u64;}
pub data SecondSuite [copy] {}
machine read(value:Shared)->u64 {value.right}
pub machine SecondSuite::positive(&mut self)->i32 {let data:Shared=Shared {right:11};let number:u64=read(data);transition number==11 {true -> (0) _ -> (1)}}
pub machine SecondSuite::control(&mut self)->i32 {let data:Shared=Shared {right:11};let number:u64=read(data);transition number==12 {true -> (0) _ -> (1)}}
