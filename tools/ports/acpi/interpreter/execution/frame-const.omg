// Current frame admission and u64 maximum-offset regression, executed as a const.
use {aml}/model.omg;
use {execution}/execution_model.omg;
use {execution}/frames.omg;
use {integer_helpers}/integers.omg;
machine test_frame_admission() -> i32 {
    let mut path: |model|::Path = |model|::Path { absolute: true, count: 1 };
    path.segments[0] = 0x4e49414d;
    let valid_body: |model|::Span = |model|::Span { unit: 7, start: 0, end: 1 };
    let invalid_body: |model|::Span = |model|::Span { unit: 7, start: 0xffffffffffffffff, end: 1 };
    let mut definitions: [|model|::MethodDefinition; 64];
    let arguments: [|model|::Value; 7];
    definitions[0] = |model|::MethodDefinition { present: true, scope: path, body: valid_body };
    let valid: |execution_model|::FrameResult = |frames|::observed_frame(|model|::Value::Method { body: valid_body }, 0, &definitions, &arguments, 0, |integers|::IntegerSize::FourBytes, 7, 1);
    definitions[0].body = invalid_body;
    let invalid: |execution_model|::FrameResult = |frames|::observed_frame(|model|::Value::Method { body: invalid_body }, 0, &definitions, &arguments, 0, |integers|::IntegerSize::FourBytes, 7, 1);
    transition valid.outcome == |execution_model|::ExecutionOutcome::Success && invalid.outcome == |execution_model|::ExecutionOutcome::Truncated {
        true -> (0) _ -> (1)
    }
}
const TEST_RESULT: i32 = test_frame_admission();
machine require_success(value: i32) requires value == 0; {}
data Main {}
machine Main::main(&mut self) { require_success(TEST_RESULT); }
