use helpers::byte_comparison;
use helpers::byte_comparison::Comparison;
use helpers::byte_comparison::BufferOrdering;
machine test_result()->i32 {
let mut left:[u8;256];let mut right:[u8;256];
let observed:Comparison=byte_comparison::compare_buffers(&left,0,&right,0,BufferOrdering::Lexicographic);transition observed {Comparison::Equal -> (0) _ -> (1)} }
const TEST_RESULT:i32=test_result();
machine require_ok(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
