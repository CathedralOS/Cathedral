machine test_upstream_copy_bits() -> bool {
    let mut source: [u8; 256];
    source[0] = 191;
    source[1] = 247;
    source[2] = 255;
    source[3] = 255;
    source[4] = 255;
    let mut destination: [u8; 256];
    destination[0] = 225;
    let error: u8 = copy_bits(&source, 5, 0, &mut destination, 5, 2, 15);
    error == 0 && destination[0] == 253 && destination[1] == 222 && destination[2] == 1 && destination[3] == 0 && destination[4] == 0
}
