machine test_last_byte_copy() -> bool {
    let mut source: [u8; 256];
    let mut output: [u8; 256];
    source[255] = 128;
    output[255] = 1;
    let error: u8 = copy_bits(&source, 256, 2047, &mut output, 256, 2047, 1);
    error == 0 && output[255] == 129 && output[254] == 0
}
machine test_last_bit_field() -> bool {
    let mut source: [u8; 256];
    source[255] = 128;
    let result: IntegerResult = field_to_integer(IntegerSize::EightBytes, &source, 256, 2047, 64);
    result.error == 0 && result.value == 1
}
machine test_last_byte_mid() -> bool {
    let mut source: [u8; 256];
    let mut output: [u8; 256];
    output[0] = 99;
    output[1] = 99;
    source[255] = 42;
    let result: IntegerResult = mid(&source, 256, 255, 18446744073709551615, &mut output);
    result.error == 0 && result.value == 1 && output[0] == 42 && output[1] == 99
}
machine test_asl_incdec() -> bool {
    let a: IntegerResult = binary(IntegerSize::FourBytes, Binary::Add, 0, 1);
    let b: IntegerResult = binary(IntegerSize::FourBytes, Binary::Add, a.value, 1);
    let c: IntegerResult = binary(IntegerSize::FourBytes, Binary::Add, b.value, 1);
    let y: u64 = c.value;
    let x: IntegerResult = binary(IntegerSize::FourBytes, Binary::Subtract, c.value, 1);
    x.value == 2 && y == 3
}
machine test_asl_logical_not() -> bool {
    let result: u64 = logical_not(IntegerSize::FourBytes, 1);
    result == 0
}
data Main {}
machine Main::main(&mut self) {}
