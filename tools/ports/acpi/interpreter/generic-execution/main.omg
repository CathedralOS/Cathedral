state patch_33(program:&mut Program)->u8 {program.store.space.objects[1].value=Value::Reference {kind:ReferenceKind::RefOf,object_id:0};0}
state patch_34(program:&mut Program)->u8 {program.store.space.object_count=64;0}
state patch_36(program:&mut Program)->u8 {program.store.space.objects[1].value=Value::Reference {kind:ReferenceKind::RefOf,object_id:0};0}
