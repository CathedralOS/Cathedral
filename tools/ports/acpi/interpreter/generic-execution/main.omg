state patch_42(program:&mut Program)->u8 {program.store.space.object_count=64;0}
state patch_43(program:&mut Program)->u8 {program.store.space.objects[0].value=Value::Buffer {buffer_storage:BufferStorage::Source {declared_size:1,buffer_initializer:Span {unit:8,start:0,end:1}}};0}
state patch_44(program:&mut Program)->u8 {program.store.space.objects[0].value=Value::Buffer {buffer_storage:BufferStorage::Owned {buffer_owner:1}};0}
