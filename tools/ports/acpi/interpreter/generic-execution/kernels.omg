// Independent canonical copy kernels; no engine or pipeline import.
use {aml}/model.omg;
use {aml}/byte_storage.omg;
use {execution}/execution_model.omg;
use {execution}/generic_values.omg;
machine gk_integer(value:|model|::Value,expected:u64)->bool {transition value {|model|::Value::Integer {number} -> (number==expected) _ -> (false)}}
machine gk_package(value:|model|::Value,expected:u64)->bool {transition value {|model|::Value::Package {first,count} -> (first==expected && count==2) _ -> (false)}}
machine gk_check(kind:u64,expected:u64)->i32 {
 let mut input:[u8;1024];input[0]=65;input[1]=66;
 let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.object_count=4;
 store.space.objects[0].value=|model|::Value::String {string_storage:|model|::StringStorage::Source {string_source:|model|::Span {unit:7,start:0,end:2}}};
 store.space.objects[1].value=|model|::Value::Integer {number:9};
 let result:bool=gk_operation(&input,&mut store,kind,expected);
 transition result {true -> (0) _ -> (1)}
}
machine gk_operation(input:&[u8;1024],store:&mut |model|::ObjectStore,kind:u64,expected:u64)->bool {
 transition kind {0 -> bytes(input,store,expected) 1 -> self_copy(input,store,expected) 2 -> clear_owned(input,store,expected) 3 -> invalid_owner(input,store,expected) 4 -> package(input,store,expected) 5 -> capacity(input,store,expected) _ -> (false)}
 state bytes(input:&[u8;1024],store:&mut |model|::ObjectStore,expected:u64)->bool {
  let outcome:|execution_model|::ExecutionOutcome=|generic_values|::copy_into(input,2,7,store,1,|execution_model|::Operand::Object {object_id:0});
  let read:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,2,7,store,1);
  outcome==|execution_model|::ExecutionOutcome::Success && read.outcome==|byte_storage|::ByteOutcome::Success && read.length==2 && read.bytes[0] as u64==expected && store.bytes.blocks[1].initialized
 }
 state self_copy(input:&[u8;1024],store:&mut |model|::ObjectStore,expected:u64)->bool {
  store.space.objects[0].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:0}};
  store.bytes.blocks[0]=|model|::ByteBlock {initialized:true,length:2};store.bytes.blocks[0].bytes[0]=17;store.bytes.blocks[0].bytes[1]=34;
  let outcome:|execution_model|::ExecutionOutcome=|generic_values|::copy_into(input,2,7,store,0,|execution_model|::Operand::Object {object_id:0});let read:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,2,7,store,0);
  outcome==|execution_model|::ExecutionOutcome::Success && read.outcome==|byte_storage|::ByteOutcome::Success && read.length==2 && read.bytes[0] as u64==expected && read.bytes[1]==34
 }
 state clear_owned(input:&[u8;1024],store:&mut |model|::ObjectStore,expected:u64)->bool {
  store.space.objects[1].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:1}};store.bytes.blocks[1]=|model|::ByteBlock {initialized:true,length:1};store.bytes.blocks[1].bytes[0]=99;
  let outcome:|execution_model|::ExecutionOutcome=|generic_values|::copy_into(input,2,7,store,1,|execution_model|::Operand::Integer {number:22});let value:bool=gk_integer(store.space.objects[1].value,expected);
  outcome==|execution_model|::ExecutionOutcome::Success && value && !store.bytes.blocks[1].initialized
 }
 state invalid_owner(input:&[u8;1024],store:&mut |model|::ObjectStore,expected:u64)->bool {
  store.space.objects[0].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:1}};
  let outcome:|execution_model|::ExecutionOutcome=|generic_values|::copy_into(input,2,7,store,1,|execution_model|::Operand::Object {object_id:0});let value:bool=gk_integer(store.space.objects[1].value,expected);
  outcome==|execution_model|::ExecutionOutcome::InvalidState && value && !store.bytes.blocks[1].initialized
 }
 state package(input:&[u8;1024],store:&mut |model|::ObjectStore,expected:u64)->bool {
  store.space.objects[0].value=|model|::Value::Package {first:1,count:2};store.space.objects[1]=|model|::Object {value:|model|::Value::Integer {number:11},has_next:true,next:2};store.space.objects[2].value=|model|::Value::Integer {number:22};
  let outcome:|execution_model|::ExecutionOutcome=|generic_values|::copy_into(input,2,7,store,3,|execution_model|::Operand::Object {object_id:0});let changed:|execution_model|::ExecutionOutcome=|generic_values|::copy_into(input,2,7,store,1,|execution_model|::Operand::Integer {number:99});
  let same:bool=gk_package(store.space.objects[3].value,expected);let value:bool=gk_integer(store.space.objects[1].value,99);
  outcome==|execution_model|::ExecutionOutcome::Success && changed==|execution_model|::ExecutionOutcome::Success && same && value && store.space.objects[1].has_next && store.space.objects[1].next==2
 }
 state capacity(input:&[u8;1024],store:&mut |model|::ObjectStore,expected:u64)->bool {
  store.space.object_count=64;let copied:|execution_model|::BindingResult=|generic_values|::copied_binding(input,2,7,store,|execution_model|::Binding::Uninitialized,|execution_model|::Operand::Object {object_id:0});
  copied.outcome==|execution_model|::ExecutionOutcome::Capacity && store.space.object_count==expected && !store.bytes.blocks[0].initialized
 }
}
data Kernels {}
machine Kernels::bytes_positive(&mut self)->i32 {let result:i32=gk_check(0,65);result}
machine Kernels::bytes_control(&mut self)->i32 {let result:i32=gk_check(0,66);result}
machine Kernels::self_positive(&mut self)->i32 {let result:i32=gk_check(1,17);result}
machine Kernels::self_control(&mut self)->i32 {let result:i32=gk_check(1,18);result}
machine Kernels::clear_positive(&mut self)->i32 {let result:i32=gk_check(2,22);result}
machine Kernels::clear_control(&mut self)->i32 {let result:i32=gk_check(2,23);result}
machine Kernels::invalid_positive(&mut self)->i32 {let result:i32=gk_check(3,9);result}
machine Kernels::invalid_control(&mut self)->i32 {let result:i32=gk_check(3,10);result}
machine Kernels::package_positive(&mut self)->i32 {let result:i32=gk_check(4,1);result}
machine Kernels::package_control(&mut self)->i32 {let result:i32=gk_check(4,2);result}
machine Kernels::capacity_positive(&mut self)->i32 {let result:i32=gk_check(5,64);result}
machine Kernels::capacity_control(&mut self)->i32 {let result:i32=gk_check(5,63);result}
