use {aml}/model.omg;
use {aml}/byte_storage.omg;
use {execution}/execution_model.omg;
use {execution}/generic_target_model.omg;
use {execution}/generic_target_values.omg;
use {execution}/generic_values.omg;
use {integer_helpers}/integers.omg;
data Suite {}
machine dt_number(input:&[u8;1024],store:&|model|::ObjectStore,operand:|execution_model|::Operand)->u64 {
 let result:|execution_model|::ValueResult=|generic_values|::read_value(store,operand);
 transition result.value {|model|::Value::Integer {number} -> (number) |model|::Value::String {string_storage} -> bytes(input,store,result) _ -> (999)}
 state bytes(input:&[u8;1024],store:&|model|::ObjectStore,result:|execution_model|::ValueResult)->u64 {let bytes:|byte_storage|::ByteRead=|generic_values|::byte_snapshot(input,1,7,store,result);bytes.bytes[0] as u64}
}
machine dt_case(mode:u64,expected:u64)->i32 {
 let mut input:[u8;1024];input[0]=65;
 let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.object_count=3;
 store.space.objects[0].value=|model|::Value::Integer {number:11};
 store.space.objects[1].value=|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:0};
 store.space.objects[2].value=|model|::Value::String {string_storage:|model|::StringStorage::Source {string_source:|model|::Span {unit:7,end:1}}};
 let selected:|generic_target_model|::TargetSelection=dt_select(mode);let operand:|execution_model|::Operand=dt_source(mode);
 let result:|execution_model|::BindingResult=|generic_target_values|::apply_selected(&input,1,7,|integers|::IntegerSize::EightBytes,&mut store,selected,operand,mode==3 || mode==5 || mode==9);
 let observed:u64=dt_observation(&input,&store,result.binding,mode);
 let original:u64=dt_number(&input,&store,|execution_model|::Operand::Object {object_id:0});
 let expected_outcome:|execution_model|::ExecutionOutcome=dt_expected(mode);
 let count:u64=dt_count(mode);
 let good:bool=dt_result(mode,observed,expected,original,result.outcome,expected_outcome,store.space.object_count,count);
 transition good {true -> (0) _ -> (1)}
}
machine dt_result(mode:u64,observed:u64,expected:u64,original:u64,outcome:|execution_model|::ExecutionOutcome,wanted:|execution_model|::ExecutionOutcome,count:u64,expected_count:u64)->bool {observed==expected && outcome==wanted && count==expected_count && ((mode==2 || mode==3 || mode==5) || original==11)}
machine dt_expected(mode:u64)->|execution_model|::ExecutionOutcome {transition mode {4 -> (|execution_model|::ExecutionOutcome::UnsupportedValue) 6 -> (|execution_model|::ExecutionOutcome::InvalidTarget) 7 -> (|execution_model|::ExecutionOutcome::InvalidTarget) 8 -> (|execution_model|::ExecutionOutcome::MissingObject) _ -> (|execution_model|::ExecutionOutcome::Success)}}
machine dt_count(mode:u64)->u64 {transition mode==9 {true -> (4) _ -> (3)}}
machine dt_source(mode:u64)->|execution_model|::Operand {transition mode<2 {true -> (|execution_model|::Operand::Integer {number:22}) _ -> (|execution_model|::Operand::Object {object_id:2})}}
machine dt_select(mode:u64)->|generic_target_model|::TargetSelection {
 transition mode {
 0 -> (|generic_target_model|::TargetSelection::Argument {argument_index:0,argument_binding:|execution_model|::Binding::Shared {shared_id:0}})
 1 -> (|generic_target_model|::TargetSelection::Local {local_index:0,local_binding:|execution_model|::Binding::Cell {cell_id:1}})
 2 -> (|generic_target_model|::TargetSelection::Argument {argument_index:0,argument_binding:|execution_model|::Binding::Shared {shared_id:1}})
 3 -> (|generic_target_model|::TargetSelection::Argument {argument_index:0,argument_binding:|execution_model|::Binding::Shared {shared_id:1}})
 6 -> (|generic_target_model|::TargetSelection::Local {local_index:8,local_binding:|execution_model|::Binding::Uninitialized})
 7 -> (|generic_target_model|::TargetSelection::Argument {argument_index:18446744073709551615,argument_binding:|execution_model|::Binding::Uninitialized})
 8 -> (|generic_target_model|::TargetSelection::Named {object_id:18446744073709551615})
 9 -> (|generic_target_model|::TargetSelection::Local {local_index:0,local_binding:|execution_model|::Binding::Uninitialized})
 _ -> (|generic_target_model|::TargetSelection::Named {object_id:0})
 }
}
machine dt_observation(input:&[u8;1024],store:&|model|::ObjectStore,binding:|execution_model|::Binding,mode:u64)->u64 {
 transition mode<2 || mode==9 {true -> binding(input,store,binding) _ -> object(input,store)}
 state binding(input:&[u8;1024],store:&|model|::ObjectStore,binding:|execution_model|::Binding)->u64 {let operand:|execution_model|::Operand=|generic_values|::binding_operand(binding);let result:u64=dt_number(input,store,operand);result}
 state object(input:&[u8;1024],store:&|model|::ObjectStore)->u64 {let result:u64=dt_number(input,store,|execution_model|::Operand::Object {object_id:0});result}
}
machine Suite::target_0_0(&mut self)->i32 {let result:i32=dt_case(0,22);result}
machine Suite::target_0_1(&mut self)->i32 {let result:i32=dt_case(0,23);result}
machine Suite::target_1_0(&mut self)->i32 {let result:i32=dt_case(1,22);result}
machine Suite::target_1_1(&mut self)->i32 {let result:i32=dt_case(1,23);result}
machine Suite::target_2_0(&mut self)->i32 {let result:i32=dt_case(2,65);result}
machine Suite::target_2_1(&mut self)->i32 {let result:i32=dt_case(2,66);result}
machine Suite::target_3_0(&mut self)->i32 {let result:i32=dt_case(3,65);result}
machine Suite::target_3_1(&mut self)->i32 {let result:i32=dt_case(3,66);result}
machine Suite::target_4_0(&mut self)->i32 {let result:i32=dt_case(4,11);result}
machine Suite::target_4_1(&mut self)->i32 {let result:i32=dt_case(4,12);result}
machine Suite::target_5_0(&mut self)->i32 {let result:i32=dt_case(5,65);result}
machine Suite::target_5_1(&mut self)->i32 {let result:i32=dt_case(5,66);result}
machine Suite::target_6_0(&mut self)->i32 {let result:i32=dt_case(6,11);result}
machine Suite::target_6_1(&mut self)->i32 {let result:i32=dt_case(6,12);result}
machine Suite::target_7_0(&mut self)->i32 {let result:i32=dt_case(7,11);result}
machine Suite::target_7_1(&mut self)->i32 {let result:i32=dt_case(7,12);result}
machine Suite::target_8_0(&mut self)->i32 {let result:i32=dt_case(8,11);result}
machine Suite::target_8_1(&mut self)->i32 {let result:i32=dt_case(8,12);result}
machine Suite::target_9_0(&mut self)->i32 {let result:i32=dt_case(9,65);result}
machine Suite::target_9_1(&mut self)->i32 {let result:i32=dt_case(9,66);result}
