let mut arguments:[|model|::Value;7];arguments[0]=|model|::Value::Integer {number:18446744073709551615};

let mut expected:|model|::ObjectStore=|model|::ObjectStore {space:store.space,bytes:store.bytes};

expected.bytes.blocks[63].bytes[255]=78;
let result:|external_arguments|::ExternalArguments=|external_arguments|::prepare_external_arguments(&input,1,7,&mut store,&arguments,1,|integers|::IntegerSize::FourBytes);
let payload:bool=ex_operand(result.operands[0],1,4294967295);let unchanged:bool=fx_store(&store,&expected);
transition result.outcome==|execution_model|::ExecutionOutcome::Success && payload && unchanged {true -> (0) _ -> (1)}
}
