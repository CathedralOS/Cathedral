machine Suite::late_owned_0(&mut self)->i32 {
let mut input:[u8;1024];input[0]=65;
let mut store:ObjectStore=ObjectStore {};store.space.object_count=1;store.space.objects[0].value=Value::Integer {number:11};store.bytes.blocks[63].bytes[255]=77;
let mut arguments:[Value;7];arguments[0]=Value::Buffer {buffer_storage:BufferStorage::Source {declared_size:1,buffer_initializer:Span {unit:7,end:1}}};
arguments[1]=Value::Buffer {buffer_storage:BufferStorage::Owned {buffer_owner:0}};
let mut expected:ObjectStore=ObjectStore {space:store.space,bytes:store.bytes};

let result:ExternalArguments=prepare_external_arguments(&input,1,7,&mut store,&arguments,2,IntegerSize::FourBytes);
let payload:bool=ex_operand(result.operands[0],0,0);let unchanged:bool=fx_store(&store,&expected);
