use {omega}/language/core/nat.omg;
use {aml}/model.omg;
use {execution}/execution_model.omg;
use {integer_helpers}/integers.omg;
use {execution}/generic_target_bridge.omg;
data Suite {}
machine fx_bytes_equal(a:&[u8;256],b:&[u8;256],i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_byte_equal(a,b,i,n);transition i<n {true -> fx_bytes_equal(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_byte_equal(a:&[u8;256],b:&[u8;256],i:u64,n:u64)->bool {transition i<n && i<256 {true -> (a[i]==b[i]) _ -> (true)}}
machine fx_span(a:|model|::Span,b:|model|::Span)->bool {a.unit==b.unit && a.start==b.start && a.end==b.end}
machine fx_path(a:|model|::Path,b:|model|::Path)->bool {let good:bool=fx_segments(&a.segments,&b.segments,0,16,true);a.absolute==b.absolute && a.parents==b.parents && a.count==b.count && good}
machine fx_segments(a:&[u32;16],b:&[u32;16],i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_segment(a,b,i,n);transition i<n {true -> fx_segments(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_segment(a:&[u32;16],b:&[u32;16],i:u64,n:u64)->bool {transition i<n && i<16 {true -> (a[i]==b[i]) _ -> (true)}}
machine fx_string(a:|model|::StringStorage,b:|model|::StringStorage)->bool {
 transition a {|model|::StringStorage::Source {string_source} -> source(string_source,b) |model|::StringStorage::Owned {string_owner} -> owned(string_owner,b)}
 state source(a:|model|::Span,b:|model|::StringStorage)->bool {transition b {|model|::StringStorage::Source {string_source} -> span(a,string_source) _ -> (false)}}
 state span(a:|model|::Span,b:|model|::Span)->bool {let good:bool=fx_span(a,b);good}
 state owned(a:u64,b:|model|::StringStorage)->bool {transition b {|model|::StringStorage::Owned {string_owner} -> (a==string_owner) _ -> (false)}}
}
machine fx_buffer(a:|model|::BufferStorage,b:|model|::BufferStorage)->bool {
 transition a {|model|::BufferStorage::Source {declared_size,buffer_initializer} -> source(declared_size,buffer_initializer,b) |model|::BufferStorage::Owned {buffer_owner} -> owned(buffer_owner,b)}
 state source(size:u64,a:|model|::Span,b:|model|::BufferStorage)->bool {transition b {|model|::BufferStorage::Source {declared_size,buffer_initializer} -> span(size,a,declared_size,buffer_initializer) _ -> (false)}}
 state span(size:u64,a:|model|::Span,other:u64,b:|model|::Span)->bool {let good:bool=fx_span(a,b);size==other && good}
 state owned(a:u64,b:|model|::BufferStorage)->bool {transition b {|model|::BufferStorage::Owned {buffer_owner} -> (a==buffer_owner) _ -> (false)}}
}
machine fx_value(a:|model|::Value,b:|model|::Value)->bool {transition a {
|model|::Value::Uninitialized -> c_uninitialized(b)
|model|::Value::Integer {number} -> c_integer(number,b)
|model|::Value::String {string_storage} -> c_string(string_storage,b)
|model|::Value::Buffer {buffer_storage} -> c_buffer(buffer_storage,b)
|model|::Value::BufferField {backing_object,bit_offset,bit_length} -> c_bufferfield(backing_object,bit_offset,bit_length,b)
|model|::Value::Package {first,count} -> c_package(first,count,b)
|model|::Value::NameReference {name,scope} -> c_namereference(name,scope,b)
|model|::Value::Reference {kind,object_id} -> c_reference(kind,object_id,b)
|model|::Value::Method {flags,body} -> c_method(flags,body,b)
|model|::Value::Device -> c_device(b)
|model|::Value::Processor {id,address,length} -> c_processor(id,address,length,b)
|model|::Value::PowerResource {system_level,order} -> c_powerresource(system_level,order,b)
|model|::Value::ThermalZone -> c_thermalzone(b)
|model|::Value::Mutex {sync_level} -> c_mutex(sync_level,b)
|model|::Value::Event -> c_event(b)
|model|::Value::OperationRegion {space,base,length,scope} -> c_operationregion(space,base,length,scope,b)
}
state c_uninitialized(b:|model|::Value)->bool {transition b {|model|::Value::Uninitialized -> (true) _ -> (false)}}
state c_integer(a_number:u64,b:|model|::Value)->bool {transition b {|model|::Value::Integer {number} -> (a_number==number) _ -> (false)}}
state c_string(a_string_storage:|model|::StringStorage,b:|model|::Value)->bool {transition b {|model|::Value::String {string_storage} -> check_c_string(a_string_storage,string_storage) _ -> (false)}}
state check_c_string(a_string_storage:|model|::StringStorage,string_storage:|model|::StringStorage)->bool {let good_string_storage:bool=fx_string(a_string_storage,string_storage);good_string_storage}
state c_buffer(a_buffer_storage:|model|::BufferStorage,b:|model|::Value)->bool {transition b {|model|::Value::Buffer {buffer_storage} -> check_c_buffer(a_buffer_storage,buffer_storage) _ -> (false)}}
state check_c_buffer(a_buffer_storage:|model|::BufferStorage,buffer_storage:|model|::BufferStorage)->bool {let good_buffer_storage:bool=fx_buffer(a_buffer_storage,buffer_storage);good_buffer_storage}
state c_bufferfield(a_backing_object:u64,a_bit_offset:u64,a_bit_length:u64,b:|model|::Value)->bool {transition b {|model|::Value::BufferField {backing_object,bit_offset,bit_length} -> (a_backing_object==backing_object && a_bit_offset==bit_offset && a_bit_length==bit_length) _ -> (false)}}
state c_package(a_first:u64,a_count:u64,b:|model|::Value)->bool {transition b {|model|::Value::Package {first,count} -> (a_first==first && a_count==count) _ -> (false)}}
state c_namereference(a_name:|model|::Path,a_scope:|model|::Path,b:|model|::Value)->bool {transition b {|model|::Value::NameReference {name,scope} -> check_c_namereference(a_name,a_scope,name,scope) _ -> (false)}}
state check_c_namereference(a_name:|model|::Path,a_scope:|model|::Path,name:|model|::Path,scope:|model|::Path)->bool {let good_name:bool=fx_path(a_name,name);let good_scope:bool=fx_path(a_scope,scope);good_name && good_scope}
state c_reference(a_kind:|model|::ReferenceKind,a_object_id:u64,b:|model|::Value)->bool {transition b {|model|::Value::Reference {kind,object_id} -> (a_kind==kind && a_object_id==object_id) _ -> (false)}}
state c_method(a_flags:u8,a_body:|model|::Span,b:|model|::Value)->bool {transition b {|model|::Value::Method {flags,body} -> check_c_method(a_flags,a_body,flags,body) _ -> (false)}}
state check_c_method(a_flags:u8,a_body:|model|::Span,flags:u8,body:|model|::Span)->bool {let good_body:bool=fx_span(a_body,body);a_flags==flags && good_body}
state c_device(b:|model|::Value)->bool {transition b {|model|::Value::Device -> (true) _ -> (false)}}
state c_processor(a_id:u8,a_address:u32,a_length:u8,b:|model|::Value)->bool {transition b {|model|::Value::Processor {id,address,length} -> (a_id==id && a_address==address && a_length==length) _ -> (false)}}
state c_powerresource(a_system_level:u8,a_order:u16,b:|model|::Value)->bool {transition b {|model|::Value::PowerResource {system_level,order} -> (a_system_level==system_level && a_order==order) _ -> (false)}}
state c_thermalzone(b:|model|::Value)->bool {transition b {|model|::Value::ThermalZone -> (true) _ -> (false)}}
state c_mutex(a_sync_level:u8,b:|model|::Value)->bool {transition b {|model|::Value::Mutex {sync_level} -> (a_sync_level==sync_level) _ -> (false)}}
state c_event(b:|model|::Value)->bool {transition b {|model|::Value::Event -> (true) _ -> (false)}}
state c_operationregion(a_space:u8,a_base:u64,a_length:u64,a_scope:|model|::Path,b:|model|::Value)->bool {transition b {|model|::Value::OperationRegion {space,base,length,scope} -> check_c_operationregion(a_space,a_base,a_length,a_scope,space,base,length,scope) _ -> (false)}}
state check_c_operationregion(a_space:u8,a_base:u64,a_length:u64,a_scope:|model|::Path,space:u8,base:u64,length:u64,scope:|model|::Path)->bool {let good_scope:bool=fx_path(a_scope,scope);a_space==space && a_base==base && a_length==length && good_scope}
}
machine fx_store(a:&|model|::ObjectStore,b:&|model|::ObjectStore)->bool {
 let objects:bool=fx_objects(a,b,0,64,true);let entries:bool=fx_entries(&a.space,&b.space,0,32,true);
 a.space.object_count==b.space.object_count && a.space.count==b.space.count && objects && entries
}
machine fx_objects(a:&|model|::ObjectStore,b:&|model|::ObjectStore,i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_object(a,b,i,n);transition i<n {true -> fx_objects(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_object(a:&|model|::ObjectStore,b:&|model|::ObjectStore,i:u64,n:u64)->bool {
 transition i<n && i<64 {true -> item(a,b,i) _ -> (true)}
 state item(a:&|model|::ObjectStore,b:&|model|::ObjectStore,i:u64)->bool {
  let left:|model|::Object=a.space.objects[i];let right:|model|::Object=b.space.objects[i];let first:|model|::ByteBlock=a.bytes.blocks[i];let second:|model|::ByteBlock=b.bytes.blocks[i];
  let payload:bool=fx_value(left.value,right.value);
  let bytes:bool=fx_bytes_equal(&first.bytes,&second.bytes,0,256,true);
  payload && bytes && left.has_next==right.has_next && left.next==right.next && first.initialized==second.initialized && first.length==second.length
 }
}
machine fx_entries(a:&|model|::Namespace,b:&|model|::Namespace,i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_entry(a,b,i,n);transition i<n {true -> fx_entries(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_entry(a:&|model|::Namespace,b:&|model|::Namespace,i:u64,n:u64)->bool {
 transition i<n && i<32 {true -> item(a.entries[i],b.entries[i]) _ -> (true)}
 state item(a:|model|::Entry,b:|model|::Entry)->bool {let path:bool=fx_path(a.path,b.path);path && a.has_level==b.has_level && a.level==b.level && a.has_object==b.has_object && a.object==b.object && a.alias==b.alias}
}


machine ba_binding(a:|execution_model|::Binding,b:|execution_model|::Binding)->bool {
 transition a {|execution_model|::Binding::Uninitialized -> none(b) |execution_model|::Binding::Integer {number} -> integer(number,b) |execution_model|::Binding::Shared {shared_id} -> shared(shared_id,b) |execution_model|::Binding::Cell {cell_id} -> cell(cell_id,b)}
 state none(b:|execution_model|::Binding)->bool {transition b {|execution_model|::Binding::Uninitialized -> (true) _ -> (false)}}
 state integer(a:u64,b:|execution_model|::Binding)->bool {transition b {|execution_model|::Binding::Integer {number} -> (a==number) _ -> (false)}}
 state shared(a:u64,b:|execution_model|::Binding)->bool {transition b {|execution_model|::Binding::Shared {shared_id} -> (a==shared_id) _ -> (false)}}
 state cell(a:u64,b:|execution_model|::Binding)->bool {transition b {|execution_model|::Binding::Cell {cell_id} -> (a==cell_id) _ -> (false)}}
}
machine ba_operand(a:|execution_model|::Operand,b:|execution_model|::Operand)->bool {
 transition a {|execution_model|::Operand::Uninitialized -> none(b) |execution_model|::Operand::Integer {number} -> integer(number,b) |execution_model|::Operand::Object {object_id} -> object(object_id,b)}
 state none(b:|execution_model|::Operand)->bool {transition b {|execution_model|::Operand::Uninitialized -> (true) _ -> (false)}}
 state integer(a:u64,b:|execution_model|::Operand)->bool {transition b {|execution_model|::Operand::Integer {number} -> (a==number) _ -> (false)}}
 state object(a:u64,b:|execution_model|::Operand)->bool {transition b {|execution_model|::Operand::Object {object_id} -> (a==object_id) _ -> (false)}}
}
machine ba_target(a:|execution_model|::Target,b:|execution_model|::Target)->bool {
 transition a {|execution_model|::Target::Null -> null(b) |execution_model|::Target::Debug -> debug(b) |execution_model|::Target::Local {local_index} -> local(local_index,b) |execution_model|::Target::Argument {argument_index} -> argument(argument_index,b) |execution_model|::Target::Named {object_id} -> named(object_id,b)}
 state null(b:|execution_model|::Target)->bool {transition b {|execution_model|::Target::Null -> (true) _ -> (false)}}
 state debug(b:|execution_model|::Target)->bool {transition b {|execution_model|::Target::Debug -> (true) _ -> (false)}}
 state local(a:u64,b:|execution_model|::Target)->bool {transition b {|execution_model|::Target::Local {local_index} -> (a==local_index) _ -> (false)}}
 state argument(a:u64,b:|execution_model|::Target)->bool {transition b {|execution_model|::Target::Argument {argument_index} -> (a==argument_index) _ -> (false)}}
 state named(a:u64,b:|execution_model|::Target)->bool {transition b {|execution_model|::Target::Named {object_id} -> (a==object_id) _ -> (false)}}
}
machine ba_block(a:|execution_model|::Block,b:|execution_model|::Block)->bool {a.looping==b.looping && a.parent_end==b.parent_end && a.after==b.after && a.predicate==b.predicate && a.end==b.end}
machine ba_cache(a:|execution_model|::NameCache,b:|execution_model|::NameCache)->bool {a.at==b.at && a.next==b.next && a.object_id==b.object_id && a.entry_index==b.entry_index}
machine ba_operation(a:&|execution_model|::Operation,b:&|execution_model|::Operation)->bool {
 let operands:bool=ba_operands(a,b,0,7,true);let first:bool=ba_target(a.first_target,b.first_target);let second:bool=ba_target(a.second_target,b.second_target);let span:bool=fx_span(a.method_body,b.method_body);
 a.opcode==b.opcode && a.count==b.count && a.value_arity==b.value_arity && a.target_arity==b.target_arity && a.body_end==b.body_end && a.predicate==b.predicate && a.parent_end==b.parent_end && a.method_id==b.method_id && a.method_flags==b.method_flags && operands && first && second && span
}
machine ba_operands(a:&|execution_model|::Operation,b:&|execution_model|::Operation,i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=ba_operand_at(a,b,i,n);transition i<n {true -> ba_operands(a,b,i+1,n,prior && good) _ -> (prior)}}
machine ba_operand_at(a:&|execution_model|::Operation,b:&|execution_model|::Operation,i:u64,n:u64)->bool {
 transition i<n && i<7 {true -> selected(a.operands[i],b.operands[i]) _ -> (true)}
 state selected(left:|execution_model|::Operand,right:|execution_model|::Operand)->bool {let good:bool=ba_operand(left,right);good}
}
machine ba_frame(a:&|execution_model|::Frame,b:&|execution_model|::Frame)->bool {
 let scope:bool=fx_path(a.scope,b.scope);let body:bool=fx_span(a.body,b.body);let result:bool=ba_operand(a.return_value,b.return_value);
 let arrays:bool=ba_frame_arrays(a,b,0,16,true);
 scope && body && result && arrays && a.source_length==b.source_length && a.size==b.size && a.pc==b.pc && a.end==b.end && a.block_count==b.block_count && a.operation_count==b.operation_count && a.cache_count==b.cache_count && a.returned==b.returned && a.has_return_value==b.has_return_value
}
machine ba_frame_arrays(a:&|execution_model|::Frame,b:&|execution_model|::Frame,i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=ba_frame_at(a,b,i,n);transition i<n {true -> ba_frame_arrays(a,b,i+1,n,prior && good) _ -> (prior)}}
machine ba_frame_at(a:&|execution_model|::Frame,b:&|execution_model|::Frame,i:u64,n:u64)->bool {
 let small:bool=ba_frame_small(a,b,i);
 transition i<n && i<16 {true -> selected(a.operations[i],b.operations[i],a.lookup_cache[i],b.lookup_cache[i],small) _ -> (true)}
 state selected(left:|execution_model|::Operation,right:|execution_model|::Operation,left_cache:|execution_model|::NameCache,right_cache:|execution_model|::NameCache,small:bool)->bool {
  let operation:bool=ba_operation(&left,&right);let cache:bool=ba_cache(left_cache,right_cache);operation && cache && small
 }
}
machine ba_frame_small(a:&|execution_model|::Frame,b:&|execution_model|::Frame,i:u64)->bool {
 transition i<8 {true -> local(a,b,i) _ -> (true)}
 state local(a:&|execution_model|::Frame,b:&|execution_model|::Frame,i:u64)->bool {
  let binding:bool=ba_binding(a.locals[i],b.locals[i]);let block_good:bool=ba_block(a.blocks[i],b.blocks[i]);let argument:bool=ba_frame_argument(a,b,i);binding && block_good && argument
 }
}
machine ba_frame_argument(a:&|execution_model|::Frame,b:&|execution_model|::Frame,i:u64)->bool {transition i<7 {true -> item(a,b,i) _ -> (true)} state item(a:&|execution_model|::Frame,b:&|execution_model|::Frame,i:u64)->bool {let good:bool=ba_binding(a.arguments[i],b.arguments[i]);good}}
machine ba_check(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,operand:|execution_model|::Operand,copy:bool,expected_store:&|model|::ObjectStore,expected_frame:&|execution_model|::Frame,wanted:|execution_model|::ExecutionOutcome)->i32 {
 let outcome:|execution_model|::ExecutionOutcome=|generic_target_bridge|::write_generic_target(input,store,frame,target,operand,copy);
 let objects:bool=fx_store(store,expected_store);let callframe:bool=ba_frame(frame,expected_frame);
 transition outcome==wanted && objects && callframe {true -> (0) _ -> (1)}
}


machine ba_initial_store(row:u64)->|model|::ObjectStore {
 let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.object_count=3;store.bytes.blocks[63].bytes[255]=77;
 store.space.objects[0].value=|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:1};
 store.space.objects[1]=|model|::Object {value:|model|::Value::Integer {number:11},has_next:true,next:2};
 store.space.objects[2].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:1,buffer_initializer:|model|::Span {unit:7,end:1}}};
 transition row {1 -> capacity(store) 3 -> owner(store) 10 -> index(store) 12 -> method(store) 13 -> dangling(store) _ -> (store)}
 state capacity(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.object_count=64;result}
 state owner(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:2}};result}
 state index(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[0].value=|model|::Value::Reference {kind:|model|::ReferenceKind::Index,object_id:1};result}
 state method(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Method {};result}
 state dangling(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[0].value=|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:18446744073709551615};result}
}
machine ba_initial_frame(row:u64)->|execution_model|::Frame {
 let mut frame:|execution_model|::Frame=|execution_model|::Frame {source_length:1,body:|model|::Span {unit:7,end:1},end:1,size:|integers|::IntegerSize::EightBytes};
 frame.arguments[0]=|execution_model|::Binding::Shared {shared_id:0};frame.locals[0]=|execution_model|::Binding::Shared {shared_id:1};frame.lookup_cache[15].object_id=71;frame.operations[15].operands[6]=|execution_model|::Operand::Integer {number:59};
 transition row==2 {true -> bad_cell(frame) _ -> (frame)}
 state bad_cell(frame:|execution_model|::Frame)->|execution_model|::Frame {let mut result:|execution_model|::Frame=frame;result.locals[0]=|execution_model|::Binding::Cell {cell_id:18446744073709551615};result}
}
machine ba_selected_target(row:u64)->|execution_model|::Target {
 transition row {3 -> (|execution_model|::Target::Argument {argument_index:0}) 4 -> (|execution_model|::Target::Local {local_index:18446744073709551615}) 5 -> (|execution_model|::Target::Argument {argument_index:18446744073709551615}) 6 -> (|execution_model|::Target::Null) 7 -> (|execution_model|::Target::Debug) 8 -> (|execution_model|::Target::Null) 9 -> (|execution_model|::Target::Argument {argument_index:0}) 10 -> (|execution_model|::Target::Argument {argument_index:0}) 11 -> (|execution_model|::Target::Named {object_id:1}) 12 -> (|execution_model|::Target::Named {object_id:1}) 13 -> (|execution_model|::Target::Argument {argument_index:0}) _ -> (|execution_model|::Target::Local {local_index:0})}
}
machine ba_selected_operand(row:u64)->|execution_model|::Operand {transition row==0 || row==8 {true -> (|execution_model|::Operand::Uninitialized) _ -> (|execution_model|::Operand::Object {object_id:2})}}
machine ba_copy_mode(row:u64)->bool {row!=7 && row!=8 && row!=10 && row!=13}
machine ba_expected_store(original:|model|::ObjectStore,row:u64,control:bool)->|model|::ObjectStore {
 let mut result:|model|::ObjectStore=original;
 let tail:u8=ba_control_tail(row,control);result.bytes.blocks[63].bytes[255]=tail;
 transition row>=9 && row<=11 {true -> copied(result) _ -> (result)}
 state copied(store:|model|::ObjectStore)->|model|::ObjectStore {
  let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:1}};result.bytes.blocks[1]=|model|::ByteBlock {initialized:true,length:1};result.bytes.blocks[1].bytes[0]=17;result
 }
}
machine ba_control_tail(row:u64,control:bool)->u8 {transition control && row%2==1 {true -> (78) _ -> (77)}}
machine ba_control_cache(row:u64,control:bool)->u64 {transition control && row%2==0 {true -> (72) _ -> (71)}}
machine ba_scenario(row:u64,wanted:|execution_model|::ExecutionOutcome,control:bool)->i32 {
 let mut input:[u8;1024];input[0]=17;
 let mut store:|model|::ObjectStore=ba_initial_store(row);let mut frame:|execution_model|::Frame=ba_initial_frame(row);
 let expected_store:|model|::ObjectStore=ba_expected_store(|model|::ObjectStore {space:store.space,bytes:store.bytes},row,control);
 let mut expected_frame:|execution_model|::Frame=frame;let cache:u64=ba_control_cache(row,control);expected_frame.lookup_cache[15].object_id=cache;
 let target:|execution_model|::Target=ba_selected_target(row);let operand:|execution_model|::Operand=ba_selected_operand(row);let copy:bool=ba_copy_mode(row);
 let result:i32=ba_check(&input,&mut store,&mut frame,target,operand,copy,&expected_store,&expected_frame,wanted);result
}
