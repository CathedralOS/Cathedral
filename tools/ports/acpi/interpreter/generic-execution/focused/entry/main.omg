use {aml}/model.omg;
use {execution}/engine.omg;
use {execution}/execution_model.omg;
use {execution}/generic_values.omg;
use {integer_helpers}/integers.omg;
data Suite {}
machine xe_assert(store:&|model|::ObjectStore,result:|engine|::ExecutionResult,status:|execution_model|::ExecutionOutcome,tag:u64,number:u64,count:u64)->bool {
 let found:|execution_model|::ValueResult=|generic_values|::read_value(store,result.operand);let matched:bool=xe_kind(found.value,tag,number);
 result.outcome==status && store.space.object_count==count && ((status==|execution_model|::ExecutionOutcome::Success && result.has_value && matched) || (status!=|execution_model|::ExecutionOutcome::Success && !result.has_value && result.steps==0 && result.fault_offset==0))
}
machine xe_kind(value:|model|::Value,tag:u64,expected:u64)->bool {transition value {|model|::Value::Integer {number} -> (tag==1 && number==expected) |model|::Value::Buffer {buffer_storage} -> (tag==2) |model|::Value::Package {first,count} -> (tag==3 && count==expected) _ -> (false)}}
machine Suite::buffer_0(&mut self)->i32 {
let mut input:[u8;1024];input[0]=164;input[1]=104;input[2]=17;
let mut path:|model|::Path=|model|::Path {absolute:true,count:1};path.segments[0]=1313423693;let mut x:|model|::Path=|model|::Path {absolute:true,count:1};x.segments[0]=1600085848;let mut alias:|model|::Path=|model|::Path {absolute:true,count:1};alias.segments[0]=1600085842;
let body:|model|::Span=|model|::Span {unit:7,end:2};let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.count=3;store.space.object_count=3;
store.space.entries[0]=|model|::Entry {path:path,has_object:true,object:0};store.space.entries[1]=|model|::Entry {path:x,has_object:true,object:1};store.space.entries[2]=|model|::Entry {path:alias,has_object:true,object:2};
store.space.objects[0].value=|model|::Value::Method {flags:1,body:body};store.space.objects[1].value=|model|::Value::Integer {number:11};store.space.objects[2].value=|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1};
let mut definitions:[|model|::MethodDefinition;64];definitions[0]=|model|::MethodDefinition {present:true,object_id:0,flags:1,body:body,scope:|model|::Path {absolute:true}};
let mut arguments:[|model|::Value;7];arguments[0]=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:1,buffer_initializer:|model|::Span {unit:7,start:2,end:3}}};
let result:|engine|::ExecutionResult=|engine|::run_method(&input,3,7,&mut store,&definitions,path,&arguments,1,|integers|::IntegerSize::EightBytes,64);let good:bool=xe_assert(&store,result,|execution_model|::ExecutionOutcome::Success,2,0,4);transition good {true -> (0) _ -> (1)}
}
