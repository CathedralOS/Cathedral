data Suite {}
machine fc_case(args:&[Operand;7],definitions:&[MethodDefinition;64],flags:u8,body:Span,count:u64,size:IntegerSize,wanted:ExecutionOutcome,number:u64,length:u64)->i32 {
 let result:FrameResult=observed_frame(Value::Method {flags:flags,body:body},0,definitions,args,count,size,7,1);
 let payload:u64=fc_payload(result.frame.arguments[0]);
 let good:bool=fc_assert(result.outcome,wanted,payload,number,result.frame.source_length,length,result.frame.operation_count,result.frame.pc);
 transition good {true -> (0) _ -> (1)}
}
machine fc_assert(actual:ExecutionOutcome,wanted:ExecutionOutcome,payload:u64,expected:u64,length:u64,want_length:u64,operations:u64,pc:u64)->bool {actual==wanted && payload==expected && length==want_length && operations==0 && pc==0}
machine fc_payload(binding:Binding)->u64 {transition binding {Binding::Uninitialized -> (999) Binding::Integer {number} -> (number) Binding::Shared {shared_id} -> (shared_id) Binding::Cell {cell_id} -> (998)}}
