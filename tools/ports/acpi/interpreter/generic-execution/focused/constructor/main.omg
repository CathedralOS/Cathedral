machine fc_case(args:&[|execution_model|::Operand;7],definitions:&[|model|::MethodDefinition;64],flags:u8,body:|model|::Span,count:u64,size:|integers|::IntegerSize,wanted:|execution_model|::ExecutionOutcome,number:u64,length:u64)->i32 {
 let result:|execution_model|::FrameResult=|frames|::observed_frame(|model|::Value::Method {flags:flags,body:body},0,definitions,args,count,size,7,1);
 let payload:u64=fc_payload(result.frame.arguments[0]);
 let good:bool=fc_assert(result.outcome,wanted,payload,number,result.frame.source_length,length,result.frame.operation_count,result.frame.pc);
 transition good {true -> (0) _ -> (1)}
}
machine fc_assert(actual:|execution_model|::ExecutionOutcome,wanted:|execution_model|::ExecutionOutcome,payload:u64,expected:u64,length:u64,want_length:u64,operations:u64,pc:u64)->bool {actual==wanted && payload==expected && length==want_length && operations==0 && pc==0}
