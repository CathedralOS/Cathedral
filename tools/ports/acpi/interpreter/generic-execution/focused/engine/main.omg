use {aml}/model.omg;
use {execution}/engine.omg;
use {execution}/execution_model.omg;
use {integer_helpers}/integers.omg;
data Suite {}
machine de_case(buffer:bool,expected:u64)->i32 {
 let mut input:[u8;1024];input[0]=164;input[1]=104;input[2]=17;
 let mut path:|model|::Path=|model|::Path {absolute:true,count:1};path.segments[0]=1313423693;
 let body:|model|::Span=|model|::Span {unit:7,end:2};
 let mut store:|model|::ObjectStore=|model|::ObjectStore {};
 store.space.count=1;store.space.object_count=2;
 store.space.entries[0]=|model|::Entry {path:path,has_object:true,object:0};
 store.space.objects[0]=|model|::Object {value:|model|::Value::Method {flags:1,body:body}};
 store.space.objects[1]=|model|::Object {value:|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:1,buffer_initializer:|model|::Span {unit:7,start:2,end:3}}}};
 let mut definitions:[|model|::MethodDefinition;64];definitions[0]=|model|::MethodDefinition {present:true,object_id:0,flags:1,body:body,scope:|model|::Path {absolute:true}};
 let mut arguments:[|execution_model|::Operand;7];arguments[0]=de_argument(buffer);
 let result:|engine|::ExecutionResult=|engine|::run_operands(&input,3,7,&mut store,&definitions,path,&arguments,1,|integers|::IntegerSize::EightBytes,64);
 let number:u64=de_value(result.operand);
 let good:bool=de_assert(result.outcome,result.has_value,number,expected,store.space.object_count);
 transition good {true -> (0) _ -> (1)}
}
machine de_argument(buffer:bool)->|execution_model|::Operand {transition buffer {true -> (|execution_model|::Operand::Object {object_id:1}) _ -> (|execution_model|::Operand::Integer {number:23})}}
machine de_value(value:|execution_model|::Operand)->u64 {transition value {|execution_model|::Operand::Object {object_id} -> (object_id) |execution_model|::Operand::Integer {number} -> (number) _ -> (999)}}
machine de_assert(outcome:|execution_model|::ExecutionOutcome,present:bool,actual:u64,wanted:u64,count:u64)->bool {outcome==|execution_model|::ExecutionOutcome::Success && present && actual==wanted && count==2}
machine Suite::direct_0_0(&mut self)->i32 {let result:i32=de_case(false,23);result}
machine Suite::direct_0_1(&mut self)->i32 {let result:i32=de_case(false,24);result}
machine Suite::direct_1_0(&mut self)->i32 {let result:i32=de_case(true,1);result}
machine Suite::direct_1_1(&mut self)->i32 {let result:i32=de_case(true,2);result}
