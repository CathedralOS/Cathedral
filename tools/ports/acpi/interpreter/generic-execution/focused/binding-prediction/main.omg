data Suite {}
machine fx_bytes_equal(a:&[u8;256],b:&[u8;256],i:u64,n:u64,prior:bool)
terminates by(i,n)->Nat::BoundedDistance;
->bool {let good:bool=fx_byte_equal(a,b,i,n);transition i<n {true -> fx_bytes_equal(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_byte_equal(a:&[u8;256],b:&[u8;256],i:u64,n:u64)->bool {transition i<n && i<256 {true -> (a[i]==b[i]) _ -> (true)}}
machine fx_span(a:Span,b:Span)->bool {a.unit==b.unit && a.start==b.start && a.end==b.end}
machine fx_path(a:Path,b:Path)->bool {let good:bool=fx_segments(&a.segments,&b.segments,0,16,true);a.absolute==b.absolute && a.parents==b.parents && a.count==b.count && good}
machine fx_segments(a:&[u32;16],b:&[u32;16],i:u64,n:u64,prior:bool)
terminates by(i,n)->Nat::BoundedDistance;
->bool {let good:bool=fx_segment(a,b,i,n);transition i<n {true -> fx_segments(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_segment(a:&[u32;16],b:&[u32;16],i:u64,n:u64)->bool {transition i<n && i<16 {true -> (a[i]==b[i]) _ -> (true)}}
machine fx_string(a:StringStorage,b:StringStorage)->bool {
 transition a {StringStorage::Source {string_source} -> source(string_source,b) StringStorage::Owned {string_owner} -> owned(string_owner,b)}
 state source(a:Span,b:StringStorage)->bool {transition b {StringStorage::Source {string_source} -> span(a,string_source) _ -> (false)}}
 state span(a:Span,b:Span)->bool {let good:bool=fx_span(a,b);good}
 state owned(a:u64,b:StringStorage)->bool {transition b {StringStorage::Owned {string_owner} -> (a==string_owner) _ -> (false)}}
}
machine fx_buffer(a:BufferStorage,b:BufferStorage)->bool {
 transition a {BufferStorage::Source {declared_size,buffer_initializer} -> source(declared_size,buffer_initializer,b) BufferStorage::Owned {buffer_owner} -> owned(buffer_owner,b)}
 state source(size:u64,a:Span,b:BufferStorage)->bool {transition b {BufferStorage::Source {declared_size,buffer_initializer} -> span(size,a,declared_size,buffer_initializer) _ -> (false)}}
 state span(size:u64,a:Span,other:u64,b:Span)->bool {let good:bool=fx_span(a,b);size==other && good}
 state owned(a:u64,b:BufferStorage)->bool {transition b {BufferStorage::Owned {buffer_owner} -> (a==buffer_owner) _ -> (false)}}
}
machine fx_value(a:Value,b:Value)->bool {transition a {
Value::Uninitialized -> c_uninitialized(b)
Value::Integer {number} -> c_integer(number,b)
Value::String {string_storage} -> c_string(string_storage,b)
Value::Buffer {buffer_storage} -> c_buffer(buffer_storage,b)
Value::BufferField {backing_object,bit_offset,bit_length} -> c_bufferfield(backing_object,bit_offset,bit_length,b)
Value::Package {first,count} -> c_package(first,count,b)
Value::NameReference {name,scope} -> c_namereference(name,scope,b)
Value::Reference {kind,object_id} -> c_reference(kind,object_id,b)
Value::Method {flags,body} -> c_method(flags,body,b)
Value::Device -> c_device(b)
Value::Processor {id,address,length} -> c_processor(id,address,length,b)
Value::PowerResource {system_level,order} -> c_powerresource(system_level,order,b)
Value::ThermalZone -> c_thermalzone(b)
Value::Mutex {sync_level} -> c_mutex(sync_level,b)
Value::Event -> c_event(b)
Value::OperationRegion {space,base,length,scope} -> c_operationregion(space,base,length,scope,b)
}
state c_uninitialized(b:Value)->bool {transition b {Value::Uninitialized -> (true) _ -> (false)}}
state c_integer(a_number:u64,b:Value)->bool {transition b {Value::Integer {number} -> (a_number==number) _ -> (false)}}
state c_string(a_string_storage:StringStorage,b:Value)->bool {transition b {Value::String {string_storage} -> check_c_string(a_string_storage,string_storage) _ -> (false)}}
state check_c_string(a_string_storage:StringStorage,string_storage:StringStorage)->bool {let good_string_storage:bool=fx_string(a_string_storage,string_storage);good_string_storage}
state c_buffer(a_buffer_storage:BufferStorage,b:Value)->bool {transition b {Value::Buffer {buffer_storage} -> check_c_buffer(a_buffer_storage,buffer_storage) _ -> (false)}}
state check_c_buffer(a_buffer_storage:BufferStorage,buffer_storage:BufferStorage)->bool {let good_buffer_storage:bool=fx_buffer(a_buffer_storage,buffer_storage);good_buffer_storage}
state c_bufferfield(a_backing_object:u64,a_bit_offset:u64,a_bit_length:u64,b:Value)->bool {transition b {Value::BufferField {backing_object,bit_offset,bit_length} -> (a_backing_object==backing_object && a_bit_offset==bit_offset && a_bit_length==bit_length) _ -> (false)}}
state c_package(a_first:u64,a_count:u64,b:Value)->bool {transition b {Value::Package {first,count} -> (a_first==first && a_count==count) _ -> (false)}}
state c_namereference(a_name:Path,a_scope:Path,b:Value)->bool {transition b {Value::NameReference {name,scope} -> check_c_namereference(a_name,a_scope,name,scope) _ -> (false)}}
state check_c_namereference(a_name:Path,a_scope:Path,name:Path,scope:Path)->bool {let good_name:bool=fx_path(a_name,name);let good_scope:bool=fx_path(a_scope,scope);good_name && good_scope}
state c_reference(a_kind:ReferenceKind,a_object_id:u64,b:Value)->bool {transition b {Value::Reference {kind,object_id} -> (a_kind==kind && a_object_id==object_id) _ -> (false)}}
state c_method(a_flags:u8,a_body:Span,b:Value)->bool {transition b {Value::Method {flags,body} -> check_c_method(a_flags,a_body,flags,body) _ -> (false)}}
state check_c_method(a_flags:u8,a_body:Span,flags:u8,body:Span)->bool {let good_body:bool=fx_span(a_body,body);a_flags==flags && good_body}
state c_device(b:Value)->bool {transition b {Value::Device -> (true) _ -> (false)}}
state c_processor(a_id:u8,a_address:u32,a_length:u8,b:Value)->bool {transition b {Value::Processor {id,address,length} -> (a_id==id && a_address==address && a_length==length) _ -> (false)}}
state c_powerresource(a_system_level:u8,a_order:u16,b:Value)->bool {transition b {Value::PowerResource {system_level,order} -> (a_system_level==system_level && a_order==order) _ -> (false)}}
state c_thermalzone(b:Value)->bool {transition b {Value::ThermalZone -> (true) _ -> (false)}}
state c_mutex(a_sync_level:u8,b:Value)->bool {transition b {Value::Mutex {sync_level} -> (a_sync_level==sync_level) _ -> (false)}}
state c_event(b:Value)->bool {transition b {Value::Event -> (true) _ -> (false)}}
state c_operationregion(a_space:u8,a_base:u64,a_length:u64,a_scope:Path,b:Value)->bool {transition b {Value::OperationRegion {space,base,length,scope} -> check_c_operationregion(a_space,a_base,a_length,a_scope,space,base,length,scope) _ -> (false)}}
state check_c_operationregion(a_space:u8,a_base:u64,a_length:u64,a_scope:Path,space:u8,base:u64,length:u64,scope:Path)->bool {let good_scope:bool=fx_path(a_scope,scope);a_space==space && a_base==base && a_length==length && good_scope}
}
machine fx_store(a:&ObjectStore,b:&ObjectStore)->bool {
 let objects:bool=fx_objects(a,b,0,64,true);let entries:bool=fx_entries(&a.space,&b.space,0,32,true);
 a.space.object_count==b.space.object_count && a.space.count==b.space.count && objects && entries
}
machine fx_objects(a:&ObjectStore,b:&ObjectStore,i:u64,n:u64,prior:bool)
terminates by(i,n)->Nat::BoundedDistance;
->bool {let good:bool=fx_object(a,b,i,n);transition i<n {true -> fx_objects(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_object(a:&ObjectStore,b:&ObjectStore,i:u64,n:u64)->bool {
 transition i<n && i<64 {true -> item(a,b,i) _ -> (true)}
 state item(a:&ObjectStore,b:&ObjectStore,i:u64)->bool {
  let left:Object=a.space.objects[i];let right:Object=b.space.objects[i];let first:ByteBlock=a.bytes.blocks[i];let second:ByteBlock=b.bytes.blocks[i];
  let payload:bool=fx_value(left.value,right.value);
  let bytes:bool=fx_bytes_equal(&first.bytes,&second.bytes,0,256,true);
  payload && bytes && left.has_next==right.has_next && left.next==right.next && first.initialized==second.initialized && first.length==second.length
 }
}
machine fx_entries(a:&Namespace,b:&Namespace,i:u64,n:u64,prior:bool)
terminates by(i,n)->Nat::BoundedDistance;
->bool {let good:bool=fx_entry(a,b,i,n);transition i<n {true -> fx_entries(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_entry(a:&Namespace,b:&Namespace,i:u64,n:u64)->bool {
 transition i<n && i<32 {true -> item(a.entries[i],b.entries[i]) _ -> (true)}
 state item(a:Entry,b:Entry)->bool {let path:bool=fx_path(a.path,b.path);path && a.has_level==b.has_level && a.level==b.level && a.has_object==b.has_object && a.object==b.object && a.alias==b.alias}
}


machine bp_store(row:u64)->ObjectStore {
 let mut store:ObjectStore=ObjectStore {};store.space.object_count=4;
 store.space.objects[0].value=bp_source(row);store.space.objects[1].value=Value::Integer {number:18446744073709551615};store.space.objects[2].value=Value::Integer {number:33};store.space.objects[3]=Object {value:Value::Integer {number:9},has_next:true,next:1};
 store.bytes.blocks[0]=ByteBlock {initialized:true,length:2};store.bytes.blocks[0].bytes[0]=65;store.bytes.blocks[0].bytes[1]=66;store.bytes.blocks[0].bytes[255]=93;
 store.bytes.blocks[1]=ByteBlock {initialized:true,length:2};store.bytes.blocks[1].bytes[0]=65;store.bytes.blocks[1].bytes[1]=66;store.bytes.blocks[63].bytes[255]=77;
 transition row {3 -> chain(store) 6 -> string(store) 9 -> buffer(store) 11 -> package(store) 13 -> reference(store) 20 -> full(store) 24 -> oversized(store) 25 -> oversized(store) 27 -> buffer_source(store) _ -> (store)}
 state chain(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.objects[1].value=Value::Reference {kind:ReferenceKind::Arg,object_id:2};result}
 state string(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.objects[1].value=Value::String {string_storage:StringStorage::Source {string_source:Span {unit:7,end:1}}};result}
 state buffer(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.objects[1].value=Value::Buffer {buffer_storage:BufferStorage::Owned {buffer_owner:1}};result}
 state buffer_source(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.objects[1].value=Value::Buffer {buffer_storage:BufferStorage::Source {declared_size:2,buffer_initializer:Span {unit:7,end:1}}};result}
 state package(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.objects[1].value=Value::Package {first:2,count:1};result}
 state reference(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.objects[1].value=Value::Reference {kind:ReferenceKind::RefOf,object_id:2};result}
 state full(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.object_count=64;result}
 state oversized(store:ObjectStore)->ObjectStore {let mut result:ObjectStore=store;result.space.object_count=18446744073709551615;result}
}
machine bp_source(row:u64)->Value {transition row {
 31 -> (Value::Reference {kind:ReferenceKind::Unresolved,object_id:1})
 1 -> (Value::Integer {number:18446744073709551615}) 2 -> (Value::Reference {kind:ReferenceKind::Named,object_id:1}) 3 -> (Value::Reference {kind:ReferenceKind::Named,object_id:1})
 4 -> (Value::String {string_storage:StringStorage::Source {string_source:Span {unit:7,end:1}}})
 5 -> (Value::String {string_storage:StringStorage::Owned {string_owner:0}})
 6 -> (Value::Reference {kind:ReferenceKind::Named,object_id:1})
 7 -> (Value::Buffer {buffer_storage:BufferStorage::Source {declared_size:2,buffer_initializer:Span {unit:7,end:1}}})
 8 -> (Value::Buffer {buffer_storage:BufferStorage::Owned {buffer_owner:0}})
 9 -> (Value::Reference {kind:ReferenceKind::Named,object_id:1})
 10 -> (Value::Package {first:2,count:1}) 11 -> (Value::Reference {kind:ReferenceKind::Named,object_id:1})
 12 -> (Value::Reference {kind:ReferenceKind::RefOf,object_id:1}) 13 -> (Value::Reference {kind:ReferenceKind::Named,object_id:1}) 14 -> (Value::Reference {kind:ReferenceKind::Index,object_id:1})
 15 -> (Value::Uninitialized) 16 -> (Value::Method {})
 17 -> (Value::String {string_storage:StringStorage::Source {string_source:Span {unit:8,end:1}}})
 18 -> (Value::Buffer {buffer_storage:BufferStorage::Owned {buffer_owner:1}})
 20 -> (Value::Buffer {buffer_storage:BufferStorage::Source {declared_size:1,buffer_initializer:Span {unit:7,end:1}}})
 21 -> (Value::String {string_storage:StringStorage::Source {string_source:Span {unit:7,end:1}}})
 22 -> (Value::Package {first:18446744073709551615,count:1}) 23 -> (Value::Reference {kind:ReferenceKind::RefOf,object_id:18446744073709551615})
 26 -> (Value::Integer {number:18446744073709551615}) 27 -> (Value::Reference {kind:ReferenceKind::Local,object_id:1})
 28 -> (Value::NameReference {}) 29 -> (Value::OperationRegion {}) 30 -> (Value::BufferField {})
 _ -> (Value::Integer {number:11})}}
machine bp_operand(row:u64)->Operand {transition row {0 -> (Operand::Integer {number:4294967319}) 19 -> (Operand::Object {object_id:18446744073709551615}) 25 -> (Operand::Integer {number:18446744073709551615}) _ -> (Operand::Object {object_id:0})}}
machine bp_size(row:u64)->IntegerSize {transition row==26 {true -> (IntegerSize::EightBytes) _ -> (IntegerSize::FourBytes)}}
machine bp_old(cell:bool)->Binding {transition cell {true -> (Binding::Cell {cell_id:3}) _ -> (Binding::Shared {shared_id:1})}}
machine bp_case(row:u64,cell:bool,expected:ExecutionOutcome,control:bool)->i32 {
 let mut input:[u8;1024];input[0]=bp_byte(row);let original:ObjectStore=bp_store(row);let mut store:ObjectStore=original;
 let before:u64=store.space.object_count;let old:Binding=bp_old(cell);let incoming:Operand=bp_operand(row);let size:IntegerSize=bp_size(row);
 let normalized:Operand=normalized_operand(&store,size,incoming);let predicted:Binding=prospective_binding(before,TargetAction::Replace {binding:old},normalized);
 let actual:BindingResult=copied_binding(&input,1,7,&mut store,old,normalized);let after:u64=store.space.object_count;
 let correct:bool=bp_check(original,&store,before,after,actual,expected,predicted,cell,control);
 transition correct {true -> (0) _ -> (1)}
}
machine bp_byte(row:u64)->u8 {transition row==21 {true -> (128) _ -> (65)}}
machine bp_check(original:ObjectStore,store:&ObjectStore,before:u64,after:u64,actual:BindingResult,expected:ExecutionOutcome,predicted:Binding,cell:bool,control:bool)->bool {
 transition actual.outcome==expected {true -> outcome(original,store,before,after,actual,expected,predicted,cell,control) _ -> (false)}
 state outcome(original:ObjectStore,store:&ObjectStore,before:u64,after:u64,actual:BindingResult,expected:ExecutionOutcome,predicted:Binding,cell:bool,control:bool)->bool {
  transition expected==ExecutionOutcome::Success {true -> success(before,after,actual.binding,predicted,cell,control) _ -> failure(original,store,control)}
 }
 state success(before:u64,after:u64,actual:Binding,predicted:Binding,cell:bool,control:bool)->bool {
  let wanted:Binding=bp_expected_binding(predicted,control);let equal:bool=bp_equal(actual,wanted);let count:bool=bp_count(before,after,predicted,cell);equal && count
 }
 state failure(original:ObjectStore,store:&ObjectStore,control:bool)->bool {
  let mut wanted:ObjectStore=original;wanted.bytes.blocks[63].bytes[255]=bp_sentinel(control);let same:bool=fx_store(store,&wanted);same
 }
}
machine bp_count(before:u64,after:u64,binding:Binding,cell:bool)->bool {transition cell {true -> (before==after) _ -> allocated(before,after,binding)} state allocated(before:u64,after:u64,binding:Binding)->bool {transition binding {Binding::Integer {number} -> (before==after) Binding::Cell {cell_id} -> next(before,after,cell_id) _ -> (false)}} state next(before:u64,after:u64,id:u64)->bool {transition before<64 {true -> (after==before+1 && id==before) _ -> (false)}}}
machine bp_expected_binding(binding:Binding,control:bool)->Binding {transition control {true -> changed(binding) _ -> (binding)} state changed(binding:Binding)->Binding {transition binding {Binding::Integer {number} -> (Binding::Integer {number:((number as u64 in Wrapping)+1) as u64}) Binding::Cell {cell_id} -> (Binding::Cell {cell_id:((cell_id as u64 in Wrapping)+1) as u64}) Binding::Shared {shared_id} -> (Binding::Shared {shared_id:((shared_id as u64 in Wrapping)+1) as u64}) _ -> (Binding::Integer {number:0})}}}
machine bp_equal(a:Binding,b:Binding)->bool {transition a {Binding::Uninitialized -> uninitialized(b) Binding::Integer {number} -> integer(b,number) Binding::Cell {cell_id} -> cell(b,cell_id) Binding::Shared {shared_id} -> shared(b,shared_id)}
 state uninitialized(b:Binding)->bool {transition b {Binding::Uninitialized -> (true) _ -> (false)}}
 state integer(b:Binding,a:u64)->bool {transition b {Binding::Integer {number} -> (a==number) _ -> (false)}}
 state cell(b:Binding,a:u64)->bool {transition b {Binding::Cell {cell_id} -> (a==cell_id) _ -> (false)}}
 state shared(b:Binding,a:u64)->bool {transition b {Binding::Shared {shared_id} -> (a==shared_id) _ -> (false)}}}
machine bp_sentinel(control:bool)->u8 {transition control {true -> (78) _ -> (77)}}
