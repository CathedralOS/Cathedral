use {omega}/language/core/nat.omg;
use {aml}/model.omg;
use {execution}/execution_model.omg;
use {execution}/generic_target_model.omg;
use {execution}/generic_binding_plan.omg;
use {execution}/generic_values.omg;
use {integer_helpers}/integers.omg;
data Suite {}
machine fx_bytes_equal(a:&[u8;256],b:&[u8;256],i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_byte_equal(a,b,i,n);transition i<n {true -> fx_bytes_equal(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_byte_equal(a:&[u8;256],b:&[u8;256],i:u64,n:u64)->bool {transition i<n && i<256 {true -> (a[i]==b[i]) _ -> (true)}}
machine fx_span(a:|model|::Span,b:|model|::Span)->bool {a.unit==b.unit && a.start==b.start && a.end==b.end}
machine fx_path(a:|model|::Path,b:|model|::Path)->bool {let good:bool=fx_segments(&a.segments,&b.segments,0,16,true);a.absolute==b.absolute && a.parents==b.parents && a.count==b.count && good}
machine fx_segments(a:&[u32;16],b:&[u32;16],i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_segment(a,b,i,n);transition i<n {true -> fx_segments(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_segment(a:&[u32;16],b:&[u32;16],i:u64,n:u64)->bool {transition i<n && i<16 {true -> (a[i]==b[i]) _ -> (true)}}
machine fx_string(a:|model|::StringStorage,b:|model|::StringStorage)->bool {
 transition a {|model|::StringStorage::Source {string_source} -> source(string_source,b) |model|::StringStorage::Owned {string_owner} -> owned(string_owner,b)}
 state source(a:|model|::Span,b:|model|::StringStorage)->bool {transition b {|model|::StringStorage::Source {string_source} -> span(a,string_source) _ -> (false)}}
 state span(a:|model|::Span,b:|model|::Span)->bool {let good:bool=fx_span(a,b);good}
 state owned(a:u64,b:|model|::StringStorage)->bool {transition b {|model|::StringStorage::Owned {string_owner} -> (a==string_owner) _ -> (false)}}
}
machine fx_buffer(a:|model|::BufferStorage,b:|model|::BufferStorage)->bool {
 transition a {|model|::BufferStorage::Source {declared_size,buffer_initializer} -> source(declared_size,buffer_initializer,b) |model|::BufferStorage::Owned {buffer_owner} -> owned(buffer_owner,b)}
 state source(size:u64,a:|model|::Span,b:|model|::BufferStorage)->bool {transition b {|model|::BufferStorage::Source {declared_size,buffer_initializer} -> span(size,a,declared_size,buffer_initializer) _ -> (false)}}
 state span(size:u64,a:|model|::Span,other:u64,b:|model|::Span)->bool {let good:bool=fx_span(a,b);size==other && good}
 state owned(a:u64,b:|model|::BufferStorage)->bool {transition b {|model|::BufferStorage::Owned {buffer_owner} -> (a==buffer_owner) _ -> (false)}}
}
machine fx_value(a:|model|::Value,b:|model|::Value)->bool {transition a {
|model|::Value::Uninitialized -> c_uninitialized(b)
|model|::Value::Integer {number} -> c_integer(number,b)
|model|::Value::String {string_storage} -> c_string(string_storage,b)
|model|::Value::Buffer {buffer_storage} -> c_buffer(buffer_storage,b)
|model|::Value::BufferField {backing_object,bit_offset,bit_length} -> c_bufferfield(backing_object,bit_offset,bit_length,b)
|model|::Value::Package {first,count} -> c_package(first,count,b)
|model|::Value::NameReference {name,scope} -> c_namereference(name,scope,b)
|model|::Value::Reference {kind,object_id} -> c_reference(kind,object_id,b)
|model|::Value::Method {flags,body} -> c_method(flags,body,b)
|model|::Value::Device -> c_device(b)
|model|::Value::Processor {id,address,length} -> c_processor(id,address,length,b)
|model|::Value::PowerResource {system_level,order} -> c_powerresource(system_level,order,b)
|model|::Value::ThermalZone -> c_thermalzone(b)
|model|::Value::Mutex {sync_level} -> c_mutex(sync_level,b)
|model|::Value::Event -> c_event(b)
|model|::Value::OperationRegion {space,base,length,scope} -> c_operationregion(space,base,length,scope,b)
}
state c_uninitialized(b:|model|::Value)->bool {transition b {|model|::Value::Uninitialized -> (true) _ -> (false)}}
state c_integer(a_number:u64,b:|model|::Value)->bool {transition b {|model|::Value::Integer {number} -> (a_number==number) _ -> (false)}}
state c_string(a_string_storage:|model|::StringStorage,b:|model|::Value)->bool {transition b {|model|::Value::String {string_storage} -> check_c_string(a_string_storage,string_storage) _ -> (false)}}
state check_c_string(a_string_storage:|model|::StringStorage,string_storage:|model|::StringStorage)->bool {let good_string_storage:bool=fx_string(a_string_storage,string_storage);good_string_storage}
state c_buffer(a_buffer_storage:|model|::BufferStorage,b:|model|::Value)->bool {transition b {|model|::Value::Buffer {buffer_storage} -> check_c_buffer(a_buffer_storage,buffer_storage) _ -> (false)}}
state check_c_buffer(a_buffer_storage:|model|::BufferStorage,buffer_storage:|model|::BufferStorage)->bool {let good_buffer_storage:bool=fx_buffer(a_buffer_storage,buffer_storage);good_buffer_storage}
state c_bufferfield(a_backing_object:u64,a_bit_offset:u64,a_bit_length:u64,b:|model|::Value)->bool {transition b {|model|::Value::BufferField {backing_object,bit_offset,bit_length} -> (a_backing_object==backing_object && a_bit_offset==bit_offset && a_bit_length==bit_length) _ -> (false)}}
state c_package(a_first:u64,a_count:u64,b:|model|::Value)->bool {transition b {|model|::Value::Package {first,count} -> (a_first==first && a_count==count) _ -> (false)}}
state c_namereference(a_name:|model|::Path,a_scope:|model|::Path,b:|model|::Value)->bool {transition b {|model|::Value::NameReference {name,scope} -> check_c_namereference(a_name,a_scope,name,scope) _ -> (false)}}
state check_c_namereference(a_name:|model|::Path,a_scope:|model|::Path,name:|model|::Path,scope:|model|::Path)->bool {let good_name:bool=fx_path(a_name,name);let good_scope:bool=fx_path(a_scope,scope);good_name && good_scope}
state c_reference(a_kind:|model|::ReferenceKind,a_object_id:u64,b:|model|::Value)->bool {transition b {|model|::Value::Reference {kind,object_id} -> (a_kind==kind && a_object_id==object_id) _ -> (false)}}
state c_method(a_flags:u8,a_body:|model|::Span,b:|model|::Value)->bool {transition b {|model|::Value::Method {flags,body} -> check_c_method(a_flags,a_body,flags,body) _ -> (false)}}
state check_c_method(a_flags:u8,a_body:|model|::Span,flags:u8,body:|model|::Span)->bool {let good_body:bool=fx_span(a_body,body);a_flags==flags && good_body}
state c_device(b:|model|::Value)->bool {transition b {|model|::Value::Device -> (true) _ -> (false)}}
state c_processor(a_id:u8,a_address:u32,a_length:u8,b:|model|::Value)->bool {transition b {|model|::Value::Processor {id,address,length} -> (a_id==id && a_address==address && a_length==length) _ -> (false)}}
state c_powerresource(a_system_level:u8,a_order:u16,b:|model|::Value)->bool {transition b {|model|::Value::PowerResource {system_level,order} -> (a_system_level==system_level && a_order==order) _ -> (false)}}
state c_thermalzone(b:|model|::Value)->bool {transition b {|model|::Value::ThermalZone -> (true) _ -> (false)}}
state c_mutex(a_sync_level:u8,b:|model|::Value)->bool {transition b {|model|::Value::Mutex {sync_level} -> (a_sync_level==sync_level) _ -> (false)}}
state c_event(b:|model|::Value)->bool {transition b {|model|::Value::Event -> (true) _ -> (false)}}
state c_operationregion(a_space:u8,a_base:u64,a_length:u64,a_scope:|model|::Path,b:|model|::Value)->bool {transition b {|model|::Value::OperationRegion {space,base,length,scope} -> check_c_operationregion(a_space,a_base,a_length,a_scope,space,base,length,scope) _ -> (false)}}
state check_c_operationregion(a_space:u8,a_base:u64,a_length:u64,a_scope:|model|::Path,space:u8,base:u64,length:u64,scope:|model|::Path)->bool {let good_scope:bool=fx_path(a_scope,scope);a_space==space && a_base==base && a_length==length && good_scope}
}
machine fx_store(a:&|model|::ObjectStore,b:&|model|::ObjectStore)->bool {
 let objects:bool=fx_objects(a,b,0,64,true);let entries:bool=fx_entries(&a.space,&b.space,0,32,true);
 a.space.object_count==b.space.object_count && a.space.count==b.space.count && objects && entries
}
machine fx_objects(a:&|model|::ObjectStore,b:&|model|::ObjectStore,i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_object(a,b,i,n);transition i<n {true -> fx_objects(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_object(a:&|model|::ObjectStore,b:&|model|::ObjectStore,i:u64,n:u64)->bool {
 transition i<n && i<64 {true -> item(a,b,i) _ -> (true)}
 state item(a:&|model|::ObjectStore,b:&|model|::ObjectStore,i:u64)->bool {
  let left:|model|::Object=a.space.objects[i];let right:|model|::Object=b.space.objects[i];let first:|model|::ByteBlock=a.bytes.blocks[i];let second:|model|::ByteBlock=b.bytes.blocks[i];
  let payload:bool=fx_value(left.value,right.value);
  let bytes:bool=fx_bytes_equal(&first.bytes,&second.bytes,0,256,true);
  payload && bytes && left.has_next==right.has_next && left.next==right.next && first.initialized==second.initialized && first.length==second.length
 }
}
machine fx_entries(a:&|model|::Namespace,b:&|model|::Namespace,i:u64,n:u64,prior:bool)
terminates by(i,n)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=fx_entry(a,b,i,n);transition i<n {true -> fx_entries(a,b,i+1,n,prior && good) _ -> (prior)}}
machine fx_entry(a:&|model|::Namespace,b:&|model|::Namespace,i:u64,n:u64)->bool {
 transition i<n && i<32 {true -> item(a.entries[i],b.entries[i]) _ -> (true)}
 state item(a:|model|::Entry,b:|model|::Entry)->bool {let path:bool=fx_path(a.path,b.path);path && a.has_level==b.has_level && a.level==b.level && a.has_object==b.has_object && a.object==b.object && a.alias==b.alias}
}


machine bp_store(row:u64)->|model|::ObjectStore {
 let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.object_count=4;
 store.space.objects[0].value=bp_source(row);store.space.objects[1].value=|model|::Value::Integer {number:18446744073709551615};store.space.objects[2].value=|model|::Value::Integer {number:33};store.space.objects[3]=|model|::Object {value:|model|::Value::Integer {number:9},has_next:true,next:1};
 store.bytes.blocks[0]=|model|::ByteBlock {initialized:true,length:2};store.bytes.blocks[0].bytes[0]=65;store.bytes.blocks[0].bytes[1]=66;store.bytes.blocks[0].bytes[255]=93;
 store.bytes.blocks[1]=|model|::ByteBlock {initialized:true,length:2};store.bytes.blocks[1].bytes[0]=65;store.bytes.blocks[1].bytes[1]=66;store.bytes.blocks[63].bytes[255]=77;
 transition row {3 -> chain(store) 6 -> string(store) 9 -> buffer(store) 11 -> package(store) 13 -> reference(store) 20 -> full(store) 24 -> oversized(store) 25 -> oversized(store) 27 -> buffer_source(store) _ -> (store)}
 state chain(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Reference {kind:|model|::ReferenceKind::Arg,object_id:2};result}
 state string(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::String {string_storage:|model|::StringStorage::Source {string_source:|model|::Span {unit:7,end:1}}};result}
 state buffer(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:1}};result}
 state buffer_source(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:2,buffer_initializer:|model|::Span {unit:7,end:1}}};result}
 state package(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Package {first:2,count:1};result}
 state reference(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:2};result}
 state full(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.object_count=64;result}
 state oversized(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.object_count=18446744073709551615;result}
}
machine bp_source(row:u64)->|model|::Value {transition row {
 31 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Unresolved,object_id:1})
 1 -> (|model|::Value::Integer {number:18446744073709551615}) 2 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1}) 3 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1})
 4 -> (|model|::Value::String {string_storage:|model|::StringStorage::Source {string_source:|model|::Span {unit:7,end:1}}})
 5 -> (|model|::Value::String {string_storage:|model|::StringStorage::Owned {string_owner:0}})
 6 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1})
 7 -> (|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:2,buffer_initializer:|model|::Span {unit:7,end:1}}})
 8 -> (|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:0}})
 9 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1})
 10 -> (|model|::Value::Package {first:2,count:1}) 11 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1})
 12 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:1}) 13 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1}) 14 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Index,object_id:1})
 15 -> (|model|::Value::Uninitialized) 16 -> (|model|::Value::Method {})
 17 -> (|model|::Value::String {string_storage:|model|::StringStorage::Source {string_source:|model|::Span {unit:8,end:1}}})
 18 -> (|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:1}})
 20 -> (|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:1,buffer_initializer:|model|::Span {unit:7,end:1}}})
 21 -> (|model|::Value::String {string_storage:|model|::StringStorage::Source {string_source:|model|::Span {unit:7,end:1}}})
 22 -> (|model|::Value::Package {first:18446744073709551615,count:1}) 23 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:18446744073709551615})
 26 -> (|model|::Value::Integer {number:18446744073709551615}) 27 -> (|model|::Value::Reference {kind:|model|::ReferenceKind::Local,object_id:1})
 28 -> (|model|::Value::NameReference {}) 29 -> (|model|::Value::OperationRegion {}) 30 -> (|model|::Value::BufferField {})
 _ -> (|model|::Value::Integer {number:11})}}
machine bp_operand(row:u64)->|execution_model|::Operand {transition row {0 -> (|execution_model|::Operand::Integer {number:4294967319}) 19 -> (|execution_model|::Operand::Object {object_id:18446744073709551615}) 25 -> (|execution_model|::Operand::Integer {number:18446744073709551615}) _ -> (|execution_model|::Operand::Object {object_id:0})}}
machine bp_size(row:u64)->|integers|::IntegerSize {transition row==26 {true -> (|integers|::IntegerSize::EightBytes) _ -> (|integers|::IntegerSize::FourBytes)}}
machine bp_old(cell:bool)->|execution_model|::Binding {transition cell {true -> (|execution_model|::Binding::Cell {cell_id:3}) _ -> (|execution_model|::Binding::Shared {shared_id:1})}}
machine bp_case(row:u64,cell:bool,expected:|execution_model|::ExecutionOutcome,control:bool)->i32 {
 let mut input:[u8;1024];input[0]=bp_byte(row);let original:|model|::ObjectStore=bp_store(row);let mut store:|model|::ObjectStore=original;
 let before:u64=store.space.object_count;let old:|execution_model|::Binding=bp_old(cell);let incoming:|execution_model|::Operand=bp_operand(row);let size:|integers|::IntegerSize=bp_size(row);
 let normalized:|execution_model|::Operand=|generic_values|::normalized_operand(&store,size,incoming);let predicted:|execution_model|::Binding=|generic_binding_plan|::prospective_binding(before,|generic_target_model|::TargetAction::Replace {binding:old},normalized);
 let actual:|execution_model|::BindingResult=|generic_values|::copied_binding(&input,1,7,&mut store,old,normalized);let after:u64=store.space.object_count;
 let correct:bool=bp_check(original,&store,before,after,actual,expected,predicted,cell,control);
 transition correct {true -> (0) _ -> (1)}
}
machine bp_byte(row:u64)->u8 {transition row==21 {true -> (128) _ -> (65)}}
machine bp_check(original:|model|::ObjectStore,store:&|model|::ObjectStore,before:u64,after:u64,actual:|execution_model|::BindingResult,expected:|execution_model|::ExecutionOutcome,predicted:|execution_model|::Binding,cell:bool,control:bool)->bool {
 transition actual.outcome==expected {true -> outcome(original,store,before,after,actual,expected,predicted,cell,control) _ -> (false)}
 state outcome(original:|model|::ObjectStore,store:&|model|::ObjectStore,before:u64,after:u64,actual:|execution_model|::BindingResult,expected:|execution_model|::ExecutionOutcome,predicted:|execution_model|::Binding,cell:bool,control:bool)->bool {
  transition expected==|execution_model|::ExecutionOutcome::Success {true -> success(before,after,actual.binding,predicted,cell,control) _ -> failure(original,store,control)}
 }
 state success(before:u64,after:u64,actual:|execution_model|::Binding,predicted:|execution_model|::Binding,cell:bool,control:bool)->bool {
  let wanted:|execution_model|::Binding=bp_expected_binding(predicted,control);let equal:bool=bp_equal(actual,wanted);let count:bool=bp_count(before,after,predicted,cell);equal && count
 }
 state failure(original:|model|::ObjectStore,store:&|model|::ObjectStore,control:bool)->bool {
  let mut wanted:|model|::ObjectStore=original;wanted.bytes.blocks[63].bytes[255]=bp_sentinel(control);let same:bool=fx_store(store,&wanted);same
 }
}
machine bp_count(before:u64,after:u64,binding:|execution_model|::Binding,cell:bool)->bool {transition cell {true -> (before==after) _ -> allocated(before,after,binding)} state allocated(before:u64,after:u64,binding:|execution_model|::Binding)->bool {transition binding {|execution_model|::Binding::Integer {number} -> (before==after) |execution_model|::Binding::Cell {cell_id} -> next(before,after,cell_id) _ -> (false)}} state next(before:u64,after:u64,id:u64)->bool {transition before<64 {true -> (after==before+1 && id==before) _ -> (false)}}}
machine bp_expected_binding(binding:|execution_model|::Binding,control:bool)->|execution_model|::Binding {transition control {true -> changed(binding) _ -> (binding)} state changed(binding:|execution_model|::Binding)->|execution_model|::Binding {transition binding {|execution_model|::Binding::Integer {number} -> (|execution_model|::Binding::Integer {number:((number as u64 in Wrapping)+1) as u64}) |execution_model|::Binding::Cell {cell_id} -> (|execution_model|::Binding::Cell {cell_id:((cell_id as u64 in Wrapping)+1) as u64}) |execution_model|::Binding::Shared {shared_id} -> (|execution_model|::Binding::Shared {shared_id:((shared_id as u64 in Wrapping)+1) as u64}) _ -> (|execution_model|::Binding::Integer {number:0})}}}
machine bp_equal(a:|execution_model|::Binding,b:|execution_model|::Binding)->bool {transition a {|execution_model|::Binding::Uninitialized -> uninitialized(b) |execution_model|::Binding::Integer {number} -> integer(b,number) |execution_model|::Binding::Cell {cell_id} -> cell(b,cell_id) |execution_model|::Binding::Shared {shared_id} -> shared(b,shared_id)}
 state uninitialized(b:|execution_model|::Binding)->bool {transition b {|execution_model|::Binding::Uninitialized -> (true) _ -> (false)}}
 state integer(b:|execution_model|::Binding,a:u64)->bool {transition b {|execution_model|::Binding::Integer {number} -> (a==number) _ -> (false)}}
 state cell(b:|execution_model|::Binding,a:u64)->bool {transition b {|execution_model|::Binding::Cell {cell_id} -> (a==cell_id) _ -> (false)}}
 state shared(b:|execution_model|::Binding,a:u64)->bool {transition b {|execution_model|::Binding::Shared {shared_id} -> (a==shared_id) _ -> (false)}}}
machine bp_sentinel(control:bool)->u8 {transition control {true -> (78) _ -> (77)}}
machine Suite::prediction_0_0_0(&mut self)->i32 {let result:i32=bp_case(0,false,|execution_model|::ExecutionOutcome::Success,false);result}
machine Suite::prediction_0_0_1(&mut self)->i32 {let result:i32=bp_case(0,false,|execution_model|::ExecutionOutcome::Success,true);result}
machine Suite::prediction_0_1_0(&mut self)->i32 {let result:i32=bp_case(0,true,|execution_model|::ExecutionOutcome::Success,false);result}
machine Suite::prediction_0_1_1(&mut self)->i32 {let result:i32=bp_case(0,true,|execution_model|::ExecutionOutcome::Success,true);result}
machine Suite::prediction_1_0_0(&mut self)->i32 {let result:i32=bp_case(1,false,|execution_model|::ExecutionOutcome::Success,false);result}
machine Suite::prediction_1_0_1(&mut self)->i32 {let result:i32=bp_case(1,false,|execution_model|::ExecutionOutcome::Success,true);result}
machine Suite::prediction_1_1_0(&mut self)->i32 {let result:i32=bp_case(1,true,|execution_model|::ExecutionOutcome::Success,false);result}
machine Suite::prediction_1_1_1(&mut self)->i32 {let result:i32=bp_case(1,true,|execution_model|::ExecutionOutcome::Success,true);result}
machine Suite::prediction_2_0_0(&mut self)->i32 {let result:i32=bp_case(2,false,|execution_model|::ExecutionOutcome::Success,false);result}
machine Suite::prediction_2_0_1(&mut self)->i32 {let result:i32=bp_case(2,false,|execution_model|::ExecutionOutcome::Success,true);result}
machine Suite::prediction_2_1_0(&mut self)->i32 {let result:i32=bp_case(2,true,|execution_model|::ExecutionOutcome::Success,false);result}
machine Suite::prediction_2_1_1(&mut self)->i32 {let result:i32=bp_case(2,true,|execution_model|::ExecutionOutcome::Success,true);result}
machine Suite::prediction_3_0_0(&mut self)->i32 {let result:i32=bp_case(3,false,|execution_model|::ExecutionOutcome::Success,false);result}
machine Suite::prediction_3_0_1(&mut self)->i32 {let result:i32=bp_case(3,false,|execution_model|::ExecutionOutcome::Success,true);result}
machine Suite::prediction_3_1_0(&mut self)->i32 {let result:i32=bp_case(3,true,|execution_model|::ExecutionOutcome::Success,false);result}
