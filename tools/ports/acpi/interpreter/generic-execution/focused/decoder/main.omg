use {aml}/model.omg;
use {execution}/execution_model.omg;
data Suite {}

use {aml}/namespace.omg;
use {execution}/decode_execution.omg;
machine ge_decoder(mode:u64,expected_pc:u64)->i32 {
 let mut input:[u8;1024];let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space=|namespace|::empty();
 let mut frame:|execution_model|::Frame=|execution_model|::Frame {scope:|model|::Path {absolute:true},source_length:4,body:|model|::Span {unit:7},end:4,operation_count:1};
 frame.operations[0]=|execution_model|::Operation {opcode:0x72,value_arity:1,count:1};
 let expected:|execution_model|::ExecutionOutcome=ge_decoder_setup(&mut input,&mut store,&mut frame,mode);
 let count:u64=frame.operation_count;
 let actual:|execution_model|::ExecutionOutcome=ge_decoder_run(&input,&store,&mut frame,mode);
 let good:bool=ge_decoder_result(actual,expected,frame.pc,expected_pc,frame.end,frame.operation_count,count);
 transition good {true -> (0) _ -> (1)}
}
machine ge_decoder_result(actual:|execution_model|::ExecutionOutcome,expected:|execution_model|::ExecutionOutcome,pc:u64,want:u64,end:u64,count:u64,prior:u64)->bool {actual==expected && pc==want && end==4 && count==prior}
machine ge_decoder_run(input:&[u8;1024],store:&|model|::ObjectStore,frame:&mut |execution_model|::Frame,mode:u64)->|execution_model|::ExecutionOutcome {
 transition mode==5 {true -> target(input,store,frame) _ -> term(input,store,frame)}
 state target(input:&[u8;1024],store:&|model|::ObjectStore,frame:&mut |execution_model|::Frame)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=|decode_execution|::decode_target(input,store,frame);result}
 state term(input:&[u8;1024],store:&|model|::ObjectStore,frame:&mut |execution_model|::Frame)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=|decode_execution|::decode_term(input,store,frame);result}
}
machine ge_decoder_setup(input:&mut [u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,mode:u64)->|execution_model|::ExecutionOutcome {
 transition mode {0 -> (|execution_model|::ExecutionOutcome::InvalidState) 1 -> local(input,frame) 2 -> operation(input,frame) 3 -> named(input,store,frame,false) 4 -> named(input,store,frame,true) _ -> target(frame)}
 state local(input:&mut [u8;1024],frame:&mut |execution_model|::Frame)->|execution_model|::ExecutionOutcome {input[0]=0x60;frame.locals[0]=|execution_model|::Binding::Integer {number:11};|execution_model|::ExecutionOutcome::InvalidState}
 state operation(input:&mut [u8;1024],frame:&mut |execution_model|::Frame)->|execution_model|::ExecutionOutcome {input[0]=0x72;frame.operation_count=16;|execution_model|::ExecutionOutcome::Depth}
 state named(input:&mut [u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,method:bool)->|execution_model|::ExecutionOutcome {
  input[0]=88;input[1]=95;input[2]=95;input[3]=95;
  let mut path:|model|::Path=|model|::Path {absolute:true,count:1};path.segments[0]=1600085848;
  let value:|model|::Value=ge_decoder_named_value(method);
  let inserted:|model|::NamespaceResult=|namespace|::insert(store.space,path,value);store.space=inserted.space;
  transition method {true -> method_frame(frame) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}
 }
 state method_frame(frame:&mut |execution_model|::Frame)->|execution_model|::ExecutionOutcome {frame.operation_count=16;|execution_model|::ExecutionOutcome::Depth}
 state target(frame:&mut |execution_model|::Frame)->|execution_model|::ExecutionOutcome {frame.operations[0]=|execution_model|::Operation {opcode:0x72};|execution_model|::ExecutionOutcome::InvalidState}
}
machine ge_decoder_named_value(method:bool)->|model|::Value {transition method {true -> (|model|::Value::Method {body:|model|::Span {unit:7}}) _ -> (|model|::Value::Integer {number:11})}}
machine Suite::decoder_constant_full_positive(&mut self)->i32 {let result:i32=ge_decoder(0,0);result}
machine Suite::decoder_constant_full_control(&mut self)->i32 {let result:i32=ge_decoder(0,1);result}
machine Suite::decoder_local_full_positive(&mut self)->i32 {let result:i32=ge_decoder(1,0);result}
machine Suite::decoder_local_full_control(&mut self)->i32 {let result:i32=ge_decoder(1,1);result}
machine Suite::decoder_operation_full_positive(&mut self)->i32 {let result:i32=ge_decoder(2,0);result}
machine Suite::decoder_operation_full_control(&mut self)->i32 {let result:i32=ge_decoder(2,1);result}
machine Suite::decoder_named_value_full_positive(&mut self)->i32 {let result:i32=ge_decoder(3,0);result}
machine Suite::decoder_named_value_full_control(&mut self)->i32 {let result:i32=ge_decoder(3,1);result}
machine Suite::decoder_named_method_full_positive(&mut self)->i32 {let result:i32=ge_decoder(4,0);result}
machine Suite::decoder_named_method_full_control(&mut self)->i32 {let result:i32=ge_decoder(4,1);result}
machine Suite::decoder_target_full_positive(&mut self)->i32 {let result:i32=ge_decoder(5,0);result}
machine Suite::decoder_target_full_control(&mut self)->i32 {let result:i32=ge_decoder(5,1);result}
