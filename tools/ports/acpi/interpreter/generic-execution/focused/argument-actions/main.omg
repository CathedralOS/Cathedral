use {aml}/model.omg;
use {execution}/execution_model.omg;
use {execution}/generic_target_model.omg;
use {execution}/generic_target_values.omg;
data Suite {}
machine aa_classify(kind:u64,wanted:u64)->i32 {
 let store:|model|::ObjectStore=aa_store(kind);let binding:|execution_model|::Binding=aa_binding(kind);
 let action:|generic_target_model|::ArgumentAction=|generic_target_values|::classify_argument(&store,binding);
 let result:u64=aa_action(action,binding);
 transition result==wanted {true -> (0) _ -> (1)}
}
machine aa_store(kind:u64)->|model|::ObjectStore {
 let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.object_count=3;
 store.space.objects[0].value=|model|::Value::Integer {number:11};store.space.objects[1].value=|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:0};store.space.objects[2].value=|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1};
 transition kind {4 -> index(store) 7 -> cycle(store) 8 -> dangling(store) _ -> (store)}
 state index(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Reference {kind:|model|::ReferenceKind::Index,object_id:0};result}
 state cycle(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Reference {kind:|model|::ReferenceKind::Named,object_id:1};result}
 state dangling(store:|model|::ObjectStore)->|model|::ObjectStore {let mut result:|model|::ObjectStore=store;result.space.objects[1].value=|model|::Value::Reference {kind:|model|::ReferenceKind::RefOf,object_id:18446744073709551615};result}
}
machine aa_binding(kind:u64)->|execution_model|::Binding {transition kind {0 -> (|execution_model|::Binding::Uninitialized) 1 -> (|execution_model|::Binding::Integer {number:9}) 2 -> (|execution_model|::Binding::Shared {shared_id:0}) 3 -> (|execution_model|::Binding::Cell {cell_id:1}) 5 -> (|execution_model|::Binding::Shared {shared_id:2}) 6 -> (|execution_model|::Binding::Shared {shared_id:18446744073709551615}) _ -> (|execution_model|::Binding::Shared {shared_id:1})}}
machine aa_same(a:|execution_model|::Binding,b:|execution_model|::Binding)->bool {transition a {
 |execution_model|::Binding::Uninitialized -> uninitialized(b)
 |execution_model|::Binding::Integer {number} -> integer(b,number)
 |execution_model|::Binding::Shared {shared_id} -> shared(b,shared_id)
 |execution_model|::Binding::Cell {cell_id} -> cell(b,cell_id)}
 state uninitialized(b:|execution_model|::Binding)->bool {transition b {|execution_model|::Binding::Uninitialized -> (true) _ -> (false)}}
 state integer(b:|execution_model|::Binding,a:u64)->bool {transition b {|execution_model|::Binding::Integer {number} -> (a==number) _ -> (false)}}
 state shared(b:|execution_model|::Binding,a:u64)->bool {transition b {|execution_model|::Binding::Shared {shared_id} -> (a==shared_id) _ -> (false)}}
 state cell(b:|execution_model|::Binding,a:u64)->bool {transition b {|execution_model|::Binding::Cell {cell_id} -> (a==cell_id) _ -> (false)}}
}
machine aa_action(action:|generic_target_model|::ArgumentAction,original:|execution_model|::Binding)->u64 {
 transition action {|generic_target_model|::ArgumentAction::Replace {binding} -> replacement(binding,original) |generic_target_model|::ArgumentAction::CopyReferent {binding,object_id} -> reference(binding,original,object_id) |generic_target_model|::ArgumentAction::Failure {outcome} -> failure(outcome)}
 state replacement(binding:|execution_model|::Binding,original:|execution_model|::Binding)->u64 {let same:bool=aa_same(binding,original);transition same {true -> (10) _ -> (99)}}
 state reference(binding:|execution_model|::Binding,original:|execution_model|::Binding,id:u64)->u64 {let same:bool=aa_same(binding,original);transition { !same -> (99) id==0 -> (20) id==18446744073709551615 -> (21) _ -> (98)}}
 state failure(outcome:|execution_model|::ExecutionOutcome)->u64 {transition outcome {|execution_model|::ExecutionOutcome::InvalidState -> (30) _ -> (97)}}
}
machine aa_apply(kind:u64,wanted:u64)->i32 {
 let input:[u8;1024];let mut store:|model|::ObjectStore=aa_store(0);let action:|generic_target_model|::ArgumentAction=aa_selected(kind);
 let result:|execution_model|::BindingResult=|generic_target_values|::apply_argument(&input,0,7,&mut store,action,|execution_model|::Operand::Integer {number:22});
 let valid:bool=aa_applied(result,kind);let number:u64=aa_number(store.space.objects[0].value);
 transition valid && number==wanted && store.space.object_count==3 {true -> (0) _ -> (1)}
}
machine aa_selected(kind:u64)->|generic_target_model|::ArgumentAction {transition kind {0 -> (|generic_target_model|::ArgumentAction::Replace {binding:|execution_model|::Binding::Shared {shared_id:0}}) 1 -> (|generic_target_model|::ArgumentAction::CopyReferent {binding:|execution_model|::Binding::Shared {shared_id:1},object_id:0}) _ -> (|generic_target_model|::ArgumentAction::Failure {outcome:|execution_model|::ExecutionOutcome::InvalidTarget})}}
machine aa_applied(result:|execution_model|::BindingResult,kind:u64)->bool {transition kind {0 -> integer(result.outcome,result.binding) 1 -> reference(result.outcome,result.binding) _ -> (result.outcome==|execution_model|::ExecutionOutcome::InvalidTarget)}
 state integer(outcome:|execution_model|::ExecutionOutcome,binding:|execution_model|::Binding)->bool {transition binding {|execution_model|::Binding::Integer {number} -> (outcome==|execution_model|::ExecutionOutcome::Success && number==22) _ -> (false)}}
 state reference(outcome:|execution_model|::ExecutionOutcome,binding:|execution_model|::Binding)->bool {transition binding {|execution_model|::Binding::Shared {shared_id} -> (outcome==|execution_model|::ExecutionOutcome::Success && shared_id==1) _ -> (false)}}
}
machine aa_number(value:|model|::Value)->u64 {transition value {|model|::Value::Integer {number} -> (number) _ -> (999)}}
machine Suite::classify_0_0(&mut self)->i32 {let result:i32=aa_classify(0,10);result}
machine Suite::classify_0_1(&mut self)->i32 {let result:i32=aa_classify(0,11);result}
machine Suite::classify_1_0(&mut self)->i32 {let result:i32=aa_classify(1,10);result}
machine Suite::classify_1_1(&mut self)->i32 {let result:i32=aa_classify(1,11);result}
machine Suite::classify_2_0(&mut self)->i32 {let result:i32=aa_classify(2,10);result}
machine Suite::classify_2_1(&mut self)->i32 {let result:i32=aa_classify(2,11);result}
machine Suite::classify_3_0(&mut self)->i32 {let result:i32=aa_classify(3,20);result}
machine Suite::classify_3_1(&mut self)->i32 {let result:i32=aa_classify(3,21);result}
machine Suite::classify_4_0(&mut self)->i32 {let result:i32=aa_classify(4,20);result}
machine Suite::classify_4_1(&mut self)->i32 {let result:i32=aa_classify(4,21);result}
machine Suite::classify_5_0(&mut self)->i32 {let result:i32=aa_classify(5,20);result}
machine Suite::classify_5_1(&mut self)->i32 {let result:i32=aa_classify(5,21);result}
machine Suite::classify_6_0(&mut self)->i32 {let result:i32=aa_classify(6,30);result}
machine Suite::classify_6_1(&mut self)->i32 {let result:i32=aa_classify(6,31);result}
machine Suite::classify_7_0(&mut self)->i32 {let result:i32=aa_classify(7,30);result}
machine Suite::classify_7_1(&mut self)->i32 {let result:i32=aa_classify(7,31);result}
machine Suite::classify_8_0(&mut self)->i32 {let result:i32=aa_classify(8,21);result}
machine Suite::classify_8_1(&mut self)->i32 {let result:i32=aa_classify(8,22);result}
machine Suite::apply_0_0(&mut self)->i32 {let result:i32=aa_apply(0,11);result}
machine Suite::apply_0_1(&mut self)->i32 {let result:i32=aa_apply(0,12);result}
machine Suite::apply_1_0(&mut self)->i32 {let result:i32=aa_apply(1,22);result}
machine Suite::apply_1_1(&mut self)->i32 {let result:i32=aa_apply(1,23);result}
machine Suite::apply_2_0(&mut self)->i32 {let result:i32=aa_apply(2,11);result}
machine Suite::apply_2_1(&mut self)->i32 {let result:i32=aa_apply(2,12);result}
