use {aml}/model.omg;
use {execution}/execution_model.omg;
use {integer_helpers}/integers.omg;
use {execution}/generic_target_bridge.omg;
data Suite {}
machine br_bytes(wanted:u64)->i32 {
 let mut input:[u8;1024];input[0]=17;
 let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.object_count=1;
 store.space.objects[0].value=|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:1,buffer_initializer:|model|::Span {unit:7,end:1}}};
 let mut frame:|execution_model|::Frame=|execution_model|::Frame {source_length:1,body:|model|::Span {unit:7,end:1},end:1,size:|integers|::IntegerSize::EightBytes};
 let outcome:|execution_model|::ExecutionOutcome=|generic_target_bridge|::write_generic_target(&input,&mut store,&mut frame,|execution_model|::Target::Local {local_index:0},|execution_model|::Operand::Object {object_id:0},true);
 let id:u64=br_cell(frame.locals[0]);
 let copied:bool=br_payload(&store);
 transition outcome==|execution_model|::ExecutionOutcome::Success && id==wanted && copied {true -> (0) _ -> (1)}
}
machine br_cell(value:|execution_model|::Binding)->u64 {transition value {|execution_model|::Binding::Cell {cell_id} -> (cell_id) _ -> (999)}}
machine br_integer(value:|execution_model|::Binding)->u64 {transition value {|execution_model|::Binding::Integer {number} -> (number) _ -> (999)}}
machine br_payload(store:&|model|::ObjectStore)->bool {store.space.object_count==2 && store.bytes.blocks[1].initialized && store.bytes.blocks[1].length==1 && store.bytes.blocks[1].bytes[0]==17}
machine br_scalar(argument:bool,wanted:u64)->i32 {
 let input:[u8;1024];let mut store:|model|::ObjectStore=|model|::ObjectStore {};store.space.object_count=1;store.space.objects[0].value=|model|::Value::Integer {number:11};
 let mut frame:|execution_model|::Frame=|execution_model|::Frame {size:|integers|::IntegerSize::FourBytes};frame.arguments[0]=|execution_model|::Binding::Shared {shared_id:0};
 let target:|execution_model|::Target=br_target(argument);
 let outcome:|execution_model|::ExecutionOutcome=|generic_target_bridge|::write_generic_target(&input,&mut store,&mut frame,target,|execution_model|::Operand::Integer {number:4294967319},true);
 let binding:|execution_model|::Binding=br_selected(&frame,argument);let number:u64=br_integer(binding);let original:bool=br_original(&store);
 transition outcome==|execution_model|::ExecutionOutcome::Success && number==wanted && original {true -> (0) _ -> (1)}
}
machine br_target(argument:bool)->|execution_model|::Target {transition argument {true -> (|execution_model|::Target::Argument {argument_index:0}) _ -> (|execution_model|::Target::Local {local_index:0})}}
machine br_selected(frame:&|execution_model|::Frame,argument:bool)->|execution_model|::Binding {transition argument {true -> (frame.arguments[0]) _ -> (frame.locals[0])}}
machine br_original(store:&|model|::ObjectStore)->bool {let valid:bool=store.space.object_count==1;transition store.space.objects[0].value {|model|::Value::Integer {number} -> (valid && number==11) _ -> (false)}}
machine Suite::bridge_bytes_0(&mut self)->i32 {let result:i32=br_bytes(1);result}
machine Suite::bridge_bytes_1(&mut self)->i32 {let result:i32=br_bytes(2);result}
machine Suite::bridge_local_0(&mut self)->i32 {let result:i32=br_scalar(false,23);result}
machine Suite::bridge_local_1(&mut self)->i32 {let result:i32=br_scalar(false,24);result}
machine Suite::bridge_arg_0(&mut self)->i32 {let result:i32=br_scalar(true,23);result}
machine Suite::bridge_arg_1(&mut self)->i32 {let result:i32=br_scalar(true,24);result}
