machine rv_check(store:&ObjectStore,operand:Operand,wanted:ExecutionOutcome,scalar_wanted:ExecutionOutcome,number:u64)->i32 {
 let mut input:[u8;1024];input[0]=65;
 let actual:ExecutionOutcome=validate_operand(&input,1,7,store,operand);
 let rich:ValueResult=admit_data(&input,1,7,store,operand);
 let scalar:SlotResult=integer_operand(store,IntegerSize::FourBytes,operand);
 let good:bool=rv_assert(actual,rich.outcome,wanted,scalar.outcome,scalar_wanted,scalar.slot.initialized,scalar.slot.number,number);
 transition good {true -> (0) _ -> (1)}
}
machine rv_assert(actual:ExecutionOutcome,rich:ExecutionOutcome,wanted:ExecutionOutcome,scalar:ExecutionOutcome,scalar_wanted:ExecutionOutcome,initialized:bool,number:u64,expected:u64)->bool {actual==wanted && rich==wanted && scalar==scalar_wanted && (scalar!=ExecutionOutcome::Success || (initialized && number==expected))}
