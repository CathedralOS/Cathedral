machine unknown_kept(fact: TopologyFact) -> bool { transition fact { TopologyFact::Other { other_entry } -> inspect(other_entry) _ -> (false) } state inspect(entry: MadtEntry) -> bool { let result: bool = raw_unknown(entry); result } }
machine raw_unknown(entry: MadtEntry) -> bool { transition entry { MadtEntry::Unknown { header } -> (header.entry_type == 128 && header.length == 2) _ -> (false) } }
