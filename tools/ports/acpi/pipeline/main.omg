use {aml}/model.omg;
use {aml}/namespace.omg;
use {aml}/loader.omg;
use {pipeline}/program.omg;
use {execution}/engine.omg;
use {execution}/execution_model.omg;
use {integer_helpers}/integers.omg;
machine test_result() -> i32 {
let mut input: [u8;1024];
input[0] = 20;
input[1] = 13;
input[2] = 77;
input[3] = 65;
input[4] = 73;
input[5] = 78;
input[7] = 164;
input[8] = 114;
input[9] = 10;
input[10] = 40;
input[11] = 10;
input[12] = 2;
let prepared: |program|::Prepared = |program|::prepare_program(input,14,7,64,128);
let mut program: |program|::Program = prepared.program;
let mut target_path: |model|::Path = |model|::Path { absolute:true,count:1 };
target_path.segments[0] = 1313423693;
let arguments: [|model|::Value;7];
let result: |engine|::ExecutionResult = |program|::run_program(&mut program,target_path,&arguments,0,|integers|::IntegerSize::FourBytes,256);
transition prepared.outcome == |model|::Outcome::Success && result.outcome == |execution_model|::ExecutionOutcome::Success && result.value.initialized && result.value.number == 42 { true -> (0) _ -> (1) }
}
const TEST_RESULT:i32=test_result();
machine require_ok(value:i32) requires value==0;{}
data Main{}
machine Main::main(&mut self){require_ok(TEST_RESULT);}
