pub data Operand [copy] { case Uninitialized; case Integer(number:u64); case Object(object_id:u64); }
pub data Binding [copy] { case Uninitialized; case Integer(number:u64); case Shared(shared_id:u64); case Cell(cell_id:u64); }
pub data OperandResult [copy] { outcome:ExecutionOutcome; operand:Operand; }
pub data BindingResult [copy] { outcome:ExecutionOutcome; binding:Binding; }
pub data ValueResult [copy] { outcome:ExecutionOutcome; value:Value; has_object:bool; object:u64; }
pub data Slot [copy] { initialized: bool; number: u64; }
pub data Target [copy] {
    case Null; case Local(local_index: u64); case Argument(argument_index: u64);
    case Named(object_id: u64); case Debug;
}
pub data SlotResult [copy] { outcome: ExecutionOutcome; slot: Slot; }
pub data TargetResult [copy] { outcome: ExecutionOutcome; target: Target; next: u64; }
pub data Block [copy] { looping: bool; parent_end: u64; after: u64; predicate: u64; end: u64; }
pub data Operation [copy] {
    opcode: u64; count: u64; value_arity: u64; target_arity: u64; operands: [Operand; 7]; first_target: Target; second_target: Target;
    body_end: u64; predicate: u64; parent_end: u64; method_id: u64; method_body: Span; method_flags: u8;
}
pub data NameCache [copy] { at: u64; next: u64; object_id: u64; entry_index: u64; }
pub data DeferredRead [copy] {case None;case Field(object:u64,at:u64,next:u64);}
pub data Frame [copy] {
    scope: Path; body: Span; source_length:u64; size: IntegerSize; pc: u64; end: u64;
    arguments: [Binding; 7]; locals: [Binding; 8];
    block_count: u64; blocks: [Block; 8];
    operation_count: u64; operations: [Operation; 16];
    cache_count: u64; lookup_cache: [NameCache; 16];
    returned: bool; has_return_value:bool; return_value: Operand;
    field_reads:bool; deferred_read:DeferredRead;
}
pub data FrameResult [copy] { outcome: ExecutionOutcome; frame: Frame; }
pub data Runtime [copy] {
    outcome: ExecutionOutcome; frames: [Frame; 4]; count: u64;
    unit: u64; length: u64; steps: u64; finished: bool; has_result:bool; result: Operand;
    fault_offset: u64;
}
pub data RuntimeStart [copy] {case Failure(outcome:ExecutionOutcome);case Ready(runtime:Runtime);}
pub data Error [copy] {case InvalidFlags;case InconsistentAccess;case UnsupportedKind;case UnsupportedConnection;case UnsupportedMetadata;case UnsupportedBuffer;case UnsupportedZeroWidth;case Capacity;case Overflow;case OutsideRegion;case InvalidChunk;case NeedsPrevious;}
pub data LockRequirement [copy] {case NotRequested;case UnmetGlobalLock;}
pub data ReadShape [copy] {case Integer(size:IntegerSize);case Buffer(bytes:u64);}
pub data Chunk [copy] {offset:u64;width:u64;field_bit:u64;native_bit:u64;bit_count:u64;mask:u64;partial:bool;}
pub data Plan [copy] {access:AccessType;update:UpdateRule;lock:LockRequirement;shape:ReadShape;bit_offset:u64;bit_length:u64;region_bytes:u64;start:u64;end:u64;width:u64;count:u64;preserve_reads:u64;chunks:[Chunk;257];}
pub data PlanResult [copy] {case Ready(plan:Plan);case Failure(error:Error);}
pub data Previous [copy] {case Absent;case Value(word:u64);}
pub data WordResult [copy] {case Word(value:u64);case Failure(error:Error);}
pub data Program {
    loaded: bool;
    source: [u8; 1024]; length: u64; unit: u64;
    store: ObjectStore; definitions: MethodDefinitions;
}
pub data Prepared { outcome: Outcome; offset: u64; program: Program; }
pub data ExecutionResult [copy] { outcome: ExecutionOutcome; value: Slot; has_value:bool; operand:Operand; steps: u64; fault_offset: u64; }
pub data State [copy] {case Failed;case Running;case AwaitingRead;case Finished;}
pub data Fault [copy] {
 case InvalidState;case Execution(outcome:ExecutionOutcome);case Geometry(cause:Error);
 case UnsupportedSpace;case UnmetLock;case BaseAlignment;case AddressOverflow;
 case Provider(outcome:ExecutionOutcome);
}
pub data NativeRead [copy] {
 session:u64;serial:u64;unit:u64;field:u64;region:u64;space:u8;
 base:u64;offset:u64;width:u64;
}
pub data Completion [copy] {
 case Failure(request:NativeRead,outcome:ExecutionOutcome);
 case Word(request:NativeRead,value:u64);
}
pub data ReadField [copy] {object:u64;region:u64;declaration:Declaration;field:Field;}
pub data Transfer [copy] {
 definition:ReadField;region:u64;base:u64;region_bytes:u64;size:IntegerSize;
 plan:Plan;words:[u64;257];received:u64;request:NativeRead;
}
pub data Session {
 state:State;outcome:ExecutionOutcome;fault:Fault;program:Program;runtime:Runtime;
 correlation:u64;fuel_limit:u64;issued:u64;accepted:u64;transfer:Transfer;
 result_objects:u64;result_bytes:u64;result:ExecutionResult;
}
pub data Progress [copy] {
 case Failure(outcome:ExecutionOutcome);case Paused;
 case Read(request:NativeRead);case Finished(result:ExecutionResult);
}
pub data OperationHeader [copy] {value_arity:u64;target_arity:u64;count:u64;}
machine decode_generic_value(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame,next:u64,found:OperandResult)->ExecutionOutcome {
 transition found.outcome==ExecutionOutcome::Success {true -> mode(input,store,frame,next,found.operand) _ -> (found.outcome)}
 state mode(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame,next:u64,operand:Operand)->ExecutionOutcome {
  transition frame.field_reads {true -> selected(input,store,frame,next,operand) _ -> admit(input,store,frame,next,operand)}
 }
 state selected(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame,next:u64,operand:Operand)->ExecutionOutcome {
  let value:ValueResult=read_value(store,operand);
  transition value.outcome==ExecutionOutcome::Success && value.has_object {
   true -> payload(input,store,frame,next,operand,value)
   _ -> admit(input,store,frame,next,operand)
  }
 }
 state payload(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame,next:u64,operand:Operand,value:ValueResult)->ExecutionOutcome {
  transition value.value {Value::FieldUnit {binding,declaration,field} -> deferred(frame,next,value.object) _ -> admit(input,store,frame,next,operand)}
 }
 state deferred(frame:&mut Frame,next:u64,object:u64)->ExecutionOutcome {
  transition object<64 && next>frame.pc && next<=frame.end && frame.end<=frame.body.end && frame.body.end<=frame.source_length && frame.source_length<=1024 {
   true -> ready(frame,next,object) _ -> (ExecutionOutcome::InvalidState)
  }
 }
 state ready(frame:&mut Frame,next:u64,object:u64)->ExecutionOutcome {
  // Check contribution room without changing the real parent operation.
  let operation:OperationHeader=operation_header(frame);
  transition frame.operation_count==0 || (frame.operation_count<=16 && operation.count<operation.value_arity && operation.count<7) {
   true -> suspend(frame,next,object) _ -> (ExecutionOutcome::InvalidState)
  }
 }
 state suspend(frame:&mut Frame,next:u64,object:u64)->ExecutionOutcome {
  frame.deferred_read=DeferredRead::Field {object:object,at:frame.pc,next:next};ExecutionOutcome::Success
 }
 state admit(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame,next:u64,operand:Operand)->ExecutionOutcome {
  let value:ExecutionOutcome=validate_operand(input,frame.source_length,frame.body.unit,store,operand);
  transition value==ExecutionOutcome::Success {true -> contribute(frame,next,operand) _ -> (value)}
 }
 state contribute(frame:&mut Frame,next:u64,operand:Operand)->ExecutionOutcome {let result:ExecutionOutcome=contribute_operand(frame,operand);let committed:ExecutionOutcome=decode_commit_cursor(frame,next,result);committed}
}
machine decode_commit_cursor(frame:&mut Frame,next:u64,outcome:ExecutionOutcome)->ExecutionOutcome {
 transition outcome==ExecutionOutcome::Success {true -> commit(frame,next) _ -> (outcome)}
 state commit(frame:&mut Frame,next:u64)->ExecutionOutcome {frame.pc=next;ExecutionOutcome::Success}
}
pub machine object_outcome(outcome:Outcome)->ExecutionOutcome {
 transition outcome {Outcome::Success -> (ExecutionOutcome::Success) Outcome::Capacity -> (ExecutionOutcome::Capacity) Outcome::WorkLimit -> (ExecutionOutcome::WorkLimit) Outcome::MissingObject -> (ExecutionOutcome::MissingObject) _ -> (ExecutionOutcome::InvalidState)}
}
pub machine read_value(store:&ObjectStore,operand:Operand)->ValueResult {
 transition operand {Operand::Uninitialized -> (ValueResult {value:Value::Uninitialized}) Operand::Integer {number} -> (ValueResult {value:Value::Integer {number:number}}) Operand::Object {object_id} -> object_value(store,object_id)}
 state object_value(store:&ObjectStore,id:u64)->ValueResult {
  let found:ReferenceState=unwrap_transparent(&store.space,id,64);
  let outcome:ExecutionOutcome=object_outcome(found.outcome);
  transition outcome==ExecutionOutcome::Success && found.object<64 {true -> selected(store,found.object) _ -> (ValueResult {outcome:outcome})}
 }
 state selected(store:&ObjectStore,id:u64)->ValueResult {ValueResult {value:store.space.objects[id].value,has_object:true,object:id}}
}
pub machine unwrap_transparent(space:&Namespace,object:u64,budget:u64)->ReferenceState {
 let result:ReferenceState=or_unwrap(space,object,budget,true);result
}
machine or_unwrap(space:&Namespace,object:u64,budget:u64,transparent:bool)->ReferenceState {
 let capacity:u64=space.object_count;
 transition capacity<=64 && object<capacity && object<64 && budget<=64 {
  true -> run(space,object,budget,transparent)
  _ -> (ReferenceState {outcome:Outcome::InvalidState,object:object,done:true})
 }
 state run(space:&Namespace,object:u64,budget:u64,transparent:bool)->ReferenceState {
  let initial:ReferenceState=ReferenceState {object:object};
  let result:ReferenceState=or_reference_walk(space,initial,0,budget,transparent);
  transition result.done {true -> (result) _ -> (ReferenceState {outcome:Outcome::WorkLimit,object:result.object,visited:result.visited,done:true})}
 }
}
machine or_reference_walk(space:&Namespace,value:ReferenceState,index:u64,count:u64,transparent:bool)
terminates by(index,count)->Nat::BoundedDistance;
->ReferenceState {
 let next:ReferenceState=or_reference_bounded_step(space,value,index,count,transparent);
 transition index<count {true -> or_reference_walk(space,next,index+1,count,transparent) _ -> (value)}
}
machine or_reference_bounded_step(space:&Namespace,value:ReferenceState,index:u64,count:u64,transparent:bool)->ReferenceState {
 transition index<count {true -> step(space,value,transparent) _ -> (value)}
 state step(space:&Namespace,value:ReferenceState,transparent:bool)->ReferenceState {
  let next:ReferenceState=or_reference_step(space,value,transparent);next
 }
}
machine or_reference_step(space:&Namespace,value:ReferenceState,transparent:bool)->ReferenceState {
 transition value.done {true -> (value) _ -> inspect(space,value,transparent,value.object)}
 state inspect(space:&Namespace,value:ReferenceState,transparent:bool,index:u64)->ReferenceState {
  transition index<space.object_count && index<64 {true -> payload(space,value,transparent,index) _ -> (ReferenceState {outcome:Outcome::InvalidState,object:index,visited:value.visited,done:true})}
 }
 state payload(space:&Namespace,value:ReferenceState,transparent:bool,index:u64)->ReferenceState {
  let mask:u64=(1 as u64)<<index;let seen:u64=value.visited|mask;
  let payload:Value=space.objects[index].value;
  transition payload {
   Value::Reference {kind,object_id} -> reference(space,index,object_id,seen,kind,transparent)
   _ -> (ReferenceState {object:index,visited:seen,done:true})
  }
 }
 state reference(space:&Namespace,from:u64,target:u64,seen:u64,kind:ReferenceKind,transparent:bool)->ReferenceState {
  let follow:bool=!transparent || kind==ReferenceKind::Named || kind==ReferenceKind::Local || kind==ReferenceKind::Arg;
  transition follow {true -> bounds(space,target,seen) _ -> (ReferenceState {object:from,visited:seen,done:true})}
 }
 state bounds(space:&Namespace,target:u64,seen:u64)->ReferenceState {
  transition target<space.object_count && target<64 {true -> cycle(target,seen) _ -> (ReferenceState {outcome:Outcome::InvalidState,object:target,visited:seen,done:true})}
 }
 state cycle(target:u64,seen:u64)->ReferenceState {
  let mask:u64=(1 as u64)<<target;
  transition seen&mask!=0 {true -> (ReferenceState {outcome:Outcome::ReferenceCycle,object:target,visited:seen,done:true}) _ -> (ReferenceState {object:target,visited:seen})}
 }
}
pub machine operation_header(frame:&Frame)->OperationHeader {
 let count:u64=frame.operation_count;
 transition count>0 && count<=16 {true -> at(frame,count-1) _ -> (OperationHeader {})}
 state at(frame:&Frame,index:u64)->OperationHeader {
  transition index<16 {true -> fields(frame,index) _ -> (OperationHeader {})}
 }
 state fields(frame:&Frame,index:u64)->OperationHeader {
  OperationHeader {value_arity:frame.operations[index].value_arity,target_arity:frame.operations[index].target_arity,count:frame.operations[index].count}
 }
}
pub machine pending_read(runtime:&Runtime)->DeferredRead {
 transition runtime.count>0 && runtime.count<=4 {true -> frame(runtime,runtime.count-1) _ -> (DeferredRead::None)}
 state frame(runtime:&Runtime,index:u64)->DeferredRead {
  transition index<4 {true -> (runtime.frames[index].deferred_read) _ -> (DeferredRead::None)}
 }
}
pub machine advance_read_runtime(input:&[u8;1024],store:&mut ObjectStore,definitions:&[MethodDefinition;64],runtime:&mut Runtime)->ExecutionOutcome {
 transition runtime.finished || runtime.outcome!=ExecutionOutcome::Success {
  true -> (runtime.outcome) _ -> pending(input,store,definitions,runtime)
 }
 state pending(input:&[u8;1024],store:&mut ObjectStore,definitions:&[MethodDefinition;64],runtime:&mut Runtime)->ExecutionOutcome {
  let deferred:DeferredRead=pending_read(runtime);
  transition deferred {DeferredRead::None -> fuel(input,store,definitions,runtime) _ -> (ExecutionOutcome::Success)}
 }
 state fuel(input:&[u8;1024],store:&mut ObjectStore,definitions:&[MethodDefinition;64],runtime:&mut Runtime)->ExecutionOutcome {
  transition runtime.steps<1024 {true -> turn(input,store,definitions,runtime) _ -> exhausted(runtime)}
 }
 state turn(input:&[u8;1024],store:&mut ObjectStore,definitions:&[MethodDefinition;64],runtime:&mut Runtime)->ExecutionOutcome {
  let outcome:ExecutionOutcome=execution_run_turn(input,store,definitions,runtime,0,1);outcome
 }
 state exhausted(runtime:&mut Runtime)->ExecutionOutcome {runtime.outcome=ExecutionOutcome::WorkLimit;runtime.outcome}
}
machine execution_run_turn(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64, limit: u64) -> ExecutionOutcome {
    transition index < limit && !runtime.finished && runtime.outcome == ExecutionOutcome::Success && runtime.steps < 1024 {
        true -> active(input, space, definitions, runtime) _ -> (runtime.outcome)
    }
    state active(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime) -> ExecutionOutcome {
        runtime.steps = runtime.steps + 1;
        let result: ExecutionOutcome = execution_turn(input, space, definitions, runtime);
        runtime.outcome = result; result
    }
}
