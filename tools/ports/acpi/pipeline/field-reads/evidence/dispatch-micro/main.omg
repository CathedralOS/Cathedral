// Explicit failing stubs for routes excluded by the selected Field operand.
machine validate_operand(input:&[u8;1024],length:u64,unit:u64,store:&ObjectStore,operand:Operand)->ExecutionOutcome {ExecutionOutcome::UnsupportedValue}
machine contribute_operand(frame:&mut Frame,operand:Operand)->ExecutionOutcome {ExecutionOutcome::UnsupportedValue}
// This synthetic turn bypasses loader, name resolution and other opcode paths.
machine execution_turn(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime) -> ExecutionOutcome {
    transition runtime.count > 0 && runtime.count <= 4 {
        true -> index(input, space, definitions, runtime, runtime.count - 1) _ -> (ExecutionOutcome::InvalidState)
    }
    state index(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64) -> ExecutionOutcome {
        transition index < 4 { true -> frame(input, space, definitions, runtime, index) _ -> (ExecutionOutcome::InvalidState) }
    }
    state frame(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64) -> ExecutionOutcome {
        runtime.fault_offset = runtime.frames[index].pc;
        let operation:OperationHeader=operation_header(&runtime.frames[index]);
        transition operation.value_arity <= 7 && operation.target_arity <= 2 && runtime.frames[index].operation_count <= 16 {
            true -> dispatch(input, space, definitions, runtime, index, operation) _ -> (ExecutionOutcome::InvalidState)
        }
    }
    state dispatch(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64, operation: OperationHeader) -> ExecutionOutcome {
        let total: u64 = operation.value_arity + operation.target_arity;
        transition {
            runtime.frames[index].returned -> complete(runtime, index)
            runtime.frames[index].operation_count != 0 && operation.count == total -> retire(input, space, definitions, runtime, index)
            runtime.frames[index].pc == runtime.frames[index].end -> block(runtime, index)
            runtime.frames[index].pc > runtime.frames[index].end -> (ExecutionOutcome::Truncated)
            runtime.frames[index].operation_count != 0 && operation.count >= operation.value_arity -> target(input, space, definitions, runtime, index)
            _ -> term(input, space, definitions, runtime, index)
        }
    }
    state complete(runtime: &mut Runtime, index: u64) -> ExecutionOutcome { let result: ExecutionOutcome = complete_frame(runtime, index); result }
    state block(runtime: &mut Runtime, index: u64) -> ExecutionOutcome {
        let result: ExecutionOutcome = finish_block(&mut runtime.frames[index]); result
    }
    state target(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64) -> ExecutionOutcome {
        let result: ExecutionOutcome = decode_target(input, space, &mut runtime.frames[index]); result
    }
    state term(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64) -> ExecutionOutcome {
        let result: ExecutionOutcome = decode_term(input, space, &mut runtime.frames[index]); result
    }
    state retire(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64) -> ExecutionOutcome {
        let operation:Operation=current_operation(&runtime.frames[index]);
        let popped: ExecutionOutcome = pop_operation(&mut runtime.frames[index]);
        transition operation.opcode == 0x10000 { true -> call(runtime, definitions, index, operation) _ -> ordinary(input, space, definitions, runtime, index, operation) }
    }
    state call(runtime: &mut Runtime, definitions: &[MethodDefinition; 64], index: u64, operation: Operation) -> ExecutionOutcome { let result: ExecutionOutcome = invoke_frame(runtime, definitions, index, operation); result }
    state ordinary(input: &[u8; 1024], space: &mut ObjectStore, definitions: &[MethodDefinition; 64], runtime: &mut Runtime, index: u64, operation: Operation) -> ExecutionOutcome {
        let result: ExecutionOutcome = retire_operation(input, space, &mut runtime.frames[index], operation); result
    }
}

machine initial()->Session {let mut session:Session=seeded(0);session.runtime.steps=1;session.runtime.frames[0].deferred_read=DeferredRead::None;session.runtime.unit=7;session.runtime.length=38;session}
machine expected(frame:&Frame,next:u64)->bool {
 transition frame.deferred_read {DeferredRead::Field {object,at,next as actual} -> (object==1 && at==34 && actual==next && frame.pc==34 && frame.operation_count==1 && frame.operations[0].count==0) _ -> (false)}
}
machine absent(frame:&Frame)->bool {transition frame.deferred_read {DeferredRead::None -> (true) _ -> (false)}}
data DecoderProbe {}
machine DecoderProbe::direct(&mut self)->i32 {
 let session:Session=initial();let mut frame:Frame=session.runtime.frames[0];
 let result:ExecutionOutcome=decode_generic_value(&session.program.source,&session.program.store,&mut frame,38,OperandResult {operand:Operand::Object {object_id:1}});
 let ok:bool=expected(&frame,38);transition result==ExecutionOutcome::Success && ok {true -> (0) _ -> (1)}
}
machine DecoderProbe::changed_expectation(&mut self)->i32 {
 let session:Session=initial();let mut frame:Frame=session.runtime.frames[0];
 let result:ExecutionOutcome=decode_generic_value(&session.program.source,&session.program.store,&mut frame,38,OperandResult {operand:Operand::Object {object_id:1}});
 let ok:bool=expected(&frame,37);transition result==ExecutionOutcome::Success && ok {true -> (0) _ -> (1)}
}
machine DecoderProbe::runtime(&mut self)->i32 {
 let session:Session=initial();let input:[u8;1024]=session.program.source;let mut store:ObjectStore=session.program.store;let definitions:[MethodDefinition;64]=session.program.definitions.entries;let mut runtime:Runtime=session.runtime;
 let result:ExecutionOutcome=advance_read_runtime(&input,&mut store,&definitions,&mut runtime);
 let ok:bool=expected(&runtime.frames[0],38);transition result==ExecutionOutcome::Success && runtime.outcome==ExecutionOutcome::Success && runtime.steps==2 && ok {true -> (0) _ -> (1)}
}
machine DecoderProbe::session(&mut self)->i32 {
 let mut session:Session=initial();
 let result:ExecutionOutcome=advance_read_runtime(&session.program.source,&mut session.program.store,&session.program.definitions.entries,&mut session.runtime);
 let ok:bool=expected(&session.runtime.frames[0],38);transition result==ExecutionOutcome::Success && session.runtime.outcome==ExecutionOutcome::Success && session.runtime.steps==2 && ok {true -> (0) _ -> (1)}
}
machine DecoderProbe::pending_poll(&mut self)->i32 {
 let mut session:Session=initial();
 let result:ExecutionOutcome=advance_read_runtime(&session.program.source,&mut session.program.store,&session.program.definitions.entries,&mut session.runtime);
 let polled:ExecutionOutcome=advance_read_runtime(&session.program.source,&mut session.program.store,&session.program.definitions.entries,&mut session.runtime);
 let ok:bool=expected(&session.runtime.frames[0],38);transition result==ExecutionOutcome::Success && polled==ExecutionOutcome::Success && session.runtime.outcome==ExecutionOutcome::Success && session.runtime.steps==2 && ok {true -> (0) _ -> (1)}
}
machine DecoderProbe::parent_full(&mut self)->i32 {
 let mut session:Session=initial();session.runtime.frames[0].operations[0].count=1;
 let result:ExecutionOutcome=advance_read_runtime(&session.program.source,&mut session.program.store,&session.program.definitions.entries,&mut session.runtime);
 let none:bool=absent(&session.runtime.frames[0]);transition result==ExecutionOutcome::InvalidState && session.runtime.outcome==ExecutionOutcome::InvalidState && session.runtime.steps==2 && session.runtime.frames[0].pc==34 && none {true -> (0) _ -> (1)}
}
pub machine current_operation(frame: &Frame) -> Operation {
    transition frame.operation_count > 0 && frame.operation_count <= 16 { true -> at(frame, frame.operation_count - 1) _ -> (Operation {}) }
    state at(frame: &Frame, index: u64) -> Operation { transition index < 16 { true -> (frame.operations[index]) _ -> (Operation {}) } }
}
pub machine pop_operation(frame: &mut Frame) -> ExecutionOutcome {
    transition frame.operation_count > 0 && frame.operation_count <= 16 {
        true -> pop(frame) _ -> (ExecutionOutcome::InvalidState)
    }
    state pop(frame: &mut Frame) -> ExecutionOutcome { frame.operation_count = frame.operation_count - 1; ExecutionOutcome::Success }
}
pub machine push_operation(frame: &mut Frame, operation: Operation) -> ExecutionOutcome {
    let index: u64 = frame.operation_count;
    transition index < 16 && operation.value_arity <= 7 && operation.target_arity <= 2 && operation.count == 0 {
        true -> push(frame, index, operation) _ -> (ExecutionOutcome::Depth)
    }
    state push(frame: &mut Frame, index: u64, operation: Operation) -> ExecutionOutcome {
        frame.operations[index] = operation; frame.operation_count = index + 1; ExecutionOutcome::Success
    }
}
machine named_operand(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame,found:NamedResult,value:Value)->ExecutionOutcome {
 transition value {
  Value::Method {flags,body} -> method(frame,found,flags,body)
  _ -> data(input,store,frame,found)
 }
 state data(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame,found:NamedResult)->ExecutionOutcome {
  let result:ExecutionOutcome=decode_generic_value(input,store,frame,found.next,OperandResult {operand:Operand::Object {object_id:found.object_id}});result
 }
 state method(frame:&mut Frame,found:NamedResult,flags:u8,body:Span)->ExecutionOutcome {
  let count:u64=(flags & 7) as u64;
  let result:ExecutionOutcome=push_operation(frame,Operation {opcode:0x10000,value_arity:count,method_id:found.object_id,method_body:body,method_flags:flags});let committed:ExecutionOutcome=decode_commit_cursor(frame,found.next,result);committed
 }
}
pub data NamedResult [copy] { outcome: ExecutionOutcome; object_id: u64; entry_index: u64; path: Path; next: u64; }

// Only the actual term-to-named-operand seam is substituted: deterministic
// name lookup reports the fixture's real Field slot and next source cursor.
machine decode_term(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame)->ExecutionOutcome {
 let found:NamedResult=NamedResult {object_id:1,next:38};
 let value:Value=store.space.objects[1].value;
 let result:ExecutionOutcome=named_operand(input,store,frame,found,value);result
}
// These unrelated dispatch paths fail if reached by any diagnostic selection.
machine complete_frame(runtime:&mut Runtime,index:u64)->ExecutionOutcome {ExecutionOutcome::UnsupportedValue}
machine finish_block(frame:&mut Frame)->ExecutionOutcome {ExecutionOutcome::UnsupportedValue}
machine decode_target(input:&[u8;1024],store:&ObjectStore,frame:&mut Frame)->ExecutionOutcome {ExecutionOutcome::UnsupportedValue}
machine invoke_frame(runtime:&mut Runtime,definitions:&[MethodDefinition;64],index:u64,operation:Operation)->ExecutionOutcome {ExecutionOutcome::UnsupportedValue}
machine retire_operation(input:&[u8;1024],store:&mut ObjectStore,frame:&mut Frame,operation:Operation)->ExecutionOutcome {ExecutionOutcome::UnsupportedValue}
