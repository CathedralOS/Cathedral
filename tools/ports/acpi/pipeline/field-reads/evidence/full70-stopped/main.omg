let mut input:[u8;1024];input[0]=91;input[1]=128;input[2]=82;input[3]=69;input[4]=71;input[5]=48;input[8]=11;input[10]=2;input[11]=91;input[12]=129;input[13]=13;input[14]=82;input[15]=69;input[16]=71;input[17]=48;input[18]=1;input[20]=5;input[21]=70;input[22]=76;input[23]=68;input[24]=95;input[25]=29;input[26]=20;input[27]=11;input[28]=77;input[29]=65;input[30]=73;input[31]=78;input[33]=164;input[34]=70;input[35]=76;input[36]=68;input[37]=95;
