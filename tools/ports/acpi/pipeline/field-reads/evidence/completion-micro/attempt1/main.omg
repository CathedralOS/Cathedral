  let value:IntegerResult=field_to_integer(size,bytes,256,0,plan.bit_length);
  transition value.error==0 {true -> (ReadResult::Integer {value:value.value,size:size,lock:plan.lock}) _ -> (ReadResult::Failure {error:ReadError::InternalChunk})}
