pub machine source_bit(source: &[u8; 256], length: u64, start: u64, index: u64) -> u8 {
    transition length <= 256 && start < 2048 { true -> bounded(source, length, start, index) _ -> (0) }
    state bounded(source: &[u8; 256], length: u64, start: u64, index: u64) -> u8 {
        transition index < 2048 && index < 2048 - start { true -> offset(source, length, start + index) _ -> (0) }
    }
