pub data ReadError [copy] {case Geometry(cause:Error);case CountMismatch;case InternalChunk;}
// Numeric data only. An unmet lock requirement is never a held-lock receipt.
pub data ReadResult [copy] {
 case Failure(error:ReadError);
 case Integer(value:u64,size:IntegerSize,lock:LockRequirement);
 case Buffer(length:u64,bytes:[u8;256],lock:LockRequirement);
}
pub data IntegerResult [copy] { error: u8; value: u64; remainder: u64; }
data Bytes [copy] {bytes:[u8;256];}
pub machine assemble(kind:DeclarationKind,field:&Field,region_bytes:u64,size:IntegerSize,words:&[u64;257],supplied_count:u64)->ReadResult {
