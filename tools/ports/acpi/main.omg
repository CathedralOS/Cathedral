machine test_checksum_empty() -> bool {
    let mut input: [u8; 4096];
    let result: ChecksumResult = checksum(&input, 0);
    result.error == 0 &&
    result.sum == 0
 }
machine test_checksum_capacity() -> bool {
    let mut input: [u8; 4096];
    let result: ChecksumResult = checksum(&input, 4097);
    result.error == 1
 }
machine test_checksum_capacity_exact() -> bool {
    let mut input: [u8; 4096];
    input[4095] = 255;
    let result: ChecksumResult = checksum(&input, 4096);
    result.error == 0 &&
    result.sum == 255
 }
