use {access}/model.omg;
use {aml}/field_model.omg;
use {integers}/integers.omg;
use {writes}/write.omg;
data Main {payload:[u8;256];previous:[|model|::Previous;257];}machine Main::main(&mut self){let field:|field_model|::Field=|field_model|::Field {};_ = |write|::assemble(|field_model|::DeclarationKind::Field,&field,4,|integers|::IntegerSize::EightBytes,&self.payload,0,&self.previous,0);}
