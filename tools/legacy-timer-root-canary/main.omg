// Compile-only: lower the real PIC handler without executing privileged instructions.
use arch::isa::x86_64::interrupts::entry::CathedralAcknowledgementRepresentation;
use omega::language::core::interrupt;
use arch::board::pc::timer::root::LegacyPicTimerRoot;

machine timer_entry(acknowledgement: InterruptAcknowledgement in Pending) reaches PortIo {
    LegacyPicTimerRoot::enter(acknowledgement);
}
