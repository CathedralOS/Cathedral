use {omega}/language/core/interrupt.omg;
use {arch}/isa/x86_64/interrupts/entry.omg;
machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_timer_double_ack");
    Build::depend_as(builder, "arch", Source::Path { location: "../../../../source/kernel/arch" });
    Build::select_representation<|interrupt|::InterruptAcknowledgement, |entry|::CathedralAcknowledgementRepresentation>(builder);
    builder.freestanding = true;
}
