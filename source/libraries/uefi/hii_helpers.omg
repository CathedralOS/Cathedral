// Modified pure helpers from uefi-raw c0facddf9ba42b74906a37fca2869e6cdbc8da6a.
// No union projection, firmware calls or authority establishment.
module hii_helpers;
use cathedral_uefi_raw::hii_ifr;

pub machine ifr_date_storage(flags: hii_ifr::IfrDateFlags) -> hii_ifr::IfrDateStorage {
    hii_ifr::IfrDateStorage { raw: flags.raw & 0x30 }
}
pub machine ifr_time_storage(flags: hii_ifr::IfrTimeFlags) -> hii_ifr::IfrTimeStorage {
    hii_ifr::IfrTimeStorage { raw: flags.raw & 0x30 }
}
pub machine ifr_numeric_size(flags: hii_ifr::IfrNumericFlags) -> hii_ifr::IfrNumericSize {
    hii_ifr::IfrNumericSize { raw: flags.raw & 0x03 }
}
pub machine ifr_numeric_display(flags: hii_ifr::IfrNumericFlags) -> hii_ifr::IfrNumericDisplay {
    hii_ifr::IfrNumericDisplay { raw: flags.raw & 0x30 }
}

// Locally authored field extraction and bounded header checks, UEFI section33.
// These preserve unknown tags and never interpret a union or execute IFR.
pub machine hii_package_length(length_and_type: u32) -> u32 { length_and_type & 0x00ff_ffff }
pub machine hii_package_type(length_and_type: u32) -> u8 { (length_and_type >> 24) as u8 }
pub machine hii_package_fits(length_and_type: u32, available: u64) -> bool {
    (length_and_type & 0x00ff_ffff) >= 4 &&
    ((length_and_type & 0x00ff_ffff) as u64) <= available
}
pub machine ifr_op_length(length_and_scope: u8) -> u8 { length_and_scope & 0x7f }
pub machine ifr_op_has_scope(length_and_scope: u8) -> bool { (length_and_scope & 0x80) != 0 }
pub machine ifr_op_fits(length_and_scope: u8, available: u64) -> bool {
    (length_and_scope & 0x7f) >= 2 && ((length_and_scope & 0x7f) as u64) <= available
}
