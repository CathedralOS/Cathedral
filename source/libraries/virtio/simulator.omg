    }
    state slot7(value: QueueSimulation, item: u16) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.available[7] = item;
      out
    }
}
machine buffer_set(value: QueueSimulation, index: u16, item: SimBuffer) -> QueueSimulation {
    transition index {
      0 -> slot0(value, item)
      1 -> slot1(value, item)
      2 -> slot2(value, item)
      3 -> slot3(value, item)
      4 -> slot4(value, item)
      5 -> slot5(value, item)
      6 -> slot6(value, item)
      7 -> slot7(value, item)
      _ -> (value)
    }
    state slot0(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[0] = item;
      out
    }
    state slot1(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[1] = item;
      out
    }
    state slot2(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[2] = item;
      out
    }
    state slot3(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[3] = item;
      out
    }
    state slot4(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[4] = item;
      out
    }
    state slot5(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[5] = item;
      out
    }
    state slot6(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[6] = item;
      out
    }
    state slot7(value: QueueSimulation, item: SimBuffer) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.descriptors[7] = item;
      out
    }
}
machine completion_set(value: QueueSimulation, index: u16, item: Completion) -> QueueSimulation {
    transition index {
      0 -> slot0(value, item)
      1 -> slot1(value, item)
      2 -> slot2(value, item)
      3 -> slot3(value, item)
      4 -> slot4(value, item)
      5 -> slot5(value, item)
      6 -> slot6(value, item)
      7 -> slot7(value, item)
      _ -> (value)
    }
    state slot0(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[0] = item;
      out
    }
    state slot1(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[1] = item;
      out
    }
    state slot2(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[2] = item;
      out
    }
    state slot3(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[3] = item;
      out
    }
    state slot4(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[4] = item;
      out
    }
    state slot5(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[5] = item;
      out
    }
    state slot6(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[6] = item;
      out
    }
    state slot7(value: QueueSimulation, item: Completion) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.used[7] = item;
      out
    }
}
machine busy_clear(value: QueueSimulation, index: u16) -> QueueSimulation {
    transition index {
      0 -> slot0(value)
      1 -> slot1(value)
      2 -> slot2(value)
      3 -> slot3(value)
      4 -> slot4(value)
      5 -> slot5(value)
      6 -> slot6(value)
      7 -> slot7(value)
      _ -> (value)
    }
    state slot0(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[0] = false;
      out
    }
    state slot1(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[1] = false;
      out
    }
    state slot2(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[2] = false;
      out
    }
    state slot3(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[3] = false;
      out
    }
    state slot4(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[4] = false;
      out
    }
    state slot5(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[5] = false;
      out
    }
    state slot6(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[6] = false;
      out
    }
    state slot7(value: QueueSimulation) -> QueueSimulation {
      let mut out: QueueSimulation = value;
      out.busy[7] = false;
      out
    }
}
