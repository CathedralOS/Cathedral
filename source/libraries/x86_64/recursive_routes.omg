// SPDX-License-Identifier: MIT OR Apache-2.0
// Modified pure orchestration of pinned x86_64 RecursivePageTable Mapper methods.
// Reuses canonical capture/request/effect types; see recursive-routes.PORT.md.
// Captures, allocations and edits are numeric proposals, never live custody.
module recursive_routes;
use pages;
use page_entries;
use mapping_plans;
use mapping_plans::FrameSupply;
use mapping_plans::ChildPlan;
use mapping_plans::LeafPlan;

use mapping_routes::Request;
use mapping_routes::CapturedPath;
use mapping_routes::AllocationInputs;
use mapping_routes::Edits;
use mapping_routes::Outcome;
use mapping_routes::RoutePlan;

pub machine plan(path: &CapturedPath, allocations: &AllocationInputs, page: u64, size: u64, request: Request) -> RoutePlan {
    let valid_page: bool = pages::start_valid(page, size, false);
    let valid_request: bool = request_valid(request, size);
    transition valid_page && valid_request {
        true -> begin(path, allocations, page, size, request)
        _ -> (RoutePlan {})
    }
    state begin(path: &CapturedPath, allocations: &AllocationInputs, page: u64, size: u64, request: Request) -> RoutePlan {
        let edits: Edits = Edits { table_ids: path.table_ids, words: path.words,
            indices: [((page >> 39) & 511) as u16, ((page >> 30) & 511) as u16,
                ((page >> 21) & 511) as u16, ((page >> 12) & 511) as u16] };
        let target: u8 = target_index(size, request);
        let outcome: Outcome = route(path, allocations, &mut edits, size, request, target);
        RoutePlan { edits: edits, outcome: outcome }
    }
}
machine request_valid(request: Request, size: u64) -> bool {
    transition request {
        Request::Map { frame, flags, parent_flags } -> frame_valid(frame, size)
        Request::SetParent { level, table_flags } -> (level >= 2 && level <= 4)
        _ -> (true)
    }
    state frame_valid(frame: u64, size: u64) -> bool {
        let valid: bool = pages::start_valid(frame, size, true);
        valid
    }
}
machine target_index(size: u64, request: Request) -> u8 {
    transition request {
        Request::SetParent { level, table_flags } -> parent(level)
        _ -> leaf(size)
    }
    state leaf(size: u64) -> u8 {
        transition size { 1073741824 -> (1) 2097152 -> (2) _ -> (3) }
    }
    state parent(level: u8) -> u8 {
        transition level <= 4 { true -> (4 - level) _ -> (4) }
    }
}
machine route(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, size: u64, request: Request, target: u8) -> Outcome {
    let leaf: u8 = target_index(size, Request::Translate);
    transition {
        target > leaf -> (Outcome::ParentHugePage)
        target == leaf && is_parent_request(request) -> (Outcome::ParentHugePage)
        target == 0 -> complete(edits, size, request, 0)
        _ -> first(path, allocations, edits, size, request, target)
    }
    state first(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, size: u64, request: Request, target: u8) -> Outcome {
        let result: Outcome = parent_step(path, allocations, edits, request, 0);
        transition result {
            Outcome::Continue -> second(path, allocations, edits, size, request, target)
            _ -> (result)
        }
    }
    state second(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, size: u64, request: Request, target: u8) -> Outcome {
        transition target == 1 { true -> complete(edits, size, request, 1) _ -> descend_second(path, allocations, edits, size, request, target) }
    }
    state descend_second(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, size: u64, request: Request, target: u8) -> Outcome {
        let result: Outcome = parent_step(path, allocations, edits, request, 1);
        transition result { Outcome::Continue -> third(path, allocations, edits, size, request, target) _ -> (result) }
    }
    state third(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, size: u64, request: Request, target: u8) -> Outcome {
        transition target == 2 { true -> complete(edits, size, request, 2) _ -> descend_third(path, allocations, edits, size, request) }
    }
    state descend_third(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, size: u64, request: Request) -> Outcome {
        let result: Outcome = parent_step(path, allocations, edits, request, 2);
        transition result { Outcome::Continue -> complete(edits, size, request, 3) _ -> (result) }
    }
    state complete(edits: &mut Edits, size: u64, request: Request, index: u8 [0..=3]) -> Outcome {
        let result: Outcome = finish(edits, size, request, index);
        result
    }
}
machine is_parent_request(request: Request) -> bool {
    transition request { Request::SetParent { level, table_flags } -> (true) _ -> (false) }
}
machine parent_step(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, request: Request, index: u8 [0..=2]) -> Outcome {
    edits.visited = index + 1;
    let word: u64 = edits.words[index];
    transition request {
        Request::Map { frame, flags, parent_flags } -> mapping(path, allocations, edits, index, word, parent_flags)
        Request::Unmap -> existing(path, edits, index, word)
        _ -> nonzero(path, edits, index, word)
    }
    state mapping(path: &CapturedPath, allocations: &AllocationInputs, edits: &mut Edits, index: u8 [0..=2], word: u64, flags: u64) -> Outcome {
        let supplied: FrameSupply = allocation(allocations, edits, word);
        let child: ChildPlan = prepare_child(word, flags, supplied);
        record_word(edits, index, child.word, child.write);
        transition child {
            ChildPlan::Ready { address, zero_child } -> ready_child(path, edits, index, address, zero_child)
            _ -> (Outcome::ChildFailure { child: child })
        }
    }
    state nonzero(path: &CapturedPath, edits: &mut Edits, index: u8 [0..=2], word: u64) -> Outcome {
        let address: u64 = page_entries::address(word);
        transition word == 0 {
            true -> (Outcome::ParentNotMapped)
            _ -> ready_child(path, edits, index, address, false)
        }
    }
    state existing(path: &CapturedPath, edits: &mut Edits, index: u8 [0..=2], word: u64) -> Outcome {
        let address: u64 = page_entries::address(word);
        let present: bool = (word & 1) != 0;
        let huge: bool = (word & 128) != 0;
        transition {
            !present -> (Outcome::ParentNotMapped)
            huge -> (Outcome::ParentHugePage)
            _ -> ready_child(path, edits, index, address, false)
        }
    }
    state ready_child(path: &CapturedPath, edits: &mut Edits, index: u8 [0..=2], address: u64, zero: bool) -> Outcome {
        let result: Outcome = child_ready(path, edits, index, address, zero);
        result
    }
}
machine allocation(allocations: &AllocationInputs, edits: &mut Edits, word: u64) -> FrameSupply {
    let count: u8 = edits.allocation_calls;
    transition word == 0 && count < 3 {
        true -> consume(allocations, edits, count)
        _ -> (FrameSupply::Unavailable)
    }
    state consume(allocations: &AllocationInputs, edits: &mut Edits, count: u8 [0..=2]) -> FrameSupply {
        let supplied: FrameSupply = allocations.frames[count];
        edits.allocation_calls = count + 1;
        supplied
    }
}
machine record_word(edits: &mut Edits, index: u8 [0..=3], word: u64, write: bool) {
    edits.words[index] = word;
    transition write { true -> record(edits, index) _ -> {} }
    state record(edits: &mut Edits, index: u8 [0..=3]) {
        edits.write_mask = edits.write_mask | ((1 as u8) << index);
    }
}
machine child_ready(path: &CapturedPath, edits: &mut Edits, index: u8 [0..=2], address: u64, zero: bool) -> Outcome {
    let next: u8 [1..=3] = index + 1;
    transition zero {
        true -> cleared(edits, next, address)
        _ -> capture(path, edits, next, address)
    }
    state cleared(edits: &mut Edits, next: u8 [1..=3], address: u64) -> Outcome {
        edits.table_ids[next] = address;
        edits.words[next] = 0;
        edits.zero_mask = edits.zero_mask | ((1 as u8) << next);
        Outcome::Continue
    }
    state capture(path: &CapturedPath, edits: &mut Edits, next: u8 [1..=3], address: u64) -> Outcome {
        let supplied: u64 = path.table_ids[next];
        transition supplied == address {
            true -> (Outcome::Continue)
            _ -> (Outcome::CaptureMismatch { expected: address, supplied: supplied })
        }
    }
}
machine finish(edits: &mut Edits, size: u64, request: Request, index: u8 [0..=3]) -> Outcome {
    edits.visited = index + 1;
    let word: u64 = edits.words[index];
    let leaf: LeafPlan = leaf_decision(word, size, request);
    record_word(edits, index, leaf.word, leaf.write);
    Outcome::Leaf { leaf: leaf }
}
machine leaf_decision(word: u64, size: u64, request: Request) -> LeafPlan {
    transition request {
        Request::Map { frame, flags, parent_flags } -> mapping(word, size, frame, flags)
        Request::Unmap -> unmapping(word, size)
        Request::Update { new_flags } -> updating(word, size, new_flags)
        Request::SetParent { level, table_flags } -> updating(word, 4096, table_flags)
        _ -> translating(word, size)
    }
    state mapping(word: u64, size: u64, frame: u64, flags: u64) -> LeafPlan { let result: LeafPlan = mapping_plans::map_leaf(word, frame, size, flags); result }
    state unmapping(word: u64, size: u64) -> LeafPlan { let result: LeafPlan = mapping_plans::unmap_leaf(word, size); result }
    state updating(word: u64, size: u64, flags: u64) -> LeafPlan { let result: LeafPlan = mapping_plans::update_leaf_flags(word, size, flags); result }
    state translating(word: u64, size: u64) -> LeafPlan { let result: LeafPlan = mapping_plans::translate_leaf(word, size); result }
}

// Pinned recursive child creation differs from ordinary mapped child creation:
// new links force PRESENT|WRITABLE; existing links need not be PRESENT.
pub machine prepare_child(word: u64, insert_flags: u64, supply: FrameSupply) -> ChildPlan {
    transition word == 0 { true -> allocate(insert_flags, supply) _ -> existing(word, insert_flags) }
    state allocate(flags: u64, supply: FrameSupply) -> ChildPlan {
        transition supply {
            FrameSupply::Unavailable -> (ChildPlan::AllocationFailed { word: 0, write: false })
            FrameSupply::Supplied { address } -> frame(address, flags)
        }
    }
    state frame(address: u64, flags: u64) -> ChildPlan {
        transition address <= page_entries::ADDRESS_MASK && (address & 4095) == 0 {
            true -> input_flags(address, flags)
            _ -> (ChildPlan::InvalidSuppliedFrame { word: 0, write: false })
        }
    }
    state input_flags(address: u64, flags: u64) -> ChildPlan {
        let huge: bool = (flags & 128) != 0;
        transition huge {
            true -> (ChildPlan::InvalidHugeInput { word: 0, write: false })
            _ -> classify(address | flags | 3, true, true)
        }
    }
    state existing(word: u64, flags: u64) -> ChildPlan {
        let old_flags: u64 = page_entries::flags(word);
        let write: bool = flags != 0 && (old_flags & flags) != flags;
        transition write { true -> classify(word | flags, true, false) _ -> classify(word, false, false) }
    }
    state classify(word: u64, write: bool, created: bool) -> ChildPlan {
        let huge: bool = (word & 128) != 0;
        let address: u64 = page_entries::address(word);
        transition huge {
            true -> (ChildPlan::HugeParent { word: word, write: write })
            _ -> (ChildPlan::Ready { word: word, write: write, address: address, zero_child: created })
        }
    }
}
