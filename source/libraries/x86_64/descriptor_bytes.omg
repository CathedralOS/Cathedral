pub machine encode_DescriptorTablePointer(value: &x86_descriptors::DescriptorTablePointer) -> [u8; 10] {
    let mut output: [u8; 10];
    output[0] = ((value.limit >> 0) & 255) as u8;
    output[1] = ((value.limit >> 8) & 255) as u8;
    output[2] = ((value.base >> 0) & 255) as u8;
    output[3] = ((value.base >> 8) & 255) as u8;
    output[4] = ((value.base >> 16) & 255) as u8;
    output[5] = ((value.base >> 24) & 255) as u8;
    output[6] = ((value.base >> 32) & 255) as u8;
    output[7] = ((value.base >> 40) & 255) as u8;
    output[8] = ((value.base >> 48) & 255) as u8;
    output[9] = ((value.base >> 56) & 255) as u8;
    output
}
pub machine decode_DescriptorTablePointer(input: &[u8; 10]) -> x86_descriptors::DescriptorTablePointer {
    let limit: u16 = ((input[0] as u16) << 0) | ((input[1] as u16) << 8);
    let base: u64 = ((input[2] as u64) << 0) | ((input[3] as u64) << 8) | ((input[4] as u64) << 16) | ((input[5] as u64) << 24) | ((input[6] as u64) << 32) | ((input[7] as u64) << 40) | ((input[8] as u64) << 48) | ((input[9] as u64) << 56);
    x86_descriptors::DescriptorTablePointer { limit: limit, base: base }
}

