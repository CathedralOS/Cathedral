pub machine encode_GdtEntry(value: &x86_descriptors::GdtEntry) -> [u8; 8] {
    let mut output: [u8; 8];
    output[0] = ((value.raw >> 0) & 255) as u8;
    output[1] = ((value.raw >> 8) & 255) as u8;
    output[2] = ((value.raw >> 16) & 255) as u8;
    output[3] = ((value.raw >> 24) & 255) as u8;
    output[4] = ((value.raw >> 32) & 255) as u8;
    output[5] = ((value.raw >> 40) & 255) as u8;
    output[6] = ((value.raw >> 48) & 255) as u8;
    output[7] = ((value.raw >> 56) & 255) as u8;
    output
}
pub machine decode_GdtEntry(input: &[u8; 8]) -> x86_descriptors::GdtEntry {
    let raw: u64 = ((input[0] as u64) << 0) | ((input[1] as u64) << 8) | ((input[2] as u64) << 16) | ((input[3] as u64) << 24) | ((input[4] as u64) << 32) | ((input[5] as u64) << 40) | ((input[6] as u64) << 48) | ((input[7] as u64) << 56);
    x86_descriptors::GdtEntry { raw: raw }
}

pub machine encode_TssDescriptorWords(value: &x86_descriptors::TssDescriptorWords) -> [u8; 16] {
    let mut output: [u8; 16];
    output[0] = ((value.low >> 0) & 255) as u8;
    output[1] = ((value.low >> 8) & 255) as u8;
    output[2] = ((value.low >> 16) & 255) as u8;
    output[3] = ((value.low >> 24) & 255) as u8;
    output[4] = ((value.low >> 32) & 255) as u8;
    output[5] = ((value.low >> 40) & 255) as u8;
    output[6] = ((value.low >> 48) & 255) as u8;
    output[7] = ((value.low >> 56) & 255) as u8;
    output[8] = ((value.high >> 0) & 255) as u8;
    output[9] = ((value.high >> 8) & 255) as u8;
    output[10] = ((value.high >> 16) & 255) as u8;
    output[11] = ((value.high >> 24) & 255) as u8;
    output[12] = ((value.high >> 32) & 255) as u8;
    output[13] = ((value.high >> 40) & 255) as u8;
    output[14] = ((value.high >> 48) & 255) as u8;
    output[15] = ((value.high >> 56) & 255) as u8;
    output
}
pub machine decode_TssDescriptorWords(input: &[u8; 16]) -> x86_descriptors::TssDescriptorWords {
    let low: u64 = ((input[0] as u64) << 0) | ((input[1] as u64) << 8) | ((input[2] as u64) << 16) | ((input[3] as u64) << 24) | ((input[4] as u64) << 32) | ((input[5] as u64) << 40) | ((input[6] as u64) << 48) | ((input[7] as u64) << 56);
    let high: u64 = ((input[8] as u64) << 0) | ((input[9] as u64) << 8) | ((input[10] as u64) << 16) | ((input[11] as u64) << 24) | ((input[12] as u64) << 32) | ((input[13] as u64) << 40) | ((input[14] as u64) << 48) | ((input[15] as u64) << 56);
    x86_descriptors::TssDescriptorWords { low: low, high: high }
}
