    let reserved_3: u64 = ((input[92] as u64) << 0) | ((input[93] as u64) << 8) | ((input[94] as u64) << 16) | ((input[95] as u64) << 24) | ((input[96] as u64) << 32) | ((input[97] as u64) << 40) | ((input[98] as u64) << 48) | ((input[99] as u64) << 56);
    let reserved_4: u16 = ((input[100] as u16) << 0) | ((input[101] as u16) << 8);
    let iomap_base: u16 = ((input[102] as u16) << 0) | ((input[103] as u16) << 8);
