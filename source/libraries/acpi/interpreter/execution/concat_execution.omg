module concat_execution;
use aml::model::ObjectStore;
use aml::model::Value;
use aml::model::Object;
use aml::model::ByteBlock;
use aml::model::BufferStorage;
use aml::model::StringStorage;
use aml::model::Outcome;
use aml::model::ReferenceState;
use aml::object_references::unwrap_transparent;
use aml::object_concat_described;
use aml::object_concat::Concatenated;
use aml::inline_concat;
use execution_model::ExecutionOutcome;
use execution_model::Operand;
use execution_model::OperandResult;
use execution_model::Frame;
use execution_model::Target;
use execution_model::Binding;
use generic_values::normalized_operand;
use generic_values::object_outcome;
use named_store::conversion_outcome;
use generic_targets::select_target;
use generic_target_values::classify_target;
use generic_target_model::TargetSelection;
use generic_target_model::TargetAction;
use write_retirement::retire_result;
use integer_helpers::integers::IntegerSize;

data ConcatStage [copy] {store:ObjectStore;frame:Frame;}
pub machine retire_concat(input:&[u8;1024],store:&mut ObjectStore,frame:&mut Frame,left:Operand,right:Operand,target:Target)->ExecutionOutcome {
 let a:OperandResult=resolve(store,frame.size,left);
 transition a.outcome==ExecutionOutcome::Success {true -> right(input,store,frame,a.operand,right,target) _ -> (a.outcome)}
 state right(input:&[u8;1024],store:&mut ObjectStore,frame:&mut Frame,left:Operand,right:Operand,target:Target)->ExecutionOutcome {
  let b:OperandResult=resolve(store,frame.size,right);
  transition b.outcome==ExecutionOutcome::Success {true -> prepare(input,store,frame,left,b.operand,target) _ -> (b.outcome)}
 }
 state prepare(input:&[u8;1024],store:&mut ObjectStore,frame:&mut Frame,left:Operand,right:Operand,target:Target)->ExecutionOutcome {
  let result:Concatenated=concatenate(input,frame.source_length,frame.body.unit,store,frame.size,left,right);
  transition result {
   Concatenated::Failure {reason} -> failed(reason)
   Concatenated::Buffer {length,bytes} -> target(input,store,frame,target,false,length,bytes)
   Concatenated::String {length,bytes} -> target(input,store,frame,target,true,length,bytes)
  }
 }
 state failed(reason:aml::object_conversions::ConversionFailure)->ExecutionOutcome {let outcome:ExecutionOutcome=conversion_outcome(reason);outcome}
 state target(input:&[u8;1024],store:&mut ObjectStore,frame:&mut Frame,target:Target,string:bool,length:u64,bytes:[u8;256])->ExecutionOutcome {
  // Validate against the original arena; a fresh result must not make a stale
  // target ID equal to the former object_count become a valid destination.
  let admitted:ExecutionOutcome=original_target(store,frame,target);
  transition admitted==ExecutionOutcome::Success {true -> stage(input,store,frame,target,string,length,bytes) _ -> (admitted)}
 }
 state stage(input:&[u8;1024],store:&mut ObjectStore,frame:&mut Frame,target:Target,string:bool,length:u64,bytes:[u8;256])->ExecutionOutcome {
  let mut staged:ConcatStage=ConcatStage {store:store,frame:frame};
  let outcome:ExecutionOutcome=allocate(input,&mut staged,target,string,length,bytes);
  transition outcome==ExecutionOutcome::Success {true -> publish(store,frame,staged) _ -> (outcome)}
 }
 state publish(store:&mut ObjectStore,frame:&mut Frame,staged:ConcatStage)->ExecutionOutcome {store=staged.store;frame=staged.frame;ExecutionOutcome::Success}
}
machine resolve(store:&ObjectStore,size:IntegerSize,operand:Operand)->OperandResult {
 transition operand {
  Operand::Uninitialized -> (OperandResult {outcome:ExecutionOutcome::Uninitialized})
  Operand::Integer {number} -> normalized(store,size,operand)
  Operand::Object {object_id} -> object(store,size,object_id)
 }
 state object(store:&ObjectStore,size:IntegerSize,id:u64)->OperandResult {
  let found:ReferenceState=unwrap_transparent(&store.space,id,64);
  transition found.outcome==Outcome::Success {true -> normalized(store,size,Operand::Object {object_id:found.object}) _ -> failed(found.outcome)}
 }
 state normalized(store:&ObjectStore,size:IntegerSize,operand:Operand)->OperandResult {let value:Operand=normalized_operand(store,size,operand);OperandResult {operand:value}}
 state failed(outcome:Outcome)->OperandResult {let error:ExecutionOutcome=object_outcome(outcome);OperandResult {outcome:error}}
}
machine concatenate(input:&[u8;1024],length:u64,unit:u64,store:&ObjectStore,size:IntegerSize,left:Operand,right:Operand)->Concatenated {
 transition left {
  Operand::Integer {number} -> integer(input,length,unit,store,size,number,right)
  Operand::Object {object_id} -> object(input,length,unit,store,size,object_id,right)
  _ -> (Concatenated::Failure {})
 }
 state integer(input:&[u8;1024],length:u64,unit:u64,store:&ObjectStore,size:IntegerSize,left:u64,right:Operand)->Concatenated {
  transition right {
   Operand::Integer {number} -> integers(size,left,number)
   Operand::Object {object_id} -> integer_object(input,length,unit,store,size,left,object_id)
   _ -> (Concatenated::Failure {})
  }
 }
 state object(input:&[u8;1024],length:u64,unit:u64,store:&ObjectStore,size:IntegerSize,left:u64,right:Operand)->Concatenated {
  transition right {
   Operand::Integer {number} -> object_integer(input,length,unit,store,size,left,number)
   Operand::Object {object_id} -> objects(input,length,unit,store,size,left,object_id)
   _ -> (Concatenated::Failure {})
  }
 }
 state integers(size:IntegerSize,left:u64,right:u64)->Concatenated {let result:Concatenated=inline_concat::integers(size,left,right);result}
 state integer_object(input:&[u8;1024],length:u64,unit:u64,store:&ObjectStore,size:IntegerSize,left:u64,right:u64)->Concatenated {let result:Concatenated=inline_concat::integer_left(input,length,unit,store,left,right,size);result}
 state object_integer(input:&[u8;1024],length:u64,unit:u64,store:&ObjectStore,size:IntegerSize,left:u64,right:u64)->Concatenated {let result:Concatenated=inline_concat::integer_right(input,length,unit,store,left,right,size);result}
 state objects(input:&[u8;1024],length:u64,unit:u64,store:&ObjectStore,size:IntegerSize,left:u64,right:u64)->Concatenated {let result:Concatenated=object_concat_described::concatenate(input,length,unit,store,left,right,size);result}
}
machine original_target(store:&ObjectStore,frame:&Frame,target:Target)->ExecutionOutcome {
 transition target {Target::Named {object_id} -> named(store,frame,target,object_id) _ -> ordinary(store,frame,target)}
 state named(store:&ObjectStore,frame:&Frame,target:Target,id:u64)->ExecutionOutcome {
  let count:u64=store.space.object_count;
  transition count<=64 && id<count && id<64 {true -> value(store,frame,target,id) _ -> (ExecutionOutcome::MissingObject)}
 }
 state value(store:&ObjectStore,frame:&Frame,target:Target,id:u64)->ExecutionOutcome {
  transition store.space.objects[id].value {Value::FieldUnit {binding,declaration,field} -> field(store,frame,target) _ -> ordinary(store,frame,target)}
 }
 state field(store:&ObjectStore,frame:&Frame,target:Target)->ExecutionOutcome {
  transition frame.field_writes {true -> (ExecutionOutcome::Success) _ -> ordinary(store,frame,target)}
 }
 state ordinary(store:&ObjectStore,frame:&Frame,target:Target)->ExecutionOutcome {let result:ExecutionOutcome=ordinary_target(store,frame,target);result}
}
machine ordinary_target(store:&ObjectStore,frame:&Frame,target:Target)->ExecutionOutcome {
 let selected:TargetSelection=select_target(frame,target);
 let action:TargetAction=classify_target(store,selected,Operand::Uninitialized,false);
 transition action {
  TargetAction::Failure {outcome} -> (outcome)
  TargetAction::CopyTo {object_id,result_binding} -> existing(store,object_id)
  TargetAction::StoreNamed {object_id} -> existing(store,object_id)
  TargetAction::Replace {binding} -> binding(store,binding)
  TargetAction::NoWrite -> (ExecutionOutcome::Success)
 }
 state binding(store:&ObjectStore,binding:Binding)->ExecutionOutcome {transition binding {Binding::Cell {cell_id} -> existing(store,cell_id) _ -> (ExecutionOutcome::Success)}}
 state existing(store:&ObjectStore,id:u64)->ExecutionOutcome {
  let count:u64=store.space.object_count;
  transition count<=64 && id<count && id<64 {true -> (ExecutionOutcome::Success) _ -> (ExecutionOutcome::MissingObject)}
 }
}
machine allocate(input:&[u8;1024],staged:&mut ConcatStage,target:Target,string:bool,length:u64,bytes:[u8;256])->ExecutionOutcome {
 let id:u64=staged.store.space.object_count;
 transition id<64 && staged.store.space.count<=32 && length<=256 {true -> install(input,staged,target,string,length,bytes,id) _ -> (ExecutionOutcome::Capacity)}
 state install(input:&[u8;1024],staged:&mut ConcatStage,target:Target,string:bool,length:u64,bytes:[u8;256],id:u64)->ExecutionOutcome {
  let value:Value=byte_value(string,id);
  staged.store.space.objects[id]=Object {value:value};
  staged.store.bytes.blocks[id]=ByteBlock {initialized:true,length:length,bytes:bytes};
  staged.store.space.object_count=id+1;
  let outcome:ExecutionOutcome=retire_result(input,&mut staged.store,&mut staged.frame,target,Operand::Object {object_id:id});outcome
 }
}
machine byte_value(string:bool,id:u64)->Value {
 transition string {true -> (Value::String {string_storage:StringStorage::Owned {string_owner:id}}) _ -> (Value::Buffer {buffer_storage:BufferStorage::Owned {buffer_owner:id}})}
}
