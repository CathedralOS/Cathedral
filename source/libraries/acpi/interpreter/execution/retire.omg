// Retire a completed scalar/control operation. Divide writes remainder then
// quotient in AML grammar order. Namespace side effects are not rolled back.
module retire;
use aml::model::ObjectStore;
use aml::model::Value;
use execution_model::Operand;
use execution_model::ValueResult;
use generic_values::validate_operand;
use generic_values::integer_operand;
use generic_values::normalized_operand;
use generic_target_bridge::write_generic_target;
use operands::contribute_operand;
use aml::model::Read;
use aml::model::Envelope;
use aml::bytes::read_le;
use aml::bytes::envelope;
use execution_model::ExecutionOutcome;
use execution_model::Frame;
use execution_model::Operation;
use execution_model::Target;
use execution_model::SlotResult;
use execution_names::decode_outcome;
use operands::contribute_integer;
use targets::read_target;
use targets::store_target;

use control::return_operand;
use control::enter_block;
use operator_specs::compute_integer;
use to_integer_execution::retire_to_integer;
use integer_helpers::integers::IntegerResult;
pub machine retire_operation(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,operation:Operation)->ExecutionOutcome {
 transition operation.opcode {
  0xa4 -> returned(input,space,frame,operation.operands[0])
  0xa0 -> branch(input,space,frame,operation.opcode,operation.body_end,operation.parent_end,operation.predicate,operation.operands[0])
  0xa2 -> branch(input,space,frame,operation.opcode,operation.body_end,operation.parent_end,operation.predicate,operation.operands[0])
  0x70 -> copy(input,space,frame,operation.first_target,operation.operands[0],false)
  0x99 -> integer_conversion_retirement(input,space,frame,operation.operands[0],operation.first_target)
  0x9d -> copy(input,space,frame,operation.first_target,operation.operands[0],true)
  0x75 -> increment(input,space,frame,operation.opcode,operation.target_arity,operation.first_target,operation.second_target)
  0x76 -> increment(input,space,frame,operation.opcode,operation.target_arity,operation.first_target,operation.second_target)
  _ -> scalar_a(input,space,frame,operation.opcode,operation.value_arity,operation.target_arity,operation.first_target,operation.second_target,operation.operands[0],operation.operands[1])
 }
 state integer_conversion_retirement(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,operand:Operand,target:Target)->ExecutionOutcome {
  let result:ExecutionOutcome=retire_to_integer(input,space,frame,operand,target);result
 }
 state returned(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,operand:Operand)->ExecutionOutcome {
  let admitted:ExecutionOutcome=validate_operand(input,frame.source_length,frame.body.unit,space,operand);let normalized:Operand=normalized_operand(space,frame.size,operand);
  transition admitted==ExecutionOutcome::Success {true -> return_value(frame,normalized) _ -> (admitted)}
 }
 state return_value(frame:&mut Frame,operand:Operand)->ExecutionOutcome {let result:ExecutionOutcome=return_operand(frame,operand);result}
 state branch(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,body_end:u64,parent_end:u64,predicate:u64,operand:Operand)->ExecutionOutcome {
  let scalar:SlotResult=integer_operand(space,frame.size,operand);
  transition scalar.outcome==ExecutionOutcome::Success {true -> branch_value(input,frame,opcode,body_end,parent_end,predicate,scalar.slot.number) _ -> (scalar.outcome)}
 }
 state branch_value(input:&[u8;1024],frame:&mut Frame,opcode:u64,body_end:u64,parent_end:u64,predicate:u64,number:u64)->ExecutionOutcome {let result:ExecutionOutcome=retire_branch(input,frame,opcode,body_end,parent_end,predicate,number);result}
 state copy(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,target:Target,operand:Operand,is_copy:bool)->ExecutionOutcome {
  let result:ExecutionOutcome=write_generic_target(input,space,frame,target,operand,is_copy);
  transition result==ExecutionOutcome::Success {true -> copied(space,frame,target,operand,is_copy) _ -> (result)}
 }
 // ACPI 6.6 19.6.132: Store's expression result is the data written. Named
 // implicit conversion may change its type; CopyObject still contributes the
 // copied source. Arithmetic operators retain their own result contracts.
 state copied(space:&ObjectStore,frame:&mut Frame,target:Target,operand:Operand,is_copy:bool)->ExecutionOutcome {
  transition is_copy {true -> contribute(frame,operand) _ -> stored(space,frame,target,operand)}
 }
 state stored(space:&ObjectStore,frame:&mut Frame,target:Target,operand:Operand)->ExecutionOutcome {
  transition target {Target::Named {object_id} -> named_result(space,frame,object_id) _ -> contribute(frame,operand)}
 }
 state named_result(space:&ObjectStore,frame:&mut Frame,id:u64)->ExecutionOutcome {
  let operand:Operand=normalized_operand(space,frame.size,Operand::Object {object_id:id});
  let result:ExecutionOutcome=contribute_operand(frame,operand);result
 }
 state contribute(frame:&mut Frame,operand:Operand)->ExecutionOutcome {let result:ExecutionOutcome=contribute_operand(frame,operand);result}
 state increment(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,targets:u64,first:Target,second:Target)->ExecutionOutcome {
  let value:SlotResult=read_target(space,frame,first);
  transition value.outcome==ExecutionOutcome::Success {true -> compute(input,space,frame,opcode,targets,first,second,value.slot.number,1) _ -> (value.outcome)}
 }
 state scalar_a(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,values:u64,targets:u64,first:Target,second:Target,a_operand:Operand,b_operand:Operand)->ExecutionOutcome {
  let value:SlotResult=integer_operand(space,frame.size,a_operand);
  transition value.outcome==ExecutionOutcome::Success {true -> scalar_b(input,space,frame,opcode,values,targets,first,second,value.slot.number,b_operand) _ -> (value.outcome)}
 }
 state scalar_b(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,values:u64,targets:u64,first:Target,second:Target,a:u64,b_operand:Operand)->ExecutionOutcome {
  transition values>1 {true -> scalar_second(input,space,frame,opcode,targets,first,second,a,b_operand) _ -> compute(input,space,frame,opcode,targets,first,second,a,0)}
 }
 state scalar_second(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,targets:u64,first:Target,second:Target,a:u64,operand:Operand)->ExecutionOutcome {
  let value:SlotResult=integer_operand(space,frame.size,operand);
  transition value.outcome==ExecutionOutcome::Success {true -> compute(input,space,frame,opcode,targets,first,second,a,value.slot.number) _ -> (value.outcome)}
 }
 state compute(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,targets:u64,first:Target,second:Target,a:u64,b:u64)->ExecutionOutcome {
  let result:IntegerResult=compute_integer(frame.size,opcode,a,b);
  transition {result.error==1 -> (ExecutionOutcome::DivideByZero) result.error!=0 -> (ExecutionOutcome::BadEncoding) _ -> store(input,space,frame,opcode,targets,first,second,result)}
 }
 state store(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,targets:u64,first:Target,second:Target,result:IntegerResult)->ExecutionOutcome {
  let outcome:ExecutionOutcome=operation_stores(input,space,frame,opcode,targets,first,second,result);
  transition outcome==ExecutionOutcome::Success {true -> integer(frame,result.value) _ -> (outcome)}
 }
 state integer(frame:&mut Frame,number:u64)->ExecutionOutcome {let result:ExecutionOutcome=contribute_integer(frame,number);result}
}
machine operation_stores(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,opcode:u64,targets:u64,first:Target,second:Target,result:IntegerResult)->ExecutionOutcome {
 transition {targets==0 -> (ExecutionOutcome::Success) opcode==0x78 -> divide(input,space,frame,first,second,result) _ -> write_first(input,space,frame,first,result.value)}
 state write_first(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,target:Target,number:u64)->ExecutionOutcome {let result:ExecutionOutcome=store_target(input,space,frame,target,number);result}
 state divide(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,first:Target,second:Target,result:IntegerResult)->ExecutionOutcome {
  let outcome:ExecutionOutcome=store_target(input,space,frame,first,result.remainder);
  transition outcome==ExecutionOutcome::Success {true -> quotient(input,space,frame,second,result.value) _ -> (outcome)}
 }
 state quotient(input:&[u8;1024],space:&mut ObjectStore,frame:&mut Frame,target:Target,number:u64)->ExecutionOutcome {let result:ExecutionOutcome=store_target(input,space,frame,target,number);result}
}
pub data ElseBranch [copy] { outcome: ExecutionOutcome; present: bool; start: u64; end: u64; }
machine else_branch(input: &[u8; 1024], at: u64, end: u64) -> ElseBranch {
    transition at < end && end <= 1024 { true -> peek(input, at, end) _ -> (ElseBranch { end: at }) }
    state peek(input: &[u8; 1024], at: u64, end: u64) -> ElseBranch {
        let byte: Read = read_le(input, end, at, 1);
        transition byte.value == 0xa1 && at < 1024 { true -> package(input, at + 1, end) _ -> (ElseBranch { end: at }) }
    }
    state package(input: &[u8; 1024], at: u64, end: u64) -> ElseBranch {
        let body: Envelope = envelope(input, end, at);
        let outcome: ExecutionOutcome = decode_outcome(body.outcome);
        ElseBranch { outcome: outcome, present: true, start: body.body, end: body.end }
    }
}
machine retire_branch(input: &[u8; 1024], frame: &mut Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> ExecutionOutcome {
    transition frame.pc <= body_end && body_end <= parent_end && parent_end <= frame.body.end && frame.body.end <= 1024 {
        true -> restore(input, frame,opcode,body_end,parent_end,predicate,condition) _ -> (ExecutionOutcome::BadEncoding)
    }
    state restore(input: &[u8; 1024], frame: &mut Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> ExecutionOutcome {
        frame.end = parent_end;
        transition opcode == 0xa2 { true -> while_branch(frame,opcode,body_end,parent_end,predicate,condition) _ -> if_branch(input, frame,opcode,body_end,parent_end,predicate,condition) }
    }
    state while_branch(frame: &mut Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> ExecutionOutcome {
        transition condition != 0 { true -> enter_while(frame,opcode,body_end,parent_end,predicate,condition) _ -> skip(frame, body_end) }
    }
    state enter_while(frame: &mut Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> ExecutionOutcome {
        let result: ExecutionOutcome = enter_block(frame, frame.pc, body_end, body_end, true, predicate); result
    }
    state if_branch(input: &[u8; 1024], frame: &mut Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> ExecutionOutcome {
        let otherwise: ElseBranch = else_branch(input, body_end, parent_end);
        transition otherwise.outcome == ExecutionOutcome::Success { true -> choose(frame,opcode,body_end,parent_end,predicate,otherwise,condition) _ -> (otherwise.outcome) }
    }
    state choose(frame: &mut Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,otherwise:ElseBranch,condition:u64) -> ExecutionOutcome {
        transition { condition != 0 -> then(frame,opcode,body_end,parent_end,predicate,otherwise,condition)
            otherwise.present -> otherwise(frame, otherwise,condition)
            _ -> skip(frame, body_end) }
    }
    state then(frame: &mut Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,otherwise:ElseBranch,condition:u64) -> ExecutionOutcome {
        let result: ExecutionOutcome = enter_block(frame, frame.pc, body_end, otherwise.end, false, 0); result
    }
    state otherwise(frame: &mut Frame, otherwise: ElseBranch, condition:u64) -> ExecutionOutcome {
        let result: ExecutionOutcome = enter_block(frame, otherwise.start, otherwise.end, otherwise.end, false, 0); result
    }
    state skip(frame: &mut Frame, next: u64) -> ExecutionOutcome { frame.pc = next; ExecutionOutcome::Success }
}
