// ObjectType/SizeOf operand-role integration over canonical object query helpers.
// ACPI 6.6 19.6.97 and 20.2.5.4; pinned acpi mod.rs ObjectType dispatch.
module object_type_execution;
use aml::model::ObjectStore;
use aml::model::Namespace;
use aml::model::Outcome;
use aml::model::Read;
use aml::model::Path;
use aml::model::PathResult;
use aml::model::Lookup;
use aml::model::Entry;
use aml::model::LevelKind;
use aml::bytes::opcode;
use aml::names::lead_char;
use aml::names::namestring;
use aml::names::resolve;
use aml::names::parent;
use aml::namespace::locate;
use aml::object_queries::QueryResult;
use aml::object_queries::object_type;
use aml::object_queries::size_of;
use generic_values::bytes_outcome;
use execution_model::ExecutionOutcome;
use execution_model::Binding;
use execution_model::Frame;
use execution_names::decode_outcome;

pub data ObjectTypeResult [copy] {outcome:ExecutionOutcome;number:u64;next:u64;}
// Metadata inspection is read-only. Cursor and operand publication belong to
// decode_execution and occur only after this complete descriptor succeeds.
pub machine inspect_object_type(input:&[u8;1024],store:&ObjectStore,frame:&Frame,at:u64)->ObjectTypeResult {
 let result:ObjectTypeResult=inspect_metadata(input,store,frame,at,false);result
}
pub machine inspect_size_of(input:&[u8;1024],store:&ObjectStore,frame:&Frame,at:u64)->ObjectTypeResult {
 let result:ObjectTypeResult=inspect_metadata(input,store,frame,at,true);result
}
// Both operations admit the same bounded metadata syntax. SizeOf never obtains
// an ordinary TermArg value to discover the size of a Method or FieldUnit.
machine inspect_metadata(input:&[u8;1024],store:&ObjectStore,frame:&Frame,at:u64,sizing:bool)->ObjectTypeResult {
 let token:Read=opcode(input,frame.end,at);
 let outcome:ExecutionOutcome=decode_outcome(token.outcome);
 transition outcome==ExecutionOutcome::Success {true -> token(input,store,frame,at,token,sizing) _ -> (ObjectTypeResult {outcome:outcome})}
 state token(input:&[u8;1024],store:&ObjectStore,frame:&Frame,at:u64,token:Read,sizing:bool)->ObjectTypeResult {
  let code:u64=token.value;
  let named:bool=lead_char(code) || code==0x5c || code==0x5e || code==0x2e || code==0x2f;
  transition {
   code>=0x60 && code<=0x67 -> local(input,store,frame,code-0x60,token.next,sizing)
   code>=0x68 && code<=0x6e -> argument(input,store,frame,code-0x68,token.next,sizing)
   code==0x5b31 -> scalar(16,token.next,sizing)
   named -> named(input,store,frame,at,sizing)
   code==0 -> (ObjectTypeResult {outcome:ExecutionOutcome::InvalidTarget})
   _ -> (ObjectTypeResult {outcome:ExecutionOutcome::UnsupportedOpcode})
  }
 }
 state local(input:&[u8;1024],store:&ObjectStore,frame:&Frame,index:u64,next:u64,sizing:bool)->ObjectTypeResult {
  transition index<8 {true -> binding(input,store,frame,frame.locals[index],next,sizing) _ -> (ObjectTypeResult {outcome:ExecutionOutcome::InvalidTarget})}
 }
 state argument(input:&[u8;1024],store:&ObjectStore,frame:&Frame,index:u64,next:u64,sizing:bool)->ObjectTypeResult {
  transition index<7 {true -> binding(input,store,frame,frame.arguments[index],next,sizing) _ -> (ObjectTypeResult {outcome:ExecutionOutcome::InvalidTarget})}
 }
 state binding(input:&[u8;1024],store:&ObjectStore,frame:&Frame,value:Binding,next:u64,sizing:bool)->ObjectTypeResult {let result:ObjectTypeResult=ote_binding(input,store,frame,value,next,sizing);result}
 state named(input:&[u8;1024],store:&ObjectStore,frame:&Frame,at:u64,sizing:bool)->ObjectTypeResult {
  let name:PathResult=namestring(input,frame.end,at);
  let outcome:ExecutionOutcome=decode_outcome(name.outcome);
  transition outcome==ExecutionOutcome::Success {true -> lookup(input,store,frame,name,sizing) _ -> (ObjectTypeResult {outcome:outcome})}
 }
 state lookup(input:&[u8;1024],store:&ObjectStore,frame:&Frame,name:PathResult,sizing:bool)->ObjectTypeResult {
  let found:Lookup=ote_lookup(&store.space,name.value,frame.scope);
  let outcome:ExecutionOutcome=ote_resolution_outcome(found.outcome);
  transition outcome==ExecutionOutcome::Success {true -> selected_entry(input,store,frame,found.index,name.next,sizing) _ -> (ObjectTypeResult {outcome:outcome})}
 }
 state selected_entry(input:&[u8;1024],store:&ObjectStore,frame:&Frame,index:u64,next:u64,sizing:bool)->ObjectTypeResult {
  let count:u64=store.space.count;
  transition count<=32 && index<count && index<32 {true -> selected(input,store,frame,store.space.entries[index],next,sizing) _ -> (ObjectTypeResult {outcome:ExecutionOutcome::InvalidState})}
 }
 state selected(input:&[u8;1024],store:&ObjectStore,frame:&Frame,entry:Entry,next:u64,sizing:bool)->ObjectTypeResult {
  transition {entry.has_object -> object(input,store,frame,entry.object,next,sizing)
   entry.has_level && entry.level==LevelKind::Scope -> scalar(0,next,sizing)
   _ -> (ObjectTypeResult {outcome:ExecutionOutcome::InvalidState})}
 }
 state scalar(number:u64,next:u64,sizing:bool)->ObjectTypeResult {let result:ObjectTypeResult=ote_scalar(number,next,sizing);result}
 state object(input:&[u8;1024],store:&ObjectStore,frame:&Frame,id:u64,next:u64,sizing:bool)->ObjectTypeResult {let result:ObjectTypeResult=ote_object(input,store,frame,id,next,sizing);result}
}
// Execution carriers have no canonical object slot. SizeOf rejects these kinds;
// object-backed values use the canonical query without an extra unwrap budget.
machine ote_binding(input:&[u8;1024],store:&ObjectStore,frame:&Frame,value:Binding,next:u64,sizing:bool)->ObjectTypeResult {
 transition value {
  Binding::Uninitialized -> scalar(0,next,sizing)
  Binding::Integer {number} -> scalar(1,next,sizing)
  Binding::Shared {shared_id} -> object(input,store,frame,shared_id,next,sizing)
  Binding::Cell {cell_id} -> object(input,store,frame,cell_id,next,sizing)
 }
 state scalar(number:u64,next:u64,sizing:bool)->ObjectTypeResult {let result:ObjectTypeResult=ote_scalar(number,next,sizing);result}
 state object(input:&[u8;1024],store:&ObjectStore,frame:&Frame,id:u64,next:u64,sizing:bool)->ObjectTypeResult {let result:ObjectTypeResult=ote_object(input,store,frame,id,next,sizing);result}
}
machine ote_scalar(number:u64,next:u64,sizing:bool)->ObjectTypeResult {
 transition sizing {true -> (ObjectTypeResult {outcome:ExecutionOutcome::UnsupportedValue}) _ -> (ObjectTypeResult {number:number,next:next})}
}
machine ote_object(input:&[u8;1024],store:&ObjectStore,frame:&Frame,id:u64,next:u64,sizing:bool)->ObjectTypeResult {
 transition sizing {true -> size(input,store,frame,id,next) _ -> type(store,id,next)}
 state type(store:&ObjectStore,id:u64,next:u64)->ObjectTypeResult {let found:QueryResult=object_type(&store.space,id,64);let result:ObjectTypeResult=ote_result(found,next);result}
 state size(input:&[u8;1024],store:&ObjectStore,frame:&Frame,id:u64,next:u64)->ObjectTypeResult {let found:QueryResult=size_of(input,frame.source_length,frame.body.unit,store,id,64);let result:ObjectTypeResult=ote_result(found,next);result}
}
machine ote_result(found:QueryResult,next:u64)->ObjectTypeResult {
 transition found {
  QueryResult::Value {object,number} -> (ObjectTypeResult {number:number,next:next})
  QueryResult::ResolutionFailure {resolution_error} -> failure(resolution_error)
  QueryResult::UnsupportedValue -> (ObjectTypeResult {outcome:ExecutionOutcome::UnsupportedValue})
  QueryResult::InvalidStorage {storage_error} -> storage(storage_error)
 }
 state failure(reason:Outcome)->ObjectTypeResult {let outcome:ExecutionOutcome=ote_resolution_outcome(reason);ObjectTypeResult {outcome:outcome}}
 state storage(reason:aml::byte_storage::ByteOutcome)->ObjectTypeResult {let outcome:ExecutionOutcome=bytes_outcome(reason);ObjectTypeResult {outcome:outcome}}
}
// Running method scopes need not be namespace levels. Search each canonical
// resolved path with locate so a nearer typeless scope shadows outer objects.
machine ote_lookup(space:&Namespace,name:Path,scope:Path)->Lookup {
 transition !name.absolute && name.parents==0 && name.count==1 {
  true -> ancestors(space,name,scope)
  _ -> exact(space,name,scope)
 }
 state ancestors(space:&Namespace,name:Path,scope:Path)->Lookup {let result:Lookup=ote_lookup_scan(space,name,scope,0,17);result}
 state exact(space:&Namespace,name:Path,scope:Path)->Lookup {let result:Lookup=ote_lookup_once(space,name,scope);result}
}
machine ote_lookup_scan(space:&Namespace,name:Path,scope:Path,index:u64,limit:u64)
terminates by(index,limit)->Nat::BoundedDistance;
->Lookup {
 let found:Lookup=ote_lookup_once(space,name,scope);
 let upper:PathResult=parent(scope);
 transition {found.outcome!=Outcome::MissingLevel || scope.count==0 -> (found)
  upper.outcome!=Outcome::Success -> (Lookup {outcome:Outcome::WorkLimit})
  index<limit -> ote_lookup_scan(space,name,upper.value,index+1,limit)
  _ -> (Lookup {outcome:Outcome::WorkLimit})}
}
machine ote_lookup_once(space:&Namespace,name:Path,scope:Path)->Lookup {
 let path:PathResult=resolve(name,scope);
 transition path.outcome==Outcome::Success {true -> at_path(space,path.value) _ -> (Lookup {outcome:path.outcome})}
 state at_path(space:&Namespace,path:Path)->Lookup {
  let copied:Namespace=Namespace {count:space.count,object_count:space.object_count,entries:space.entries,objects:space.objects};
  let found:Lookup=locate(copied,path);found
 }
}
machine ote_resolution_outcome(reason:Outcome)->ExecutionOutcome {
 transition reason {
  Outcome::Success -> (ExecutionOutcome::Success)
  Outcome::MissingObject -> (ExecutionOutcome::MissingObject)
  Outcome::MissingLevel -> (ExecutionOutcome::MissingObject)
  Outcome::ReferenceCycle -> (ExecutionOutcome::ReferenceCycle)
  Outcome::WorkLimit -> (ExecutionOutcome::WorkLimit)
  Outcome::Capacity -> (ExecutionOutcome::Capacity)
  Outcome::InvalidState -> (ExecutionOutcome::InvalidState)
  _ -> (ExecutionOutcome::BadEncoding)
 }
}
