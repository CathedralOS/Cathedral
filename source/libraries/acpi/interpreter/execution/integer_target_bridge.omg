module integer_target_bridge;
use aml::model::ObjectStore;
use execution_model::ExecutionOutcome;
use execution_model::Frame;
use execution_model::Target;
use execution_model::Operand;
use execution_model::BindingResult;
use generic_target_model::TargetSelection;
use generic_target_model::TargetAction;
use generic_targets::select_target;
use generic_targets::publish_target;
use generic_target_values::classify_target;
use integer_target_values::apply_integer_action;
use integer_helpers::integers::normalize;
pub machine write_integer_target(input:&[u8;1024],store:&mut ObjectStore,frame:&mut Frame,target:Target,number:u64,copy:bool)->ExecutionOutcome {
 let normalized:u64=normalize(frame.size,number);let length:u64=frame.source_length;let unit:u64=frame.body.unit;
 let selection:TargetSelection=select_target(frame,target);
 let action:TargetAction=classify_target(store,selection,Operand::Integer {number:normalized},copy);
 let result:BindingResult=apply_integer_action(input,length,unit,store,action,normalized);
 let outcome:ExecutionOutcome=publish_target(frame,selection,result);outcome
}
