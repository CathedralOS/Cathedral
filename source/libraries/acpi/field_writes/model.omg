module model;
use access::model::Error;
use access::model::LockRequirement;
pub data WriteError [copy] {case Geometry(cause:Error);case PayloadLength;case CountMismatch;case Chunk(index:u64,cause:Error);}
// Region-relative numeric recipe only; no permission, store, or observation.
pub data NativeWrite [copy] {offset:u64;width:u64;value:u64;}
pub data WriteResult [copy] {
 case Failure(error:WriteError);
 case Writes(count:u64,records:[NativeWrite;257],lock:LockRequirement);
}
