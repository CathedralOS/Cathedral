// Original Cathedral normal-Field write pipeline over canonical licensed kernels.
// Synthetic requests only; no live provider, grant, lock or mapping authority.
module field_writes;
use program::Program;
use program::admit_result;
use aml::model::Value;
use aml::model::FieldBinding;
use aml::model::Path;
use aml::model::ReferenceState;
use aml::model::Outcome;
use aml::object_references::unwrap_transparent;
use aml::field_model::DeclarationKind;
use aml::field_model::Declaration;
use aml::field_model::Field;
use aml::result_graph::limits_valid;
use field_access::geometry;
use field_access::model::Plan;
use field_access::model::PlanResult;
use field_access::model::LockRequirement;
use field_access::model::Error;
use field_sources::sequence;
use field_sources::model::PayloadResult;
use aml::object_conversions::ConversionFailure;
use write_values::transfer;
use write_values::transfer_model::WriteTransfer;
use write_values::transfer_model::TransferProgress;
use write_values::transfer_model::TransferFailure;
use write_values::transfer_model::Request;
use write_values::transfer_model::RequestKind;
use write_values::transfer_model::Acceptance;
use write_values::transfer_model::ProviderFailure;
use execution::runtime_model::Runtime;
use execution::runtime_model::RuntimeStart;
use execution::execution_model::ExecutionOutcome;
use execution::execution_model::DeferredWrite;
use execution::execution_model::Operand;
use execution::engine::ExecutionResult;
use execution::engine::start_write_runtime;
use execution::engine::advance_write_runtime;
use execution::engine::pending_write;
use execution::engine::complete_retired_write;
use execution::engine::write_runtime_result;
use execution::generic_values::normalized_operand;
use execution::generic_values::object_outcome;
use execution::named_store::conversion_outcome;
use integer_helpers::integers::IntegerSize;

pub data State [copy] {case Failed;case Running;case AwaitingRequest;case Finished;}
pub data Fault [copy] {
 case InvalidState;case Execution(outcome:ExecutionOutcome);case Geometry(cause:Error);
 case UnsupportedSpace;case UnmetLock;case BaseAlignment;case AddressOverflow;
 case Transfer(cause:TransferFailure);case Source(cause:ConversionFailure);
}
// All inner request fields and outer identity fields participate in matching.
pub data NativeRequest [copy] {
 session:u64;serial:u64;unit:u64;field:u64;region:u64;space:u8;
 base:u64;payload:u64;request:Request;
}
pub data Completion [copy] {
 case Failure(request:NativeRequest,cause:ProviderFailure);
 case Word(request:NativeRequest,value:u64);
 case Written(request:NativeRequest);
}
pub data WriteField [copy] {object:u64;region:u64;declaration:Declaration;field:Field;}
pub data Transfer [copy] {
 definition:WriteField;region:u64;base:u64;region_bytes:u64;size:IntegerSize;
 source:Operand;ordinal:u64;total:u64;core:WriteTransfer;request:NativeRequest;
}
pub data Session {
 state:State;outcome:ExecutionOutcome;fault:Fault;program:Program;runtime:Runtime;
 correlation:u64;fuel_limit:u64;issued:u64;accepted:u64;reads:u64;writes:u64;
 payloads:u64;incoming:Operand;transfer:Transfer;
 result_objects:u64;result_bytes:u64;result:ExecutionResult;
}
pub data Progress [copy] {
 case Failure(outcome:ExecutionOutcome);case Paused;
 case Pending(request:NativeRequest);case Finished(result:ExecutionResult);
}
pub machine begin(program:Program,path:Path,arguments:&[Value;7],count:u64,size:IntegerSize,fuel:u64,correlation:u64)->Session {
 let session:Session=begin_limited(program,path,arguments,count,size,fuel,correlation,64,16384);session
}
// Quota bounds are admitted before argument allocation or any method turn.
pub machine begin_limited(program:Program,path:Path,arguments:&[Value;7],count:u64,size:IntegerSize,fuel:u64,correlation:u64,result_objects:u64,result_bytes:u64)->Session {
 let valid:bool=limits_valid(result_objects,result_bytes);
 transition {
  !program.loaded -> (Session {program:program,outcome:ExecutionOutcome::InvalidState,correlation:correlation})
  program.length>1024 || !valid || fuel>1024 -> (Session {program:program,outcome:ExecutionOutcome::Capacity,fault:Fault::Execution {outcome:ExecutionOutcome::Capacity},correlation:correlation})
  _ -> start(program,path,arguments,count,size,fuel,correlation,result_objects,result_bytes)
 }
 state start(program:Program,path:Path,arguments:&[Value;7],count:u64,size:IntegerSize,fuel:u64,correlation:u64,result_objects:u64,result_bytes:u64)->Session {
  let mut session:Session=Session {program:program,correlation:correlation,fuel_limit:fuel,result_objects:result_objects,result_bytes:result_bytes};
  let started:RuntimeStart=start_write_runtime(&session.program.source,session.program.length,session.program.unit,&mut session.program.store,&session.program.definitions.entries,path,arguments,count,size);
  transition started {RuntimeStart::Ready {runtime} -> ready(session,runtime) RuntimeStart::Failure {outcome} -> rejected(session,outcome)}
 }
 state ready(session:Session,runtime:Runtime)->Session {let mut out:Session=session;out.runtime=runtime;out.state=State::Running;out}
 state rejected(session:Session,outcome:ExecutionOutcome)->Session {let mut out:Session=session;out.outcome=outcome;out.fault=Fault::Execution {outcome:outcome};out}
}
pub machine progress(session:&Session)->Progress {
 transition session.state {
  State::Running -> (Progress::Paused)
  State::AwaitingRequest -> (Progress::Pending {request:session.transfer.request})
  State::Failed -> failed(session.outcome)
  State::Finished -> result(session)
 }
 state failed(outcome:ExecutionOutcome)->Progress {transition outcome==ExecutionOutcome::Success {true -> (Progress::Failure {outcome:ExecutionOutcome::InvalidState}) _ -> (Progress::Failure {outcome:outcome})}}
 state result(session:&Session)->Progress {Progress::Finished {result:session.result}}
}
// A quantum bounds local scheduling turns. Only advance_write_runtime charges
// AML fuel; pending continuation admission and provider completions do not.
// Conservative session bound:1024 AML turns *2 targets *2048 payloads *514
// native requests =2155872256. Each API completion handles at most one request.
pub machine advance(session:&mut Session,budget:u64)->Progress {
 transition budget<=1024 {true -> run(session,budget) _ -> (Progress::Failure {outcome:ExecutionOutcome::Capacity})}
 state run(session:&mut Session,budget:u64)->Progress {
  let outcome:ExecutionOutcome=drive(session,0,budget);let result:Progress=progress(session);result
 }
}
machine drive(session:&mut Session,index:u64,limit:u64)
terminates by(index,limit)->Nat::BoundedDistance;
->ExecutionOutcome {
 let outcome:ExecutionOutcome=turn(session,index,limit);
 transition {session.state!=State::Running -> (outcome)
  index<limit -> drive(session,index+1,limit) _ -> (outcome)}
}
machine turn(session:&mut Session,index:u64,limit:u64)->ExecutionOutcome {
 transition index<limit && session.state==State::Running {true -> pending(session) _ -> (session.outcome)}
 state pending(session:&mut Session)->ExecutionOutcome {
  let deferred:DeferredWrite=pending_write(&session.runtime);
  transition deferred {
   DeferredWrite::Field {object,source,result,stored,has_second,second_target,second_value} -> prepare_write(session,object,source)
   _ -> fuel(session)
  }
 }
 state prepare_write(session:&mut Session,object:u64,source:Operand)->ExecutionOutcome {
  session.incoming=source;let outcome:ExecutionOutcome=prepare(session,object);outcome
 }
 state fuel(session:&mut Session)->ExecutionOutcome {
  transition session.fuel_limit<=1024 && session.runtime.steps<session.fuel_limit {true -> execute(session) _ -> failed(session,ExecutionOutcome::WorkLimit)}
 }
 state execute(session:&mut Session)->ExecutionOutcome {
  let outcome:ExecutionOutcome=advance_write_runtime(&session.program.source,&mut session.program.store,&session.program.definitions.entries,&mut session.runtime);
  transition outcome==ExecutionOutcome::Success {true -> inspect(session) _ -> failed(session,outcome)}
 }
 state failed(session:&mut Session,outcome:ExecutionOutcome)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,outcome,Fault::Execution {outcome:outcome});result}
 state inspect(session:&mut Session)->ExecutionOutcome {
  transition session.runtime.finished {true -> finished(session) _ -> pending_after_turn(session)}
 }
 state pending_after_turn(session:&mut Session)->ExecutionOutcome {
  let deferred:DeferredWrite=pending_write(&session.runtime);
  transition deferred {
   DeferredWrite::Field {object,source,result,stored,has_second,second_target,second_value} -> prepare_write(session,object,source)
   _ -> (ExecutionOutcome::Success)
  }
 }
 state finished(session:&mut Session)->ExecutionOutcome {
  let raw:ExecutionResult=write_runtime_result(&session.program.store,&session.runtime);
  let result:ExecutionResult=admit_result(&session.program,raw,session.result_objects,session.result_bytes);
  session.result=result;
  transition result.outcome==ExecutionOutcome::Success {true -> published(session) _ -> failed(session,result.outcome)}
 }
 state published(session:&mut Session)->ExecutionOutcome {session.state=State::Finished;ExecutionOutcome::Success}
}
machine prepare(session:&mut Session,object:u64)->ExecutionOutcome {
 let count:u64=session.program.store.space.object_count;
 transition count<=64 && object<count && object<64 {true -> definition(session,object) _ -> invalid(session)}
 state definition(session:&mut Session,object:u64)->ExecutionOutcome {
  transition session.program.store.space.objects[object].value {
   Value::FieldUnit {binding,declaration,field} -> kind(session,object,binding,declaration,field)
   _ -> invalid(session)
  }
 }
 state kind(session:&mut Session,object:u64,binding:FieldBinding,declaration:Declaration,field:Field)->ExecutionOutcome {
  transition binding {
   FieldBinding::Region {region_object} -> normal_binding(session,object,region_object,declaration,field)
   FieldBinding::Bank {region_object,selector_object} -> bank_binding(session,declaration.kind)
   FieldBinding::Index {index_object,data_object} -> index_binding(session,declaration.kind)
  }
 }
 state normal_binding(session:&mut Session,object:u64,region:u64,declaration:Declaration,field:Field)->ExecutionOutcome {
  transition declaration.kind==DeclarationKind::Field {true -> source(session,WriteField {object:object,region:region,declaration:declaration,field:field}) _ -> invalid(session)}
 }
 state bank_binding(session:&mut Session,kind:DeclarationKind)->ExecutionOutcome {
  transition kind==DeclarationKind::Bank {true -> geometry_failed(session,Error::UnsupportedKind) _ -> invalid(session)}
 }
 state index_binding(session:&mut Session,kind:DeclarationKind)->ExecutionOutcome {
  transition kind==DeclarationKind::Index {true -> geometry_failed(session,Error::UnsupportedKind) _ -> invalid(session)}
 }
 state source(session:&mut Session,field:WriteField)->ExecutionOutcome {
  let unit:u64=session.program.unit;let length:u64=session.program.length;
  transition field.declaration.source.unit==unit && field.field.source.unit==unit && field.declaration.source.start<=field.field.source.start && field.field.source.start<=field.field.source.end && field.field.source.end<=field.declaration.source.end && field.declaration.source.end<=length {
   true -> region(session,field,field.region) _ -> invalid(session)
  }
 }
 state region(session:&mut Session,field:WriteField,object:u64)->ExecutionOutcome {
  let count:u64=session.program.store.space.object_count;
  transition count<=64 && object<count && object<64 {true -> region_value(session,field,object) _ -> invalid(session)}
 }
 state region_value(session:&mut Session,field:WriteField,object:u64)->ExecutionOutcome {
  transition session.program.store.space.objects[object].value {
   Value::OperationRegion {space,base,length,scope} -> profile(session,field,object,space,base,length)
   _ -> invalid(session)
  }
 }
 state profile(session:&mut Session,field:WriteField,region:u64,space:u8,base:u64,length:u64)->ExecutionOutcome {
  transition space==0 {true -> frame(session,field,region,base,length) _ -> unsupported(session)}
 }
 state frame(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64)->ExecutionOutcome {
  let count:u64=session.runtime.count;
  transition count>0 && count<=4 {true -> size(session,field,region,base,length,count-1) _ -> invalid(session)}
 }
 state size(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64,index:u64)->ExecutionOutcome {
  transition index<4 {true -> geometry(session,field,region,base,length,session.runtime.frames[index].size) _ -> invalid(session)}
 }
 state geometry(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64,size:IntegerSize)->ExecutionOutcome {
  let planned:PlanResult=geometry::plan(field.declaration.kind,&field.field,length,size);
  transition planned {PlanResult::Ready {plan} -> lock(session,field,region,base,length,size,plan) PlanResult::Failure {error} -> geometry_failed(session,error)}
 }
 state lock(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64,size:IntegerSize,plan:Plan)->ExecutionOutcome {
  transition plan.lock==LockRequirement::NotRequested {true -> width(session,field,region,base,length,size,plan) _ -> locked(session)}
 }
 state width(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64,size:IntegerSize,plan:Plan)->ExecutionOutcome {
  transition plan.width==1 || plan.width==2 || plan.width==4 || plan.width==8 {true -> alignment(session,field,region,base,length,size,plan) _ -> invalid(session)}
 }
 state alignment(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64,size:IntegerSize,plan:Plan)->ExecutionOutcome {
  transition base%plan.width==0 {true -> address(session,field,region,base,length,size,plan) _ -> misaligned(session)}
 }
 state address(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64,size:IntegerSize,plan:Plan)->ExecutionOutcome {
  transition plan.start<=plan.end && base<=18446744073709551615-plan.end {true -> stage(session,field,region,base,length,size,plan) _ -> overflow(session)}
 }
 state stage(session:&mut Session,field:WriteField,region:u64,base:u64,length:u64,size:IntegerSize,plan:Plan)->ExecutionOutcome {
  session.transfer=Transfer {definition:field,region:region,base:base,region_bytes:length,size:size,source:session.incoming};
  let result:ExecutionOutcome=source_identity(session);result
 }
 state invalid(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::InvalidState,Fault::InvalidState);result}
 state geometry_failed(session:&mut Session,error:Error)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::UnresolvedRegion,Fault::Geometry {cause:error});result}
 state unsupported(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::UnresolvedRegion,Fault::UnsupportedSpace);result}
 state locked(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::UnresolvedSynchronization,Fault::UnmetLock);result}
 state misaligned(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::UnresolvedRegion,Fault::BaseAlignment);result}
 state overflow(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::Overflow,Fault::AddressOverflow);result}
 state exhausted(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::Capacity,Fault::Execution {outcome:ExecutionOutcome::Capacity});result}
}

machine source_identity(session:&mut Session)->ExecutionOutcome {
 transition session.transfer.source {
  Operand::Uninitialized -> failed(session,ExecutionOutcome::Uninitialized)
  Operand::Integer {number} -> payload(session)
  Operand::Object {object_id} -> object(session,object_id)
 }
 state object(session:&mut Session,id:u64)->ExecutionOutcome {
  let resolved:ReferenceState=unwrap_transparent(&session.program.store.space,id,64);
  let outcome:ExecutionOutcome=object_outcome(resolved.outcome);
  transition outcome==ExecutionOutcome::Success {true -> selected(session,resolved.object) _ -> failed(session,outcome)}
 }
 state selected(session:&mut Session,id:u64)->ExecutionOutcome {
  session.transfer.source=normalized_operand(&session.program.store,session.transfer.size,Operand::Object {object_id:id});
  let outcome:ExecutionOutcome=select_payload(session,0);outcome
 }
 state payload(session:&mut Session)->ExecutionOutcome {let outcome:ExecutionOutcome=select_payload(session,0);outcome}
 state failed(session:&mut Session,outcome:ExecutionOutcome)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,outcome,Fault::Execution {outcome:outcome});result}
}

// The session owns its Program throughout the write sequence. No scheduling
// or public completion changes source bytes between these selections.
machine select_payload(session:&mut Session,ordinal:u64)->ExecutionOutcome {
 transition session.transfer.source {
  Operand::Integer {number} -> integer(session,ordinal,number)
  Operand::Object {object_id} -> object(session,ordinal,object_id)
  _ -> invalid(session)
 }
 state integer(session:&mut Session,ordinal:u64,number:u64)->ExecutionOutcome {
  let selected:PayloadResult=sequence::integer_payload_at(number,session.transfer.size,session.transfer.definition.field.bit_length,ordinal);
  let outcome:ExecutionOutcome=accept_payload(session,ordinal,selected);outcome
 }
 state object(session:&mut Session,ordinal:u64,id:u64)->ExecutionOutcome {
  let selected:PayloadResult=sequence::payload_at(&session.program.source,session.program.length,session.program.unit,&session.program.store,id,session.transfer.size,session.transfer.definition.field.bit_length,ordinal);
  let outcome:ExecutionOutcome=accept_payload(session,ordinal,selected);outcome
 }
 state invalid(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::InvalidState,Fault::InvalidState);result}
}
machine accept_payload(session:&mut Session,expected:u64,selected:PayloadResult)->ExecutionOutcome {
 transition selected {
  PayloadResult::Failure {reason} -> source_failure(session,reason)
  PayloadResult::End {total} -> empty(session,expected,total)
  PayloadResult::Payload {total,ordinal,length,bytes} -> payload(session,expected,total,ordinal,length,bytes)
 }
 state source_failure(session:&mut Session,reason:ConversionFailure)->ExecutionOutcome {
  let outcome:ExecutionOutcome=conversion_outcome(reason);let result:ExecutionOutcome=fail(session,outcome,Fault::Source {cause:reason});result
 }
 state empty(session:&mut Session,expected:u64,total:u64)->ExecutionOutcome {
  transition expected==0 && total==0 {true -> completed(session) _ -> invalid(session)}
 }
 state completed(session:&mut Session)->ExecutionOutcome {
  let result:ExecutionOutcome=complete_target(session);result
 }
 state payload(session:&mut Session,expected:u64,total:u64,ordinal:u64,length:u64,bytes:[u8;256])->ExecutionOutcome {
  transition ordinal==expected && ordinal<total && total<=2048 && length<=256 && (ordinal==0 || total==session.transfer.total) {
   true -> start(session,total,ordinal,length,bytes) _ -> invalid(session)
  }
 }
 state start(session:&mut Session,total:u64,ordinal:u64,length:u64,bytes:[u8;256])->ExecutionOutcome {
  let started:WriteTransfer=transfer::begin(session.transfer.definition.declaration.kind,&session.transfer.definition.field,session.transfer.region_bytes,session.transfer.size,&bytes,length,session.correlation);
  session.transfer.core=started;session.transfer.ordinal=ordinal;session.transfer.total=total;
  let state:TransferProgress=transfer::progress(&session.transfer.core);
  transition state {
   TransferProgress::Pending {request} -> request(session,request)
   TransferProgress::Failure {reason,reads,writes} -> failed(session,reason)
   _ -> invalid(session)
  }
 }
 state request(session:&mut Session,request:Request)->ExecutionOutcome {let result:ExecutionOutcome=issue(session,request);result}
 state failed(session:&mut Session,reason:TransferFailure)->ExecutionOutcome {let result:ExecutionOutcome=transfer_failed(session,reason);result}
 state invalid(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::InvalidState,Fault::InvalidState);result}
}

machine issue(session:&mut Session,request:Request)->ExecutionOutcome {
 transition session.issued<2155872256 {true -> publish(session,request) _ -> invalid(session)}
 state publish(session:&mut Session,request:Request)->ExecutionOutcome {
  let serial:u64=session.issued+1;
  session.transfer.request=NativeRequest {session:session.correlation,serial:serial,unit:session.program.unit,field:session.transfer.definition.object,region:session.transfer.region,base:session.transfer.base,payload:session.transfer.ordinal,request:request};
  session.issued=serial;session.state=State::AwaitingRequest;ExecutionOutcome::Success
 }
 state invalid(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::WorkLimit,Fault::Execution {outcome:ExecutionOutcome::WorkLimit});result}
}
pub machine same_request(a:NativeRequest,b:NativeRequest)->bool {
 let inner:bool=transfer::same_request(a.request,b.request);
 inner && a.session==b.session && a.serial==b.serial && a.unit==b.unit && a.field==b.field && a.region==b.region && a.space==b.space && a.base==b.base && a.payload==b.payload
}
// Acceptance distinguishes an acknowledged provider outcome (possibly terminal
// failure) from a wrong/duplicate response that changes no session state.
pub machine complete(session:&mut Session,completion:Completion)->Acceptance {
 transition session.state==State::AwaitingRequest {true -> kind(session,completion) _ -> (Acceptance::Rejected)}
 state kind(session:&mut Session,completion:Completion)->Acceptance {
  transition completion {
   Completion::Failure {request,cause} -> failure(session,request,cause)
   Completion::Word {request,value} -> word(session,request,value)
   Completion::Written {request} -> written(session,request)
  }
 }
 state failure(session:&mut Session,request:NativeRequest,cause:ProviderFailure)->Acceptance {
  let same:bool=same_request(request,session.transfer.request);
  transition same {true -> accept_failure(session,request.request,cause) _ -> (Acceptance::Rejected)}
 }
 state accept_failure(session:&mut Session,request:Request,cause:ProviderFailure)->Acceptance {
  let accepted:Acceptance=transfer::complete(&mut session.transfer.core,write_values::transfer_model::Completion::Failure {request:request,cause:cause});
  let result:Acceptance=completed(session,accepted,false,false);result
 }
 state word(session:&mut Session,request:NativeRequest,value:u64)->Acceptance {
  let same:bool=same_request(request,session.transfer.request);
  transition same {true -> accept_word(session,request.request,value) _ -> (Acceptance::Rejected)}
 }
 state accept_word(session:&mut Session,request:Request,value:u64)->Acceptance {
  let accepted:Acceptance=transfer::complete(&mut session.transfer.core,write_values::transfer_model::Completion::Word {request:request,value:value});
  let result:Acceptance=completed(session,accepted,true,false);result
 }
 state written(session:&mut Session,request:NativeRequest)->Acceptance {
  let same:bool=same_request(request,session.transfer.request);
  transition same {true -> accept_written(session,request.request) _ -> (Acceptance::Rejected)}
 }
 state accept_written(session:&mut Session,request:Request)->Acceptance {
  let accepted:Acceptance=transfer::complete(&mut session.transfer.core,write_values::transfer_model::Completion::Written {request:request});
  let result:Acceptance=completed(session,accepted,false,true);result
 }
}
machine completed(session:&mut Session,accepted:Acceptance,read:bool,write:bool)->Acceptance {
 transition accepted {Acceptance::Rejected -> (Acceptance::Rejected) _ -> bounds(session,read,write)}
 state bounds(session:&mut Session,read:bool,write:bool)->Acceptance {
  transition session.accepted<2155872256 && session.reads<2155872256 && session.writes<2155872256 {
   true -> count(session,read,write) _ -> invalid(session)
  }
 }
 state count(session:&mut Session,read:bool,write:bool)->Acceptance {
  session.accepted=session.accepted+1;
  transition {read -> read(session) write -> written(session) _ -> advanced(session)}
 }
 state read(session:&mut Session)->Acceptance {session.reads=session.reads+1;let result:ExecutionOutcome=after_completion(session);Acceptance::Accepted}
 state written(session:&mut Session)->Acceptance {session.writes=session.writes+1;let result:ExecutionOutcome=after_completion(session);Acceptance::Accepted}
 state advanced(session:&mut Session)->Acceptance {let result:ExecutionOutcome=after_completion(session);Acceptance::Accepted}
 state invalid(session:&mut Session)->Acceptance {let result:ExecutionOutcome=fail(session,ExecutionOutcome::InvalidState,Fault::InvalidState);Acceptance::Accepted}
}
machine after_completion(session:&mut Session)->ExecutionOutcome {
 let state:TransferProgress=transfer::progress(&session.transfer.core);
 transition state {
  TransferProgress::Pending {request} -> request(session,request)
  TransferProgress::Failure {reason,reads,writes} -> failed(session,reason)
  TransferProgress::Finished {reads,writes} -> next(session)
 }
 state request(session:&mut Session,request:Request)->ExecutionOutcome {let result:ExecutionOutcome=issue(session,request);result}
 state failed(session:&mut Session,reason:TransferFailure)->ExecutionOutcome {let result:ExecutionOutcome=transfer_failed(session,reason);result}
 state next(session:&mut Session)->ExecutionOutcome {
  let ordinal:u64=session.transfer.ordinal;let total:u64=session.transfer.total;
  transition ordinal<total && total<=2048 && ordinal<2048 && session.payloads<4194304 {true -> counted(session,ordinal,total) _ -> invalid(session)}
 }
 state counted(session:&mut Session,ordinal:u64,total:u64)->ExecutionOutcome {
  session.payloads=session.payloads+1;
  transition ordinal+1<total {true -> payload(session,ordinal+1) _ -> finished(session)}
 }
 state payload(session:&mut Session,ordinal:u64)->ExecutionOutcome {let result:ExecutionOutcome=select_payload(session,ordinal);result}
 state finished(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=complete_target(session);result}
 state invalid(session:&mut Session)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::InvalidState,Fault::InvalidState);result}
}

machine complete_target(session:&mut Session)->ExecutionOutcome {
 // Ordinary-Field source-result compatibility policy: return the admitted
 // source after the entire sequence, including the zero-character no-op.
 let outcome:ExecutionOutcome=complete_retired_write(&session.program.source,&mut session.program.store,&mut session.runtime,session.transfer.source);
 transition outcome==ExecutionOutcome::Success {true -> running(session) _ -> failed(session,outcome)}
 state running(session:&mut Session)->ExecutionOutcome {session.state=State::Running;ExecutionOutcome::Success}
 state failed(session:&mut Session,outcome:ExecutionOutcome)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,outcome,Fault::Execution {outcome:outcome});result}
}
machine transfer_failed(session:&mut Session,reason:TransferFailure)->ExecutionOutcome {
 transition reason {TransferFailure::UnmetLock -> lock(session,reason) _ -> region(session,reason)}
 state lock(session:&mut Session,reason:TransferFailure)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::UnresolvedSynchronization,Fault::Transfer {cause:reason});result}
 state region(session:&mut Session,reason:TransferFailure)->ExecutionOutcome {let result:ExecutionOutcome=fail(session,ExecutionOutcome::UnresolvedRegion,Fault::Transfer {cause:reason});result}
}
machine fail(session:&mut Session,outcome:ExecutionOutcome,fault:Fault)->ExecutionOutcome {
 session.outcome=outcome;session.fault=fault;session.state=State::Failed;session.runtime.outcome=outcome;outcome
}
