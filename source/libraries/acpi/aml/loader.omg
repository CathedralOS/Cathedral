  let resolved:PathResult=resolve(raw.value,scope);let mut out:PathResult=resolved;out.next=raw.next;
  transition raw.value.count>0 && resolved.value.count>0 {true -> (out) _ -> (PathResult {outcome:Outcome::InvalidName,offset:raw.next})}
 }
