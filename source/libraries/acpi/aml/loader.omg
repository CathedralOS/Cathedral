machine loader_commit_method(value:&mut LoadState,definitions:&mut MethodDefinitions,inserted:NamespaceResult,observation:MethodDefinition,next:u64)->Outcome {
 transition inserted.outcome==Outcome::Success {true -> index(value,definitions,inserted,observation,next,inserted.object) _ -> rejected(value,inserted.outcome)}
 state index(value:&mut LoadState,definitions:&mut MethodDefinitions,inserted:NamespaceResult,observation:MethodDefinition,next:u64,index:u64)->Outcome {
