machine method(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions,at:u64)->Outcome {
 let package:Envelope=envelope(input,value.end,at);
 transition package.outcome==Outcome::Success {true -> name(input,value,definitions,package) _ -> call_fail_0(value,package.outcome,package.offset)}
 state name(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions,package:Envelope)->Outcome {
