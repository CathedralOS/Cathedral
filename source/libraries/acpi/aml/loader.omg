 state insert_object(value:&mut LoadState,package:Envelope,name:PathResult,object:Value,next:u64,space:Namespace)->Outcome {
  let inserted:NamespaceResult=insert(space,name.value,object);
  transition inserted.outcome==Outcome::Success {true -> call_push_3(value,package,name.value,next,inserted.space) _ -> call_fail_4(value,inserted.outcome,value.at)}
 }

 state call_fail_0(value:&mut LoadState,outcome:Outcome,offset:u64) -> Outcome {let result:Outcome=fail(value,outcome,offset);result}

 state call_fail_1(value:&mut LoadState,outcome:Outcome,offset:u64) -> Outcome {let result:Outcome=fail(value,outcome,offset);result}

 state call_push_2(value:&mut LoadState,package:Envelope,scope:Path,next:u64,space:Namespace) -> Outcome {let result:Outcome=push(value,package,scope,next,space);result}

 state call_push_3(value:&mut LoadState,package:Envelope,scope:Path,next:u64,space:Namespace) -> Outcome {let result:Outcome=push(value,package,scope,next,space);result}

 state call_fail_4(value:&mut LoadState,outcome:Outcome,offset:u64) -> Outcome {let result:Outcome=fail(value,outcome,offset);result}
}
machine push(value:&mut LoadState,package:Envelope,scope:Path,next:u64,space:Namespace)->Outcome {
 let index:u64=value.depth;
 transition index<8 {true -> commit(value,package,scope,next,space,index) _ -> call_fail_0(value,Outcome::Depth,value.at)}
 state commit(value:&mut LoadState,package:Envelope,scope:Path,next:u64,space:Namespace,index:u64)->Outcome {
  let frame:ScopeFrame=ScopeFrame {scope:value.scope,end:value.end};
  value.frames[index]=frame;value.depth=index+1;value.scope=scope;value.at=next;value.end=package.end;value.space=space;Outcome::Success
 }

 state call_fail_0(value:&mut LoadState,outcome:Outcome,offset:u64) -> Outcome {let result:Outcome=fail(value,outcome,offset);result}
}

machine scoped_name(input:&[u8;1024],end:u64,at:u64,scope:Path,kind:LevelKind)->PathResult {
 let raw:PathResult=namestring(input,end,at);
 transition raw.outcome==Outcome::Success {true -> full(raw,scope,kind) _ -> (raw)}
 state full(raw:PathResult,scope:Path,kind:LevelKind)->PathResult {
  let result:PathResult=resolve(raw.value,scope);let mut out:PathResult=result;out.next=raw.next;
  transition kind {LevelKind::Scope -> (out) _ -> nonempty(raw,out)}
 }
 state nonempty(raw:PathResult,out:PathResult)->PathResult {transition raw.value.count>0 {true -> (out) _ -> (PathResult {outcome:Outcome::InvalidName,offset:raw.next})}
 }
}

machine loader_capture(input:&[u8;1024],length:u64,unit:u64,space:Namespace,definitions:&mut MethodDefinitions,term_budget:u64,value_budget:u64)->LoadState {
 transition length<=1024 && term_budget<=1024 && value_budget<=1024 {
  true -> run(input,length,unit,space,definitions,term_budget,value_budget) _ -> (LoadState {outcome:Outcome::Capacity,space:space,done:true})
 }
 state run(input:&[u8;1024],length:u64,unit:u64,space:Namespace,definitions:&mut MethodDefinitions,term_budget:u64,value_budget:u64)->LoadState {
  let scope:Path=root();let mut current:LoadState=LoadState {space:space,end:length,unit:unit,scope:scope,value_budget:value_budget};
  let outcome:Outcome=load_loop(input,&mut current,definitions,0,term_budget);
  transition current.done {true -> result(space,current) _ -> exhausted(space,current)}
 }
 state result(original:Namespace,current:LoadState)->LoadState {
  transition current.outcome==Outcome::Success {true -> (current) _ -> rollback(original,current)}
 }
 state exhausted(original:Namespace,current:LoadState)->LoadState {
  let mut out:LoadState=current;out.space=original;out.outcome=Outcome::WorkLimit;out.offset=current.at;out.done=true;out.external_count=0;out
 }
 state rollback(original:Namespace,current:LoadState)->LoadState {let mut out:LoadState=current;out.space=original;out.external_count=0;out}
}
machine load_loop(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions,index:u64,count:u64)
terminates by (index,count) -> Nat::BoundedDistance;
-> Outcome {
 let next:Outcome=load_tick(input,value,definitions,index,count);
 transition index<count {true -> load_loop(input,value,definitions,index+1,count) _ -> (value.outcome)}
}
machine load_tick(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions,index:u64,count:u64)->Outcome {
 transition index<count {true -> tick(input,value,definitions) _ -> (value.outcome)}
 state tick(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions)->Outcome {let result:Outcome=load_step(input,value,definitions);result}
}

// Compatibility entry: newly captured observations are intentionally discarded.
// Existing namespace-only callers retain the original signature and outcomes.
pub machine load(input:&[u8;1024],length:u64,unit:u64,space:Namespace,term_budget:u64,value_budget:u64)->LoadState {
 let mut definitions:MethodDefinitions;
 let result:LoadState=loader_capture(input,length,unit,space,&mut definitions,term_budget,value_budget);result
}
// Callers retain matching immutable source units. The namespace and sidecar are
// one transaction; errors return both original inputs, never partial captures.
pub machine load_with_definitions(input:&[u8;1024],length:u64,unit:u64,space:Namespace,definitions:MethodDefinitions,term_budget:u64,value_budget:u64)->ObservedLoad {
 let mut candidate:MethodDefinitions=definitions;
 let loaded:LoadState=loader_capture(input,length,unit,space,&mut candidate,term_budget,value_budget);
 transition loaded.outcome==Outcome::Success {true -> (ObservedLoad {load:loaded,definitions:candidate}) _ -> (ObservedLoad {load:loaded,definitions:definitions})}
}
