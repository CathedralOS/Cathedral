machine scope_frame(value:&mut LoadState,index:u64)->ScopeFrame {transition index<8 {true -> (value.frames[index]) _ -> (ScopeFrame {})}}
machine advance(value:&mut LoadState,at:u64)->Outcome {value.at=at;Outcome::Success}
machine declared_name(input:&[u8;1024],end:u64,at:u64,scope:Path)->PathResult {
