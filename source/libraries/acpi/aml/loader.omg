machine fail(value:&mut LoadState,outcome:Outcome,offset:u64)->Outcome {value.outcome=outcome;value.offset=offset;value.done=true;outcome}
// Input is an AML TermList, after independently verified definition-block headers.
// On error, the original namespace is returned. Retain immutable input for spans.



machine load_step(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions)->Outcome {
 transition value.done {true -> (value.outcome) _ -> active(input,value,definitions)}
 state active(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions)->Outcome {
  transition value.at==value.end {true -> leave(value) _ -> token(input,value,definitions)}
 }
 state leave(value:&mut LoadState)->Outcome {
  transition value.depth>0 && value.depth<=8 {true -> pop(value) _ -> complete(value)}
 }
 state pop(value:&mut LoadState)->Outcome {
  let index:u64=value.depth-1;let frame:ScopeFrame=scope_frame(value,index);value.depth=index;value.scope=frame.scope;value.end=frame.end;Outcome::Success
 }
 state complete(value:&mut LoadState)->Outcome {value.done=true;Outcome::Success}
 state token(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions)->Outcome {
  let op:Read=opcode(input,value.end,value.at);
  transition op.outcome==Outcome::Success {true -> dispatch(input,value,definitions,op) _ -> call_fail_0(value,op.outcome,op.offset)}
 }
 state dispatch(input:&[u8;1024],value:&mut LoadState,definitions:&mut MethodDefinitions,op:Read)->Outcome {
  transition op.value {
   0x06 -> call_alias_declaration_1(input,value,op.next)
   0x08 -> call_name_declaration_2(input,value,op.next)
   0x10 -> call_scoped_3(input,value,op,LevelKind::Scope)
   0x14 -> call_method_4(input,value,definitions,op.next)
   0x15 -> call_external_5(input,value,op.next)
   0x5b01 -> call_mutex_6(input,value,op.next)
   0x5b02 -> call_event_7(input,value,op.next)
   0x5b80 -> call_region_8(input,value,op.next)
   0x5b81 -> field(input,value)
   0x5b82 -> call_scoped_9(input,value,op,LevelKind::Device)
   0x5b83 -> call_scoped_10(input,value,op,LevelKind::Processor)
   0x5b84 -> call_scoped_11(input,value,op,LevelKind::PowerResource)
   0x5b85 -> call_scoped_12(input,value,op,LevelKind::ThermalZone)
   0xa3 -> call_advance_13(value,op.next)
   _ -> call_fail_14(value,Outcome::UnsupportedSyntax,value.at)
  }
 }

