 state available(value:&mut LoadState,definitions:&mut MethodDefinitions,inserted:NamespaceResult,observation:MethodDefinition,next:u64,index:u64)->Outcome {
  transition !definitions.entries[index].present {true -> commit(value,definitions,inserted,observation,next,index) _ -> rejected(value,Outcome::InvalidState)}
