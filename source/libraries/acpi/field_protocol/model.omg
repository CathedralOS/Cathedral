// Modified pure decomposition of rust-osdev/acpi do_field_read/do_field_write,
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5; copyright 2018 Isaac Woods.
module model;
use access::model::Plan;
use access::model::Error;
use access::model::LockRequirement;
use fields::field_model::Field;
use fields::field_model::DeclarationKind;
use integers::integers::IntegerSize;
pub data Direction [copy] {case Read;case Write;}
pub data Component [copy] {case Field;case Selector;case Data;}
// Descriptions only: no namespace identity, physical address or access grant.
pub data Register [copy] {kind:DeclarationKind;field:Field;region_bytes:u64;}
pub data Request [copy] {
 kind:DeclarationKind;direction:Direction;size:IntegerSize;
 field:Field;region_bytes:u64;selector:Register;data:Register;bank_value:u64;
}
pub data Action [copy] {
 case None;
 case Select(value:u64);
 case ReadDatum(chunk:u64);
 case WriteDatum(chunk:u64);
}
// Index data actions operate through the independently planned DataName field.
// Its logical result/source is zero-extended or truncated to/from outer.width.
// Bank data actions use the corresponding native outer chunk directly.
pub data Recipe [copy] {
 kind:DeclarationKind;direction:Direction;outer:Plan;selector:Plan;data:Plan;
 bank_value:u64;lock:LockRequirement;count:u64;actions:[Action;1028];
}
pub data ProtocolResult [copy] {
 case Failure(component:Component,error:Error);
 case SelectorOverflow;
 case Ready(recipe:Recipe);
}
