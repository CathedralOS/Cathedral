    transition { step.error != 0 -> (U8Result { error: step.error })
        step.done -> (U8Result { error: 10 })
        index >= (step.header.length as u64) -> (U8Result { error: 10 })
        index > 254 || step.offset > 4094 -> (U8Result { error: 10 }) _ -> read(input, step, index) }
    state read(input: &[u8; 4096], step: MadtStep, index: u64) -> U8Result {
        let offset: u64 = step.offset + index;
        let result: U8Result = read_u8(input, step.next_offset, offset);
        result
    }
}
