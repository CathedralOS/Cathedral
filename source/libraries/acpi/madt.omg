pub machine parse_mps_inti_flags(flags: u16) -> IntiResult {
    let polarity: u16 = flags & 3;
    let trigger_mode: u16 = (flags >> 2) & 3;
    transition { polarity == 2 -> (IntiResult { error: 15 }) trigger_mode == 2 -> (IntiResult { error: 16 })
        _ -> polarity_value(polarity, trigger_mode) }
    state polarity_value(polarity: u16, trigger_mode: u16) -> IntiResult {
        transition polarity { 0 -> trigger_value(Polarity::SameAsBus, trigger_mode)
            1 -> trigger_value(Polarity::ActiveHigh, trigger_mode) _ -> trigger_value(Polarity::ActiveLow, trigger_mode) }
    }
    state trigger_value(polarity: Polarity, trigger_mode: u16) -> IntiResult {
        transition trigger_mode { 0 -> (IntiResult { polarity: polarity, trigger_mode: TriggerMode::SameAsBus })
            1 -> (IntiResult { polarity: polarity, trigger_mode: TriggerMode::Edge })
            _ -> (IntiResult { polarity: polarity, trigger_mode: TriggerMode::Level }) }
    }
}
