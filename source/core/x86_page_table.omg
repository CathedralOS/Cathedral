// source/core/x86_page_table.omg
//
// First source-owned state for Cathedral's fixed bootstrap page tables. This
// records the initial four-level x86-64 address-space profile, models one
// architectural 4-KiB table page as 512 existing 8-byte PTE values, validates
// the only universally safe page starting state, and decomposes canonical
// virtual addresses into their four walk indexes. It also validates ordinary
// numeric physical-frame geometry without establishing hierarchy storage,
// mappings, physical frames, or an installation provider.

use facts::x86_page_table_entry;

pub const X86_PAGE_TABLE_ENTRY_COUNT: u64 = 512;
pub const X86_BOOTSTRAP_LOW_CANONICAL_MAX: u64 = 0x00007FFFFFFFFFFF;
pub const X86_BOOTSTRAP_HIGH_CANONICAL_MIN: u64 = 0xFFFF800000000000;
pub const X86_PAGE_TABLE_INDEX_MASK: u64 = 511;
pub const X86_PAGE_OFFSET_MASK: u64 = 4095;
pub const X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS: u64 = 0x000FFFFFFFFFF000;

// Cathedral's first QEMU/UEFI-x64 bootstrap profile deliberately uses the
// baseline four-level translation regime. LA57 remains a future alternate
// platform profile rather than an inferred property of ordinary x86-64 code.
pub data X86BootstrapAddressSpaceProfile {
    canonical_virtual_address_bits: u8;
    translation_level_count: u8;
    index_bits_per_level: u8;
    entries_per_table: u64;
    page_shift: u8;
    page_bytes: u64;
    level_shifts: [u8; 4];
    la57_enabled: bool;
}

// Pure Cathedral policy data. It selects no virtual layout or page count and
// grants no storage, mapping, placement, TLB, or machine-control authority.
pub machine x86_bootstrap_address_space_profile()
    -> X86BootstrapAddressSpaceProfile
{
    X86BootstrapAddressSpaceProfile {
        canonical_virtual_address_bits: 48,
        translation_level_count: 4,
        index_bits_per_level: 9,
        entries_per_table: X86_PAGE_TABLE_ENTRY_COUNT,
        page_shift: X86_PAGE_SHIFT,
        page_bytes: X86_PAGE_BYTES,
        level_shifts: [39, 30, 21, 12],
        la57_enabled: false,
    }
}

// Ordinary numeric decomposition under the selected four-level profile. The
// original address is retained so later mapping policy can bind these indexes
// to the exact request rather than treating them as a free-standing path.
pub data X86BootstrapVirtualAddressIndices {
    address: u64;
    pml4_index: u64 [0..=511];
    pdpt_index: u64 [0..=511];
    pd_index: u64 [0..=511];
    pt_index: u64 [0..=511];
    page_offset: u64 [0..=4095];
}

pub data X86BootstrapVirtualAddressCheck {
    case Rejected;
    case Canonical(indices: X86BootstrapVirtualAddressIndices);
}

// Reject the noncanonical hole, then derive the exact page-walk indexes and
// byte offset. Success remains ordinary data: it grants no Extent, frame,
// hierarchy, mapping, placement, TLB, or installation authority.
pub machine x86_decompose_bootstrap_virtual_address(
    address: u64
) -> X86BootstrapVirtualAddressCheck {
    // Bind the unsigned high bound to its u64 place before using it in the
    // comparison; no signed intermediate participates in canonicality.
    let low_canonical_max: u64 = X86_BOOTSTRAP_LOW_CANONICAL_MAX;
    let high_canonical_min: u64 = X86_BOOTSTRAP_HIGH_CANONICAL_MIN;
    transition address <= low_canonical_max || address >= high_canonical_min {
        true -> decompose(address)
        _ -> reject()
    }

    state decompose(address: u64) -> X86BootstrapVirtualAddressCheck {
        let pml4_index: u64 [0..=511] =
            (address >> 39) & X86_PAGE_TABLE_INDEX_MASK;
        let pdpt_index: u64 [0..=511] =
            (address >> 30) & X86_PAGE_TABLE_INDEX_MASK;
        let pd_index: u64 [0..=511] =
            (address >> 21) & X86_PAGE_TABLE_INDEX_MASK;
        let pt_index: u64 [0..=511] =
            (address >> 12) & X86_PAGE_TABLE_INDEX_MASK;
        let page_offset: u64 [0..=4095] = address & X86_PAGE_OFFSET_MASK;
        X86BootstrapVirtualAddressCheck::Canonical {
            indices: X86BootstrapVirtualAddressIndices {
                address: address,
                pml4_index: pml4_index,
                pdpt_index: pdpt_index,
                pd_index: pd_index,
                pt_index: pt_index,
                page_offset: page_offset,
            },
        }
    }

    state reject() -> X86BootstrapVirtualAddressCheck {
        X86BootstrapVirtualAddressCheck::Rejected
    }
}

// Ordinary numeric geometry for one possible 4-KiB physical frame base. This
// is intentionally not a frame, mapping claim, or provider receipt. The later
// authority-bearing page-table operation must rebind the same address and PFN
// while holding the exact physical source and mapping authority.
pub data X86BootstrapPhysicalFrameGeometry {
    address: u64;
    frame_number: u64 [0..=1099511627775];
}

pub data X86BootstrapPhysicalFrameGeometryCheck {
    case Rejected;
    case GeometryConsistent(frame: X86BootstrapPhysicalFrameGeometry);
}

// Accept only a 4-KiB-aligned frame base inside the architectural 52-bit
// physical-address envelope, then derive bits 12..51 as the bounded PFN.
pub machine x86_validate_bootstrap_physical_frame_geometry(
    address: u64
) -> X86BootstrapPhysicalFrameGeometryCheck {
    let page_offset: u64 [0..=4095] = address & X86_PAGE_OFFSET_MASK;
    transition page_offset == 0 &&
        address <= X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS {
        true -> derive_frame_number(address)
        _ -> reject_frame_geometry()
    }

    state derive_frame_number(
        address: u64
    ) -> X86BootstrapPhysicalFrameGeometryCheck {
        // The mask makes the result domain explicit; the prior envelope check
        // ensures this cannot silently truncate a higher physical-address bit.
        let frame_number: u64 [0..=1099511627775] =
            (address >> X86_PAGE_SHIFT) & X86_PAGE_FRAME_NUMBER_MAX;
        X86BootstrapPhysicalFrameGeometryCheck::GeometryConsistent {
            frame: X86BootstrapPhysicalFrameGeometry {
                address: address,
                frame_number: frame_number,
            },
        }
    }

    state reject_frame_geometry() -> X86BootstrapPhysicalFrameGeometryCheck {
        X86BootstrapPhysicalFrameGeometryCheck::Rejected
    }
}

// Ordinary candidate data. A future placed-page provider must bind this shape
// to pre-reserved qualified storage; declaring the array grants no Extent,
// capacity, placement, mapping, or installation authority.
pub data X86PageTablePageCandidate {
    entries: [X86PageTableEntry; 512];
}

pub data X86EmptyPageTablePagePolicyCheck {
    case Rejected;
    case ZeroConsistent(candidate: X86PageTablePageCandidate);
}

// Exact zero encoding for the existing PTE schema. `present == false` alone is
// insufficient for this bootstrap baseline: accepting residual software or
// address bits would make zero-initialized storage and a reused dirty page
// indistinguishable at the policy boundary.
machine x86_page_table_entry_is_zero(entry: X86PageTableEntry) -> bool {
    !entry.present &&
    !entry.writable &&
    !entry.user &&
    !entry.write_through &&
    !entry.cache_disable &&
    !entry.accessed &&
    !entry.dirty &&
    !entry.page_size_or_pat &&
    !entry.global &&
    entry.software_low == 0 &&
    entry.frame_number == 0 &&
    entry.software_high == 0 &&
    entry.protection_key == 0 &&
    !entry.no_execute
}

// Validate the whole page as one transaction. A failed slot rejects the page;
// no partially checked candidate escapes.
pub machine x86_validate_empty_page_table_page(
    candidate: X86PageTablePageCandidate
) -> X86EmptyPageTablePagePolicyCheck {
    x86_scan_empty_page_table_page(candidate, X86_PAGE_TABLE_ENTRY_COUNT, true)
}

// The fixed scan always visits indices 0..511 under checked decreasing fuel.
// Accumulating the verdict keeps one bounded control shape and still prevents
// a dirty slot from being forgotten by an early success path.
machine x86_scan_empty_page_table_page(
    candidate: X86PageTablePageCandidate,
    remaining: u64 [1..=512],
    zero_so_far: bool
)
terminates by remaining;
-> X86EmptyPageTablePagePolicyCheck
{
    let index: u64 [0..=511] = X86_PAGE_TABLE_ENTRY_COUNT - remaining;
    let entry: X86PageTableEntry = candidate.entries[index];
    let still_zero: bool = zero_so_far && x86_page_table_entry_is_zero(entry);
    transition remaining > 1 {
        true -> x86_scan_empty_page_table_page(
            candidate,
            remaining - 1,
            still_zero
        )
        _ -> settle_empty_page_table_page(candidate, still_zero)
    }

    state settle_empty_page_table_page(
        candidate: X86PageTablePageCandidate,
        zero: bool
    ) -> X86EmptyPageTablePagePolicyCheck {
        transition zero {
            true -> accept_empty_page_table_page(candidate)
            _ -> reject_empty_page_table_page()
        }
    }

    state accept_empty_page_table_page(
        candidate: X86PageTablePageCandidate
    ) -> X86EmptyPageTablePagePolicyCheck {
        X86EmptyPageTablePagePolicyCheck::ZeroConsistent {
            candidate: candidate,
        }
    }

    state reject_empty_page_table_page() -> X86EmptyPageTablePagePolicyCheck {
        X86EmptyPageTablePagePolicyCheck::Rejected
    }
}
