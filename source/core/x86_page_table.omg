// source/core/x86_page_table.omg
//
// First source-owned state for Cathedral's fixed bootstrap page tables. This
// records the initial four-level x86-64 address-space profile, models one
// architectural 4-KiB table page as 512 existing 8-byte PTE values, validates
// the only universally safe page starting state, and decomposes canonical
// virtual addresses into their four walk indexes. It also validates ordinary
// numeric physical-frame geometry and composes detached address-bound PTE data
// without establishing hierarchy storage, mappings, physical frames, or an
// installation provider.

use facts::x86_page_table_entry;

pub const X86_PAGE_TABLE_ENTRY_COUNT: u64 = 512;
pub const X86_BOOTSTRAP_LOW_CANONICAL_MAX: u64 = 0x00007FFFFFFFFFFF;
pub const X86_BOOTSTRAP_HIGH_CANONICAL_MIN: u64 = 0xFFFF800000000000;
pub const X86_PAGE_TABLE_INDEX_MASK: u64 = 511;
pub const X86_PAGE_OFFSET_MASK: u64 = 4095;
pub const X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS: u64 = 0x000FFFFFFFFFF000;

// Cathedral's first QEMU/UEFI-x64 bootstrap profile deliberately uses the
// baseline four-level translation regime. LA57 remains a future alternate
// platform profile rather than an inferred property of ordinary x86-64 code.
pub data X86BootstrapAddressSpaceProfile {
    canonical_virtual_address_bits: u8;
    translation_level_count: u8;
    index_bits_per_level: u8;
    entries_per_table: u64;
    page_shift: u8;
    page_bytes: u64;
    level_shifts: [u8; 4];
    la57_enabled: bool;
}

// Pure Cathedral policy data. It selects no virtual layout or page count and
// grants no storage, mapping, placement, TLB, or machine-control authority.
pub machine x86_bootstrap_address_space_profile()
    -> X86BootstrapAddressSpaceProfile
{
    X86BootstrapAddressSpaceProfile {
        canonical_virtual_address_bits: 48,
        translation_level_count: 4,
        index_bits_per_level: 9,
        entries_per_table: X86_PAGE_TABLE_ENTRY_COUNT,
        page_shift: X86_PAGE_SHIFT,
        page_bytes: X86_PAGE_BYTES,
        level_shifts: [39, 30, 21, 12],
        la57_enabled: false,
    }
}

// Ordinary numeric decomposition under the selected four-level profile. The
// original address is retained so later mapping policy can bind these indexes
// to the exact request rather than treating them as a free-standing path.
pub data X86BootstrapVirtualAddressIndices {
    address: u64;
    pml4_index: u64 [0..=511];
    pdpt_index: u64 [0..=511];
    pd_index: u64 [0..=511];
    pt_index: u64 [0..=511];
    page_offset: u64 [0..=4095];
}

pub data X86BootstrapVirtualAddressCheck {
    case Rejected;
    case Canonical(indices: X86BootstrapVirtualAddressIndices);
}

// Reject the noncanonical hole, then derive the exact page-walk indexes and
// byte offset. Success remains ordinary data: it grants no Extent, frame,
// hierarchy, mapping, placement, TLB, or installation authority.
pub machine x86_decompose_bootstrap_virtual_address(
    address: u64
) -> X86BootstrapVirtualAddressCheck {
    // Bind the unsigned high bound to its u64 place before using it in the
    // comparison; no signed intermediate participates in canonicality.
    let low_canonical_max: u64 = X86_BOOTSTRAP_LOW_CANONICAL_MAX;
    let high_canonical_min: u64 = X86_BOOTSTRAP_HIGH_CANONICAL_MIN;
    transition address <= low_canonical_max || address >= high_canonical_min {
        true -> decompose(address)
        _ -> reject()
    }

    state decompose(address: u64) -> X86BootstrapVirtualAddressCheck {
        let pml4_index: u64 [0..=511] =
            (address >> 39) & X86_PAGE_TABLE_INDEX_MASK;
        let pdpt_index: u64 [0..=511] =
            (address >> 30) & X86_PAGE_TABLE_INDEX_MASK;
        let pd_index: u64 [0..=511] =
            (address >> 21) & X86_PAGE_TABLE_INDEX_MASK;
        let pt_index: u64 [0..=511] =
            (address >> 12) & X86_PAGE_TABLE_INDEX_MASK;
        let page_offset: u64 [0..=4095] = address & X86_PAGE_OFFSET_MASK;
        X86BootstrapVirtualAddressCheck::Canonical {
            indices: X86BootstrapVirtualAddressIndices {
                address: address,
                pml4_index: pml4_index,
                pdpt_index: pdpt_index,
                pd_index: pd_index,
                pt_index: pt_index,
                page_offset: page_offset,
            },
        }
    }

    state reject() -> X86BootstrapVirtualAddressCheck {
        X86BootstrapVirtualAddressCheck::Rejected
    }
}

// Revalidate an ordinary retained decomposition before a later hierarchy
// consumer trusts its numeric coordinates. This proves only that the candidate
// matches Cathedral's selected canonical-address profile; it grants no table,
// mapping, backing, placement, TLB, or installation authority.
pub machine x86_validate_bootstrap_virtual_address_indices(
    candidate: X86BootstrapVirtualAddressIndices
) -> X86BootstrapVirtualAddressCheck {
    let low_canonical_max: u64 = X86_BOOTSTRAP_LOW_CANONICAL_MAX;
    let high_canonical_min: u64 = X86_BOOTSTRAP_HIGH_CANONICAL_MIN;
    let pml4_index: u64 [0..=511] =
        (candidate.address >> 39) & X86_PAGE_TABLE_INDEX_MASK;
    let pdpt_index: u64 [0..=511] =
        (candidate.address >> 30) & X86_PAGE_TABLE_INDEX_MASK;
    let pd_index: u64 [0..=511] =
        (candidate.address >> 21) & X86_PAGE_TABLE_INDEX_MASK;
    let pt_index: u64 [0..=511] =
        (candidate.address >> 12) & X86_PAGE_TABLE_INDEX_MASK;
    let page_offset: u64 [0..=4095] = candidate.address & X86_PAGE_OFFSET_MASK;
    transition (
        candidate.address <= low_canonical_max ||
        candidate.address >= high_canonical_min
    ) &&
        candidate.pml4_index == pml4_index &&
        candidate.pdpt_index == pdpt_index &&
        candidate.pd_index == pd_index &&
        candidate.pt_index == pt_index &&
        candidate.page_offset == page_offset
    {
        true -> accept_virtual_address_indices(candidate)
        _ -> reject_virtual_address_indices()
    }

    state accept_virtual_address_indices(
        candidate: X86BootstrapVirtualAddressIndices
    ) -> X86BootstrapVirtualAddressCheck {
        X86BootstrapVirtualAddressCheck::Canonical { indices: candidate }
    }

    state reject_virtual_address_indices() -> X86BootstrapVirtualAddressCheck {
        X86BootstrapVirtualAddressCheck::Rejected
    }
}

// Ordinary numeric geometry for one possible 4-KiB physical frame base. This
// is intentionally not a frame, mapping claim, or provider receipt. The later
// authority-bearing page-table operation must rebind the same address and PFN
// while holding the exact physical source and mapping authority.
pub data X86BootstrapPhysicalFrameGeometry {
    address: u64;
    frame_number: u64 [0..=1099511627775];
}

pub data X86BootstrapPhysicalFrameGeometryCheck {
    case Rejected;
    case GeometryConsistent(frame: X86BootstrapPhysicalFrameGeometry);
}

// Accept only a 4-KiB-aligned frame base inside the architectural 52-bit
// physical-address envelope, then derive bits 12..51 as the bounded PFN.
pub machine x86_validate_bootstrap_physical_frame_geometry(
    address: u64
) -> X86BootstrapPhysicalFrameGeometryCheck {
    let page_offset: u64 [0..=4095] = address & X86_PAGE_OFFSET_MASK;
    transition page_offset == 0 &&
        address <= X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS {
        true -> derive_frame_number(address)
        _ -> reject_frame_geometry()
    }

    state derive_frame_number(
        address: u64
    ) -> X86BootstrapPhysicalFrameGeometryCheck {
        // The mask makes the result domain explicit; the prior envelope check
        // ensures this cannot silently truncate a higher physical-address bit.
        let frame_number: u64 [0..=1099511627775] =
            (address >> X86_PAGE_SHIFT) & X86_PAGE_FRAME_NUMBER_MAX;
        X86BootstrapPhysicalFrameGeometryCheck::GeometryConsistent {
            frame: X86BootstrapPhysicalFrameGeometry {
                address: address,
                frame_number: frame_number,
            },
        }
    }

    state reject_frame_geometry() -> X86BootstrapPhysicalFrameGeometryCheck {
        X86BootstrapPhysicalFrameGeometryCheck::Rejected
    }
}

// Every non-address bit of one detached paging entry. Cathedral does not assign
// role semantics here: in particular, `page_size_or_pat` remains the hardware
// fact's role-dependent field, and the caller supplies every policy value.
pub data X86BootstrapPageTableEntryNonAddressFields {
    present: bool;
    writable: bool;
    user: bool;
    write_through: bool;
    cache_disable: bool;
    accessed: bool;
    dirty: bool;
    page_size_or_pat: bool;
    global: bool;
    software_low: u8 [0..=7];
    software_high: u8 [0..=127];
    protection_key: u8 [0..=15];
    no_execute: bool;
}

// Ordinary detached encoding candidate. Retaining the numeric source address
// prevents the derived PFN from becoming a free-standing address claim.
pub data X86BootstrapAddressBoundPageTableEntryCandidate {
    physical_address: u64;
    entry: X86PageTableEntry;
}

pub data X86BootstrapAddressBoundPageTableEntryCheck {
    case Rejected;
    case Composed(candidate: X86BootstrapAddressBoundPageTableEntryCandidate);
}

// Bind bits 12..51 to one aligned address while copying every other PTE field
// explicitly. This establishes numeric consistency only. It does not validate
// a leaf/link role, select page size or hierarchy policy, prove a frame or
// backing exists, establish a mapping, or authorize placement/installation.
pub machine x86_compose_bootstrap_address_bound_page_table_entry(
    physical_address: u64,
    fields: X86BootstrapPageTableEntryNonAddressFields
) -> X86BootstrapAddressBoundPageTableEntryCheck {
    let page_offset: u64 [0..=4095] = physical_address & X86_PAGE_OFFSET_MASK;
    transition page_offset == 0 &&
        physical_address <= X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS {
        true -> compose_address_bound_page_table_entry(physical_address, fields)
        _ -> reject_address_bound_page_table_entry()
    }

    state compose_address_bound_page_table_entry(
        physical_address: u64,
        fields: X86BootstrapPageTableEntryNonAddressFields
    ) -> X86BootstrapAddressBoundPageTableEntryCheck {
        let frame_number: u64 [0..=1099511627775] =
            (physical_address >> X86_PAGE_SHIFT) & X86_PAGE_FRAME_NUMBER_MAX;
        X86BootstrapAddressBoundPageTableEntryCheck::Composed {
            candidate: X86BootstrapAddressBoundPageTableEntryCandidate {
                physical_address: physical_address,
                entry: X86PageTableEntry {
                    present: fields.present,
                    writable: fields.writable,
                    user: fields.user,
                    write_through: fields.write_through,
                    cache_disable: fields.cache_disable,
                    accessed: fields.accessed,
                    dirty: fields.dirty,
                    page_size_or_pat: fields.page_size_or_pat,
                    global: fields.global,
                    software_low: fields.software_low,
                    frame_number: frame_number,
                    software_high: fields.software_high,
                    protection_key: fields.protection_key,
                    no_execute: fields.no_execute,
                },
            },
        }
    }

    state reject_address_bound_page_table_entry()
        -> X86BootstrapAddressBoundPageTableEntryCheck
    {
        X86BootstrapAddressBoundPageTableEntryCheck::Rejected
    }
}

// Revalidate a retained detached candidate before later role-specific policy
// consumes it. The address must still be aligned and inside the selected
// physical envelope, and the entry's PFN must be exactly derived from it. All
// non-address fields remain uninterpreted ordinary data.
pub machine x86_validate_bootstrap_address_bound_page_table_entry(
    candidate: X86BootstrapAddressBoundPageTableEntryCandidate
) -> X86BootstrapAddressBoundPageTableEntryCheck {
    let page_offset: u64 [0..=4095] =
        candidate.physical_address & X86_PAGE_OFFSET_MASK;
    transition page_offset == 0 &&
        candidate.physical_address <= X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS {
        true -> check_address_bound_frame_number(candidate)
        _ -> reject_retained_address_bound_page_table_entry()
    }

    state check_address_bound_frame_number(
        candidate: X86BootstrapAddressBoundPageTableEntryCandidate
    ) -> X86BootstrapAddressBoundPageTableEntryCheck {
        let frame_number: u64 [0..=1099511627775] =
            (candidate.physical_address >> X86_PAGE_SHIFT) &
            X86_PAGE_FRAME_NUMBER_MAX;
        transition candidate.entry.frame_number == frame_number {
            true -> accept_retained_address_bound_page_table_entry(candidate)
            _ -> reject_retained_address_bound_page_table_entry()
        }
    }

    state accept_retained_address_bound_page_table_entry(
        candidate: X86BootstrapAddressBoundPageTableEntryCandidate
    ) -> X86BootstrapAddressBoundPageTableEntryCheck {
        X86BootstrapAddressBoundPageTableEntryCheck::Composed {
            candidate: candidate,
        }
    }

    state reject_retained_address_bound_page_table_entry()
        -> X86BootstrapAddressBoundPageTableEntryCheck
    {
        X86BootstrapAddressBoundPageTableEntryCheck::Rejected
    }
}

// One ordinary numeric step in a retained four-level walk description. The
// table address identifies the possible 4-KiB table page, `index` selects one
// of its 512 entries, and `entry_address` retains the exact byte address at
// which the detached entry was observed. The address-bound entry records the
// numeric target encoded by bits 12..51. None of these values proves that the
// table or target exists, is backed, belongs to Cathedral, or may be read.
pub data X86BootstrapPageTableWalkStep {
    table_address: u64;
    index: u64 [0..=511];
    entry_address: u64;
    entry: X86BootstrapAddressBoundPageTableEntryCandidate;
}

// A complete retained numeric description of one baseline four-level walk.
// Named fields make the level order explicit. The descriptor remains ordinary
// pre-authority data: it is not a mapping, hierarchy, placement, frame, TLB, or
// installation claim, and it assigns no leaf/link semantics to the entry bits.
pub data X86BootstrapFourLevelWalkDescriptor {
    indices: X86BootstrapVirtualAddressIndices;
    pml4: X86BootstrapPageTableWalkStep;
    pdpt: X86BootstrapPageTableWalkStep;
    pd: X86BootstrapPageTableWalkStep;
    pt: X86BootstrapPageTableWalkStep;
}

pub data X86BootstrapFourLevelWalkDescriptorCheck {
    case Rejected;
    case NumericallyConsistent(
        descriptor: X86BootstrapFourLevelWalkDescriptor
    );
}

// Revalidate one numeric step without assigning a paging role to its entry.
// A 4-KiB-aligned table base and a bounded index determine the exact 8-byte
// entry address. The detached entry's target address and PFN must also retain
// the already-selected 52-bit physical geometry.
machine x86_bootstrap_page_table_walk_step_is_consistent(
    step: X86BootstrapPageTableWalkStep,
    expected_index: u64 [0..=511]
) -> bool {
    let table_page_offset: u64 [0..=4095] =
        step.table_address & X86_PAGE_OFFSET_MASK;
    let target_page_offset: u64 [0..=4095] =
        step.entry.physical_address & X86_PAGE_OFFSET_MASK;
    let entry_offset: u64 [0..=4088] = step.index * 8;
    // Alignment makes OR equivalent to addition here while keeping the
    // bounded address composition visibly non-overflowing.
    let expected_entry_address: u64 = step.table_address | entry_offset;
    let expected_target_frame_number: u64 [0..=1099511627775] =
        (step.entry.physical_address >> X86_PAGE_SHIFT) &
        X86_PAGE_FRAME_NUMBER_MAX;
    table_page_offset == 0 &&
    step.table_address <= X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS &&
    step.index == expected_index &&
    step.entry_address == expected_entry_address &&
    target_page_offset == 0 &&
    step.entry.physical_address <=
        X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS &&
    step.entry.entry.frame_number == expected_target_frame_number
}

// Recompute every retained coordinate needed to replay the numeric walk. The
// first three detached targets must name the next retained table page; the PT
// entry's detached target is only checked as aligned address/PFN data. Success
// does not establish that any entry is present, that large pages are disabled,
// that the PT target is backed, or that a hardware translation exists.
pub machine x86_validate_bootstrap_four_level_walk_descriptor(
    candidate: X86BootstrapFourLevelWalkDescriptor
) -> X86BootstrapFourLevelWalkDescriptorCheck {
    let low_canonical_max: u64 = X86_BOOTSTRAP_LOW_CANONICAL_MAX;
    let high_canonical_min: u64 = X86_BOOTSTRAP_HIGH_CANONICAL_MIN;
    let pml4_index: u64 [0..=511] =
        (candidate.indices.address >> 39) & X86_PAGE_TABLE_INDEX_MASK;
    let pdpt_index: u64 [0..=511] =
        (candidate.indices.address >> 30) & X86_PAGE_TABLE_INDEX_MASK;
    let pd_index: u64 [0..=511] =
        (candidate.indices.address >> 21) & X86_PAGE_TABLE_INDEX_MASK;
    let pt_index: u64 [0..=511] =
        (candidate.indices.address >> 12) & X86_PAGE_TABLE_INDEX_MASK;
    let page_offset: u64 [0..=4095] =
        candidate.indices.address & X86_PAGE_OFFSET_MASK;
    let pml4_consistent: bool =
        x86_bootstrap_page_table_walk_step_is_consistent(
            candidate.pml4,
            pml4_index
        );
    let pdpt_consistent: bool =
        x86_bootstrap_page_table_walk_step_is_consistent(
            candidate.pdpt,
            pdpt_index
        );
    let pd_consistent: bool =
        x86_bootstrap_page_table_walk_step_is_consistent(
            candidate.pd,
            pd_index
        );
    let pt_consistent: bool =
        x86_bootstrap_page_table_walk_step_is_consistent(
            candidate.pt,
            pt_index
        );
    transition (
        candidate.indices.address <= low_canonical_max ||
        candidate.indices.address >= high_canonical_min
    ) &&
        candidate.indices.pml4_index == pml4_index &&
        candidate.indices.pdpt_index == pdpt_index &&
        candidate.indices.pd_index == pd_index &&
        candidate.indices.pt_index == pt_index &&
        candidate.indices.page_offset == page_offset &&
        pml4_consistent &&
        pdpt_consistent &&
        pd_consistent &&
        pt_consistent &&
        candidate.pml4.entry.physical_address ==
            candidate.pdpt.table_address &&
        candidate.pdpt.entry.physical_address == candidate.pd.table_address &&
        candidate.pd.entry.physical_address == candidate.pt.table_address
    {
        true -> accept_four_level_walk_descriptor(candidate)
        _ -> reject_four_level_walk_descriptor()
    }

    state accept_four_level_walk_descriptor(
        candidate: X86BootstrapFourLevelWalkDescriptor
    ) -> X86BootstrapFourLevelWalkDescriptorCheck {
        X86BootstrapFourLevelWalkDescriptorCheck::NumericallyConsistent {
            descriptor: candidate,
        }
    }

    state reject_four_level_walk_descriptor()
        -> X86BootstrapFourLevelWalkDescriptorCheck
    {
        X86BootstrapFourLevelWalkDescriptorCheck::Rejected
    }
}

// Ordinary role-policy validation for the selected four-level 4-KiB walk.
// Numeric consistency is replayed first, so the descriptor accepted here is
// still bound to its exact canonical indexes, entry addresses, PFNs, and three
// inter-table links. The upper three entries must be present non-large-page
// links, and the PT entry must be present as the final 4-KiB leaf. Bit 7 on the
// PT entry remains caller-supplied PAT data, and every other permission/cache
// field remains uninterpreted. Success grants no backing, mapping, placement,
// TLB, installation, CR3, or machine-control authority.
pub data X86BootstrapFourLevelWalkRoleCheck {
    case Rejected;
    case RoleConsistent(
        descriptor: X86BootstrapFourLevelWalkDescriptor
    );
}

pub machine x86_validate_bootstrap_four_level_walk_roles(
    candidate: X86BootstrapFourLevelWalkDescriptor
) -> X86BootstrapFourLevelWalkRoleCheck {
    let numeric: X86BootstrapFourLevelWalkDescriptorCheck =
        x86_validate_bootstrap_four_level_walk_descriptor(candidate);
    transition numeric {
        X86BootstrapFourLevelWalkDescriptorCheck::NumericallyConsistent {
            descriptor
        } -> validate_four_level_walk_roles(descriptor)
        _ -> reject_four_level_walk_roles()
    }

    state validate_four_level_walk_roles(
        descriptor: X86BootstrapFourLevelWalkDescriptor
    ) -> X86BootstrapFourLevelWalkRoleCheck {
        transition descriptor.pml4.entry.entry.present &&
            !descriptor.pml4.entry.entry.page_size_or_pat &&
            descriptor.pdpt.entry.entry.present &&
            !descriptor.pdpt.entry.entry.page_size_or_pat &&
            descriptor.pd.entry.entry.present &&
            !descriptor.pd.entry.entry.page_size_or_pat &&
            descriptor.pt.entry.entry.present
        {
            true -> accept_four_level_walk_roles(descriptor)
            _ -> reject_four_level_walk_roles()
        }
    }

    state accept_four_level_walk_roles(
        descriptor: X86BootstrapFourLevelWalkDescriptor
    ) -> X86BootstrapFourLevelWalkRoleCheck {
        X86BootstrapFourLevelWalkRoleCheck::RoleConsistent {
            descriptor: descriptor,
        }
    }

    state reject_four_level_walk_roles()
        -> X86BootstrapFourLevelWalkRoleCheck
    {
        X86BootstrapFourLevelWalkRoleCheck::Rejected
    }
}

// Ordinary numeric endpoints bound to one role-consistent four-level 4-KiB
// walk. The virtual endpoint must be the exact page base retained by the walk,
// and the physical endpoint must be the exact frame base retained by its PT
// entry. This intent data chooses no virtual layout or permission/cache policy
// and grants no Extent, backing, hierarchy-page, mapping, placement, TLB,
// installation, CR3, or machine-control authority.
pub data X86BootstrapFourKilobyteWalkEndpoints {
    virtual_page_address: u64;
    physical_frame_address: u64;
    descriptor: X86BootstrapFourLevelWalkDescriptor;
}

pub data X86BootstrapFourKilobyteWalkEndpointCheck {
    case Rejected;
    case EndpointConsistent(
        candidate: X86BootstrapFourKilobyteWalkEndpoints
    );
}

pub machine x86_validate_bootstrap_four_kilobyte_walk_endpoints(
    candidate: X86BootstrapFourKilobyteWalkEndpoints
) -> X86BootstrapFourKilobyteWalkEndpointCheck {
    let virtual_page_address: u64 = candidate.virtual_page_address;
    let physical_frame_address: u64 = candidate.physical_frame_address;
    let roles: X86BootstrapFourLevelWalkRoleCheck =
        x86_validate_bootstrap_four_level_walk_roles(candidate.descriptor);
    transition roles {
        X86BootstrapFourLevelWalkRoleCheck::RoleConsistent {
            descriptor
        } -> validate_four_kilobyte_walk_endpoints(
            virtual_page_address,
            physical_frame_address,
            descriptor
        )
        _ -> reject_four_kilobyte_walk_endpoints()
    }

    state validate_four_kilobyte_walk_endpoints(
        virtual_page_address: u64,
        physical_frame_address: u64,
        descriptor: X86BootstrapFourLevelWalkDescriptor
    ) -> X86BootstrapFourKilobyteWalkEndpointCheck {
        transition virtual_page_address == descriptor.indices.address &&
            descriptor.indices.page_offset == 0 &&
            physical_frame_address ==
                descriptor.pt.entry.physical_address
        {
            true -> accept_four_kilobyte_walk_endpoints(
                virtual_page_address,
                physical_frame_address,
                descriptor
            )
            _ -> reject_four_kilobyte_walk_endpoints()
        }
    }

    state accept_four_kilobyte_walk_endpoints(
        virtual_page_address: u64,
        physical_frame_address: u64,
        descriptor: X86BootstrapFourLevelWalkDescriptor
    ) -> X86BootstrapFourKilobyteWalkEndpointCheck {
        X86BootstrapFourKilobyteWalkEndpointCheck::EndpointConsistent {
            candidate: X86BootstrapFourKilobyteWalkEndpoints {
                virtual_page_address: virtual_page_address,
                physical_frame_address: physical_frame_address,
                descriptor: descriptor,
            },
        }
    }

    state reject_four_kilobyte_walk_endpoints()
        -> X86BootstrapFourKilobyteWalkEndpointCheck
    {
        X86BootstrapFourKilobyteWalkEndpointCheck::Rejected
    }
}

// Ordinary candidate data. A future placed-page provider must bind this shape
// to pre-reserved qualified storage; declaring the array grants no Extent,
// capacity, placement, mapping, or installation authority.
pub data X86PageTablePageCandidate {
    entries: [X86PageTableEntry; 512];
}

pub data X86EmptyPageTablePagePolicyCheck {
    case Rejected;
    case ZeroConsistent(candidate: X86PageTablePageCandidate);
}

// Exact zero encoding for the existing PTE schema. `present == false` alone is
// insufficient for this bootstrap baseline: accepting residual software or
// address bits would make zero-initialized storage and a reused dirty page
// indistinguishable at the policy boundary.
machine x86_page_table_entry_is_zero(entry: X86PageTableEntry) -> bool {
    !entry.present &&
    !entry.writable &&
    !entry.user &&
    !entry.write_through &&
    !entry.cache_disable &&
    !entry.accessed &&
    !entry.dirty &&
    !entry.page_size_or_pat &&
    !entry.global &&
    entry.software_low == 0 &&
    entry.frame_number == 0 &&
    entry.software_high == 0 &&
    entry.protection_key == 0 &&
    !entry.no_execute
}

// Validate the whole page as one transaction. A failed slot rejects the page;
// no partially checked candidate escapes.
pub machine x86_validate_empty_page_table_page(
    candidate: X86PageTablePageCandidate
) -> X86EmptyPageTablePagePolicyCheck {
    x86_scan_empty_page_table_page(candidate, X86_PAGE_TABLE_ENTRY_COUNT, true)
}

// The fixed scan always visits indices 0..511 under checked decreasing fuel.
// Accumulating the verdict keeps one bounded control shape and still prevents
// a dirty slot from being forgotten by an early success path.
machine x86_scan_empty_page_table_page(
    candidate: X86PageTablePageCandidate,
    remaining: u64 [1..=512],
    zero_so_far: bool
)
terminates by remaining;
-> X86EmptyPageTablePagePolicyCheck
{
    let index: u64 [0..=511] = X86_PAGE_TABLE_ENTRY_COUNT - remaining;
    let entry: X86PageTableEntry = candidate.entries[index];
    let still_zero: bool = zero_so_far && x86_page_table_entry_is_zero(entry);
    transition remaining > 1 {
        true -> x86_scan_empty_page_table_page(
            candidate,
            remaining - 1,
            still_zero
        )
        _ -> settle_empty_page_table_page(candidate, still_zero)
    }

    state settle_empty_page_table_page(
        candidate: X86PageTablePageCandidate,
        zero: bool
    ) -> X86EmptyPageTablePagePolicyCheck {
        transition zero {
            true -> accept_empty_page_table_page(candidate)
            _ -> reject_empty_page_table_page()
        }
    }

    state accept_empty_page_table_page(
        candidate: X86PageTablePageCandidate
    ) -> X86EmptyPageTablePagePolicyCheck {
        X86EmptyPageTablePagePolicyCheck::ZeroConsistent {
            candidate: candidate,
        }
    }

    state reject_empty_page_table_page() -> X86EmptyPageTablePagePolicyCheck {
        X86EmptyPageTablePagePolicyCheck::Rejected
    }
}

// One ordinary final page image paired with the numeric walk step that names
// its sole populated slot. The retained table and target addresses remain
// numeric data; this carrier establishes no backing, placement, hierarchy,
// mapping, TLB, installation, CR3, or machine-control authority.
pub data X86BootstrapSingleEntryPageImageCandidate {
    step: X86BootstrapPageTableWalkStep;
    page: X86PageTablePageCandidate;
}

pub data X86BootstrapSingleEntryPageImageCheck {
    case Rejected;
    case ImageConsistent(
        candidate: X86BootstrapSingleEntryPageImageCandidate
    );
}

// Exact schema equality for the PTE value stored in one selected slot. Every
// permission, cache, software, address, and role-dependent field is copied as
// uninterpreted data rather than inferred or normalized here.
machine x86_page_table_entries_are_equal(
    left: X86PageTableEntry,
    right: X86PageTableEntry
) -> bool {
    left.present == right.present &&
    left.writable == right.writable &&
    left.user == right.user &&
    left.write_through == right.write_through &&
    left.cache_disable == right.cache_disable &&
    left.accessed == right.accessed &&
    left.dirty == right.dirty &&
    left.page_size_or_pat == right.page_size_or_pat &&
    left.global == right.global &&
    left.software_low == right.software_low &&
    left.frame_number == right.frame_number &&
    left.software_high == right.software_high &&
    left.protection_key == right.protection_key &&
    left.no_execute == right.no_execute
}

// Exact equality for one retained walk step. Both inputs have their local
// entry-address and PFN geometry replayed by their owning validators before
// this helper is used; equality here binds a validated page image to the exact
// level step retained by the endpoint-consistent descriptor without assigning
// any further meaning to the entry fields.
machine x86_bootstrap_page_table_walk_steps_are_equal(
    left: X86BootstrapPageTableWalkStep,
    right: X86BootstrapPageTableWalkStep
) -> bool {
    left.table_address == right.table_address &&
    left.index == right.index &&
    left.entry_address == right.entry_address &&
    left.entry.physical_address == right.entry.physical_address &&
    x86_page_table_entries_are_equal(left.entry.entry, right.entry.entry)
}

// Keep the selected-versus-zero policy explicit while leaving the recursive
// scanner with one visibly decreasing edge. The selected slot preserves every
// retained entry field; an unselected slot preserves the exact-zero baseline.
machine x86_bootstrap_single_entry_page_slot_is_consistent(
    entry: X86PageTableEntry,
    expected: X86PageTableEntry,
    selected: bool
) -> bool {
    transition selected {
        true -> compare_selected_bootstrap_page_entry(entry, expected)
        _ -> compare_zero_bootstrap_page_entry(entry)
    }

    state compare_selected_bootstrap_page_entry(
        entry: X86PageTableEntry,
        expected: X86PageTableEntry
    ) -> bool {
        x86_page_table_entries_are_equal(entry, expected)
    }

    state compare_zero_bootstrap_page_entry(
        entry: X86PageTableEntry
    ) -> bool {
        x86_page_table_entry_is_zero(entry)
    }
}

// Validate the complete final image as one transaction. Step geometry and a
// present selected entry are prerequisites; no partial image escapes failure.
pub machine x86_validate_bootstrap_single_entry_page_image(
    candidate: X86BootstrapSingleEntryPageImageCandidate
) -> X86BootstrapSingleEntryPageImageCheck {
    let step_consistent: bool =
        x86_bootstrap_page_table_walk_step_is_consistent(
            candidate.step,
            candidate.step.index
        );
    transition step_consistent && candidate.step.entry.entry.present {
        true -> x86_scan_bootstrap_single_entry_page_image(
            candidate,
            X86_PAGE_TABLE_ENTRY_COUNT,
            true
        )
        _ -> reject_bootstrap_single_entry_page_image()
    }

    state reject_bootstrap_single_entry_page_image()
        -> X86BootstrapSingleEntryPageImageCheck
    {
        X86BootstrapSingleEntryPageImageCheck::Rejected
    }
}

// Visit indices 0..511 under checked decreasing fuel. Exactly the retained
// step index uses field-for-field equality; every other slot must preserve the
// existing exact-zero starting policy.
machine x86_scan_bootstrap_single_entry_page_image(
    candidate: X86BootstrapSingleEntryPageImageCandidate,
    remaining: u64 [1..=512],
    consistent_so_far: bool
)
terminates by remaining;
-> X86BootstrapSingleEntryPageImageCheck
{
    let index: u64 [0..=511] = X86_PAGE_TABLE_ENTRY_COUNT - remaining;
    let entry: X86PageTableEntry = candidate.page.entries[index];
    let selected: bool = index == candidate.step.index;
    let slot_consistent: bool =
        x86_bootstrap_single_entry_page_slot_is_consistent(
            entry,
            candidate.step.entry.entry,
            selected
        );
    let still_consistent: bool = consistent_so_far && slot_consistent;
    transition remaining > 1 {
        true -> x86_scan_bootstrap_single_entry_page_image(
            candidate,
            remaining - 1,
            still_consistent
        )
        _ -> settle_bootstrap_single_entry_page_image(
            candidate,
            still_consistent
        )
    }

    state settle_bootstrap_single_entry_page_image(
        candidate: X86BootstrapSingleEntryPageImageCandidate,
        consistent: bool
    ) -> X86BootstrapSingleEntryPageImageCheck {
        transition consistent {
            true -> accept_bootstrap_single_entry_page_image(candidate)
            _ -> reject_bootstrap_single_entry_page_image()
        }
    }

    state accept_bootstrap_single_entry_page_image(
        candidate: X86BootstrapSingleEntryPageImageCandidate
    ) -> X86BootstrapSingleEntryPageImageCheck {
        X86BootstrapSingleEntryPageImageCheck::ImageConsistent {
            candidate: candidate,
        }
    }

    state reject_bootstrap_single_entry_page_image()
        -> X86BootstrapSingleEntryPageImageCheck
    {
        X86BootstrapSingleEntryPageImageCheck::Rejected
    }
}

// Four independently checked single-entry page images paired with one checked
// 4-KiB walk endpoint candidate. The endpoint carrier already retains the exact
// role-consistent descriptor. These values remain ordinary pre-authority data:
// they prove no backing, placement, hierarchy ownership, mapping, TLB state,
// installation, CR3 value, or machine-control authority and choose no layout,
// permission, or cache policy.
pub data X86BootstrapFourPageWalkImageCandidate {
    endpoints: X86BootstrapFourKilobyteWalkEndpoints;
    pml4: X86BootstrapSingleEntryPageImageCandidate;
    pdpt: X86BootstrapSingleEntryPageImageCandidate;
    pd: X86BootstrapSingleEntryPageImageCandidate;
    pt: X86BootstrapSingleEntryPageImageCandidate;
}

pub data X86BootstrapFourPageWalkImageCheck {
    case Rejected;
    case ImagesConsistent(
        candidate: X86BootstrapFourPageWalkImageCandidate
    );
}

// Replay the endpoint/role/descriptor policy and each complete single-entry
// image independently. Only the exact successful payload from every validator
// reaches the final level-binding check.
pub machine x86_validate_bootstrap_four_page_walk_images(
    candidate: X86BootstrapFourPageWalkImageCandidate
) -> X86BootstrapFourPageWalkImageCheck {
    let pml4: X86BootstrapSingleEntryPageImageCandidate = candidate.pml4;
    let pdpt: X86BootstrapSingleEntryPageImageCandidate = candidate.pdpt;
    let pd: X86BootstrapSingleEntryPageImageCandidate = candidate.pd;
    let pt: X86BootstrapSingleEntryPageImageCandidate = candidate.pt;
    let endpoints_check: X86BootstrapFourKilobyteWalkEndpointCheck =
        x86_validate_bootstrap_four_kilobyte_walk_endpoints(
            candidate.endpoints
        );
    transition endpoints_check {
        X86BootstrapFourKilobyteWalkEndpointCheck::EndpointConsistent {
            candidate
        } -> validate_bootstrap_pml4_page_image(
            candidate,
            pml4,
            pdpt,
            pd,
            pt
        )
        _ -> reject_bootstrap_four_page_walk_images()
    }

    state validate_bootstrap_pml4_page_image(
        endpoints: X86BootstrapFourKilobyteWalkEndpoints,
        pml4: X86BootstrapSingleEntryPageImageCandidate,
        pdpt: X86BootstrapSingleEntryPageImageCandidate,
        pd: X86BootstrapSingleEntryPageImageCandidate,
        pt: X86BootstrapSingleEntryPageImageCandidate
    ) -> X86BootstrapFourPageWalkImageCheck {
        let image_check: X86BootstrapSingleEntryPageImageCheck =
            x86_validate_bootstrap_single_entry_page_image(pml4);
        transition image_check {
            X86BootstrapSingleEntryPageImageCheck::ImageConsistent {
                candidate
            } -> validate_bootstrap_pdpt_page_image(
                endpoints,
                candidate,
                pdpt,
                pd,
                pt
            )
            _ -> reject_bootstrap_four_page_walk_images()
        }
    }

    state validate_bootstrap_pdpt_page_image(
        endpoints: X86BootstrapFourKilobyteWalkEndpoints,
        pml4: X86BootstrapSingleEntryPageImageCandidate,
        pdpt: X86BootstrapSingleEntryPageImageCandidate,
        pd: X86BootstrapSingleEntryPageImageCandidate,
        pt: X86BootstrapSingleEntryPageImageCandidate
    ) -> X86BootstrapFourPageWalkImageCheck {
        let image_check: X86BootstrapSingleEntryPageImageCheck =
            x86_validate_bootstrap_single_entry_page_image(pdpt);
        transition image_check {
            X86BootstrapSingleEntryPageImageCheck::ImageConsistent {
                candidate
            } -> validate_bootstrap_pd_page_image(
                endpoints,
                pml4,
                candidate,
                pd,
                pt
            )
            _ -> reject_bootstrap_four_page_walk_images()
        }
    }

    state validate_bootstrap_pd_page_image(
        endpoints: X86BootstrapFourKilobyteWalkEndpoints,
        pml4: X86BootstrapSingleEntryPageImageCandidate,
        pdpt: X86BootstrapSingleEntryPageImageCandidate,
        pd: X86BootstrapSingleEntryPageImageCandidate,
        pt: X86BootstrapSingleEntryPageImageCandidate
    ) -> X86BootstrapFourPageWalkImageCheck {
        let image_check: X86BootstrapSingleEntryPageImageCheck =
            x86_validate_bootstrap_single_entry_page_image(pd);
        transition image_check {
            X86BootstrapSingleEntryPageImageCheck::ImageConsistent {
                candidate
            } -> validate_bootstrap_pt_page_image(
                endpoints,
                pml4,
                pdpt,
                candidate,
                pt
            )
            _ -> reject_bootstrap_four_page_walk_images()
        }
    }

    state validate_bootstrap_pt_page_image(
        endpoints: X86BootstrapFourKilobyteWalkEndpoints,
        pml4: X86BootstrapSingleEntryPageImageCandidate,
        pdpt: X86BootstrapSingleEntryPageImageCandidate,
        pd: X86BootstrapSingleEntryPageImageCandidate,
        pt: X86BootstrapSingleEntryPageImageCandidate
    ) -> X86BootstrapFourPageWalkImageCheck {
        let image_check: X86BootstrapSingleEntryPageImageCheck =
            x86_validate_bootstrap_single_entry_page_image(pt);
        transition image_check {
            X86BootstrapSingleEntryPageImageCheck::ImageConsistent {
                candidate
            } -> validate_bootstrap_four_page_walk_correspondence(
                endpoints,
                pml4,
                pdpt,
                pd,
                candidate
            )
            _ -> reject_bootstrap_four_page_walk_images()
        }
    }

    state validate_bootstrap_four_page_walk_correspondence(
        endpoints: X86BootstrapFourKilobyteWalkEndpoints,
        pml4: X86BootstrapSingleEntryPageImageCandidate,
        pdpt: X86BootstrapSingleEntryPageImageCandidate,
        pd: X86BootstrapSingleEntryPageImageCandidate,
        pt: X86BootstrapSingleEntryPageImageCandidate
    ) -> X86BootstrapFourPageWalkImageCheck {
        let pml4_matches: bool =
            x86_bootstrap_page_table_walk_steps_are_equal(
                pml4.step,
                endpoints.descriptor.pml4
            );
        let pdpt_matches: bool =
            x86_bootstrap_page_table_walk_steps_are_equal(
                pdpt.step,
                endpoints.descriptor.pdpt
            );
        let pd_matches: bool =
            x86_bootstrap_page_table_walk_steps_are_equal(
                pd.step,
                endpoints.descriptor.pd
            );
        let pt_matches: bool =
            x86_bootstrap_page_table_walk_steps_are_equal(
                pt.step,
                endpoints.descriptor.pt
            );
        transition pml4_matches && pdpt_matches && pd_matches && pt_matches {
            true -> accept_bootstrap_four_page_walk_images(
                endpoints,
                pml4,
                pdpt,
                pd,
                pt
            )
            _ -> reject_bootstrap_four_page_walk_images()
        }
    }

    state accept_bootstrap_four_page_walk_images(
        endpoints: X86BootstrapFourKilobyteWalkEndpoints,
        pml4: X86BootstrapSingleEntryPageImageCandidate,
        pdpt: X86BootstrapSingleEntryPageImageCandidate,
        pd: X86BootstrapSingleEntryPageImageCandidate,
        pt: X86BootstrapSingleEntryPageImageCandidate
    ) -> X86BootstrapFourPageWalkImageCheck {
        X86BootstrapFourPageWalkImageCheck::ImagesConsistent {
            candidate: X86BootstrapFourPageWalkImageCandidate {
                endpoints: endpoints,
                pml4: pml4,
                pdpt: pdpt,
                pd: pd,
                pt: pt,
            },
        }
    }

    state reject_bootstrap_four_page_walk_images()
        -> X86BootstrapFourPageWalkImageCheck
    {
        X86BootstrapFourPageWalkImageCheck::Rejected
    }
}
