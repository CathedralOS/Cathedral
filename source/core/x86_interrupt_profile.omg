// source/core/x86_interrupt_profile.omg
//
// Cathedral's first x86-64 vector-to-stack policy. This composes pure
// architecture facts into kernel policy; it still grants no entry identity,
// stack storage, root admission, table publication, or machine control.
//
// Keeping the complete stack record beside the vector prevents the root/WCSU
// side from selecting one analysis class while IDT/TSS materialization writes
// a different IST index.

use facts::pic_8259;
use facts::x86_exception_vectors;
use facts::x86_idt_gate;
use facts::x86_interrupt_stacks;
use omega::language::std::calling;

// The complete pre-timer exception floor is deliberately fatal. Later
// recovery policy may replace individual entries only through a fresh root
// admission; the bootstrap table never leaves an absent or silently returning
// architectural slot.
pub data X86BootstrapExceptionDisposition {
    case FatalDiagnostic;
}

// One record is consumed by both sides of exception admission: `stack` is the
// normalized WCSU/nesting policy and `ist_index` is the x86 gate/TSS choice.
// Current-stack entries pair `Interrupted` with IST zero. Dedicated entries
// derive both fields from one X86IstStackClass so they cannot drift.
pub data X86BootstrapExceptionEntryPolicy {
    vector: u8 [0..=31];
    stack: EntryStack;
    ist_index: u8 [0..=7];
    disposition: X86BootstrapExceptionDisposition;
}

// A proposed gate paired with the semantic fields that are not encoded in the
// 16-byte descriptor itself. This remains ordinary data: `entry` and
// `selector` inside `gate` have not yet been vouched for by the admitted-root
// resolver or the boot-selected code-segment fact.
pub data X86BootstrapExceptionGateCandidate {
    vector: u8 [0..=31];
    gate: X86IdtGate;
    disposition: X86BootstrapExceptionDisposition;
}

// `PolicyConsistent` reports only the Cathedral-owned checks performed below.
// It is deliberately not a MaterializedIdt, receipt, publication token, or
// assertion that the candidate's entry identity and selector are admitted.
pub data X86BootstrapExceptionGatePolicyCheck {
    case Rejected;
    case PolicyConsistent(candidate: X86BootstrapExceptionGateCandidate);
}

// Total policy for all architectural exception slots. Reserved and
// profile-optional vectors intentionally receive the same fatal current-stack
// floor as ordinary exceptions, so unexpected delivery cannot target an
// absent descriptor.
pub machine x86_bootstrap_exception_entry_policy(
    vector: u8 [0..=31]
) -> X86BootstrapExceptionEntryPolicy {
    transition vector == X86_EXCEPTION_NON_MASKABLE_INTERRUPT {
        true -> dedicated(vector, X86_NMI_STACK)
        _ -> double_fault(vector)
    }

    state double_fault(vector: u8 [0..=31]) -> X86BootstrapExceptionEntryPolicy {
        transition vector == X86_EXCEPTION_DOUBLE_FAULT {
            true -> dedicated(vector, X86_DOUBLE_FAULT_STACK)
            _ -> machine_check(vector)
        }
    }

    state machine_check(vector: u8 [0..=31]) -> X86BootstrapExceptionEntryPolicy {
        transition vector == X86_EXCEPTION_MACHINE_CHECK {
            true -> dedicated(vector, X86_MACHINE_CHECK_STACK)
            _ -> current_stack(vector)
        }
    }

    state dedicated(
        vector: u8 [0..=31],
        selected: X86IstStackClass
    ) -> X86BootstrapExceptionEntryPolicy {
        X86BootstrapExceptionEntryPolicy {
            vector: vector,
            stack: EntryStack::Dedicated { class: selected.stack_class },
            ist_index: selected.ist_index,
            disposition: X86BootstrapExceptionDisposition::FatalDiagnostic,
        }
    }

    state current_stack(vector: u8 [0..=31]) -> X86BootstrapExceptionEntryPolicy {
        X86BootstrapExceptionEntryPolicy {
            vector: vector,
            stack: EntryStack::Interrupted,
            ist_index: 0,
            disposition: X86BootstrapExceptionDisposition::FatalDiagnostic,
        }
    }
}

// Pure prepublication validation of the fields Cathedral can already decide.
// The later source-carrier integration must additionally bind `gate.entry` to
// the exact admitted root and `gate.selector` to the boot-selected ring-0 code
// segment before materialization can establish a table.
pub machine x86_validate_bootstrap_exception_gate_policy(
    expected_vector: u8 [0..=31],
    candidate: X86BootstrapExceptionGateCandidate
) -> X86BootstrapExceptionGatePolicyCheck {
    // Derive the policy internally from the requested table slot; callers
    // cannot obtain consistency merely by supplying a matching invented
    // policy record.
    let policy: X86BootstrapExceptionEntryPolicy =
        x86_bootstrap_exception_entry_policy(expected_vector);
    transition candidate.vector == policy.vector {
        true -> check_ist(policy, candidate)
        _ -> reject()
    }

    state check_ist(
        policy: X86BootstrapExceptionEntryPolicy,
        candidate: X86BootstrapExceptionGateCandidate
    ) -> X86BootstrapExceptionGatePolicyCheck {
        transition candidate.gate.ist == policy.ist_index {
            true -> check_disposition(policy, candidate)
            _ -> reject()
        }
    }

    state check_disposition(
        policy: X86BootstrapExceptionEntryPolicy,
        candidate: X86BootstrapExceptionGateCandidate
    ) -> X86BootstrapExceptionGatePolicyCheck {
        transition candidate.disposition == policy.disposition {
            true -> check_attributes(candidate)
            _ -> reject()
        }
    }

    state check_attributes(
        candidate: X86BootstrapExceptionGateCandidate
    ) -> X86BootstrapExceptionGatePolicyCheck {
        transition candidate.gate.type_attributes == PRESENT_RING0_INTERRUPT_GATE {
            true -> check_reserved(candidate)
            _ -> reject()
        }
    }

    state check_reserved(
        candidate: X86BootstrapExceptionGateCandidate
    ) -> X86BootstrapExceptionGatePolicyCheck {
        transition candidate.gate.reserved == RESERVED_ZERO {
            true -> accept(candidate)
            _ -> reject()
        }
    }

    state accept(
        candidate: X86BootstrapExceptionGateCandidate
    ) -> X86BootstrapExceptionGatePolicyCheck {
        X86BootstrapExceptionGatePolicyCheck::PolicyConsistent {
            candidate: candidate,
        }
    }

    state reject() -> X86BootstrapExceptionGatePolicyCheck {
        X86BootstrapExceptionGatePolicyCheck::Rejected
    }
}

pub data X86EntryStackAssignment {
    vector: u8;
    stack: X86IstStackClass;
}

pub machine x86_double_fault_entry_stack() -> X86EntryStackAssignment {
    X86EntryStackAssignment {
        vector: X86_EXCEPTION_DOUBLE_FAULT,
        stack: X86_DOUBLE_FAULT_STACK,
    }
}

pub machine x86_nmi_entry_stack() -> X86EntryStackAssignment {
    X86EntryStackAssignment {
        vector: X86_EXCEPTION_NON_MASKABLE_INTERRUPT,
        stack: X86_NMI_STACK,
    }
}

pub machine x86_machine_check_entry_stack() -> X86EntryStackAssignment {
    X86EntryStackAssignment {
        vector: X86_EXCEPTION_MACHINE_CHECK,
        stack: X86_MACHINE_CHECK_STACK,
    }
}

// The remapped legacy timer is the first member of the shared maskable-IRQ
// class. Later PIC/APIC roots cite the same class while owning distinct vector
// assignments.
pub machine x86_legacy_timer_entry_stack() -> X86EntryStackAssignment {
    X86EntryStackAssignment {
        vector: PROTECTED_MASTER_VECTOR_BASE,
        stack: X86_MASKABLE_IRQ_STACK,
    }
}
