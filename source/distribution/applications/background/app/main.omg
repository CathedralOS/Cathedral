// Acquire presentation -> verify scope -> paint changed grants -> sleep/respond.
// The bridge supplies completed operations, never ambient services or authority.
use model.omg;

public machine advance(s: &mut |model|::Session, event: |model|::Event) -> |model|::Command {
    transition event {
        |model|::Event::Failed { failure } -> failed(s, failure)
        _ -> resume(s, event)
    }
}
machine failed(s: &mut |model|::Session, failure: |model|::Failure) -> |model|::Command {
    transition failure {
        |model|::Failure::Provider { code } -> refused(s, code)
        _ -> fail(s, failure)
    }
}

machine resume(s: &mut |model|::Session, event: |model|::Event) -> |model|::Command {
    transition s.phase {
        |model|::Phase::Start -> acquire(s)
        |model|::Phase::Interaction -> first_poll(s)
        |model|::Phase::FirstView -> check_scope(s, event)
        |model|::Phase::StorageProbe -> report_scope(s, event)
        |model|::Phase::Diagnostic -> present(s)
        |model|::Phase::View -> refresh(s, event)
        |model|::Phase::Surface -> created(s, event)
        |model|::Phase::Paint -> wait(s)
        |model|::Phase::Recheck { code } -> rechecked(s, code, event)
        |model|::Phase::Waiting -> awakened(s, event)
        |model|::Phase::Control -> poll(s)
        |model|::Phase::Stopped -> (|model|::Command::Exit)
    }
}

machine acquire(s: &mut |model|::Session) -> |model|::Command {
    s.phase = |model|::Phase::Interaction;
    |model|::Command::AcquireInteraction
}

machine first_poll(s: &mut |model|::Session) -> |model|::Command {
    s.phase = |model|::Phase::FirstView;
    |model|::Command::Poll
}

machine check_scope(s: &mut |model|::Session, event: |model|::Event) -> |model|::Command {
    transition event {
        |model|::Event::View { view } -> remember(s, view)
        |model|::Event::NoView -> probe(s)
        _ -> fail(s, |model|::Failure::UnexpectedReply)
    }
    machine remember(s: &mut |model|::Session, view: |model|::View) -> |model|::Command {
        s.view = view;
        probe(s)
    }
    machine probe(s: &mut |model|::Session) -> |model|::Command {
        s.phase = |model|::Phase::StorageProbe;
        |model|::Command::ProbeStorage
    }
}

machine report_scope(s: &mut |model|::Session, event: |model|::Event) -> |model|::Command {
    transition event {
        |model|::Event::StorageDenied -> report(s)
        _ -> fail(s, |model|::Failure::UnexpectedStorageGrant)
    }
    machine report(s: &mut |model|::Session) -> |model|::Command {
        s.phase = |model|::Phase::Diagnostic;
        |model|::Command::ReportScope
    }
}

machine refresh(s: &mut |model|::Session, event: |model|::Event) -> |model|::Command {
    transition event {
        |model|::Event::View { view } -> update(s, view)
        |model|::Event::NoView -> wait(s)
        _ -> fail(s, |model|::Failure::UnexpectedReply)
    }
    machine update(s: &mut |model|::Session, view: |model|::View) -> |model|::Command {
        s.view = view;
        present(s)
    }
}

machine present(s: &mut |model|::Session) -> |model|::Command {
    transition s.view.epoch == s.painted_epoch {
        true -> wait(s)
        _ -> changed(s)
    }
    machine changed(s: &mut |model|::Session) -> |model|::Command {
        s.painted_epoch = s.view.epoch;
        // Surface handles belong to the old grant; a new epoch retires them.
        s.surface = 0u64;
        create(s)
    }
    machine create(s: &mut |model|::Session) -> |model|::Command {
        s.phase = |model|::Phase::Surface;
        |model|::Command::CreateSurface { epoch: s.view.epoch }
    }
}

// A grant may change between POLL, CREATE and PAINT. Recheck once, and only
// resume under a different grant. A refusal under the same grant stays fatal.
machine refused(s: &mut |model|::Session, code: u64) -> |model|::Command {
    transition s.phase {
        |model|::Phase::Surface -> recheck(s, code)
        |model|::Phase::Paint -> recheck(s, code)
        _ -> fail(s, |model|::Failure::Provider { code: code })
    }
    machine recheck(s: &mut |model|::Session, code: u64) -> |model|::Command {
        s.phase = |model|::Phase::Recheck { code: code };
        |model|::Command::Poll
    }
}
machine rechecked(s: &mut |model|::Session, code: u64, event: |model|::Event) -> |model|::Command {
    transition event {
        |model|::Event::NoView -> hidden(s)
        |model|::Event::View { view } -> observed(s, code, view)
        _ -> fail(s, |model|::Failure::UnexpectedReply)
    }
    machine hidden(s: &mut |model|::Session) -> |model|::Command {
        s.surface = 0u64;
        s.painted_epoch = 0u64;
        wait(s)
    }
    machine observed(s: &mut |model|::Session, code: u64, view: |model|::View) -> |model|::Command {
        transition view.epoch != s.view.epoch {
            true -> refresh(s, |model|::Event::View { view: view })
            _ -> fail(s, |model|::Failure::Provider { code: code })
        }
    }
}

machine created(s: &mut |model|::Session, event: |model|::Event) -> |model|::Command {
    transition event {
        |model|::Event::Surface { handle } -> retain(s, handle)
        _ -> fail(s, |model|::Failure::UnexpectedReply)
    }
    machine retain(s: &mut |model|::Session, handle: u64) -> |model|::Command {
        s.surface = handle;
        paint(s)
    }
}

machine paint(s: &mut |model|::Session) -> |model|::Command {
    s.phase = |model|::Phase::Paint;
    |model|::Command::Paint { view: s.view, surface: s.surface, color: 0x101827u64 }
}

machine wait(s: &mut |model|::Session) -> |model|::Command {
    s.phase = |model|::Phase::Waiting;
    |model|::Command::Wait { ticks: 100u64 }
}

machine awakened(s: &mut |model|::Session, event: |model|::Event) -> |model|::Command {
    transition event {
        |model|::Event::Wake -> poll(s)
        |model|::Event::Control { accepted } -> reply(s, accepted)
        _ -> fail(s, |model|::Failure::UnexpectedReply)
    }
    machine reply(s: &mut |model|::Session, accepted: bool) -> |model|::Command {
        s.phase = |model|::Phase::Control;
        |model|::Command::ReplyControl { accepted: accepted }
    }
}

machine poll(s: &mut |model|::Session) -> |model|::Command {
    s.phase = |model|::Phase::View;
    |model|::Command::Poll
}

machine fail(s: &mut |model|::Session, failure: |model|::Failure) -> |model|::Command {
    s.phase = |model|::Phase::Stopped;
    |model|::Command::Fail { failure: failure }
}
