use main.omg;

use {component}/main.omg as component_main;
machine build(builder: &mut Build) {
    Build::application(builder, "cathedral_background_native");
    Build::depend_as(builder, "component", Source::Path { location: "../component" });
    Build::depend_as(builder, "app", Source::Path { location: "../../app" });
    Build::select_provider<|component_main|::Background, |component_main|::BackgroundProvider>(builder, linux_x86_64, CompositionMode::Independent);
    Build::bind(builder, linux_x86_64::ProgramEntry, |main|::main);
}
