machine build(builder: &mut Build) {
    Build::application(builder, "cathedral_background_native");
    Build::depend_as(builder, "component", Source::Path { location: "../component" });
    Build::depend_as(builder, "app", Source::Path { location: "../../app" });
    Build::select_provider<component::main::Background, component::main::BackgroundProvider>(builder, CompositionMode::Independent);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
