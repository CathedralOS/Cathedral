// ABI and protocol interpretation stay here; the app sees named events/commands.
use {app}/model.omg;
use {host}/main.omg;
use {protocol}/main.omg as protocol_main;
use diagnostic.omg;

public machine decode(phase: |model|::Phase, p: &[u64; 4096]) -> |model|::Event {
    transition phase {
        |model|::Phase::Start -> (|model|::Event::Complete)
        |model|::Phase::Stopped -> (|model|::Event::Complete)
        |model|::Phase::StorageProbe -> scope(p)
        |model|::Phase::Waiting -> wake(p)
        _ -> completed(phase, p)
    }
}

machine completed(phase: |model|::Phase, p: &[u64; 4096]) -> |model|::Event {
    transition p[9] == 0u64 {
        true -> reply(phase, p)
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: p[9] } })
    }
    machine reply(phase: |model|::Phase, p: &[u64; 4096]) -> |model|::Event {
        transition phase {
            |model|::Phase::FirstView -> view(p)
            |model|::Phase::View -> view(p)
            |model|::Phase::Recheck { code } -> view(p)
            |model|::Phase::Surface -> surface(p)
            |model|::Phase::Paint -> painted(p)
            _ -> (|model|::Event::Complete)
        }
    }
}

machine scope(p: &[u64; 4096]) -> |model|::Event {
    transition p[9] {
        |protocol_main|::UNAVAILABLE -> (|model|::Event::StorageDenied)
        0u64 -> (|model|::Event::Failed { failure: |model|::Failure::UnexpectedStorageGrant })
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: p[9] } })
    }
}

machine view(p: &[u64; 4096]) -> |model|::Event {
    transition p[0] == 0u64 {
        true -> (|model|::Event::View { view: |model|::View { epoch: p[1], width: p[2], height: p[3] } })
        _ -> (|model|::Event::NoView)
    }
}

machine surface(p: &[u64; 4096]) -> |model|::Event {
    transition p[0] == 0u64 {
        true -> (|model|::Event::Surface { handle: p[1] })
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Provider { code: p[0] } })
    }
}

machine painted(p: &[u64; 4096]) -> |model|::Event {
    transition p[0] == 0u64 {
        true -> (|model|::Event::Complete)
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Provider { code: p[0] } })
    }
}

machine wake(p: &[u64; 4096]) -> |model|::Event {
    transition p[9] {
        0u64 -> (|model|::Event::Wake)
        1u64 -> control(p)
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: p[9] } })
    }
    machine control(p: &[u64; 4096]) -> |model|::Event {
        |model|::Event::Control { accepted: (p[0] == |protocol_main|::HEALTH || p[0] == |protocol_main|::LOSS)
            && p[1] == 0u64 && p[2] == 0u64 && p[3] == 0u64 && p[4] == 0u64
            && p[5] == 0u64 && p[6] == 0u64 && p[7] == 0u64 }
    }
}

public machine encode(command: |model|::Command, p: &mut [u64; 4096]) -> u64 {
    |main|::message(p, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
    transition command {
        |model|::Command::AcquireInteraction -> acquire(p, |main|::INTERACTION)
        |model|::Command::ProbeStorage -> acquire(p, |main|::STORAGE)
        |model|::Command::Poll -> poll(p)
        |model|::Command::ReportScope -> |diagnostic|::scope(p)
        |model|::Command::CreateSurface { epoch } -> create(p, epoch)
        |model|::Command::Paint { view, surface, color } -> paint(p, view, surface, color)
        |model|::Command::Wait { ticks } -> wait(p, ticks)
        |model|::Command::ReplyControl { accepted } -> reply(p, accepted)
        |model|::Command::Fail { failure } -> fail(p, failure)
        |model|::Command::Exit -> (|main|::EXIT)
    }
}

machine acquire(p: &mut [u64; 4096], operation: u64) -> u64 {
    p[0] = 1u64;
    p[1] = 1u64;
    operation
}

machine poll(p: &mut [u64; 4096]) -> u64 {
    p[0] = |protocol_main|::MATRIX_POLL;
    |main|::EXCHANGE
}

machine create(p: &mut [u64; 4096], epoch: u64) -> u64 {
    p[0] = |protocol_main|::SURFACE_CREATE;
    p[1] = epoch;
    |main|::EXCHANGE
}

machine paint(p: &mut [u64; 4096], view: |model|::View, surface: u64, color: u64) -> u64 {
    |main|::message(p, |protocol_main|::MATRIX_PAINT, view.epoch, surface, 0u64, 0u64, view.width, view.height, color);
    |main|::EXCHANGE
}

machine wait(p: &mut [u64; 4096], ticks: u64) -> u64 {
    p[13] = ticks;
    |main|::WAIT
}

machine reply(p: &mut [u64; 4096], accepted: bool) -> u64 {
    transition accepted {
        true -> (|main|::CONTROL)
        _ -> denied(p)
    }
    machine denied(p: &mut [u64; 4096]) -> u64 {
        p[0] = |protocol_main|::DENIED;
        |main|::CONTROL
    }
}

machine fail(p: &mut [u64; 4096], failure: |model|::Failure) -> u64 {
    let code: u64 = failure_code(failure);
    p[0] = code;
    |main|::FAIL
}

machine failure_code(failure: |model|::Failure) -> u64 {
    transition failure {
        |model|::Failure::Transport { code } -> (code)
        |model|::Failure::Provider { code } -> (code)
        |model|::Failure::UnexpectedStorageGrant -> (|protocol_main|::DENIED)
        |model|::Failure::UnexpectedReply -> (|protocol_main|::INVALID_ARGUMENT)
    }
}
