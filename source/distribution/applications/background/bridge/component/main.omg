module main;
// Temporary native ABI: decode completed host work, advance the app, encode work.
use app::main::advance;
use app::model::Session;
use app::model::Event;
use app::model::Command;
use codec;

public boundary trait Background {
    machine step(s: &mut Session, p: &mut [u64; 4096]) -> u64 reaches;
}
public BackgroundProvider satisfies Background {
    machine step(s: &mut Session, p: &mut [u64; 4096]) -> u64 {
        transition p[15] {
            1u64 -> (size_of<Session>())
            2u64 -> (align_of<Session>())
            3u64 -> (1u64)
            _ -> resume(s, p)
        }
    }
}
machine resume(s: &mut Session, p: &mut [u64; 4096]) -> u64 {
    let event: Event = codec::decode(s.phase, p);
    let command: Command = advance(s, event);
    codec::encode(command, p)
}
public machine component_entry() reaches Background invokes Background; {
    let mut s: Session;
    let mut p: [u64; 4096];
    let result: u64 = Background::step(&mut s, &mut p);
}
