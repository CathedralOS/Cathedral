// The app chooses work. This driver performs it through the supplied runtime and
// resumes with the real result; no duplicate phase machine or oversized packet.
use main.omg;
use {runtime}/kernel.omg;
use {app}/model.omg;
use {app}/main.omg as app_main;
use operations.omg;

public machine run(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut session: |model|::Session;
    transition { _ -> (block drive(gate, context, &mut session, |model|::Event::Complete)) }
}
machine drive(gate: &|kernel|::Gate, context: &mut |main|::Context, session: &mut |model|::Session, event: |model|::Event) -> u64 reaches |kernel|::Kernel {
    let command: |model|::Command = |app_main|::advance(session, event);
    transition command {
        |model|::Command::Exit -> (0u64)
        |model|::Command::Fail { failure } -> failure_code(failure)
        _ -> block execute(gate, context, session, command)
    }
}
machine execute(gate: &|kernel|::Gate, context: &mut |main|::Context, session: &mut |model|::Session, command: |model|::Command) -> u64 reaches |kernel|::Kernel {
    let event: |model|::Event = block |operations|::execute(gate, context, command);
    transition { _ -> (block drive(gate, context, session, event)) }
}
machine failure_code(failure: |model|::Failure) -> u64 {
    transition failure {
        |model|::Failure::Transport { code } -> (code)
        |model|::Failure::Provider { code } -> (code)
        |model|::Failure::UnexpectedReply -> (|kernel|::INVALID_ARGUMENT)
        |model|::Failure::UnexpectedStorageGrant -> (0xfffffffffffffff3u64)
    }
}
