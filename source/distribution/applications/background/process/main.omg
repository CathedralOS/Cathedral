// Establish installed authority -> run the existing app -> release local custody.
// No Rust application host or host packet ABI participates in this process.
use diagnostic.omg;
use {runtime}/entry.omg;
use {runtime}/kernel.omg;
use {runtime}/services/main.omg;
use {runtime}/server/main.omg as server_main;
use startup.omg;
use application.omg;

public data Context { services: |main|::Services; owner: |server_main|::Server; clock: u64; trace: |diagnostic|::Trace; }
public ProgramProvider satisfies |entry|::Program {
    machine run(gate: &|kernel|::Gate, first: u64, second: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
        let mut context: Context;
        let status: u64 = block |startup|::open(gate, &mut context);
        transition status == 0u64 {
            true -> block started(gate, &mut context)
            _ -> block finished(gate, &mut context, status)
        }
    }
}
machine started(gate: &|kernel|::Gate, context: &mut Context) -> u64 reaches |kernel|::Kernel {
    |diagnostic|::control(gate, context.clock, &mut context.trace, 0u64);
    let status: u64 = block |application|::run(gate, context);
    transition { _ -> (block finished(gate, context, status)) }
}
machine finished(gate: &|kernel|::Gate, context: &mut Context, status: u64) -> u64 reaches |kernel|::Kernel {
    block |main|::close(gate, &mut context.services);
    block |server_main|::close(gate, &mut context.owner);
    status
}
public machine component_entry() reaches |entry|::Program + |kernel|::Kernel blocks invokes |entry|::Program invokes |kernel|::Kernel {
    let gate: |kernel|::Gate;
    let status: u64 = block |entry|::Program::run(&gate, 0u64, 0u64);
}
