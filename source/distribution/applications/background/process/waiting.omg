// Drain owner and input readiness, then park. Owner protocol failure retires
// that stream only; an independent presentation wake remains usable.
use diagnostic.omg;
use main.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use {runtime}/server/main.omg as server_main;
use {app}/model.omg;
use {protocol}/main.omg as protocol_main;

public machine next(gate: &|kernel|::Gate, context: &mut |main|::Context, ticks: u64) -> |model|::Event reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block deadline(gate, context, value, ticks)
        |time|::Tick::Failed { code } -> failed(code)
    }
}
machine deadline(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64, ticks: u64) -> |model|::Event reaches |kernel|::Kernel {
    transition ticks <= 0x7fffffffffffffffu64 {
        true -> block poll(gate, context, now, |time|::after(now, ticks))
        _ -> failed(|protocol_main|::INVALID_ARGUMENT)
    }
}
machine poll(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64, deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block owner(gate, context, now, deadline)
        _ -> block input(gate, context, now, deadline)
    }
}
machine owner(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64, deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
    let event: |server_main|::Event = block |server_main|::poll(gate, &mut context.owner, now);
    transition event {
        |server_main|::Event::Request { frame } -> control(gate, context, frame.bytes, frame.payload)
        _ -> block input(gate, context, now, deadline)
    }
}
machine control(gate: &|kernel|::Gate, context: &mut |main|::Context, bytes: u64, words: [u64; 8]) -> |model|::Event reaches |kernel|::Kernel {
    |model|::Event::Control { accepted: observe(gate, context, bytes, words) }
}
// Both idle and broker-wait paths record receipt at the same boundary.
public machine observe(gate: &|kernel|::Gate, context: &mut |main|::Context, bytes: u64, words: [u64; 8]) -> bool reaches |kernel|::Kernel invokes |kernel|::Kernel {
    |diagnostic|::control(gate, context.clock, &mut context.trace, 1u64);
    accepts(bytes, words)
}
// Background has no unsaved work. The same exact owner protocol applies while
// idle and while presentation is pending; it cannot authorize another app's loss.
public machine accepts(bytes: u64, words: [u64; 8]) -> bool {
    bytes == 64u64 && (words[0] == |protocol_main|::HEALTH || words[0] == |protocol_main|::LOSS)
        && words[1] == 0u64 && words[2] == 0u64 && words[3] == 0u64 && words[4] == 0u64
        && words[5] == 0u64 && words[6] == 0u64 && words[7] == 0u64
}
machine input(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64, deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
    let hint: u64 = block |kernel|::Kernel::notify_wait(gate, context.services.wake, now, 1u64);
    transition {
        hint == |kernel|::NOTIFY_SIGNALED -> (|model|::Event::Wake)
        hint != |kernel|::NOTIFY_TIMED_OUT -> failed(hint)
        |time|::reached(now, deadline) -> (|model|::Event::Wake)
        _ -> block park(gate, context, deadline)
    }
}
machine park(gate: &|kernel|::Gate, context: &mut |main|::Context, deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
    let mut interests: [u64; 8];
    interests[0] = 2u64; interests[1] = context.services.wake;
    transition context.owner.peer.fault == 0u64 {
        true -> block combined(gate, context, &mut interests, deadline)
        _ -> block wait(gate, context, &interests, 1u64, deadline)
    }
    machine combined(gate: &|kernel|::Gate, context: &mut |main|::Context, interests: &mut [u64; 8], deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
        interests[2] = 2u64; interests[3] = context.owner.peer.bell.wait;
        interests[5] = context.owner.peer.receiver;
        transition { _ -> (block wait(gate, context, interests, 3u64, deadline)) }
    }
}
machine wait(gate: &|kernel|::Gate, context: &mut |main|::Context, interests: &[u64; 8], count: u64 [0..=4], deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
    let status: u64 = block |kernel|::Kernel::wait(gate, interests, count, deadline);
    transition status < count || status == |kernel|::TIMED_OUT || status == |kernel|::PEER_CLOSED {
        true -> block recheck(gate, context, deadline)
        _ -> block bad_wait(gate, context, deadline, status)
    }
}
machine bad_wait(gate: &|kernel|::Gate, context: &mut |main|::Context, deadline: u64, code: u64) -> |model|::Event reaches |kernel|::Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block retire_owner(gate, context, deadline)
        _ -> failed(code)
    }
    machine retire_owner(gate: &|kernel|::Gate, context: &mut |main|::Context, deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
        block |server_main|::close(gate, &mut context.owner);
        transition { _ -> (block recheck(gate, context, deadline)) }
    }
}
machine recheck(gate: &|kernel|::Gate, context: &mut |main|::Context, deadline: u64) -> |model|::Event reaches |kernel|::Kernel {
    // A wake is a hint. Drain both sources again; peer death may still leave a
    // final complete message. A bad independent grant fails its own next check.
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> (block poll(gate, context, value, deadline))
        |time|::Tick::Failed { code } -> failed(code)
    }
}
public machine reply(gate: &|kernel|::Gate, context: &mut |main|::Context, accepted: bool) -> |model|::Event reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut words: [u64; 8];
    transition accepted {
        true -> block send(gate, context, &words)
        _ -> block refused(gate, context, &mut words)
    }
    machine refused(gate: &|kernel|::Gate, context: &mut |main|::Context, words: &mut [u64; 8]) -> |model|::Event reaches |kernel|::Kernel {
        words[0] = |protocol_main|::DENIED;
        transition { _ -> (block send(gate, context, words)) }
    }
    machine send(gate: &|kernel|::Gate, context: &mut |main|::Context, words: &[u64; 8]) -> |model|::Event reaches |kernel|::Kernel {
        let status: u64 = block |server_main|::reply(gate, &mut context.owner, words);
        |diagnostic|::control(gate, context.clock, &mut context.trace, reply_phase(status));
        transition status == 0u64 {
            true -> (|model|::Event::Complete)
            _ -> failed(status)
        }
    }
}
machine reply_phase(status: u64) -> u64 { transition status == 0u64 { true -> (2u64) _ -> (3u64) } }
machine failed(code: u64) -> |model|::Event {
    |model|::Event::Failed { failure: |model|::Failure::Transport { code: code } }
}
