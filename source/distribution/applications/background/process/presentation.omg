module presentation;
// Encode only the actual 64-byte service protocol. The model sees named events.
use main::Context;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::services::main::Reply;
use app::model::Event;
use app::model::View;
use app::model::Failure;
use protocol::main;
use protocol::services::request;

public machine poll(gate: &Gate, context: &mut Context) -> Event reaches Kernel blocks; invokes Kernel; {
    let mut words: [u64; 8]; words[0] = MATRIX_POLL;
    let reply: Reply = block runtime::services::main::exchange(gate, &mut context.services, context.clock, &words);
    transition reply {
        Reply::Received { words } -> view(words)
        Reply::Failed { code } -> (Event::Failed { failure: Failure::Transport { code: code } })
    }
}
machine view(words: [u64; 8]) -> Event {
    transition words[0] == 0u64 {
        true -> (Event::View { view: View { epoch: words[1], width: words[2], height: words[3] } })
        _ -> (Event::NoView)
    }
}
public machine create(gate: &Gate, context: &mut Context, epoch: u64) -> Event reaches Kernel blocks; invokes Kernel; {
    let mut words: [u64; 8]; words[0] = SURFACE_CREATE; words[1] = epoch;
    let reply: Reply = block runtime::services::main::exchange(gate, &mut context.services, context.clock, &words);
    transition reply {
        Reply::Received { words } -> created(words)
        Reply::Failed { code } -> (Event::Failed { failure: Failure::Transport { code: code } })
    }
}
machine created(words: [u64; 8]) -> Event {
    transition words[0] == 0u64 {
        true -> (Event::Surface { handle: words[1] })
        _ -> (Event::Failed { failure: Failure::Provider { code: words[0] } })
    }
}
public machine paint(gate: &Gate, context: &mut Context, view: View, surface: u64, color: u64) -> Event reaches Kernel blocks; invokes Kernel; {
    let mut words: [u64; 8];
    words[0] = MATRIX_PAINT; words[1] = view.epoch; words[2] = surface;
    words[5] = view.width; words[6] = view.height; words[7] = color;
    let reply: Reply = block runtime::services::main::exchange(gate, &mut context.services, context.clock, &words);
    transition reply {
        Reply::Received { words } -> painted(words[0])
        Reply::Failed { code } -> (Event::Failed { failure: Failure::Transport { code: code } })
    }
}
machine painted(code: u64) -> Event {
    transition code == 0u64 {
        true -> (Event::Complete)
        _ -> (Event::Failed { failure: Failure::Provider { code: code } })
    }
}
public machine probe_storage(gate: &Gate, context: &mut Context) -> Event reaches Kernel blocks; invokes Kernel; {
    let words: [u64; 8] = request(2u64, 1u64, 1u64, 0u64);
    let reply: Reply = block runtime::services::main::exchange(gate, &mut context.services, context.clock, &words);
    transition reply {
        Reply::Received { words } -> storage(words[0])
        Reply::Failed { code } -> (Event::Failed { failure: Failure::Transport { code: code } })
    }
}
machine storage(code: u64) -> Event {
    transition code {
        UNAVAILABLE -> (Event::StorageDenied)
        0u64 -> (Event::Failed { failure: Failure::UnexpectedStorageGrant })
        _ -> (Event::Failed { failure: Failure::Transport { code: code } })
    }
}
