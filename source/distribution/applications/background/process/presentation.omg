// Encode only the actual 64-byte service protocol. The model sees named events.
use main.omg;
use exchange.omg;
use {runtime}/kernel.omg;
use {runtime}/services/main.omg as services_main;
use {app}/model.omg;
use {protocol}/main.omg as protocol_main;
use {protocol}/services.omg;

public machine poll(gate: &|kernel|::Gate, context: &mut |main|::Context) -> |model|::Event reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = |protocol_main|::MATRIX_POLL;
    let reply: |services_main|::Reply = block |exchange|::request(gate, context, &words);
    transition reply {
        |services_main|::Reply::Received { words } -> view(words)
        |services_main|::Reply::Failed { code } -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: code } })
    }
}
machine view(words: [u64; 8]) -> |model|::Event {
    transition words[0] == 0u64 {
        true -> (|model|::Event::View { view: |model|::View { epoch: words[1], width: words[2], height: words[3] } })
        _ -> (|model|::Event::NoView)
    }
}
public machine create(gate: &|kernel|::Gate, context: &mut |main|::Context, epoch: u64) -> |model|::Event reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = |protocol_main|::SURFACE_CREATE; words[1] = epoch;
    let reply: |services_main|::Reply = block |exchange|::request(gate, context, &words);
    transition reply {
        |services_main|::Reply::Received { words } -> created(words)
        |services_main|::Reply::Failed { code } -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: code } })
    }
}
machine created(words: [u64; 8]) -> |model|::Event {
    transition words[0] == 0u64 {
        true -> (|model|::Event::Surface { handle: words[1] })
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Provider { code: words[0] } })
    }
}
public machine paint(gate: &|kernel|::Gate, context: &mut |main|::Context, view: |model|::View, surface: u64, color: u64) -> |model|::Event reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut words: [u64; 8];
    words[0] = |protocol_main|::MATRIX_PAINT; words[1] = view.epoch; words[2] = surface;
    words[5] = view.width; words[6] = view.height; words[7] = color;
    let reply: |services_main|::Reply = block |exchange|::request(gate, context, &words);
    transition reply {
        |services_main|::Reply::Received { words } -> painted(words[0])
        |services_main|::Reply::Failed { code } -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: code } })
    }
}
machine painted(code: u64) -> |model|::Event {
    transition code == 0u64 {
        true -> (|model|::Event::Complete)
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Provider { code: code } })
    }
}
public machine probe_storage(gate: &|kernel|::Gate, context: &mut |main|::Context) -> |model|::Event reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let words: [u64; 8] = |services|::request(2u64, 1u64, 1u64, 0u64);
    let reply: |services_main|::Reply = block |exchange|::request(gate, context, &words);
    transition reply {
        |services_main|::Reply::Received { words } -> storage(words[0])
        |services_main|::Reply::Failed { code } -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: code } })
    }
}
machine storage(code: u64) -> |model|::Event {
    transition code {
        |protocol_main|::UNAVAILABLE -> (|model|::Event::StorageDenied)
        0u64 -> (|model|::Event::Failed { failure: |model|::Failure::UnexpectedStorageGrant })
        _ -> (|model|::Event::Failed { failure: |model|::Failure::Transport { code: code } })
    }
}
