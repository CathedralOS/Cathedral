use {runtime}/services/main.omg as services_main;
// Publish once; answer Background's independent owner while awaiting the broker.
// Neither a parking interval nor a control request cancels/replays presentation.
use main.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use {runtime}/connection/main.omg as connection_main;
use {runtime}/server/main.omg as server_main;
use {app}/model.omg;
use waiting.omg;

public machine request(gate: &|kernel|::Gate, context: &mut |main|::Context, words: &[u64; 8]) -> |services_main|::Reply
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block |connection_main|::begin(gate, &mut context.services.broker, words);
    transition status == 0u64 {
        true -> block poll(gate, context)
        _ -> (|services_main|::Reply::Failed { code: status })
    }
}
machine poll(gate: &|kernel|::Gate, context: &mut |main|::Context) -> |services_main|::Reply reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block owner(gate, context, value)
        |time|::Tick::Failed { code } -> block failed(gate, context, code)
    }
}
machine owner(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block query(gate, context, now)
        _ -> block broker(gate, context, now)
    }
    machine query(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
        let event: |server_main|::Event = block |server_main|::poll(gate, &mut context.owner, now);
        transition event {
            |server_main|::Event::Request { frame } -> block observed(gate, context, now, frame.bytes, frame.payload)
            _ -> block broker(gate, context, now)
        }
    }
    machine observed(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64, bytes: u64, words: [u64; 8]) -> |services_main|::Reply reaches |kernel|::Kernel {
        let accepted: bool = |waiting|::observe(gate, context, bytes, words);
        transition { _ -> block answer(gate, context, now, accepted) }
    }
    machine answer(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64, accepted: bool) -> |services_main|::Reply reaches |kernel|::Kernel {
        let event: |model|::Event = block |waiting|::reply(gate, context, accepted);
        transition event {
            |model|::Event::Complete -> block broker(gate, context, now)
            _ -> block retire_owner(gate, context, now)
        }
    }
}
machine retire_owner(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    block |server_main|::close(gate, &mut context.owner);
    transition { _ -> (block broker(gate, context, now)) }
}
machine broker(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    let reply: |connection_main|::Reply = block |connection_main|::poll(gate, &mut context.services.broker, now);
    transition reply {
        |connection_main|::Reply::Object { frame, object } ->
            block |services_main|::unexpected_object(gate, &mut context.services, object)
        |connection_main|::Reply::Endpoint { frame, endpoint } ->
            block |services_main|::unexpected_endpoint(gate, &mut context.services, endpoint)
        |connection_main|::Reply::Complete { frame, notification } ->
            block |services_main|::received(gate, &mut context.services, frame, notification)
        |connection_main|::Reply::Failed { code } -> (|services_main|::Reply::Failed { code: code })
        |connection_main|::Reply::Pending -> block park(gate, context, now)
    }
}
machine park(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    let deadline: u64 = |time|::after(now, 300u64);
    transition context.services.broker.partial && |time|::reached(deadline, context.services.broker.partial_deadline) {
        true -> block interests(gate, context, context.services.broker.partial_deadline)
        _ -> block interests(gate, context, deadline)
    }
}
machine interests(gate: &|kernel|::Gate, context: &mut |main|::Context, deadline: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    let mut interests: [u64; 8];
    interests[0] = 2u64; interests[1] = context.services.broker.bell.wait;
    interests[3] = context.services.broker.receiver;
    transition context.owner.peer.fault == 0u64 {
        true -> block combined(gate, context, &mut interests, deadline)
        _ -> block wait(gate, context, &interests, 2u64, deadline)
    }
    machine combined(gate: &|kernel|::Gate, context: &mut |main|::Context, interests: &mut [u64; 8], deadline: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
        interests[4] = 2u64; interests[5] = context.owner.peer.bell.wait;
        interests[7] = context.owner.peer.receiver;
        transition { _ -> (block wait(gate, context, interests, 4u64, deadline)) }
    }
}
machine wait(gate: &|kernel|::Gate, context: &mut |main|::Context, interests: &[u64; 8], count: u64 [0..=4], deadline: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    let status: u64 = block |kernel|::Kernel::wait(gate, interests, count, deadline);
    // Recheck both streams after peer closure; a final complete reply may exist.
    transition status < count || status == |kernel|::TIMED_OUT || status == |kernel|::PEER_CLOSED {
        true -> (block poll(gate, context))
        _ -> block interrupted(gate, context, status)
    }
}
machine interrupted(gate: &|kernel|::Gate, context: &mut |main|::Context, code: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    // An owner grant can be revoked between polling and parking. Retire that
    // stream and let the broker's own poll decide its independent validity.
    transition context.owner.peer.fault == 0u64 {
        true -> block detached(gate, context)
        _ -> block failed(gate, context, code)
    }
    machine detached(gate: &|kernel|::Gate, context: &mut |main|::Context) -> |services_main|::Reply reaches |kernel|::Kernel {
        block |server_main|::close(gate, &mut context.owner);
        transition { _ -> (block poll(gate, context)) }
    }
}
machine failed(gate: &|kernel|::Gate, context: &mut |main|::Context, code: u64) -> |services_main|::Reply reaches |kernel|::Kernel {
    block |services_main|::close(gate, &mut context.services);
    |services_main|::Reply::Failed { code: code }
}
