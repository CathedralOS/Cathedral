module storage::storage;

// Confirm before displaying a toggle. After uncertainty, read; never replay.
use state::State;
use state::Phase;
use state::StorageStep;
use operations::Command;
use operations::Reply;
use session::session;
use storage::record;
use protocol::main;

public machine load(s: &mut State) -> Command {
    s.phase = Phase::Storage { step: StorageStep::Bound };
    s.loading = true;
    Command::BindStorage
}

public machine toggle(s: &mut State) -> Command {
    s.phase = Phase::Storage { step: StorageStep::Saved };
    Command::Publish { object: s.object, revision: s.revision, realm: 0u64,
        bytes: storage::record::encode((s.alternate ^ 1u64) & 1u64) }
}

public machine complete(s: &mut State, step: StorageStep, reply: Reply) -> Command {
    transition reply {
        Reply::Bound { status, realm } -> bound(s, status, realm)
        Reply::Listed { status, count, object } -> listed(s, step, status, count, object)
        Reply::Created { status } -> created(s, status)
        Reply::Read { status, revision, length, bytes } -> read(s, status, revision, length, bytes)
        Reply::Saved { status, object, revision } -> saved(s, status, object, revision)
        _ -> (Command::Exit)
    }
}

machine bound(s: &mut State, status: u64, realm: u64) -> Command {
    transition status == 0u64 {
        true -> listing(s, realm)
        _ -> failed(s, status)
    }
    machine listing(s: &mut State, realm: u64) -> Command {
        s.realm = realm;
        s.phase = Phase::Storage { step: StorageStep::Listed };
        Command::List { realm: realm }
    }
}

machine listed(s: &mut State, step: StorageStep, status: u64, count: u64, object: u64) -> Command {
    transition status == 0u64 {
        true -> entries(s, step, count, object)
        _ -> failed(s, status)
    }
    machine entries(s: &mut State, step: StorageStep, count: u64, object: u64) -> Command {
        transition count != 0u64 {
            true -> reading(s, object)
            _ -> empty(s, step)
        }
    }
    machine empty(s: &mut State, step: StorageStep) -> Command {
        transition step {
            StorageStep::Listed -> create(s)
            _ -> absent(s)
        }
    }
    machine absent(s: &mut State) -> Command {
        let status: u64 = s.creation_error;
        transition status == 0u64 {
            true -> failed(s, IO_ERROR)
            _ -> failed(s, status)
        }
    }
    machine reading(s: &mut State, object: u64) -> Command {
        s.object = object;
        s.phase = Phase::Storage { step: StorageStep::Read };
        Command::Read { object: object }
    }
}

machine create(s: &mut State) -> Command {
    s.phase = Phase::Storage { step: StorageStep::Created };
    Command::Publish { object: 0u64, revision: 0u64, realm: s.realm,
        bytes: storage::record::encode(0u64) }
}

machine created(s: &mut State, status: u64) -> Command {
    s.creation_error = status;
    s.phase = Phase::Storage { step: StorageStep::Relisted };
    Command::List { realm: s.realm }
}

machine read(s: &mut State, status: u64, revision: u64, length: u64, bytes: [u8; 6]) -> Command {
    transition status == 0u64 {
        true -> validate(s, revision, length, bytes)
        _ -> failed(s, status)
    }
    machine validate(s: &mut State, revision: u64, length: u64, bytes: [u8; 6]) -> Command {
        transition storage::record::valid(length, &bytes) {
            true -> loaded(s, revision, bytes[5] as u64)
            _ -> failed(s, IO_ERROR)
        }
    }
    machine loaded(s: &mut State, revision: u64, alternate: u64) -> Command {
        s.revision = revision;
        s.alternate = alternate;
        s.error = 0u64;
        s.dirty = true;
        s.loading = false;
        session::session::poll(s)
    }
}

machine saved(s: &mut State, status: u64, object: u64, revision: u64) -> Command {
    transition status == 0u64 {
        true -> confirmed(s, object, revision)
        _ -> failed(s, status)
    }
    machine confirmed(s: &mut State, object: u64, revision: u64) -> Command {
        s.object = object;
        s.revision = revision;
        s.alternate = (s.alternate ^ 1u64) & 1u64;
        s.error = 0u64;
        s.dirty = true;
        session::session::after_input(s)
    }
}

public machine failed(s: &mut State, status: u64) -> Command {
    s.error = status;
    s.dirty = true;
    transition s.loading {
        true -> resume(s)
        _ -> session::session::after_input(s)
    }
    machine resume(s: &mut State) -> Command {
        s.loading = false;
        session::session::poll(s)
    }
}
