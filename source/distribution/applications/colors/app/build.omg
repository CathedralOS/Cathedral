machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_colors");
    Build::depend_as(builder, "host", Source::Path { location: "../../../../platform/libraries/app-host" });
    Build::depend_as(builder, "protocol", Source::Path { location: "../../../../platform/contracts/reference" });
    Build::select_provider<Colors, ColorsProvider>(builder);
    Build::bind(builder, linux_x86_64::ProgramEntry, component_entry);
}
