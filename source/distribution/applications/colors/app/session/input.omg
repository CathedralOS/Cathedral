module session::input;

// One acceptance interface, independent pointer edges per scoped channel.
// Metadata/key cancellation never manufactures a pointer press.
use state::State;
use operations::Input;
use operations::Command;
use session::session;
use storage::storage;
use protocol::main;

public machine reset_channels(s: &mut State) {
    s.channels[0] = 0u64;
    s.channels[1] = 0u64;
    s.channels[2] = 0u64;
    s.channels[3] = 0u64;
    s.buttons[0] = 0u64;
    s.buttons[1] = 0u64;
    s.buttons[2] = 0u64;
    s.buttons[3] = 0u64;
}

public machine accept(s: &mut State, event: Input) -> Command {
    transition event {
        Input::Pointer { channel, buttons, x, y } -> pointer(s, channel, buttons, x, y)
        Input::Key { code, action } -> key(s, code, action)
        Input::Cancel { channel, retire } -> cancel(s, channel, retire)
        _ -> session::session::after_input(s)
    }
}

machine key(s: &mut State, code: u64, action: u64) -> Command {
    transition code == ENTER && action == PRESS {
        true -> enter(s)
        _ -> session::session::after_input(s)
    }
    machine enter(s: &mut State) -> Command {
        transition s.error == 0u64 {
            true -> storage::storage::toggle(s)
            _ -> storage::storage::load(s)
        }
    }
}

machine cancel(s: &mut State, channel: u64, retire: bool) -> Command {
    let slot: u64 = find(s, channel, 0u64);
    transition slot < 4u64 {
        true -> clear(s, slot, retire)
        _ -> session::session::after_input(s)
    }
    machine clear(s: &mut State, slot: u64, retire: bool) -> Command requires slot < 4u64 {
        s.buttons[slot] = 0u64;
        transition retire {
            true -> forget(s, slot)
            _ -> session::session::after_input(s)
        }
    }
    machine forget(s: &mut State, slot: u64) -> Command requires slot < 4u64 {
        s.channels[slot] = 0u64;
        session::session::after_input(s)
    }
}

machine pointer(s: &mut State, channel: u64, buttons: u64, x: u64, y: u64) -> Command {
    s.pointers = ((s.pointers as u64 in Saturating) + 1) as u64;
    transition channel != 0u64 {
        true -> locate(s, channel, buttons, x, y)
        _ -> session::session::after_input(s)
    }
    machine locate(s: &mut State, channel: u64, buttons: u64, x: u64, y: u64) -> Command {
        let slot: u64 = find(s, channel, 0u64);
        transition slot < 4u64 {
            true -> edge(s, channel, buttons, x, y, slot)
            _ -> available(s, channel, buttons, x, y)
        }
    }
    machine available(s: &mut State, channel: u64, buttons: u64, x: u64, y: u64) -> Command {
        let slot: u64 = find(s, 0u64, 0u64);
        transition slot < 4u64 {
            true -> edge(s, channel, buttons, x, y, slot)
            _ -> session::session::after_input(s)
        }
    }
    machine edge(s: &mut State, channel: u64, buttons: u64, x: u64, y: u64, slot: u64) -> Command
        requires slot < 4u64
    {
        let pressed: bool = (buttons & 1u64) != 0u64 && (s.buttons[slot] & 1u64) == 0u64;
        s.channels[slot] = channel;
        s.buttons[slot] = buttons;
        transition pressed {
            true -> clicked(s, x, y)
            _ -> session::session::after_input(s)
        }
    }
}

machine clicked(s: &mut State, x: u64, y: u64) -> Command {
    transition s.confirm {
        true -> hit(s, x, y, 156u64)
        _ -> hit(s, x, y, 20u64)
    }
    machine hit(s: &mut State, x: u64, y: u64, width: u64) -> Command {
        let left: u64 in Saturating = (s.width as u64 in Saturating) - ((width as u64 in Saturating) + 4);
        let right: u64 in Saturating = (s.width as u64 in Saturating) - 4;
        transition x >= left && x < right && y >= 2u64 && y < 18u64 {
            true -> close(s)
            _ -> dismiss(s)
        }
    }
    machine close(s: &mut State) -> Command {
        transition s.error == 0u64 || s.confirm {
            true -> (Command::Exit)
            _ -> confirm(s)
        }
    }
    machine confirm(s: &mut State) -> Command {
        s.confirm = true;
        s.dirty = true;
        session::session::after_input(s)
    }
    machine dismiss(s: &mut State) -> Command {
        s.dirty = s.dirty || s.confirm;
        s.confirm = false;
        session::session::after_input(s)
    }
}

machine find(s: &State, name: u64, index: u64) -> u64 {
    transition index < 4u64 {
        true -> inspect(s, name, index)
        _ -> (4u64)
    }
    machine inspect(s: &State, name: u64, index: u64) -> u64 requires index < 4u64 {
        transition s.channels[index] == name {
            true -> (index)
            _ -> find(s, name, index + 1u64)
        }
    }
}
