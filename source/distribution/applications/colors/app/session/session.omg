module session::session;

// Acquire -> load -> receive -> act -> present, yielding one operation at a time.
use state::State;
use state::Phase;
use operations::Command;
use operations::Reply;
use operations::View;
use control::report;
use storage::storage;
use rendering::rendering;
use session::input;

public machine resume(s: &mut State, reply: Reply) -> Command {
    transition s.phase {
        Phase::Start -> acquire_interaction(s)
        Phase::InteractionReady -> acquire_storage(s)
        Phase::StorageReady -> storage::storage::load(s)
        Phase::Polled -> polled(s, reply)
        Phase::Awakened -> awakened(s, reply)
        Phase::ControlReplied -> wait(s)
        Phase::Storage { step } -> storage::storage::complete(s, step, reply)
        Phase::Rendering { step } -> rendering::rendering::complete(s, step, reply)
    }
}

machine acquire_interaction(s: &mut State) -> Command {
    s.phase = Phase::InteractionReady;
    Command::AcquireInteraction
}

machine acquire_storage(s: &mut State) -> Command {
    s.phase = Phase::StorageReady;
    Command::AcquireStorage
}

public machine poll(s: &mut State) -> Command {
    s.phase = Phase::Polled;
    Command::Poll
}

machine polled(s: &mut State, reply: Reply) -> Command {
    transition reply {
        Reply::View { view } -> observed(s, view)
        _ -> (Command::Exit)
    }
}

machine observed(s: &mut State, view: View) -> Command {
    transition view.status == 0u64 && view.epoch != 0u64
        && view.width != 0u64 && view.height != 0u64
        && view.width < 65536u64 && view.height < 65536u64 {
        true -> accept(s, view)
        _ -> hidden(s)
    }
    machine hidden(s: &mut State) -> Command {
        s.scene = false;
        s.dirty = true;
        wait(s)
    }
    machine accept(s: &mut State, view: View) -> Command {
        transition s.epoch != view.epoch {
            true -> rebound(s, view)
            _ -> geometry(s, view)
        }
    }
    machine rebound(s: &mut State, view: View) -> Command {
        session::input::reset_channels(s);
        s.scene = false;
        s.dirty = true;
        s.epoch = view.epoch;
        geometry(s, view)
    }
    machine geometry(s: &mut State, view: View) -> Command {
        s.dirty = s.dirty || s.width != view.width || s.height != view.height;
        s.width = view.width;
        s.height = view.height;
        s.frames = view.frames;
        s.more = view.more;
        s.drained = ((s.drained as u64 in Saturating) + 1) as u64;
        session::input::accept(s, view.input)
    }
}

public machine after_input(s: &mut State) -> Command {
    transition s.more && s.drained < 8u64 {
        true -> poll(s)
        _ -> rendering::rendering::render(s)
    }
}

public machine wait(s: &mut State) -> Command {
    s.drained = 0u64;
    s.phase = Phase::Awakened;
    Command::Wait
}

machine awakened(s: &mut State, reply: Reply) -> Command {
    transition reply {
        Reply::Wake -> wake(s)
        Reply::Control { loss, cpu } -> control(s, loss, cpu)
        _ -> (Command::Exit)
    }
    machine wake(s: &mut State) -> Command {
        s.wakes = ((s.wakes as u64 in Saturating) + 1) as u64;
        poll(s)
    }
    machine control(s: &mut State, loss: bool, cpu: u64) -> Command {
        s.phase = Phase::ControlReplied;
        Command::Control { report: report(s, loss, cpu) }
    }
}
