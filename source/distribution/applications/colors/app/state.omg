module state;

public data StorageStep [copy] {
    case Bound;
    case Listed;
    case Created;
    case Relisted;
    case Read;
    case Saved;
}

public data RenderStep [copy] {
    case SurfaceCreated;
    case CheckerReady;
    case RectanglesReady;
    case CloseReady;
    case ViewRechecked;
}

public data Phase [copy] {
    case Start;
    case InteractionReady;
    case StorageReady;
    case Polled;
    case Awakened;
    case ControlReplied;
    case Storage(step: StorageStep);
    case Rendering(step: RenderStep);
}

// App-owned state; the native host does not mirror or interpret this layout.
public data State {
    phase: Phase;
    realm: u64;
    object: u64;
    revision: u64;
    alternate: u64;
    error: u64;
    creation_error: u64;
    loading: bool;
    epoch: u64;
    width: u64;
    height: u64;
    frames: bool;
    more: bool;
    surfaces: [u64; 4];
    rank: u64;
    dirty: bool;
    scene: bool;
    confirm: bool;
    paint_revision: u64;
    channels: [u64; 4];
    buttons: [u64; 4];
    drained: u64;
    paints: u64;
    wakes: u64;
    pointers: u64;
}
