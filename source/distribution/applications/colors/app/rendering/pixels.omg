// App-owned raster assets; the host sees only immutable attachment bytes.
public machine checker_pixels(p: &mut [u64; 4096]) {
    transition { _ -> fill(p, 0u64) }
    state fill(p: &mut [u64; 4096], index: u64) {
        transition index < 512u64 { true -> pixel(p, index) _ -> done() }
    }
    state pixel(p: &mut [u64; 4096], index: u64) requires index < 512u64 {
        let color: u64 = checker(index * 2u64);
        p[16u64 + index] = color | (color << 32u64);
        transition { _ -> fill(p, index + 1u64) }
    }
    state done() {}
}
machine checker(index: u64) -> u64 {
    transition (((index % 32u64) / 8u64) ^ (index / 256u64)) & 1u64 {
        0u64 -> (0xffcc44u64) _ -> (0x7755ddu64)
    }
}
public machine close_pixels(p: &mut [u64; 4096], width: u64) {
    transition width == 20u64 || width == 156u64 { true -> fill(p, width, 0u64) _ -> done() }
    state fill(p: &mut [u64; 4096], width: u64, index: u64) {
        transition index < (((width as u64 in Saturating) * 8) as u64) && index < 1248u64 { true -> pixel(p, width, index) _ -> done() }
    }
    state pixel(p: &mut [u64; 4096], width: u64, index: u64) requires index < 1248u64 {
        let lo: u64 = close_pixel(width, index * 2u64);
        let hi: u64 = close_pixel(width, index * 2u64 + 1u64);
        p[16u64 + index] = lo | (hi << 32u64);
        transition { _ -> fill(p, width, index + 1u64) }
    }
    state done() {}
}
machine close_pixel(width: u64, index: u64) -> u64 {
    transition width != 0u64 { true -> position(width, index % width, index / width) _ -> (0x993f46u64) }
    state position(width: u64, x: u64, y: u64) -> u64 {
        transition x >= 5u64 && y >= 1u64 && y < 15u64 { true -> letter(width, (x - 5u64) / 12u64, ((x - 5u64) % 12u64) / 2u64, (y - 1u64) / 2u64) _ -> (0x993f46u64) }
    }
    state letter(width: u64, index: u64, x: u64, row: u64) -> u64 {
        transition x < 5u64 && row < 7u64 { true -> bit(width, index, x, row) _ -> (0x993f46u64) }
    }
    state bit(width: u64, index: u64, x: u64, row: u64) -> u64 requires x < 5u64 && row < 7u64 {
        let bits: u64 = glyph(width, index);
        transition ((bits >> (row * 8u64)) & (1u64 << (4u64 - x))) != 0u64 { true -> (0xffffffu64) _ -> (0x993f46u64) }
    }
}
machine glyph(width: u64, index: u64) -> u64 {
    transition width == 20u64 { true -> short(index) _ -> long(index) }
    state short(index: u64) -> u64 { transition index { 0u64 -> (4803809319194897u64) _ -> (0u64) } }
    state long(index: u64) -> u64 {
        transition index {
            0u64 -> (3959410360586510u64)
            1u64 -> (8743385453039632u64)
            2u64 -> (3959414672396558u64)
            3u64 -> (8445353343848463u64)
            4u64 -> (8743385687920671u64)
            5u64 -> (0u64)
            6u64 -> (4803839837409550u64)
            7u64 -> (4803839636347153u64)
            8u64 -> (1130315200991505u64)
            9u64 -> (4814851965784337u64)
            10u64 -> (4803839837409550u64)
            11u64 -> (1130315200991505u64)
            _ -> (0u64)
        }
    }
}
