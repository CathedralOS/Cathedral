machine build(builder: &mut Build) {
    Build::application(builder, "cathedral_colors_native");
    Build::depend_as(builder, "component", Source::Path { location: "../component" });
    Build::depend_as(builder, "app", Source::Path { location: "../../app" });
    Build::select_provider<component::main::Colors, component::main::ColorsProvider>(builder, CompositionMode::Independent);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
