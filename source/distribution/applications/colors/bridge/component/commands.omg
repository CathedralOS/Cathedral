use {app}/operations.omg;
use {host}/main.omg;
use {protocol}/main.omg as protocol_main;
use images.omg;

public machine encode(command: |operations|::Command, p: &mut [u64; 4096]) -> u64 {
    |main|::message(p, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
    transition command {
        |operations|::Command::Exit -> (|main|::EXIT)
        |operations|::Command::AcquireInteraction -> acquire(p, |main|::INTERACTION)
        |operations|::Command::AcquireStorage -> acquire(p, |main|::STORAGE)
        |operations|::Command::BindStorage -> (|main|::BIND)
        |operations|::Command::List { realm } -> listing(p, realm)
        |operations|::Command::Read { object } -> reading(p, object)
        |operations|::Command::Publish { object, revision, realm, bytes } -> publish(p, object, revision, realm, bytes)
        |operations|::Command::Poll -> poll(p)
        |operations|::Command::View -> view(p)
        |operations|::Command::CreateSurface { epoch, rank } -> create(p, epoch, rank)
        |operations|::Command::Image { epoch, surface, x, y, asset } -> |images|::encode(p, epoch, surface, x, y, asset)
        |operations|::Command::Rectangles { epoch, revision, background, indicator } -> rectangles(p, epoch, revision, background, indicator)
        |operations|::Command::Wait -> (|main|::WAIT)
        |operations|::Command::Control { report } -> control(p, report)
    }
}

machine acquire(p: &mut [u64; 4096], operation: u64) -> u64 {
    p[0] = 1u64;
    p[1] = 1u64;
    operation
}

machine listing(p: &mut [u64; 4096], realm: u64) -> u64 {
    p[0] = |protocol_main|::STORE_LIST;
    p[1] = realm;
    |main|::STORE
}

machine reading(p: &mut [u64; 4096], object: u64) -> u64 {
    |main|::message(p, |protocol_main|::STORE_READ, object, 0u64, 0u64, 6u64, 0u64, 0u64, 0u64);
    |main|::STORE
}

machine publish(p: &mut [u64; 4096], object: u64, revision: u64, realm: u64, bytes: [u8; 6]) -> u64 {
    |main|::message(p, |protocol_main|::STORE_PUBLISH, object, revision, realm, 6u64, 0u64, 0u64, 0u64);
    p[16] = (bytes[0] as u64) | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64) | ((bytes[3] as u64) << 24u64)
        | ((bytes[4] as u64) << 32u64) | ((bytes[5] as u64) << 40u64);
    p[8] = 6u64;
    |main|::STORE
}

machine poll(p: &mut [u64; 4096]) -> u64 {
    p[0] = |protocol_main|::MATRIX_POLL;
    |main|::EXCHANGE
}

machine view(p: &mut [u64; 4096]) -> u64 {
    p[0] = |protocol_main|::MATRIX_VIEW;
    |main|::EXCHANGE
}

machine create(p: &mut [u64; 4096], epoch: u64, rank: u64) -> u64 {
    |main|::message(p, |protocol_main|::SURFACE_CREATE, epoch, rank, 0u64, 0u64, 0u64, 0u64, 0u64);
    |main|::EXCHANGE
}

// The platform packs two rectangles into one message; the app owns geometry.
machine rectangles(p: &mut [u64; 4096], epoch: u64, revision: u64, a: |operations|::Rectangle, b: |operations|::Rectangle) -> u64 {
    |main|::message(p, |protocol_main|::PRESENT_RECTS, epoch, revision, a.surface,
        (a.x & 65535u64) | ((a.y & 65535u64) << 16u64)
            | ((a.width & 65535u64) << 32u64) | ((a.height & 65535u64) << 48u64),
        a.color | ((b.surface & 4294967295u64) << 32u64),
        (b.surface >> 32u64) | ((b.x & 65535u64) << 32u64) | ((b.y & 65535u64) << 48u64),
        (b.width & 65535u64) | ((b.height & 65535u64) << 16u64) | ((b.color & 4294967295u64) << 32u64));
    |main|::EXCHANGE
}

machine control(p: &mut [u64; 4096], report: |operations|::Report) -> u64 {
    transition report {
        |operations|::Report::Loss { error } -> loss(p, error)
        |operations|::Report::Health { paints, wakes, cpu, alternate, error, pointers, revision } -> health(p, paints, wakes, cpu, alternate, error, pointers, revision)
    }
    machine loss(p: &mut [u64; 4096], error: u64) -> u64 {
        p[1] = error;
        |main|::CONTROL
    }
    machine health(p: &mut [u64; 4096], paints: u64, wakes: u64, cpu: u64, alternate: u64, error: u64, pointers: u64, revision: u64) -> u64 {
        |main|::message(p, 0u64, paints, wakes, cpu, alternate, error, pointers, revision);
        |main|::CONTROL
    }
}
