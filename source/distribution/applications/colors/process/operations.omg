// App intent dispatches to service acquisition, storage, presentation or waiting.
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use services.omg;
use storage.omg;
use presentation.omg;
use waiting.omg;
use control.omg;

public machine execute(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command) -> |operations|::Completion reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition command {
        |operations|::Command::AcquireInteraction -> block interaction(gate, context, state)
        |operations|::Command::AcquireStorage -> block acquire_storage(gate, context, state)
        |operations|::Command::BindStorage -> block |storage|::bind(gate, context, state)
        |operations|::Command::List { realm } -> block |storage|::execute(gate, context, state, command)
        |operations|::Command::Read { object } -> block |storage|::execute(gate, context, state, command)
        |operations|::Command::Publish { object, revision, realm, bytes } -> block |storage|::execute(gate, context, state, command)
        |operations|::Command::Wait -> block |waiting|::next(gate, context, state)
        |operations|::Command::Control { report } -> block report(gate, context, report)
        _ -> block |presentation|::execute(gate, context, state, command)
    }
}
machine interaction(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) -> |operations|::Completion reaches |kernel|::Kernel {
    let status: u64 = block |services|::interaction(gate, context, state);
    |operations|::Completion { transport_status: status, reply: |operations|::Reply::Complete }
}
machine acquire_storage(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) -> |operations|::Completion reaches |kernel|::Kernel {
    let status: u64 = block |services|::storage(gate, context, state);
    |operations|::Completion { transport_status: status, reply: |operations|::Reply::Complete }
}
machine report(gate: &|kernel|::Gate, context: &mut |main|::Context, report: |operations|::Report) -> |operations|::Completion reaches |kernel|::Kernel {
    block |control|::answer(gate, context, report);
    |operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Complete }
}
