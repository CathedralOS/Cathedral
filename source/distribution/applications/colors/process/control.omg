// The independent owner never has to wait for a storage or compositor reply.
use main.omg;
use {app}/state.omg as app_state;
use {app}/control.omg;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/server/main.omg as server_main;
use {protocol}/main.omg as protocol_main;

public machine poll(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64)
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block receive(gate, context, state, now)
        _ -> done()
    }
}
machine receive(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) reaches |kernel|::Kernel {
    let event: |server_main|::Event = block |server_main|::poll(gate, &mut context.owner, now);
    transition event {
        |server_main|::Event::Request { frame } -> block request(gate, context, state, frame.bytes, frame.payload)
        _ -> done()
    }
}
machine request(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, bytes: u64, words: [u64; 8]) reaches |kernel|::Kernel {
    transition bytes == 64u64 && (words[0] == |protocol_main|::HEALTH || words[0] == |protocol_main|::LOSS)
        && words[1] == 0u64 && words[2] == 0u64 && words[3] == 0u64 && words[4] == 0u64
        && words[5] == 0u64 && words[6] == 0u64 && words[7] == 0u64 {
        true -> block answer(gate, context, |control|::report(state, words[0] == |protocol_main|::LOSS, 0u64))
        _ -> block refuse(gate, context)
    }
}
machine refuse(gate: &|kernel|::Gate, context: &mut |main|::Context) reaches |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = |protocol_main|::INVALID_ARGUMENT;
    block send(gate, context, &words);
}
public machine answer(gate: &|kernel|::Gate, context: &mut |main|::Context, report: |operations|::Report) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition report {
        |operations|::Report::Loss { error } -> block loss(gate, context, error)
        |operations|::Report::Health { paints, wakes, cpu, alternate, error, pointers, revision } ->
            block health(gate, context, paints, wakes, cpu, alternate, error, pointers, revision)
    }
    machine loss(gate: &|kernel|::Gate, context: &mut |main|::Context, error: u64) reaches |kernel|::Kernel {
        let words: [u64; 8] = [0u64, error, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64];
        block send(gate, context, &words);
    }
    machine health(gate: &|kernel|::Gate, context: &mut |main|::Context, paints: u64, wakes: u64, cpu: u64,
        alternate: u64, error: u64, pointers: u64, revision: u64) reaches |kernel|::Kernel {
        let words: [u64; 8] = [0u64, paints, wakes, cpu, alternate, error, pointers, revision];
        block send(gate, context, &words);
    }
}
machine send(gate: &|kernel|::Gate, context: &mut |main|::Context, words: &[u64; 8]) reaches |kernel|::Kernel {
    let status: u64 = block |server_main|::reply(gate, &mut context.owner, words);
    transition status == 0u64 {
        true -> done()
        _ -> block |server_main|::close(gate, &mut context.owner)
    }
}
machine done() {}
