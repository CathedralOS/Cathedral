use {runtime}/connection/main.omg as connection_main;
// Seal app-owned pixels/data -> publish once -> retain through completion ->
// release locally. Accepted compositor readers have independent lifetimes.
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/connection/call.omg;
use exchange.omg;
use replies.omg;

public machine retained(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command,
    storage: bool, words: &[u64; 8], object: u64, deadline: u64) -> |operations|::Completion reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let result: |operations|::Completion = block plain(gate, context, state, command, storage, words, object, deadline);
    let released: u64 = block |kernel|::Kernel::memory_release(gate, object);
    result
}
public machine plain(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command,
    storage: bool, words: &[u64; 8], object: u64, deadline: u64) -> |operations|::Completion reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let reply: |call|::CallReply = block |exchange|::request(gate, context, state, storage, words, object, deadline);
    transition reply {
        |call|::CallReply::Received { frame, notification } -> block received(gate, context, command, frame, notification)
        |call|::CallReply::Object { frame, object } -> block unexpected_object(gate, context, object)
        |call|::CallReply::Endpoint { frame, endpoint } -> block unexpected_endpoint(gate, context, endpoint)
        |call|::CallReply::Failed { code } -> |replies|::failed(code)
    }
}
machine received(gate: &|kernel|::Gate, context: &mut |main|::Context, command: |operations|::Command, frame: |connection_main|::Frame, notification: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && notification == 0u64 {
        true -> |replies|::decoded(command, frame.payload)
        _ -> block unexpected_notification(gate, context, notification)
    }
}
machine unexpected_endpoint(gate: &|kernel|::Gate, context: &mut |main|::Context, endpoint: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    transition { _ -> block malformed(gate, context) }
}
machine unexpected_notification(gate: &|kernel|::Gate, context: &mut |main|::Context, notification: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    transition { _ -> block malformed(gate, context) }
}
machine malformed(gate: &|kernel|::Gate, context: &mut |main|::Context) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = block retire(gate, context);
    |replies|::failed(|kernel|::IO_ERROR)
}
machine retire(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel {
    transition context.pending_storage {
        true -> block |connection_main|::close(gate, &mut context.storage.peer)
        _ -> block |connection_main|::close(gate, &mut context.services.broker)
    }
}

machine unexpected_object(gate: &|kernel|::Gate, context: &mut |main|::Context, object: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    transition { _ -> block malformed(gate, context) }
}
