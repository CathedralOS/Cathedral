use {runtime}/connection/main.omg as connection_main;
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use {runtime}/connection/call.omg;
use {runtime}/memory/object.omg;
use {runtime}/storage/main.omg as storage_main;
use exchange.omg;
use transfer.omg;
use replies.omg;

public machine bind(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) -> |operations|::Completion reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block binding(gate, context, state, value)
        |time|::Tick::Failed { code } -> |replies|::failed(code)
    }
}
machine binding(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let words: [u64; 8] = |storage_main|::bind_request(now);
    let reply: |call|::CallReply = block |exchange|::request(gate, context, state, true, &words, 0u64, words[7]);
    transition reply {
        |call|::CallReply::Received { frame, notification } -> block bound(gate, context, frame, notification)
        |call|::CallReply::Object { frame, object } -> block object(gate, context, object)
        |call|::CallReply::Endpoint { frame, endpoint } -> block endpoint(gate, context, endpoint)
        |call|::CallReply::Failed { code } -> |replies|::failed(code)
    }
}
machine bound(gate: &|kernel|::Gate, context: &mut |main|::Context, frame: |connection_main|::Frame, notification: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && notification == 0u64 {
        true -> installed(context, frame.payload)
        _ -> block notification(gate, context, notification)
    }
}
machine installed(context: &mut |main|::Context, words: [u64; 8]) -> |operations|::Completion {
    let status: u64 = |storage_main|::bound(&mut context.storage, words);
    |operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Bound { status: status, realm: context.storage.realm } }
}
machine endpoint(gate: &|kernel|::Gate, context: &mut |main|::Context, endpoint: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    transition { _ -> block malformed(gate, context) }
}
machine notification(gate: &|kernel|::Gate, context: &mut |main|::Context, notification: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    transition { _ -> block malformed(gate, context) }
}
machine malformed(gate: &|kernel|::Gate, context: &mut |main|::Context) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = block |connection_main|::close(gate, &mut context.storage.peer);
    |replies|::failed(|kernel|::IO_ERROR)
}
public machine execute(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command) -> |operations|::Completion reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block scoped(gate, context, state, command, value)
        |time|::Tick::Failed { code } -> |replies|::failed(code)
    }
}
machine scoped(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command, now: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let mut words: [u64; 8] = encode(command);
    let status: u64 = |storage_main|::request(&context.storage, &mut words, now);
    transition status == 0u64 {
        true -> block send(gate, context, state, command, &words)
        _ -> |replies|::failed(status)
    }
}
machine send(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command, words: &[u64; 8]) -> |operations|::Completion reaches |kernel|::Kernel {
    transition command {
        |operations|::Command::Publish { object, revision, realm, bytes } -> block publish(gate, context, state, command, words, bytes)
        _ -> block |transfer|::plain(gate, context, state, command, true, words, 0u64, words[7])
    }
}
machine publish(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command, words: &[u64; 8], bytes: [u8; 6]) -> |operations|::Completion reaches |kernel|::Kernel {
    let created: |object|::Creation = block record(gate, bytes);
    transition created {
        |object|::Creation::Ready { object } -> block |transfer|::retained(gate, context, state, command, true, words, object.handle, words[7])
        |object|::Creation::Failed { code } -> |replies|::failed(code)
    }
}
// The staging frame ends before any service or owner-control wait begins.
machine record(gate: &|kernel|::Gate, bytes: [u8; 6]) -> |object|::Creation reaches |kernel|::Kernel {
    let mut buffer: [u64; 2048];
    buffer[0] = (bytes[0] as u64) | ((bytes[1] as u64) << 8u64) | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64) | ((bytes[4] as u64) << 32u64) | ((bytes[5] as u64) << 40u64);
    block |object|::create(gate, &buffer, 6u64)
}

machine encode(command: |operations|::Command) -> [u64; 8] {
    transition command {
        |operations|::Command::List { realm } -> ([6u64, realm, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::Read { object } -> ([2u64, object, 0u64, 0u64, 6u64, 0u64, 0u64, 0u64])
        |operations|::Command::Publish { object, revision, realm, bytes } -> ([3u64, object, revision, realm, 6u64, 0u64, 0u64, 0u64])
        _ -> ([0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
    }
}

machine object(gate: &|kernel|::Gate, context: &mut |main|::Context, object: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    transition { _ -> block malformed(gate, context) }
}
