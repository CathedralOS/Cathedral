// Serialize the existing drawing contract. Geometry and pixel contents remain
// app decisions; transfer owns immutable attachment lifetime.
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {app}/rendering/pixels.omg;
use {runtime}/kernel.omg;
use {runtime}/memory/object.omg;
use transfer.omg;
use replies.omg;

public machine execute(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command) -> |operations|::Completion reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition command {
        |operations|::Command::Image { epoch, surface, x, y, asset } -> block image(gate, context, state, command, epoch, surface, x, y, asset)
        _ -> block plain(gate, context, state, command)
    }
}
machine plain(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command) -> |operations|::Completion reaches |kernel|::Kernel {
    let words: [u64; 8] = encode(command);
    block |transfer|::plain(gate, context, state, command, false, &words, 0u64, 0u64)
}
machine encode(command: |operations|::Command) -> [u64; 8] {
    transition command {
        |operations|::Command::Poll -> ([5u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::View -> ([1u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::CreateSurface { epoch, rank } -> ([6u64, epoch, rank, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::Rectangles { epoch, revision, background, indicator } -> rectangles(epoch, revision, background, indicator)
        _ -> ([0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
    }
}
machine rectangles(epoch: u64, revision: u64, a: |operations|::Rectangle, b: |operations|::Rectangle) -> [u64; 8] {
    [13u64, epoch, revision, a.surface,
        (a.x & 65535u64) | ((a.y & 65535u64) << 16u64) | ((a.width & 65535u64) << 32u64) | ((a.height & 65535u64) << 48u64),
        a.color | ((b.surface & 4294967295u64) << 32u64),
        (b.surface >> 32u64) | ((b.x & 65535u64) << 32u64) | ((b.y & 65535u64) << 48u64),
        (b.width & 65535u64) | ((b.height & 65535u64) << 16u64) | ((b.color & 4294967295u64) << 32u64)]
}
machine image(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command,
    epoch: u64, surface: u64, x: u64, y: u64, asset: |operations|::Asset) -> |operations|::Completion reaches |kernel|::Kernel {
    transition asset {
        |operations|::Asset::Checker -> block raster(gate, context, state, command, epoch, surface, x, y, asset, 32u64, 32u64, 4096u64)
        |operations|::Asset::Close { width } -> block close(gate, context, state, command, epoch, surface, x, y, asset, width)
    }
}
machine close(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command,
    epoch: u64, surface: u64, x: u64, y: u64, asset: |operations|::Asset, width: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    transition width {
        20u64 -> block raster(gate, context, state, command, epoch, surface, x, y, asset, width, 16u64, 1280u64)
        156u64 -> block raster(gate, context, state, command, epoch, surface, x, y, asset, width, 16u64, 9984u64)
        _ -> |replies|::failed(|kernel|::INVALID_ARGUMENT)
    }
}
machine raster(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: |operations|::Command,
    epoch: u64, surface: u64, x: u64, y: u64, asset: |operations|::Asset, width: u64, height: u64, length: u64 [1..=16384]) -> |operations|::Completion reaches |kernel|::Kernel {
    let created: |object|::Creation = block backing(gate, asset, length);
    let words: [u64; 8] = [8u64, epoch, surface, x, y, width, height, width];
    transition created {
        |object|::Creation::Ready { object } -> block |transfer|::retained(gate, context, state, command, false, &words, object.handle, 0u64)
        |object|::Creation::Failed { code } -> |replies|::failed(code)
    }
}
// Finish the raster's local stack allocation before handling service waits.
machine backing(gate: &|kernel|::Gate, asset: |operations|::Asset, length: u64 [1..=16384]) -> |object|::Creation reaches |kernel|::Kernel {
    let mut buffer: [u64; 2048];
    fill(&mut buffer, asset, length / 8u64, 0u64);
    block |object|::create(gate, &buffer, length)
}

machine fill(buffer: &mut [u64; 2048], asset: |operations|::Asset, count: u64, index: u64) {
    transition index < count && index < 2048u64 {
        true -> pixel(buffer, asset, count, index)
        _ -> done()
    }
    machine pixel(buffer: &mut [u64; 2048], asset: |operations|::Asset, count: u64, index: u64) requires index < 2048u64 {
        let lo: u64 = color(asset, index * 2u64);
        let hi: u64 = color(asset, index * 2u64 + 1u64);
        buffer[index] = (lo & 0xffffffffu64) | ((hi & 0xffffffffu64) << 32u64);
        transition { _ -> fill(buffer, asset, count, index + 1u64) }
    }
}
machine color(asset: |operations|::Asset, index: u64) -> u64 {
    transition asset {
        |operations|::Asset::Checker -> |pixels|::checker(index)
        |operations|::Asset::Close { width } -> |pixels|::close_pixel(width, index)
    }
}
machine done() {}
