// Wire decoding stops here. The application receives named completed work.
use {app}/operations.omg;
use {protocol}/main.omg;

public machine failed(code: u64) -> |operations|::Completion {
    |operations|::Completion { transport_status: code, reply: |operations|::Reply::Complete }
}
public machine decoded(command: |operations|::Command, words: [u64; 8]) -> |operations|::Completion {
    |operations|::Completion { transport_status: 0u64, reply: reply(command, words) }
}
machine reply(command: |operations|::Command, words: [u64; 8]) -> |operations|::Reply {
    transition command {
        |operations|::Command::Poll -> view(words)
        |operations|::Command::View -> view(words)
        |operations|::Command::List { realm } -> (|operations|::Reply::Listed { status: words[0], count: words[1], object: words[2] })
        |operations|::Command::Read { object } -> (|operations|::Reply::Read { status: words[0], revision: words[2], length: words[3], bytes: bytes(words[4]) })
        |operations|::Command::Publish { object, revision, realm, bytes } -> published(object, words)
        |operations|::Command::CreateSurface { epoch, rank } -> (|operations|::Reply::Surface { status: words[0], handle: words[1] })
        |operations|::Command::Image { epoch, surface, x, y, asset } -> (|operations|::Reply::Presented { status: words[0] })
        |operations|::Command::Rectangles { epoch, revision, background, indicator } -> (|operations|::Reply::Presented { status: words[0] })
        _ -> (|operations|::Reply::Complete)
    }
}
machine published(object: u64, words: [u64; 8]) -> |operations|::Reply {
    transition object == 0u64 {
        true -> (|operations|::Reply::Created { status: words[0] })
        _ -> (|operations|::Reply::Saved { status: words[0], object: words[1], revision: words[2] })
    }
}
machine bytes(word: u64) -> [u8; 6] {
    [(word & 255u64) as u8, ((word >> 8u64) & 255u64) as u8,
        ((word >> 16u64) & 255u64) as u8, ((word >> 24u64) & 255u64) as u8,
        ((word >> 32u64) & 255u64) as u8, ((word >> 40u64) & 255u64) as u8]
}
machine view(words: [u64; 8]) -> |operations|::Reply {
    |operations|::Reply::View { view: |operations|::View { status: words[0], epoch: words[1], width: words[2], height: words[3],
        frames: (words[4] & |main|::NO_FRAMES) == 0u64, more: (words[5] & |main|::MORE) != 0u64, input: input(words) } }
}
machine input(words: [u64; 8]) -> |operations|::Input {
    transition words[5] & 255u64 {
        |main|::POINTER -> (|operations|::Input::Pointer { channel: words[5] >> 32u64, buttons: (words[5] >> 8u64) & 7u64, x: words[6], y: words[7] })
        |main|::KEY -> (|operations|::Input::Key { code: words[6], action: words[7] })
        |main|::CANCEL -> (|operations|::Input::Cancel { channel: words[5] >> 32u64, retire: false })
        |main|::RETIRED -> (|operations|::Input::Cancel { channel: words[5] >> 32u64, retire: true })
        _ -> (|operations|::Input::Other)
    }
}
