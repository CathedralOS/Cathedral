// The app chooses work. This driver performs it through the supplied runtime and
// resumes with the real result; no duplicate phase machine or oversized packet.
use main.omg;
use {runtime}/kernel.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {app}/main.omg as app_main;
use operations.omg as operations_file;

public machine run(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut session: |app_state|::State;
    transition { _ -> (block drive(gate, context, &mut session, |operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Complete })) }
}
machine drive(gate: &|kernel|::Gate, context: &mut |main|::Context, session: &mut |app_state|::State, event: |operations|::Completion) -> u64 reaches |kernel|::Kernel {
    let command: |operations|::Command = |app_main|::advance(session, &event);
    transition command {
        |operations|::Command::Exit -> (0u64)
        _ -> block execute(gate, context, session, command)
    }
}
machine execute(gate: &|kernel|::Gate, context: &mut |main|::Context, session: &mut |app_state|::State, command: |operations|::Command) -> u64 reaches |kernel|::Kernel {
    let event: |operations|::Completion = block |operations_file|::execute(gate, context, session, command);
    transition { _ -> (block drive(gate, context, session, event)) }
}
