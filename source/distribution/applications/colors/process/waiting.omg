module waiting;
use main::Context;
use app::state::State;
use app::operations::Completion;
use app::operations::Reply;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::time::Tick;
use control;

public machine next(gate: &Gate, context: &mut Context, state: &State) -> Completion reaches Kernel blocks; invokes Kernel; {
    let tick: Tick = runtime::time::read(gate, context.clock);
    transition tick {
        Tick::Read { value } -> block poll(gate, context, state, value)
        Tick::Failed { code } -> failed(code)
    }
}
machine poll(gate: &Gate, context: &mut Context, state: &State, now: u64) -> Completion reaches Kernel {
    block control::poll(gate, context, state, now);
    let hint: u64 = block Kernel::notify_wait(gate, context.services.wake, now, 1u64);
    transition {
        // The app yields between bounded batches for owner control. Already
        // queued input must resume even if its coalesced bell was consumed.
        hint == kernel::NOTIFY_SIGNALED || (hint == kernel::NOTIFY_TIMED_OUT && state.more) -> (Completion { transport_status: 0u64, reply: Reply::Wake })
        hint == kernel::NOTIFY_TIMED_OUT -> block park(gate, context, state, runtime::time::after(now, 300u64))
        _ -> failed(hint)
    }
}
machine park(gate: &Gate, context: &mut Context, state: &State, deadline: u64) -> Completion reaches Kernel {
    let mut interests: [u64; 8];
    interests[0] = 2u64; interests[1] = context.services.wake;
    transition context.owner.peer.fault == 0u64 {
        true -> block combined(gate, context, state, &mut interests, deadline)
        _ -> block wait(gate, context, state, &interests, 1u64, deadline)
    }
}
machine combined(gate: &Gate, context: &mut Context, state: &State, interests: &mut [u64; 8], deadline: u64) -> Completion reaches Kernel {
    interests[2] = 2u64; interests[3] = context.owner.peer.bell.wait;
    interests[5] = context.owner.peer.receiver;
    transition { _ -> (block wait(gate, context, state, interests, 3u64, deadline)) }
}
machine wait(gate: &Gate, context: &mut Context, state: &State, interests: &[u64; 8], count: u64 [0..=4], deadline: u64) -> Completion reaches Kernel {
    let status: u64 = block Kernel::wait(gate, interests, count, deadline);
    transition status < count || status == kernel::TIMED_OUT || status == kernel::PEER_CLOSED {
        true -> (block next(gate, context, state))
        _ -> block interrupted(gate, context, state, status)
    }
}
machine interrupted(gate: &Gate, context: &mut Context, state: &State, code: u64) -> Completion reaches Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block detach(gate, context, state)
        _ -> failed(code)
    }
    machine detach(gate: &Gate, context: &mut Context, state: &State) -> Completion reaches Kernel {
        block runtime::server::main::close(gate, &mut context.owner);
        transition { _ -> (block next(gate, context, state)) }
    }
}
machine failed(code: u64) -> Completion {
    Completion { transport_status: code, reply: Reply::Complete }
}
