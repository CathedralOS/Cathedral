machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_notes_component");
    Build::depend_as(builder, "app", Source::Path { location: "../../app" });
    Build::depend_as(builder, "host", Source::Path { location: "../../../../../platform/libraries/app-host" });
    Build::depend_as(builder, "protocol", Source::Path { location: "../../../../../platform/contracts/reference" });
    Build::select_provider<main::Notes, main::NotesProvider>(builder);
    Build::bind(builder, linux_x86_64::ProgramEntry, main::component_entry);
}
