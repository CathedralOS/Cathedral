// Temporary ABI only: decode completed work, advance Notes, encode its command.
use {app}/main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use replies.omg;
use commands.omg;

public boundary trait Notes {
    machine step(s: &mut |app_state|::State, p: &mut [u64; 4096]) -> u64 reaches;
}
public NotesProvider satisfies Notes {
    machine step(s: &mut |app_state|::State, p: &mut [u64; 4096]) -> u64 {
        transition p[15] {
            1u64 -> (size_of<|app_state|::State>())
            2u64 -> (align_of<|app_state|::State>())
            3u64 -> (1u64)
            _ -> resume(s, p)
        }
    }
}
machine resume(s: &mut |app_state|::State, p: &mut [u64; 4096]) -> u64 {
    let completion: |operations|::Completion = |replies|::decode(s.phase, p);
    let command: |operations|::Command = |main|::advance(s, &completion);
    |commands|::encode(command, s, p)
}
public machine component_entry() reaches Notes invokes Notes {
    let mut s: |app_state|::State;
    let mut p: [u64; 4096];
    let result: u64 = Notes::step(&mut s, &mut p);
}
