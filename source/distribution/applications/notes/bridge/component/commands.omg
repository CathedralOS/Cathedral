use {app}/state.omg as app_state;
use {app}/operations.omg;
use {host}/main.omg;
use {protocol}/main.omg as protocol_main;
use images.omg;
use records.omg;
use diagnostics.omg;
public machine encode(command: |operations|::Command, s: &|app_state|::State, p: &mut [u64; 4096]) -> u64 {
    |main|::message(p, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
    transition command {
        |operations|::Command::Exit -> (|main|::EXIT)
        |operations|::Command::AcquireInteraction -> acquire(p, |main|::INTERACTION)
        |operations|::Command::AcquireStorage -> acquire(p, |main|::STORAGE)
        |operations|::Command::BindStorage -> (|main|::BIND)
        |operations|::Command::List { realm, after } -> listing(p, realm, after)
        |operations|::Command::Head { object } -> head(p, object)
        |operations|::Command::Read { object, revision, length } -> read(p, object, revision, length)
        |operations|::Command::Publish { object, revision, realm, record } -> publish(p, object, revision, realm, record)
        |operations|::Command::Copy { object, revision, realm } -> duplicate(p, object, revision, realm)
        |operations|::Command::Poll -> exchange(p, |protocol_main|::MATRIX_POLL)
        |operations|::Command::View -> exchange(p, |protocol_main|::MATRIX_VIEW)
        |operations|::Command::Cursor { epoch, channel, hidden } -> cursor(p, epoch, channel, hidden)
        |operations|::Command::CreateSurface { epoch, rank } -> surface(p, epoch, rank)
        |operations|::Command::Paint { epoch, surface, width, height, color } -> paint(p, epoch, surface, width, height, color)
        |operations|::Command::StageText { offset, words } -> |images|::text(s, p, offset, words)
        |operations|::Command::PublishText { image } -> |images|::publish(p, image)
        |operations|::Command::Decorate { image, decoration } -> |images|::decorate(s, p, image, decoration)
        |operations|::Command::FrameDemand { epoch } -> frame(p, |protocol_main|::FRAME_DEMAND, epoch, 0u64)
        |operations|::Command::FrameReady { epoch, ticket } -> frame(p, |protocol_main|::FRAME_READY, epoch, ticket)
        |operations|::Command::Wait -> (|main|::WAIT)
        |operations|::Command::Control { report } -> control(p, report)
        |operations|::Command::Loaded { temporary } -> |diagnostics|::loaded(p, temporary)
    }
}
machine acquire(p: &mut [u64; 4096], operation: u64) -> u64 {
    p[0] = 1u64;
    p[1] = 1u64;
    operation
}
machine listing(p: &mut [u64; 4096], realm: u64, after: u64) -> u64 {
    |main|::message(p, |protocol_main|::STORE_LIST, realm, 0u64, after, 0u64, 0u64, 0u64, 0u64);
    |main|::STORE
}
machine head(p: &mut [u64; 4096], object: u64) -> u64 {
    |main|::message(p, |protocol_main|::STORE_HEAD, object, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
    |main|::STORE
}
machine read(p: &mut [u64; 4096], object: u64, revision: u64, length: u64) -> u64 {
    |main|::message(p, |protocol_main|::STORE_BULK, object, revision, 0u64, length, 0u64, 0u64, 0u64);
    p[11] = 244u64;
    |main|::STORE
}
machine publish(p: &mut [u64; 4096], object: u64, revision: u64, realm: u64, record: |operations|::Record) -> u64 {
    |main|::message(p, |protocol_main|::STORE_PUBLISH, object, revision, realm, record.length, 0u64, 0u64, 0u64);
    |records|::encode(&record, p);
    p[8] = record.length;
    |main|::STORE
}
machine duplicate(p: &mut [u64; 4096], object: u64, revision: u64, realm: u64) -> u64 {
    |main|::message(p, |protocol_main|::STORE_COPY, object, revision, realm, 0u64, 0u64, 0u64, 0u64);
    |main|::STORE
}
machine exchange(p: &mut [u64; 4096], operation: u64) -> u64 {
    p[0] = operation;
    |main|::EXCHANGE
}
machine cursor(p: &mut [u64; 4096], epoch: u64, channel: u64, hidden: bool) -> u64 {
    |main|::message(p, |protocol_main|::CURSOR_PREFERENCE, epoch, channel, hidden as u64, 0u64, 0u64, 0u64, 0u64);
    |main|::EXCHANGE
}
machine surface(p: &mut [u64; 4096], epoch: u64, rank: u64) -> u64 {
    |main|::message(p, |protocol_main|::SURFACE_CREATE, epoch, rank, 0u64, 0u64, 0u64, 0u64, 0u64);
    |main|::EXCHANGE
}
machine paint(p: &mut [u64; 4096], epoch: u64, surface: u64, width: u64, height: u64, color: u64) -> u64 {
    |main|::message(p, |protocol_main|::MATRIX_PAINT, epoch, surface, 0u64, 0u64, width, height, color);
    |main|::EXCHANGE
}
machine frame(p: &mut [u64; 4096], operation: u64, epoch: u64, ticket: u64) -> u64 {
    |main|::message(p, operation, epoch, ticket, 0u64, 0u64, 0u64, 0u64, 0u64);
    |main|::EXCHANGE
}
machine control(p: &mut [u64; 4096], report: |operations|::Report) -> u64 {
    transition report {
        |operations|::Report::Loss { changed } -> loss(p, changed)
        |operations|::Report::Health { revision, length, error, changed, count, selected } -> health(p, revision, length, error, changed, count, selected)
    }
    machine loss(p: &mut [u64; 4096], changed: bool) -> u64 {
        p[1] = changed as u64;
        |main|::CONTROL
    }
    machine health(p: &mut [u64; 4096], revision: u64, length: u64, error: u64, changed: bool, count: u64, selected: u64) -> u64 {
        |main|::message(p, 0u64, revision, length, error, changed as u64, count, selected, 0u64);
        |main|::CONTROL
    }
}
