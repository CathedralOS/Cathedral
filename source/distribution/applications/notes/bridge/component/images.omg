use {app}/state.omg as app_state;
use {app}/operations.omg;
use {app}/rendering/pixels.omg;
use {host}/main.omg;
use {protocol}/main.omg as protocol_main;
public machine text(s: &|app_state|::State, p: &mut [u64; 4096], offset: u64, words: u64) -> u64 {
    |main|::message(p, 46080u64, offset, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
    text_pixels(s, p, offset, words);
    p[8] = ((words as u64 in Saturating) * 8) as u64;
    |main|::STAGE
}
public machine publish(p: &mut [u64; 4096], image: |operations|::Image) -> u64 {
    |main|::message(p, |protocol_main|::SURFACE_IMAGE, image.epoch, image.surface, image.x, image.y, image.width, image.height, image.width);
    |main|::EXCHANGE
}
public machine decorate(s: &|app_state|::State, p: &mut [u64; 4096], image: |operations|::Image, kind: |operations|::Decoration) -> u64 {
    let operation: u64 = publish(p, image);
    transition kind {
        |operations|::Decoration::Close -> pack(s, p, 0u64, 160u64)
        |operations|::Decoration::Temporary -> pack(s, p, 1u64, 1440u64)
        |operations|::Decoration::Tabs -> pack(s, p, 2u64, 496u64)
    }
    machine pack(s: &|app_state|::State, p: &mut [u64; 4096], kind: u64, words: u64) -> u64 {
        decoration(s, p, kind, words);
        p[8] = ((words as u64 in Saturating) * 8) as u64;
        |main|::EXCHANGE
    }
}
public machine text_pixels(s: &|app_state|::State, p: &mut [u64; 4096], offset: u64, words: u64) {
    transition {
        _ -> fill(s, p, offset, words, 0u64)
    }
    machine fill(s: &|app_state|::State, p: &mut [u64; 4096], offset: u64, words: u64, i: u64) {
        transition i < words && i < 4080u64 && offset < 46080u64 {
            true -> pair(s, p, offset, words, i)
            _ -> done()
        }
    }
    machine pair(s: &|app_state|::State, p: &mut [u64; 4096], offset: u64, words: u64, i: u64) requires i < 4080u64 && offset < 46080u64 {
        let at: u64 = offset / 4u64 + i * 2u64;
        let lo: u64 = |pixels|::text_pixel(s, at);
        let hi: u64 = |pixels|::text_pixel(s, at + 1u64);
        p[16u64 + i] = lo | ((hi & 4294967295u64) << 32u64);
        transition {
            _ -> fill(s, p, offset, words, i + 1u64)
        }
    }
    machine done() {}
}

public machine decoration(s: &|app_state|::State, p: &mut [u64; 4096], kind: u64, words: u64) {
    transition {
        _ -> fill(s, p, kind, words, 0u64)
    }
    machine fill(s: &|app_state|::State, p: &mut [u64; 4096], kind: u64, words: u64, i: u64) {
        transition i < words && i < 1440u64 {
            true -> pair(s, p, kind, words, i)
            _ -> done()
        }
    }
    machine pair(s: &|app_state|::State, p: &mut [u64; 4096], kind: u64, words: u64, i: u64) requires i < 1440u64 {
        let lo: u64 = |pixels|::decoration_pixel(s, kind, i * 2u64);
        let hi: u64 = |pixels|::decoration_pixel(s, kind, i * 2u64 + 1u64);
        p[16u64 + i] = lo | ((hi & 4294967295u64) << 32u64);
        transition {
            _ -> fill(s, p, kind, words, i + 1u64)
        }
    }
    machine done() {}
}
