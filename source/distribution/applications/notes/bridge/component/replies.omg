use {app}/state.omg as app_state;
use {app}/operations.omg;
use {protocol}/main.omg;
use records.omg;
public machine decode(phase: |app_state|::Phase, p: &[u64; 4096]) -> |operations|::Completion {
    transition phase {
        |app_state|::Phase::Start -> (|operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Complete })
        |app_state|::Phase::Awakened -> awakened(p)
        _ -> (|operations|::Completion { transport_status: p[9], reply: response(phase, p) })
    }
}
machine response(phase: |app_state|::Phase, p: &[u64; 4096]) -> |operations|::Reply {
    transition phase {
        |app_state|::Phase::Polled -> (|operations|::Reply::View { view: view(p) })
        |app_state|::Phase::CursorChanged -> (|operations|::Reply::Cursor { status: p[0] })
        |app_state|::Phase::Storage { step } -> storage_reply(step, p)
        |app_state|::Phase::Rendering { step } -> rendering(step, p)
        _ -> (|operations|::Reply::Complete)
    }
}
machine storage_reply(step: |app_state|::StorageStep, p: &[u64; 4096]) -> |operations|::Reply {
    let result: |operations|::StorageResult = storage(step, p);
    |operations|::Reply::Storage { reply: |operations|::StorageReply { status: p[0], result: result } }
}
machine storage(step: |app_state|::StorageStep, p: &[u64; 4096]) -> |operations|::StorageResult {
    transition step {
        |app_state|::StorageStep::Bound -> (|operations|::StorageResult::Bound { realm: p[1] })
        |app_state|::StorageStep::Listed -> (|operations|::StorageResult::Listed { count: p[1], entries: [p[2], p[3], p[4], p[5], p[6], p[7]] })
        |app_state|::StorageStep::Headed -> (|operations|::StorageResult::Head { revision: p[2], length: p[3] })
        |app_state|::StorageStep::Read -> (|operations|::StorageResult::Read { revision: p[2], reported: p[4], record: |records|::decode(p) })
        |app_state|::StorageStep::Saved -> (|operations|::StorageResult::Saved { object: p[1], revision: p[2] })
        |app_state|::StorageStep::Copied -> (|operations|::StorageResult::Copied { object: p[1] })
    }
}
machine rendering(step: |app_state|::RenderStep, p: &[u64; 4096]) -> |operations|::Reply {
    transition step {
        |app_state|::RenderStep::ViewRechecked -> (|operations|::Reply::View { view: view(p) })
        |app_state|::RenderStep::SurfaceCreated -> (|operations|::Reply::Surface { status: p[0], handle: p[1] })
        |app_state|::RenderStep::DemandReady -> (|operations|::Reply::Demand { status: p[0], ticket: p[2] })
        _ -> (|operations|::Reply::Presented { status: p[0] })
    }
}
machine view(p: &[u64; 4096]) -> |operations|::View {
    |operations|::View { status: p[0], epoch: p[1], width: p[2], height: p[3],
        frames: (p[4] & |main|::NO_FRAMES) == 0u64, requested: (p[4] & |main|::FRAME_REQUESTED) != 0u64,
        more: (p[5] & |main|::MORE) != 0u64, input: input(p) }
}
machine input(p: &[u64; 4096]) -> |operations|::Input {
    transition p[5] & 255u64 {
        |main|::POINTER -> (|operations|::Input::Pointer { channel: p[5] >> 32u64, group: (p[5] >> 17u64) & 32767u64,
            buttons: (p[5] >> 8u64) & 7u64, x: p[6], y: p[7] })
        |main|::KEY -> (|operations|::Input::Key { group: (p[5] >> 17u64) & 32767u64, code: p[6], action: p[7] })
        |main|::CANCEL -> (|operations|::Input::Cancel { channel: p[5] >> 32u64, retire: false })
        |main|::RETIRED -> (|operations|::Input::Cancel { channel: p[5] >> 32u64, retire: true })
        _ -> (|operations|::Input::Other)
    }
}
machine awakened(p: &[u64; 4096]) -> |operations|::Completion {
    transition p[9] {
        0u64 -> (|operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Wake })
        1u64 -> (|operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Control { loss: p[0] == |main|::LOSS } })
        _ -> (|operations|::Completion { transport_status: p[9], reply: |operations|::Reply::Complete })
    }
}
