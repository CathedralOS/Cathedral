use {runtime}/server/main.omg as server_main;
use application/application.omg;
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use services/control.omg;

public machine next(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block poll(output, gate, context, state, value)
        |time|::Tick::Failed { code } -> failed(output, code)
    }
}
machine poll(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) reaches |kernel|::Kernel {
    block |control|::poll(gate, context, state, now);
    let hint: u64 = block |kernel|::Kernel::notify_wait(gate, context.services.wake, now, 1u64);
    transition {
        // The app yields between bounded batches for owner control. Already
        // queued input must resume even if its coalesced bell was consumed.
        hint == |kernel|::NOTIFY_SIGNALED || (hint == |kernel|::NOTIFY_TIMED_OUT && state.more) -> wake(output)
        hint == |kernel|::NOTIFY_TIMED_OUT -> block park(output, gate, context, state, |time|::after(now, 300u64))
        _ -> failed(output, hint)
    }
}
machine park(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, deadline: u64) reaches |kernel|::Kernel {
    let mut interests: [u64; 8];
    interests[0] = 2u64; interests[1] = context.services.wake;
    transition context.owner.peer.fault == 0u64 {
        true -> block combined(output, gate, context, state, &mut interests, deadline)
        _ -> block wait(output, gate, context, state, &interests, 1u64, deadline)
    }
}
machine combined(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, interests: &mut [u64; 8], deadline: u64) reaches |kernel|::Kernel {
    interests[2] = 2u64; interests[3] = context.owner.peer.bell.wait;
    interests[5] = context.owner.peer.receiver;
    transition { _ -> block wait(output, gate, context, state, interests, 3u64, deadline) }
}
machine wait(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, interests: &[u64; 8], count: u64 [0..=4], deadline: u64) reaches |kernel|::Kernel {
    let status: u64 = block |kernel|::Kernel::wait(gate, interests, count, deadline);
    transition status < count || status == |kernel|::TIMED_OUT || status == |kernel|::PEER_CLOSED {
        true -> block next(output, gate, context, state)
        _ -> block interrupted(output, gate, context, state, status)
    }
}
machine interrupted(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, code: u64) reaches |kernel|::Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block detach(output, gate, context, state)
        _ -> failed(output, code)
    }
    machine detach(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) reaches |kernel|::Kernel {
        block |server_main|::close(gate, &mut context.owner);
        transition { _ -> block next(output, gate, context, state) }
    }
}
machine failed(output: &mut |application|::Work, code: u64) {
    output.event = |operations|::Completion { transport_status: code, reply: |operations|::Reply::Complete };
}

machine wake(output: &mut |application|::Work) {
    output.event = |operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Wake };
}
