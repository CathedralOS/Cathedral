use application/application.omg;
// Geometry and pixels belong to the editor. This owner encodes presentation
// requests and delegates attachment lifetime to images/transfer.
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {protocol}/main.omg as protocol_main;
use presentation/images.omg;
use services/transfer.omg;
public machine execute(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: &|application|::Request) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition command.command {
        |operations|::Command::StageText { offset, words } -> block |images|::stage(output, gate, context, state, offset, words)
        |operations|::Command::PublishText { image } -> block |images|::publish(output, gate, context, state, command, image)
        |operations|::Command::Decorate { image, decoration } -> block |images|::decorate(output, gate, context, state, command, image, decoration)
        _ -> block plain(output, gate, context, state, command)
    }
}
machine plain(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: &|application|::Request) reaches |kernel|::Kernel {
    let words: [u64; 8] = encode(command);
    block |transfer|::plain(output, gate, context, state, command, false, &words, 0u64, 0u64)
}
machine encode(command: &|application|::Request) -> [u64; 8] {
    transition command.command {
        |operations|::Command::Poll -> ([|protocol_main|::MATRIX_POLL, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::View -> ([|protocol_main|::MATRIX_VIEW, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::Cursor { epoch, channel, hidden } -> ([|protocol_main|::CURSOR_PREFERENCE, epoch, channel, hidden as u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::CreateSurface { epoch, rank } -> ([|protocol_main|::SURFACE_CREATE, epoch, rank, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::Paint { epoch, surface, width, height, color } -> ([|protocol_main|::MATRIX_PAINT, epoch, surface, 0u64, 0u64, width, height, color])
        |operations|::Command::FrameDemand { epoch } -> ([|protocol_main|::FRAME_DEMAND, epoch, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
        |operations|::Command::FrameReady { epoch, ticket } -> ([|protocol_main|::FRAME_READY, epoch, ticket, 0u64, 0u64, 0u64, 0u64, 0u64])
        _ -> ([0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64])
    }
}
