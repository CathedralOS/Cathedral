use application/application.omg;
// Storage transport owns attachment custody and extents. The editor alone
// interprets NTS1 and decides whether these bytes replace its draft.
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/connection/call.omg;
use {runtime}/connection/main.omg as connection_main;
use {runtime}/memory/object.omg;
use services/exchange.omg;
use services/replies.omg;

public machine receive(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: &|application|::Request,
    words: &[u64; 8], requested: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let reply: |call|::CallReply = block |exchange|::request(gate, context, state, true, words, 0u64, words[7]);
    transition reply {
        |call|::CallReply::Object { frame, object } -> block object(output, gate, context, frame, object, requested)
        |call|::CallReply::Received { frame, notification } -> block plain(output, gate, context, command, frame, notification)
        |call|::CallReply::Endpoint { frame, endpoint } -> block unexpected_endpoint(output, gate, context, endpoint)
        |call|::CallReply::Failed { code } -> |replies|::failed(output, code)
    }
}
machine plain(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, command: &|application|::Request, frame: |connection_main|::Frame, notification: u64) reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && frame.payload[0] != 0u64 && notification == 0u64 {
        true -> |replies|::decoded(output, command, frame.payload)
        _ -> block unexpected_notification(output, gate, context, notification)
    }
}
machine object(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, frame: |connection_main|::Frame, object: u64, requested: u64) reaches |kernel|::Kernel {
    let mut record: |operations|::Record;
    let status: u64 = block contents(gate, frame, object, requested, &mut record);
    let released: u64 = block |kernel|::Kernel::memory_release(gate, object);
    transition status == 0u64 && released == 0u64 {
        true -> |replies|::read(output, frame.payload, record)
        _ -> block malformed(output, gate, context)
    }
}
machine contents(gate: &|kernel|::Gate, frame: |connection_main|::Frame, object: u64, requested: u64, record: &mut |operations|::Record) -> u64 reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && frame.payload[0] == 0u64
        && frame.payload[4] > 0u64 && frame.payload[4] <= 244u64 && frame.payload[4] <= requested {
        true -> block copy(gate, object, record, frame.payload[4])
        _ -> (|kernel|::IO_ERROR)
    }
    machine copy(gate: &|kernel|::Gate, object: u64, record: &mut |operations|::Record, length: u64) -> u64 reaches |kernel|::Kernel {
        record.length = length;
        transition { _ -> block chunk(gate, object, record, 0u64) }
    }
}
machine chunk(gate: &|kernel|::Gate, object: u64, record: &mut |operations|::Record, offset: u64) -> u64 reaches |kernel|::Kernel {
    transition offset < record.length && offset < 244u64 {
        true -> block read(gate, object, record, offset)
        _ -> (0u64)
    }
    machine read(gate: &|kernel|::Gate, object: u64, record: &mut |operations|::Record, offset: u64) -> u64 reaches |kernel|::Kernel requires offset < 244u64 {
        let mut words: [u64; 8];
        let status: u64 = block |kernel|::Kernel::object_read(gate, object, offset / 8u64, &mut words, 8u64);
        transition status == 0u64 {
            true -> block copied(gate, object, record, offset, &words)
            _ -> (status)
        }
    }
    machine copied(gate: &|kernel|::Gate, object: u64, record: &mut |operations|::Record, offset: u64, words: &[u64; 8]) -> u64 reaches |kernel|::Kernel requires offset < 244u64 {
        unpack(record, offset, words, 0u64);
        transition { _ -> block chunk(gate, object, record, offset + 64u64) }
    }
}
machine unpack(record: &mut |operations|::Record, offset: u64 [0..=243], words: &[u64; 8], i: u64) {
    transition i < 64u64 && offset + i < 244u64 && offset + i < record.length {
        true -> byte(record, offset, words, i)
        _ -> done()
    }
    machine byte(record: &mut |operations|::Record, offset: u64 [0..=243], words: &[u64; 8], i: u64) requires i < 64u64 && offset + i < 244u64 {
        record.bytes[offset + i] = ((words[i / 8u64] >> ((i % 8u64) * 8u64)) & 255u64) as u8;
        transition { _ -> unpack(record, offset, words, i + 1u64) }
    }
}
public machine backing(gate: &|kernel|::Gate, record: &|operations|::Record) -> |object|::Creation reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition record.length > 0u64 && record.length <= 244u64 {
        true -> block pack(gate, record)
        _ -> (|object|::Creation::Failed { code: |kernel|::INVALID_ARGUMENT })
    }
    machine pack(gate: &|kernel|::Gate, record: &|operations|::Record) -> |object|::Creation reaches |kernel|::Kernel requires record.length > 0u64 && record.length <= 244u64 {
        let mut words: [u64; 2048];
        bytes(record, &mut words, 0u64);
        block |object|::create(gate, &words, record.length)
    }
}
machine bytes(record: &|operations|::Record, words: &mut [u64; 2048], i: u64) {
    transition i < record.length && i < 244u64 {
        true -> byte(record, words, i)
        _ -> done()
    }
    machine byte(record: &|operations|::Record, words: &mut [u64; 2048], i: u64) requires i < 244u64 {
        words[i / 8u64] = words[i / 8u64] | ((record.bytes[i] as u64) << ((i % 8u64) * 8u64));
        transition { _ -> bytes(record, words, i + 1u64) }
    }
}
machine unexpected_endpoint(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, endpoint: u64) reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    transition { _ -> block malformed(output, gate, context) }
}
machine unexpected_notification(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, notification: u64) reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    transition { _ -> block malformed(output, gate, context) }
}
machine malformed(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context) reaches |kernel|::Kernel {
    let ignored: u64 = block |connection_main|::close(gate, &mut context.storage.peer);
    |replies|::failed(output, |kernel|::IO_ERROR)
}
machine done() {}
