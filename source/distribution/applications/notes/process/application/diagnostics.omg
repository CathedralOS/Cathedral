    transition temporary {
        true -> write(output, gate, [7021785155730956611u64, 4211821627279548524u64, 7021797297686410272u64, 8295753032394307954u64, 7286935691776388980u64, 753348436797973614u64, 0u64, 0u64], 48u64)
        _ -> write(output, gate, [7021785155730956611u64, 4211821627279548524u64, 8028842149463158304u64, 44634039393u64, 0u64, 0u64, 0u64, 0u64], 29u64)
