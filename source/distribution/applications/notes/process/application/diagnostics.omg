machine write(output: &mut application::application::Work, gate: &Gate, words: [u64; 8], bytes: u64 [0..=64]) reaches Kernel {
    let ignored: u64 = Kernel::write(gate, &words, bytes);
    output.event = Completion { transport_status: 0u64, reply: Reply::Complete };
