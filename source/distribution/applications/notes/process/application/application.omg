// One editor state and one command/result workspace. Dispatch borrows the work
// instead of retaining large record-valued return buffers through service waits.
use main.omg;
use {runtime}/kernel.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use application/operations.omg as application_operations;
use {app}/main.omg as app_main;

public data Work { event: |operations|::Completion; }
public data Request { command: |operations|::Command; }

public machine run(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut session: |app_state|::State;
    let mut output: Work;
    let mut request: Request;
    transition { _ -> block drive(gate, context, &mut session, &mut output, &mut request) }
}
machine drive(gate: &|kernel|::Gate, context: &mut |main|::Context, session: &mut |app_state|::State, output: &mut Work, request: &mut Request) -> u64 reaches |kernel|::Kernel {
    request.command = |app_main|::advance(session, &output.event);
    transition request.command {
        |operations|::Command::Exit -> (0u64)
        _ -> block dispatch(gate, context, session, output, request)
    }
}
machine dispatch(gate: &|kernel|::Gate, context: &mut |main|::Context, session: &mut |app_state|::State, output: &mut Work, request: &mut Request) -> u64 reaches |kernel|::Kernel {
    block |application_operations|::execute(output, gate, context, session, request);
    transition { _ -> block drive(gate, context, session, output, request) }
}
