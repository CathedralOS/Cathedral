use application/application.omg;
// App intent dispatches to service acquisition, storage, presentation or waiting.
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use services/services.omg;
use storage/requests.omg;
use presentation/presentation.omg;
use services/waiting.omg;
use services/control.omg;
use application/diagnostics.omg;

public machine execute(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, command: &|application|::Request) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition command.command {
        |operations|::Command::AcquireInteraction -> block interaction(output, gate, context, state)
        |operations|::Command::AcquireStorage -> block acquire_storage(output, gate, context, state)
        |operations|::Command::BindStorage -> block |requests|::bind(output, gate, context, state)
        |operations|::Command::List { realm, after } -> block |requests|::execute(output, gate, context, state, command)
        |operations|::Command::Read { object, revision, length } -> block |requests|::execute(output, gate, context, state, command)
        |operations|::Command::Publish { object, revision, realm, record } -> block |requests|::execute(output, gate, context, state, command)
        |operations|::Command::Head { object } -> block |requests|::execute(output, gate, context, state, command)
        |operations|::Command::Copy { object, revision, realm } -> block |requests|::execute(output, gate, context, state, command)
        |operations|::Command::Loaded { temporary } -> |diagnostics|::loaded(output, gate, temporary)
        |operations|::Command::Wait -> block |waiting|::next(output, gate, context, state)
        |operations|::Command::Control { report } -> block report(output, gate, context, report)
        _ -> block |presentation|::execute(output, gate, context, state, command)
    }
}
machine interaction(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) reaches |kernel|::Kernel {
    let status: u64 = block |services|::interaction(gate, context, state);
    output.event = |operations|::Completion { transport_status: status, reply: |operations|::Reply::Complete };
}
machine acquire_storage(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) reaches |kernel|::Kernel {
    let status: u64 = block |services|::storage(gate, context, state);
    output.event = |operations|::Completion { transport_status: status, reply: |operations|::Reply::Complete };
}
machine report(output: &mut |application|::Work, gate: &|kernel|::Gate, context: &mut |main|::Context, report: |operations|::Report) reaches |kernel|::Kernel {
    block |control|::answer(gate, context, report);
    output.event = |operations|::Completion { transport_status: 0u64, reply: |operations|::Reply::Complete };
}
