use operations.omg;
use {protocol}/main.omg;
use state.omg as local_state;
use document/document.omg;
use session/session.omg;
use session/cursors.omg;
use storage/storage.omg;
public machine keys(s: &mut |local_state|::State, code: u64, action: u64) -> |operations|::Command {
    transition code == 12u64 && action == |main|::PRESS {
        true -> cursors(s)
        _ -> editor(s, code, action)
    }
    machine cursors(s: &mut |local_state|::State) -> |operations|::Command {
        s.cursor_index = 0u64;
        |cursors|::cursor_next(s)
    }
    machine editor(s: &mut |local_state|::State, code: u64, action: u64) -> |operations|::Command {
        transition !s.closing && action != 0u64 {
            true -> command(s, code, action)
            _ -> |session|::after_input(s)
        }
    }
    machine command(s: &mut |local_state|::State, code: u64, action: u64) -> |operations|::Command {
        transition code == 6u64 || code == 7u64 || code == 9u64 || code == 10u64 {
            true -> function(s, code, action)
            _ -> text(s, code)
        }
    }
    machine text(s: &mut |local_state|::State, code: u64) -> |operations|::Command {
        |document|::edit(s, code);
        |session|::after_input(s)
    }
    machine function(s: &mut |local_state|::State, code: u64, action: u64) -> |operations|::Command {
        transition action == |main|::PRESS {
            true -> available(s, code)
            _ -> |session|::after_input(s)
        }
    }
    machine available(s: &mut |local_state|::State, code: u64) -> |operations|::Command {
        transition s.temporary {
            true -> |storage|::failed(s, |main|::DENIED)
            _ -> dispatch(s, code)
        }
    }
    machine dispatch(s: &mut |local_state|::State, code: u64) -> |operations|::Command {
        transition code {
            6u64 -> f1(s)
            7u64 -> f2(s)
            9u64 -> f3(s)
            _ -> f4(s)
        }
    }
    machine f1(s: &mut |local_state|::State) -> |operations|::Command {
        s.loading = |local_state|::LoadMode::Reconcile;
        transition s.error == 0u64 && (|document|::changed(s) || s.revision == 0u64) {
            true -> |storage|::save(s)
            _ -> |storage|::load(s)
        }
    }
    machine f2(s: &mut |local_state|::State) -> |operations|::Command {
        s.loading = |local_state|::LoadMode::ReplaceDraft;
        |storage|::load(s)
    }
    machine f3(s: &mut |local_state|::State) -> |operations|::Command {
        transition s.error == 0u64 && !|document|::changed(s) && s.revision != 0u64 {
            true -> |storage|::duplicate(s)
            _ -> unchanged(s)
        }
    }
    machine f4(s: &mut |local_state|::State) -> |operations|::Command {
        transition s.error == 0u64 && !|document|::changed(s) && s.count > 1u64 && s.count <= 8u64 && s.current < 8u64 {
            true -> next(s)
            _ -> unchanged(s)
        }
    }
    machine next(s: &mut |local_state|::State) -> |operations|::Command requires s.current < 8u64 && s.count > 1u64 {
        s.current = (s.current + 1u64) % s.count;
        s.loading = |local_state|::LoadMode::ReplaceDraft;
        |storage|::head(s)
    }
    machine unchanged(s: &mut |local_state|::State) -> |operations|::Command {
        s.error = 0u64;
        s.dirty = true;
        |session|::after_input(s)
    }
}
