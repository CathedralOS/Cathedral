use state.omg as local_state;
use operations.omg;
// The app reports its state; diagnostic text encoding belongs to the bridge.
public machine loaded(s: &mut |local_state|::State) -> |operations|::Command {
    s.phase = |local_state|::Phase::LoadReported;
    s.loaded = true;
    |operations|::Command::Loaded { temporary: s.temporary }
}
