module session::cursors;
// The keyboard toggles only known pointers in its scoped input group.
use operations::Reply;
use operations::Command;
use protocol::main;
use state::State;
use state::Phase;
use session::session;
public machine cursor_next(s: &mut State) -> Command {
    transition {
        _ -> scan(s)
    }
    machine scan(s: &mut State) -> Command {
        transition s.cursor_index < 4u64 {
            true -> pointer(s)
            _ -> session::session::after_input(s)
        }
    }
    machine pointer(s: &mut State) -> Command requires s.cursor_index < 4u64 {
        transition s.channels[s.cursor_index] != 0u64 && s.groups[s.cursor_index] == s.cursor_group {
            true -> request(s)
            _ -> next(s)
        }
    }
    machine request(s: &mut State) -> Command requires s.cursor_index < 4u64 {
        s.phase = Phase::CursorChanged;
        Command::Cursor { epoch: s.epoch, channel: s.channels[s.cursor_index], hidden: !s.hidden[s.cursor_index] }
    }
    machine next(s: &mut State) -> Command requires s.cursor_index < 4u64 {
        s.cursor_index = s.cursor_index + 1u64;
        transition {
            _ -> scan(s)
        }
    }
}
public machine cursor_reply(s: &mut State, reply: Reply) -> Command {
    transition reply {
        Reply::Cursor { status } -> valid(s, status)
        _ -> (Command::Exit)
    }
    machine valid(s: &mut State, status: u64) -> Command {
        transition s.cursor_index < 4u64 {
            true -> response(s, status)
            _ -> (Command::Exit)
        }
    }
    machine response(s: &mut State, status: u64) -> Command requires s.cursor_index < 4u64 {
        transition status == 0u64 {
            true -> toggle(s)
            _ -> next(s)
        }
    }
    machine toggle(s: &mut State) -> Command requires s.cursor_index < 4u64 {
        s.hidden[s.cursor_index] = !s.hidden[s.cursor_index];
        transition {
            _ -> next(s)
        }
    }
    machine next(s: &mut State) -> Command requires s.cursor_index < 4u64 {
        s.cursor_index = s.cursor_index + 1u64;
        cursor_next(s)
    }
}
