// Acquire -> wait for placement -> load -> receive -> act -> present.
use state.omg as local_state;
use operations.omg;
use {protocol}/main.omg;
use storage/storage.omg;
use rendering/rendering.omg;
use session/input.omg;
use session/cursors.omg;
use session/diagnostics.omg;
use document/document.omg;

public machine resume(s: &mut |local_state|::State, reply: |operations|::Reply) -> |operations|::Command {
    transition s.phase {
        |local_state|::Phase::Start -> acquire_interaction(s)
        |local_state|::Phase::InteractionReady -> acquire_storage(s)
        |local_state|::Phase::StorageReady -> storage_ready(s, 0u64)
        |local_state|::Phase::Polled -> polled(s, reply)
        |local_state|::Phase::Awakened -> awakened(s, reply)
        |local_state|::Phase::ControlReplied -> wait(s)
        |local_state|::Phase::CursorChanged -> |cursors|::cursor_reply(s, reply)
        |local_state|::Phase::LoadReported -> |input|::input(s)
        |local_state|::Phase::Storage { step } -> |storage|::persistence(s, reply)
        |local_state|::Phase::Rendering { step } -> |rendering|::presentation(s, step, reply)
    }
}
machine acquire_interaction(s: &mut |local_state|::State) -> |operations|::Command {
    s.phase = |local_state|::Phase::InteractionReady;
    |operations|::Command::AcquireInteraction
}
machine acquire_storage(s: &mut |local_state|::State) -> |operations|::Command {
    s.phase = |local_state|::Phase::StorageReady;
    |operations|::Command::AcquireStorage
}
public machine storage_ready(s: &mut |local_state|::State, status: u64) -> |operations|::Command {
    s.loading = |local_state|::LoadMode::ReplaceDraft;
    transition status {
        0u64 -> poll(s)
        |main|::UNAVAILABLE -> temporary(s)
        _ -> (|operations|::Command::Exit)
    }
    machine temporary(s: &mut |local_state|::State) -> |operations|::Command {
        s.temporary = true;
        s.dirty = true;
        poll(s)
    }
}
public machine poll(s: &mut |local_state|::State) -> |operations|::Command {
    s.phase = |local_state|::Phase::Polled;
    |operations|::Command::Poll
}
machine polled(s: &mut |local_state|::State, reply: |operations|::Reply) -> |operations|::Command {
    transition reply {
        |operations|::Reply::View { view } -> observed(s, view)
        _ -> (|operations|::Command::Exit)
    }
}
machine observed(s: &mut |local_state|::State, view: |operations|::View) -> |operations|::Command {
    transition view.status == 0u64 && view.epoch != 0u64
        && view.width != 0u64 && view.height != 0u64
        && view.width < 65536u64 && view.height < 65536u64 {
        true -> accept(s, view)
        _ -> hidden(s)
    }
    machine hidden(s: &mut |local_state|::State) -> |operations|::Command {
        s.scene = false;
        s.dirty = true;
        wait(s)
    }
    machine accept(s: &mut |local_state|::State, view: |operations|::View) -> |operations|::Command {
        transition s.epoch != view.epoch {
            true -> rebound(s, view)
            _ -> geometry(s, view)
        }
    }
    machine rebound(s: &mut |local_state|::State, view: |operations|::View) -> |operations|::Command {
        |input|::reset_channels(s);
        s.scene = false;
        s.dirty = true;
        s.epoch = view.epoch;
        geometry(s, view)
    }
    machine geometry(s: &mut |local_state|::State, view: |operations|::View) -> |operations|::Command {
        s.dirty = s.dirty || s.width != view.width || s.height != view.height;
        s.width = view.width;
        s.height = view.height;
        s.frames = view.frames;
        s.requested = view.requested;
        s.more = view.more;
        s.input = view.input;
        s.drained = ((s.drained as u64 in Saturating) + 1) as u64;
        transition s.loaded {
            true -> |input|::input(s)
            _ -> first(s)
        }
    }
    machine first(s: &mut |local_state|::State) -> |operations|::Command {
        transition s.temporary {
            true -> |diagnostics|::loaded(s)
            _ -> |storage|::load(s)
        }
    }
}
public machine after_input(s: &mut |local_state|::State) -> |operations|::Command {
    transition s.more && s.drained < 8u64 {
        true -> poll(s)
        _ -> |rendering|::render(s)
    }
}
public machine wait(s: &mut |local_state|::State) -> |operations|::Command {
    s.drained = 0u64;
    s.phase = |local_state|::Phase::Awakened;
    |operations|::Command::Wait
}
machine awakened(s: &mut |local_state|::State, reply: |operations|::Reply) -> |operations|::Command {
    transition reply {
        |operations|::Reply::Wake -> poll(s)
        |operations|::Reply::Control { loss } -> control(s, loss)
        _ -> (|operations|::Command::Exit)
    }
    machine control(s: &mut |local_state|::State, loss: bool) -> |operations|::Command {
        s.phase = |local_state|::Phase::ControlReplied;
        transition loss {
            true -> (|operations|::Command::Control { report: |operations|::Report::Loss { changed: |document|::changed(s) } })
            _ -> (|operations|::Command::Control { report: |operations|::Report::Health {
                revision: s.revision, length: s.length, error: s.error,
                changed: |document|::changed(s), count: s.count, selected: selection(s)
            } })
        }
    }
}
machine selection(s: &|local_state|::State) -> u64 {
    transition s.count == 0u64 {
        true -> (0u64)
        _ -> (((s.current as u64 in Saturating) + 1) as u64)
    }
}
