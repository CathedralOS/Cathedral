module session::session;

// Acquire -> wait for placement -> load -> receive -> act -> present.
use state::State;
use state::LoadMode;
use state::Phase;
use operations::View;
use operations::Reply;
use operations::Report;
use operations::Command;
use protocol::main;
use storage::storage;
use rendering::rendering;
use session::input;
use session::cursors;
use session::diagnostics;
use document::document;

public machine resume(s: &mut State, reply: Reply) -> Command {
    transition s.phase {
        Phase::Start -> acquire_interaction(s)
        Phase::InteractionReady -> acquire_storage(s)
        Phase::StorageReady -> storage_ready(s, 0u64)
        Phase::Polled -> polled(s, reply)
        Phase::Awakened -> awakened(s, reply)
        Phase::ControlReplied -> wait(s)
        Phase::CursorChanged -> session::cursors::cursor_reply(s, reply)
        Phase::LoadReported -> session::input::input(s)
        Phase::Storage { step } -> storage::storage::persistence(s, reply)
        Phase::Rendering { step } -> rendering::rendering::presentation(s, step, reply)
    }
}
machine acquire_interaction(s: &mut State) -> Command {
    s.phase = Phase::InteractionReady;
    Command::AcquireInteraction
}
machine acquire_storage(s: &mut State) -> Command {
    s.phase = Phase::StorageReady;
    Command::AcquireStorage
}
public machine storage_ready(s: &mut State, status: u64) -> Command {
    s.loading = LoadMode::ReplaceDraft;
    transition status {
        0u64 -> poll(s)
        UNAVAILABLE -> temporary(s)
        _ -> (Command::Exit)
    }
    machine temporary(s: &mut State) -> Command {
        s.temporary = true;
        s.dirty = true;
        poll(s)
    }
}
public machine poll(s: &mut State) -> Command {
    s.phase = Phase::Polled;
    Command::Poll
}
machine polled(s: &mut State, reply: Reply) -> Command {
    transition reply {
        Reply::View { view } -> observed(s, view)
        _ -> (Command::Exit)
    }
}
machine observed(s: &mut State, view: View) -> Command {
    transition view.status == 0u64 && view.epoch != 0u64
        && view.width != 0u64 && view.height != 0u64
        && view.width < 65536u64 && view.height < 65536u64 {
        true -> accept(s, view)
        _ -> hidden(s)
    }
    machine hidden(s: &mut State) -> Command {
        s.scene = false;
        s.dirty = true;
        wait(s)
    }
    machine accept(s: &mut State, view: View) -> Command {
        transition s.epoch != view.epoch {
            true -> rebound(s, view)
            _ -> geometry(s, view)
        }
    }
    machine rebound(s: &mut State, view: View) -> Command {
        session::input::reset_channels(s);
        s.scene = false;
        s.dirty = true;
        s.epoch = view.epoch;
        geometry(s, view)
    }
    machine geometry(s: &mut State, view: View) -> Command {
        s.dirty = s.dirty || s.width != view.width || s.height != view.height;
        s.width = view.width;
        s.height = view.height;
        s.frames = view.frames;
        s.requested = view.requested;
        s.more = view.more;
        s.input = view.input;
        s.drained = ((s.drained as u64 in Saturating) + 1) as u64;
        transition s.loaded {
            true -> session::input::input(s)
            _ -> first(s)
        }
    }
    machine first(s: &mut State) -> Command {
        transition s.temporary {
            true -> session::diagnostics::loaded(s)
            _ -> storage::storage::load(s)
        }
    }
}
public machine after_input(s: &mut State) -> Command {
    transition s.more && s.drained < 8u64 {
        true -> poll(s)
        _ -> rendering::rendering::render(s)
    }
}
public machine wait(s: &mut State) -> Command {
    s.drained = 0u64;
    s.phase = Phase::Awakened;
    Command::Wait
}
machine awakened(s: &mut State, reply: Reply) -> Command {
    transition reply {
        Reply::Wake -> poll(s)
        Reply::Control { loss } -> control(s, loss)
        _ -> (Command::Exit)
    }
    machine control(s: &mut State, loss: bool) -> Command {
        s.phase = Phase::ControlReplied;
        transition loss {
            true -> (Command::Control { report: Report::Loss { changed: document::document::changed(s) } })
            _ -> (Command::Control { report: Report::Health {
                revision: s.revision, length: s.length, error: s.error,
                changed: document::document::changed(s), count: s.count, selected: selection(s)
            } })
        }
    }
}
machine selection(s: &State) -> u64 {
    transition s.count == 0u64 {
        true -> (0u64)
        _ -> (((s.current as u64 in Saturating) + 1) as u64)
    }
}
