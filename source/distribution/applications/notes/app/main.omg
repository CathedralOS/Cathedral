module main;

// Advance one completed operation. Storage retains uncertain outcomes; startup
// interprets optional service refusal. Reporting remains best effort; other
// transport loss stops the app.
use state::State;
use state::Phase;
use operations::Completion;
use operations::Command;
use session::session;
use session::input;
use storage::storage;
public machine advance(s: &mut State, completion: &Completion) -> Command {
    transition completion.transport_status == 0u64 {
        true -> session::session::resume(s, completion.reply)
        _ -> failed(s, completion.transport_status)
    }
    machine failed(s: &mut State, status: u64) -> Command {
        transition s.phase {
            Phase::StorageReady -> session::session::storage_ready(s, status)
            Phase::ControlReplied -> session::session::wait(s)
            Phase::LoadReported -> session::input::input(s)
            Phase::Storage { step } -> storage::storage::failed(s, status)
            _ -> (Command::Exit)
        }
    }
}
