// The bounded editor and NTS1 schema belong to Notes, not the storage service.
use state;
use document::encoding;
public machine changed(s: &State) -> bool {
    transition s.length != s.saved_length { true -> (true) _ -> scan(s, 0u64) }
    state scan(s: &State, i: u64) -> bool {
        transition i < s.length && i < 240u64 { true -> byte(s, i) _ -> (false) }
    }
    state byte(s: &State, i: u64) -> bool requires i < 240u64 {
        transition s.draft[i] != s.confirmed[i] { true -> (true) _ -> scan(s, i + 1u64) }
    }
}
public machine confirm(s: &mut State) {
    s.saved_length = s.length;
    transition { _ -> copy(s, 0u64) }
    state copy(s: &mut State, i: u64) {
        transition i < 240u64 { true -> byte(s, i) _ -> done() }
    }
    state byte(s: &mut State, i: u64) requires i < 240u64 {
        s.confirmed[i] = s.draft[i]; transition { _ -> copy(s, i + 1u64) }
    }
    state done() {}
}
public machine edit(s: &mut State, key: u64) {
    transition s.length <= 240u64 && s.cursor <= s.length {
        true -> command(s, key) _ -> done()
    }
    state command(s: &mut State, key: u64) {
        transition key {
            3u64 -> left(s)
            4u64 -> right(s)
            52u64 -> backspace(s)
            _ -> character(s, key)
        }
    }
    state left(s: &mut State) { s.cursor = ((s.cursor as u64 in Saturating) - 1) as u64; s.dirty = true; }
    state right(s: &mut State) {
        transition s.cursor < s.length && s.cursor < 240u64 { true -> advance(s) _ -> done() }
    }
    state advance(s: &mut State) requires s.cursor < 240u64 { s.cursor = s.cursor + 1u64; s.dirty = true; }
    state backspace(s: &mut State) {
        transition s.cursor > 0u64 && s.cursor <= 240u64 && s.length > 0u64 && s.length <= 240u64 { true -> erase(s) _ -> done() }
    }
    state erase(s: &mut State) requires s.cursor > 0u64 && s.length > 0u64 {
        s.cursor = s.cursor - 1u64; s.length = s.length - 1u64; s.dirty = true;
        let start: u64 = s.cursor; transition { _ -> shift_left(s, start) }
    }
    state shift_left(s: &mut State, i: u64) {
        transition i < s.length && i < 239u64 { true -> move_left(s, i) _ -> clear(s) }
    }
    state move_left(s: &mut State, i: u64) requires i < 239u64 {
        s.draft[i] = s.draft[i + 1u64]; transition { _ -> shift_left(s, i + 1u64) }
    }
    state clear(s: &mut State) { transition s.length < 240u64 { true -> zero(s) _ -> done() } }
    state zero(s: &mut State) requires s.length < 240u64 { s.draft[s.length] = 0u8; }
    state character(s: &mut State, key: u64) {
        let byte: u64 = key_byte(key);
        transition byte != 0u64 && s.length < 240u64 { true -> insert(s, byte) _ -> done() }
    }
    state insert(s: &mut State, byte: u64) { let end: u64 = s.length; transition { _ -> shift_right(s, byte, end) } }
    state shift_right(s: &mut State, byte: u64, i: u64) {
        transition i > s.cursor && i > 0u64 && i < 240u64 { true -> move_right(s, byte, i) _ -> put(s, byte) }
    }
    state move_right(s: &mut State, byte: u64, i: u64) requires i > 0u64 && i < 240u64 {
        s.draft[i] = s.draft[i - 1u64]; transition { _ -> shift_right(s, byte, i - 1u64) }
    }
    state put(s: &mut State, byte: u64) {
        transition s.cursor < 240u64 && s.length < 240u64 && byte < 256u64 { true -> commit(s, byte) _ -> done() }
    }
    state commit(s: &mut State, byte: u64) requires s.cursor < 240u64 && s.length < 240u64 && byte < 256u64 {
        s.draft[s.cursor] = byte as u8; s.cursor = s.cursor + 1u64; s.length = s.length + 1u64; s.dirty = true;
    }
    state done() {}
}
machine key_byte(key: u64) -> u64 {
    transition key >= 15u64 && key <= 40u64 { true -> letter(key) _ -> digit_check(key) }
    state letter(key: u64) -> u64 requires key >= 15u64 && key <= 40u64 { 97u64 + key - 15u64 }
    state digit_check(key: u64) -> u64 { transition key >= 41u64 && key <= 50u64 { true -> digit(key) _ -> other(key) } }
    state digit(key: u64) -> u64 requires key >= 41u64 && key <= 50u64 { 48u64 + key - 41u64 }
    state other(key: u64) -> u64 { transition key { 51u64 -> (32u64) 5u64 -> (10u64) _ -> (0u64) } }
}
