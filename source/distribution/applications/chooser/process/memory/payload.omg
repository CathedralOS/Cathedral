use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/memory/staging.omg;
use {runtime}/memory/object.omg;
public machine create(gate: &|kernel|::Gate, exchange: &|operations|::Exchange) -> |object|::Creation reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition exchange.payload_bytes > 0u64 && exchange.payload_bytes <= 4080u64 {
        true -> block allocate(gate, exchange)
        _ -> (|object|::Creation::Failed { code: |kernel|::INVALID_ARGUMENT })
    }
    machine allocate(gate: &|kernel|::Gate, exchange: &|operations|::Exchange) -> |object|::Creation reaches |kernel|::Kernel requires exchange.payload_bytes > 0u64 && exchange.payload_bytes <= 4080u64 {
        let result: |staging|::Allocation = block |staging|::allocate(gate, exchange.payload_bytes);
        transition result {
            |staging|::Allocation::Ready { buffer } -> block fill(gate, exchange, buffer)
            |staging|::Allocation::Failed { code } -> (|object|::Creation::Failed { code: code })
        }
    }
    machine fill(gate: &|kernel|::Gate, exchange: &|operations|::Exchange, buffer: |staging|::Buffer) -> |object|::Creation reaches |kernel|::Kernel {
        let mut backing: |staging|::Buffer = buffer;
        let status: u64 = block write(gate, &backing, 0u64, exchange);
        transition status == 0u64 {
            true -> block |staging|::seal(gate, &mut backing)
            _ -> block failed(gate, &mut backing, status)
        }
    }
    machine failed(gate: &|kernel|::Gate, buffer: &mut |staging|::Buffer, code: u64) -> |object|::Creation reaches |kernel|::Kernel {
        let ignored: u64 = block |staging|::release(gate, buffer);
        |object|::Creation::Failed { code: code }
    }
}
// This scratch frame ends before a service wait can dispatch owner control.
public machine write(gate: &|kernel|::Gate, buffer: &|staging|::Buffer, offset: u64, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition exchange.payload_bytes > 0u64 && exchange.payload_bytes <= 4080u64 {
        true -> block bounded(gate, buffer, offset, exchange)
        _ -> (|kernel|::INVALID_ARGUMENT)
    }
    machine bounded(gate: &|kernel|::Gate, buffer: &|staging|::Buffer, offset: u64, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel requires exchange.payload_bytes > 0u64 && exchange.payload_bytes <= 4080u64 {
        let mut words: [u64; 1024];
        pack(&mut words, exchange, 0u64);
        block |staging|::write(gate, buffer, offset, &words, exchange.payload_bytes)
    }
}
machine pack(words: &mut [u64; 1024], exchange: &|operations|::Exchange, i: u64) {
    transition i < 510u64 && i * 8u64 < exchange.payload_bytes {
        true -> word(words, exchange, i)
        _ -> done()
    }
    machine word(words: &mut [u64; 1024], exchange: &|operations|::Exchange, i: u64) requires i < 510u64 {
        words[i] = exchange.payload[i];
        transition { _ -> pack(words, exchange, i + 1u64) }
    }
}
machine done() {}
