module main;
// Installed authority -> app execution -> release every locally held object.
use runtime::entry::Program;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::services::main::Services;
use runtime::server::main::Server;
use runtime::storage::main::Scope;
use startup;
use application::application;
public data Context {
    services: Services;
    owner: Server;
    clock: u64;
    storage: Scope;
    pending_storage: bool;
    pending_deadline: u64;
    image: runtime::memory::staging::Buffer;
    image_filled: u64;
    ready_image: u64;
}
public ProgramProvider satisfies Program {
    machine run(gate: &Gate, first: u64, argument: u64) -> u64 reaches Kernel blocks; invokes Kernel; {
        let mut context: Context;
        let status: u64 = block startup::open(gate, &mut context);
        transition status == 0u64 {
            true -> block started(gate, &mut context, argument)
            _ -> block finished(gate, &mut context, status)
        }
    }
}
machine started(gate: &Gate, context: &mut Context, argument: u64) -> u64 reaches Kernel {
    let status: u64 = block application::application::run(gate, context, argument);
    transition { _ -> block finished(gate, context, status) }
}
machine finished(gate: &Gate, context: &mut Context, status: u64) -> u64 reaches Kernel {
    let image: u64 = block runtime::memory::staging::release(gate, &mut context.image);
    let ready: u64 = block Kernel::memory_release(gate, context.ready_image);
    let stored: u64 = block runtime::connection::main::close(gate, &mut context.storage.peer);
    block runtime::services::main::close(gate, &mut context.services);
    block runtime::server::main::close(gate, &mut context.owner);
    status
}
public machine component_entry() reaches Program + Kernel blocks; invokes Program; invokes Kernel; {
    let gate: Gate;
    let status: u64 = block Program::run(&gate, 0u64, 0u64);
}
