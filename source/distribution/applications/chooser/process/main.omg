use {runtime}/connection/main.omg as connection_main;
use {runtime}/memory/staging.omg;
// Installed authority -> app execution -> release every locally held object.
use {runtime}/entry.omg;
use {runtime}/kernel.omg;
use {runtime}/services/main.omg;
use {runtime}/server/main.omg as server_main;
use {runtime}/storage/main.omg as storage_main;
use startup.omg;
use application/application.omg;
public data Context {
    services: |main|::Services;
    owner: |server_main|::Server;
    clock: u64;
    storage: |storage_main|::Scope;
    pending_storage: bool;
    pending_deadline: u64;
    image: |staging|::Buffer;
    image_filled: u64;
    ready_image: u64;
}
public ProgramProvider satisfies |entry|::Program {
    machine run(gate: &|kernel|::Gate, first: u64, argument: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
        let mut context: Context;
        let status: u64 = block |startup|::open(gate, &mut context);
        transition status == 0u64 {
            true -> block started(gate, &mut context, argument)
            _ -> block finished(gate, &mut context, status)
        }
    }
}
machine started(gate: &|kernel|::Gate, context: &mut Context, argument: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |application|::run(gate, context, argument);
    transition { _ -> block finished(gate, context, status) }
}
machine finished(gate: &|kernel|::Gate, context: &mut Context, status: u64) -> u64 reaches |kernel|::Kernel {
    let image: u64 = block |staging|::release(gate, &mut context.image);
    let ready: u64 = block |kernel|::Kernel::memory_release(gate, context.ready_image);
    let stored: u64 = block |connection_main|::close(gate, &mut context.storage.peer);
    block |main|::close(gate, &mut context.services);
    block |server_main|::close(gate, &mut context.owner);
    status
}
public machine component_entry() reaches |entry|::Program + |kernel|::Kernel blocks invokes |entry|::Program invokes |kernel|::Kernel {
    let gate: |kernel|::Gate;
    let status: u64 = block |entry|::Program::run(&gate, 0u64, 0u64);
}
