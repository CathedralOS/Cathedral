use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use {runtime}/storage/main.omg as storage_main;
use services/requests.omg;
public machine bind(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, exchange: &mut |operations|::Exchange) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block request(gate, context, state, exchange, value)
        |time|::Tick::Failed { code } -> (code)
    }
    machine request(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, exchange: &mut |operations|::Exchange, now: u64) -> u64 reaches |kernel|::Kernel {
        let words: [u64; 8] = |storage_main|::bind_request(now);
        let status: u64 = block |requests|::call(gate, context, state, exchange, true, &words, 0u64, 0u64, 0u64);
        transition status == 0u64 {
            true -> installed(context, exchange)
            _ -> (status)
        }
    }
    machine installed(context: &mut |main|::Context, exchange: &mut |operations|::Exchange) -> u64 {
        let status: u64 = |storage_main|::bound(&mut context.storage, exchange.frame);
        exchange.frame = [status, context.storage.realm, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64];
        status
    }
}
