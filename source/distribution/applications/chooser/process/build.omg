use main.omg;
use {runtime}/arch/x86_64/gate.omg;
use {runtime}/entry.omg;
use {runtime}/kernel.omg;
machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_chooser_process");
    Build::depend_as(builder, "app", Source::Path { location: "../app" });
    Build::depend_as(builder, "runtime", Source::Path { location: "../../../../platform/libraries/user-runtime" });
    Build::depend_as(builder, "protocol", Source::Path { location: "../../../../platform/contracts/reference" });
    Build::select_provider<|entry|::Program, |main|::ProgramProvider>(builder, linux_x86_64);
    Build::select_provider<|kernel|::Kernel, |gate|::NativeKernel>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |main|::component_entry);
}
