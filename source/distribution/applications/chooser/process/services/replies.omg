// The only incoming attachment is a bounded ENTRIES page. Every path releases it.
use main.omg;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/connection/call.omg;
use {runtime}/connection/main.omg as connection_main;
use storage/entries.omg;
public machine accept(gate: &|kernel|::Gate, context: &mut |main|::Context, output: &mut |operations|::Exchange, result: |call|::CallReply, limit: u64, after: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition result {
        |call|::CallReply::Received { frame, notification } -> block plain(gate, context, output, frame, notification, limit)
        |call|::CallReply::Object { frame, object } -> block object(gate, context, output, frame, object, limit, after)
        |call|::CallReply::Endpoint { frame, endpoint } -> block unexpected_endpoint(gate, context, endpoint)
        |call|::CallReply::Failed { code } -> (code)
    }
}
machine plain(gate: &|kernel|::Gate, context: &mut |main|::Context, output: &mut |operations|::Exchange, frame: |connection_main|::Frame, notification: u64, limit: u64) -> u64 reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && notification == 0u64 && (limit == 0u64 || frame.payload[0] != 0u64 || (limit <= 4080u64 && frame.payload[1] == 0u64)) {
        true -> decoded(output, frame.payload)
        _ -> block unexpected_notification(gate, context, notification)
    }
    machine decoded(output: &mut |operations|::Exchange, words: [u64; 8]) -> u64 { output.frame = words; 0u64 }
}
machine object(gate: &|kernel|::Gate, context: &mut |main|::Context, output: &mut |operations|::Exchange, frame: |connection_main|::Frame, object: u64, limit: u64, after: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block contents(gate, output, frame, object, limit, after);
    let released: u64 = block |kernel|::Kernel::memory_release(gate, object);
    transition status == 0u64 && released == 0u64 {
        true -> (0u64)
        _ -> block malformed(gate, context)
    }
}
machine contents(gate: &|kernel|::Gate, output: &mut |operations|::Exchange, frame: |connection_main|::Frame, object: u64, limit: u64, after: u64) -> u64 reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && limit != 0u64 {
        true -> block entries(gate, output, frame.payload, object, limit, after)
        _ -> (|kernel|::IO_ERROR)
    }
    machine entries(gate: &|kernel|::Gate, output: &mut |operations|::Exchange, words: [u64; 8], object: u64, limit: u64, after: u64) -> u64 reaches |kernel|::Kernel {
        output.frame = words;
        block |entries|::receive(gate, output, object, limit, after)
    }
}
machine unexpected_endpoint(gate: &|kernel|::Gate, context: &mut |main|::Context, endpoint: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    transition { _ -> block malformed(gate, context) }
}
machine unexpected_notification(gate: &|kernel|::Gate, context: &mut |main|::Context, notification: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    transition { _ -> block malformed(gate, context) }
}
machine malformed(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block retire(gate, context);
    |kernel|::IO_ERROR
}
machine retire(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel {
    transition context.pending_storage {
        true -> block |connection_main|::close(gate, &mut context.storage.peer)
        _ -> block |connection_main|::close(gate, &mut context.services.broker)
    }
}
