use {runtime}/server/main.omg as server_main;
// Publish exactly once, then service independent owner control while waiting.
// Storage carries its end-to-end deadline. Presentation parking is only a hint.
use main.omg;
use {app}/state.omg as app_state;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use {runtime}/connection/main.omg as connection_main;
use {runtime}/connection/call.omg;
use services/control.omg;

public machine request(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, storage: bool,
    words: &[u64; 8], object: u64, deadline: u64) -> |call|::CallReply reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    context.pending_storage = storage;
    context.pending_deadline = deadline;
    let status: u64 = block begin(gate, context, words, object);
    transition status == 0u64 {
        true -> block poll(gate, context, state)
        _ -> (|call|::CallReply::Failed { code: status })
    }
}
machine begin(gate: &|kernel|::Gate, context: &mut |main|::Context, words: &[u64; 8], object: u64) -> u64 reaches |kernel|::Kernel {
    transition context.pending_storage {
        true -> block |connection_main|::begin_object(gate, &mut context.storage.peer, words, object)
        _ -> block |connection_main|::begin_object(gate, &mut context.services.broker, words, object)
    }
}
machine poll(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) -> |call|::CallReply reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block owner(gate, context, state, value)
        |time|::Tick::Failed { code } -> block failed(gate, context, code)
    }
}
machine owner(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) -> |call|::CallReply reaches |kernel|::Kernel {
    block |control|::poll(gate, context, state, now);
    let reply: |connection_main|::Reply = block receive(gate, context, now);
    transition reply {
        |connection_main|::Reply::Complete { frame, notification } -> (|call|::CallReply::Received { frame: frame, notification: notification })
        |connection_main|::Reply::Object { frame, object } -> (|call|::CallReply::Object { frame: frame, object: object })
        |connection_main|::Reply::Endpoint { frame, endpoint } -> (|call|::CallReply::Endpoint { frame: frame, endpoint: endpoint })
        |connection_main|::Reply::Failed { code } -> (|call|::CallReply::Failed { code: code })
        |connection_main|::Reply::Pending -> block pending(gate, context, state, now)
    }
}
machine receive(gate: &|kernel|::Gate, context: &mut |main|::Context, now: u64) -> |connection_main|::Reply reaches |kernel|::Kernel {
    transition context.pending_storage {
        true -> block |connection_main|::poll(gate, &mut context.storage.peer, now)
        _ -> block |connection_main|::poll(gate, &mut context.services.broker, now)
    }
}
machine pending(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) -> |call|::CallReply reaches |kernel|::Kernel {
    transition context.pending_deadline != 0u64 && |time|::reached(now, context.pending_deadline) {
        true -> block failed(gate, context, |kernel|::TIMED_OUT)
        _ -> block prepare(gate, context, state, now)
    }
}
machine prepare(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) -> |call|::CallReply reaches |kernel|::Kernel {
    let mut interests: [u64; 8];
    let deadline: u64 = selected(context, &mut interests, |time|::after(now, 300u64));
    transition context.owner.peer.fault == 0u64 {
        true -> block combined(gate, context, state, &mut interests, deadline)
        _ -> block wait(gate, context, state, &interests, 2u64, deadline)
    }
}
machine selected(context: &|main|::Context, interests: &mut [u64; 8], deadline: u64) -> u64 {
    transition context.pending_storage {
        true -> peer(&context.storage.peer, interests, deadline, context.pending_deadline)
        _ -> peer(&context.services.broker, interests, deadline, context.pending_deadline)
    }
}
machine peer(peer: &|connection_main|::Peer, interests: &mut [u64; 8], deadline: u64, expiry: u64) -> u64 {
    interests[0] = 2u64; interests[1] = peer.bell.wait; interests[3] = peer.receiver;
    transition peer.partial && |time|::reached(deadline, peer.partial_deadline) {
        true -> bounded(peer.partial_deadline, expiry)
        _ -> bounded(deadline, expiry)
    }
}
machine bounded(deadline: u64, expiry: u64) -> u64 {
    transition expiry != 0u64 && |time|::reached(deadline, expiry) {
        true -> (expiry)
        _ -> (deadline)
    }
}
machine combined(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, interests: &mut [u64; 8], deadline: u64) -> |call|::CallReply reaches |kernel|::Kernel {
    interests[4] = 2u64; interests[5] = context.owner.peer.bell.wait; interests[7] = context.owner.peer.receiver;
    transition { _ -> (block wait(gate, context, state, interests, 4u64, deadline)) }
}
machine wait(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, interests: &[u64; 8], count: u64 [0..=4], deadline: u64) -> |call|::CallReply reaches |kernel|::Kernel {
    let status: u64 = block |kernel|::Kernel::wait(gate, interests, count, deadline);
    transition status < count || status == |kernel|::TIMED_OUT || status == |kernel|::PEER_CLOSED {
        true -> (block poll(gate, context, state))
        _ -> block interrupted(gate, context, state, status)
    }
}
machine interrupted(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, code: u64) -> |call|::CallReply reaches |kernel|::Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block detach(gate, context, state)
        _ -> block failed(gate, context, code)
    }
    machine detach(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State) -> |call|::CallReply reaches |kernel|::Kernel {
        block |server_main|::close(gate, &mut context.owner);
        transition { _ -> (block poll(gate, context, state)) }
    }
}
machine failed(gate: &|kernel|::Gate, context: &mut |main|::Context, code: u64) -> |call|::CallReply reaches |kernel|::Kernel {
    let ignored: u64 = block close(gate, context);
    |call|::CallReply::Failed { code: code }
}
machine close(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel {
    transition context.pending_storage {
        true -> block |connection_main|::close(gate, &mut context.storage.peer)
        _ -> block |connection_main|::close(gate, &mut context.services.broker)
    }
}
