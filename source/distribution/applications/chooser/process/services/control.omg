// Owner queries are independent of a pending storage or compositor request.
use main.omg;
use {app}/state.omg as app_state;
use {app}/settings/settings.omg;
use {runtime}/kernel.omg;
use {runtime}/server/main.omg as server_main;
use {protocol}/main.omg as protocol_main;
public machine poll(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.owner.peer.fault == 0u64 {
        true -> block receive(gate, context, state, now)
        _ -> done()
    }
}
machine receive(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, now: u64) reaches |kernel|::Kernel {
    let event: |server_main|::Event = block |server_main|::poll(gate, &mut context.owner, now);
    transition event {
        |server_main|::Event::Request { frame } -> block answer(gate, context, state, frame.bytes, frame.payload)
        _ -> done()
    }
}
machine answer(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, bytes: u64, request: [u64; 8]) reaches |kernel|::Kernel {
    let mut reply: [u64; 8];
    transition bytes == 64u64 && (request[0] == |protocol_main|::HEALTH || request[0] == |protocol_main|::LOSS)
        && request[1] == 0u64 && request[2] == 0u64 && request[3] == 0u64
        && request[4] == 0u64 && request[5] == 0u64 && request[6] == 0u64 && request[7] == 0u64 {
        true -> block report(gate, context, state, request[0], &mut reply)
        _ -> block refuse(gate, context, &mut reply)
    }
    machine report(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, operation: u64, reply: &mut [u64; 8]) reaches |kernel|::Kernel {
        reply[1] = (operation == |protocol_main|::LOSS && state.editing && |settings|::settings_dirty(state)) as u64;
        let ignored: u64 = block send(gate, context, reply);
    }
    machine refuse(gate: &|kernel|::Gate, context: &mut |main|::Context, reply: &mut [u64; 8]) reaches |kernel|::Kernel {
        reply[0] = |protocol_main|::INVALID_ARGUMENT;
        let ignored: u64 = block send(gate, context, reply);
    }
}
public machine send(gate: &|kernel|::Gate, context: &mut |main|::Context, words: &[u64; 8]) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block |server_main|::reply(gate, &mut context.owner, words);
    transition status == 0u64 {
        true -> (0u64)
        _ -> block failed(gate, context, status)
    }
    // A failed publication must not leave a pending owner request wedged while
    // the chooser continues servicing its independent storage/presentation peers.
    machine failed(gate: &|kernel|::Gate, context: &mut |main|::Context, status: u64) -> u64 reaches |kernel|::Kernel {
        block |server_main|::close(gate, &mut context.owner);
        status
    }
}
machine done() {}
