// App intent selects a supplied service, image staging, clock or parking.
use main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use services/services.omg;
use services/requests.omg;
use services/control.omg;
use services/waiting.omg;
use storage/binding.omg;
use presentation/images.omg;
public machine execute(gate: &|kernel|::Gate, context: &mut |main|::Context, state: &|app_state|::State, exchange: &mut |operations|::Exchange, command: |operations|::Command) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition command {
        |operations|::Command::AcquireInteraction -> block |services|::interaction(gate, context, state)
        |operations|::Command::AcquireStorage -> block |services|::storage(gate, context, state)
        |operations|::Command::BindStorage -> block |binding|::bind(gate, context, state, exchange)
        |operations|::Command::Storage -> block |requests|::storage(gate, context, state, exchange)
        |operations|::Command::Interaction -> block |requests|::interaction(gate, context, state, exchange)
        |operations|::Command::StageImage -> block |images|::stage(gate, context, exchange)
        |operations|::Command::Wait -> block |waiting|::next(gate, context, state, exchange.refresh_ticks)
        |operations|::Command::Control -> block |control|::send(gate, context, &exchange.frame)
        |operations|::Command::Clock -> clock(gate, context, exchange)
        |operations|::Command::Exit -> (0u64)
    }
}
machine clock(gate: &|kernel|::Gate, context: &|main|::Context, exchange: &mut |operations|::Exchange) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> read(exchange, value)
        |time|::Tick::Failed { code } -> (code)
    }
    machine read(exchange: &mut |operations|::Exchange, value: u64) -> u64 {
        exchange.frame = [value, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64];
        0u64
    }
}
