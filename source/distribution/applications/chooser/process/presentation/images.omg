// Ordered app-owned chunks -> sealed immutable backing -> request custody.
use main.omg;
use {app}/operations.omg;
use {runtime}/kernel.omg;
use {runtime}/memory/staging.omg;
use {runtime}/memory/object.omg;
use memory/payload.omg;
public machine stage(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition exchange.frame[0] > 0u64 && exchange.frame[0] <= 65536u64
        && exchange.payload_bytes > 0u64 && exchange.payload_bytes <= 4080u64 {
        true -> block prepare(gate, context, exchange)
        _ -> block failed(gate, context, |kernel|::INVALID_ARGUMENT)
    }
}
machine prepare(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel {
    transition exchange.frame[1] == 0u64 {
        true -> block allocate(gate, context, exchange)
        _ -> block append(gate, context, exchange)
    }
}
machine allocate(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel {
    block discard(gate, context);
    transition exchange.frame[0] > 0u64 && exchange.frame[0] <= 65536u64 {
        true -> block create(gate, context, exchange)
        _ -> (|kernel|::INVALID_ARGUMENT)
    }
    machine create(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel requires exchange.frame[0] > 0u64 && exchange.frame[0] <= 65536u64 {
        let result: |staging|::Allocation = block |staging|::allocate(gate, exchange.frame[0]);
        transition result {
            |staging|::Allocation::Ready { buffer } -> block installed(gate, context, exchange, buffer)
            |staging|::Allocation::Failed { code } -> (code)
        }
    }
    machine installed(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange, buffer: |staging|::Buffer) -> u64 reaches |kernel|::Kernel {
        context.image = buffer;
        transition { _ -> block append(gate, context, exchange) }
    }
}
machine append(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel {
    transition context.image.handle != 0u64 && context.ready_image == 0u64
        && context.image.bytes == exchange.frame[0] && context.image_filled == exchange.frame[1] {
        true -> block fill(gate, context, exchange)
        _ -> block failed(gate, context, |kernel|::INVALID_ARGUMENT)
    }
}
machine fill(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |payload|::write(gate, &context.image, exchange.frame[1], exchange);
    transition status == 0u64 && context.image_filled <= 65536u64 && exchange.payload_bytes <= 4080u64 {
        true -> block progress(gate, context, exchange)
        _ -> block failed(gate, context, status)
    }
    machine progress(gate: &|kernel|::Gate, context: &mut |main|::Context, exchange: &|operations|::Exchange) -> u64 reaches |kernel|::Kernel requires context.image_filled <= 65536u64 && exchange.payload_bytes <= 4080u64 {
        context.image_filled = context.image_filled + exchange.payload_bytes;
        transition context.image_filled == context.image.bytes {
            true -> block seal(gate, context)
            _ -> (0u64)
        }
    }
}
machine seal(gate: &|kernel|::Gate, context: &mut |main|::Context) -> u64 reaches |kernel|::Kernel {
    let result: |object|::Creation = block |staging|::seal(gate, &mut context.image);
    context.image_filled = 0u64;
    transition result {
        |object|::Creation::Ready { object } -> ready(context, object.handle)
        |object|::Creation::Failed { code } -> (code)
    }
    machine ready(context: &mut |main|::Context, handle: u64) -> u64 { context.ready_image = handle; 0u64 }
}
public machine discard(gate: &|kernel|::Gate, context: &mut |main|::Context) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let partial: u64 = block |staging|::release(gate, &mut context.image);
    let ready: u64 = block |kernel|::Kernel::memory_release(gate, context.ready_image);
    context.ready_image = 0u64; context.image_filled = 0u64;
}
machine failed(gate: &|kernel|::Gate, context: &mut |main|::Context, code: u64) -> u64 reaches |kernel|::Kernel {
    block discard(gate, context);
    code
}
machine done() {}
