// Compatibility boundary for the retained Rust host and compiled model tests.
// No host packet is passed into the chooser app itself.
use {app}/main.omg;
use {app}/state.omg as app_state;
use {app}/operations.omg;
use packets.omg;
public boundary trait ChooserApp {
    machine step(s: &mut |app_state|::State, p: &mut [u64; 4096]) -> u64 reaches;
}
public ChooserAppProvider satisfies ChooserApp {
    machine step(s: &mut |app_state|::State, p: &mut [u64; 4096]) -> u64 {
        transition p[15] {
            1u64 -> (size_of<|app_state|::State>())
            2u64 -> (align_of<|app_state|::State>())
            3u64 -> (1u64)
            _ -> execute(s, p)
        }
    }
}
machine execute(s: &mut |app_state|::State, p: &mut [u64; 4096]) -> u64 {
    let mut exchange: |operations|::Exchange;
    |packets|::decode(s, p, &mut exchange);
    let command: |operations|::Command = |main|::advance(s, &mut exchange);
    |packets|::encode(p, &exchange);
    |packets|::operation(command)
}
public machine component_entry() reaches ChooserApp invokes ChooserApp {
    let mut s: |app_state|::State;
    let mut p: [u64; 4096];
    let result: u64 = ChooserApp::step(&mut s, &mut p);
}
