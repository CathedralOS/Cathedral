machine build(builder: &mut Build) {
    Build::application(builder, "cathedral_chooser_native");
    Build::depend_as(builder, "policy", Source::Path { location: "../policy" });
    Build::select_provider<policy::main::Chooser, policy::main::ChooserProvider>(builder, CompositionMode::Independent);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
