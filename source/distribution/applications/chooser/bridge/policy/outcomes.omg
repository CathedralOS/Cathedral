use {decisions}/outcomes.omg;


public machine outcome(p: &mut [u64; 128]) -> u64 {
    let result: |outcomes|::Outcome = |outcomes|::outcome(operation(p[1]), p[2], p[3]);
    p[80] = notice(result.notice);
    p[81] = result.receipt;
    1u64
}
public machine after_select(p: &mut [u64; 128]) -> u64 {
    let result: |outcomes|::SelectionReply = |outcomes|::after_select(p[1], p[2] != 0u64);
    p[80] = result.close as u64;
    p[81] = notice(result.notice);
    1u64
}
public machine observation(p: &mut [u64; 128]) -> u64 {
    let result: |outcomes|::Observation = |outcomes|::observation(p[1], p[2]);
    p[80] = result.running as u64;
    p[81] = notice(result.notice);
    1u64
}
machine operation(word: u64) -> |outcomes|::Operation {
    transition word {
        0u64 -> (|outcomes|::Operation::Launch)
        2u64 -> (|outcomes|::Operation::Close)
        3u64 -> (|outcomes|::Operation::Copy)
        _ -> (|outcomes|::Operation::Retry)
    }
}
machine notice(value: |outcomes|::Notice) -> u64 {
    transition value {
        |outcomes|::Notice::None -> (0u64)
        |outcomes|::Notice::Unavailable -> (1u64)
        |outcomes|::Notice::Retry -> (2u64)
        |outcomes|::Notice::Capacity -> (3u64)
        |outcomes|::Notice::Unsaved -> (4u64)
        |outcomes|::Notice::Stopped -> (5u64)
        _ -> (0u64)
    }
}
