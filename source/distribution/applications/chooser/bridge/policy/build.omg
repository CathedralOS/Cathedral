use main.omg;

machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_chooser_bridge");
    Build::depend_as(builder, "decisions", Source::Path { location: "../../policy" });
    Build::depend_as(builder, "protocol", Source::Path { location: "../../../../../platform/contracts/reference" });
    Build::select_provider<|main|::Chooser, |main|::ChooserProvider>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |main|::component_entry);
}
