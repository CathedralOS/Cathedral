use interaction/model.omg;

// Input -> selection. Pointer geometry and keyboard navigation share tile IDs.
use interaction/pointer.omg;
use interaction/keyboard.omg;

public machine selection(context: &|model|::Context, input: |model|::Input) -> |model|::Selection {
    transition input {
        |model|::Input::Pointer { x, y, clicked } -> |pointer|::select_pointer(context, x, y, clicked)
        |model|::Input::Key { code, pressed } -> |keyboard|::select_key(context, code, pressed)
        _ -> |model|::unchanged(context)
    }
}
