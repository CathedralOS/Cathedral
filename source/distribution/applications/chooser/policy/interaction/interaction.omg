module interaction::interaction;

use interaction::model::Input;

// Input -> selection. Pointer geometry and keyboard navigation share tile IDs.
use interaction::model;
use interaction::pointer;
use interaction::keyboard;

public machine selection(context: &model::Context, input: Input) -> model::Selection {
    transition input {
        Input::Pointer { x, y, clicked } -> pointer::select_pointer(context, x, y, clicked)
        Input::Key { code, pressed } -> keyboard::select_key(context, code, pressed)
        _ -> model::unchanged(context)
    }
}
