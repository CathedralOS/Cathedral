// Status tags are presentation data for the retained Rust painter. The matrix's
// reply, not optimistic local state, decides whether work was accepted.
use protocol::main;
public machine outcome(p: &mut [u64; 128]) -> u64 {
    p[80] = 0u64; p[81] = 0u64;
    transition p[2] == 0u64 { true -> accepted(p) _ -> refused(p) }
    state accepted(p: &mut [u64; 128]) -> u64 {
        transition p[1] == 0u64 { true -> launched(p) _ -> (1u64) }
    }
    state launched(p: &mut [u64; 128]) -> u64 { p[81] = p[3]; 1u64 }
    state refused(p: &mut [u64; 128]) -> u64 {
        transition p[1] {
            0u64 -> launch_error(p)
            2u64 -> unsaved(p)
            3u64 -> copy_error(p)
            _ -> retry(p)
        }
    }
    state launch_error(p: &mut [u64; 128]) -> u64 {
        transition p[2] { BUSY -> retry(p) NO_MEMORY -> capacity(p) _ -> unavailable(p) }
    }
    state copy_error(p: &mut [u64; 128]) -> u64 {
        transition p[2] { NO_MEMORY -> capacity(p) _ -> retry(p) }
    }
    state unavailable(p: &mut [u64; 128]) -> u64 { p[80] = 1u64; 1u64 }
    state retry(p: &mut [u64; 128]) -> u64 { p[80] = 2u64; 1u64 }
    state capacity(p: &mut [u64; 128]) -> u64 { p[80] = 3u64; 1u64 }
    state unsaved(p: &mut [u64; 128]) -> u64 { p[80] = 4u64; 1u64 }
}
public machine after_select(p: &mut [u64; 128]) -> u64 {
    p[80] = (p[1] == 0u64 && p[2] != 0u64) as u64;
    p[81] = (p[1] != 0u64) as u64 * 2u64; 1u64
}
public machine observation(p: &mut [u64; 128]) -> u64 {
    p[80] = (p[1] == 0u64 && p[2] == LAUNCH_RUNNING) as u64;
    p[81] = (p[1] == 0u64 && p[2] == LAUNCH_FAILED) as u64 * 5u64; 1u64
}
