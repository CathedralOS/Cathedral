module outcomes;

// Replies, not optimistic UI state, decide whether an operation was accepted.
use protocol::main;

public data Operation [copy] {
    case Launch;
    case Close;
    case Copy;
    case Retry;
}

public data Notice [copy] {
    case None;
    case Unavailable;
    case Retry;
    case Capacity;
    case Unsaved;
    case Stopped;
}

public data Outcome [copy] {
    notice: Notice;
    receipt: u64;
}

public data SelectionReply [copy] {
    close: bool;
    notice: Notice;
}

public data Observation [copy] {
    running: bool;
    notice: Notice;
}

public machine outcome(operation: Operation, status: u64, receipt: u64) -> Outcome {
    transition status == 0u64 {
        true -> accepted(operation, receipt)
        _ -> (Outcome { notice: refusal(operation, status), receipt: 0u64 })
    }
    machine accepted(operation: Operation, receipt: u64) -> Outcome {
        transition operation {
            Operation::Launch -> (Outcome { notice: Notice::None, receipt: receipt })
            _ -> (Outcome { notice: Notice::None, receipt: 0u64 })
        }
    }
}

machine refusal(operation: Operation, status: u64) -> Notice {
    transition operation {
        Operation::Launch -> launch_error(status)
        Operation::Close -> (Notice::Unsaved)
        Operation::Copy -> copy_error(status)
        _ -> (Notice::Retry)
    }
    machine launch_error(status: u64) -> Notice {
        transition status {
            BUSY -> (Notice::Retry)
            NO_MEMORY -> (Notice::Capacity)
            _ -> (Notice::Unavailable)
        }
    }
    machine copy_error(status: u64) -> Notice {
        transition status {
            NO_MEMORY -> (Notice::Capacity)
            _ -> (Notice::Retry)
        }
    }
}

public machine after_select(status: u64, close: bool) -> SelectionReply {
    transition status == 0u64 {
        true -> (SelectionReply { close: close, notice: Notice::None })
        _ -> (SelectionReply { close: false, notice: Notice::Retry })
    }
}

public machine observation(status: u64, state: u64) -> Observation {
    transition status == 0u64 {
        true -> observed(state)
        _ -> (Observation { running: false, notice: Notice::None })
    }
    machine observed(state: u64) -> Observation {
        transition state {
            LAUNCH_RUNNING -> (Observation { running: true, notice: Notice::None })
            LAUNCH_FAILED -> (Observation { running: false, notice: Notice::Stopped })
            _ -> (Observation { running: false, notice: Notice::None })
        }
    }
}
