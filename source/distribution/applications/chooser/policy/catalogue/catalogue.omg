module catalogue::catalogue;

public data Request {
    picker: bool;
    own: u64;
    template: u64;
    background: u64;
    count: u64;
    ids: [u64; 51];
}

public data Catalogue {
    count: u64;
    ids: [u64; 6];
}

// Metadata names roles; type selects executables. Stable local object IDs are
// supplied by the realm connection. Neither filenames nor ordinals grant access.
public machine catalogue(request: &Request, result: &mut Catalogue) -> bool {
    result.count = 0u64;
    transition request.count <= 51u64 {
        true -> hidden(request, result)
        _ -> (false)
    }
    machine hidden(request: &Request, result: &mut Catalogue) -> bool {
        transition request.picker {
            true -> template(request, result)
            _ -> find_own(request, result, 0u64)
        }
    }
    machine template(request: &Request, result: &mut Catalogue) -> bool {
        transition request.template != 0u64 {
            true -> start(request, result, request.template)
            _ -> (false)
        }
    }
    machine find_own(request: &Request, result: &mut Catalogue, i: u64) -> bool {
        transition i < request.count && i < 51u64 {
            true -> own(request, result, i)
            _ -> (false)
        }
    }
    machine own(request: &Request, result: &mut Catalogue, i: u64) -> bool requires i < 51u64 {
        transition request.ids[i] == request.own && request.own != 0u64 {
            true -> start(request, result, request.own)
            _ -> find_own(request, result, i + 1u64)
        }
    }
    machine start(request: &Request, result: &mut Catalogue, hidden: u64) -> bool {
        result.count = 1u64;
        result.ids[0] = hidden;
        transition {
            _ -> scan(request, result, hidden, 0u64, 1u64)
        }
    }
    machine scan(request: &Request, result: &mut Catalogue, hidden: u64, i: u64, count: u64) -> bool {
        transition i < request.count && i < 51u64 && count < 6u64 && (!request.picker || count < 4u64) {
            true -> candidate(request, result, hidden, i, count)
            _ -> (true)
        }
    }
    machine candidate(request: &Request, result: &mut Catalogue, hidden: u64, i: u64, count: u64) -> bool requires i < 51u64 {
        let id: u64 = request.ids[i];
        transition id != hidden && id != request.background {
            true -> add(request, result, hidden, i, count, id)
            _ -> scan(request, result, hidden, i + 1u64, count)
        }
    }
    machine add(request: &Request, result: &mut Catalogue, hidden: u64, i: u64, count: u64, id: u64) -> bool {
        transition count < 6u64 && i < 51u64 {
            true -> put(request, result, hidden, i, count, id)
            _ -> (false)
        }
    }
    machine put(request: &Request, result: &mut Catalogue, hidden: u64, i: u64, count: u64, id: u64) -> bool requires count < 6u64 && i < 51u64 {
        result.ids[count] = id;
        result.count = count + 1u64;
        transition {
            _ -> scan(request, result, hidden, i + 1u64, count + 1u64)
        }
    }
}
