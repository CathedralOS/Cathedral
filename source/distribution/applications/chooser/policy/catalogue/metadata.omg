module catalogue::metadata;

public data Classification {
    executable: bool;
    template: bool;
    background: bool;
    label: [u64; 13];
}

// Input bytes are widened into words at the native seam; output is a bounded
// display label. Metadata validation and attachment custody remain transport work.
public machine classify(metadata: &[u64; 64], result: &mut Classification) {
    let template: bool = metadata[0] == 84u64
        && metadata[1] == 101u64
        && metadata[2] == 109u64
        && metadata[3] == 112u64
        && metadata[4] == 108u64
        && metadata[5] == 97u64
        && metadata[6] == 116u64
        && metadata[7] == 101u64
        && metadata[8] == 0u64;
    let background: bool = metadata[0] == 66u64
        && metadata[1] == 97u64
        && metadata[2] == 99u64
        && metadata[3] == 107u64
        && metadata[4] == 103u64
        && metadata[5] == 114u64
        && metadata[6] == 111u64
        && metadata[7] == 117u64
        && metadata[8] == 110u64
        && metadata[9] == 100u64
        && metadata[10] == 0u64;
    let executable: bool = executable(metadata);
    result.executable = executable;
    result.template = template;
    result.background = background;
    transition {
        _ -> label(metadata, result, 0u64)
    }
    machine label(metadata: &[u64; 64], result: &mut Classification, i: u64) {
        transition i < 13u64 {
            true -> character(metadata, result, i)
            _ -> done()
        }
    }
    machine character(metadata: &[u64; 64], result: &mut Classification, i: u64) requires i < 13u64 {
        let byte: u64 = metadata[i];
        result.label[i] = upper(byte);
        transition {
            _ -> label(metadata, result, i + 1u64)
        }
    }
}
machine done() {
}

machine upper(byte: u64) -> u64 {
    transition byte >= 97u64 && byte <= 122u64 {
        true -> letter(byte)
        _ -> (byte)
    }
    machine letter(byte: u64) -> u64 requires byte >= 97u64 {
        byte - 32u64
    }
}
machine executable(metadata: &[u64; 64]) -> bool {
    // Exact "application/x-executable", including its terminator.
    let expected: [u64; 23] = [97u64,112u64,112u64,108u64,105u64,99u64,97u64,116u64,105u64,111u64,110u64,47u64,120u64,45u64,101u64,120u64,101u64,99u64,117u64,116u64,97u64,98u64,108u64];
    transition {
        _ -> scan(metadata, &expected, 0u64)
    }
    machine scan(metadata: &[u64; 64], expected: &[u64; 23], i: u64) -> bool {
        transition i < 23u64 {
            true -> compare(metadata, expected, i)
            _ -> (metadata[55] == 101u64
        && metadata[56] == 0u64)
        }
    }
    machine compare(metadata: &[u64; 64], expected: &[u64; 23], i: u64) -> bool requires i < 23u64 {
        transition metadata[32u64 + i] == expected[i] {
            true -> scan(metadata, expected, i + 1u64)
            _ -> (false)
        }
    }
}
