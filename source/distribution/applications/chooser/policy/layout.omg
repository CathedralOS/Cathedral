module layout;

public data Geometry [copy] {
    count: u64;
    width: u64;
    height: u64;
    x: u64;
    y: u64;
    tasks_left: u64;
    item: u64;
}

// One geometry model drives both published tiles and input hit testing.
public machine tile_count(count: u64, picker: bool) -> u64 {
    let bounded: u64 = limit(count);
    let visible: u64 = ((bounded as u64 in Saturating) - 1) as u64;
    transition picker && bounded < 4u64 {
        true -> (plus(visible, 1u64))
        _ -> (visible)
    }
}
public machine tile_id(count: u64, picker: bool, tile: u64) -> u64 {
    let next: u64 = ((tile as u64 in Saturating) + 1) as u64;
    transition picker && next >= count {
        true -> (6u64)
        _ -> (next)
    }
}
public machine tile_width(picker: bool) -> u64 {
    transition picker {
        true -> (128u64)
        _ -> (48u64)
    }
}
public machine tile_height(picker: bool) -> u64 {
    transition picker {
        true -> (96u64)
        _ -> (48u64)
    }
}
public machine tile_left(width: u64, n: u64, picker: bool, tile: u64) -> u64 {
    transition picker {
        true -> centered(width, n, tile)
        _ -> (plus(8u64, times(limit(tile), 56u64)))
    }
    state centered(width: u64, n: u64, tile: u64) -> u64 {
        let total: u64 = minus(times(limit(n), 152u64), 24u64);
        let left: u64 = minus(width, total) / 2u64;
        plus(left, times(limit(tile), 152u64))
    }
}
public machine tile_top(height: u64, picker: bool) -> u64 {
    let h: u64 = tile_height(picker);
    minus(height, h) / 2u64
}
public machine tasks_left(count: u64) -> u64 {
    let n: u64 = ((limit(count) as u64 in Saturating) - 1) as u64;
    plus(16u64, times(n, 56u64))
}
public machine inside(value: u64, start: u64, length: u64) -> bool {
    transition value >= start {
        true -> distance(value, start, length)
        _ -> (false)
    }
    state distance(value: u64, start: u64, length: u64) -> bool requires value >= start {
        value - start < length
    }
}
public machine geometry(picker: bool, count: u64, width: u64, height: u64, tile: u64) -> Geometry {
    Geometry {
        count: tile_count(count, picker),
        width: tile_width(picker),
        height: tile_height(picker),
        x: tile_left(width, tile_count(count, picker), picker, tile),
        y: tile_top(height, picker),
        tasks_left: tasks_left(count),
        item: tile_id(count, picker, tile)
    }
}

machine limit(n: u64) -> u64 {
    transition n < 6u64 {
        true -> (n)
        _ -> (6u64)
    }
}
machine plus(a: u64, b: u64) -> u64 {
    ((a as u64 in Saturating) + (b as u64 in Saturating)) as u64
}
machine minus(a: u64, b: u64) -> u64 {
    ((a as u64 in Saturating) - (b as u64 in Saturating)) as u64
}
machine times(a: u64, b: u64) -> u64 {
    ((a as u64 in Saturating) * (b as u64 in Saturating)) as u64
}
