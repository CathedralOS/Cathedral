module catalogue::catalogue;
use protocol::main;
use decisions::outcomes;
// Stream scoped entry pages, resolve presentation roles, then publish one model.
use operations::Command;
use operations::Exchange;
use decisions::catalogue::metadata;
use decisions::catalogue::catalogue;
use state::State;
use state::Phase;
use transport::storage;
use transport::failed;
use transport::byte;
use transport::subtract;
use transport::add;
use session::session::cycle;
public machine reload(s: &mut State, p: &mut Exchange) -> Command {
    s.phase = Phase::Bound; s.found = 0u64; s.template = 0u64; s.background = 0u64; s.after = 0u64; Command::BindStorage
}
public machine bound(s: &mut State, p: &mut Exchange) -> Command {
    transition failed(p) { true -> unavailable(s, p) _ -> ready(s, p) }
    machine ready(s: &mut State, p: &mut Exchange) -> Command { s.realm = p.frame[1]; page(s, p) }
}
machine page(s: &mut State, p: &mut Exchange) -> Command {
    let realm: u64 = s.realm; let after: u64 = s.after;
    let op: Command = storage(s, p, Phase::Listed, 19u64, realm, 0u64, after, 0u64); p.receive_limit = 4080u64; op
}
public machine listed(s: &mut State, p: &mut Exchange) -> Command {
    transition failed(p) || p.frame[1] > 51u64 || p.payload_bytes != p.frame[1] * 80u64 { true -> unavailable(s, p) _ -> scan(s, p, 0u64) }
    machine scan(s: &mut State, p: &mut Exchange, i: u64) -> Command {
        transition i < p.frame[1] && i < 51u64 { true -> row(s, p, i) _ -> complete(s, p) }
    }
    machine row(s: &mut State, p: &mut Exchange, i: u64) -> Command requires i < 51u64 {
        transition { _ -> metadata(s, p, i, 0u64) }
    }
    machine metadata(s: &mut State, p: &mut Exchange, i: u64, j: u64) -> Command {
        transition i < 51u64 && j < 64u64 { true -> field(s, p, i, j) _ -> classify_row(s, p, i) }
    }
    machine field(s: &mut State, p: &mut Exchange, i: u64, j: u64) -> Command requires i < 51u64 && j < 64u64 {
        s.metadata[j] = byte(p, i * 80u64 + 16u64 + j) as u64;
        transition { _ -> metadata(s, p, i, j + 1u64) }
    }
    machine classify_row(s: &mut State, p: &mut Exchange, i: u64) -> Command {
        decisions::catalogue::metadata::classify(&s.metadata, &mut s.classification);
        transition i < 51u64 { true -> roles(s, p, i) _ -> unavailable(s, p) }
    }
    machine roles(s: &mut State, p: &mut Exchange, i: u64) -> Command requires i < 51u64 {
        let id: u64 = p.payload[i * 10u64];
        transition s.classification.template { true -> template(s, p, i, id) _ -> background(s, p, i, id) }
    }
    machine template(s: &mut State, p: &mut Exchange, i: u64, id: u64) -> Command { s.template = id; transition { _ -> background(s, p, i, id) } }
    machine background(s: &mut State, p: &mut Exchange, i: u64, id: u64) -> Command {
        transition s.classification.background { true -> mark_background(s, p, i, id) _ -> executable(s, p, i, id) }
    }
    machine mark_background(s: &mut State, p: &mut Exchange, i: u64, id: u64) -> Command { s.background = id; transition { _ -> executable(s, p, i, id) } }
    machine executable(s: &mut State, p: &mut Exchange, i: u64, id: u64) -> Command {
        transition s.classification.executable && s.found < 51u64 { true -> append(s, p, i, id) _ -> next(s, p, i) }
    }
    machine append(s: &mut State, p: &mut Exchange, i: u64, id: u64) -> Command requires s.found < 51u64 {
        s.catalogue_request.ids[s.found] = id; transition { _ -> label(s, p, i, 0u64) }
    }
    machine label(s: &mut State, p: &mut Exchange, i: u64, j: u64) -> Command {
        transition j < 13u64 && s.found < 51u64 { true -> letter(s, p, i, j) _ -> appended(s, p, i) }
    }
    machine letter(s: &mut State, p: &mut Exchange, i: u64, j: u64) -> Command requires j < 13u64 && s.found < 51u64 {
        s.candidate_names[s.found][j] = (s.classification.label[j] & 255u64) as u8; transition { _ -> label(s, p, i, j + 1u64) }
    }
    machine appended(s: &mut State, p: &mut Exchange, i: u64) -> Command { s.found = add(s.found, 1u64); transition { _ -> next(s, p, i) } }
    machine next(s: &mut State, p: &mut Exchange, i: u64) -> Command { let following: u64 = add(i, 1u64); transition { _ -> scan(s, p, following) } }
    machine complete(s: &mut State, p: &mut Exchange) -> Command {
        s.after = p.frame[2]; transition p.frame[1] == 51u64 { true -> page(s, p) _ -> resolve(s, p) }
    }
}
machine resolve(s: &mut State, p: &mut Exchange) -> Command {
    s.catalogue_request.picker = s.picker;
    s.catalogue_request.own = s.own;
    s.catalogue_request.template = s.template;
    s.catalogue_request.background = s.background;
    s.catalogue_request.count = s.found;
    let accepted: bool = decisions::catalogue::catalogue::catalogue(&s.catalogue_request, &mut s.entries);
    transition accepted {
        true -> names(s, p, 0u64)
        _ -> unavailable(s, p)
    }
    machine names(s: &mut State, p: &mut Exchange, i: u64) -> Command {
        transition i < 6u64 {
            true -> name(s, p, i, 0u64)
            _ -> finished(s, p)
        }
    }
    machine name(s: &mut State, p: &mut Exchange, i: u64, j: u64) -> Command {
        transition i < 6u64 && j < s.found && j < 51u64 { true -> match_name(s, p, i, j) _ -> advance(s, p, i) }
    }
    machine match_name(s: &mut State, p: &mut Exchange, i: u64, j: u64) -> Command requires i < 6u64 && j < 51u64 {
        transition s.entries.ids[i] == s.catalogue_request.ids[j] { true -> copy_name(s, p, i, j, 0u64) _ -> name(s, p, i, j + 1u64) }
    }
    machine copy_name(s: &mut State, p: &mut Exchange, i: u64, j: u64, k: u64) -> Command {
        transition i < 6u64 && j < 51u64 && k < 13u64 { true -> copy_letter(s, p, i, j, k) _ -> advance(s, p, i) }
    }
    machine copy_letter(s: &mut State, p: &mut Exchange, i: u64, j: u64, k: u64) -> Command requires i < 6u64 && j < 51u64 && k < 13u64 {
        s.names[i][k] = s.candidate_names[j][k]; transition { _ -> copy_name(s, p, i, j, k + 1u64) }
    }
    machine advance(s: &mut State, p: &mut Exchange, i: u64) -> Command { let following: u64 = add(i, 1u64); transition { _ -> names(s, p, following) } }
    machine finished(s: &mut State, p: &mut Exchange) -> Command { s.dirty = true; transition s.selected == 6u64 { true -> choose_new(s, p) _ -> cycle(s, p) } }
    machine choose_new(s: &mut State, p: &mut Exchange) -> Command { s.selected = subtract(s.entries.count, 1u64); cycle(s, p) }
}
public machine unavailable(s: &mut State, p: &mut Exchange) -> Command { s.notice = decisions::outcomes::Notice::Unavailable; s.dirty = true; cycle(s, p) }
