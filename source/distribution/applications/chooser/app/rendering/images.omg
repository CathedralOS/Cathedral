module rendering::images;
use protocol::main;
// Each image is staged in bounded chunks before a single presentation request.
use operations::Command;
use operations::Exchange;
use state::State;
use state::Phase;
use transport::interaction;
use transport::subtract;
use transport::add;
use rendering::rendering::geometry;
use rendering::rendering::footer_managed;
use rendering::pixels::pixels;
public machine tile_image(s: &mut State, p: &mut Exchange) -> Command {
    transition s.rank < 6u64 { true -> tile(s, p) _ -> (Command::Exit) }
    machine tile(s: &mut State, p: &mut Exchange) -> Command requires s.rank < 6u64 {
        s.image_kind = 2u64 - (s.picker as u64); s.image_index = s.geometry.item;
        s.image_surface = s.surfaces[s.rank + 1u64]; s.rank = add(s.rank, 1u64);
        s.image_x = s.geometry.x; s.image_y = s.geometry.y; s.image_width = s.geometry.width; s.image_height = s.geometry.height; begin_image(s, p)
    }
}
public machine settings_image(s: &mut State, p: &mut Exchange) -> Command {
    transition s.rank < 3u64 { true -> panel(s, p) _ -> (Command::Exit) }
    machine panel(s: &mut State, p: &mut Exchange) -> Command requires s.rank < 3u64 {
        let row: u64 = s.rank; s.image_kind = 3u64; s.image_index = row; s.image_surface = s.surfaces[row + 1u64];
        s.image_x = add(subtract(s.width, 512u64) / 2u64, row * 176u64); s.image_y = 8u64;
        s.image_width = 160u64; s.image_height = 64u64; s.rank = row + 1u64; begin_image(s, p)
    }
}
public machine management_image(s: &mut State, p: &mut Exchange) -> Command {
    transition s.rank < 3u64 { true -> panel(s, p) _ -> (Command::Exit) }
    machine panel(s: &mut State, p: &mut Exchange) -> Command requires s.rank < 3u64 {
        let row: u64 = s.rank; s.image_kind = 4u64; s.image_index = row; s.image_surface = s.surfaces[row + 1u64];
        s.image_x = add(subtract(s.width, 572u64) / 2u64, row * 196u64); s.image_y = 16u64;
        s.image_width = 180u64; s.image_height = management_height(row); s.rank = row + 1u64; begin_image(s, p)
    }
}
machine management_height(row: u64) -> u64 { transition row == 0u64 { true -> (48u64) _ -> (32u64) } }
public machine footer_image(s: &mut State, p: &mut Exchange) -> Command {
    let offset: u64 = (footer_managed(s) as u64) * 24u64;
    s.image_kind = 5u64; s.image_index = 0u64; s.image_width = 180u64; s.image_height = 40u64 + offset;
    transition s.picker { true -> picker(s, p) _ -> chrome(s, p, offset) }
    machine picker(s: &mut State, p: &mut Exchange) -> Command {
        s.image_surface = s.surfaces[5]; s.image_x = subtract(s.width, 180u64) / 2u64; s.image_y = add(s.height / 2u64, 88u64); begin_image(s, p)
    }
    machine chrome(s: &mut State, p: &mut Exchange, offset: u64) -> Command {
        s.image_surface = s.surfaces[6]; s.image_x = subtract(s.width, 184u64); s.image_y = subtract(s.height, add(48u64, offset)); begin_image(s, p)
    }
}
public machine tasks_image(s: &mut State, p: &mut Exchange) -> Command {
    geometry(s); s.image_kind = 6u64; s.image_index = 0u64; s.image_surface = s.surfaces[7];
    s.image_x = s.geometry.tasks_left; s.image_y = subtract(s.height, 32u64) / 2u64; s.image_width = 432u64; s.image_height = 32u64; begin_image(s, p)
}
machine begin_image(s: &mut State, p: &mut Exchange) -> Command { s.image_offset = 0u64; stage(s, p) }
machine stage(s: &mut State, p: &mut Exchange) -> Command {
    transition s.image_width > 0u64 && s.image_width <= 432u64 && s.image_height <= 96u64 { true -> bounded(s, p) _ -> (Command::Exit) }
    machine bounded(s: &mut State, p: &mut Exchange) -> Command requires s.image_width <= 432u64 && s.image_height <= 96u64 {
        let total: u64 = s.image_width * s.image_height * 4u64;
        transition total <= 65536u64 && s.image_offset < total { true -> chunk(s, p, total) _ -> (Command::Exit) }
    }
    machine chunk(s: &mut State, p: &mut Exchange, total: u64) -> Command requires s.image_offset < total {
        let count: u64 = chunk_size(total - s.image_offset);
        pixels(s, p, count / 8u64); p.frame[0] = total; p.frame[1] = s.image_offset; p.payload_bytes = count;
        s.image_offset = add(s.image_offset, count); s.phase = Phase::Staged; Command::StageImage
    }
}
machine chunk_size(remaining: u64) -> u64 { transition remaining > 4080u64 { true -> (4080u64) _ -> (remaining) } }
public machine staged(s: &mut State, p: &mut Exchange) -> Command {
    transition p.transport_status != 0u64 { true -> (Command::Exit) _ -> progress(s, p) }
    machine progress(s: &mut State, p: &mut Exchange) -> Command {
        transition s.image_width <= 432u64 && s.image_height <= 96u64 { true -> extent(s, p) _ -> (Command::Exit) }
    }
    machine extent(s: &mut State, p: &mut Exchange) -> Command requires s.image_width <= 432u64 && s.image_height <= 96u64 {
        transition s.image_offset < s.image_width * s.image_height * 4u64 { true -> stage(s, p) _ -> submit(s, p) }
    }
    machine submit(s: &mut State, p: &mut Exchange) -> Command {
        let epoch: u64 = s.epoch; let surface: u64 = s.image_surface; let x: u64 = s.image_x; let y: u64 = s.image_y;
        let w: u64 = s.image_width; let h: u64 = s.image_height; interaction(s, p, Phase::Image, SURFACE_IMAGE, epoch, surface, x, y, w, h, w)
    }
}
