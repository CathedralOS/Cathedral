use operations.omg;
// Distribution-owned rasterization. The host sees only bounded image bytes.
use state.omg as local_state;
use rendering/tiles.omg;
use rendering/panels.omg;
public machine pixels(s: &|local_state|::State, p: &mut |operations|::Exchange, words: u64) {
    transition { _ -> fill(s, p, words, 0u64) }
    machine fill(s: &|local_state|::State, p: &mut |operations|::Exchange, words: u64, i: u64) {
        transition i < words && i < 510u64 && s.image_offset < 65536u64 { true -> pair(s, p, words, i) _ -> done() }
    }
    machine pair(s: &|local_state|::State, p: &mut |operations|::Exchange, words: u64, i: u64) requires i < 510u64 && s.image_offset < 65536u64 {
        let at: u64 = s.image_offset / 4u64 + i * 2u64;
        let lo: u64 = pixel(s, at); let hi: u64 = pixel(s, at + 1u64);
        p.payload[i] = lo | ((hi & 4294967295u64) << 32u64);
        transition { _ -> fill(s, p, words, i + 1u64) }
    }
    machine done() {}
}
machine pixel(s: &|local_state|::State, at: u64) -> u64 {
    transition s.image_width > 0u64 { true -> coordinate(s, at) _ -> (0u64) }
    machine coordinate(s: &|local_state|::State, at: u64) -> u64 requires s.image_width > 0u64 {
        let x: u64 = at % s.image_width; let y: u64 = at / s.image_width;
        transition s.image_kind { 1u64 -> |tiles|::avatar(s, x, y) 2u64 -> |tiles|::icon(s, x, y) 3u64 -> |panels|::settings_pixel(s, x, y) 4u64 -> |panels|::management_pixel(s, x, y) 5u64 -> |panels|::footer_pixel(s, x, y) _ -> |panels|::task_pixel(s, x, y) }
    }
}
