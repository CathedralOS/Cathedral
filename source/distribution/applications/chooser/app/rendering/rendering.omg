use {protocol}/main.omg;
// Retain surfaces; publish complete bounded images. Re-poll after an epoch race.
use operations.omg;
use {decisions}/layout.omg;
use {decisions}/outcomes.omg;
use state.omg as local_state;
use transport.omg;
use session/session.omg;
use rendering/images.omg;
public machine render(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition !s.scene { true -> create(s, p) _ -> repaint(s, p) }
    machine create(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.rank = 0u64; create_surface(s, p) }
}
machine create_surface(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    let epoch: u64 = s.epoch; let rank: u64 = s.rank; |transport|::interaction(s, p, |local_state|::Phase::Surface, |main|::SURFACE_CREATE, epoch, rank, 0u64, 0u64, 0u64, 0u64, 0u64)
}
public machine surface_reply(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition |transport|::failed(p) || s.rank >= 8u64 { true -> recheck(s, p) _ -> created(s, p) }
    machine created(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command requires s.rank < 8u64 {
        s.surfaces[s.rank] = p.frame[1]; s.rank = |transport|::add(s.rank, 1u64);
        transition s.rank < surface_count(s) { true -> create_surface(s, p) _ -> ready(s, p) }
    }
    machine ready(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.scene = true; s.dirty = true; repaint(s, p) }
}
machine surface_count(s: &|local_state|::State) -> u64 { transition s.picker { true -> (6u64) _ -> (8u64) } }
machine repaint(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition s.dirty { true -> begin(s, p) _ -> |session|::finish(s, p) }
    machine begin(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.paint_step = 0u64; s.rank = 0u64; paint_next(s, p) }
}
public machine paint_next(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition s.paint_step {
        0u64 -> background(s, p)
        1u64 -> release_footer(s, p)
        2u64 -> clear_panels(s, p)
        3u64 -> primary(s, p)
        4u64 -> clear_unused(s, p)
        5u64 -> footer(s, p)
        6u64 -> tasks(s, p)
        _ -> done(s, p)
    }
    machine background(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.paint_step = 1u64; let epoch: u64 = s.epoch; let surface: u64 = s.surfaces[0]; let w: u64 = s.width; let h: u64 = s.height;
        |transport|::interaction(s, p, |local_state|::Phase::Painted, |main|::MATRIX_PAINT, epoch, surface, 0u64, 0u64, w, h, 1054759u64)
    }
    machine release_footer(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.paint_step = 2u64; s.rank = 4u64; let slot: u64 = footer_slot(s); clear_surface(s, p, slot)
    }
    machine clear_panels(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition (s.editing || s.confirming != 0u64) && s.rank < 8u64 { true -> clear_panel(s, p) _ -> primary_start(s, p) }
    }
    machine clear_panel(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { let slot: u64 = s.rank; s.rank = |transport|::add(s.rank, 1u64); clear_surface(s, p, slot) }
    machine primary_start(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.rank = 0u64; s.paint_step = 3u64; transition { _ -> primary(s, p) } }
    machine primary(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition s.confirming != 0u64 { true -> management(s, p) _ -> editor(s, p) }
    }
    machine management(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition s.rank < 3u64 { true -> |images|::management_image(s, p) _ -> footer_start(s, p) } }
    machine editor(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition s.editing { true -> settings(s, p) _ -> tiles(s, p) } }
    machine settings(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition s.rank < 3u64 { true -> |images|::settings_image(s, p) _ -> footer_start(s, p) } }
    machine tiles(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        geometry(s); transition s.rank < s.geometry.count && s.rank < 6u64 { true -> |images|::tile_image(s, p) _ -> clear_start(s, p) }
    }
    machine clear_start(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.paint_step = 4u64; transition { _ -> clear_unused(s, p) } }
    machine clear_unused(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition s.rank < |transport|::subtract(footer_slot(s), 1u64) { true -> clear_tile(s, p) _ -> footer_start(s, p) }
    }
    machine clear_tile(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { let slot: u64 = |transport|::add(s.rank, 1u64); s.rank = slot; clear_surface(s, p, slot) }
    machine footer_start(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.paint_step = 5u64; transition { _ -> footer(s, p) } }
    machine footer(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.paint_step = 6u64;
        transition footer_status(s) != 0u64 || normal_chrome(s) { true -> |images|::footer_image(s, p) _ -> tasks(s, p) }
    }
    machine tasks(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.paint_step = 7u64; transition normal_chrome(s) { true -> |images|::tasks_image(s, p) _ -> done(s, p) }
    }
    machine done(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.dirty = false; |session|::finish(s, p) }
}
public machine painted(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition |transport|::failed(p) { true -> recheck(s, p) _ -> paint_next(s, p) } }
public machine image_reply(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition |transport|::failed(p) { true -> recheck(s, p) _ -> paint_next(s, p) } }
machine clear_surface(s: &mut |local_state|::State, p: &mut |operations|::Exchange, slot: u64) -> |operations|::Command {
    transition slot < 8u64 { true -> clear(s, p, slot) _ -> (|operations|::Command::Exit) }
    machine clear(s: &mut |local_state|::State, p: &mut |operations|::Exchange, slot: u64) -> |operations|::Command requires slot < 8u64 {
        let epoch: u64 = s.epoch; let surface: u64 = s.surfaces[slot]; |transport|::interaction(s, p, |local_state|::Phase::Painted, |main|::MATRIX_PAINT, epoch, surface, 0u64, 0u64, 0u64, 0u64, 0u64)
    }
}
public machine recheck(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { |transport|::interaction(s, p, |local_state|::Phase::Recheck, |main|::MATRIX_VIEW, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64) }
public machine rechecked(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 || (p.frame[0] == 0u64 && p.frame[1] == s.epoch) { true -> (|operations|::Command::Exit) _ -> retry(s, p) }
    machine retry(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.scene = false; s.dirty = true; s.channels[0] = 0u64; s.channels[1] = 0u64; s.channels[2] = 0u64; s.channels[3] = 0u64; s.buttons[0] = 0u64; s.buttons[1] = 0u64; s.buttons[2] = 0u64; s.buttons[3] = 0u64; |session|::cycle(s, p) }
}
public machine geometry(s: &mut |local_state|::State) {
    s.geometry = |layout|::geometry(s.picker, s.entries.count, s.width, s.height, s.rank);
}
public machine footer_slot(s: &|local_state|::State) -> u64 { transition s.picker { true -> (5u64) _ -> (6u64) } }
public machine normal_chrome(s: &|local_state|::State) -> bool { !s.picker && !s.editing && s.confirming == 0u64 }
public machine footer_managed(s: &|local_state|::State) -> bool { normal_chrome(s) && s.managed != 0u64 }
public machine footer_status(s: &|local_state|::State) -> u64 {
    transition s.confirming != 0u64 { true -> (s.management_status) _ -> editor(s) }
    machine editor(s: &|local_state|::State) -> u64 { transition s.editing { true -> (s.setting_status) _ -> availability(s) } }
    machine availability(s: &|local_state|::State) -> u64 { transition s.saves { 1u64 -> (6u64) 2u64 -> (7u64) _ -> (notice_code(s.notice)) } }
}

// The existing footer painter shares numeric presentation tags with its panels.
// Convert named operation notices only at that presentation boundary.
machine notice_code(notice: |outcomes|::Notice) -> u64 {
    transition notice {
        |outcomes|::Notice::None -> (0u64)
        |outcomes|::Notice::Unavailable -> (1u64)
        |outcomes|::Notice::Retry -> (2u64)
        |outcomes|::Notice::Capacity -> (3u64)
        |outcomes|::Notice::Unsaved -> (4u64)
        |outcomes|::Notice::Stopped -> (5u64)
    }
}
