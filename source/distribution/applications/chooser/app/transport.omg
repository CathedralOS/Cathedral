// Continuation-bearing requests; every service is supplied by this matrix.
use host::main;
use state;
public machine interaction(s: &mut State, p: &mut [u64; 4096], next: u64, op: u64, a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64) -> u64 {
    s.phase = next; message(p, op, a, b, c, d, e, f, g); EXCHANGE
}
public machine storage(s: &mut State, p: &mut [u64; 4096], next: u64, op: u64, object: u64, revision: u64, argument: u64, length: u64) -> u64 {
    s.phase = next; message(p, op, object, revision, argument, length, 0u64, 0u64, 0u64); STORE
}
public machine failed(p: &[u64; 4096]) -> bool { p[9] != 0u64 || p[0] != 0u64 }
public machine status(p: &[u64; 4096]) -> u64 { transition p[9] != 0u64 { true -> (p[9]) _ -> (p[0]) } }
public machine byte(p: &[u64; 4096], offset: u64) -> u8 {
    transition offset < 32640u64 { true -> read(p, offset) _ -> (0u8) }
    state read(p: &[u64; 4096], offset: u64) -> u8 requires offset < 32640u64 { ((p[16u64 + offset / 8u64] >> ((offset % 8u64) * 8u64)) & 255u64) as u8 }
}
public machine put(p: &mut [u64; 4096], offset: u64, value: u64) {
    transition offset < 32640u64 { true -> write(p, offset, value) _ -> done() }
    state write(p: &mut [u64; 4096], offset: u64, value: u64) requires offset < 32640u64 {
        let at: u64 = 16u64 + offset / 8u64; let shift: u64 = (offset % 8u64) * 8u64;
        p[at] = (p[at] & ~(255u64 << shift)) | ((value & 255u64) << shift);
    }
    state done() {}
}
public machine subtract(a: u64, b: u64) -> u64 { ((a as u64 in Saturating) - (b as u64 in Saturating)) as u64 }
public machine add(a: u64, b: u64) -> u64 { ((a as u64 in Saturating) + (b as u64 in Saturating)) as u64 }
