use {protocol}/main.omg;
use rendering/images.omg;
// Startup -> refresh scoped observations -> poll -> dispatch -> present -> wait.
use operations.omg;
use {decisions}/outcomes.omg;
use state.omg as local_state;
use transport.omg;
use catalogue/catalogue.omg;
use session/input.omg;
use session/actions.omg;
use settings/settings.omg;
use settings/persistence.omg;
use management.omg;
use rendering/rendering.omg;

public machine session(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition s.phase {
        |local_state|::Phase::Start -> start(s, p)
        |local_state|::Phase::InteractionReady -> acquire_storage(s, p)
        |local_state|::Phase::StorageReady -> storage_ready(s, p)
        |local_state|::Phase::Bound -> |catalogue|::bound(s, p)
        |local_state|::Phase::Listed -> |catalogue|::listed(s, p)
        |local_state|::Phase::CopyHead -> |actions|::copy_head(s, p)
        |local_state|::Phase::Copied -> |actions|::copied(s, p)
        |local_state|::Phase::Clocked -> clocked(s, p)
        |local_state|::Phase::Tasked -> tasked(s, p)
        |local_state|::Phase::Managed -> managed(s, p)
        |local_state|::Phase::Avail -> availability(s, p)
        |local_state|::Phase::Observed -> observed(s, p)
        |local_state|::Phase::Polled -> polled(s, p)
        |local_state|::Phase::Selected -> |actions|::selected_reply(s, p)
        |local_state|::Phase::Closed -> |actions|::closed(s, p)
        |local_state|::Phase::Launched -> |actions|::launched(s, p)
        |local_state|::Phase::Retried -> |actions|::retried(s, p)
        |local_state|::Phase::Waited -> awakened(s, p)
        |local_state|::Phase::Controlled -> cycle(s, p)
        |local_state|::Phase::SettingBound -> |persistence|::setting_bound(s, p)
        |local_state|::Phase::Looked -> |persistence|::looked(s, p)
        |local_state|::Phase::Head -> |persistence|::head(s, p)
        |local_state|::Phase::Read -> |persistence|::read_reply(s, p)
        |local_state|::Phase::Saved -> |persistence|::saved_reply(s, p)
        |local_state|::Phase::Applied -> |persistence|::applied(s, p)
        |local_state|::Phase::Terminated -> |management|::terminated(s, p)
        |local_state|::Phase::Surface -> |rendering|::surface_reply(s, p)
        |local_state|::Phase::Painted -> |rendering|::painted(s, p)
        |local_state|::Phase::Staged -> |images|::staged(s, p)
        |local_state|::Phase::Image -> |rendering|::image_reply(s, p)
        |local_state|::Phase::Recheck -> |rendering|::rechecked(s, p)
        _ -> (|operations|::Command::Exit)
    }
}
machine start(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    let role: u64 = p.argument & 255u64;
    s.picker = role == 1u64 || role == 2u64; s.own = p.argument >> 8u64;
    s.notice = initial_notice(role); s.selected = 1u64; s.dirty = true; s.force_refresh = true;
    s.phase = |local_state|::Phase::InteractionReady; p.frame[0] = 1u64; p.frame[1] = 1u64; |operations|::Command::AcquireInteraction
}
machine acquire_storage(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 { true -> (|operations|::Command::Exit) _ -> request(s, p) }
    machine request(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.phase = |local_state|::Phase::StorageReady; p.frame[0] = 1u64; p.frame[1] = 1u64; |operations|::Command::AcquireStorage }
}
machine storage_ready(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition p.transport_status != 0u64 { true -> (|operations|::Command::Exit) _ -> |catalogue|::reload(s, p) } }
public machine cycle(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.phase = |local_state|::Phase::Clocked; |operations|::Command::Clock }
machine clocked(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 { true -> (|operations|::Command::Exit) _ -> route(s, p) }
    machine route(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition s.picker { true -> observe(s, p) _ -> refresh(s, p) }
    }
    machine refresh(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition s.force_refresh || p.frame[0] >= s.next_refresh { true -> tasks(s, p) _ -> management(s, p) }
    }
    machine tasks(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.force_refresh = false; s.next_refresh = |transport|::add(p.frame[0], 10u64); s.task_index = 0u64;
        |transport|::interaction(s, p, |local_state|::Phase::Tasked, 23u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64)
    }
}
machine tasked(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 || s.task_index >= 3u64 { true -> (|operations|::Command::Exit) _ -> compare(s, p, 0u64) }
    machine compare(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command {
        transition i < 8u64 && s.task_index < 3u64 { true -> word(s, p, i) _ -> next(s, p) }
    }
    machine word(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command requires i < 8u64 && s.task_index < 3u64 {
        s.dirty = s.dirty || s.tasks[s.task_index][i] != p.frame[i]; s.tasks[s.task_index][i] = p.frame[i];
        transition { _ -> compare(s, p, i + 1u64) }
    }
    machine next(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.task_index = |transport|::add(s.task_index, 1u64);
        transition s.task_index < 3u64 { true -> request(s, p) _ -> management(s, p) }
    }
    machine request(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { let i: u64 = s.task_index; |transport|::interaction(s, p, |local_state|::Phase::Tasked, 23u64, i, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64) }
}
machine management(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { |transport|::interaction(s, p, |local_state|::Phase::Managed, 18u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64) }
machine managed(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 { true -> (|operations|::Command::Exit) _ -> result(s, p) }
    machine result(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        let current: u64 = ticket(p);
        transition current != s.managed { true -> changed(s, p, current) _ -> saves(s, p) }
    }
    machine changed(s: &mut |local_state|::State, p: &mut |operations|::Exchange, current: u64) -> |operations|::Command { s.managed = current; s.confirming = 0u64; s.dirty = true; transition { _ -> saves(s, p) } }
    machine saves(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { |transport|::interaction(s, p, |local_state|::Phase::Avail, 21u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64) }
}
machine ticket(p: &|operations|::Exchange) -> u64 { transition p.frame[0] == 0u64 { true -> (p.frame[1]) _ -> (0u64) } }
machine availability(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 { true -> (|operations|::Command::Exit) _ -> result(s, p) }
    machine result(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { let next: u64 = ticket(p); s.dirty = s.dirty || s.saves != next; s.saves = next; observe(s, p) }
}
machine observe(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition s.launched != 0u64 { true -> request(s, p) _ -> poll(s, p) }
    machine request(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { let receipt: u64 = s.launched; |transport|::interaction(s, p, |local_state|::Phase::Observed, 17u64, receipt, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64) }
}
machine observed(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    let result: |outcomes|::Observation = |outcomes|::observation(|transport|::status(p), p.frame[1]);
    transition result.running {
        true -> poll(s, p)
        _ -> stopped(s, p, result.notice)
    }
    machine stopped(s: &mut |local_state|::State, p: &mut |operations|::Exchange, notice: |outcomes|::Notice) -> |operations|::Command {
        s.launched = 0u64;
        s.notice = notice;
        s.dirty = true;
        poll(s, p)
    }
}

machine initial_notice(role: u64) -> |outcomes|::Notice {
    transition role == 2u64 {
        true -> (|outcomes|::Notice::Unavailable)
        _ -> (|outcomes|::Notice::None)
    }
}

public machine poll(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { |transport|::interaction(s, p, |local_state|::Phase::Polled, |main|::MATRIX_POLL, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64) }
machine polled(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 { true -> (|operations|::Command::Exit) _ -> view(s, p) }
    machine view(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.more = p.frame[5] & |main|::MORE != 0u64;
        transition p.frame[0] == 0u64 { true -> geometry(s, p) _ -> hidden(s, p) }
    }
    machine hidden(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.scene = false; finish(s, p) }
    machine geometry(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition s.epoch != p.frame[1] { true -> changed(s, p) _ -> snapshot(s, p, 0u64) }
    }
    machine changed(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.epoch = p.frame[1]; s.width = p.frame[2]; s.height = p.frame[3]; s.scene = false; s.dirty = true; transition { _ -> snapshot(s, p, 0u64) } }
    machine snapshot(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command { transition i < 8u64 { true -> word(s, p, i) _ -> |input|::input(s, p) } }
    machine word(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command requires i < 8u64 { s.snapshot[i] = p.frame[i]; transition { _ -> snapshot(s, p, i + 1u64) } }
}
public machine after_input(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { |rendering|::render(s, p) }
public machine finish(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition s.more { true -> cycle(s, p) _ -> wait(s, p) }
    // Task collection can finish after its last surface notification. Refresh
    // observations even when there is no further input or presentation wake.
    machine wait(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.phase = |local_state|::Phase::Waited; p.refresh_ticks = 100u64; |operations|::Command::Wait }
}
machine awakened(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition p.transport_status != 0u64 { true -> (|operations|::Command::Exit) _ -> delivered(s, p) }
    machine delivered(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition p.owner_request { true -> control(s, p) _ -> cycle(s, p) }
    }
    machine control(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        transition p.frame[0] { 105u64 -> reply(s, p, 0u64, 0u64) |main|::LOSS -> loss(s, p) _ -> reply(s, p, |main|::DENIED, 0u64) }
    }
    machine loss(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { let dirty: bool = s.editing && |settings|::settings_dirty(s); transition { _ -> reply(s, p, 0u64, dirty as u64) } }
    machine reply(s: &mut |local_state|::State, p: &mut |operations|::Exchange, code: u64, dirty: u64) -> |operations|::Command { s.phase = |local_state|::Phase::Controlled; |operations|::message(p, code, dirty, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64); |operations|::Command::Control }
}
