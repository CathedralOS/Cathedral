// Opaque app state. The host knows only its size/alignment, never its fields.
public data State {
    phase: u64; picker: bool; own: u64; realm: u64; status: u64;
    q: [u64; 128]; candidates: [u64; 51]; candidate_names: [[u8; 13]; 51];
    found: u64; template: u64; background: u64; after: u64;
    ids: [u64; 6]; names: [[u8; 13]; 6]; count: u64; selected: u64;
    epoch: u64; width: u64; height: u64; snapshot: [u64; 8];
    channels: [u64; 4]; buttons: [u64; 4]; clicked: bool; more: bool;
    tasks: [[u64; 8]; 3]; task_index: u64; next_refresh: u64; force_refresh: bool;
    managed: u64; confirming: u64; cancel: bool; management_status: u64;
    saves: u64; launched: u64; close_selected: bool;
    editing: bool; uncertain: bool; setting_selected: u64; setting_status: u64;
    config_object: u64; config_revision: u64; reading_object: u64; reading_revision: u64;
    saved: [u8; 104]; draft: [u8; 104]; reading: [u8; 104]; read_at: u64; reconciling: bool;
    dirty: bool; scene: bool; surfaces: [u64; 8]; rank: u64; paint_step: u64;
    image_kind: u64; image_index: u64; image_surface: u64; image_x: u64; image_y: u64;
    image_width: u64; image_height: u64; image_offset: u64;
}
public const START: u64 = 0u64;
public const INTERACTION_READY: u64 = 1u64;
public const STORAGE_READY: u64 = 2u64;
public const BOUND: u64 = 3u64;
public const LISTED: u64 = 4u64;
public const COPY_HEAD: u64 = 5u64;
public const COPIED: u64 = 6u64;
public const CLOCKED: u64 = 7u64;
public const TASKED: u64 = 8u64;
public const MANAGED: u64 = 9u64;
public const AVAIL: u64 = 10u64;
public const OBSERVED: u64 = 11u64;
public const POLLED: u64 = 12u64;
public const SELECTED: u64 = 13u64;
public const CLOSED: u64 = 14u64;
public const LAUNCHED: u64 = 15u64;
public const RETRIED: u64 = 16u64;
public const WAITED: u64 = 17u64;
public const CONTROLLED: u64 = 18u64;
public const SETTING_BOUND: u64 = 19u64;
public const LOOKED: u64 = 20u64;
public const HEAD: u64 = 21u64;
public const READ: u64 = 22u64;
public const SAVED: u64 = 23u64;
public const APPLIED: u64 = 24u64;
public const TERMINATED: u64 = 25u64;
public const SURFACE: u64 = 26u64;
public const PAINTED: u64 = 27u64;
public const STAGED: u64 = 28u64;
public const IMAGE: u64 = 29u64;
public const RECHECK: u64 = 30u64;
