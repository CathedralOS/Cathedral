module state;
use decisions::outcomes;
use decisions::catalogue::metadata;
use decisions::catalogue::catalogue;
use decisions::layout;

// Opaque app state. The host knows only its size/alignment, never its fields.
public data State {
    phase: Phase;
    picker: bool;
    own: u64;
    realm: u64;
    notice: decisions::outcomes::Notice;
    metadata: [u64; 64];
    classification: decisions::catalogue::metadata::Classification;
    catalogue_request: decisions::catalogue::catalogue::Request;
    entries: decisions::catalogue::catalogue::Catalogue;
    geometry: decisions::layout::Geometry;
    candidate_names: [[u8; 13]; 51];
    found: u64;
    template: u64;
    background: u64;
    after: u64;
    names: [[u8; 13]; 6];
    selected: u64;
    epoch: u64;
    width: u64;
    height: u64;
    snapshot: [u64; 8];
    channels: [u64; 4];
    buttons: [u64; 4];
    clicked: bool;
    more: bool;
    tasks: [[u64; 8]; 3];
    task_index: u64;
    next_refresh: u64;
    force_refresh: bool;
    managed: u64;
    confirming: u64;
    cancel: bool;
    management_status: u64;
    saves: u64;
    launched: u64;
    close_selected: bool;
    editing: bool;
    uncertain: bool;
    setting_selected: u64;
    setting_status: u64;
    config_object: u64;
    config_revision: u64;
    reading_object: u64;
    reading_revision: u64;
    saved: [u8; 104];
    draft: [u8; 104];
    reading: [u8; 104];
    read_at: u64;
    reconciling: bool;
    dirty: bool;
    scene: bool;
    surfaces: [u64; 8];
    rank: u64;
    paint_step: u64;
    image_kind: u64;
    image_index: u64;
    image_surface: u64;
    image_x: u64;
    image_y: u64;
    image_width: u64;
    image_height: u64;
    image_offset: u64;
}

public data Phase [copy] {
    case Start;
    case InteractionReady;
    case StorageReady;
    case Bound;
    case Listed;
    case CopyHead;
    case Copied;
    case Clocked;
    case Tasked;
    case Managed;
    case Avail;
    case Observed;
    case Polled;
    case Selected;
    case Closed;
    case Launched;
    case Retried;
    case Waited;
    case Controlled;
    case SettingBound;
    case Looked;
    case Head;
    case Read;
    case Saved;
    case Applied;
    case Terminated;
    case Surface;
    case Painted;
    case Staged;
    case Image;
    case Recheck;
}
