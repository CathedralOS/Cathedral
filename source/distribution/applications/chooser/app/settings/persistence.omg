use {protocol}/main.omg;
use {decisions}/outcomes.omg;
// Resolve -> pinned inline reads -> compare -> publish -> apply. A lost reply
// stays uncertain until readback; an intervening edit is never overwritten.
use operations.omg;
use state.omg as local_state;
use transport.omg;
use session/session.omg;
use settings/settings.omg;
use {matrix_service}/children/configuration/encoding.omg;
public machine load_settings(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.phase = |local_state|::Phase::SettingBound; |operations|::Command::BindStorage }
public machine setting_bound(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition |transport|::failed(p) { true -> load_error(s, p) _ -> lookup(s, p) }
    machine lookup(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.realm = p.frame[1]; let realm: u64 = s.realm; let op: |operations|::Command = |transport|::storage(s, p, |local_state|::Phase::Looked, 16u64, realm, 0u64, 0u64, 6u64);
        p.payload[0] = 132394287128909u64; p.payload_bytes = 6u64; op
    }
}
public machine looked(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition |transport|::failed(p) { true -> load_error(s, p) _ -> head_request(s, p) }
    machine head_request(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.reading_object = p.frame[1]; let object: u64 = s.reading_object; |transport|::storage(s, p, |local_state|::Phase::Head, |main|::STORE_HEAD, object, 0u64, 0u64, 0u64) }
}
public machine head(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition |transport|::failed(p) || p.frame[3] != 104u64 { true -> load_error(s, p) _ -> begin(s, p) }
    machine begin(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.reading_revision = p.frame[2]; s.read_at = 0u64; read_request(s, p) }
}
machine read_request(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    let object: u64 = s.reading_object; let revision: u64 = s.reading_revision; let at: u64 = s.read_at; let length: u64 = read_length(at);
    |transport|::storage(s, p, |local_state|::Phase::Read, |main|::STORE_READ, object, revision, at, length)
}
machine read_length(at: u64) -> u64 { transition at == 96u64 { true -> (8u64) _ -> (32u64) } }
public machine read_reply(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition |transport|::failed(p) || p.frame[2] != s.reading_revision || p.frame[3] != 104u64 { true -> load_error(s, p) _ -> copy(s, p, 0u64) }
    machine copy(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command { transition i < read_length(s.read_at) && i < 32u64 && s.read_at < 104u64 { true -> byte(s, p, i) _ -> next(s, p) } }
    machine byte(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command requires i < 32u64 {
        let at: u64 = |transport|::add(s.read_at, i); transition at < 104u64 { true -> put(s, p, i, at) _ -> load_error(s, p) }
    }
    machine put(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64, at: u64) -> |operations|::Command requires i < 32u64 && at < 104u64 {
        s.reading[at] = ((p.frame[4u64 + i / 8u64] >> ((i % 8u64) * 8u64)) & 255u64) as u8;
        transition { _ -> copy(s, p, i + 1u64) }
    }
    machine next(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.read_at = |transport|::add(s.read_at, read_length(s.read_at)); transition s.read_at < 104u64 { true -> read_request(s, p) _ -> validate(s, p) } }
    machine validate(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition |encoding|::normalize(&mut s.reading) { true -> loaded(s, p) _ -> load_error(s, p) } }
}
machine loaded(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition s.reconciling { true -> reconcile(s, p) _ -> opened(s, p) }
    machine opened(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.config_object = s.reading_object; s.config_revision = s.reading_revision; s.saved = s.reading; s.draft = s.reading;
        s.editing = true; s.uncertain = false; s.setting_selected = 0u64; s.setting_status = 0u64; s.notice = |outcomes|::Notice::None; s.dirty = true; |session|::cycle(s, p)
    }
    machine reconcile(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition s.config_object != s.reading_object { true -> conflict(s, p) _ -> desired(s, p) } }
    machine desired(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition |encoding|::equal(&s.reading, &s.draft) { true -> confirmed(s, p) _ -> baseline(s, p) } }
    machine confirmed(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.saved = s.reading; s.config_revision = s.reading_revision; s.uncertain = false; apply_settings(s, p) }
    machine baseline(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { transition s.reading_revision != s.config_revision || !|encoding|::equal(&s.reading, &s.saved) { true -> conflict(s, p) _ -> publish(s, p) } }
    machine publish(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
        s.uncertain = true; let object: u64 = s.config_object; let revision: u64 = s.config_revision;
        let op: |operations|::Command = |transport|::storage(s, p, |local_state|::Phase::Saved, |main|::STORE_PUBLISH, object, revision, 0u64, 104u64);
        transition { _ -> bytes(s, p, 0u64) }
    }
    machine bytes(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command { transition i < 104u64 { true -> byte(s, p, i) _ -> send(s, p) } }
    machine byte(s: &mut |local_state|::State, p: &mut |operations|::Exchange, i: u64) -> |operations|::Command requires i < 104u64 { |transport|::put(p, i, s.draft[i] as u64); transition { _ -> bytes(s, p, i + 1u64) } }
    machine send(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { p.payload_bytes = 104u64; |operations|::Command::Storage }
    machine conflict(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.setting_status = 18u64; s.dirty = true; |session|::cycle(s, p) }
}
public machine save_settings(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition |settings|::settings_dirty(s) { true -> reconcile(s, p) _ -> apply_settings(s, p) }
    machine reconcile(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.reconciling = true; load_settings(s, p) }
}
public machine saved_reply(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    transition |transport|::failed(p) { true -> load_error(s, p) _ -> confirmed(s, p) }
    machine confirmed(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.config_revision = p.frame[2]; s.saved = s.draft; s.uncertain = false; apply_settings(s, p) }
}
machine apply_settings(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    let epoch: u64 = s.epoch; let margin: u64 = |encoding|::word(&s.draft, 64u64); let height: u64 = |encoding|::word(&s.draft, 72u64); let gap: u64 = |encoding|::word(&s.draft, 80u64);
    |transport|::interaction(s, p, |local_state|::Phase::Applied, 16u64, epoch, margin, height, gap, 0u64, 0u64, 0u64)
}
public machine applied(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    s.setting_status = 16u64 + |transport|::failed(p) as u64; s.dirty = true; |session|::cycle(s, p)
}
machine load_error(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command {
    s.dirty = true; transition s.reconciling { true -> save_failed(s, p) _ -> open_failed(s, p) }
    machine save_failed(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.setting_status = 19u64; |session|::cycle(s, p) }
    machine open_failed(s: &mut |local_state|::State, p: &mut |operations|::Exchange) -> |operations|::Command { s.notice = |outcomes|::Notice::Unavailable; |session|::cycle(s, p) }
}
