// Explicit native ABI for POSIX byte-view leaves. A slice is one semantic
// borrowed formal: pointer then extent occupy two consecutive native words.
// Scalar and sized-reference formals occupy one word. This policy is opt-in;
// it neither changes the default slice ABI nor grants access beyond the view.
use calling;

public LinuxArm64ByteViewCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan = posix_byte_view_linux_arm64_entry();
        let accepted: bool = posix_byte_view_parameters(&signature, &mut plan);
        transition accepted {
            true -> BoundaryPlanResult::Accepted { plan: plan }
            _ -> BoundaryPlanResult::Rejected {
                reason: CallingPolicyRejection { reason: "expected bounded byte views and integer or sized-reference formals" }
            }
        }
    }
}

public LinuxX86ByteViewCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan = posix_byte_view_linux_x86_entry();
        let accepted: bool = posix_byte_view_parameters(&signature, &mut plan);
        transition accepted {
            true -> BoundaryPlanResult::Accepted { plan: plan }
            _ -> BoundaryPlanResult::Rejected {
                reason: CallingPolicyRejection { reason: "expected bounded byte views and integer or sized-reference formals" }
            }
        }
    }
}

public DarwinArm64ByteViewCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan = posix_byte_view_darwin_entry();
        let accepted: bool = posix_byte_view_parameters(&signature, &mut plan);
        transition accepted {
            true -> BoundaryPlanResult::Accepted { plan: plan }
            _ -> BoundaryPlanResult::Rejected {
                reason: CallingPolicyRejection { reason: "expected bounded byte views and integer or sized-reference formals" }
            }
        }
    }
}
machine posix_byte_view_parameters(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan) -> bool
{
    transition signature.parameter_count == signature.native_parameter_count
        && signature.parameter_count <= 6 && signature.has_result
        && signature.callback_binder_count == 0 && signature.callback_demand_count == 0
        && signature.result < signature.shape_count && signature.result < 256 {
        true -> result(signature, plan, &signature.shapes[signature.result])
        _ -> false
    }
    state result(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, shape: &ValueShape) -> bool {
        transition shape.class {
            ValueClass::Integer -> result_size(signature, plan, shape)
            _ -> false
        }
    }
    state result_size(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, shape: &ValueShape) -> bool {
        transition (shape.byte_size == 4 && shape.alignment == 4)
            || (shape.byte_size == 8 && shape.alignment == 8) {
            true -> result_place(signature, plan, shape)
            _ -> false
        }
    }
    state result_place(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, shape: &ValueShape) -> bool {
        plan.call.has_result = true;
        plan.call.result.shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: shape.byte_size, alignment: shape.alignment };
        plan.call.result.location_count = 1;
        plan.call.result.locations[0] = ValueLocation::Register {
            register: posix_byte_view_result_register(&plan.call.convention), value_byte_offset: 0, byte_size: shape.byte_size
        };
        plan.call.parameter_count = signature.parameter_count;
        posix_byte_view_parameters_from(signature, plan, 0, 0, 6)
    }
}

machine posix_byte_view_parameters_from(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64, remaining: u64) -> bool
terminates by remaining;
{
    let next_word: u64 = posix_byte_view_parameter(signature, plan, ordinal, word);
    transition {
        ordinal == signature.parameter_count -> (next_word <= 6)
        ordinal < 6 && remaining > 0 && next_word <= 6 ->
            posix_byte_view_parameters_from(signature, plan, ordinal + 1, next_word, remaining - 1)
        _ -> false
    }
}

machine posix_byte_view_parameter(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64) -> u64
{
        transition {
            ordinal == signature.parameter_count -> word
            ordinal < signature.parameter_count && ordinal < 6 && ordinal < 32 -> root(signature, plan, ordinal, word, signature.parameters[ordinal])
            _ -> 7
        }
    state root(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64, root: u64) -> u64
    requires ordinal < 6;
    {
        transition root < signature.shape_count && root < 256 {
            true -> shape(signature, plan, ordinal, word, &signature.shapes[root])
            _ -> 7
        }
    }
    state shape(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64, shape: &ValueShape) -> u64
    requires ordinal < 6;
    {
        transition shape.class {
            ValueClass::Reference -> reference(signature, plan, ordinal, word, shape)
            ValueClass::Integer -> scalar(signature, plan, ordinal, word, shape)
            _ -> 7
        }
    }
    state reference(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64, shape: &ValueShape) -> u64
    requires ordinal < 6;
    {
        transition {
            shape.byte_size == 16 && shape.alignment == 8 && word <= 4 -> place(signature, plan, ordinal, word, shape, true)
            shape.byte_size == 8 && shape.alignment == 8 && word < 6 -> place(signature, plan, ordinal, word, shape, false)
            _ -> 7
        }
    }
    state scalar(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64, shape: &ValueShape) -> u64
    requires ordinal < 6;
    {
        transition word < 6 && ((shape.byte_size == 4 && shape.alignment == 4)
            || (shape.byte_size == 8 && shape.alignment == 8)) {
            true -> place(signature, plan, ordinal, word, shape, false)
            _ -> 7
        }
    }
    state place(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64, shape: &ValueShape, pair: bool) -> u64
    requires ordinal < 6, word < 6;
    {
        plan.call.parameters[ordinal].shape = AbiValueShape {
            class: AbiValueClass::Integer, byte_size: shape.byte_size, alignment: shape.alignment
        };
        transition pair {
            true -> pair(signature, plan, ordinal, word)
            _ -> single(signature, plan, ordinal, word, shape.byte_size)
        }
    }
    state pair(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64) -> u64
    requires ordinal < 6, word < 6;
    {
        transition word <= 4 {
            true -> pair_place(signature, plan, ordinal, word)
            _ -> 7
        }
    }
    state pair_place(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64) -> u64
    requires ordinal < 6, word <= 4;
    {
        plan.call.parameters[ordinal].location_count = 2;
        plan.call.parameters[ordinal].locations[0] = ValueLocation::Register {
            register: posix_byte_view_argument_register(word, &plan.call.convention), value_byte_offset: 0, byte_size: 8
        };
        plan.call.parameters[ordinal].locations[1] = ValueLocation::Register {
            register: posix_byte_view_argument_register(word + 1, &plan.call.convention), value_byte_offset: 8, byte_size: 8
        };
        word + 2
    }
    state single(signature: &BoundarySignature, plan: &mut BoundaryEntryPlan, ordinal: u64, word: u64, size: u64) -> u64
    requires ordinal < 6, word < 6;
    {
        plan.call.parameters[ordinal].location_count = 1;
        plan.call.parameters[ordinal].locations[0] = ValueLocation::Register {
            register: posix_byte_view_argument_register(word, &plan.call.convention), value_byte_offset: 0, byte_size: size
        };
        word + 1
    }
}

machine posix_byte_view_argument_register(word: u64, convention: &CallingConvention) -> MachineRegister {
    transition convention {
        CallingConvention::LinuxSyscallX86_64 -> x86(word)
        _ -> MachineRegister::Aarch64X { index: word }
    }
    state x86(word: u64) -> MachineRegister {
        transition word {
            0 -> MachineRegister::X86Rdi
            1 -> MachineRegister::X86Rsi
            2 -> MachineRegister::X86Rdx
            3 -> MachineRegister::X86R10
            4 -> MachineRegister::X86R8
            _ -> MachineRegister::X86R9
        }
    }
}
machine posix_byte_view_result_register(convention: &CallingConvention) -> MachineRegister {
    transition convention {
        CallingConvention::LinuxSyscallX86_64 -> MachineRegister::X86Rax
        _ -> MachineRegister::Aarch64X { index: 0 }
    }
}

machine posix_byte_view_linux_arm64_entry() -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan;
    plan.call.convention = CallingConvention::LinuxSyscallAarch64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::SupervisorCall { number_register: MachineRegister::Aarch64X { index: 8 }, immediate: 0 };
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::Aarch64X { index: 0 };
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::Aarch64X { index: 1 };
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::Aarch64X { index: 2 };
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::Aarch64X { index: 3 };
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::Aarch64X { index: 4 };
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::Aarch64X { index: 5 };
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::Aarch64X { index: 8 };
    plan.call.ordinary_clobbers.register_count = 7;
    plan.state.initial_regime = MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}
machine posix_byte_view_linux_x86_entry() -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan;
    plan.call.convention = CallingConvention::LinuxSyscallX86_64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::SupervisorCall { number_register: MachineRegister::X86Rax, immediate: 0 };
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::X86R11;
    plan.call.ordinary_clobbers.register_count = 3;
    plan.state.initial_regime = MachineRegime::X86Long64;
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}
machine posix_byte_view_darwin_entry() -> BoundaryEntryPlan
{
    let mut plan: BoundaryEntryPlan;
    plan.call.convention = CallingConvention::Aapcs64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::CallReturn;
    plan.state.initial_regime = MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::Aarch64X { index: 0 };
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::Aarch64X { index: 1 };
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::Aarch64X { index: 2 };
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::Aarch64X { index: 3 };
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::Aarch64X { index: 4 };
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::Aarch64X { index: 5 };
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::Aarch64X { index: 6 };
    plan.call.ordinary_clobbers.registers[7] = MachineRegister::Aarch64X { index: 7 };
    plan.call.ordinary_clobbers.registers[8] = MachineRegister::Aarch64X { index: 8 };
    plan.call.ordinary_clobbers.registers[9] = MachineRegister::Aarch64X { index: 9 };
    plan.call.ordinary_clobbers.registers[10] = MachineRegister::Aarch64X { index: 10 };
    plan.call.ordinary_clobbers.registers[11] = MachineRegister::Aarch64X { index: 11 };
    plan.call.ordinary_clobbers.registers[12] = MachineRegister::Aarch64X { index: 12 };
    plan.call.ordinary_clobbers.registers[13] = MachineRegister::Aarch64X { index: 13 };
    plan.call.ordinary_clobbers.registers[14] = MachineRegister::Aarch64X { index: 14 };
    plan.call.ordinary_clobbers.registers[15] = MachineRegister::Aarch64X { index: 15 };
    plan.call.ordinary_clobbers.registers[16] = MachineRegister::Aarch64X { index: 16 };
    plan.call.ordinary_clobbers.registers[17] = MachineRegister::Aarch64X { index: 17 };
    plan.call.ordinary_clobbers.registers[18] = MachineRegister::Aarch64V { index: 0 };
    plan.call.ordinary_clobbers.registers[19] = MachineRegister::Aarch64V { index: 1 };
    plan.call.ordinary_clobbers.registers[20] = MachineRegister::Aarch64V { index: 2 };
    plan.call.ordinary_clobbers.registers[21] = MachineRegister::Aarch64V { index: 3 };
    plan.call.ordinary_clobbers.registers[22] = MachineRegister::Aarch64V { index: 4 };
    plan.call.ordinary_clobbers.registers[23] = MachineRegister::Aarch64V { index: 5 };
    plan.call.ordinary_clobbers.registers[24] = MachineRegister::Aarch64V { index: 6 };
    plan.call.ordinary_clobbers.registers[25] = MachineRegister::Aarch64V { index: 7 };
    plan.call.ordinary_clobbers.registers[26] = MachineRegister::Aarch64V { index: 16 };
    plan.call.ordinary_clobbers.registers[27] = MachineRegister::Aarch64V { index: 17 };
    plan.call.ordinary_clobbers.registers[28] = MachineRegister::Aarch64V { index: 18 };
    plan.call.ordinary_clobbers.registers[29] = MachineRegister::Aarch64V { index: 19 };
    plan.call.ordinary_clobbers.registers[30] = MachineRegister::Aarch64V { index: 20 };
    plan.call.ordinary_clobbers.registers[31] = MachineRegister::Aarch64V { index: 21 };
    plan.call.ordinary_clobbers.registers[32] = MachineRegister::Aarch64V { index: 22 };
    plan.call.ordinary_clobbers.registers[33] = MachineRegister::Aarch64V { index: 23 };
    plan.call.ordinary_clobbers.registers[34] = MachineRegister::Aarch64V { index: 24 };
    plan.call.ordinary_clobbers.registers[35] = MachineRegister::Aarch64V { index: 25 };
    plan.call.ordinary_clobbers.registers[36] = MachineRegister::Aarch64V { index: 26 };
    plan.call.ordinary_clobbers.registers[37] = MachineRegister::Aarch64V { index: 27 };
    plan.call.ordinary_clobbers.registers[38] = MachineRegister::Aarch64V { index: 28 };
    plan.call.ordinary_clobbers.registers[39] = MachineRegister::Aarch64V { index: 29 };
    plan.call.ordinary_clobbers.registers[40] = MachineRegister::Aarch64V { index: 30 };
    plan.call.ordinary_clobbers.registers[41] = MachineRegister::Aarch64V { index: 31 };
    plan.call.ordinary_clobbers.register_count = 42;
    plan
}
