// std::time — Duration pure-value core (rung 3) + Instant/Time over the
// TimeHost seam (rung 6) per TASKS_TIME.md D1-D7/D9/D13.
//
// `Duration` is a normalized span: whole seconds plus subsecond nanoseconds,
// whose data `where` carries the normalization invariant at construction
// and mutation boundaries — ZII zero IS the zero duration.
// Everything here is a pure `[copy]` value with no authority; clock
// READS live on the `Time` capability (a later rung), never on these types.
//
// Rust parity, differing where Omega is better (TASKS_TIME.md north star):
// - No panicking `+`/`-`: the checked and saturating forms ARE the API.
//   `case Overflow` is DurationResult's ZII-zero first case, so an
//   uninitialized result reads as the failure case, never a fake success.
// - `checked_subtract` reports underflow through the same `Overflow` case
//   (one result vocabulary; the direction is unambiguous from the operation).
// - Struct literals and receiverless `from_*` machines establish the same
//   normalization predicate. Local bounds come from their computations,
//   never from a scalar type suffix.
//
// Authoring shape (the de-Trapping house recipes):
// - Overflow/underflow DETECTION is explicit guards; the arithmetic itself
//   runs in Wrapping-domained lets (obligation-free), whose values are only
//   USED on the guard arms that prove them meaningful — the wrapped-compare
//   idiom (`sum < a` iff the u64 add wrapped) needs no u64::MAX literal.
// - The normalized `subsecond_nanoseconds` store happens in `*_emit` states whose
//   SINGLE inbound edge is the `<= 999999999` guard: single-predecessor edge
//   guards flow into the target state, so the store proves. The `false` arms
//   are unreachable by construction but total (never a silent face).

// The raw per-OS boundary (`TimeHost`) is declared once in the sibling std
// module; the `Time` capability below wraps it (the filesystem.omg layering).
use time_host;
use math;
use omega::language::core::numeric_conversion;

public data Ordering [copy] {
    case Less;
    case Equal;
    case Greater;
}

public data Duration [copy] where subsecond_nanoseconds <= 999_999_999 {
    seconds: u64;
    subsecond_nanoseconds: u32;
}

public data DurationResult [copy] {
    case Overflow;
    case Ok(duration: Duration);
}

// Whole-duration totals (`checked_as_*`): one result vocabulary for all three
// units. (The scoping sketch spelled this `NanosecondsResult { Ok(nanoseconds) }`;
// one payload field cannot be unit-accurate for nanoseconds AND milliseconds,
// so the field is the neutral `total` -- noted in TASKS_TIME.md.)
public data TotalResult [copy] {
    case Overflow;
    case Ok(total: u64);
}

const Duration::ZERO: Duration = Duration { seconds: 0, subsecond_nanoseconds: 0 };
// u64::MAX seconds: spellable since D14 fire D blessed u64-classed
// struct-literal fields for u64-magnitude literals. MAX is public because it
// is the exact saturation and checked-total boundary exposed by Duration.
public const Duration::MAX: Duration = Duration { seconds: 18446744073709551615, subsecond_nanoseconds: 999999999 };

// Unit constructors (receiverless type-scoped machines).
public machine Duration::from_seconds(seconds: u64) -> Duration {
    Duration { seconds: seconds, subsecond_nanoseconds: 0 }
}

public machine Duration::from_milliseconds(milliseconds: u64) -> Duration {
    // The remainder and scaling establish the narrowing bound; the final
    // remainder establishes Duration's normalization predicate.
    let scaled_wide: u64 = (milliseconds % 1000) * 1000000;
    let scaled: u32 = narrow_u64_to_u32_exact(scaled_wide);
    let whole_seconds: u64 = milliseconds / 1000;
    let sub: u32 = scaled % 1000000000;
    Duration {
        seconds: whole_seconds,
        subsecond_nanoseconds: sub,
    }
}

public machine Duration::from_microseconds(microseconds: u64) -> Duration {
    // The same initializer facts as from_milliseconds, at microsecond scale.
    let scaled_wide: u64 = (microseconds % 1000000) * 1000;
    let scaled: u32 = narrow_u64_to_u32_exact(scaled_wide);
    let whole_seconds: u64 = microseconds / 1000000;
    let sub: u32 = scaled % 1000000000;
    Duration {
        seconds: whole_seconds,
        subsecond_nanoseconds: sub,
    }
}

public machine Duration::from_nanoseconds(nanoseconds: u64) -> Duration {
    let remainder_wide: u64 = nanoseconds % 1000000000;
    let remainder: u32 = narrow_u64_to_u32_exact(remainder_wide);
    let whole_seconds: u64 = nanoseconds / 1000000000;
    let sub: u32 = remainder % 1000000000;
    Duration {
        seconds: whole_seconds,
        subsecond_nanoseconds: sub,
    }
}

// Whole seconds, truncating the subsecond part (Rust `as_secs`).
public machine Duration::as_seconds(duration: &Duration) -> u64 {
    duration.seconds
}

public machine Duration::subsecond_milliseconds(duration: &Duration) -> u32 {
    duration.subsecond_nanoseconds / 1000000
}

public machine Duration::subsecond_microseconds(duration: &Duration) -> u32 {
    duration.subsecond_nanoseconds / 1000
}

// checked-as-<unit> shares this spine: bound-check the seconds magnitude,
// fold the unit-scaled subsecond part into a wrapping total, and report
// Overflow when the exact value no longer fits u64. `divisor` scales
// nanoseconds down to the unit, so it is never zero.
machine checked_as_scaled_total(duration: &Duration, multiplier: u64 in Wrapping, divisor: u32, seconds_bound: u64, subsecond_bound: u32) -> TotalResult
requires divisor > 0
{
    let seconds_small: bool = duration.seconds < seconds_bound;
    let seconds_edge: bool = duration.seconds == seconds_bound;
    let subsecond_part: u32 = duration.subsecond_nanoseconds / divisor;
    let subsecond_fits: bool = subsecond_part <= subsecond_bound;
    let total: u64 in Wrapping = ((duration.seconds as u64 in Wrapping) * multiplier)
        + (widen_u32_to_u64(subsecond_part) as u64 in Wrapping);
    transition seconds_small {
        true -> total_ok(total as u64)
        false -> total_edge(seconds_edge, subsecond_fits, total as u64)
    }
    state total_ok(total: u64) -> TotalResult {
        TotalResult::Ok { total: total }
    }
    state total_edge(seconds_edge: bool, subsecond_fits: bool, total: u64) -> TotalResult {
        transition seconds_edge && subsecond_fits {
            true -> total_ok(total)
            false -> total_overflow()
        }
    }
    state total_overflow() -> TotalResult {
        TotalResult::Overflow
    }
}

// The whole duration as a nanosecond count. u64 nanoseconds cap at
// ~584 years: seconds above 18_446_744_073 (u64::MAX / 1e9) overflow, and at
// exactly that threshold only subseconds up to 709_551_615 still fit
// (18_446_744_073 * 1e9 + 709_551_615 == u64::MAX).
public machine Duration::checked_as_nanoseconds(duration: &Duration) -> TotalResult {
    checked_as_scaled_total(duration, 1000000000 as u64 in Wrapping, 1, 18446744073, 709551615)
}

// The whole duration as a microsecond count (subseconds truncate to the
// microsecond). Threshold 18_446_744_073_709 = u64::MAX / 1e6; at the edge
// only microsecond parts up to 551_615 still fit.
public machine Duration::checked_as_microseconds(duration: &Duration) -> TotalResult {
    checked_as_scaled_total(duration, 1000000 as u64 in Wrapping, 1000, 18446744073709, 551615)
}

// The whole duration as a millisecond count (subseconds truncate to the
// millisecond). Threshold 18_446_744_073_709_551 = u64::MAX / 1e3; at the
// edge only millisecond parts up to 615 still fit.
public machine Duration::checked_as_milliseconds(duration: &Duration) -> TotalResult {
    checked_as_scaled_total(duration, 1000 as u64 in Wrapping, 1000000, 18446744073709551, 615)
}

public machine Duration::is_zero(duration: &Duration) -> bool {
    duration.seconds == 0 && duration.subsecond_nanoseconds == 0
}

// duration + other; `Overflow` when the true sum exceeds the representable range.
public machine Duration::checked_add(duration: &Duration, other: Duration) -> DurationResult {
    // EXACT-provable straight from the field ranges:
    // [0..=999_999_999] + [0..=999_999_999] = [0..=1_999_999_998] fits u32.
    let nanoseconds_total: u32 = duration.subsecond_nanoseconds + other.subsecond_nanoseconds;
    let seconds_sum: u64 in Wrapping =
        (duration.seconds as u64 in Wrapping) + (other.seconds as u64 in Wrapping);
    let seconds_wrapped: bool = seconds_sum < duration.seconds;
    transition nanoseconds_total >= 1000000000 {
        true -> add_carried(nanoseconds_total, seconds_sum as u64, seconds_wrapped)
        false -> add_flat(nanoseconds_total, seconds_sum as u64, seconds_wrapped)
    }

    state add_carried(nanoseconds_total: u32, seconds_sum: u64, seconds_wrapped: bool) -> DurationResult {
        let seconds_carried: u64 in Wrapping = (seconds_sum as u64 in Wrapping) + 1;
        let carry_wrapped: bool = seconds_carried < seconds_sum;
        let nanoseconds_reduced: u32 in Wrapping = (nanoseconds_total as u32 in Wrapping) - 1000000000;
        transition seconds_wrapped {
            true -> add_overflow()
            false -> add_carry_gate(nanoseconds_reduced as u32, seconds_carried as u64, carry_wrapped)
        }
    }
    state add_carry_gate(nanoseconds_reduced: u32, seconds_carried: u64, carry_wrapped: bool) -> DurationResult {
        transition carry_wrapped {
            true -> add_overflow()
            false -> add_gate(seconds_carried, nanoseconds_reduced)
        }
    }
    state add_flat(nanoseconds_total: u32, seconds_sum: u64, seconds_wrapped: bool) -> DurationResult {
        transition seconds_wrapped {
            true -> add_overflow()
            false -> add_gate(seconds_sum, nanoseconds_total)
        }
    }
    state add_gate(seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        transition nanoseconds_final <= 999999999 {
            true -> add_emit(seconds_final, nanoseconds_final)
            false -> add_overflow()
        }
    }
    state add_emit(seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        // `% 1000000000` INLINE in the field value: construction checks are
        // flow-insensitive, and modulo bounds by the divisor, so the ranged
        // store proves right here; the gate already ensured the mod is an
        // identity at runtime.
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state add_overflow() -> DurationResult {
        DurationResult::Overflow
    }
}

// duration - other; `Overflow` (underflow) when other exceeds duration.
// Later states carry the arithmetic values they need, not either input borrow.
public machine Duration::checked_subtract(duration: &Duration, other: Duration) -> DurationResult {
    let seconds_bigger: bool = duration.seconds > other.seconds;
    let seconds_equal: bool = duration.seconds == other.seconds;
    let nanoseconds_fit: bool = duration.subsecond_nanoseconds >= other.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping =
        (duration.seconds as u64 in Wrapping) - (other.seconds as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    // The final `as u32` re-domains each wrapped result to Exact IN THE LET:
    // a payload field value of shape `(cast) % literal` is silently dropped by
    // the parallel write cascade (known landmine, filed in TASKS.md), so the
    // emit states must see a BARE param (`nanoseconds_final % 1000000000`).
    let nanoseconds_direct: u32 = ((duration.subsecond_nanoseconds as u32 in Wrapping)
        - (other.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (other.subsecond_nanoseconds as u32 in Wrapping))
        + (duration.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> subtract_bigger(nanoseconds_fit, seconds_direct as u64, seconds_borrowed as u64, nanoseconds_direct, nanoseconds_borrowed)
        false -> subtract_equal_or_less(seconds_equal, nanoseconds_fit, seconds_direct as u64, nanoseconds_direct)
    }

    state subtract_bigger(nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> DurationResult {
        // Seconds strictly bigger: a nanosecond borrow cannot underflow.
        transition nanoseconds_fit {
            true -> subtract_emit(seconds_direct, nanoseconds_direct)
            false -> subtract_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state subtract_equal_or_less(seconds_equal: bool, nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32) -> DurationResult {
        transition seconds_equal && nanoseconds_fit {
            true -> subtract_emit(seconds_direct, nanoseconds_direct)
            false -> subtract_underflow()
        }
    }
    state subtract_emit(seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        // Inline `%` bounds the ranged store flow-insensitively; the guarded
        // arms above ensured it is an identity at runtime.
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state subtract_underflow() -> DurationResult {
        DurationResult::Overflow
    }
}

// duration * factor; `Overflow` when the true product exceeds the range.
public machine Duration::checked_multiply(duration: &Duration, factor: u32) -> DurationResult {
    let factor_wide: u64 = widen_u32_to_u64(factor);
    // Subsecond product fits u64 by math ([0..=999_999_999] * [0..=u32::MAX])
    // but the interval fold cannot multiply variable bounds -- Wrapping
    // spelling, correctness carried by the bounds themselves.
    let nano_product_wrapped: u64 in Wrapping =
        (widen_u32_to_u64(duration.subsecond_nanoseconds) as u64 in Wrapping)
        * (factor_wide as u64 in Wrapping);
    let nano_product: u64 = nano_product_wrapped as u64;
    let extra_seconds: u64 = nano_product / 1000000000;
    let nano_remainder_wide: u64 = nano_product % 1000000000;
    let nano_remainder: u32 = narrow_u64_to_u32_exact(nano_remainder_wide);
    // Division-free u64 overflow detection for seconds * factor via the
    // 32-bit split (the interpreter's div/mod on msb-set u64 was only just
    // taught unsignedness; shifts and adds need no such care):
    // seconds = hi<<32 | lo. Overflow iff hi*factor exceeds 32 bits or a
    // carry wraps (wrapped-compare idiom).
    let seconds_high: u64 = duration.seconds >> 32;
    let seconds_low: u64 = duration.seconds & 4294967295;
    let high_product_wrapped: u64 in Wrapping =
        (seconds_high as u64 in Wrapping) * (factor_wide as u64 in Wrapping);
    let high_product: u64 = high_product_wrapped as u64;
    let low_product_wrapped: u64 in Wrapping =
        (seconds_low as u64 in Wrapping) * (factor_wide as u64 in Wrapping);
    let low_product: u64 = low_product_wrapped as u64;
    let high_fits: bool = high_product <= 4294967295;
    let high_shifted: u64 in Wrapping = (high_product as u64 in Wrapping) << 32;
    let seconds_product: u64 in Wrapping =
        (high_shifted as u64 in Wrapping) + (low_product as u64 in Wrapping);
    let product_wrapped: bool = seconds_product < low_product;
    let final_seconds: u64 in Wrapping =
        (seconds_product as u64 in Wrapping) + (extra_seconds as u64 in Wrapping);
    let final_wrapped: bool = final_seconds < seconds_product;
    transition high_fits {
        true -> multiply_carry_gate(product_wrapped, final_wrapped, final_seconds as u64, nano_remainder)
        false -> multiply_overflow()
    }
    state multiply_carry_gate(product_wrapped: bool, final_wrapped: bool, final_seconds: u64, nano_remainder: u32) -> DurationResult {
        transition product_wrapped {
            true -> multiply_overflow()
            false -> multiply_final_gate(final_wrapped, final_seconds, nano_remainder)
        }
    }
    state multiply_final_gate(final_wrapped: bool, final_seconds: u64, nano_remainder: u32) -> DurationResult {
        transition final_wrapped {
            true -> multiply_overflow()
            false -> multiply_emit(final_seconds, nano_remainder)
        }
    }
    state multiply_emit(seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state multiply_overflow() -> DurationResult {
        DurationResult::Overflow
    }
}

// duration / divisor; the `Overflow` case doubles as the divisor-0 signal (a
// guard, never a runtime fault -- per the settled surface). The subsecond
// remainder of the seconds division redistributes into the nanoseconds.
public machine Duration::divide(duration: &Duration, divisor: u32) -> DurationResult {
    // ENTRY-ONLY discipline: entry lets evaluate eagerly, so a zero divisor
    // is clamped to 1 and the real zero case routes to the Overflow arm,
    // ignoring the harmlessly-computed values.
    let divisor_is_zero: bool = divisor == 0;
    let safe_divisor_narrow: u32 = clamp_u32(divisor, 1, 4294967295);
    let safe_divisor: u64 = widen_u32_to_u64(safe_divisor_narrow);
    let seconds_quotient: u64 = duration.seconds / safe_divisor;
    let seconds_remainder: u64 = duration.seconds % safe_divisor;
    // remainder < divisor <= u32::MAX, so this fits u64 by math; Wrapping
    // spelling because the fold cannot multiply variable bounds.
    let total_wrapped: u64 in Wrapping = ((seconds_remainder as u64 in Wrapping)
        * 1000000000)
        + (widen_u32_to_u64(duration.subsecond_nanoseconds) as u64 in Wrapping);
    let total_subnanoseconds: u64 = total_wrapped as u64;
    let sub_quotient_wide: u64 = total_subnanoseconds / safe_divisor;
    let sub_quotient_bounded: u64 =
        sub_quotient_wide % 1000000000;
    let sub_quotient: u32 = narrow_u64_to_u32_exact(sub_quotient_bounded);
    transition divisor_is_zero {
        true -> divide_by_zero()
        false -> divide_emit(seconds_quotient, sub_quotient)
    }
    state divide_emit(seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state divide_by_zero() -> DurationResult {
        DurationResult::Overflow
    }
}

// duration + other, clamping at MAX instead of reporting overflow (total).
public machine Duration::saturating_add(duration: &Duration, other: Duration) -> Duration {
    let sum: DurationResult = Duration::checked_add(duration, other);
    transition sum {
        DurationResult::Ok { duration } -> saturate_add_value(duration)
        DurationResult::Overflow -> saturate_add_max()
    }
    state saturate_add_value(duration: Duration) -> Duration { duration }
    state saturate_add_max() -> Duration { Duration::MAX }
}

// duration - other, clamping at ZERO instead of reporting underflow (total, the
// ZII-friendly default the wrapper types lean on).
public machine Duration::saturating_subtract(duration: &Duration, other: Duration) -> Duration {
    let difference: DurationResult = Duration::checked_subtract(duration, other);
    transition difference {
        DurationResult::Ok { duration } -> saturate_value(duration)
        DurationResult::Overflow -> saturate_zero()
    }
    state saturate_value(duration: Duration) -> Duration { duration }
    state saturate_zero() -> Duration { Duration::ZERO }
}

public machine Duration::compare(duration: &Duration, other: Duration) -> Ordering {
    let seconds_greater: bool = duration.seconds > other.seconds;
    let seconds_less: bool = duration.seconds < other.seconds;
    let nanoseconds_greater: bool = duration.subsecond_nanoseconds > other.subsecond_nanoseconds;
    let nanoseconds_less: bool = duration.subsecond_nanoseconds < other.subsecond_nanoseconds;
    transition seconds_greater {
        true -> compare_greater()
        false -> compare_seconds_rest(seconds_less, nanoseconds_greater, nanoseconds_less)
    }
    state compare_seconds_rest(seconds_less: bool, nanoseconds_greater: bool, nanoseconds_less: bool) -> Ordering {
        transition seconds_less {
            true -> compare_less()
            false -> compare_nanoseconds(nanoseconds_greater, nanoseconds_less)
        }
    }
    state compare_nanoseconds(nanoseconds_greater: bool, nanoseconds_less: bool) -> Ordering {
        transition nanoseconds_greater {
            true -> compare_greater()
            false -> compare_nanoseconds_rest(nanoseconds_less)
        }
    }
    state compare_nanoseconds_rest(nanoseconds_less: bool) -> Ordering {
        transition nanoseconds_less {
            true -> compare_less()
            false -> compare_equal()
        }
    }
    state compare_less() -> Ordering { Ordering::Less }
    state compare_equal() -> Ordering { Ordering::Equal }
    state compare_greater() -> Ordering { Ordering::Greater }
}

public machine Duration::is_less_than(duration: &Duration, other: Duration) -> bool {
    let order: Ordering = Duration::compare(duration, other);
    transition order {
        Ordering::Less -> less_yes()
        Ordering::Equal -> less_no()
        Ordering::Greater -> less_no()
    }
    state less_yes() -> bool { true }
    state less_no() -> bool { false }
}

public machine Duration::is_greater_than(duration: &Duration, other: Duration) -> bool {
    let order: Ordering = Duration::compare(duration, other);
    transition order {
        Ordering::Greater -> greater_yes()
        Ordering::Less -> greater_no()
        Ordering::Equal -> greater_no()
    }
    state greater_yes() -> bool { true }
    state greater_no() -> bool { false }
}

// A point on the MONOTONIC clock, normalized at `now()` (D6): whole seconds +
// subsecond nanoseconds since an UNSPECIFIED epoch. Opaque-by-convention --
// only differences between two Instants from the same process are meaningful.
// Same field shapes as Duration, so the subtraction machinery mirrors it.
public data Instant [copy] where subsecond_nanoseconds <= 999_999_999 {
    seconds: u64;
    subsecond_nanoseconds: u32;
}

public data InstantResult [copy] {
    case Overflow;
    case Ok(instant: Instant);
}

// The representable extremes the saturating forms clamp to. MAX's seconds
// literal is D14 fire D (a u64-classed struct field accepts the u64
// magnitude); EPOCH is the ZII zero spelled as itself.
const Instant::EPOCH: Instant = Instant { seconds: 0, subsecond_nanoseconds: 0 };
const Instant::MAX: Instant = Instant { seconds: 18446744073709551615, subsecond_nanoseconds: 999999999 };

// instant + duration as a later Instant; `Overflow` past the representable
// range. Mirrors Duration::checked_add -- identical field shapes, identical
// carry idiom (wrapped-compare overflow detection).
public machine Instant::checked_add(instant: &Instant, duration: Duration) -> InstantResult {
    let nanoseconds_total: u32 = instant.subsecond_nanoseconds + duration.subsecond_nanoseconds;
    let seconds_sum: u64 in Wrapping =
        (instant.seconds as u64 in Wrapping) + (duration.seconds as u64 in Wrapping);
    let seconds_wrapped: bool = seconds_sum < instant.seconds;
    transition nanoseconds_total >= 1000000000 {
        true -> instant_add_carried(nanoseconds_total, seconds_sum as u64, seconds_wrapped)
        false -> instant_add_flat(nanoseconds_total, seconds_sum as u64, seconds_wrapped)
    }
    state instant_add_carried(nanoseconds_total: u32, seconds_sum: u64, seconds_wrapped: bool) -> InstantResult {
        let seconds_carried: u64 in Wrapping = (seconds_sum as u64 in Wrapping) + 1;
        let carry_wrapped: bool = seconds_carried < seconds_sum;
        let nanoseconds_reduced: u32 in Wrapping = (nanoseconds_total as u32 in Wrapping) - 1000000000;
        transition seconds_wrapped {
            true -> instant_add_overflow()
            false -> instant_add_carry_gate(nanoseconds_reduced as u32, seconds_carried as u64, carry_wrapped)
        }
    }
    state instant_add_carry_gate(nanoseconds_reduced: u32, seconds_carried: u64, carry_wrapped: bool) -> InstantResult {
        transition carry_wrapped {
            true -> instant_add_overflow()
            false -> instant_add_emit(seconds_carried, nanoseconds_reduced)
        }
    }
    state instant_add_flat(nanoseconds_total: u32, seconds_sum: u64, seconds_wrapped: bool) -> InstantResult {
        transition seconds_wrapped {
            true -> instant_add_overflow()
            false -> instant_add_emit(seconds_sum, nanoseconds_total)
        }
    }
    state instant_add_emit(seconds_final: u64, nanoseconds_final: u32) -> InstantResult {
        InstantResult::Ok {
            instant: Instant {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state instant_add_overflow() -> InstantResult { InstantResult::Overflow }
}

// instant - duration as an earlier Instant; `Overflow` on underflow below the
// monotonic epoch. Mirrors Duration::checked_subtract's borrow idiom.
public machine Instant::checked_subtract(instant: &Instant, duration: Duration) -> InstantResult {
    let seconds_bigger: bool = instant.seconds > duration.seconds;
    let seconds_equal: bool = instant.seconds == duration.seconds;
    let nanoseconds_fit: bool = instant.subsecond_nanoseconds >= duration.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping =
        (instant.seconds as u64 in Wrapping) - (duration.seconds as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    let nanoseconds_direct: u32 = ((instant.subsecond_nanoseconds as u32 in Wrapping)
        - (duration.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (duration.subsecond_nanoseconds as u32 in Wrapping))
        + (instant.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> instant_sub_bigger(nanoseconds_fit, seconds_direct as u64, seconds_borrowed as u64, nanoseconds_direct, nanoseconds_borrowed)
        false -> instant_sub_equal_or_less(seconds_equal, nanoseconds_fit, seconds_direct as u64, nanoseconds_direct)
    }
    state instant_sub_bigger(nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> InstantResult {
        transition nanoseconds_fit {
            true -> instant_sub_emit(seconds_direct, nanoseconds_direct)
            false -> instant_sub_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state instant_sub_equal_or_less(seconds_equal: bool, nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32) -> InstantResult {
        transition seconds_equal && nanoseconds_fit {
            true -> instant_sub_emit(seconds_direct, nanoseconds_direct)
            false -> instant_sub_overflow()
        }
    }
    state instant_sub_emit(seconds_final: u64, nanoseconds_final: u32) -> InstantResult {
        InstantResult::Ok {
            instant: Instant {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state instant_sub_overflow() -> InstantResult { InstantResult::Overflow }
}

// instant - earlier as a Duration; `Overflow` when `earlier` is later than instant
// (the monotonic clock cannot run backwards, so this means the caller swapped
// the operands or mixed instants across processes). Mirrors
// Duration::checked_subtract -- same borrow idiom, same authoring rules.
public machine Instant::checked_duration_since(instant: &Instant, earlier: Instant) -> DurationResult {
    let seconds_bigger: bool = instant.seconds > earlier.seconds;
    let seconds_equal: bool = instant.seconds == earlier.seconds;
    let nanoseconds_fit: bool = instant.subsecond_nanoseconds >= earlier.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping =
        (instant.seconds as u64 in Wrapping) - (earlier.seconds as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    let nanoseconds_direct: u32 = ((instant.subsecond_nanoseconds as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping))
        + (instant.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> since_bigger(nanoseconds_fit, seconds_direct as u64, seconds_borrowed as u64, nanoseconds_direct, nanoseconds_borrowed)
        false -> since_equal_or_less(seconds_equal, nanoseconds_fit, seconds_direct as u64, nanoseconds_direct)
    }
    state since_bigger(nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> DurationResult {
        transition nanoseconds_fit {
            true -> since_emit(seconds_direct, nanoseconds_direct)
            false -> since_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state since_equal_or_less(seconds_equal: bool, nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32) -> DurationResult {
        transition seconds_equal && nanoseconds_fit {
            true -> since_emit(seconds_direct, nanoseconds_direct)
            false -> since_backwards()
        }
    }
    state since_emit(seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state since_backwards() -> DurationResult {
        DurationResult::Overflow
    }
}

// instant + duration, clamping at Instant::MAX instead of reporting overflow
// (total). Mirrors Duration::saturating_add exactly; unblocked by D14
// fires E+F (the MAX const's u64 seconds literal is fire D).
public machine Instant::saturating_add(instant: &Instant, duration: Duration) -> Instant {
    let sum: InstantResult = Instant::checked_add(instant, duration);
    transition sum {
        InstantResult::Ok { instant } -> saturate_add_value(instant)
        InstantResult::Overflow -> saturate_add_max()
    }
    state saturate_add_value(instant: Instant) -> Instant { instant }
    state saturate_add_max() -> Instant { Instant::MAX }
}

// instant - duration, clamping at the monotonic EPOCH instead of reporting
// underflow (total). Mirrors Duration::saturating_subtract.
public machine Instant::saturating_subtract(instant: &Instant, duration: Duration) -> Instant {
    let difference: InstantResult = Instant::checked_subtract(instant, duration);
    transition difference {
        InstantResult::Ok { instant } -> saturate_value(instant)
        InstantResult::Overflow -> saturate_epoch()
    }
    state saturate_value(instant: Instant) -> Instant { instant }
    state saturate_epoch() -> Instant { Instant::EPOCH }
}

// instant - earlier, clamping at ZERO instead of reporting the backwards case
// (total, the ZII-friendly default -- Rust's `duration_since` panics here).
// Mirrors Duration::saturating_subtract (transitioning on a nested sibling
// call's result is safe again since the guard-ZII slot-naming fix,
// 2026-07-08 -- pinned by calls/runtime_nested_value_call_guard_exit).
public machine Instant::duration_since(instant: &Instant, earlier: Instant) -> Duration {
    let since: DurationResult = Instant::checked_duration_since(instant, earlier);
    transition since {
        DurationResult::Ok { duration } -> since_value(duration)
        DurationResult::Overflow -> since_zero()
    }
    state since_value(duration: Duration) -> Duration { duration }
    state since_zero() -> Duration { Duration::ZERO }
}

// A point on the WALL clock (D7): signed Unix-epoch seconds (pre-1970
// timestamps exist -- filesystem metadata bridges here) + subsecond
// nanoseconds. ZII zero IS the Unix epoch.
public data SystemTime [copy] where subsecond_nanoseconds <= 999_999_999 {
    seconds_since_unix_epoch: i64;
    subsecond_nanoseconds: u32;
}

const SystemTime::UNIX_EPOCH: SystemTime = SystemTime { seconds_since_unix_epoch: 0, subsecond_nanoseconds: 0 };
// The representable extremes the saturating forms clamp to (i64 seconds:
// both literals sit inside the i64 window, no D14 fire needed).
const SystemTime::MAX: SystemTime = SystemTime { seconds_since_unix_epoch: 9223372036854775807, subsecond_nanoseconds: 999999999 };
const SystemTime::MIN: SystemTime = SystemTime { seconds_since_unix_epoch: -9223372036854775808, subsecond_nanoseconds: 0 };

// `duration_since`'s result: the wall clock is NOT monotonic, so "earlier is
// actually later" is an ORDINARY outcome (NTP step, manual clock set), not an
// error -- the Backwards case carries the amount. The ZII zero case must be
// payload-free, and `Unmeasured` is the honest reading of an untouched
// result: never a fake Ok, never a fabricated Backwards(ZERO) measurement.
// (Deviation from the TASKS_TIME.md sketch, which had no zero case -- noted
// there.) `duration_since` itself never produces Unmeasured.
public data SystemTimeDifference [copy] {
    case Unmeasured;
    case Backwards(amount: Duration);
    case Ok(duration: Duration);
}

// Bridge from filesystem `Metadata` timestamps (and any other i64 Unix
// source): whole seconds, zero subseconds.
public machine SystemTime::from_unix_seconds(seconds: i64) -> SystemTime {
    SystemTime { seconds_since_unix_epoch: seconds, subsecond_nanoseconds: 0 }
}

// time - earlier as a Duration, or Backwards(earlier - time) when the wall
// clock ran backwards. The seconds difference of two i64s always fits u64
// (i64::MAX - i64::MIN == u64::MAX), computed as a u64 BIT-PATTERN wrapping
// subtraction -- two's complement makes it the true difference whenever the
// dominating compare proves the sign. Same borrow idiom as
// Duration::checked_subtract, both directions precomputed in entry lets.
public machine SystemTime::duration_since(time: &SystemTime, earlier: SystemTime) -> SystemTimeDifference {
    let seconds_bigger: bool = time.seconds_since_unix_epoch > earlier.seconds_since_unix_epoch;
    let seconds_equal: bool = time.seconds_since_unix_epoch == earlier.seconds_since_unix_epoch;
    let nanoseconds_fit: bool = time.subsecond_nanoseconds >= earlier.subsecond_nanoseconds;
    let back_nanoseconds_fit: bool = earlier.subsecond_nanoseconds >= time.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(time.seconds_since_unix_epoch) as u64 in Wrapping)
        - (narrow_i64_to_u64_wrapping(earlier.seconds_since_unix_epoch) as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    let nanoseconds_direct: u32 = ((time.subsecond_nanoseconds as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping))
        + (time.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let back_seconds_direct: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(earlier.seconds_since_unix_epoch) as u64 in Wrapping)
        - (narrow_i64_to_u64_wrapping(time.seconds_since_unix_epoch) as u64 in Wrapping);
    let back_seconds_borrowed: u64 in Wrapping = (back_seconds_direct as u64 in Wrapping) - 1;
    let back_nanoseconds_direct: u32 = ((earlier.subsecond_nanoseconds as u32 in Wrapping)
        - (time.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let back_nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (time.subsecond_nanoseconds as u32 in Wrapping))
        + (earlier.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> wall_bigger(nanoseconds_fit, seconds_direct as u64, seconds_borrowed as u64, nanoseconds_direct, nanoseconds_borrowed)
        false -> wall_equal_or_less(seconds_equal, nanoseconds_fit, back_nanoseconds_fit, seconds_direct as u64, nanoseconds_direct, back_seconds_direct as u64, back_seconds_borrowed as u64, back_nanoseconds_direct, back_nanoseconds_borrowed)
    }
    state wall_bigger(nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> SystemTimeDifference {
        transition nanoseconds_fit {
            true -> wall_emit_ok(seconds_direct, nanoseconds_direct)
            false -> wall_emit_ok(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state wall_equal_or_less(seconds_equal: bool, nanoseconds_fit: bool, back_nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32, back_seconds_direct: u64, back_seconds_borrowed: u64, back_nanoseconds_direct: u32, back_nanoseconds_borrowed: u32) -> SystemTimeDifference {
        transition seconds_equal && nanoseconds_fit {
            true -> wall_emit_ok(seconds_direct, nanoseconds_direct)
            false -> wall_backwards_split(seconds_equal, back_nanoseconds_fit, back_seconds_direct, back_seconds_borrowed, back_nanoseconds_direct, back_nanoseconds_borrowed)
        }
    }
    state wall_backwards_split(seconds_equal: bool, back_nanoseconds_fit: bool, back_seconds_direct: u64, back_seconds_borrowed: u64, back_nanoseconds_direct: u32, back_nanoseconds_borrowed: u32) -> SystemTimeDifference {
        // seconds equal here means time.sub < earlier.sub: no borrow needed.
        transition seconds_equal {
            true -> wall_emit_backwards(back_seconds_direct, back_nanoseconds_direct)
            false -> wall_backwards_borrow(back_nanoseconds_fit, back_seconds_direct, back_seconds_borrowed, back_nanoseconds_direct, back_nanoseconds_borrowed)
        }
    }
    state wall_backwards_borrow(back_nanoseconds_fit: bool, back_seconds_direct: u64, back_seconds_borrowed: u64, back_nanoseconds_direct: u32, back_nanoseconds_borrowed: u32) -> SystemTimeDifference {
        transition back_nanoseconds_fit {
            true -> wall_emit_backwards(back_seconds_direct, back_nanoseconds_direct)
            false -> wall_emit_backwards(back_seconds_borrowed, back_nanoseconds_borrowed)
        }
    }
    state wall_emit_ok(seconds_final: u64, nanoseconds_final: u32) -> SystemTimeDifference {
        SystemTimeDifference::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state wall_emit_backwards(seconds_final: u64, nanoseconds_final: u32) -> SystemTimeDifference {
        SystemTimeDifference::Backwards {
            amount: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
}

public data SystemTimeResult [copy] {
    case Overflow;
    case Ok(time: SystemTime);
}

// time + duration; `Overflow` past i64::MAX seconds. The signed overflow
// detection runs in BIASED u64 space: adding 2^63 (spelled `1 << 63` -- the
// raw literal is not blessed in operand position) maps the whole i64 range
// onto [0, 2^64) order-preserving, so "exceeds i64::MAX" becomes the plain
// unsigned wrapped-compare idiom, uniformly for duration seconds above
// i64::MAX too. The RESULT seconds compute in i64-domained Wrapping
// bit-arithmetic (probe-verified incl. above-i64::MAX operands).
public machine SystemTime::checked_add(time: &SystemTime, duration: Duration) -> SystemTimeResult {
    let nanoseconds_total: u32 = time.subsecond_nanoseconds + duration.subsecond_nanoseconds;
    let bias: u64 in Wrapping = (1 as u64 in Wrapping) << 63;
    let seconds_biased: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(time.seconds_since_unix_epoch) as u64 in Wrapping)
        + (bias as u64 in Wrapping);
    let sum_biased: u64 in Wrapping =
        (seconds_biased as u64 in Wrapping) + (duration.seconds as u64 in Wrapping);
    let add_wrapped: bool = sum_biased < seconds_biased;
    let seconds_sum: i64 in Wrapping =
        (time.seconds_since_unix_epoch as i64 in Wrapping)
        + (narrow_u64_to_i64_wrapping(duration.seconds) as i64 in Wrapping);
    transition nanoseconds_total >= 1000000000 {
        true -> wall_add_carried(nanoseconds_total, seconds_sum as i64, sum_biased as u64, add_wrapped)
        false -> wall_add_flat(nanoseconds_total, seconds_sum as i64, add_wrapped)
    }
    state wall_add_carried(nanoseconds_total: u32, seconds_sum: i64, sum_biased: u64, add_wrapped: bool) -> SystemTimeResult {
        let seconds_carried: i64 in Wrapping = (seconds_sum as i64 in Wrapping) + 1;
        let carried_biased: u64 in Wrapping = (sum_biased as u64 in Wrapping) + 1;
        let carry_wrapped: bool = carried_biased < sum_biased;
        let nanoseconds_reduced: u32 in Wrapping = (nanoseconds_total as u32 in Wrapping) - 1000000000;
        transition add_wrapped {
            true -> wall_add_overflow()
            false -> wall_add_carry_gate(nanoseconds_reduced as u32, seconds_carried as i64, carry_wrapped)
        }
    }
    state wall_add_carry_gate(nanoseconds_reduced: u32, seconds_carried: i64, carry_wrapped: bool) -> SystemTimeResult {
        transition carry_wrapped {
            true -> wall_add_overflow()
            false -> wall_add_emit(seconds_carried, nanoseconds_reduced)
        }
    }
    state wall_add_flat(nanoseconds_total: u32, seconds_sum: i64, add_wrapped: bool) -> SystemTimeResult {
        transition add_wrapped {
            true -> wall_add_overflow()
            false -> wall_add_emit(seconds_sum, nanoseconds_total)
        }
    }
    state wall_add_emit(seconds_final: i64, nanoseconds_final: u32) -> SystemTimeResult {
        SystemTimeResult::Ok {
            time: SystemTime {
                seconds_since_unix_epoch: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state wall_add_overflow() -> SystemTimeResult { SystemTimeResult::Overflow }
}

// time - duration; `Overflow` below i64::MIN seconds. Same biased-space
// idiom, subtraction direction: underflow iff the biased difference wrapped
// UPWARD (difference > minuend, unsigned).
public machine SystemTime::checked_subtract(time: &SystemTime, duration: Duration) -> SystemTimeResult {
    let nanoseconds_fit: bool = time.subsecond_nanoseconds >= duration.subsecond_nanoseconds;
    let bias: u64 in Wrapping = (1 as u64 in Wrapping) << 63;
    let seconds_biased: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(time.seconds_since_unix_epoch) as u64 in Wrapping)
        + (bias as u64 in Wrapping);
    let difference_biased: u64 in Wrapping =
        (seconds_biased as u64 in Wrapping) - (duration.seconds as u64 in Wrapping);
    let subtract_wrapped: bool = difference_biased > seconds_biased;
    let seconds_difference: i64 in Wrapping =
        (time.seconds_since_unix_epoch as i64 in Wrapping)
        - (narrow_u64_to_i64_wrapping(duration.seconds) as i64 in Wrapping);
    let nanoseconds_direct: u32 = ((time.subsecond_nanoseconds as u32 in Wrapping)
        - (duration.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (duration.subsecond_nanoseconds as u32 in Wrapping))
        + (time.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition nanoseconds_fit {
        true -> wall_sub_flat(seconds_difference as i64, subtract_wrapped, nanoseconds_direct)
        false -> wall_sub_borrowed(seconds_difference as i64, difference_biased as u64, subtract_wrapped, nanoseconds_borrowed)
    }
    state wall_sub_flat(seconds_difference: i64, subtract_wrapped: bool, nanoseconds_direct: u32) -> SystemTimeResult {
        transition subtract_wrapped {
            true -> wall_sub_overflow()
            false -> wall_sub_emit(seconds_difference, nanoseconds_direct)
        }
    }
    state wall_sub_borrowed(seconds_difference: i64, difference_biased: u64, subtract_wrapped: bool, nanoseconds_borrowed: u32) -> SystemTimeResult {
        let seconds_borrowed: i64 in Wrapping = (seconds_difference as i64 in Wrapping) - 1;
        let borrowed_biased: u64 in Wrapping = (difference_biased as u64 in Wrapping) - 1;
        let borrow_wrapped: bool = borrowed_biased > difference_biased;
        transition subtract_wrapped {
            true -> wall_sub_overflow()
            false -> wall_sub_borrow_gate(seconds_borrowed as i64, borrow_wrapped, nanoseconds_borrowed)
        }
    }
    state wall_sub_borrow_gate(seconds_borrowed: i64, borrow_wrapped: bool, nanoseconds_borrowed: u32) -> SystemTimeResult {
        transition borrow_wrapped {
            true -> wall_sub_overflow()
            false -> wall_sub_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state wall_sub_emit(seconds_final: i64, nanoseconds_final: u32) -> SystemTimeResult {
        SystemTimeResult::Ok {
            time: SystemTime {
                seconds_since_unix_epoch: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state wall_sub_overflow() -> SystemTimeResult { SystemTimeResult::Overflow }
}

// time + duration, clamping at SystemTime::MAX instead of reporting
// overflow (total). Mirrors Duration::saturating_add.
public machine SystemTime::saturating_add(time: &SystemTime, duration: Duration) -> SystemTime {
    let sum: SystemTimeResult = SystemTime::checked_add(time, duration);
    transition sum {
        SystemTimeResult::Ok { time } -> saturate_add_value(time)
        SystemTimeResult::Overflow -> saturate_add_max()
    }
    state saturate_add_value(time: SystemTime) -> SystemTime { time }
    state saturate_add_max() -> SystemTime { SystemTime::MAX }
}

// time - duration, clamping at SystemTime::MIN instead of reporting
// underflow (total; wall time is signed, so the floor is i64::MIN seconds,
// not the epoch). Mirrors Duration::saturating_subtract.
public machine SystemTime::saturating_subtract(time: &SystemTime, duration: Duration) -> SystemTime {
    let difference: SystemTimeResult = SystemTime::checked_subtract(time, duration);
    transition difference {
        SystemTimeResult::Ok { time } -> saturate_value(time)
        SystemTimeResult::Overflow -> saturate_min()
    }
    state saturate_value(time: SystemTime) -> SystemTime { time }
    state saturate_min() -> SystemTime { SystemTime::MIN }
}


// The clock-read CAPABILITY (D9): reads live here, never ambiently on the
// value types -- Rust's `Instant::now()`/`Instant::elapsed()` intentionally
// have no equivalent (the Cathedral no-ambient-authority stance).
public data Time { }

// Read the monotonic clock and normalize ONCE (D6): raw ticks + calibration
// in, (seconds, subsecond_nanoseconds) out. All conversion math lives here,
// per D11 -- the lowering layer only delivers raw u64s.
//
// The `clamp` IS the calibration guard (O2's proof bound, D5): frequency in
// [1, 18_446_744_073] proves the divisor nonzero AND that
// `remainder * 1_000_000_000` fits u64 (remainder < frequency). Every real
// host passes through unchanged (windows QPF 10^7 or 10^6-ish, POSIX 10^9,
// the interpreter's virtual 1000); a host reporting 0 or an absurd frequency
// measures degraded instead of faulting. Re-read per call: Time stays
// stateless (no capture-once field machinery) until a profile says otherwise.
public machine Time::now(time: &mut Time) -> Instant
reaches
    TimeHost
invokes
    TimeHost;
{
    let ticks: u64 = TimeHost::monotonic_ticks();
    let frequency_raw: u64 = TimeHost::monotonic_ticks_per_second();
    let frequency: u64 = clamp_u64(frequency_raw, 1, 18446744073);
    let whole_seconds: u64 = ticks / frequency;
    let remainder: u64 = ticks % frequency;
    // Fits u64 by the clamp bound, but the interval fold cannot multiply
    // variable bounds -- Wrapping spelling (the checked_multiply idiom).
    let scaled_wrapped: u64 in Wrapping = (remainder as u64 in Wrapping) * 1000000000;
    let scaled: u64 = scaled_wrapped as u64;
    let subnanos_wide: u64 = scaled / frequency;
    // The remainder's initializer fact survives narrowing and establishes
    // Instant's normalization predicate; the quotient is already < 10^9.
    let subsecond: u32 = (subnanos_wide % 1000000000) as u32;
    Instant { seconds: whole_seconds, subsecond_nanoseconds: subsecond }
}

// Read the wall clock: ONE raw read (D11, no second-boundary tearing) +
// the two per-target calibration constants, all conversion math here.
// `unix = raw / units - offset`; the subtraction is a u64 wrapping let whose
// value is only USED on the after-epoch arm the dominating compare proves
// (the checked_subtract idiom); `% i64::MAX` establishes the bound for the
// i64 narrowing (real clocks sit ~1.7e9, the bound only tames the prover).
// A host clock before 1970 reads as UNIX_EPOCH (degraded, never faulting).
public machine Time::system_time_now(time: &mut Time) -> SystemTime
reaches
    TimeHost
invokes
    TimeHost;
{
    let raw: u64 = TimeHost::wall_clock_raw();
    let units_raw: u64 = TimeHost::wall_clock_units_per_second();
    let offset: u64 = TimeHost::wall_clock_epoch_offset_seconds();
    // The same clamp-as-calibration-guard as `now()` (D5 proof bound).
    let units: u64 = clamp_u64(units_raw, 1, 18446744073);
    let platform_seconds: u64 = raw / units;
    let remainder: u64 = raw % units;
    let scaled_wrapped: u64 in Wrapping = (remainder as u64 in Wrapping) * 1000000000;
    let scaled: u64 = scaled_wrapped as u64;
    let subnanos_wide: u64 = scaled / units;
    let subsecond: u32 = (subnanos_wide % 1000000000) as u32;
    let is_after_epoch: bool = platform_seconds >= offset;
    let unix_wrapped: u64 in Wrapping = (platform_seconds as u64 in Wrapping)
        - (offset as u64 in Wrapping);
    let unix_bounded: u64 =
        (unix_wrapped as u64) % 9223372036854775807;
    let unix_seconds: i64 = narrow_u64_to_i64_exact(unix_bounded);
    transition is_after_epoch {
        true -> wall_now_emit(unix_seconds, subsecond)
        false -> wall_now_before_epoch()
    }
    state wall_now_emit(unix_seconds: i64, subsecond: u32) -> SystemTime {
        SystemTime {
            seconds_since_unix_epoch: unix_seconds,
            subsecond_nanoseconds: subsecond % 1000000000,
        }
    }
    state wall_now_before_epoch() -> SystemTime { SystemTime::UNIX_EPOCH }
}

// The stopwatch read: monotonic-now minus `start`, saturating at ZERO (a
// start Instant from a different process/boot measures garbage; ZERO is the
// honest total answer). This body combines now()'s normalization with the
// checked_duration_since arithmetic.
// The clock capability is an explicit borrowed parameter; arithmetic states
// carry only the values they use, not the clock capability.
//
// Shares let names with `now()` deliberately: two same-named-let callees
// from one caller state pinned the cross-callee collision (both flavors now
// FIXED -- runtime_time_elapsed_since_exit is the live std tripwire).
public machine Time::elapsed_since(time: &mut Time, start: Instant) -> Duration
reaches
    TimeHost
invokes
    TimeHost;
{
    let ticks: u64 = TimeHost::monotonic_ticks();
    let frequency_raw: u64 = TimeHost::monotonic_ticks_per_second();
    let frequency: u64 = clamp_u64(frequency_raw, 1, 18446744073);
    let now_seconds: u64 = ticks / frequency;
    let remainder: u64 = ticks % frequency;
    let scaled_wrapped: u64 in Wrapping = (remainder as u64 in Wrapping) * 1000000000;
    let scaled: u64 = scaled_wrapped as u64;
    let subnanos_wide: u64 = scaled / frequency;
    let now_subsecond_wide: u64 =
        subnanos_wide % 1000000000;
    let now_subsecond: u32 = narrow_u64_to_u32_exact(now_subsecond_wide);
    let seconds_bigger: bool = now_seconds > start.seconds;
    let seconds_equal: bool = now_seconds == start.seconds;
    let nanoseconds_fit: bool = now_subsecond >= start.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping = (now_seconds as u64 in Wrapping)
        - (start.seconds as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    let nanoseconds_direct: u32 = ((now_subsecond as u32 in Wrapping)
        - (start.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (start.subsecond_nanoseconds as u32 in Wrapping))
        + (now_subsecond as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> elapsed_bigger(nanoseconds_fit, seconds_direct as u64, seconds_borrowed as u64, nanoseconds_direct, nanoseconds_borrowed)
        false -> elapsed_equal_or_less(seconds_equal, nanoseconds_fit, seconds_direct as u64, nanoseconds_direct)
    }
    state elapsed_bigger(nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> Duration {
        transition nanoseconds_fit {
            true -> elapsed_emit(seconds_direct, nanoseconds_direct)
            false -> elapsed_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state elapsed_equal_or_less(seconds_equal: bool, nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32) -> Duration {
        transition seconds_equal && nanoseconds_fit {
            true -> elapsed_emit(seconds_direct, nanoseconds_direct)
            false -> elapsed_backwards()
        }
    }
    state elapsed_emit(seconds_final: u64, nanoseconds_final: u32) -> Duration {
        Duration {
            seconds: seconds_final,
            subsecond_nanoseconds: nanoseconds_final % 1000000000,
        }
    }
    // A start Instant from a different process/boot can sit "ahead" of now:
    // saturate at ZERO (total, never faulting).
    state elapsed_backwards() -> Duration { Duration::ZERO }
}

// Sleep for (approximately, never less than the platform grants) the given
// duration, through the millisecond host op. ONE clamped chunk: durations
// above u32::MAX milliseconds (~49.7 days) saturate -- the clamped request
// is RETURNED so the caller can observe it. All-entry lets; the clamps
// carry the narrowing proofs (4294968 * 1000 + 999 just exceeds u32::MAX,
// hence the second clamp).
public machine Time::sleep_for(time: &mut Time, duration: Duration) -> u32
reaches
    TimeHost
invokes
    TimeHost;
blocks;
{
    let seconds_capped: u64 = clamp_u64(duration.seconds, 0, 4294968);
    let seconds_scaled: u64 in Wrapping = (seconds_capped as u64 in Wrapping) * 1000;
    let subsecond_milliseconds: u32 = duration.subsecond_nanoseconds / 1000000;
    let total_wide: u64 in Wrapping =
        (seconds_scaled as u64 in Wrapping)
        + (widen_u32_to_u64(subsecond_milliseconds) as u64 in Wrapping);
    let total: u64 = total_wide as u64;
    let capped: u64 = clamp_u64(total, 0, 4294967295);
    let milliseconds: u32 = narrow_u64_to_u32_exact(capped);
    block TimeHost::sleep(milliseconds);
    milliseconds
}
