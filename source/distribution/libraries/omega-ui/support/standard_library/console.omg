// Portable console surface exposed by the Omega standard library.
//
// This is the friendly app-facing API. Its implementation should eventually be
// proven Omega code over explicit host capabilities, not a direct OS binding.
//
// Each selected target contributes the irreducible native byte leaves and its
// provider default. Target filtering keeps exactly one implementation closure.
use targets::windows_x86_64::console_impl;
use targets::macos_arm64::console_impl;
use targets::macos_x86_64::console_impl;
use targets::linux_x86_64::console_impl;
use targets::linux_arm64::console_impl;

// The result of a byte-level stdin read. `Eof` is ORDINAL 0: a
// zero-initialized ByteRead IS end-of-input -- ZII, no magic sentinel
// (the byte result has no sentinel).
public data ByteRead {
    case Eof;
    case Byte(value: i32) where value >= 0 && value <= 255;
}

// Counts describe only the prefix written during this invocation. Invalid is
// the zero-initialized value, never a normal reader completion or an I/O error.
public data LineReadResult {
    case Invalid;
    case LineComplete(count: u64);
    case EndOfInput(count: u64);
    case Full(count: u64);
}

public boundary trait Console {
    machine write_line(text: &[u8])
    reaches
        Console;
    machine write(text: &[u8])
    reaches
        Console;
    // Fill the existing writable extent without resizing it. Preserve every
    // byte, including CR and the terminating LF; callers interpret the prefix.
    // Hosted input may occupy the worker while waiting and traps on a failed
    // host read, so callers acknowledge `block` and cover the `Trap` route.
    machine read_line(out_line: &mut [u8]) -> LineReadResult
    reaches
        Console
    blocks;
    crashes Trap;
    // Byte-level stdin/stdout (the settled universal console surface):
    // `read_byte` yields the next stdin byte as `ByteRead::Byte`, or
    // `ByteRead::Eof` at end-of-input; `write_byte` appends one byte to
    // stdout. Both interpreter and native providers implement these leaves;
    // the friendly text adapters below are shared checked Omega code.
    // `read_byte` honestly publishes the hosted wait/failure envelope.
    machine read_byte() -> ByteRead
    reaches
        Console
    blocks;
    crashes Trap;
    machine write_byte(byte: i32)
    reaches
        Console;
    machine exit_process(return_code: i32)
    reaches
        Console;
}

// Storage for target-default declarations and the namespace of the exact
// native leaves. This data declaration is not a whole-trait implementation.
public data ConsoleNativeProvider { }

// The selected implementation owns the complete Console map. Native leaves
// retain their exact target identities; shared adapters use ordinary calls.
public NativeConsole satisfies Console {
    machine write_line(text: &[u8]) reaches Console {
        console_write_bytes(text, true);
    }
    machine write(text: &[u8]) reaches Console {
        console_write_bytes(text, false);
    }
    machine read_line(out_line: &mut [u8]) -> LineReadResult
    reaches Console blocks; crashes Trap {
        block ConsoleNativeProvider::read_line(out_line)
    }
    machine read_byte() -> ByteRead
    reaches Console blocks; crashes Trap {
        block ConsoleNativeProvider::read_byte()
    }
    machine write_byte(byte: i32) reaches Console {
        ConsoleNativeProvider::write_byte(byte);
    }
    machine exit_process(return_code: i32) reaches Console {
        ConsoleNativeProvider::exit_process(return_code);
    }
}

// Shared bounded input uses this exact provider's byte leaf, not recursive
// service redispatch. Check capacity before reading: Full consumes no lookahead
// and an empty destination returns Full(0). LF in the last slot still completes
// the line. Finite storage does not promise a bound on waiting for host input.
machine ConsoleNativeProvider::read_line(out_line: &mut [u8]) -> LineReadResult
satisfies Console::read_line
reaches Console {
    transition { _ -> scan(out_line, 0) }
    state scan(out_line: &mut [u8], position: u64) -> LineReadResult {
        transition position < out_line.len {
            true -> read(out_line, position, position + 1)
            false -> full(position)
        }
    }
    state read(out_line: &mut [u8], position: u64, next: u64) -> LineReadResult {
        let observed: ByteRead = block ConsoleNativeProvider::read_byte();
        transition observed {
            ByteRead::Byte { value } -> store(out_line, position, next, value)
            ByteRead::Eof -> end(position)
        }
    }
    state store(out_line: &mut [u8], position: u64, next: u64, value: i32) -> LineReadResult
    requires value >= 0 && value <= 255
    {
        out_line[position] = value as u8;
        transition value == 10 {
            true -> complete(next)
            false -> scan(out_line, next)
        }
    }
    state full(count: u64) -> LineReadResult { LineReadResult::Full { count: count } }
    state end(count: u64) -> LineReadResult { LineReadResult::EndOfInput { count: count } }
    state complete(count: u64) -> LineReadResult { LineReadResult::LineComplete { count: count } }
}

// Friendly output is checked Omega code over the byte-level boundary leaf.
// The writer belongs to this concrete provider closure and calls its byte leaf
// directly; it does not receive or manufacture a separate service authority.
// The private writer walks a borrowed byte view as one measured state
// loop. Each guarded edge stages the head byte and tail slice; the loop state's
// body performs the byte effect only after that edge was selected.
machine console_write_bytes(bytes: &[u8], newline: bool)
terminates by bytes -> Slice::Length;
reaches
    Console
{
    transition bytes.len > 0 {
        true -> emit(bytes[0], bytes[1..], newline)
        false -> finish(newline)
    }

    state emit(byte: u8, bytes: &[u8], newline: bool) {
        let mut output: u8 = byte;
        ConsoleNativeProvider::write_byte(output as i32);
        transition bytes.len > 0 {
            true -> emit(bytes[0], bytes[1..], newline)
            false -> finish(newline)
        }
    }

    state finish(newline: bool) {
        transition newline {
            true -> emit_newline(10)
            false -> done()
        }
    }

    state emit_newline(byte: u8) {
        let mut output: u8 = byte;
        ConsoleNativeProvider::write_byte(output as i32);
    }

    state done() { }
}
