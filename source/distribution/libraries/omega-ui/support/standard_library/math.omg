// Standard-library numeric helpers with explicit carrier names.
//
// Fixed integers retain Exact arithmetic and ordinary bounds contracts. Floats
// retain their selected core meaning, including operand-order-dependent NaNs,
// signed zeros and nearest-even square root; these names have no compiler role.

use omega::language::core::float_operations;

// Fixed-width integer helpers use Exact arithmetic. Signed absolute value
// excludes the unrepresentable minimum; clamp rejects inverted bounds. The
// piecewise guarantees and bounds are ordinary facts available to callers.

public machine min_i8(left: i8, right: i8) -> i8
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right))
{
    transition { left < right -> (left) _ -> (right) }
}

public machine max_i8(left: i8, right: i8) -> i8
ensures result >= left && result >= right &&
    ((left > right && result == left) || (left <= right && result == right))
{
    transition { left > right -> (left) _ -> (right) }
}

public machine clamp_i8(value: i8, lower: i8, upper: i8) -> i8
requires lower <= upper
ensures result >= lower && result <= upper &&
    ((value < lower && result == lower) ||
     (value > upper && result == upper) ||
     (value >= lower && value <= upper && result == value))
{
    transition {
        value < lower -> (lower)
        value > upper -> (upper)
        _ -> (value)
    }
}

public machine abs_i8(value: i8) -> i8
requires value > -128
ensures result >= 0 &&
    ((value < 0 && result == 0 - value) || (value >= 0 && result == value))
{
    transition { value < 0 -> (0 - value) _ -> (value) }
}

