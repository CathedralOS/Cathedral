// Float min/max retain the selected core meanings: the second operand wins
// equality and unordered comparison. Clamp composes those operations, so a
// NaN value selects lower, while unordered bounds fail its precondition.

public machine min_f32(left: f32, right: f32) -> f32
ensures F32::meaning(result) == FloatSemantics::minimum(
    F32::meaning(left), F32::meaning(right))
{
    F32::minimum(left, right)
}

public machine max_f32(left: f32, right: f32) -> f32
ensures F32::meaning(result) == FloatSemantics::maximum(
    F32::meaning(left), F32::meaning(right))
{
    F32::maximum(left, right)
}

public machine clamp_f32(value: f32, lower: f32, upper: f32) -> f32
requires lower <= upper
ensures F32::meaning(result) == FloatSemantics::minimum(
    FloatSemantics::maximum(F32::meaning(value), F32::meaning(lower)),
    F32::meaning(upper))
{
    F32::minimum(F32::maximum(value, lower), upper)
}

public machine sqrt_f32(value: f32) -> f32
ensures F32::meaning(result) == FloatSemantics::square_root(
    FloatFormat::BINARY32, F32::meaning(value))
{
    F32::square_root(value)
}

public machine abs_f32(value: f32) -> f32
ensures
    (value == 0.0 && F32::meaning(result) == F32::meaning(0.0)) ||
    (value < 0.0 && F32::meaning(result) == FloatSemantics::negate(FloatFormat::BINARY32, F32::meaning(value))) ||
    (value != 0.0 && !(value < 0.0) && F32::meaning(result) == F32::meaning(value))
{
    transition {
        value == 0.0 -> (0.0)
        value < 0.0 -> (F32::negate(value))
        _ -> (value)
    }
}

public machine min_f64(left: f64, right: f64) -> f64
ensures F64::meaning(result) == FloatSemantics::minimum(
    F64::meaning(left), F64::meaning(right))
{
    F64::minimum(left, right)
}

public machine max_f64(left: f64, right: f64) -> f64
ensures F64::meaning(result) == FloatSemantics::maximum(
    F64::meaning(left), F64::meaning(right))
{
    F64::maximum(left, right)
}

public machine clamp_f64(value: f64, lower: f64, upper: f64) -> f64
requires lower <= upper
ensures F64::meaning(result) == FloatSemantics::minimum(
    FloatSemantics::maximum(F64::meaning(value), F64::meaning(lower)),
    F64::meaning(upper))
{
    F64::minimum(F64::maximum(value, lower), upper)
}

// Quiet binary64 square root: nearest-even in binary64, preserving signed
// zero and positive infinity; negative inputs and NaNs produce NaN. The
// selected ordinary boundary operator owns this meaning on every target.
public machine sqrt_f64(value: f64) -> f64
ensures F64::meaning(result) == FloatSemantics::square_root(
    FloatFormat::BINARY64, F64::meaning(value))
{
    F64::square_root(value)
}

// Both zeros become positive zero. Negative nonzero values are negated;
// positive values and NaNs are returned unchanged, retaining NaN payloads.
public machine abs_f64(value: f64) -> f64
ensures
    (value == 0.0 && F64::meaning(result) == F64::meaning(0.0)) ||
    (value < 0.0 && F64::meaning(result) == FloatSemantics::negate(FloatFormat::BINARY64, F64::meaning(value))) ||
    (value != 0.0 && !(value < 0.0) && F64::meaning(result) == F64::meaning(value))
{
    transition {
        value == 0.0 -> (0.0)
        value < 0.0 -> (F64::negate(value))
        _ -> (value)
    }
}

// Sine/cosine use the same ordinary IEEE operation sequence on both engines.
// Shape: a binary-ladder range reduction into [-pi, pi] (conditional
// subtraction of 2pi * 2^k -- pure compares and subtracts, no
// float-to-int cast, which is still owner-gated), a quadrant fold into
// [-pi/2, pi/2], then a degree-17 Taylor polynomial in Horner form.
// Accuracy: ~5e-14 polynomial error at |x| = pi/2; the ladder serves |x| up to
// ~6.7e7 (2pi * 2^24) with reduction error growing as |x| does. Large
// arguments and sub-ulp accuracy are the recorded follow-on (Cody-Waite
// double-double constants ride the same shape).

public machine sin(x: f64) -> f64 {
    transition { _ -> reduce(x, 16777216.0) }

    // Ladder: subtract 2pi * k, halving k, until x lands in [-pi, pi].
    // Guard subjects materialize into slotted locals first (the guard
    // encoder compares places, not computed expressions).
    state reduce(x: f64, k: f64) {
        let mut hi: f64 = 3.14159265358979312;
        hi = hi * k;
        let mut lo: f64 = 0.0;
        lo = lo - hi;
        let mut step: f64 = 6.28318530717958623;
        step = step * k;
        transition {
            k < 1.0 -> fold(x)
            x > hi -> reduce(x - step, k)
            x < lo -> reduce(x + step, k)
            _ -> reduce(x, k * 0.5)
        }
    }

    // Quadrant fold: sin(x) = sin(pi - x) on (pi/2, pi]; mirrored below.
    state fold(x: f64) {
        transition {
            x > 1.57079632679489656 -> poly(3.14159265358979312 - x)
            x < 0.0 - 1.57079632679489656 -> poly(0.0 - 3.14159265358979312 - x)
            _ -> poly(x)
        }
    }

    // Degree-17 Taylor in Horner form over x*x. The accumulator is
    // `let mut`: plain lets BIND-FOLD into their consumers, which would
    // rebuild the whole chain as one deeply nested expression and exhaust
    // the MVP encoders' small scratch pools -- a mut local is slotted, so
    // every step stays a two-op store.
    state poly(x: f64) {
        let xx: f64 = x * x;
        // The x^17 coefficient is exactly 1/17!, not ten times that value.
        // Endpoint error matters when repeated cos(0) butterfly factors accumulate.
        let mut p: f64 = 0.000000000000002811457254345520763198946;
        let mut term: f64 = xx * p;
        p = -0.00000000000076471637318198164759011320 + term;
        term = xx * p;
        p = 0.00000000016059043836821614599392377170 + term;
        term = xx * p;
        p = -0.00000002505210838544171877505210838544 + term;
        term = xx * p;
        p = 0.00000275573192239858906525573192239859 + term;
        term = xx * p;
        p = -0.00019841269841269841269841269841269841 + term;
        term = xx * p;
        p = 0.00833333333333333333333333333333333333 + term;
        term = xx * p;
        p = -0.16666666666666666666666666666666666667 + term;
        let mut tail: f64 = x * xx;
        tail = tail * p;
        transition { _ -> (x + tail) }
    }
}

public machine cos(x: f64) -> f64 {
    // cos(x) = sin(x + pi/2); the shared reduction absorbs the shift. The
    // let-bound spelling is what a terminal call desugars to anyway (the
    // always-arm hoist, pass/calls/runtime_value_call_terminal_exit);
    // spelled explicitly here so the library reads as the served idiom.
    let s: f64 = sin(x + 1.57079632679489656);
    transition { _ -> (s) }
}

public machine is_finite(x: f64) -> bool {
    // Portable finiteness: x - x is 0.0 exactly when x is finite (inf - inf
    // and NaN - NaN are both NaN, and NaN compares unequal to everything).
    // No IEEE bit-classification enters the grammar -- the arithmetic IS the
    // spelling on both engines. The hoisted let keeps the guard subject a
    // slotted place (the guard encoder compares places, not computed
    // expressions), same as sin's ladder locals above. Exercised natively by
    // tests/omega/pass/float/runtime_std_is_finite_exit (finite/inf/NaN legs).
    let d: f64 = x - x;
    transition d == 0.0 { true -> yes() _ -> no() }
    state yes() -> bool { true }
    state no() -> bool { false }
}
