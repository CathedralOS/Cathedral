use omega::language::core::filesystem_authority;
// POSIX implementation state is local to an entered portable operation. Raw
// calls are static provider dependencies; no raw binding enters app data.
// Portable operations and directory traversal are shared. Target files own
// stat layouts, directory-record geometry, flags, errno translation and libc
// imports; only a target with that complete implementation installs defaults.
use filesystem;
use posix_filesystem_host;
use omega::language::core::layout;
use omega::language::core::numeric_conversion;
use targets::linux_x86_64::filesystem_impl;
use targets::linux_arm64::filesystem_impl;
use targets::macos_arm64::filesystem_impl;

data FilesystemProviderDefaults { }

// Native mode bits are decoded only inside the POSIX family. The portable
// metadata kind is not an alias for a POSIX permission or file-type bitfield.
machine posix_metadata_kind(mode: u32) -> FileKind {
    transition mode & 61440 {
        32768 -> FileKind::File
        16384 -> FileKind::Directory
        40960 -> FileKind::Symlink
        8192 -> FileKind::CharacterDevice
        24576 -> FileKind::BlockDevice
        4096 -> FileKind::Fifo
        49152 -> FileKind::Socket
        _ -> FileKind::Other
    }
}

FilesystemPosixProvider satisfies FilesystemService {
    machine create(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    {
        let mut context: PosixFilesystem;
        PosixFilesystem::create(&mut context, path)
    }

    machine create_new(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    {
        let mut context: PosixFilesystem;
        PosixFilesystem::create_new(&mut context, path)
    }

    machine open(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    {
        let mut context: PosixFilesystem;
        PosixFilesystem::open(&mut context, path)
    }

    machine append(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    {
        let mut context: PosixFilesystem;
        PosixFilesystem::append(&mut context, path)
