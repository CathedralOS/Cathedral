    machine write(file: File, bytes: &[u8]) -> IoResult
    reaches FilesystemContentWrite
    invokes PosixFilesystemHost;
    {
        let mut context: PosixFilesystem;
        PosixFilesystem::write(&mut context, file, bytes)
    }

    machine close(file: File) -> UnitResult

    invokes PosixFilesystemHost;
    {
        let mut context: PosixFilesystem;
        let result: i32 = PosixFilesystem::close(&mut context, file);
        transition result == 0 { true -> closed() false -> failed(result) }
        state closed() -> UnitResult { UnitResult::Ok }
        state failed(result: i32) -> UnitResult {
            let mut context: PosixFilesystem;
            let kind: ErrorKind = PosixFilesystem::last_error_i32(&mut context, result);
            UnitResult::Error { kind: kind }
        }
    }

    machine write_all(path: &[u8] in Path, bytes: &[u8]) -> UnitResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    {
        let mut context: PosixFilesystem;
        PosixFilesystem::write_all(&mut context, path, bytes)
