data PosixDirectoryKind [copy] {
    case Other;
    case Directory;
    case Regular;
}

data PosixFilesystem
where open_writable >= 0 && open_writable <= 1,
    open_readable >= 0 && open_readable <= 1,
    open_creating >= 0 && open_creating <= 1
{
    dir_mode: i32;
    read_flags: i32;

    open_flags: i32;

    open_options: OpenOptions;

    open_writable: i32;
    open_readable: i32;
    open_creating: i32;

    file_fd: i32;

    stat_buf: [u8; 144];

    times_buf: [u8; 32];

    walk_rc: i32;

    mkall_scratch: [u8; 256];

    stat_rc: i32;

    stat_errno: i32;

    lock_errno: i32;

    err_code: i32;
    err_kind: ErrorKind;

    dir_buf: [u8; 512];
    directory_descriptor: i32;
    rd_off: u64 in Wrapping;
    rd_total: u64 in Wrapping;
    rd_count: i32 in Wrapping;
    rd_position: i64;
    rd_idx: u64 in Wrapping;
    rd_lo: u8;
    rd_hi: u8;
    rd_lou: u64 in Wrapping;
    rd_hiu: u64 in Wrapping;
    rd_reclen: u64 in Wrapping;

    rd_dtype: u8;

    rd_recno: u64 in Wrapping;
    rd_target: u64 in Wrapping;
    rd_j: u64 in Wrapping;
    rd_ridx: u64 in Wrapping;
    rd_nb: u8;
    entry_name: [u8; 256];

    rdn_result: DirEntryResult;
    rda_sub: i32;
    rda_rc: i32;

    rda_stack: [i32; 16];
    rda_depth: u64;
    rda_fd: i32;

    rda_verdict: i32;

    rda_close_rc: i32;

    rd_seek_rc: i64;

    mkall_byte: u8;

}

machine PosixFilesystem::creation_open_options() -> OpenOptions {
    (OpenOptions { read: false, write: true, append: false, truncate: true, create: true, create_new: false })
}

machine PosixFilesystem::empty_open_options() -> OpenOptions {
    (OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false })
}

machine PosixFilesystem::create(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    filesystem.open_options = PosixFilesystem::creation_open_options();
    PosixFilesystem::encode_open_options(filesystem);

    let fd: i32 = PosixFilesystemHost::open_create(path, filesystem.open_flags, 438);
    transition fd >= 0 { true -> ok(fd) _ -> err(filesystem, fd) }
    state ok(fd: i32) -> OpenResult { OpenResult::Ok { file: PosixFilesystem::file(fd) } }
    state err(filesystem: &mut PosixFilesystem, fd: i32) -> OpenResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, fd); OpenResult::Error { kind: kind } }
}

machine PosixFilesystem::create_new(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    filesystem.open_options = OpenOptions {
        read: true,
        write: true,
        append: false,
        truncate: false,
        create: false,
        create_new: true,
    };
    PosixFilesystem::encode_open_options(filesystem);
    let fd: i32 = PosixFilesystemHost::open_create(path, filesystem.open_flags, 438);
    transition fd >= 0 { true -> ok(filesystem, fd) _ -> err(filesystem, fd) }
    state ok(filesystem: &mut PosixFilesystem, fd: i32) -> OpenResult { OpenResult::Ok { file: PosixFilesystem::file(fd) } }
    state err(filesystem: &mut PosixFilesystem, fd: i32) -> OpenResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, fd); OpenResult::Error { kind: kind } }
}

machine PosixFilesystem::open(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    filesystem.open_options = PosixFilesystem::empty_open_options();
    PosixFilesystem::encode_open_options(filesystem);
    filesystem.read_flags = filesystem.open_flags;
    let fd: i32 = PosixFilesystemHost::open(path, filesystem.read_flags);
    transition fd >= 0 { true -> ok(fd) _ -> err(filesystem, fd) }
    state ok(fd: i32) -> OpenResult { OpenResult::Ok { file: PosixFilesystem::file(fd) } }
    state err(filesystem: &mut PosixFilesystem, fd: i32) -> OpenResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, fd); OpenResult::Error { kind: kind } }
}

machine PosixFilesystem::append(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    filesystem.open_options = OpenOptions {
        read: false,
        write: false,
        append: true,
        truncate: false,
        create: false,
        create_new: false,
    };
    PosixFilesystem::encode_open_options(filesystem);
    let fd: i32 = PosixFilesystemHost::open(path, filesystem.open_flags);
    transition fd >= 0 { true -> ok(filesystem, fd) _ -> err(filesystem, fd) }
    state ok(filesystem: &mut PosixFilesystem, fd: i32) -> OpenResult { OpenResult::Ok { file: PosixFilesystem::file(fd) } }
    state err(filesystem: &mut PosixFilesystem, fd: i32) -> OpenResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, fd); OpenResult::Error { kind: kind } }
}

machine PosixFilesystem::read(filesystem: &mut PosixFilesystem, file: File, buffer: &mut [u8], count: u64) -> IoResult
reaches FilesystemContentRead

invokes
    PosixFilesystemHost;
{
    filesystem.file_fd = PosixFilesystem::descriptor(file);
    let n: i64 = PosixFilesystemHost::read(filesystem.file_fd, buffer, count);
    transition n >= 0 { true -> ok(n) _ -> err(filesystem, n) }
    state ok(n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(filesystem: &mut PosixFilesystem, n: i64) -> IoResult { let kind: ErrorKind = PosixFilesystem::last_error_i64(filesystem, n); IoResult::Error { kind: kind } }
}

machine PosixFilesystem::write(filesystem: &mut PosixFilesystem, file: File, bytes: &[u8]) -> IoResult
reaches FilesystemContentWrite

invokes
    PosixFilesystemHost;
{
    filesystem.file_fd = PosixFilesystem::descriptor(file);
    let n: i64 = PosixFilesystemHost::write(filesystem.file_fd, bytes);
    transition n >= 0 { true -> ok(n) _ -> err(filesystem, n) }
    state ok(n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(filesystem: &mut PosixFilesystem, n: i64) -> IoResult { let kind: ErrorKind = PosixFilesystem::last_error_i64(filesystem, n); IoResult::Error { kind: kind } }
}

machine PosixFilesystem::close(filesystem: &mut PosixFilesystem, file: File) -> i32

invokes
    PosixFilesystemHost;
{
    filesystem.file_fd = PosixFilesystem::descriptor(file);
    let rc: i32 = PosixFilesystemHost::close(filesystem.file_fd);
    rc
}

// Complete a checked byte view, preserving the OS error and refusing zero
// progress. A short successful write advances the same original backing.
machine PosixFilesystem::write_descriptor(filesystem: &mut PosixFilesystem, descriptor: i32, bytes: &[u8]) -> UnitResult
reaches FilesystemContentWrite
invokes PosixFilesystemHost;
{
    transition { _ -> remaining(filesystem, descriptor, bytes, 0) }
    state remaining(filesystem: &mut PosixFilesystem, descriptor: i32, bytes: &[u8], position: u64) -> UnitResult
    requires position <= bytes.len;
    {
        transition position < bytes.len {
            true -> write(filesystem, descriptor, bytes, position)
            false -> complete()
        }
    }
    state write(filesystem: &mut PosixFilesystem, descriptor: i32, bytes: &[u8], position: u64) -> UnitResult
    requires position < bytes.len;
    {
        let count: i64 = PosixFilesystemHost::write(descriptor, bytes[position..bytes.len]);
        transition count > 0 {
            true -> progressed(filesystem, descriptor, bytes, position, count)
            false -> stalled(filesystem, descriptor, bytes, position, count)
        }
    }
    state progressed(filesystem: &mut PosixFilesystem, descriptor: i32, bytes: &[u8], position: u64, count: i64) -> UnitResult
    requires position <= bytes.len, count > 0;
    {
        let written: u64 = narrow_i64_to_u64_exact(count);
        transition written <= bytes.len - position {
            true -> remaining(filesystem, descriptor, bytes, position + written)
            false -> invalid()
        }
    }
    state stalled(filesystem: &mut PosixFilesystem, descriptor: i32, bytes: &[u8], position: u64, count: i64) -> UnitResult
    requires position <= bytes.len;
    {
        transition count == -4 {
            true -> remaining(filesystem, descriptor, bytes, position)
            false -> failure(filesystem, count)
        }
    }
    state failure(filesystem: &mut PosixFilesystem, count: i64) -> UnitResult {
        transition count == 0 { true -> zero_progress() false -> failed(filesystem, count) }
    }
    state failed(filesystem: &mut PosixFilesystem, count: i64) -> UnitResult {
        let kind: ErrorKind = PosixFilesystem::last_error_i64(filesystem, count);
        UnitResult::Error { kind: kind }
    }
    state zero_progress() -> UnitResult { UnitResult::Error { kind: ErrorKind::WriteZero } }
    state invalid() -> UnitResult { UnitResult::Error { kind: ErrorKind::Other } }
    state complete() -> UnitResult { UnitResult::Ok }
}

machine PosixFilesystem::write_all(filesystem: &mut PosixFilesystem, path: &[u8] in Path, bytes: &[u8]) -> UnitResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes PosixFilesystemHost;
{
    filesystem.open_options = PosixFilesystem::creation_open_options();
    PosixFilesystem::encode_open_options(filesystem);
    let descriptor: i32 = PosixFilesystemHost::open_create(path, filesystem.open_flags, 438);
    transition descriptor >= 0 { true -> opened(filesystem, descriptor, bytes) false -> open_failed(filesystem, descriptor) }
    state opened(filesystem: &mut PosixFilesystem, descriptor: i32, bytes: &[u8]) -> UnitResult {
        let outcome: UnitResult = PosixFilesystem::write_descriptor(filesystem, descriptor, bytes);
        let closed: i32 = PosixFilesystemHost::close(descriptor);
        transition outcome {
            UnitResult::Ok -> close_result(filesystem, closed)
            UnitResult::Error { kind } -> failed(kind)
        }
    }
    state close_result(filesystem: &mut PosixFilesystem, result: i32) -> UnitResult {
        transition result == 0 { true -> complete() false -> open_failed(filesystem, result) }
    }
    state open_failed(filesystem: &mut PosixFilesystem, result: i32) -> UnitResult {
        let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, result);
        UnitResult::Error { kind: kind }
    }
    state failed(kind: ErrorKind) -> UnitResult { UnitResult::Error { kind: kind } }
    state complete() -> UnitResult { UnitResult::Ok }
}

machine PosixFilesystem::read_all(filesystem: &mut PosixFilesystem, path: &[u8] in Path, buffer: &mut [u8], count: u64) -> IoResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes PosixFilesystemHost;
{
    filesystem.open_options = PosixFilesystem::empty_open_options();
    PosixFilesystem::encode_open_options(filesystem);
    let descriptor: i32 = PosixFilesystemHost::open(path, filesystem.open_flags);
    transition descriptor >= 0 { true -> opened(filesystem, descriptor, buffer, count) false -> failed_open(filesystem, descriptor) }
    state opened(filesystem: &mut PosixFilesystem, descriptor: i32, buffer: &mut [u8], count: u64) -> IoResult {
        let received: i64 = PosixFilesystemHost::read(descriptor, buffer, count);
        let closed: i32 = PosixFilesystemHost::close(descriptor);
        transition received >= 0 { true -> read_result(filesystem, received, closed) false -> read_failed(filesystem, received) }
    }
    state read_result(filesystem: &mut PosixFilesystem, received: i64, closed: i32) -> IoResult
    requires received >= 0;
    {
        transition closed == 0 { true -> complete(received) false -> failed_open(filesystem, closed) }
    }
    state complete(received: i64) -> IoResult requires received >= 0; {
        let count: u64 = narrow_i64_to_u64_exact(received);
        IoResult::Ok { count: count }
    }
    state failed_open(filesystem: &mut PosixFilesystem, result: i32) -> IoResult {
        let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, result);
        IoResult::Error { kind: kind }
    }
    state read_failed(filesystem: &mut PosixFilesystem, result: i64) -> IoResult {
        let kind: ErrorKind = PosixFilesystem::last_error_i64(filesystem, result);
        IoResult::Error { kind: kind }
    }
}

// Preserve the existing bounded-copy contract: cap is the maximum prefix.
// Only initialized bytes cross the destination seam. Opening, metadata,
// writing, permission restoration and release each retain their own failure.
machine PosixFilesystem::copy(filesystem: &mut PosixFilesystem, from: &[u8] in Path, to: &[u8] in Path, buffer: &mut [u8], cap: u64) -> IoResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery
invokes PosixFilesystemHost;
{
    filesystem.open_options = PosixFilesystem::empty_open_options();
    PosixFilesystem::encode_open_options(filesystem);
    let source: i32 = PosixFilesystemHost::open(from, filesystem.open_flags);
    transition source >= 0 { true -> metadata(filesystem, source, to, buffer, cap) false -> failed_open(filesystem, source) }
    state metadata(filesystem: &mut PosixFilesystem, source: i32, to: &[u8] in Path, buffer: &mut [u8], cap: u64) -> IoResult {
        let result: i32 = PosixFilesystemHost::read_file_metadata(source, &mut filesystem.stat_buf);
        transition result == 0 { true -> read(filesystem, source, to, buffer, cap) false -> metadata_failed(filesystem, source, result) }
    }
    state metadata_failed(filesystem: &mut PosixFilesystem, source: i32, result: i32) -> IoResult {
        let closed: i32 = PosixFilesystemHost::close(source);
        let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, result);
        IoResult::Error { kind: kind }
    }
    state read(filesystem: &mut PosixFilesystem, source: i32, to: &[u8] in Path, buffer: &mut [u8], cap: u64) -> IoResult {
        let result: MetadataResult = PosixFilesystem::decode_metadata(filesystem);
        transition result {
            MetadataResult::Ok { meta } -> read_contents(filesystem, source, to, buffer, cap, meta)
            MetadataResult::Error { kind } -> invalid_metadata(source, kind)
        }
    }
    state invalid_metadata(source: i32, kind: ErrorKind) -> IoResult {
        let closed: i32 = PosixFilesystemHost::close(source);
        IoResult::Error { kind: kind }
    }
    state read_contents(filesystem: &mut PosixFilesystem, source: i32, to: &[u8] in Path, buffer: &mut [u8], cap: u64, metadata: Metadata) -> IoResult {
        transition metadata.posix {
            PosixMetadataResult::Ok { details } -> read_permissioned(filesystem, source, to, buffer, cap, details.mode & 511)
            PosixMetadataResult::Error { kind } -> invalid_metadata(source, kind)
        }
    }
    state read_permissioned(filesystem: &mut PosixFilesystem, source: i32, to: &[u8] in Path, buffer: &mut [u8], cap: u64, mode: u32) -> IoResult {
        let count: i64 = PosixFilesystemHost::read(source, buffer, cap);
        let closed: i32 = PosixFilesystemHost::close(source);
        transition count >= 0 { true -> read_result(filesystem, to, buffer, count, mode, closed) false -> read_failed(filesystem, count) }
    }
    state read_result(filesystem: &mut PosixFilesystem, to: &[u8] in Path, buffer: &mut [u8], count: i64, mode: u32, closed: i32) -> IoResult
    requires count >= 0;
    {
        transition closed == 0 { true -> bounded(filesystem, to, buffer, count, mode) false -> failed_open(filesystem, closed) }
    }
    state bounded(filesystem: &mut PosixFilesystem, to: &[u8] in Path, buffer: &mut [u8], count: i64, mode: u32) -> IoResult
    requires count >= 0;
    {
        let received: u64 = narrow_i64_to_u64_exact(count);
        transition received <= buffer.len { true -> destination(filesystem, to, buffer, received, mode) false -> invalid() }
    }
    state destination(filesystem: &mut PosixFilesystem, to: &[u8] in Path, buffer: &mut [u8], count: u64, mode: u32) -> IoResult
    requires count <= buffer.len;
    {
        filesystem.open_options = PosixFilesystem::creation_open_options();
        PosixFilesystem::encode_open_options(filesystem);
        let descriptor: i32 = PosixFilesystemHost::open_create(to, filesystem.open_flags, 438);
        transition descriptor >= 0 { true -> write(filesystem, descriptor, buffer, count, mode) false -> failed_open(filesystem, descriptor) }
    }
    state write(filesystem: &mut PosixFilesystem, descriptor: i32, buffer: &mut [u8], count: u64, mode: u32) -> IoResult
    requires count <= buffer.len;
    {
        let outcome: UnitResult = PosixFilesystem::write_descriptor(filesystem, descriptor, buffer[0..count]);
        transition outcome { UnitResult::Ok -> permissions(filesystem, descriptor, count, mode) UnitResult::Error { kind } -> write_failed(descriptor, kind) }
    }
    state permissions(filesystem: &mut PosixFilesystem, descriptor: i32, count: u64, mode: u32) -> IoResult {
        let changed: i32 = PosixFilesystemHost::set_file_permissions(descriptor, mode);
        let closed: i32 = PosixFilesystemHost::close(descriptor);
        transition changed == 0 { true -> close_result(filesystem, count, closed) false -> failed_open(filesystem, changed) }
    }
    state close_result(filesystem: &mut PosixFilesystem, count: u64, closed: i32) -> IoResult {
        transition closed == 0 { true -> complete(count) false -> failed_open(filesystem, closed) }
    }
    state write_failed(descriptor: i32, kind: ErrorKind) -> IoResult {
        let closed: i32 = PosixFilesystemHost::close(descriptor);
        IoResult::Error { kind: kind }
    }
    state failed_open(filesystem: &mut PosixFilesystem, result: i32) -> IoResult {
        let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, result);
        IoResult::Error { kind: kind }
    }
    state read_failed(filesystem: &mut PosixFilesystem, result: i64) -> IoResult {
        let kind: ErrorKind = PosixFilesystem::last_error_i64(filesystem, result);
        IoResult::Error { kind: kind }
    }
    state invalid() -> IoResult { IoResult::Error { kind: ErrorKind::Other } }
    state complete(count: u64) -> IoResult { IoResult::Ok { count: count } }
}

machine PosixFilesystem::exists(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> bool
reaches FilesystemMetadataQuery

invokes
    PosixFilesystemHost;
{
    filesystem.stat_rc = PosixFilesystemHost::read_metadata(path, &mut filesystem.stat_buf);
    filesystem.stat_rc == 0
}

machine PosixFilesystem::try_exists(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> ExistsResult
reaches FilesystemMetadataQuery

invokes
    PosixFilesystemHost;
{

    filesystem.stat_rc = PosixFilesystemHost::read_metadata(path, &mut filesystem.stat_buf);
    let metadata_rc: i32 = filesystem.stat_rc;
    filesystem.stat_errno = PosixFilesystem::native_error_code_i32(filesystem, metadata_rc);
    transition filesystem.stat_rc == 0 { true -> present(filesystem) _ -> absent(filesystem) }
    state present(filesystem: &mut PosixFilesystem) -> ExistsResult { ExistsResult::Yes }
    state absent(filesystem: &mut PosixFilesystem) -> ExistsResult {
        transition filesystem.stat_errno == 2 { true -> no(filesystem) _ -> other(filesystem) }
    }
    state no(filesystem: &mut PosixFilesystem) -> ExistsResult { ExistsResult::No }
    state other(filesystem: &mut PosixFilesystem) -> ExistsResult { let metadata_rc: i32 = filesystem.stat_rc; let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, metadata_rc); ExistsResult::Error { kind: kind } }
}

machine PosixFilesystem::metadata_path(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> MetadataResult
reaches FilesystemMetadataQuery

invokes
    PosixFilesystemHost;
{
    let rc: i32 = PosixFilesystemHost::read_metadata(path, &mut filesystem.stat_buf);
    transition rc == 0 { true -> decode(filesystem) _ -> err(filesystem, rc) }
    state decode(filesystem: &mut PosixFilesystem) -> MetadataResult { PosixFilesystem::decode_metadata(filesystem) }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> MetadataResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); MetadataResult::Error { kind: kind } }
}

machine PosixFilesystem::symlink_metadata(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> MetadataResult
reaches FilesystemMetadataQuery

invokes
    PosixFilesystemHost;
{
    let rc: i32 = PosixFilesystemHost::read_symlink_metadata(path, &mut filesystem.stat_buf);
    transition rc == 0 { true -> decode(filesystem) _ -> err(filesystem, rc) }
    state decode(filesystem: &mut PosixFilesystem) -> MetadataResult { PosixFilesystem::decode_metadata(filesystem) }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> MetadataResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); MetadataResult::Error { kind: kind } }
}

machine PosixFilesystem::remove(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> UnitResult
reaches FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    let rc: i32 = PosixFilesystemHost::remove(path);
    transition rc == 0 { true -> ok() _ -> err(filesystem, rc) }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); UnitResult::Error { kind: kind } }
}

// Raw POSIX providers return negative errno on every supported target.
// Preserve that code; each target maps its own errno catalog to portable kinds.
machine PosixFilesystem::native_error_code_i32(filesystem: &mut PosixFilesystem, result: i32) -> i32 {
    let code: i32 in Wrapping = (0 as i32 in Wrapping) - (result as i32 in Wrapping);
    filesystem.err_code = code as i32;
    filesystem.err_code
}
machine PosixFilesystem::native_error_code_i64(filesystem: &mut PosixFilesystem, result: i64) -> i32 {
    let code: i64 in Wrapping = (0 as i64 in Wrapping) - (result as i64 in Wrapping);
    filesystem.err_code = narrow_i64_to_i32_wrapping(code as i64);
    filesystem.err_code
}

machine PosixFilesystem::last_error_i32(filesystem: &mut PosixFilesystem, result: i32) -> ErrorKind {
    filesystem.err_code = PosixFilesystem::native_error_code_i32(filesystem, result);
    PosixFilesystem::kind_of_stored_error_code(filesystem)
}

machine PosixFilesystem::last_error_i64(filesystem: &mut PosixFilesystem, result: i64) -> ErrorKind {
    filesystem.err_code = PosixFilesystem::native_error_code_i64(filesystem, result);
    PosixFilesystem::kind_of_stored_error_code(filesystem)
}

machine PosixFilesystem::create_dir(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> UnitResult
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    filesystem.dir_mode = 493;
    let rc: i32 = PosixFilesystemHost::create_dir(path, filesystem.dir_mode);
    transition rc == 0 { true -> ok() _ -> err(filesystem, rc) }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); UnitResult::Error { kind: kind } }
}

machine PosixFilesystem::remove_dir(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> UnitResult
reaches FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    let rc: i32 = PosixFilesystemHost::remove_dir(path);
    transition rc == 0 { true -> ok() _ -> err(filesystem, rc) }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); UnitResult::Error { kind: kind } }
}

machine PosixFilesystem::create_dir_all(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> UnitResult
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    filesystem.dir_mode = 493;
    transition { _ -> PosixFilesystem::mkall_walk(filesystem, path, 1) }
}

machine PosixFilesystem::mkall_walk(filesystem: &mut PosixFilesystem, path: &[u8] in Path, i: u64) -> UnitResult
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation

terminates by (i, path.len) -> Nat::BoundedDistance;

{
    filesystem.walk_rc = PosixFilesystem::mkall_step(filesystem, path, i);
    transition i < path.len {
        true -> mkall_walk(filesystem, path, i + 1)
        false -> mkall_leaf(filesystem, path)
    }
    state mkall_leaf(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> UnitResult {
        let rc: i32 = PosixFilesystemHost::create_dir(path, filesystem.dir_mode);
        transition rc == 0 { true -> ok(filesystem) _ -> exists_ok(filesystem, rc) }
    }
    state ok(filesystem: &mut PosixFilesystem) -> UnitResult { UnitResult::Ok }
    state exists_ok(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult {

        let code: i32 = PosixFilesystem::native_error_code_i32(filesystem, rc);
        transition code == 17 { true -> ok(filesystem) _ -> mkall_error(filesystem, rc) }
    }
    state mkall_error(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult {
        let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc);
        UnitResult::Error { kind: kind }
    }
}

machine PosixFilesystem::mkall_step(filesystem: &mut PosixFilesystem, path: &[u8] in Path, i: u64) -> i32
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
 {
    transition i < path.len {
        true -> mkall_at(filesystem, path, i)
        false -> mkall_noop(filesystem)
    }
    state mkall_at(filesystem: &mut PosixFilesystem, path: &[u8] in Path, i: u64) -> i32 {
        transition path[i] == 47 {
            true -> mkall_mk(filesystem, path, i)
            false -> mkall_noop(filesystem)
        }
    }
    state mkall_mk(filesystem: &mut PosixFilesystem, path: &[u8] in Path, i: u64) -> i32 {

        transition i < 255 {
            true -> PosixFilesystem::mkall_copy(filesystem, path, i, 0)
            false -> mkall_noop(filesystem)
        }
    }
    state mkall_noop(filesystem: &mut PosixFilesystem) -> i32 { 0 }
}

machine PosixFilesystem::mkall_copy(filesystem: &mut PosixFilesystem, path: &[u8] in Path, i: u64, j: u64) -> i32
terminates by (j, i) -> Nat::BoundedDistance;
{
    PosixFilesystem::mkall_put(filesystem, path, i, j);
    transition j < i {
        true -> mkall_copy(filesystem, path, i, j + 1)
        false -> PosixFilesystem::mkall_issue(filesystem, i)
    }
}

machine PosixFilesystem::mkall_put(filesystem: &mut PosixFilesystem, path: &[u8] in Path, i: u64, j: u64) {
    transition j < i {
        true -> put_byte(filesystem, path, i, j)
        false -> put_nul(filesystem, j)
    }
    state put_byte(filesystem: &mut PosixFilesystem, path: &[u8] in Path, i: u64, j: u64) {
        transition j < path.len {
            true -> put_byte_bounded(filesystem, path, j)
            false -> put_done(filesystem)
        }
    }
    state put_byte_bounded(filesystem: &mut PosixFilesystem, path: &[u8] in Path, j: u64) {
        transition j < 255 {
            true -> put_byte_write(filesystem, path, j)
            false -> put_done(filesystem)
        }
    }
    state put_byte_write(filesystem: &mut PosixFilesystem, path: &[u8] in Path, j: u64) {

        filesystem.mkall_byte = path[j];
        filesystem.mkall_scratch[j] = filesystem.mkall_byte;
        transition { _ -> put_done(filesystem) }
    }
    state put_nul(filesystem: &mut PosixFilesystem, j: u64) {
        transition j < 255 {
            true -> put_nul_write(filesystem, j)
            false -> put_done(filesystem)
        }
    }
    state put_nul_write(filesystem: &mut PosixFilesystem, j: u64) {
        filesystem.mkall_scratch[j] = 0;
        transition { _ -> put_done(filesystem) }
    }
    state put_done(filesystem: &mut PosixFilesystem) { }
}

machine PosixFilesystem::mkall_issue(filesystem: &mut PosixFilesystem, i: u64) -> i32
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation

{
    transition i < 255 {
        true -> issue_mk(filesystem, i)
        false -> issue_skip(filesystem)
    }
    state issue_mk(filesystem: &mut PosixFilesystem, i: u64) -> i32 {

        let rc: i32 = PosixFilesystemHost::create_dir_name(filesystem.mkall_scratch[0..i], filesystem.dir_mode);
        rc
    }
    state issue_skip(filesystem: &mut PosixFilesystem) -> i32 { 0 }
}

machine PosixFilesystem::read_dir_is_empty(filesystem: &mut PosixFilesystem, path: &[u8] in Path) -> EmptyResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery

invokes
    PosixFilesystemHost;
{
    let first: DirEntryResult = PosixFilesystem::read_dir_nth(filesystem, path, 0);
    transition first {
        DirEntryResult::End -> rdie_empty(filesystem)
        DirEntryResult::Ok { entry } -> rdie_non(filesystem)
        DirEntryResult::Error { kind } -> rdie_err(filesystem, kind)
    }
    state rdie_empty(filesystem: &mut PosixFilesystem) -> EmptyResult { EmptyResult::Empty }
    state rdie_non(filesystem: &mut PosixFilesystem) -> EmptyResult { EmptyResult::NonEmpty }
    state rdie_err(filesystem: &mut PosixFilesystem, kind: ErrorKind) -> EmptyResult { EmptyResult::Error { kind: kind } }
}

machine PosixFilesystem::set_permissions(filesystem: &mut PosixFilesystem, path: &[u8] in Path, perms: Permissions) -> UnitResult
reaches FilesystemMetadataQuery + FilesystemMetadataMutation

invokes
    PosixFilesystemHost;
{
    transition perms {
        Permissions::Default -> apply(filesystem, path, 438)
        Permissions::Posix { mode } -> apply(filesystem, path, mode)
        Permissions::Readonly { value } -> inspect(filesystem, path, value)
    }
    // A portable read-only request changes only write bits of the live mode;
    // an exact POSIX request needs no preliminary query. The path-based query
    // and update are not atomic against concurrent replacement or mode changes.
    state inspect(filesystem: &mut PosixFilesystem, path: &[u8] in Path, readonly: bool) -> UnitResult {
        let result: i32 = PosixFilesystemHost::read_metadata(path, &mut filesystem.stat_buf);
        transition result == 0 { true -> derive(filesystem, path, readonly) false -> err(filesystem, result) }
    }
    state derive(filesystem: &mut PosixFilesystem, path: &[u8] in Path, readonly: bool) -> UnitResult {
        let existing: u32 = PosixFilesystem::permission_bits(filesystem);
        let requested: u32 = posix_mode_with_readonly(existing, readonly);
        transition { _ -> apply(filesystem, path, requested) }
    }
    state apply(filesystem: &mut PosixFilesystem, path: &[u8] in Path, mode: u32) -> UnitResult {
        let result: i32 = PosixFilesystemHost::set_permissions(path, mode);
        transition result == 0 { true -> ok() false -> err(filesystem, result) }
    }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); UnitResult::Error { kind: kind } }
}

machine PosixFilesystem::symlink(filesystem: &mut PosixFilesystem, target: &[u8] in Path, link: &[u8] in Path) -> UnitResult
reaches FilesystemNamespaceMutation

invokes
    PosixFilesystemHost;
{
    let rc: i32 = PosixFilesystemHost::symlink(target, link);
    transition rc == 0 { true -> ok(filesystem) _ -> err(filesystem, rc) }
    state ok(filesystem: &mut PosixFilesystem) -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); UnitResult::Error { kind: kind } }
}

machine PosixFilesystem::read_link(filesystem: &mut PosixFilesystem, path: &[u8] in Path, buffer: &mut [u8], count: u64) -> IoResult
reaches FilesystemMetadataQuery

invokes
    PosixFilesystemHost;
{
    let n: i64 = PosixFilesystemHost::read_link(path, buffer, count);
    transition n >= 0 { true -> ok(filesystem, n) _ -> err(filesystem, n) }
    state ok(filesystem: &mut PosixFilesystem, n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(filesystem: &mut PosixFilesystem, n: i64) -> IoResult { let kind: ErrorKind = PosixFilesystem::last_error_i64(filesystem, n); IoResult::Error { kind: kind } }
}

machine PosixFilesystem::set_file_permissions(filesystem: &mut PosixFilesystem, file: File, perms: Permissions) -> UnitResult
reaches FilesystemMetadataQuery + FilesystemMetadataMutation

invokes
    PosixFilesystemHost;
{
    filesystem.file_fd = PosixFilesystem::descriptor(file);
    transition perms {
        Permissions::Default -> apply(filesystem, 438)
        Permissions::Posix { mode } -> apply(filesystem, mode)
        Permissions::Readonly { value } -> inspect(filesystem, value)
    }
    state inspect(filesystem: &mut PosixFilesystem, readonly: bool) -> UnitResult {
        let result: i32 = PosixFilesystemHost::read_file_metadata(filesystem.file_fd, &mut filesystem.stat_buf);
        transition result == 0 { true -> derive(filesystem, readonly) false -> err(filesystem, result) }
    }
    state derive(filesystem: &mut PosixFilesystem, readonly: bool) -> UnitResult {
        let existing: u32 = PosixFilesystem::permission_bits(filesystem);
        let requested: u32 = posix_mode_with_readonly(existing, readonly);
        transition { _ -> apply(filesystem, requested) }
    }
    state apply(filesystem: &mut PosixFilesystem, mode: u32) -> UnitResult {
        let result: i32 = PosixFilesystemHost::set_file_permissions(filesystem.file_fd, mode);
        transition result == 0 { true -> ok(filesystem) false -> err(filesystem, result) }
    }
    state ok(filesystem: &mut PosixFilesystem) -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut PosixFilesystem, rc: i32) -> UnitResult { let kind: ErrorKind = PosixFilesystem::last_error_i32(filesystem, rc); UnitResult::Error { kind: kind } }
}

