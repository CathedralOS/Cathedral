use omega::language::core::filesystem_authority;
// The raw POSIX filesystem service: one boundary trait for the operating
// systems whose filesystem is the POSIX descriptor surface (Linux, macOS).
// Platform services (wiki/spec/build/platform_services.md) give every
// operating-system family its own raw trait so a provider covers the complete
// schema without stub rows; `WindowsFilesystemHost` is the other family.
// Programs that work with descriptors directly hold
// the exact `PosixFilesystemHost` static provider slot. The portable `Filesystem` service is a
// separate layer above the families.
//
// Conventions shared by every operation:
// - Descriptors are the OS's `int` descriptors; 0 is a valid descriptor.
// - Paths are NUL-free bytes (`Path`); providers terminate them for the
//   kernel. Operations named `*_name` and the `*_at` names take trusted plain
//   bytes that are NUL-free by construction.
// - Failure returns the negated `errno` (`-2` for `ENOENT`). That is the
//   kernel's own convention on Linux. A libc-backed provider reads its
//   thread-local `errno` immediately after the failing call and negates it,
//   so no provider keeps error state between calls and there is no separate
//   `errno` operation. Flag and mode values are the target's own constants,
//   passed through unchanged.
use filesystem_host;

use targets::macos_arm64::posix_filesystem_impl;
use targets::linux_x86_64::posix_filesystem_impl;
use targets::linux_arm64::posix_filesystem_impl;

// The native provider: one nominal type whose target-scoped bodies realize
// the service on each POSIX target.
data PosixFilesystemNativeProvider { }

public boundary trait PosixFilesystemHost {
    // Open an existing file (`open(path, flags)`). Creating opens use
    // `open_create`, whose mode crosses as a fixed argument.
    machine open(path: &[u8] in Path, flags: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
    // The creating open (`open(path, flags, mode)` with `O_CREAT`, optionally
    // `O_EXCL`/`O_TRUNC`).
    machine open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
    // `creat(path, mode)`: create or truncate for writing.
    machine create(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
    // Read up to `count` bytes (and at most `buffer.len`) into `buffer`. A short
    // read is a successful partial read; zero is end of file for a nonzero
    // request. A zero-length request still invokes the OS with count zero.
    machine read(fd: i32, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemContentRead;
    // Write a prefix of `bytes`; the result counts the bytes written. A short
    // write is a successful partial write. An empty view still invokes the OS
    // with count zero; the provider does not manufacture a successful result.
    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite;
    // `pread`: read at an absolute offset without moving the descriptor's cursor.
    machine read_at(fd: i32, buffer: &mut [u8], count: u64, offset: i64) -> i64 reaches FilesystemContentRead;
    // `pwrite`: write at an absolute offset without moving the descriptor's
    // cursor.
    machine write_at(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite;
    // Release a descriptor.
    machine close(fd: i32) -> i32;
    // Remove a file (`unlink`).
    machine remove(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation;
    // `lseek`: reposition the cursor; the result is the new absolute offset.
    machine seek(fd: i32, offset: i64, whence: i32) -> i64;
    // `mkdir`.
    machine create_dir(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation;
    // Remove an empty directory (`rmdir`).
    machine remove_dir(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation;
    // `mkdir` over trusted plain bytes: a prefix copied from a `Path` source is
    // NUL-free by construction.
    machine create_dir_name(name: &[u8], mode: i32) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation;
    // `openat` relative to an open directory. `name` is a trusted
    // directory-listing component.
    machine open_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
    // `unlinkat` relative to an open directory; `flags` carries the target's
    // `AT_REMOVEDIR` bit verbatim.
    machine unlink_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemNamespaceMutation;
    // `chmod`.
    machine set_permissions(path: &[u8] in Path, mode: u32) -> i32 reaches FilesystemMetadataMutation;
    // `fchmod`.
    machine set_file_permissions(fd: i32, mode: u32) -> i32 reaches FilesystemMetadataMutation;
    // `rename`.
    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation;
    // `link(original, link)`.
    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation;
    // `symlink(target, link)`.
    machine symlink(target: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation;
    // `readlink`: the link's target bytes, not NUL-terminated; the result counts
    // them.
    machine read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemMetadataQuery;
    // Fill `buffer` with packed target directory records. Darwin returns `struct
    // direntry` records (d_reclen@16, d_namlen@18, d_type@20, d_name@21) and
    // advances `position`; Linux returns `getdents64` records (d_reclen@16,
    // d_type@18, NUL-terminated d_name@19) and ignores it. Zero means end of
    // directory.
    machine read_dir(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64 reaches DirectoryEnumeration;
    // `unlink` over trusted plain bytes.
    machine remove_name(path: &[u8]) -> i32 reaches FilesystemNamespaceMutation;
    // `rmdir` over trusted plain bytes.
    machine remove_dir_name(path: &[u8]) -> i32 reaches FilesystemNamespaceMutation;
    // `stat`: fill `buffer` (at least the target's `struct stat`, 144 bytes on
    // Darwin and x86-64 Linux, 128 on arm64 Linux) with the target record that
    // `StatLayout` decodes. Undersized output returns EINVAL before the OS call;
    // only the native record is written, not the rest of a larger caller view.
    machine read_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery;
    // `fstat`, the same record for an open descriptor.
    machine read_file_metadata(fd: i32, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery;
    // `lstat`: like `read_metadata` but a final symlink reports its own record.
    machine read_symlink_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery;
    // `fstatat`: query a trusted listing component relative to its open
    // directory. Flags are native; no-follow classification must request the
    // target's AT_SYMLINK_NOFOLLOW. Refuse undersized output before the OS call.
    machine read_metadata_at(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32 reaches FilesystemMetadataQuery;
    // `ftruncate`.
    machine set_len(fd: i32, length: i64) -> i32 reaches FilesystemContentWrite + FilesystemMetadataMutation;
    // `futimens`: `times` holds two packed `struct timespec` values (access, then
    // modification), 32 bytes on the supported POSIX targets. Undersized input
    // returns EINVAL before the OS call. The byte view itself need not be aligned.
    machine set_file_times(fd: i32, times: &[u8]) -> i32 reaches FilesystemMetadataMutation;
    // `fsync`.
    machine sync(fd: i32) -> i32;
    // `fdatasync`: flush a file's data.
    machine sync_data(fd: i32) -> i32;
    // `dup`: a fresh descriptor sharing the open file.
    machine duplicate(fd: i32) -> i32;
    // `flock`: `LOCK_SH`=1, `LOCK_EX`=2, `LOCK_NB`=4, `LOCK_UN`=8.
    machine lock_file(fd: i32, operation: i32) -> i32;
    // `chown`; -1 leaves a component unchanged.
    machine change_owner(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation;
    // `lchown`: does not follow a final symlink.
    machine change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation;
    // `fchown`.
    machine change_file_owner(fd: i32, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation;
}

// Export the checked implementation for explicit raw-service composition.
// Calling its members retains their original reaches and provider closure.
public PosixFilesystemImplementation satisfies PosixFilesystemHost {
    machine open(path: &[u8] in Path, flags: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::open(path, flags)
    }

    machine open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::open_create(path, flags, mode)
    }

    machine create(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::create(path, mode)
    }

    machine read(fd: i32, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemContentRead {
        PosixFilesystemNativeProvider::read(fd, buffer, count)
    }

    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite {
        PosixFilesystemNativeProvider::write(fd, bytes)
    }

    machine read_at(fd: i32, buffer: &mut [u8], count: u64, offset: i64) -> i64 reaches FilesystemContentRead {
        PosixFilesystemNativeProvider::read_at(fd, buffer, count, offset)
    }

    machine write_at(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite {
        PosixFilesystemNativeProvider::write_at(fd, bytes, offset)
    }

    machine close(fd: i32) -> i32 {
        PosixFilesystemNativeProvider::close(fd)
    }

    machine remove(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::remove(path)
    }

    machine seek(fd: i32, offset: i64, whence: i32) -> i64 {
        PosixFilesystemNativeProvider::seek(fd, offset, whence)
    }

    machine create_dir(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::create_dir(path, mode)
    }

    machine remove_dir(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::remove_dir(path)
    }

    machine create_dir_name(name: &[u8], mode: i32) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::create_dir_name(name, mode)
    }

    machine open_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::open_at(dirfd, name, flags)
    }

    machine unlink_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::unlink_at(dirfd, name, flags)
    }

    machine set_permissions(path: &[u8] in Path, mode: u32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemNativeProvider::set_permissions(path, mode)
    }

    machine set_file_permissions(fd: i32, mode: u32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemNativeProvider::set_file_permissions(fd, mode)
    }

    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::rename(from, to)
    }

    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::hard_link(original, link)
    }

    machine symlink(target: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::symlink(target, link)
    }

    machine read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemMetadataQuery {
        PosixFilesystemNativeProvider::read_link(path, buffer, count)
    }

    machine read_dir(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64 reaches DirectoryEnumeration {
        PosixFilesystemNativeProvider::read_dir(fd, buffer, count, position)
    }

    machine remove_name(path: &[u8]) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::remove_name(path)
    }

    machine remove_dir_name(path: &[u8]) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemNativeProvider::remove_dir_name(path)
    }

    machine read_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemNativeProvider::read_metadata(path, buffer)
    }

    machine read_file_metadata(fd: i32, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemNativeProvider::read_file_metadata(fd, buffer)
    }

    machine read_symlink_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemNativeProvider::read_symlink_metadata(path, buffer)
    }

    machine read_metadata_at(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemNativeProvider::read_metadata_at(directory_descriptor, name, buffer, flags)
    }

    machine set_len(fd: i32, length: i64) -> i32 reaches FilesystemContentWrite + FilesystemMetadataMutation {
        PosixFilesystemNativeProvider::set_len(fd, length)
    }

    machine set_file_times(fd: i32, times: &[u8]) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemNativeProvider::set_file_times(fd, times)
    }

    machine sync(fd: i32) -> i32 {
        PosixFilesystemNativeProvider::sync(fd)
    }

    machine sync_data(fd: i32) -> i32 {
        PosixFilesystemNativeProvider::sync_data(fd)
    }

    machine duplicate(fd: i32) -> i32 {
        PosixFilesystemNativeProvider::duplicate(fd)
    }

    machine lock_file(fd: i32, operation: i32) -> i32 {
        PosixFilesystemNativeProvider::lock_file(fd, operation)
    }

    machine change_owner(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemNativeProvider::change_owner(path, uid, gid)
    }

    machine change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemNativeProvider::change_owner_no_follow(path, uid, gid)
    }

    machine change_file_owner(fd: i32, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemNativeProvider::change_file_owner(fd, uid, gid)
    }
}

// Copy `path` into `out` and terminate it for the kernel. Returns false when
// the path does not fit beside its terminator. A path that does not fit
// leaves the empty string, which every POSIX call refuses, never a truncated
// prefix that could name a different file.
//
// The byte loops below recurse through their machine entry and write in a
// separate per-byte machine whose states do not cycle: every write then lands
// on the writer's own entry parameter, whose storage origin checking can
// trace through each invocation back to the caller's buffer. Buffers cross
// as slices; callers lend fixed local arrays.
public machine posix_terminated_path(path: &[u8], out: &mut [u8]) -> bool {
    posix_copy_path_from(path, out, 0);
    transition path.len < out.len {
        true -> (true)
        _ -> rejected(out)
    }

    state rejected(out: &mut [u8]) -> bool {
        posix_put_path_byte("", out, 0);
        transition { _ -> (false) }
    }
}

machine posix_copy_path_from(path: &[u8], out: &mut [u8], index: u64)
terminates by (index, path.len) -> Nat::BoundedDistance;
{
    posix_put_path_byte(path, out, index);
    transition index < path.len {
        true -> posix_copy_path_from(path, out, index + 1)
        _ -> done()
    }

    state done() { }
}

// Position `index` of the terminated copy: the path byte below the path's
// length and the terminator at it, each only where the copy still leaves
// room for the terminator.
machine posix_put_path_byte(path: &[u8], out: &mut [u8], index: u64) {
    transition index < path.len {
        true -> byte(path, out, index)
        _ -> terminator(out, index)
    }

    state byte(path: &[u8], out: &mut [u8], index: u64) {
        transition index + 1 < out.len {
            true -> write_byte(path, out, index)
            _ -> done()
        }
    }

    state write_byte(path: &[u8], out: &mut [u8], index: u64) {
        out[index] = path[index];
        transition { _ -> done() }
    }

    state terminator(out: &mut [u8], index: u64) {
        transition index < out.len {
            true -> write_terminator(out, index)
            _ -> done()
        }
    }

    state write_terminator(out: &mut [u8], index: u64) {
        out[index] = 0;
        transition { _ -> done() }
    }

    state done() { }
}
