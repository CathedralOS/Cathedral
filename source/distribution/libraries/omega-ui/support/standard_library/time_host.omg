// std::time — the raw per-OS time boundary (TASKS_TIME.md rung 4, D11/D12).
//
// Value-returning scalars ONLY on this TRAIT surface: the portable SEMANTICS
// are fixed here and each target's binding/lowering must meet them (the fs
// seam discipline). The wall clock is ONE raw u64 read plus two per-target
// CONSTANTS, so all epoch/unit conversion lives in proven wrapper code
// (`time.omg`'s `Time` capability) — no provider converts epochs or units:
//
//   unix_seconds          = raw / units - epoch_offset
//   subsecond_nanoseconds = (raw % units) * 1_000_000_000 / units
//     (fits u64 for every real clock: units <= 18_446_744_073, guarded once
//      at calibration)
//
// A scalar trait surface does not mean every kernel hands back a scalar. Where
// one does not, its provider owns exactly the irreducible assembly and nothing
// more: the Linux providers turn `clock_gettime`'s two 64-bit timespec fields
// into one tick count with a single multiply-and-add, and Windows reads
// FILETIME's two DWORDs as the one little-endian u64 that ULARGE_INTEGER
// names. Neither touches `units` or `epoch_offset`.
//
// Per-target reference — every hosted target has a provider:
//   windows: QueryPerformanceCounter/-Frequency (out-param),
//            GetSystemTimePreciseAsFileTime raw=FILETIME u64,
//            units 10_000_000, epoch offset 11_644_473_600 (1601 -> 1970)
//   darwin:  clock_gettime_nsec_np(CLOCK_UPTIME_RAW / CLOCK_REALTIME),
//            units 1_000_000_000, epoch offset 0; arm64 and x86_64 each own a
//            copy, because a machine carries one target scope
//   linux:   clock_gettime(CLOCK_MONOTONIC / CLOCK_REALTIME) through a
//            borrowed timespec, units 1_000_000_000, epoch offset 0. The
//            syscall number is per-architecture, NOT per-OS: 228 on x86-64's
//            own table, 113 on arm64's asm-generic table.
//   uefi_x86_64 has no Console or ProcessExit provider either and keeps its
//            settlement gap; it is not a hosted target.
//   INTERPRETER (D12, the deterministic VIRTUAL clock): 1 tick = 1 ms;
//            `sleep` advances the clock by the slept milliseconds and the
//            reads never advance it, so interpreter canaries assert EXACT
//            values. Wall clock = 2026-01-01T00:00:00Z + elapsed, already in
//            Unix units (epoch offset 0, units 1000).
use targets::macos_arm64::time_host_impl;
use targets::macos_x86_64::time_host_impl;
use targets::linux_x86_64::time_host_impl;
use targets::linux_arm64::time_host_impl;
use targets::windows_x86_64::time_host_impl;

// The selected target owns an ordinary reviewed provider, not a table of
// compiler-folded answers. Unsupported targets retain their settlement gap.
public data TimeHostNativeProvider { }

// The target namespace is not a whole-trait implementation. Select this
// complete map; each inline member makes an ordinary call to its exact target
// body, retaining that body's raw-provider closure and operational contract.
public NativeTimeHost satisfies TimeHost {
    machine monotonic_ticks() -> u64 reaches TimeHost {
        TimeHostNativeProvider::monotonic_ticks()
    }

    machine monotonic_ticks_per_second() -> u64 {
        TimeHostNativeProvider::monotonic_ticks_per_second()
    }

    machine wall_clock_raw() -> u64 reaches TimeHost {
        TimeHostNativeProvider::wall_clock_raw()
    }

    machine wall_clock_units_per_second() -> u64 {
        TimeHostNativeProvider::wall_clock_units_per_second()
    }

    machine wall_clock_epoch_offset_seconds() -> u64 {
        TimeHostNativeProvider::wall_clock_epoch_offset_seconds()
    }

    machine sleep(milliseconds: u32) reaches TimeHost blocks; {
        block TimeHostNativeProvider::sleep(milliseconds);
    }
}

public boundary trait TimeHost {
    // Monotonic, never-decreasing tick counter since an unspecified epoch.
    // Only differences are meaningful.
    machine monotonic_ticks() -> u64 reaches TimeHost;
    // Ticks per second for monotonic_ticks. Stable for the process lifetime.
    machine monotonic_ticks_per_second() -> u64 reaches TimeHost;
    // Wall clock: ONE non-tearing read, raw platform units since the
    // platform epoch.
    machine wall_clock_raw() -> u64 reaches TimeHost;
    // Units per second for wall_clock_raw (constant per target).
    machine wall_clock_units_per_second() -> u64 reaches TimeHost;
    // Platform-epoch -> Unix-epoch shift, in seconds (constant per target).
    machine wall_clock_epoch_offset_seconds() -> u64 reaches TimeHost;
    // Millisecond sleep. The Darwin and Linux x86-64 providers wait with
    // poll, Linux arm64 with nanosleep (the asm-generic table publishes no
    // poll), Windows with kernel32 `Sleep`, and the interpreter advances its
    // virtual clock.
    machine sleep(milliseconds: u32) reaches TimeHost blocks;
}
