// The Windows window and thread-message service. Handles and message storage
// belong to the caller; the provider keeps no virtual desktop or hidden state.
// Class and title use the Windows ANSI API encoding and include a terminating
// NUL byte. Empty or unterminated views refuse creation before entering user32.
use targets::windows_x86_64::windows_gui_impl;

// Win64 MSG has 48 bytes with pointer alignment. The exact native layout stays
// opaque to callers; PeekMessage fills it and Translate/Dispatch consume it.
public data WindowsMessage { words: [u64; 6]; }
public data WindowsRectangle { left: i32; top: i32; right: i32; bottom: i32; }
public data WindowsTextExtent { width: i32; height: i32; }

// Win64 MSG stores HWND at byte 0, UINT message at byte 8 (followed by
// padding), and WPARAM at byte 16. Inspect only after a successful pump.
public machine WindowsMessage::window(message: &WindowsMessage) -> u64 {
    message.words[0]
}
public machine WindowsMessage::kind(message: &WindowsMessage) -> u64 {
    message.words[1] & 4294967295
}
public machine WindowsMessage::word_parameter(message: &WindowsMessage) -> u64 {
    message.words[2]
}

public boundary trait WindowsGuiHost {
    machine window_create(class_name: &[u8], title: &[u8], style: u32,
        x: i32, y: i32, width: i32, height: i32) -> u64 reaches WindowsGuiHost;
    machine foreground_window() -> u64 reaches WindowsGuiHost;
    machine is_window(window: u64) -> bool reaches WindowsGuiHost;
    machine window_destroy(window: u64) -> bool reaches WindowsGuiHost;
    // Remove at most one message from this thread, translate and dispatch it.
    // A false result means the queue had no message; this operation never waits.
    machine pump_message(message: &mut WindowsMessage) -> bool reaches WindowsGuiHost;
    // Add native frame metrics to the requested client size. Windows may
    // enforce its own minimum window size during creation.
    machine window_create_client(class_name: &[u8], title: &[u8], style: u32,
        x: i32, y: i32, width: i32, height: i32) -> u64 reaches WindowsGuiHost;
    machine get_dc(window: u64) -> u64 reaches WindowsGuiHost;
    machine release_dc(window: u64, device: u64) -> i32 reaches WindowsGuiHost;
    machine client_rectangle(window: u64, rectangle: &mut WindowsRectangle) -> i32 reaches WindowsGuiHost;
    // The caller lends live BITMAPINFO and pixel storage for this synchronous call.
    machine stretch_dibits(device: u64, destination_x: i32, destination_y: i32,
        destination_width: i32, destination_height: i32, source_x: i32, source_y: i32,
        source_width: i32, source_height: i32, pixels: &i32, info: &i32,
        usage: u32, raster_operation: u32) -> i32 reaches WindowsGuiHost;
    machine set_dpi_aware() -> i32 reaches WindowsGuiHost;
    machine create_compatible_dc(device: u64) -> u64 reaches WindowsGuiHost;
    machine delete_dc(device: u64) -> i32 reaches WindowsGuiHost;
    machine create_compatible_bitmap(device: u64, width: i32, height: i32) -> u64 reaches WindowsGuiHost;
    machine select_object(device: u64, object: u64) -> u64 reaches WindowsGuiHost;
    machine bit_blt(dest_dc: u64, x: i32, y: i32, width: i32, height: i32, src_dc: u64, src_x: i32, src_y: i32, rop: u32) -> i32 reaches WindowsGuiHost;
    machine stretch_blt(dest_dc: u64, x: i32, y: i32, width: i32, height: i32, src_dc: u64, src_x: i32, src_y: i32, src_width: i32, src_height: i32, rop: u32) -> i32 reaches WindowsGuiHost;
    machine set_stretch_blt_mode(device: u64, mode: i32) -> i32 reaches WindowsGuiHost;
    machine set_bk_mode(device: u64, mode: i32) -> i32 reaches WindowsGuiHost;
    machine set_text_color(device: u64, color: u32) -> u32 reaches WindowsGuiHost;
    machine text_face(device: u64, face: &mut [u16; 64]) -> i32 reaches WindowsGuiHost;
    machine create_font(height: i32, weight: i32, face_name: &[u8]) -> u64 reaches WindowsGuiHost;
    machine text_out(device: u64, x: i32, y: i32, text: &[u8]) -> i32 reaches WindowsGuiHost;
    machine draw_text_rect(device: u64, text: &[u8], rectangle: &mut WindowsRectangle, format: u32) -> i32 reaches WindowsGuiHost;
    machine get_text_extent(device: u64, text: &[u8], extent: &mut i32) -> i32 reaches WindowsGuiHost;
    machine text_out_wide(device: u64, x: i32, y: i32, text: &[u16]) -> i32 reaches WindowsGuiHost;
    machine draw_text_rect_wide(device: u64, text: &[u16], rectangle: &mut WindowsRectangle, format: u32) -> i32 reaches WindowsGuiHost;
    machine get_text_extent_wide(device: u64, text: &[u16], extent: &mut WindowsTextExtent) -> i32 reaches WindowsGuiHost;
    // Returns the executable path length; capacity means the path was truncated.
    machine module_filename(buffer: &mut [u16]) -> u32 reaches WindowsGuiHost;
    // FR_PRIVATE fonts live only in this process; Windows releases them on exit.
    machine add_private_font(path: &[u16]) -> i32 reaches WindowsGuiHost;
    machine get_di_bits(device: u64, bitmap: u64, start_scan: u32, scan_lines: u32, bits: &mut i32, info: &i32, usage: u32) -> i32 reaches WindowsGuiHost;
    machine open_bmp_file(path: &[u8]) -> u64 reaches WindowsGuiHost;
    machine write_bmp_band(handle: u64, pixels: &[i32], byte_count: u32) -> i32 reaches WindowsGuiHost;
    machine close_bmp_file(handle: u64) -> i32 reaches WindowsGuiHost;
    machine is_headless() -> bool reaches WindowsGuiHost;
    machine get_cursor_pos(pt: &mut i32) -> i32 reaches WindowsGuiHost;
    machine screen_to_client(window: u64, pt: &mut i32) -> i32 reaches WindowsGuiHost;
    machine get_async_key_state(vkey: i32) -> i32 reaches WindowsGuiHost;
    machine get_key_state(vkey: i32) -> i32 reaches WindowsGuiHost;
    machine capture_mouse(window: u64) -> bool reaches WindowsGuiHost;
    machine release_mouse() -> bool reaches WindowsGuiHost;
    machine mouse_captured(window: u64) -> bool reaches WindowsGuiHost;
    // An invisible Unicode edit owns standard Windows selection, clipboard and undo.
    machine edit_create() -> u64 reaches WindowsGuiHost;
    machine edit_message(window: u64, message: u32, word: u64, parameter: u64) -> u64 reaches WindowsGuiHost;
    machine edit_read(window: u64, text: &mut [u16]) -> u32 reaches WindowsGuiHost;
    machine edit_replace(window: u64, text: &[u16]) -> bool reaches WindowsGuiHost;
    // Keep the returned pixel address inside its live bitmap's original dimensions.
    // Flush pending GDI work before CPU writes; the bitmap owns this storage.
    machine delete_object(object: u64) -> i32 reaches WindowsGuiHost;
    machine create_dib_section(device: u64, info: &i32, usage: u32, pixels: &mut u64, section: u64, offset: u32) -> u64 reaches WindowsGuiHost;
    machine copy_bitmap_row(pixels: u64, stride: i32, height: i32, row: i32, width: i32, source: &[i32]) -> bool reaches WindowsGuiHost;
    machine copy_bitmap_span(pixels: u64, stride: i32, height: i32, row: i32, left: i32, width: i32, source: &[i32]) -> bool reaches WindowsGuiHost;
    // Repeat one source span into consecutive rows after checking the entire range.
    machine copy_bitmap_rows(pixels: u64, stride: i32, height: i32, row: i32, left: i32, width: i32, count: i32, source: &[i32]) -> bool reaches WindowsGuiHost;
    // Read the source span into destination[0..width].
    machine read_bitmap_span(pixels: u64, stride: i32, height: i32, row: i32, left: i32, width: i32, destination: &mut [i32]) -> bool reaches WindowsGuiHost;
    machine intersect_clip_rectangle(device: u64, left: i32, top: i32, right: i32, bottom: i32) -> i32 reaches WindowsGuiHost;
    machine exclude_clip_rectangle(device: u64, left: i32, top: i32, right: i32, bottom: i32) -> i32 reaches WindowsGuiHost;
    machine rectangle_visible(device: u64, rectangle: &WindowsRectangle) -> i32 reaches WindowsGuiHost;
    machine select_clip_region(device: u64, region: u64) -> i32 reaches WindowsGuiHost;
    machine create_rectangle_region(left: i32, top: i32, right: i32, bottom: i32) -> u64 reaches WindowsGuiHost;
    machine combine_regions(destination: u64, first: u64, second: u64, mode: i32) -> i32 reaches WindowsGuiHost;
    machine flush_gdi() -> i32 reaches WindowsGuiHost;
    machine wait_for_compositor() -> i32 reaches WindowsGuiHost;
    machine wait_for_input(timeout_ms: u32) -> u32 reaches WindowsGuiHost;
    machine reduced_motion() -> bool reaches WindowsGuiHost;
    machine performance_counter(value: &mut i64) -> i32 reaches WindowsGuiHost;
    machine performance_frequency(value: &mut i64) -> i32 reaches WindowsGuiHost;
}
