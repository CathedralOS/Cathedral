use omega::language::core::float_operations;

// Portable measurement units over the erased indexed-domain machinery.
//
// Units are library data, not compiler vocabulary. `Quantity<U>` leaves the
// carrier ABI unchanged; the named machines below make every scale change and
// integer-rounding choice visible in ordinary Omega code. This PDI2 surface
// deliberately publishes closed named combinations rather than computed
// index expressions (`A / B` belongs to PDI3).

data Unit [copy] {
    scale_numerator: i32;
    scale_denominator: i32;
    length_exponent: i32;
    time_exponent: i32;
}

data Units {
}

const Units::METER: Unit = Unit {
    scale_numerator: 1,
    scale_denominator: 1,
    length_exponent: 1,
    time_exponent: 0
};

const Units::KILOMETER: Unit = Unit {
    scale_numerator: 1000,
    scale_denominator: 1,
    length_exponent: 1,
    time_exponent: 0
};

const Units::SECOND: Unit = Unit {
    scale_numerator: 1,
    scale_denominator: 1,
    length_exponent: 0,
    time_exponent: 1
};

const Units::HOUR: Unit = Unit {
    scale_numerator: 3600,
    scale_denominator: 1,
    length_exponent: 0,
    time_exponent: 1
};

const Units::METER_PER_SECOND: Unit = Unit {
    scale_numerator: 1,
    scale_denominator: 1,
    length_exponent: 1,
    time_exponent: -1
};

// 1 km/h = 5/18 m/s. The normalized ratio gives this named closed
// combination one canonical identity without requiring open index algebra.
const Units::KILOMETER_PER_HOUR: Unit = Unit {
    scale_numerator: 5,
    scale_denominator: 18,
    length_exponent: 1,
    time_exponent: -1
};

domain<T, const U: Unit> T::Quantity<U>;

// Per-pair token bindings state only the carrier operations this first
// package actually serves. They do not impose arithmetic on every carrier that
// may participate in Quantity<U>. Each is an ordinary named machine homed in
// the `Quantity` domain: the fixed token after `machine` binds the spelling
// to that declaration for its deliberately narrow carrier pair, and the body
// is the executable supply -- the carrier arithmetic, erased to the carrier
// and re-qualified with the result unit, so no builtin fallback or satisfier
// search stands in for it.
machine + Quantity::add_i64_meters(
    left: i64 in Quantity<Units::METER>,
    right: i64 in Quantity<Units::METER>
) -> i64 in Quantity<Units::METER> {
    let sum: i64 in Trapping = (left as i64 in Trapping) + (right as i64 in Trapping);
    sum as i64 in Quantity<Units::METER>
}

machine + Quantity::add_f64_meters(
    left: f64 in Quantity<Units::METER>,
    right: f64 in Quantity<Units::METER>
) -> f64 in Quantity<Units::METER> {
    let sum: f64 = (left as f64) + (right as f64);
    sum as f64 in Quantity<Units::METER>
}

machine / Quantity::divide_i64_meters_by_seconds(
    distance: i64 in Quantity<Units::METER>,
    duration: i64 in Quantity<Units::SECOND>
) -> i64 in Quantity<Units::METER_PER_SECOND> {
    let speed: i64 in Trapping = (distance as i64 in Trapping) / (duration as i64 in Trapping);
    speed as i64 in Quantity<Units::METER_PER_SECOND>
}

machine / Quantity::divide_f64_meters_by_seconds(
    distance: f64 in Quantity<Units::METER>,
    duration: f64 in Quantity<Units::SECOND>
) -> f64 in Quantity<Units::METER_PER_SECOND> {
    let speed: f64 = (distance as f64) / (duration as f64);
    speed as f64 in Quantity<Units::METER_PER_SECOND>
}

machine / Quantity::divide_f64_kilometers_by_hours(
    distance: f64 in Quantity<Units::KILOMETER>,
    duration: f64 in Quantity<Units::HOUR>
) -> f64 in Quantity<Units::KILOMETER_PER_HOUR> {
    let speed: f64 = (distance as f64) / (duration as f64);
    speed as f64 in Quantity<Units::KILOMETER_PER_HOUR>
}

machine meters_i64(value: i64) -> i64 in Quantity<Units::METER> {
    value as i64 in Quantity<Units::METER>
}

machine kilometers_i64(value: i64) -> i64 in Quantity<Units::KILOMETER> {
    value as i64 in Quantity<Units::KILOMETER>
}

machine seconds_i64(value: i64) -> i64 in Quantity<Units::SECOND> {
    value as i64 in Quantity<Units::SECOND>
}

machine meters_f64(value: f64) -> f64 in Quantity<Units::METER> {
    value as f64 in Quantity<Units::METER>
}

machine kilometers_f64(value: f64) -> f64 in Quantity<Units::KILOMETER> {
    value as f64 in Quantity<Units::KILOMETER>
}

machine seconds_f64(value: f64) -> f64 in Quantity<Units::SECOND> {
    value as f64 in Quantity<Units::SECOND>
}

machine hours_f64(value: f64) -> f64 in Quantity<Units::HOUR> {
    value as f64 in Quantity<Units::HOUR>
}

// Exact on the mathematical integers; the carrier's ordinary trapping
// multiplication remains visible when the scaled value exceeds i64.
machine kilometers_to_meters_trapping_i64(
    value: i64 in Quantity<Units::KILOMETER>
) -> i64 in Quantity<Units::METER> {
    let scaled: i64 in Trapping = (value as i64 in Trapping) * 1000;
    scaled as i64 in Quantity<Units::METER>
}

// Integer division rounds toward zero. The operation says so in its name and
// body instead of hiding the lossy policy in `as`.
machine meters_to_kilometers_truncating_i64(
    value: i64 in Quantity<Units::METER>
) -> i64 in Quantity<Units::KILOMETER> {
    let scaled: i64 in Trapping = (value as i64 in Trapping) / 1000;
    scaled as i64 in Quantity<Units::KILOMETER>
}

machine kilometers_to_meters_f64(
    value: f64 in Quantity<Units::KILOMETER>
) -> f64 in Quantity<Units::METER> {
    let scaled: f64 = (value as f64) * 1000.0;
    scaled as f64 in Quantity<Units::METER>
}

machine meters_to_kilometers_f64(
    value: f64 in Quantity<Units::METER>
) -> f64 in Quantity<Units::KILOMETER> {
    let scaled: f64 = (value as f64) / 1000.0;
    scaled as f64 in Quantity<Units::KILOMETER>
}

machine kilometers_per_hour_to_meters_per_second_f64(
    value: f64 in Quantity<Units::KILOMETER_PER_HOUR>
) -> f64 in Quantity<Units::METER_PER_SECOND> {
    // 1 km/h = 5/18 m/s. The arithmetic stays visible and uses the same
    // normalized scale ratio published by the named destination constants.
    // The two operations bind separately: a value-call argument may not be
    // another machine call, and each float operator is a boundary call.
    let numerator: f64 = (value as f64) * 5.0;
    let scaled: f64 = numerator / 18.0;
    scaled as f64 in Quantity<Units::METER_PER_SECOND>
}
