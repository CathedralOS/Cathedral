// linux_x86_64 `TimeHost` provider.
//
// Linux publishes no scalar nanosecond clock read. `clock_gettime` writes a
// two-field 64-bit `struct __kernel_timespec` through a caller-supplied
// pointer, so this provider owns one multiply-and-add to produce the trait's
// single tick count. That is the ONLY arithmetic the per-OS layer does: epoch
// and unit conversion still happens once in `std/time.omg`, as D11 requires.
//
// Every foreign constant below was read out of the kernel sources rather than
// assumed from the Darwin provider or from the sibling arm64 file:
//   `228  common  clock_gettime    sys_clock_gettime`
//     — arch/x86/entry/syscalls/syscall_64.tbl
//   `7    common  poll             sys_poll`
//     — the same table; `targets/linux_x86_64/clock_impl.omg` already binds it.
//   `#define CLOCK_REALTIME 0` and `#define CLOCK_MONOTONIC 1`
//     — include/uapi/linux/time.h. Darwin's selectors are DIFFERENT numbers
//       for the same names, which is why the Darwin provider passes 8.
//   `struct __kernel_timespec { __kernel_time64_t tv_sec; long long tv_nsec; }`
//     — include/uapi/linux/time_types.h.
// The arm64 sibling binds the same two calls at different numbers (the
// asm-generic table), so neither Linux file is the other with the target
// renamed.
//
// NATIVE EXECUTION IS UNVERIFIED. This host is macOS arm64 and cannot execute
// a linux_x86_64 product. The evidence for this file is Psi checking plus the
// native artifact's terminal-authority closure review resolving every
// `TimeHost` requirement to a selected provider row.
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use time_host;

// The kernel's 64-bit timespec, in declaration order. Both fields are SIGNED;
// a CLOCK_MONOTONIC read or a post-1970 CLOCK_REALTIME read is nonnegative,
// and the saturating conversions below keep a negative or absurd field from
// becoming an enormous unsigned tick count.
public data LinuxX64TimeHostInstant { seconds: i64; nanoseconds: i64; }

// Per-target requirement carriers. A `boundary requirement` is target-neutral,
// so each target's seam owns its own carrier type rather than re-declaring a
// shared path — the shape `LinuxClockWait`/`LinuxArmClockWait` already use.
data LinuxX64TimeRead { }

boundary requirement LinuxX64TimeRead::clock_gettime(clock_id: u32, instant: &mut LinuxX64TimeHostInstant) -> i64
reaches TimeHost;

boundary requirement LinuxX64TimeRead::poll(descriptors: u64, descriptor_count: u32, timeout_milliseconds: i32) -> i32
reaches TimeHost
blocks;

data LinuxX64TimeImports { }

linux_x86_64 machine LinuxX64TimeImports::clock_gettime(clock_id: u32, instant: &mut LinuxX64TimeHostInstant) -> i64
    satisfies LinuxX64TimeRead::clock_gettime
    via ForeignBinding::Syscall(228);

linux_x86_64 machine LinuxX64TimeImports::poll(descriptors: u64, descriptor_count: u32, timeout_milliseconds: i32) -> i32
    satisfies LinuxX64TimeRead::poll
    via ForeignBinding::Syscall(7)
    blocks;

// `seconds * 1_000_000_000 + nanoseconds` in the Wrapping spelling
// `Time::now` already uses for the same reason: the interval fold cannot
// multiply variable bounds, so a proven-in-range multiply is not expressible
// here. The product cannot wrap for any real clock — u64 holds 18_446_744_073
// seconds of nanoseconds, past year 2554 for CLOCK_REALTIME and 584 years of
// uptime for CLOCK_MONOTONIC — and a kernel reporting more reads as a
// degraded tick count instead of faulting.
public machine linux_x86_64_time_host_ticks(seconds: i64, nanoseconds: i64) -> u64 {
    let seconds_unsigned: u64 = narrow_i64_to_u64_saturating(seconds);
    let nanoseconds_unsigned: u64 = narrow_i64_to_u64_saturating(nanoseconds);
    let scaled: u64 in Wrapping = (seconds_unsigned as u64 in Wrapping) * 1000000000;
    let total: u64 in Wrapping = scaled + (nanoseconds_unsigned as u64 in Wrapping);
    total as u64
}

// A failed read reports zero rather than a fabricated tick count: `Time::now`
// treats zero as a degraded clock and never faults on it.
linux_x86_64 machine TimeHostNativeProvider::monotonic_ticks() -> u64
    satisfies TimeHost::monotonic_ticks
reaches TimeHost
{
    let mut instant: LinuxX64TimeHostInstant = LinuxX64TimeHostInstant { seconds: 0, nanoseconds: 0 };
    let status: i64 = LinuxX64TimeRead::clock_gettime(1, &mut instant);
    transition status == 0 {
        true -> measured(instant.seconds, instant.nanoseconds)
        _ -> degraded()
    }

    state measured(seconds: i64, nanoseconds: i64) -> u64 {
        linux_x86_64_time_host_ticks(seconds, nanoseconds)
    }

    state degraded() -> u64 { 0 }
}

linux_x86_64 machine TimeHostNativeProvider::monotonic_ticks_per_second() -> u64
    satisfies TimeHost::monotonic_ticks_per_second
{
    1000000000
}

linux_x86_64 machine TimeHostNativeProvider::wall_clock_raw() -> u64
    satisfies TimeHost::wall_clock_raw
reaches TimeHost
{
    let mut instant: LinuxX64TimeHostInstant = LinuxX64TimeHostInstant { seconds: 0, nanoseconds: 0 };
    let status: i64 = LinuxX64TimeRead::clock_gettime(0, &mut instant);
    transition status == 0 {
        true -> measured(instant.seconds, instant.nanoseconds)
        _ -> degraded()
    }

    state measured(seconds: i64, nanoseconds: i64) -> u64 {
        linux_x86_64_time_host_ticks(seconds, nanoseconds)
    }

    state degraded() -> u64 { 0 }
}

// CLOCK_REALTIME is already Unix-epoch nanoseconds, so the units are 10^9 and
// the epoch shift is zero — unlike Windows, whose FILETIME needs both.
linux_x86_64 machine TimeHostNativeProvider::wall_clock_units_per_second() -> u64
    satisfies TimeHost::wall_clock_units_per_second
{
    1000000000
}

linux_x86_64 machine TimeHostNativeProvider::wall_clock_epoch_offset_seconds() -> u64
    satisfies TimeHost::wall_clock_epoch_offset_seconds
{
    0
}

// poll's timeout is signed. Preserve the full u32 millisecond request by
// splitting large waits into signed-representable pieces, as the Clock
// provider for this target does.
linux_x86_64 machine TimeHostNativeProvider::sleep(milliseconds: u32)
    satisfies TimeHost::sleep
reaches TimeHost
blocks;
{
    transition milliseconds > 2147483647 {
        true -> in_parts(milliseconds)
        _ -> at_once(milliseconds)
    }

    state at_once(milliseconds: u32) {
        block TimeHostNativeProvider::wait_part_linux_x86_64(narrow_u32_to_i32_wrapping(milliseconds));
    }

    state in_parts(milliseconds: u32) {
        let third: i32 = narrow_u32_to_i32_wrapping(milliseconds / 3);
        block TimeHostNativeProvider::wait_part_linux_x86_64(third);
        block TimeHostNativeProvider::wait_part_linux_x86_64(third);
        block TimeHostNativeProvider::wait_part_linux_x86_64(third);
        block TimeHostNativeProvider::wait_part_linux_x86_64(narrow_u32_to_i32_wrapping(milliseconds % 3));
    }
}

// No descriptors means zero reports a completed timeout. Retry failed waits
// instead of reporting sleep complete early. Repeating the full piece can
// oversleep; this boundary promises neither an upper duration nor termination.
linux_x86_64 machine TimeHostNativeProvider::wait_part_linux_x86_64(timeout_milliseconds: i32)
reaches TimeHost
blocks;
{
    transition { _ -> wait(timeout_milliseconds) }

    state wait(timeout_milliseconds: i32) {
        let outcome: i32 = block LinuxX64TimeRead::poll(0, 0, timeout_milliseconds);
        transition outcome == 0 {
            true -> done()
            _ -> wait(timeout_milliseconds)
        }
    }

    state done() { }
}

linux_x86_64 machine TimeHostNativeProvider::provider_defaults(defaults: &mut TimeHostNativeProvider) {
    TimeHostNativeProvider::select_provider<TimeHost, NativeTimeHost>(defaults);
    TimeHostNativeProvider::select_provider<LinuxX64TimeRead::clock_gettime, LinuxX64TimeImports>(defaults);
    TimeHostNativeProvider::select_provider<LinuxX64TimeRead::poll, LinuxX64TimeImports>(defaults);
}
