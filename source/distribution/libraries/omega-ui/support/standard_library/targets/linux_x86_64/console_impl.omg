use console;

// Exact linux_x86_64 Console byte/runtime leaves. The named NativeConsole
// implementation in std/console.omg forwards to these target declarations.
// Unmigrated sibling leaves retain transitional payload-free `via` syntax. The
// exit leaf's compiler supply is inferred from its exact realization symbol,
// normalized signature, package custody, and selected target.
linux_x86_64 machine ConsoleNativeProvider::read_byte() -> ByteRead
    satisfies Console::read_byte
    via ForeignBinding::CompilerIntrinsic
    crashes Trap
    blocks;
linux_x86_64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
linux_x86_64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;

linux_x86_64 machine ConsoleNativeProvider::provider_defaults(defaults: &mut ConsoleNativeProvider) {
    ConsoleNativeProvider::select_provider<Console, NativeConsole>(defaults);
}
