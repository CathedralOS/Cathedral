// uefi_x86_64 Loaded Image protocol geometry, authored once as a checked Omega
// schema plus its evaluated layout policy. `EfiLoadedImage` is the semantic
// carrier record; `EfiLoadedImageLayout::plan` is the evaluated layout policy
// that owns the firmware ABI's byte positions. The compiler replays this
// policy and validates its plan, so the firmware layout lives in exactly one
// authored definition -- the Rust side binds to the evaluated report through
// recorded commitments rather than keeping a second field catalog.
//
// EFI_LOADED_IMAGE_PROTOCOL: handle and pointer members are u64 address
// carriers (schema materialization has no `addr` carrier; member kind stays in
// the Rust field vocabulary), and `unload` is a function-pointer carrier. The
// implicit four-byte pads after `revision` and `load_options_size` are ABI
// alignment the report encodes as gaps between declared members.
use omega::language::core::layout;

data EfiLoadedImage {
    revision: u32;
    parent_handle: u64;
    system_table: u64;
    device_handle: u64;
    file_path: u64;
    reserved: u64;
    load_options_size: u32;
    load_options: u64;
    image_base: u64;
    image_size: u64;
    image_code_type: u32;
    image_data_type: u32;
    unload: u64;
}

data EfiLoadedImageLayout {
}

uefi_x86_64 machine EfiLoadedImageLayout::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 16 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 24 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 32 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 40 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::At { offset: 48 } };
    entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 56 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 64 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 72 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 80 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 84 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 88 } };
    Plan { entries: entries, entry_count: 13, size_fixed: 96, size_is_dynamic: false, align: 8 }
}

// uefi_x86_64 system-table and boot-services geometry, authored under the same
// checked-schema discipline as the Loaded Image protocol above.
// `EfiTableHeader` is the shared EFI_TABLE_HEADER preamble both protocol
// tables open with; `EfiSystemTableView` and `EfiBootServicesView` declare the
// semantic members the program continuation projects. The physical arrival
// keeps its own opaque boundary carriers (`boundary data EfiSystemTable` in
// entry.omg, the `UefiPhysicalEntry::enter` parameter), so these views stay
// distinct from the firmware-arrival surface. The evaluated `*Layout::plan`
// policies own the firmware ABI's byte positions. The Rust side binds each
// evaluated report to recorded commitments rather than keeping a second field
// catalog.
//
// EFI_SYSTEM_TABLE's pointer members are u64 address carriers; the implicit
// four-byte pad after `firmware_revision` is ABI alignment the report encodes
// as a gap. EFI_BOOT_SERVICES' forty-four function-pointer slots are a uniform
// service-pointer block: schema reflection caps a declaration at 32 members,
// so the block is one fixed `services` array and the Rust native-field
// vocabulary names each retained slot inside it.
data EfiTableHeader {
    signature: u64;
    revision: u32;
    header_size: u32;
    crc32: u32;
    reserved: u32;
}

data EfiSystemTableView {
    header: EfiTableHeader;
    firmware_vendor: u64;
    firmware_revision: u32;
    console_in_handle: u64;
    console_in: u64;
    console_out_handle: u64;
    console_out: u64;
    standard_error_handle: u64;
    standard_error: u64;
    runtime_services: u64;
    boot_services: u64;
    number_of_table_entries: u64;
    configuration_table: u64;
}

data EfiSystemTableViewLayout {
}

uefi_x86_64 machine EfiSystemTableViewLayout::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 24 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 32 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 40 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 48 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 56 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::At { offset: 64 } };
    entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 72 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 80 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 88 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 96 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 104 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 112 } };
    Plan { entries: entries, entry_count: 13, size_fixed: 120, size_is_dynamic: false, align: 8 }
}

data EfiBootServicesView {
    header: EfiTableHeader;
    services: [u64; 44];
}

data EfiBootServicesViewLayout {
}

uefi_x86_64 machine EfiBootServicesViewLayout::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 24 } };
    Plan { entries: entries, entry_count: 2, size_fixed: 376, size_is_dynamic: false, align: 8 }
}
