// UEFI 2.11 section 4.2: validate the declared table bytes, with the stored
// CRC field treated as zero. The caller supplies an already valid readable
// range and its required table signature, revision and minimum layout size.
// This checks contents, not pointer validity, firmware authority or lifetime.
// https://uefi.org/specs/UEFI/2.11/04_EFI_System_Table.html

public machine validate_table(
    bytes: &[u8],
    signature: u64,
    minimum_revision: u32,
    minimum_size: u32
) -> bool
terminates;
{
    transition bytes.len >= 24 {
        true -> header(bytes, signature, minimum_revision, minimum_size)
        _ -> (false)
    }

    state header(bytes: &[u8], signature: u64, minimum_revision: u32, minimum_size: u32) -> bool
    requires bytes.len >= 24;
    {
        let signature_low: u32 = read_u32(bytes);
        let signature_high: u32 = read_u32(bytes[4..]);
        let actual_signature: u64 = (signature_low as u64) | ((signature_high as u64) << 32);
        let revision: u32 = read_u32(bytes[8..]);
        let header_size: u32 = read_u32(bytes[12..]);
        let expected_crc: u32 = read_u32(bytes[16..]);
        let reserved: u32 = read_u32(bytes[20..]);
        transition actual_signature == signature && revision >= minimum_revision
            && reserved == 0 && header_size >= 24 && header_size >= minimum_size
            && header_size <= bytes.len {
            true -> checksum(bytes, header_size as u64, expected_crc)
            _ -> (false)
        }
    }

    state checksum(bytes: &[u8], header_size: u64, expected_crc: u32) -> bool
    requires header_size <= bytes.len;
    {
        let computed: u32 = table_crc(bytes[..header_size], 0, 0xFFFFFFFF);
        computed == expected_crc
    }
}

machine read_u32(bytes: &[u8]) -> u32
requires bytes.len >= 4;
{
    (bytes[0] as u32) | ((bytes[1] as u32) << 8)
        | ((bytes[2] as u32) << 16) | ((bytes[3] as u32) << 24)
}

// Do not edit the firmware table to clear its CRC: even a read-only validated
// borrow is enough. The checksum covers HeaderSize, not backing capacity.
machine table_crc(bytes: &[u8], position: u64, checksum: u32) -> u32
terminates by (position, bytes.len) -> Nat::BoundedDistance;
{
    transition position < bytes.len {
        true -> table_crc(bytes, position + 1, table_byte(bytes, position, checksum))
        _ -> (checksum ^ 0xFFFFFFFF)
    }
}

// A byte update is acyclic; the outer loop advances once per complete byte.
machine table_byte(bytes: &[u8], position: u64, checksum: u32) -> u32
requires position < bytes.len;
{
    transition position >= 16 && position < 20 {
        true -> crc_bits(checksum, 8)
        _ -> crc_bits(checksum ^ (bytes[position] as u32), 8)
    }
}

machine crc_bits(checksum: u32, remaining: u64) -> u32
terminates by remaining;
{
    transition remaining > 0 {
        true -> bit(checksum, remaining)
        _ -> (checksum)
    }

    state bit(checksum: u32, remaining: u64) -> u32
    requires remaining > 0;
    {
        transition (checksum & 1) == 1 {
            true -> crc_bits((checksum >> 1) ^ 0xEDB88320, remaining - 1)
            _ -> crc_bits(checksum >> 1, remaining - 1)
        }
    }
}
