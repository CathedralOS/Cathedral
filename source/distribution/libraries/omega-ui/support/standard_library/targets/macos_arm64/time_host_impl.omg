// Darwin clock reads return nanoseconds directly; the portable Time wrapper
// owns conversion into Instant and SystemTime. Clock selectors and calibration
// are ordinary checked code, not hidden arguments or constant provider rows.
// Apple documents/implements the selected clocks in Libc/gen/clock_gettime.c:
// https://github.com/apple-oss-distributions/Libc/blob/main/gen/clock_gettime.c
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use time_host;

boundary requirement TimeHostNativeProvider::clock_nanoseconds(clock_id: u32) -> u64
reaches TimeHost;

boundary requirement TimeHostNativeProvider::poll(descriptors: u64, descriptor_count: u32, timeout_milliseconds: i32) -> i32
reaches TimeHost
blocks;

data TimeHostDarwinImports { }

macos_arm64 machine time_host_clock_binding() -> ForeignBinding<26, 22, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_clock_gettime_nsec_np",
        },
    }
}

macos_arm64 machine time_host_poll_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_poll",
        },
    }
}

macos_arm64 machine TimeHostDarwinImports::clock_nanoseconds(clock_id: u32) -> u64
    satisfies TimeHostNativeProvider::clock_nanoseconds
    via time_host_clock_binding();

macos_arm64 machine TimeHostDarwinImports::poll(descriptors: u64, descriptor_count: u32, timeout_milliseconds: i32) -> i32
    satisfies TimeHostNativeProvider::poll
    via time_host_poll_binding()
    blocks;

macos_arm64 machine TimeHostNativeProvider::monotonic_ticks() -> u64
    satisfies TimeHost::monotonic_ticks
reaches TimeHost
{
    TimeHostNativeProvider::clock_nanoseconds(8)
}

macos_arm64 machine TimeHostNativeProvider::monotonic_ticks_per_second() -> u64
    satisfies TimeHost::monotonic_ticks_per_second
{
    1000000000
}

macos_arm64 machine TimeHostNativeProvider::wall_clock_raw() -> u64
    satisfies TimeHost::wall_clock_raw
reaches TimeHost
{
    TimeHostNativeProvider::clock_nanoseconds(0)
}

macos_arm64 machine TimeHostNativeProvider::wall_clock_units_per_second() -> u64
    satisfies TimeHost::wall_clock_units_per_second
{
    1000000000
}

macos_arm64 machine TimeHostNativeProvider::wall_clock_epoch_offset_seconds() -> u64
    satisfies TimeHost::wall_clock_epoch_offset_seconds
{
    0
}

// poll's timeout is signed. Preserve the full u32 millisecond request by
// splitting large waits into signed-representable pieces, as Clock does.
macos_arm64 machine TimeHostNativeProvider::sleep(milliseconds: u32)
    satisfies TimeHost::sleep
reaches TimeHost
blocks;
{
    transition milliseconds > 2147483647 {
        true -> in_parts(milliseconds)
        _ -> at_once(milliseconds)
    }

    state at_once(milliseconds: u32) {
        block TimeHostNativeProvider::wait_part(narrow_u32_to_i32_wrapping(milliseconds));
    }

    state in_parts(milliseconds: u32) {
        let third: i32 = narrow_u32_to_i32_wrapping(milliseconds / 3);
        block TimeHostNativeProvider::wait_part(third);
        block TimeHostNativeProvider::wait_part(third);
        block TimeHostNativeProvider::wait_part(third);
        block TimeHostNativeProvider::wait_part(narrow_u32_to_i32_wrapping(milliseconds % 3));
    }
}

// No descriptors means zero reports a completed timeout. Retry failed waits
// instead of reporting sleep complete early. Repeating the full piece can
// oversleep; this boundary promises neither an upper duration nor termination.
macos_arm64 machine TimeHostNativeProvider::wait_part(timeout_milliseconds: i32)
reaches TimeHost
blocks;
{
    transition { _ -> wait(timeout_milliseconds) }

    state wait(timeout_milliseconds: i32) {
        let outcome: i32 = block TimeHostNativeProvider::poll(0, 0, timeout_milliseconds);
        transition outcome == 0 {
            true -> done()
            _ -> wait(timeout_milliseconds)
        }
    }

    state done() { }
}

macos_arm64 machine TimeHostNativeProvider::provider_defaults(defaults: &mut TimeHostNativeProvider) {
    TimeHostNativeProvider::select_provider<TimeHost, NativeTimeHost>(defaults);
    TimeHostNativeProvider::select_provider<TimeHostNativeProvider::clock_nanoseconds, TimeHostDarwinImports>(defaults);
    TimeHostNativeProvider::select_provider<TimeHostNativeProvider::poll, TimeHostDarwinImports>(defaults);
}
