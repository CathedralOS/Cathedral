// Darwin ABI facts for the shared POSIX portable service. Layout and flag
// values follow the SDK's sys/stat.h, sys/fcntl.h and sys/dirent.h; the
// complete raw provider supplies negative errno, never retained libc state.
// Application data remains one Binding<FilesystemService>.
use omega::language::core::filesystem_authority;
use omega::language::core::external_binding;
use omega::language::core::layout;
use omega::language::core::numeric_conversion;
use filesystem;
use posix_filesystem_adapter;

data DarwinStatRecord {
    dev: u32;
    mode: u16;
    nlink: u16;
    ino: u64;
    uid: u32;
    gid: u32;
    rdev: u32;
    atime: i64;
    mtime: i64;
    ctime: i64;
    btime: i64;
    size: i64;
    blocks: i64;
    blksize: i32;
}
data DarwinStatLayout {}
data DarwinStatView { value: DarwinStatLayout<DarwinStatRecord>; }

macos_arm64 machine DarwinStatLayout::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 4 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 6 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 8 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 16 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 20 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::At { offset: 24 } };
    entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 32 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 48 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 64 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 80 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 96 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 104 } };
    entries[13] = FieldEntry { key: schema.fields[13].key, placement: FieldPlan::At { offset: 112 } };
    Plan { entries: entries, entry_count: 14, size_fixed: 144, size_is_dynamic: false, align: 8 }
}

macos_arm64 machine PosixFilesystem::decode_metadata(filesystem: &mut PosixFilesystem) -> MetadataResult {
    let stat: &DarwinStatView = &filesystem.stat_buf[0] as &DarwinStatView;
    let blocks: i64 = stat.value.blocks;
    let blksize: i64 = stat.value.blksize as i64;
    transition blocks >= 0 && blksize >= 0 {
        true -> decode(stat, blocks, blksize)
        _ -> MetadataResult::Error { kind: ErrorKind::InvalidInput }
    }
    state decode(stat: &DarwinStatView, block_count: i64, block_size: i64) -> MetadataResult
    requires block_count >= 0 && block_size >= 0;
    {
        let mode: u32 = stat.value.mode as u32;
        let nlink: u64 = stat.value.nlink as u64;
        let ino: u64 = stat.value.ino;
        let uid: u32 = stat.value.uid;
        let gid: u32 = stat.value.gid;
        let dev: u64 = stat.value.dev as u64;
        let rdev: u64 = stat.value.rdev as u64;
        let ctime: i64 = stat.value.ctime;
        let blocks: u64 = narrow_i64_to_u64_exact(block_count);
        let blksize: u64 = narrow_i64_to_u64_exact(block_size);
        let len: i64 = stat.value.size;
        let mtime: i64 = stat.value.mtime;
        let atime: i64 = stat.value.atime;
        let btime: i64 = stat.value.btime;
        let details: PosixMetadata = PosixMetadata { mode: mode, ino: ino, dev: dev, uid: uid, gid: gid, rdev: rdev, blocks: blocks, blksize: blksize };
        let metadata: Metadata = Metadata { len: len, kind: posix_metadata_kind(mode), permissions: Permissions::Posix { mode: mode & 4095 }, nlink: nlink, posix: PosixMetadataResult::Ok { details: details }, modified_secs: mtime, accessed_secs: atime, creation_time: TimestampResult::Ok { seconds: btime }, changed_secs: ctime };
        MetadataResult::Ok { meta: metadata }
    }
}

macos_arm64 machine PosixFilesystem::permission_bits(filesystem: &PosixFilesystem) -> u32 {
    let stat: &DarwinStatView = &filesystem.stat_buf[0] as &DarwinStatView;
    (stat.value.mode as u32) & 4095
}

macos_arm64 machine PosixFilesystem::encode_open_options(filesystem: &mut PosixFilesystem) {
    filesystem.open_writable = (filesystem.open_options.write as i32) | (filesystem.open_options.append as i32);
    filesystem.open_readable = filesystem.open_options.read as i32;
    filesystem.open_creating = (filesystem.open_options.create as i32) | (filesystem.open_options.create_new as i32);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | ((filesystem.open_options.append as i32) << 3)
        | (filesystem.open_creating << 9)
        | ((filesystem.open_options.truncate as i32) << 10)
        | ((filesystem.open_options.create_new as i32) << 11));
}

// Resolve an absent directory hint from the native mode without decoding
// unrelated size/timestamp fields or following a final symlink.
macos_arm64 machine PosixFilesystem::decode_directory_kind(filesystem: &mut PosixFilesystem) -> PosixDirectoryKind {
    let stat: &DarwinStatView = &filesystem.stat_buf[0] as &DarwinStatView;
    let kind: u32 = (stat.value.mode as u32) & 61440;
    transition kind {
        16384 -> PosixDirectoryKind::Directory
        32768 -> PosixDirectoryKind::Regular
        _ -> PosixDirectoryKind::Other
    }
}
macos_arm64 machine PosixFilesystem::metadata_no_follow_flag() -> i32 { 32 }

macos_arm64 machine PosixFilesystem::directory_type_offset() -> u64
    ensures result >= 18 && result <= 20
{ 20 }
macos_arm64 machine PosixFilesystem::directory_name_offset() -> u64
    ensures result >= 19 && result <= 21
{ 21 }
macos_arm64 machine PosixFilesystem::remove_directory_flag() -> i32 { 128 }
macos_arm64 machine PosixFilesystem::directory_descent_flags() -> i32 { 1048832 }

macos_arm64 machine FilesystemProviderDefaults::provider_defaults(defaults: &mut FilesystemProviderDefaults) {
    FilesystemProviderDefaults::select_provider<FilesystemService, FilesystemPosixProvider>(defaults);
}

macos_arm64 machine darwin_realpath_binding() -> ForeignBinding<26, 9, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_realpath",
    } }
}

macos_arm64 machine PosixCanonicalImports::provider_defaults(defaults: &mut PosixCanonicalImports) {
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::resolve, PosixCanonicalImports>(defaults);
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::error_location, PosixCanonicalImports>(defaults);
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::copy_error, PosixCanonicalImports>(defaults);
}

macos_arm64 machine darwin_errno_location_binding() -> ForeignBinding<26, 8, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "___error",
    } }
}

macos_arm64 machine darwin_errno_copy_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcpy",
    } }
}

macos_arm64 machine PosixCanonicalImports::resolve(path: &[u8; 4096], output: &mut [u8; 4096]) -> u64
satisfies PosixCanonicalLibc::resolve via darwin_realpath_binding();

macos_arm64 machine PosixCanonicalImports::error_location() -> u64
satisfies PosixCanonicalLibc::error_location via darwin_errno_location_binding();

macos_arm64 machine PosixCanonicalImports::copy_error(destination: &mut [u8; 4], source: u64, count: u64) -> u64
satisfies PosixCanonicalLibc::copy_error via darwin_errno_copy_binding();

// Error numbers belong to this OS, not to a synthetic shared POSIX catalog.
macos_arm64 machine PosixFilesystem::kind_of_stored_error_code(filesystem: &mut PosixFilesystem) -> ErrorKind {
    filesystem.err_kind = match filesystem.err_code {
        2 -> ErrorKind::NotFound,
        13 -> ErrorKind::PermissionDenied,
        1 -> ErrorKind::PermissionDenied,
        17 -> ErrorKind::AlreadyExists,
        9 -> ErrorKind::BadDescriptor,
        21 -> ErrorKind::IsADirectory,
        35 -> ErrorKind::WouldBlock,
        22 -> ErrorKind::InvalidInput,
        34 -> ErrorKind::InvalidInput,
        63 -> ErrorKind::InvalidInput,
        45 -> ErrorKind::Unsupported,
        78 -> ErrorKind::Unsupported,
        102 -> ErrorKind::Unsupported,
        _ -> ErrorKind::Other
    };
    ErrorKind::reconstruct(&filesystem.err_kind)
}

macos_arm64 machine PosixFilesystem::would_block_error() -> i32 { 35 }
