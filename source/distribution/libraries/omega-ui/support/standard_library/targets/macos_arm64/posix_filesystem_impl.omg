boundary requirement PosixFilesystemDarwin::c_open(path: &u8, flags: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_open_create(path: &u8, flags: i32, mode: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_create(path: &u8, mode: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_close(fd: i32) -> i32
;
boundary requirement PosixFilesystemDarwin::c_remove(path: &u8) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_seek(fd: i32, offset: i64, whence: i32) -> i64
;
boundary requirement PosixFilesystemDarwin::c_create_dir(path: &u8, mode: i32) -> i32
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_remove_dir(path: &u8) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_create_dir_name(name: &u8, mode: i32) -> i32
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_open_at(dirfd: i32, name: &u8, flags: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_unlink_at(dirfd: i32, name: &u8, flags: i32) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_set_permissions(path: &u8, mode: u32) -> i32
reaches FilesystemMetadataMutation;
boundary requirement PosixFilesystemDarwin::c_set_file_permissions(fd: i32, mode: u32) -> i32
reaches FilesystemMetadataMutation;
boundary requirement PosixFilesystemDarwin::c_rename(from: &u8, to: &u8) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_hard_link(original: &u8, link: &u8) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_symlink(target: &u8, link: &u8) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_remove_name(path: &u8) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_remove_dir_name(path: &u8) -> i32
reaches FilesystemNamespaceMutation;
boundary requirement PosixFilesystemDarwin::c_read_file_metadata(fd: i32, buffer: &mut u8) -> i32
reaches FilesystemMetadataQuery;
boundary requirement PosixFilesystemDarwin::c_read_metadata_at(directory_descriptor: i32, name: &u8, buffer: &mut u8, flags: i32) -> i32
reaches FilesystemMetadataQuery;
boundary requirement PosixFilesystemDarwin::c_set_len(fd: i32, length: i64) -> i32
reaches FilesystemContentWrite + FilesystemMetadataMutation;
boundary requirement PosixFilesystemDarwin::c_set_file_times(fd: i32, times: &DarwinTimestampAlignment<DarwinTimestampRecord>) -> i32
reaches FilesystemMetadataMutation;
boundary requirement PosixFilesystemDarwin::c_sync(fd: i32) -> i32
;
boundary requirement PosixFilesystemDarwin::c_sync_data(fd: i32) -> i32
;
boundary requirement PosixFilesystemDarwin::c_duplicate(fd: i32) -> i32
;
boundary requirement PosixFilesystemDarwin::c_lock_file(fd: i32, operation: i32) -> i32
;
boundary requirement PosixFilesystemDarwin::c_change_owner(path: &u8, uid: i32, gid: i32) -> i32
reaches FilesystemMetadataMutation;
boundary requirement PosixFilesystemDarwin::c_change_owner_no_follow(path: &u8, uid: i32, gid: i32) -> i32
reaches FilesystemMetadataMutation;
boundary requirement PosixFilesystemDarwin::c_change_file_owner(fd: i32, uid: i32, gid: i32) -> i32
reaches FilesystemMetadataMutation;
boundary requirement PosixFilesystemDarwin::c_error_location() -> u64
;
boundary requirement PosixFilesystemDarwin::c_copy_from_address(destination: &mut u8, source: u64, count: u64) -> u64
;

data PosixFilesystemDarwin { }  // requirement namespace for the libSystem imports
data PosixFilesystemDarwinImports { }

macos_arm64 machine PosixFilesystemDarwinImports::c_open(path: &u8, flags: i32) -> i32
    satisfies PosixFilesystemDarwin::c_open via posix_darwin_open_binding();
macos_arm64 machine PosixFilesystemDarwinImports::c_open_create(path: &u8, flags: i32, mode: i32) -> i32
    satisfies PosixFilesystemDarwin::c_open_create via posix_darwin_open_private_binding();
