    satisfies PosixFilesystemDarwin::c_copy_from_address via posix_darwin_memcpy_binding();

// The negated `errno` of the call that just failed.
macos_arm64 machine PosixFilesystemDarwin::failure_i32() -> i32

{
    let location: u64 = PosixFilesystemDarwin::c_error_location();
    let mut code: [u8; 4];
    let copied: u64 = PosixFilesystemDarwin::c_copy_from_address(&mut code[0], location, 4);
    let low: u8 = code[0];
    0 - (low as i32)
}

macos_arm64 machine PosixFilesystemDarwin::failure_i64() -> i64

{
    let location: u64 = PosixFilesystemDarwin::c_error_location();
    let mut code: [u8; 4];
    let copied: u64 = PosixFilesystemDarwin::c_copy_from_address(&mut code[0], location, 4);
    let low: u8 = code[0];
    0 - (low as i64)
}

// Capture libc errno before restoring caller storage after a native write.
macos_arm64 machine PosixFilesystemDarwin::normalize_i64(outcome: i64) -> i64 {
    transition outcome < 0 { true -> PosixFilesystemDarwin::failure_i64() _ -> outcome }
}

// Darwin `ENAMETOOLONG`, answered without a call when a path does not fit.
macos_arm64 machine PosixFilesystemDarwin::name_too_long_i32() -> i32 { -63 }
macos_arm64 machine PosixFilesystemDarwin::name_too_long_i64() -> i64 { -63 }

macos_arm64 machine PosixFilesystemNativeProvider::open(path: &[u8] in Path, flags: i32) -> i32
    satisfies PosixFilesystemHost::open
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_open(&terminated[0], flags);
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    state settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

