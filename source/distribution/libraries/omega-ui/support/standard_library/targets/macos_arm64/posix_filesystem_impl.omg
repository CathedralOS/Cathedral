use omega::language::core::filesystem_authority;
// Complete macos_arm64 `PosixFilesystemHost` provider over libSystem.
// Each operation is an ordinary checked adapter: it terminates paths into
// local buffers, lends caller backing for ordinary read/write transfers,
// calls libSystem, and turns libc's `-1` plus thread-local `errno` into the
// trait's negated `errno`. The imports state libSystem's own parameters
// through std-private requirements, each satisfied by one Mach-O symbol.
//
// `open_create` imports `___open`, the fixed-arity entry behind libc's
// variadic `open`: Apple arm64 passes variadic arguments on the stack, and an
// authored import cannot request that placement yet, so the creation mode
// would otherwise arrive in the wrong place. `open`, `openat` and
// `unlinkat` take no variadic argument without `O_CREAT`, so their ordinary
// entries are called with their fixed arguments only.
//
// `errno` lives in libc's thread-local storage, reachable only as the address
// `___error()` returns. The adapter copies its low byte out through
// `_memcpy`; Darwin's `errno` values stop at `ELAST` (106), so that byte is
// the whole value.
use omega::language::core::external_binding;
use posix_filesystem_host;
use filesystem_host;
use omega::language::core::layout;
use omega::language::core::numeric_conversion;
use math;
use calling;
use posix_byte_view_calling;

// The explicit policy exports the borrowed view as pointer/count, not one byte.
boundary trait PosixFilesystemDarwinByteViews: Calling<DarwinArm64ByteViewCalling> {
    machine c_read(fd: i32, buffer: &mut [u8]) -> i64 reaches FilesystemContentRead;
    machine c_write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite;
    machine c_read_at(fd: i32, buffer: &mut [u8], offset: i64) -> i64 reaches FilesystemContentRead;
    machine c_write_at(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite;
    machine c_read_link(path: &[u8; 4096], buffer: &mut [u8]) -> i64 reaches FilesystemMetadataQuery;
    machine c_read_dir(fd: i32, buffer: &mut [u8], position: &mut i64) -> i64 reaches DirectoryEnumeration;
}


// Unlike the raw Linux syscall, libc consumes an aligned timespec[2] object.
// Caller byte views need not have that alignment. Materialize only this native
// 32-byte record, keeping required ABI marshaling separate from payload staging.
data DarwinTimestampRecord {
    accessed_seconds: i64;
    accessed_nanoseconds: i64;
    modified_seconds: i64;
    modified_nanoseconds: i64;
}
data DarwinTimestampAlignment { }
macos_arm64 machine DarwinTimestampAlignment::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 16 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 24 } };
    Plan { entries: entries, entry_count: 4, size_fixed: 32, size_is_dynamic: false, align: 8 }
}

// Decode the caller's packed little-endian bytes without forming an aligned
// native reference to them. All signed bit patterns, including UTIME sentinels,
// survive unchanged; semantic timestamp validation remains the OS's operation.
macos_arm64 machine darwin_timestamp_word(bytes: &[u8]) -> i64
requires bytes.len == 8;
{
    let word: u64 in Wrapping = (widen_u8_to_u64(bytes[0]) as u64 in Wrapping)
        | ((widen_u8_to_u64(bytes[1]) as u64 in Wrapping) << 8)
        | ((widen_u8_to_u64(bytes[2]) as u64 in Wrapping) << 16)
        | ((widen_u8_to_u64(bytes[3]) as u64 in Wrapping) << 24)
        | ((widen_u8_to_u64(bytes[4]) as u64 in Wrapping) << 32)
        | ((widen_u8_to_u64(bytes[5]) as u64 in Wrapping) << 40)
        | ((widen_u8_to_u64(bytes[6]) as u64 in Wrapping) << 48)
        | ((widen_u8_to_u64(bytes[7]) as u64 in Wrapping) << 56);
    narrow_u64_to_i64_wrapping(word as u64)
}

macos_arm64 machine posix_darwin_open_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_open",
        },
    }
}

