// The kernel writes one complete native record into caller-owned storage.
// Only path termination needs scratch; undersized output never reaches libc.
macos_arm64 machine PosixFilesystemNativeProvider::read_metadata_at(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32
    satisfies PosixFilesystemHost::read_metadata_at
reaches FilesystemMetadataQuery
{
    transition buffer.len >= 144 { true -> prepare(directory_descriptor, name, buffer, flags) _ -> -22 }
    state prepare(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32
    requires buffer.len >= 144;
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(name, &mut terminated);
        transition fits { true -> query(directory_descriptor, terminated, buffer, flags) _ -> -63 }
    }
    state query(directory_descriptor: i32, terminated: [u8; 4096], buffer: &mut [u8], flags: i32) -> i32
    requires buffer.len >= 144;
    {
        let outcome: i32 = PosixFilesystemDarwin::c_read_metadata_at(directory_descriptor, &terminated[0], &mut buffer[0], flags);
        transition outcome < 0 { true -> PosixFilesystemDarwin::failure_i32() _ -> outcome }
    }
}

