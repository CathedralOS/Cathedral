macos_arm64 machine PosixFilesystemNativeProvider::change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32
    satisfies PosixFilesystemHost::change_owner_no_follow
reaches FilesystemMetadataMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_change_owner_no_follow(&terminated[0], uid, gid);
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    state settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

macos_arm64 machine PosixFilesystemNativeProvider::change_file_owner(fd: i32, uid: i32, gid: i32) -> i32
    satisfies PosixFilesystemHost::change_file_owner
reaches FilesystemMetadataMutation
{
    let outcome: i32 = PosixFilesystemDarwin::c_change_file_owner(fd, uid, gid);
    transition outcome < 0 {
        true -> (PosixFilesystemDarwin::failure_i32())
        _ -> (outcome)
    }
}

