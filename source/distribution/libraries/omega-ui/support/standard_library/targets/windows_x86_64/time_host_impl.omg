// windows_x86_64 `TimeHost` provider.
//
// Windows has no stable syscall ABI, so every leaf realizes through kernel32
// DLL linkage like the other Windows boundary leaves. All four entry points
// were read out of Microsoft's API reference rather than assumed:
//   `BOOL QueryPerformanceCounter([out] LARGE_INTEGER *lpPerformanceCount)`
//     — profileapi.h, "DLL: Kernel32.dll". "On systems that run Windows XP or
//     later, the function will always succeed when given valid parameters and
//     will thus never return zero", which is what makes the degraded arm below
//     unreachable in practice rather than a swallowed failure.
//   `BOOL QueryPerformanceFrequency([out] LARGE_INTEGER *lpFrequency)`
//     — profileapi.h, "DLL: Kernel32.dll".
//   `VOID GetSystemTimePreciseAsFileTime([out] LPFILETIME)`
//     — sysinfoapi.h, "DLL: Kernel32.dll", minimum Windows 8 / Server 2012.
//     `std/time_host.omg`'s header selects this call for this target.
//   `VOID Sleep(DWORD dwMilliseconds)` — kernel32; already bound for `Clock`
//     in `targets/windows_x86_64/clock_impl.omg`, whose comment records that
//     the millisecond count IS the whole requirement signature.
//
// FILETIME is a 64-bit count of 100-nanosecond intervals since 1601-01-01
// UTC. That is the whole reason `wall_clock_units_per_second` and
// `wall_clock_epoch_offset_seconds` exist: the units are 10_000_000 and the
// 1601 -> 1970 shift is 11_644_473_600 seconds (134_774 days x 86_400), the
// two constants `std/time_host.omg`'s header already specifies here. The
// portable wrapper in `std/time.omg` applies both; this file states them and
// does no arithmetic.
//
// NATIVE EXECUTION IS UNVERIFIED. This host is macOS arm64 and cannot execute
// a windows_x86_64 product. The evidence for this file is Psi checking plus
// the native artifact's terminal-authority closure review resolving every
// `TimeHost` requirement to a selected provider row.
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use time_host;

// Per-target requirement carrier. A `boundary requirement` is target-neutral,
// so each target's seam owns its own carrier type rather than re-declaring a
// shared path.
data WindowsTimeRead { }

// LARGE_INTEGER's QuadPart is a signed LONGLONG, so the out-parameters below
// are `i64` and the conversion to the trait's unsigned ticks is explicit.
boundary requirement WindowsTimeRead::query_performance_counter(counter: &mut i64) -> i32
reaches TimeHost;

boundary requirement WindowsTimeRead::query_performance_frequency(frequency: &mut i64) -> i32
reaches TimeHost;

// FILETIME's two DWORDs form one little-endian 64-bit count — the
// ULARGE_INTEGER reading — and x86-64 Windows is always little-endian, so one
// `u64` cell receives it as the single non-tearing read D11 asks for.
boundary requirement WindowsTimeRead::system_time_as_file_time(file_time: &mut u64)
reaches TimeHost;

data WindowsTimeImports { }

windows_x86_64 machine time_host_counter_binding_windows_x86_64() -> ForeignBinding<12, 23, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "QueryPerformanceCounter",
        },
    }
}

windows_x86_64 machine time_host_frequency_binding_windows_x86_64() -> ForeignBinding<12, 25, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "QueryPerformanceFrequency",
        },
    }
}

windows_x86_64 machine time_host_file_time_binding_windows_x86_64() -> ForeignBinding<12, 30, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "GetSystemTimePreciseAsFileTime",
        },
    }
}

windows_x86_64 machine time_host_sleep_binding_windows_x86_64() -> ForeignBinding<12, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "Sleep",
        },
    }
}

windows_x86_64 machine WindowsTimeImports::query_performance_counter(counter: &mut i64) -> i32
    satisfies WindowsTimeRead::query_performance_counter
    via time_host_counter_binding_windows_x86_64();

windows_x86_64 machine WindowsTimeImports::query_performance_frequency(frequency: &mut i64) -> i32
    satisfies WindowsTimeRead::query_performance_frequency
    via time_host_frequency_binding_windows_x86_64();

windows_x86_64 machine WindowsTimeImports::system_time_as_file_time(file_time: &mut u64)
    satisfies WindowsTimeRead::system_time_as_file_time
    via time_host_file_time_binding_windows_x86_64();

// A failed read reports zero rather than a fabricated tick count: `Time::now`
// treats zero as a degraded clock and never faults on it. A zero frequency
// takes the same route through that wrapper's calibration clamp.
windows_x86_64 machine TimeHostNativeProvider::monotonic_ticks() -> u64
    satisfies TimeHost::monotonic_ticks
reaches TimeHost
{
    let mut counter: i64 = 0;
    let status: i32 = WindowsTimeRead::query_performance_counter(&mut counter);
    transition status == 0 {
        true -> degraded()
        _ -> measured(counter)
    }

    state measured(counter: i64) -> u64 { narrow_i64_to_u64_saturating(counter) }

    state degraded() -> u64 { 0 }
}

windows_x86_64 machine TimeHostNativeProvider::monotonic_ticks_per_second() -> u64
    satisfies TimeHost::monotonic_ticks_per_second
reaches TimeHost
{
    let mut frequency: i64 = 0;
    let status: i32 = WindowsTimeRead::query_performance_frequency(&mut frequency);
    transition status == 0 {
        true -> degraded()
        _ -> measured(frequency)
    }

    state measured(frequency: i64) -> u64 { narrow_i64_to_u64_saturating(frequency) }

    state degraded() -> u64 { 0 }
}

windows_x86_64 machine TimeHostNativeProvider::wall_clock_raw() -> u64
    satisfies TimeHost::wall_clock_raw
reaches TimeHost
{
    let mut file_time: u64 = 0;
    WindowsTimeRead::system_time_as_file_time(&mut file_time);
    transition { _ -> measured(file_time) }

    state measured(file_time: u64) -> u64 { file_time }
}

// FILETIME ticks are 100-nanosecond intervals.
windows_x86_64 machine TimeHostNativeProvider::wall_clock_units_per_second() -> u64
    satisfies TimeHost::wall_clock_units_per_second
{
    10000000
}

// 1601-01-01 to 1970-01-01 is 134_774 days, so 11_644_473_600 seconds.
windows_x86_64 machine TimeHostNativeProvider::wall_clock_epoch_offset_seconds() -> u64
    satisfies TimeHost::wall_clock_epoch_offset_seconds
{
    11644473600
}

// `Sleep` takes the millisecond count as its single argument, so the leaf
// signature IS the requirement signature and no adapter body is needed.
windows_x86_64 machine TimeHostNativeProvider::sleep(milliseconds: u32)
    satisfies TimeHost::sleep
    via time_host_sleep_binding_windows_x86_64()
    blocks;

windows_x86_64 machine TimeHostNativeProvider::provider_defaults(defaults: &mut TimeHostNativeProvider) {
    TimeHostNativeProvider::select_provider<TimeHost, NativeTimeHost>(defaults);
    TimeHostNativeProvider::select_provider<WindowsTimeRead::query_performance_counter, WindowsTimeImports>(defaults);
    TimeHostNativeProvider::select_provider<WindowsTimeRead::query_performance_frequency, WindowsTimeImports>(defaults);
    TimeHostNativeProvider::select_provider<WindowsTimeRead::system_time_as_file_time, WindowsTimeImports>(defaults);
}
