// Complete windows_x86_64 `WindowsFilesystemHost` provider over kernel32.
// Windows has no stable syscall ABI, so every leaf realizes through DLL
// linkage exactly like the console and process-exit providers:
//   `HANDLE CreateFileW(LPCWSTR path, DWORD access, DWORD share,
//                       LPSECURITY_ATTRIBUTES, DWORD disposition,
//                       DWORD flags, HANDLE template)`
//   `BOOL WriteFile(HANDLE, LPCVOID bytes, DWORD count, LPDWORD written,
//                   LPOVERLAPPED)`
//   `BOOL CloseHandle(HANDLE)`
//   `DWORD GetLastError(void)`
// CreateFileW failure returns INVALID_HANDLE_VALUE, which the adapter maps
// to 0 so the trait keeps exactly one failure value; WriteFile and
// CloseHandle return BOOL, and a 0 reads back as the negated GetLastError —
// the same never-stateful convention as the POSIX family's negated errno.
//
// Paths arrive as NUL-free bytes (`Path`) and are decoded as UTF-8 to
// NUL-terminated UTF-16LE in a local buffer by `windows_wide_path`: the
// decoder is a real UTF-8 walk — 1-4 byte sequences, continuation checks,
// overlong and surrogate-range rejection, and a surrogate pair for 4-byte
// sequences — so malformed input and oversized output both fail instead of
// writing a wrong name. Proof shape follows the dir-walk helpers in this
// directory's `filesystem_impl.omg`: one fact per transition guard so each
// landed state is dominated, and the output cursor `o` is range-bounded so
// `o + k` is representable without a dominating conjunct.
use omega::language::core::external_binding;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use windows_filesystem_host;
use filesystem_host;

data WindowsFilesystemIo { }
data WindowsFilesystemImports { }
data WindowsFilesystemNativeProvider { }

boundary requirement WindowsFilesystemIo::c_create_file(path: &u8, desired_access: u32, share_mode: u32, security_attributes: u64, creation_disposition: u32, flags_and_attributes: u32, template: u64) -> i64
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;
boundary requirement WindowsFilesystemIo::c_write_file(handle: i64, bytes: &u8, count: u32, written: &mut u32, overlapped: u64) -> i32
reaches FilesystemContentWrite;
boundary requirement WindowsFilesystemIo::c_close_handle(handle: i64) -> i32;
boundary requirement WindowsFilesystemIo::c_get_last_error() -> u32;

windows_x86_64 machine windows_create_file_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "CreateFileW",
        },
    }
}
windows_x86_64 machine windows_write_file_binding() -> ForeignBinding<12, 9, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "WriteFile",
        },
    }
}
windows_x86_64 machine windows_close_handle_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "CloseHandle",
        },
    }
}
windows_x86_64 machine windows_get_last_error_binding() -> ForeignBinding<12, 12, 0> {
