windows_x86_64 machine WindowsFilesystemNativeProvider::provider_defaults(defaults: &mut WindowsFilesystemNativeProvider) {
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemHost, NativeWindowsFilesystem>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_read_file, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_flush_file_buffers, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_set_file_pointer, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_get_current_process, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_duplicate_handle, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_set_file_attributes, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_move_file, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_create_directory, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_remove_directory, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_delete_file, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_set_file_time, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_get_file_time, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_set_last_error, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_create_file, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_write_file, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_close_handle, WindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo::c_get_last_error, WindowsFilesystemImports>(defaults);
}

// Inline members bind the complete implementation to its existing target-owned
// bodies and foreign bindings. Forwarding preserves operation capability rows;
// the raw family's selection identity contributes no additional service reach.
NativeWindowsFilesystem satisfies WindowsFilesystemHost {
    machine create_file(path: &[u8] in Path, desired_access: u32, share_mode: u32, creation_disposition: u32, flags_and_attributes: u32) -> u64
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        WindowsFilesystemNativeProvider::create_file(path, desired_access, share_mode, creation_disposition, flags_and_attributes)
    }
    machine write_file(handle: u64, bytes: &[u8]) -> i64 reaches FilesystemContentWrite {
        WindowsFilesystemNativeProvider::write_file(handle, bytes)
    }
    machine close_handle(handle: u64) -> i32 { WindowsFilesystemNativeProvider::close_handle(handle) }
    machine last_error() -> u32 { WindowsFilesystemNativeProvider::last_error() }
    machine read_file(handle: u64, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemContentRead {
        WindowsFilesystemNativeProvider::read_file(handle, buffer, count)
    }
    machine flush_file_buffers(handle: u64) -> i32 { WindowsFilesystemNativeProvider::flush_file_buffers(handle) }
    machine set_file_pointer(handle: u64, distance: i64, method: u32) -> i64 {
        WindowsFilesystemNativeProvider::set_file_pointer(handle, distance, method)
    }
    machine duplicate_handle(handle: u64) -> u64 { WindowsFilesystemNativeProvider::duplicate_handle(handle) }
    machine move_file(from: &[u8] in Path, to: &[u8] in Path, flags: u32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        WindowsFilesystemNativeProvider::move_file(from, to, flags)
    }
    machine set_file_time(handle: u64, access_time: u64, write_time: u64) -> i32 reaches FilesystemMetadataMutation {
        WindowsFilesystemNativeProvider::set_file_time(handle, access_time, write_time)
    }
    machine get_file_time(handle: u64) -> WindowsFileTimeResult reaches FilesystemMetadataQuery {
        WindowsFilesystemNativeProvider::get_file_time(handle)
    }
    machine set_file_attributes(path: &[u8] in Path, attributes: u32) -> i32 reaches FilesystemMetadataMutation {
        WindowsFilesystemNativeProvider::set_file_attributes(path, attributes)
    }
    machine create_directory(path: &[u8] in Path) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation {
        WindowsFilesystemNativeProvider::create_directory(path)
    }
    machine remove_directory(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        WindowsFilesystemNativeProvider::remove_directory(path)
    }
    machine delete_file(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        WindowsFilesystemNativeProvider::delete_file(path)
    }
}
