// Complete windows_x86_64 `Clock` provider closure over kernel32 `Sleep`.
// Windows has no stable syscall ABI, so the leaf realizes through DLL linkage
// like every other Windows boundary leaf; `Sleep` takes the millisecond count
// as its single argument, so the leaf signature IS the requirement signature.
use omega::language::core::external_binding;
use clock;

windows_x86_64 machine clock_sleep_binding() -> ForeignBinding<12, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "Sleep",
        },
    }
}
windows_x86_64 machine ClockNativeProvider::sleep(milliseconds: u32)
    satisfies Clock::sleep
    via clock_sleep_binding();

windows_x86_64 machine ClockNativeProvider::provider_defaults(defaults: &mut ClockNativeProvider) {
    ClockNativeProvider::select_provider<Clock, NativeClock>(defaults);
}
