windows_x86_64 machine WindowsGuiNativeProvider::copy_bitmap_span(pixels: u64, stride: i32, height: i32, row: i32, left: i32, width: i32, source: &[i32]) -> bool
satisfies WindowsGuiHost::copy_bitmap_span reaches WindowsGuiHost {
    transition pixels > 0 && stride > 0 && stride <= 3840 && height > 0 && height <= 2160
        && row >= 0 && row < height && left >= 0 && left < stride && width > 0 && width <= (stride as i32 in Saturating) - (left as i32 in Saturating)
        && (left as u64) < source.len && (((left as u64 in Saturating) + (width as u64 in Saturating)) as u64) <= source.len {
        true -> copy(pixels, stride, row, left, width, source)
        _ -> (false)
    }
    state copy(pixels: u64, stride: i32, row: i32, left: i32, width: i32, source: &[i32]) -> bool
    requires stride > 0 && stride <= 3840 && row >= 0 && row < 2160 && left >= 0 && left < 3840 && width > 0 && width <= 3840 && (left as u64) < source.len {
        let offset: u64 = ((row as u64) * (stride as u64) + (left as u64)) * 4;
        let bytes: u64 = (width as u64) * 4;
        let end: u64 in Wrapping = (pixels as u64 in Wrapping) + (offset as u64 in Wrapping) + (bytes as u64 in Wrapping);
        transition end >= pixels {
            true -> write_span(pixels, offset, bytes, left, source)
            _ -> (false)
        }
    }
    state write_span(pixels: u64, offset: u64, bytes: u64, left: i32, source: &[i32]) -> bool
    requires left >= 0 && (left as u64) < source.len {
        let destination: u64 in Wrapping = (pixels as u64 in Wrapping) + (offset as u64 in Wrapping);
        WindowsGuiIo::copy_bitmap_memory(destination as u64, &source[left as u64], bytes);
        true
    }
}

windows_x86_64 machine WindowsGuiNativeProvider::copy_bitmap_rows(pixels: u64, stride: i32, height: i32, row: i32, left: i32, width: i32, count: i32, source: &[i32]) -> bool
satisfies WindowsGuiHost::copy_bitmap_rows reaches WindowsGuiHost {
    transition pixels > 0 && stride > 0 && stride <= 3840 && height > 0 && height <= 2160
        && row >= 0 && row < height && left >= 0 && left < stride && width > 0 && width <= (stride as i32 in Saturating) - (left as i32 in Saturating)
        && count > 0 && count <= (height as i32 in Saturating) - (row as i32 in Saturating)
        && (left as u64) < source.len && (((left as u64 in Saturating) + (width as u64 in Saturating)) as u64) <= source.len {
        true -> checked_range(pixels, stride, row, left, width, count, source)
        _ -> (false)
    }
    state checked_range(pixels: u64, stride: i32, row: i32, left: i32, width: i32, count: i32, source: &[i32]) -> bool
    requires stride > 0 && stride <= 3840 && row >= 0 && row < 2160 && left >= 0 && left < 3840 && width > 0 && width <= 3840 && count > 0 && count <= 2160 && (left as u64) < source.len {
        let first: u64 = ((row as u64) * (stride as u64) + (left as u64)) * 4;
        let last_row: u64 = (row as u64) + (count as u64) - 1;
        let last: u64 = (last_row * (stride as u64) + (left as u64) + (width as u64)) * 4;
        let end: u64 in Wrapping = (pixels as u64 in Wrapping) + (last as u64 in Wrapping);
        let destination: u64 in Wrapping = (pixels as u64 in Wrapping) + (first as u64 in Wrapping);
        transition (end as u64) >= pixels {
            true -> copy(destination as u64, (stride as u64) * 4, (width as u64) * 4, count, left, source)
            _ -> (false)
        }
    }
    // The complete destination range is admitted before the first write.
    state copy(destination: u64, stride_bytes: u64, bytes: u64, count: i32, left: i32, source: &[i32]) -> bool
    requires count > 0 && count <= 2160 && left >= 0 && (left as u64) < source.len {
        WindowsGuiIo::copy_bitmap_memory(destination, &source[left as u64], bytes);
        transition count > 1 { true -> next(destination, stride_bytes, bytes, count, left, source) _ -> (true) }
    }
    state next(destination: u64, stride_bytes: u64, bytes: u64, count: i32, left: i32, source: &[i32]) -> bool
    requires count > 1 && count <= 2160 && left >= 0 && (left as u64) < source.len {
        let next_destination: u64 in Wrapping = (destination as u64 in Wrapping) + (stride_bytes as u64 in Wrapping);
        transition { _ -> copy(next_destination as u64, stride_bytes, bytes, count - 1, left, source) }
    }
}

