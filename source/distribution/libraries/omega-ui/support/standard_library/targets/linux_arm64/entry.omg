use omega::language::core::extent;
use calling;
use entry_shapes;

// The Linux kernel enters a static ELF executable on AArch64 with the
// machine stack pointer at the initial process-stack image
// ([argc][argv...][NULL][envp...][NULL][auxv...]) and no return
// continuation; it delivers no argument registers, so the first image
// word (the argument count) is the only environment-supplied value this
// surface can name. A process completes through the exit_group
// supervisor call (svc #0, number 94 in x8) with its status in w0. The
// authored argument count introduces neither storage roots nor access
// authority, and the bridge observes the incoming stack pointer itself
// before switching to its private stack; the register vocabulary cannot
// name it as a value location. ProgramStorageEntry remains the separate
// semantic root crossing; its two Extents are internal bridge inputs,
// not hosted application arguments. This calling contract supplies no
// bridge, loader admission, receiver, or numeric stack guarantee.
// ProviderSelected requires independent backing.
boundary trait LinuxArm64PhysicalEntry {
    machine enter(argc: u64) -> i32;
}

data LinuxArm64 {}
LinuxArm64CallingPolicy satisfies CallingPolicy {
    CallingPolicy::plan = LinuxArm64::plan;
}

machine LinuxArm64::plan(signature: BoundarySignature) -> BoundaryPlanResult
    satisfies CallingPolicy::plan
{
    transition signature.parameter_count {
        1 -> physical(signature)
        2 -> semantic(signature)
        _ -> reject()
    }

    state physical(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.has_result {
            true -> physical_indices(signature, signature.parameters[0],
                signature.result)
            _ -> reject()
        }
    }

    state physical_indices(signature: BoundarySignature, argc: u64,
        result: u64) -> BoundaryPlanResult
    {
        transition argc < 256 && result < 256
            && argc < signature.shape_count && result < signature.shape_count
        {
            true -> physical_shapes(signature.shapes[argc],
                signature.shapes[result])
            _ -> reject()
        }
    }

    state physical_shapes(argc: ValueShape, result: ValueShape)
        -> BoundaryPlanResult
    {
        transition HostedEntryShapes::integer_shape(&argc, 8)
            && HostedEntryShapes::integer_shape(&result, 4)
        {
            true -> build_physical()
            _ -> reject()
        }
    }

    state build_physical() -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.parameter_count = 1;
        // The kernel arrival places the argument count as the first word of
        // the initial process-stack image; it is an input observation, not a
        // writable argument object. The image's base arrives in the machine
        // stack pointer, which the register vocabulary cannot name as a value
        // location; the generated bridge observes it before switching stacks.
        output.call.parameters[0] = LinuxArm64::stack_word(8);
        output.call.has_result = true;
        // Process completion status leaves in w0 under exit_group.
        output.call.result = LinuxArm64::named_word(4, 0);
        transition { _ -> finish(output, true) }
    }

    state semantic(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.has_result {
            false -> semantic_indices(signature, signature.parameters[0],
                signature.parameters[1])
            _ -> reject()
        }
    }

    state semantic_indices(signature: BoundarySignature, image: u64,
        storage: u64) -> BoundaryPlanResult
    {
        transition image < 256 && storage < 256
            && image < signature.shape_count && storage < signature.shape_count
        {
            true -> semantic_shapes(signature.shapes[image],
                signature.shapes[storage], signature)
            _ -> reject()
        }
    }

    state semantic_shapes(image: ValueShape, storage: ValueShape,
        signature: BoundarySignature) -> BoundaryPlanResult
    {
        transition HostedEntryShapes::extent_shape(image, &signature)
            && HostedEntryShapes::extent_shape(storage, &signature)
        {
            true -> build_semantic()
            _ -> reject()
        }
    }

    state build_semantic() -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.parameter_count = 2;
        // The generated bridge passes the image and initial-storage roots in
        // the first four AAPCS64 integer registers.
        output.call.parameters[0] = HostedEntryShapes::arm_extent_value(0, 1);
        output.call.parameters[1] = HostedEntryShapes::arm_extent_value(2, 3);
        transition { _ -> finish(output, false) }
    }

    state finish(output: BoundaryEntryPlan, supervisor: bool)
        -> BoundaryPlanResult
    {
        let mut plan: BoundaryEntryPlan = output;
        plan.call.convention = CallingConvention::Aapcs64;
        plan.call.stack_alignment = 16;
        transition supervisor {
            true -> finish_supervisor(plan)
            _ -> finish_call(plan)
        }
    }

    state finish_supervisor(plan: BoundaryEntryPlan) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan = plan;
        // The kernel supplies no return continuation; the physical contract
        // completes through exit_group (x8 = 94) with status in w0.
        output.call.entry_control = EntryControl::SupervisorCall {
            number_register: MachineRegister::Aarch64X { index: 8 },
            immediate: 94,
        };
        transition { _ -> seal(output) }
    }

    state finish_call(plan: BoundaryEntryPlan) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan = plan;
        output.call.entry_control = EntryControl::CallReturn;
        transition { _ -> seal(output) }
    }

    state seal(plan: BoundaryEntryPlan) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan = plan;
        // Standard AAPCS64 volatile banks; x18 is platform-reserved. The
        // bridge may also observe the incoming stack pointer before switching
        // to its private stack.
        output.call.ordinary_clobbers.register_count = 42;
        output.call.ordinary_clobbers.registers[0] = MachineRegister::Aarch64X { index: 0 };
        output.call.ordinary_clobbers.registers[1] = MachineRegister::Aarch64X { index: 1 };
        output.call.ordinary_clobbers.registers[2] = MachineRegister::Aarch64X { index: 2 };
        output.call.ordinary_clobbers.registers[3] = MachineRegister::Aarch64X { index: 3 };
        output.call.ordinary_clobbers.registers[4] = MachineRegister::Aarch64X { index: 4 };
        output.call.ordinary_clobbers.registers[5] = MachineRegister::Aarch64X { index: 5 };
        output.call.ordinary_clobbers.registers[6] = MachineRegister::Aarch64X { index: 6 };
        output.call.ordinary_clobbers.registers[7] = MachineRegister::Aarch64X { index: 7 };
        output.call.ordinary_clobbers.registers[8] = MachineRegister::Aarch64X { index: 8 };
        output.call.ordinary_clobbers.registers[9] = MachineRegister::Aarch64X { index: 9 };
        output.call.ordinary_clobbers.registers[10] = MachineRegister::Aarch64X { index: 10 };
        output.call.ordinary_clobbers.registers[11] = MachineRegister::Aarch64X { index: 11 };
        output.call.ordinary_clobbers.registers[12] = MachineRegister::Aarch64X { index: 12 };
        output.call.ordinary_clobbers.registers[13] = MachineRegister::Aarch64X { index: 13 };
        output.call.ordinary_clobbers.registers[14] = MachineRegister::Aarch64X { index: 14 };
        output.call.ordinary_clobbers.registers[15] = MachineRegister::Aarch64X { index: 15 };
        output.call.ordinary_clobbers.registers[16] = MachineRegister::Aarch64X { index: 16 };
        output.call.ordinary_clobbers.registers[17] = MachineRegister::Aarch64X { index: 17 };
        output.call.ordinary_clobbers.registers[18] = MachineRegister::Aarch64V { index: 0 };
        output.call.ordinary_clobbers.registers[19] = MachineRegister::Aarch64V { index: 1 };
        output.call.ordinary_clobbers.registers[20] = MachineRegister::Aarch64V { index: 2 };
        output.call.ordinary_clobbers.registers[21] = MachineRegister::Aarch64V { index: 3 };
        output.call.ordinary_clobbers.registers[22] = MachineRegister::Aarch64V { index: 4 };
        output.call.ordinary_clobbers.registers[23] = MachineRegister::Aarch64V { index: 5 };
        output.call.ordinary_clobbers.registers[24] = MachineRegister::Aarch64V { index: 6 };
        output.call.ordinary_clobbers.registers[25] = MachineRegister::Aarch64V { index: 7 };
        output.call.ordinary_clobbers.registers[26] = MachineRegister::Aarch64V { index: 16 };
        output.call.ordinary_clobbers.registers[27] = MachineRegister::Aarch64V { index: 17 };
        output.call.ordinary_clobbers.registers[28] = MachineRegister::Aarch64V { index: 18 };
        output.call.ordinary_clobbers.registers[29] = MachineRegister::Aarch64V { index: 19 };
        output.call.ordinary_clobbers.registers[30] = MachineRegister::Aarch64V { index: 20 };
        output.call.ordinary_clobbers.registers[31] = MachineRegister::Aarch64V { index: 21 };
        output.call.ordinary_clobbers.registers[32] = MachineRegister::Aarch64V { index: 22 };
        output.call.ordinary_clobbers.registers[33] = MachineRegister::Aarch64V { index: 23 };
        output.call.ordinary_clobbers.registers[34] = MachineRegister::Aarch64V { index: 24 };
        output.call.ordinary_clobbers.registers[35] = MachineRegister::Aarch64V { index: 25 };
        output.call.ordinary_clobbers.registers[36] = MachineRegister::Aarch64V { index: 26 };
        output.call.ordinary_clobbers.registers[37] = MachineRegister::Aarch64V { index: 27 };
        output.call.ordinary_clobbers.registers[38] = MachineRegister::Aarch64V { index: 28 };
        output.call.ordinary_clobbers.registers[39] = MachineRegister::Aarch64V { index: 29 };
        output.call.ordinary_clobbers.registers[40] = MachineRegister::Aarch64V { index: 30 };
        output.call.ordinary_clobbers.registers[41] = MachineRegister::Aarch64V { index: 31 };
        output.state.initial_regime = MachineRegime::Aarch64A64 {
            exception_level: 0
        };
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.vector_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: output }
    }

    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection {
                reason: "LinuxArm64Application requires exact physical or program-storage entry shapes",
            },
        }
    }
}

machine LinuxArm64::named_word(bytes: u64, register: u64) -> ValuePlacement {
    let mut value: ValuePlacement;
    value.shape.class = AbiValueClass::Integer;
    value.shape.byte_size = bytes;
    value.shape.alignment = bytes;
    value.location_count = 1;
    value.locations[0] = ValueLocation::Register {
        register: MachineRegister::Aarch64X { index: register },
        value_byte_offset: 0, byte_size: bytes,
    };
    value
}

machine LinuxArm64::stack_word(bytes: u64) -> ValuePlacement {
    // The kernel places the argument count at the base of the incoming
    // process-stack image; a stack location names that delivery without a
    // stack-pointer register the value vocabulary does not carry.
    let mut value: ValuePlacement;
    value.shape.class = AbiValueClass::Integer;
    value.shape.byte_size = bytes;
    value.shape.alignment = bytes;
    value.location_count = 1;
    value.locations[0] = ValueLocation::Stack {
        stack_byte_offset: 0,
        value_byte_offset: 0, byte_size: bytes,
        alignment: bytes,
    };
    value
}

boundary trait LinuxArm64Application: ProgramStorageEntry + LinuxArm64PhysicalEntry + Calling<LinuxArm64CallingPolicy> {}
