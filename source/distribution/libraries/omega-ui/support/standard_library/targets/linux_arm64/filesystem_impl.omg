// Linux AArch64 ABI facts for the shared POSIX portable service. The kernel's
// asm-generic/stat.h record is 128 bytes, aligned to 8: nlink and blksize are
// 32-bit fields, unlike x86-64. Its reserved tail is not a birth timestamp.
// Source: Linux v6.12 include/uapi/asm-generic/{stat,fcntl,errno-base,errno}.h;
// glibc's AArch64 libc.abilist assigns these three imports GLIBC_2.17.
use omega::language::core::external_binding;
use omega::language::core::layout;
use omega::language::core::numeric_conversion;
use filesystem;
use posix_filesystem_adapter;

data LinuxArm64StatRecord {
    dev: u64;
    mode: u32;
    nlink: u32;
    ino: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    atime: i64;
    mtime: i64;
    ctime: i64;
    size: i64;
    blocks: i64;
    blksize: i32;
}
data LinuxArm64StatLayout {}
data LinuxArm64StatView { value: LinuxArm64StatLayout<LinuxArm64StatRecord>; }

linux_arm64 machine LinuxArm64StatLayout::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 16 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 20 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 8 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 24 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 28 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::At { offset: 32 } };
    entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 72 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 88 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 104 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 48 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 64 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 56 } };
    Plan { entries: entries, entry_count: 13, size_fixed: 128, size_is_dynamic: false, align: 8 }
}

linux_arm64 machine PosixFilesystem::decode_metadata(filesystem: &mut PosixFilesystem) -> MetadataResult {
    let stat: &LinuxArm64StatView = &filesystem.stat_buf[0] as &LinuxArm64StatView;
    let blocks: i64 = stat.value.blocks;
    let blksize: i64 = stat.value.blksize as i64;
    transition blocks >= 0 && blksize >= 0 {
        true -> decode(stat, blocks, blksize)
        _ -> MetadataResult::Error { kind: ErrorKind::InvalidInput }
    }
    state decode(stat: &LinuxArm64StatView, blocks: i64, blksize: i64) -> MetadataResult
    requires blocks >= 0 && blksize >= 0;
    {
        let mode: u32 = stat.value.mode;
        let details: PosixMetadata = PosixMetadata {
            mode: mode,
            ino: stat.value.ino,
            dev: stat.value.dev,
            uid: stat.value.uid,
            gid: stat.value.gid,
            rdev: stat.value.rdev,
            blocks: narrow_i64_to_u64_exact(blocks),
            blksize: narrow_i64_to_u64_exact(blksize),
        };
        let metadata: Metadata = Metadata {
            len: stat.value.size,
            kind: posix_metadata_kind(mode),
            permissions: Permissions::Posix { mode: mode & 4095 },
            nlink: stat.value.nlink as u64,
            posix: PosixMetadataResult::Ok { details: details },
            modified_secs: stat.value.mtime,
            accessed_secs: stat.value.atime,
            creation_time: TimestampResult::Error { kind: ErrorKind::Unsupported },
            changed_secs: stat.value.ctime,
        };
        MetadataResult::Ok { meta: metadata }
    }
}

linux_arm64 machine PosixFilesystem::permission_bits(filesystem: &PosixFilesystem) -> u32 {
    let stat: &LinuxArm64StatView = &filesystem.stat_buf[0] as &LinuxArm64StatView;
    stat.value.mode & 4095
}

linux_arm64 machine PosixFilesystem::encode_open_options(filesystem: &mut PosixFilesystem) {
    filesystem.open_writable = (filesystem.open_options.write as i32) | (filesystem.open_options.append as i32);
    filesystem.open_readable = filesystem.open_options.read as i32;
    filesystem.open_creating = (filesystem.open_options.create as i32) | (filesystem.open_options.create_new as i32);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | ((filesystem.open_options.append as i32) << 10)
        | (filesystem.open_creating << 6)
        | ((filesystem.open_options.truncate as i32) << 9)
        | ((filesystem.open_options.create_new as i32) << 7));
}

// Resolve an absent directory hint from the native mode without decoding
// unrelated size/timestamp fields or following a final symlink.
linux_arm64 machine PosixFilesystem::decode_directory_kind(filesystem: &mut PosixFilesystem) -> PosixDirectoryKind {
    let stat: &LinuxArm64StatView = &filesystem.stat_buf[0] as &LinuxArm64StatView;
    let kind: u32 = stat.value.mode & 61440;
    transition kind {
        16384 -> PosixDirectoryKind::Directory
        32768 -> PosixDirectoryKind::Regular
        _ -> PosixDirectoryKind::Other
    }
}
linux_arm64 machine PosixFilesystem::metadata_no_follow_flag() -> i32 { 256 }

linux_arm64 machine PosixFilesystem::directory_type_offset() -> u64
    ensures result >= 18 && result <= 20
{ 18 }
linux_arm64 machine PosixFilesystem::directory_name_offset() -> u64
    ensures result >= 19 && result <= 21
{ 19 }
linux_arm64 machine PosixFilesystem::remove_directory_flag() -> i32 { 512 }
linux_arm64 machine PosixFilesystem::directory_descent_flags() -> i32 { 49152 }
linux_arm64 machine PosixFilesystem::would_block_error() -> i32 { 11 }

linux_arm64 machine FilesystemProviderDefaults::provider_defaults(defaults: &mut FilesystemProviderDefaults) {
    FilesystemProviderDefaults::select_provider<FilesystemService, FilesystemPosixProvider>(defaults);
}

linux_arm64 machine linux_arm64_realpath_binding() -> ForeignBinding<9, 8, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "realpath", version: "GLIBC_2.17",
    } }
}
linux_arm64 machine linux_arm64_errno_location_binding() -> ForeignBinding<9, 16, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "__errno_location", version: "GLIBC_2.17",
    } }
}
linux_arm64 machine linux_arm64_errno_copy_binding() -> ForeignBinding<9, 6, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcpy", version: "GLIBC_2.17",
    } }
}
linux_arm64 machine PosixCanonicalImports::provider_defaults(defaults: &mut PosixCanonicalImports) {
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::resolve, PosixCanonicalImports>(defaults);
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::error_location, PosixCanonicalImports>(defaults);
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::copy_error, PosixCanonicalImports>(defaults);
}
linux_arm64 machine PosixCanonicalImports::resolve(path: &[u8; 4096], output: &mut [u8; 4096]) -> u64
satisfies PosixCanonicalLibc::resolve via linux_arm64_realpath_binding();
linux_arm64 machine PosixCanonicalImports::error_location() -> u64
satisfies PosixCanonicalLibc::error_location via linux_arm64_errno_location_binding();
linux_arm64 machine PosixCanonicalImports::copy_error(destination: &mut [u8; 4], source: u64, count: u64) -> u64
satisfies PosixCanonicalLibc::copy_error via linux_arm64_errno_copy_binding();

linux_arm64 machine PosixFilesystem::kind_of_stored_error_code(filesystem: &mut PosixFilesystem) -> ErrorKind {
    filesystem.err_kind = match filesystem.err_code {
        2 -> ErrorKind::NotFound,
        13 -> ErrorKind::PermissionDenied,
        1 -> ErrorKind::PermissionDenied,
        17 -> ErrorKind::AlreadyExists,
        9 -> ErrorKind::BadDescriptor,
        21 -> ErrorKind::IsADirectory,
        11 -> ErrorKind::WouldBlock,
        22 -> ErrorKind::InvalidInput,
        34 -> ErrorKind::InvalidInput,
        36 -> ErrorKind::InvalidInput,
        38 -> ErrorKind::Unsupported,
        95 -> ErrorKind::Unsupported,
        _ -> ErrorKind::Other
    };
    ErrorKind::reconstruct(&filesystem.err_kind)
}
