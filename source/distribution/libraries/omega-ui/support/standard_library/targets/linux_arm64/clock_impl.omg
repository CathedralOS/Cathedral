// Linux ARM64 nanosleep consumes a borrowed __kernel_timespec, not the
// millisecond count itself. Keep the request in ordinary checked local
// storage: its reference carries the address through the native call ABI.
// Both kernel fields are signed 64-bit integers, in seconds/nanoseconds order.
// https://github.com/torvalds/linux/blob/master/include/uapi/linux/time_types.h
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use clock;

public data LinuxArmClockSleepRequest { seconds: i64; nanoseconds: i64; }

data LinuxArmClockWait { }

boundary requirement LinuxArmClockWait::nanosleep(request: &LinuxArmClockSleepRequest, remainder: u64)
reaches
    Clock;

data LinuxArmClockNanosleep { }

linux_arm64 machine LinuxArmClockNanosleep::nanosleep(request: &LinuxArmClockSleepRequest, remainder: u64)
    satisfies LinuxArmClockWait::nanosleep
    via ForeignBinding::Syscall(101);

// Splitting before widening preserves every u32 duration and keeps the
// fractional field below one billion. A null remainder asks the kernel not
// to write back interrupted time; signals may interrupt this wait, as on
// the other POSIX Clock providers.
linux_arm64 machine ClockNativeProvider::sleep(milliseconds: u32)
    satisfies Clock::sleep
reaches
    Clock
{
    let request: LinuxArmClockSleepRequest = LinuxArmClockSleepRequest {
        seconds: widen_u32_to_i64(milliseconds / 1000),
        nanoseconds: widen_u32_to_i64(milliseconds % 1000) * 1000000
    };
    LinuxArmClockWait::nanosleep(&request, 0);
}

linux_arm64 machine ClockNativeProvider::provider_defaults(defaults: &mut ClockNativeProvider) {
    ClockNativeProvider::select_provider<Clock, NativeClock>(defaults);
    ClockNativeProvider::select_provider<LinuxArmClockWait::nanosleep, LinuxArmClockNanosleep>(defaults);
}
