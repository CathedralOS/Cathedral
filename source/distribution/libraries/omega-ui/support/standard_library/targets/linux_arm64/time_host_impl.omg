// linux_arm64 `TimeHost` provider.
//
// Same kernel interface as the x86-64 sibling, DIFFERENT syscall numbers:
// arm64 uses the asm-generic table, so nothing here may be derived from the
// x86-64 file by renaming the target. Every number was read out of the kernel
// sources:
//   `#define __NR_clock_gettime 113`  — include/uapi/asm-generic/unistd.h
//   `#define __NR_nanosleep 101`      — the same header;
//       `targets/linux_arm64/clock_impl.omg` already binds it, which
//       independently corroborates that this target uses that table.
//   `#define CLOCK_REALTIME 0`, `#define CLOCK_MONOTONIC 1`
//                                    — include/uapi/linux/time.h
//   `struct __kernel_timespec { __kernel_time64_t tv_sec; long long tv_nsec; }`
//                                    — include/uapi/linux/time_types.h
// The asm-generic table has no `poll` (it publishes `ppoll` instead), which is
// why this target waits with `nanosleep` and a borrowed timespec while the
// x86-64 sibling waits with `poll` and a signed millisecond count — exactly
// the split the two `clock_impl.omg` files already make.
//
// NATIVE EXECUTION IS UNVERIFIED. This host is macOS arm64 and cannot execute
// a linux_arm64 product. The evidence for this file is Psi checking plus the
// native artifact's terminal-authority closure review resolving every
// `TimeHost` requirement to a selected provider row.
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use time_host;

// The kernel's 64-bit timespec, in declaration order; both fields are signed.
// One record serves the read out-parameter and the sleep in-parameter.
public data LinuxArm64TimeHostInstant { seconds: i64; nanoseconds: i64; }

// Per-target requirement carriers. A `boundary requirement` is target-neutral,
// so each target's seam owns its own carrier type rather than re-declaring a
// shared path.
data LinuxArm64TimeRead { }

boundary requirement LinuxArm64TimeRead::clock_gettime(clock_id: u32, instant: &mut LinuxArm64TimeHostInstant) -> i64
reaches TimeHost;

boundary requirement LinuxArm64TimeRead::nanosleep(request: &LinuxArm64TimeHostInstant, remainder: u64) -> i64
reaches TimeHost
blocks;

data LinuxArm64TimeImports { }

linux_arm64 machine LinuxArm64TimeImports::clock_gettime(clock_id: u32, instant: &mut LinuxArm64TimeHostInstant) -> i64
    satisfies LinuxArm64TimeRead::clock_gettime
    via ForeignBinding::Syscall(113);

linux_arm64 machine LinuxArm64TimeImports::nanosleep(request: &LinuxArm64TimeHostInstant, remainder: u64) -> i64
    satisfies LinuxArm64TimeRead::nanosleep
    via ForeignBinding::Syscall(101)
    blocks;

// `seconds * 1_000_000_000 + nanoseconds` in the Wrapping spelling
// `Time::now` already uses for the same reason: the interval fold cannot
// multiply variable bounds, so a proven-in-range multiply is not expressible
// here. The product cannot wrap for any real clock — u64 holds 18_446_744_073
// seconds of nanoseconds — and a kernel reporting more reads as a degraded
// tick count instead of faulting.
public machine linux_arm64_time_host_ticks(seconds: i64, nanoseconds: i64) -> u64 {
    let seconds_unsigned: u64 = narrow_i64_to_u64_saturating(seconds);
    let nanoseconds_unsigned: u64 = narrow_i64_to_u64_saturating(nanoseconds);
    let scaled: u64 in Wrapping = (seconds_unsigned as u64 in Wrapping) * 1000000000;
    let total: u64 in Wrapping = scaled + (nanoseconds_unsigned as u64 in Wrapping);
    total as u64
}

// A failed read reports zero rather than a fabricated tick count: `Time::now`
// treats zero as a degraded clock and never faults on it.
linux_arm64 machine TimeHostNativeProvider::monotonic_ticks() -> u64
    satisfies TimeHost::monotonic_ticks
reaches TimeHost
{
    let mut instant: LinuxArm64TimeHostInstant = LinuxArm64TimeHostInstant { seconds: 0, nanoseconds: 0 };
    let status: i64 = LinuxArm64TimeRead::clock_gettime(1, &mut instant);
    transition status == 0 {
        true -> measured(instant.seconds, instant.nanoseconds)
        _ -> degraded()
    }

    state measured(seconds: i64, nanoseconds: i64) -> u64 {
        linux_arm64_time_host_ticks(seconds, nanoseconds)
    }

    state degraded() -> u64 { 0 }
}

linux_arm64 machine TimeHostNativeProvider::monotonic_ticks_per_second() -> u64
    satisfies TimeHost::monotonic_ticks_per_second
{
    1000000000
}

linux_arm64 machine TimeHostNativeProvider::wall_clock_raw() -> u64
    satisfies TimeHost::wall_clock_raw
reaches TimeHost
{
    let mut instant: LinuxArm64TimeHostInstant = LinuxArm64TimeHostInstant { seconds: 0, nanoseconds: 0 };
    let status: i64 = LinuxArm64TimeRead::clock_gettime(0, &mut instant);
    transition status == 0 {
        true -> measured(instant.seconds, instant.nanoseconds)
        _ -> degraded()
    }

    state measured(seconds: i64, nanoseconds: i64) -> u64 {
        linux_arm64_time_host_ticks(seconds, nanoseconds)
    }

    state degraded() -> u64 { 0 }
}

// CLOCK_REALTIME is already Unix-epoch nanoseconds, so the units are 10^9 and
// the epoch shift is zero — unlike Windows, whose FILETIME needs both.
linux_arm64 machine TimeHostNativeProvider::wall_clock_units_per_second() -> u64
    satisfies TimeHost::wall_clock_units_per_second
{
    1000000000
}

linux_arm64 machine TimeHostNativeProvider::wall_clock_epoch_offset_seconds() -> u64
    satisfies TimeHost::wall_clock_epoch_offset_seconds
{
    0
}

// Splitting before widening preserves every u32 duration and keeps the
// fractional field below one billion, as this target's `Clock` provider does.
// A null remainder asks the kernel not to write back interrupted time; an
// interrupted wait is retried in full, which can oversleep — this boundary
// promises neither an upper duration nor termination.
linux_arm64 machine TimeHostNativeProvider::sleep(milliseconds: u32)
    satisfies TimeHost::sleep
reaches TimeHost
blocks;
{
    transition { _ -> wait(milliseconds) }

    state wait(milliseconds: u32) {
        let request: LinuxArm64TimeHostInstant = LinuxArm64TimeHostInstant {
            seconds: widen_u32_to_i64(milliseconds / 1000),
            nanoseconds: widen_u32_to_i64(milliseconds % 1000) * 1000000
        };
        let outcome: i64 = block LinuxArm64TimeRead::nanosleep(&request, 0);
        transition outcome == 0 {
            true -> done()
            _ -> wait(milliseconds)
        }
    }

    state done() { }
}

linux_arm64 machine TimeHostNativeProvider::provider_defaults(defaults: &mut TimeHostNativeProvider) {
    TimeHostNativeProvider::select_provider<TimeHost, NativeTimeHost>(defaults);
    TimeHostNativeProvider::select_provider<LinuxArm64TimeRead::clock_gettime, LinuxArm64TimeImports>(defaults);
    TimeHostNativeProvider::select_provider<LinuxArm64TimeRead::nanosleep, LinuxArm64TimeImports>(defaults);
}
