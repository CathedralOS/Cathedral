    satisfies PosixFilesystemLinuxArm64ByteViews::pread64
    via ForeignBinding::Syscall(67);
linux_arm64 machine PosixFilesystemLinuxSyscalls::pwrite64(fd: i32, bytes: &[u8], offset: i64) -> i64
    satisfies PosixFilesystemLinuxArm64ByteViews::pwrite64
    via ForeignBinding::Syscall(68);
linux_arm64 machine PosixFilesystemLinuxSyscalls::close(fd: i32) -> i32
    satisfies PosixFilesystemLinux::close
    via ForeignBinding::Syscall(57);
linux_arm64 machine PosixFilesystemLinuxSyscalls::lseek(fd: i32, offset: i64, whence: i32) -> i64
    satisfies PosixFilesystemLinux::lseek
    via ForeignBinding::Syscall(62);
linux_arm64 machine PosixFilesystemLinuxSyscalls::mkdirat(dirfd: i32, path: &u8, mode: i32) -> i32
    satisfies PosixFilesystemLinux::mkdirat
    via ForeignBinding::Syscall(34);
linux_arm64 machine PosixFilesystemLinuxSyscalls::unlinkat(dirfd: i32, path: &u8, flags: i32) -> i32
    satisfies PosixFilesystemLinux::unlinkat
    via ForeignBinding::Syscall(35);
linux_arm64 machine PosixFilesystemLinuxSyscalls::fchmodat(dirfd: i32, path: &u8, mode: u32) -> i32
    satisfies PosixFilesystemLinux::fchmodat
    via ForeignBinding::Syscall(53);
linux_arm64 machine PosixFilesystemLinuxSyscalls::fchmod(fd: i32, mode: u32) -> i32
    satisfies PosixFilesystemLinux::fchmod
    via ForeignBinding::Syscall(52);
linux_arm64 machine PosixFilesystemLinuxSyscalls::renameat(from_dirfd: i32, from: &u8, to_dirfd: i32, to: &u8) -> i32
    satisfies PosixFilesystemLinux::renameat
    via ForeignBinding::Syscall(38);
linux_arm64 machine PosixFilesystemLinuxSyscalls::linkat(from_dirfd: i32, from: &u8, to_dirfd: i32, to: &u8, flags: i32) -> i32
    satisfies PosixFilesystemLinux::linkat
    via ForeignBinding::Syscall(37);
linux_arm64 machine PosixFilesystemLinuxSyscalls::symlinkat(target: &u8, link_dirfd: i32, link: &u8) -> i32
