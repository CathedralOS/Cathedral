    via ForeignBinding::Syscall(36);
linux_arm64 machine PosixFilesystemLinuxSyscalls::readlinkat(dirfd: i32, path: &[u8; 4096], buffer: &mut [u8]) -> i64
    satisfies PosixFilesystemLinuxArm64ByteViews::readlinkat
    via ForeignBinding::Syscall(78);
linux_arm64 machine PosixFilesystemLinuxSyscalls::getdents64(fd: i32, buffer: &mut [u8]) -> i64
    satisfies PosixFilesystemLinuxArm64ByteViews::getdents64
    via ForeignBinding::Syscall(61);
linux_arm64 machine PosixFilesystemLinuxSyscalls::newfstatat(dirfd: i32, path: &u8, buffer: &mut u8, flags: i32) -> i32
