linux_arm64 machine PosixFilesystemNativeProvider::provider_defaults(defaults: &mut PosixFilesystemNativeProvider) {
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemHost, PosixFilesystemImplementation>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::openat, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::close, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::lseek, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::mkdirat, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::unlinkat, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::fchmodat, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::fchmod, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::renameat, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::linkat, PosixFilesystemLinuxSyscalls>(defaults);
    PosixFilesystemNativeProvider::select_provider<PosixFilesystemLinux::symlinkat, PosixFilesystemLinuxSyscalls>(defaults);
