use omega::language::core::filesystem_authority;
// Linux arm64 POSIX filesystem service: the same kernel-shaped
// requirements and adapters as linux_x86_64 (`targets/linux_x86_64/
// posix_filesystem_impl.omg`), satisfied with arm64 system call numbers.
use omega::language::core::external_binding;
use posix_filesystem_host;
use math;
use posix_byte_view_calling;
use calling;

// This native requirement application fixes its kernel calling convention.
boundary trait PosixFilesystemLinuxArm64ByteViews: Calling<LinuxArm64ByteViewCalling> {
    machine read(fd: i32, buffer: &mut [u8]) -> i64 reaches FilesystemContentRead;
    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite;
    machine pread64(fd: i32, buffer: &mut [u8], offset: i64) -> i64 reaches FilesystemContentRead;
    machine pwrite64(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite;
    machine readlinkat(dirfd: i32, path: &[u8; 4096], buffer: &mut [u8]) -> i64 reaches FilesystemMetadataQuery;
    machine getdents64(fd: i32, buffer: &mut [u8]) -> i64 reaches DirectoryEnumeration;
}

use filesystem_host;
use targets::linux_x86_64::posix_filesystem_impl;

linux_arm64 machine PosixFilesystemLinuxSyscalls::openat(dirfd: i32, path: &u8, flags: i32, mode: i32) -> i32
    satisfies PosixFilesystemLinux::openat
    via ForeignBinding::Syscall(56);
linux_arm64 machine PosixFilesystemLinuxSyscalls::read(fd: i32, buffer: &mut [u8]) -> i64
    satisfies PosixFilesystemLinuxArm64ByteViews::read
    via ForeignBinding::Syscall(63);
linux_arm64 machine PosixFilesystemLinuxSyscalls::write(fd: i32, bytes: &[u8]) -> i64
    satisfies PosixFilesystemLinuxArm64ByteViews::write
    via ForeignBinding::Syscall(64);
