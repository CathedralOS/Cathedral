linux_arm64 machine PosixFilesystemNativeProvider::rename(from: &[u8] in Path, to: &[u8] in Path) -> i32
    satisfies PosixFilesystemHost::rename
reaches FilesystemNamespaceMutation
{
    let mut first: [u8; 4096];
    let mut second: [u8; 4096];
    let first_fits: bool = posix_terminated_path(from, &mut first);
    let second_fits: bool = posix_terminated_path(to, &mut second);
    let outcome: i32 = PosixFilesystemLinux::renameat(-100, &first[0], -100, &second[0]);
    transition first_fits && second_fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    state settle(outcome: i32) -> i32 {
        outcome
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32
    satisfies PosixFilesystemHost::hard_link
reaches FilesystemNamespaceMutation
{
    let mut first: [u8; 4096];
    let mut second: [u8; 4096];
    let first_fits: bool = posix_terminated_path(original, &mut first);
    let second_fits: bool = posix_terminated_path(link, &mut second);
    let outcome: i32 = PosixFilesystemLinux::linkat(-100, &first[0], -100, &second[0], 0);
    transition first_fits && second_fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    state settle(outcome: i32) -> i32 {
        outcome
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::symlink(target: &[u8] in Path, link: &[u8] in Path) -> i32
    satisfies PosixFilesystemHost::symlink
reaches FilesystemNamespaceMutation
{
    let mut first: [u8; 4096];
    let mut second: [u8; 4096];
    let first_fits: bool = posix_terminated_path(target, &mut first);
    let second_fits: bool = posix_terminated_path(link, &mut second);
    let outcome: i32 = PosixFilesystemLinux::symlinkat(&first[0], -100, &second[0]);
    transition first_fits && second_fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    state settle(outcome: i32) -> i32 {
        outcome
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> i64
    satisfies PosixFilesystemHost::read_link
reaches FilesystemMetadataQuery
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    transition fits { true -> transfer(terminated, buffer, count) _ -> -36 }
    state transfer(terminated: [u8; 4096], buffer: &mut [u8], count: u64) -> i64 {
        // readlinkat's bufsiz is a signed int, not an arbitrary staging limit.
        let capacity: u64 = min_u64(min_u64(count, buffer.len), 2147483647);
        PosixFilesystemLinuxSyscalls::readlinkat(-100, &terminated, &mut buffer[0..capacity])
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::read_dir(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64
    satisfies PosixFilesystemHost::read_dir
reaches DirectoryEnumeration
{
    // The directory callback's remaining-count field is a signed int.
    let capacity: u64 = min_u64(min_u64(count, buffer.len), 2147483647);
    PosixFilesystemLinuxSyscalls::getdents64(fd, &mut buffer[0..capacity])
}

