// macos_x86_64 `TimeHost` provider: the SAME Darwin mechanism the
// `macos_arm64` sibling binds, scoped to the other Darwin target.
//
// A machine carries exactly one target scope, so a body cannot be shared
// across two targets; `console_impl.omg` and `core`'s `float_impl.omg` are
// already duplicated between the two Darwin targets for that reason. What is
// NOT duplicated here is the requirement carrier: `boundary requirement`
// declarations are target-neutral, so re-declaring `TimeHostNativeProvider::
// clock_nanoseconds` would collide with the arm64 file. This file owns its
// own `DarwinX64TimeRead` carrier instead, which is the shape
// `targets/linux_x86_64/clock_impl.omg` (`LinuxClockWait`) and
// `targets/linux_arm64/clock_impl.omg` (`LinuxArmClockWait`) already use to
// keep two targets' per-OS seams apart.
//
// `_clock_gettime_nsec_np` is confirmed present for BOTH Darwin targets, not
// assumed from the arm64 provider: the SDK's `usr/lib/libSystem.tbd` lists it
// under `targets: [ x86_64-macos, x86_64-maccatalyst, arm64-macos,
// arm64-maccatalyst, arm64e-macos, arm64e-maccatalyst ]`. Apple's source for
// the selected clocks is Libc/gen/clock_gettime.c:
// https://github.com/apple-oss-distributions/Libc/blob/main/gen/clock_gettime.c
// Selector 8 is `_CLOCK_UPTIME_RAW` and 0 is `_CLOCK_REALTIME`, the same
// values the arm64 provider passes — the clock id namespace is per-OS, not
// per-architecture.
//
// This host is macOS arm64, so `macos_x86_64` products run here only under
// Rosetta; that is the native evidence for this file.
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use time_host;

data DarwinX64TimeRead { }

boundary requirement DarwinX64TimeRead::clock_nanoseconds(clock_id: u32) -> u64
reaches TimeHost;

boundary requirement DarwinX64TimeRead::poll(descriptors: u64, descriptor_count: u32, timeout_milliseconds: i32) -> i32
reaches TimeHost
blocks;

data DarwinX64TimeImports { }

macos_x86_64 machine time_host_clock_binding_macos_x86_64() -> ForeignBinding<26, 22, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_clock_gettime_nsec_np",
        },
    }
}

macos_x86_64 machine time_host_poll_binding_macos_x86_64() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_poll",
        },
    }
}

macos_x86_64 machine DarwinX64TimeImports::clock_nanoseconds(clock_id: u32) -> u64
    satisfies DarwinX64TimeRead::clock_nanoseconds
    via time_host_clock_binding_macos_x86_64();

macos_x86_64 machine DarwinX64TimeImports::poll(descriptors: u64, descriptor_count: u32, timeout_milliseconds: i32) -> i32
    satisfies DarwinX64TimeRead::poll
    via time_host_poll_binding_macos_x86_64()
    blocks;

macos_x86_64 machine TimeHostNativeProvider::monotonic_ticks() -> u64
    satisfies TimeHost::monotonic_ticks
reaches TimeHost
{
    DarwinX64TimeRead::clock_nanoseconds(8)
}

macos_x86_64 machine TimeHostNativeProvider::monotonic_ticks_per_second() -> u64
    satisfies TimeHost::monotonic_ticks_per_second
{
    1000000000
}

macos_x86_64 machine TimeHostNativeProvider::wall_clock_raw() -> u64
    satisfies TimeHost::wall_clock_raw
reaches TimeHost
{
    DarwinX64TimeRead::clock_nanoseconds(0)
}

macos_x86_64 machine TimeHostNativeProvider::wall_clock_units_per_second() -> u64
    satisfies TimeHost::wall_clock_units_per_second
{
    1000000000
}

macos_x86_64 machine TimeHostNativeProvider::wall_clock_epoch_offset_seconds() -> u64
    satisfies TimeHost::wall_clock_epoch_offset_seconds
{
    0
}

// poll's timeout is signed. Preserve the full u32 millisecond request by
// splitting large waits into signed-representable pieces, as the arm64
// Darwin provider does.
macos_x86_64 machine TimeHostNativeProvider::sleep(milliseconds: u32)
    satisfies TimeHost::sleep
reaches TimeHost
blocks;
{
    transition milliseconds > 2147483647 {
        true -> in_parts(milliseconds)
        _ -> at_once(milliseconds)
    }

    state at_once(milliseconds: u32) {
        block TimeHostNativeProvider::wait_part_macos_x86_64(narrow_u32_to_i32_wrapping(milliseconds));
    }

    state in_parts(milliseconds: u32) {
        let third: i32 = narrow_u32_to_i32_wrapping(milliseconds / 3);
        block TimeHostNativeProvider::wait_part_macos_x86_64(third);
        block TimeHostNativeProvider::wait_part_macos_x86_64(third);
        block TimeHostNativeProvider::wait_part_macos_x86_64(third);
        block TimeHostNativeProvider::wait_part_macos_x86_64(narrow_u32_to_i32_wrapping(milliseconds % 3));
    }
}

// No descriptors means zero reports a completed timeout. Retry failed waits
// instead of reporting sleep complete early. Repeating the full piece can
// oversleep; this boundary promises neither an upper duration nor termination.
macos_x86_64 machine TimeHostNativeProvider::wait_part_macos_x86_64(timeout_milliseconds: i32)
reaches TimeHost
blocks;
{
    transition { _ -> wait(timeout_milliseconds) }

    state wait(timeout_milliseconds: i32) {
        let outcome: i32 = block DarwinX64TimeRead::poll(0, 0, timeout_milliseconds);
        transition outcome == 0 {
            true -> done()
            _ -> wait(timeout_milliseconds)
        }
    }

    state done() { }
}

macos_x86_64 machine TimeHostNativeProvider::provider_defaults(defaults: &mut TimeHostNativeProvider) {
    TimeHostNativeProvider::select_provider<TimeHost, NativeTimeHost>(defaults);
    TimeHostNativeProvider::select_provider<DarwinX64TimeRead::clock_nanoseconds, DarwinX64TimeImports>(defaults);
    TimeHostNativeProvider::select_provider<DarwinX64TimeRead::poll, DarwinX64TimeImports>(defaults);
}
