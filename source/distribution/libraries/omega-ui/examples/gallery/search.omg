use omega_ui_windows::windows_host::WindowsUiHost;
module search;

use omega_ui::types::add_i32;
use omega_ui::types::select_i32;
use omega_ui_windows::text_field::WindowsTextField;


/*
The host's invisible Unicode edit supplies Windows text semantics, including
word navigation, selection, clipboard and undo. This record is only its bounded
paint/filter snapshot; the visible menu uses our own surfaces and typography.
The query belongs to the launcher, independently of the controls-page demo.
*/

use omega_ui::types;
use omega_ui_windows::text_field;

public data GallerySearch {
    field: WindowsTextField;
    results: [i32; 6];
    count: i32;
}

public data GalleryCommand where length <= 16u64 {
    label: [u8; 16];
    length: u64;
}

public machine title(command: i32) -> GalleryCommand {
    transition command {
        0 -> (GalleryCommand { label: "Controls        ", length: 8 })
        1 -> (GalleryCommand { label: "Tasks           ", length: 5 })
        2 -> (GalleryCommand { label: "Synthesizer     ", length: 11 })
        3 -> (GalleryCommand { label: "Appearance      ", length: 10 })
        4 -> (GalleryCommand { label: "Panels          ", length: 6 })
        _ -> (GalleryCommand { label: "Toggle theme    ", length: 12 })
    }
}

public machine matches(search_model: &GallerySearch, title: &[u8]) -> bool {
    transition search_model.field.length == 0 {
        true -> (true)
        _ -> start(search_model, title, 0u64)
    }
    machine start(search_model: &GallerySearch, title: &[u8], offset: u64) -> bool {
        transition offset < title.len && offset < 128u64 {
            true -> character(search_model, title, offset, 0u64)
            _ -> (false)
        }
    }
    machine character(search_model: &GallerySearch, title: &[u8], offset: u64, query: u64) -> bool
    requires offset < 128u64 && query <= 256u64 {
        let index: u64 = offset + query;
        transition query < 256u64 && (query as i32) < search_model.field.length && index < title.len {
            true -> compare(search_model, title, offset, query, index)
            _ -> ((query as i32) == search_model.field.length)
        }
    }
    machine compare(search_model: &GallerySearch, title: &[u8], offset: u64, query: u64, index: u64) -> bool
    requires offset < 128u64 && query < 256u64 && index < title.len {
        let typed: i32 = search_model.field.text[query] as i32;
        let letter: i32 = title[index] as i32;
        let a: i32 = select_i32(typed >= 65 && typed <= 90, add_i32(typed, 32), typed);
        let b: i32 = select_i32(letter >= 65 && letter <= 90, add_i32(letter, 32), letter);
        transition a == b {
            true -> character(search_model, title, offset, query + 1u64)
            _ -> start(search_model, title, offset + 1u64)
        }
    }
}

public machine refresh(search_model: &mut GallerySearch) reaches WindowsUiHost invokes WindowsUiHost; {
    omega_ui_windows::text_field::refresh(&mut search_model.field);
    search::update_results(search_model);
}

public machine update_results(search_model: &mut GallerySearch) {
    search_model.count = 0;
    transition { _ -> command(search_model, 0) }
    machine command(search_model: &mut GallerySearch, identifier: i32) {
        transition identifier >= 0 && identifier < 6 {
            true -> filter(search_model, identifier)
            _ -> done()
        }
    }
    machine filter(search_model: &mut GallerySearch, identifier: i32) requires identifier >= 0 && identifier < 6 {
        let title: GalleryCommand = search::title(identifier);
        let matches: bool = search::matches(search_model, &title.label[0..title.length]);
        let count: i32 = search_model.count;
        transition matches && count >= 0 && count < 6 {
            true -> include(search_model, identifier, count)
            _ -> command(search_model, identifier + 1)
        }
    }
    machine include(search_model: &mut GallerySearch, identifier: i32, count: i32) requires count >= 0 && count < 6 && identifier >= 0 && identifier < 6 {
        search_model.results[count] = identifier;
        search_model.count = count + 1;
        transition { _ -> command(search_model, identifier + 1) }
    }
    machine done() {}
}

public machine clear(search_model: &mut GallerySearch) reaches WindowsUiHost invokes WindowsUiHost; {
    omega_ui_windows::text_field::clear(&mut search_model.field);
    search::update_results(search_model);
}
public machine key(search_model: &mut GallerySearch, key: i32, control: bool, shift: bool) reaches WindowsUiHost invokes WindowsUiHost; {
    omega_ui_windows::text_field::key(&mut search_model.field, key, control, shift);
    search::update_results(search_model);
}
public machine character(search_model: &mut GallerySearch, character: u64) reaches WindowsUiHost invokes WindowsUiHost; {
    omega_ui_windows::text_field::character(&mut search_model.field, character);
    search::update_results(search_model);
}
public machine new(window: u64) -> GallerySearch {
    GallerySearch { field: omega_ui_windows::text_field::new(window), results: [0, 1, 2, 3, 4, 5], count: 6 }
}
public machine boundary(search_model: &GallerySearch, index: i32) -> bool {
    omega_ui_windows::text_field::boundary(&search_model.field, index)
}
