use damage.omg;
use {omega_ui}/context.omg;
use {omega_ui}/dock.omg;
use {omega_ui}/types.omg;


/*
The dock tree lives outside the box tree. Retain its painted surfaces so a moving
preview invalidates its old and new bounds, while resizing still covers both
pane geometries. This cache owns no layout or input behavior.
*/

public data GalleryDockSurface [copy] {
    x: i32;
    y: i32;
    width: i32;
    height: i32;
    mark: i32;
}
public data GalleryDockDamage {
    surfaces: [GalleryDockSurface; 12];
    ready: bool;
}

machine capture(rectangle: |types|::Rect, mark: i32) -> GalleryDockSurface {
    GalleryDockSurface { x: rectangle.x as i32, y: rectangle.y as i32, width: rectangle.w as i32, height: rectangle.h as i32, mark: mark }
}
machine same(first: &GalleryDockSurface, second: &GalleryDockSurface) -> bool {
    first.x == second.x && first.y == second.y && first.width == second.width && first.height == second.height && first.mark == second.mark
}

public machine dock_damage_prepare(cache: &mut GalleryDockDamage, frame_damage: &mut |damage|::GalleryDamage, context: &|context|::UiContext, tree: &|dock|::DockTree, cpu: i32) {
    transition { _ -> surface(cache, frame_damage, context, tree, cpu, 0) }
    machine surface(cache: &mut GalleryDockDamage, frame_damage: &mut |damage|::GalleryDamage, context: &|context|::UiContext, tree: &|dock|::DockTree, cpu: i32, index: i32) {
        transition index >= 0 && index < 12 {
            true -> capture(cache, frame_damage, context, tree, cpu, index)
            _ -> done(cache)
        }
    }
    machine capture(cache: &mut GalleryDockDamage, frame_damage: &mut |damage|::GalleryDamage, context: &|context|::UiContext, tree: &|dock|::DockTree, cpu: i32, index: i32) requires index >= 0 && index < 12 {
        let current: GalleryDockSurface = dock_damage_surface(context, tree, cpu, index);
        let previous: GalleryDockSurface = cache.surfaces[index];
        cache.surfaces[index] = current;
        transition cache.ready && same(&previous, &current) {
            true -> surface(cache, frame_damage, context, tree, cpu, index + 1)
            _ -> changed(cache, frame_damage, context, tree, cpu, index, previous, current)
        }
    }
    machine changed(cache: &mut GalleryDockDamage, frame_damage: &mut |damage|::GalleryDamage, context: &|context|::UiContext, tree: &|dock|::DockTree, cpu: i32, index: i32, previous: GalleryDockSurface, current: GalleryDockSurface) {
        |damage|::include_box(frame_damage, previous.x, previous.y, previous.width, previous.height);
        |damage|::include_box(frame_damage, current.x, current.y, current.width, current.height);
        transition { _ -> surface(cache, frame_damage, context, tree, cpu, |types|::add_i32(index, 1)) }
    }
    machine done(cache: &mut GalleryDockDamage) { cache.ready = true; }
}

machine dock_damage_surface(context: &|context|::UiContext, tree: &|dock|::DockTree, cpu: i32, index: i32) -> GalleryDockSurface {
    transition index < 6 {
        true -> window(tree, cpu, index)
        _ -> overlay(context, tree, index)
    }
    machine window(tree: &|dock|::DockTree, cpu: i32, index: i32) -> GalleryDockSurface {
        let identifier: i32 = |types|::add_i32(index, 1);
        let focus: i32 = |types|::select_i32(tree.focused_window == identifier, 1, 0);
        let changing: i32 = |types|::select_i32(identifier == 6, |types|::add_i32(|types|::mul_i32(cpu, 1002001), |types|::add_i32(|types|::mul_i32(tree.nodes[0].ratio_b, 1001), tree.nodes[0].ratio_c)), 0);
        let rectangle: |types|::Rect = |dock|::window_rect(tree, identifier);
        let minimum: i32 in Saturating = |types|::select_i32(identifier == 3 && rectangle.h > 28, 96, |types|::select_i32(identifier == 4 && rectangle.h > 60, 116, |types|::select_i32(identifier == 6 && rectangle.h > 80, 224, 0))) as i32 in Saturating;
        let painted: |types|::Rect = |types|::Rect { x: rectangle.x, y: rectangle.y, w: rectangle.w, h: |types|::max_sat(rectangle.h, minimum) };
        let tab: i32 = |types|::select_i32(identifier <= 2, |types|::mul_i32(tree.nodes[2].active_tab, 8), 0);
        capture(painted, |types|::add_i32(tab, |types|::add_i32(focus, |types|::mul_i32(changing, 2))))
    }
    machine overlay(context: &|context|::UiContext, tree: &|dock|::DockTree, index: i32) -> GalleryDockSurface {
        transition index < 10 {
            true -> divider(tree, index)
            _ -> ghost_or_target(context, tree, index)
        }
    }
    machine divider(tree: &|dock|::DockTree, index: i32) -> GalleryDockSurface {
        let node: i32 = |types|::select_i32(index < 8, 0, |types|::select_i32(index == 8, 1, 4));
        let split: i32 = |types|::select_i32(index == 7, 2, 1);
        let active: bool = (tree.hot_divider_node == node && tree.hot_divider_index == split) || (tree.drag_divider_node == node && tree.drag_divider_index == split);
        transition index == 7 {
            true -> (capture(|dock|::div2_rect(tree, 0), |types|::select_i32(active, 1, 0)))
            _ -> (capture(|dock|::div1_rect(tree, node), |types|::select_i32(active, 1, 0)))
        }
    }
    machine ghost_or_target(context: &|context|::UiContext, tree: &|dock|::DockTree, index: i32) -> GalleryDockSurface {
        transition tree.drag_window_id > 0 {
            true -> dragging(context, tree, index)
            _ -> (capture(|types|::rect_zero(), 0))
        }
    }
    machine dragging(context: &|context|::UiContext, tree: &|dock|::DockTree, index: i32) -> GalleryDockSurface {
        transition index == 10 {
            true -> ghost(context, tree)
            _ -> target(tree)
        }
    }
    machine ghost(context: &|context|::UiContext, tree: &|dock|::DockTree) -> GalleryDockSurface {
        let rectangle: |types|::Rect = |types|::Rect { x: |types|::clamp_i32(|types|::sub_i32(context.mouse_x, 76), 266, 860) as i32 in Saturating, y: |types|::clamp_i32(|types|::sub_i32(context.mouse_y, 14), 146, 624) as i32 in Saturating, w: 152, h: 28 };
        capture(rectangle, tree.drag_window_id)
    }
    machine target(tree: &|dock|::DockTree) -> GalleryDockSurface {
        let identifier: i32 = tree.drop_target_window;
        let rectangle: |types|::Rect = |dock|::window_rect(tree, identifier);
        transition identifier > 0 && identifier != tree.drag_window_id && rectangle.w > 20 && rectangle.h > 28 {
            true -> visible_target(rectangle, identifier)
            _ -> (capture(|types|::rect_zero(), 0))
        }
    }
    machine visible_target(rectangle: |types|::Rect, identifier: i32) -> GalleryDockSurface {
        capture(|types|::Rect { x: rectangle.x + (3 as i32 in Saturating), y: rectangle.y + (30 as i32 in Saturating), w: |types|::max_sat(rectangle.w - (6 as i32 in Saturating), 10), h: |types|::max_sat(rectangle.h - (33 as i32 in Saturating), 10) }, identifier)
    }
}
