/*
We keep the application model here and rebuild the shared box tree after input.
The Windows host owns its window, offscreen bitmap, private fonts, and event pump.
It invalidates rendering on input, resize, exposure, or animation, then waits
for input while idle. Live frames synchronize with the compositor. The logical canvas is 1024 by 672; the host maps it to client pixels.

view.omg builds example-only panel nodes. painting.omg paints
those nodes in tree order using library geometry primitives; native text is
painted afterward with the same arranged rectangles. The OMEGA_HEADLESS route
checks input and writes page and animation comparisons without creating a window.
*/

use omega_language_std::console;
use omega_language_std::windows_gui_host;
use omega_ui::types;
use omega_ui::motion;
use omega_ui::context;
use omega_ui::text;
use omega_ui::utf16;
use omega_ui::dock;
use omega_ui::widgets;
use omega_ui::raster;
use omega_ui::tester;
use omega_ui::frame;
use omega_ui::scene;
use omega_ui::list;
use omega_ui_windows::fonts;
use omega_ui_windows::text_field;
use view;
use damage;
use dock_damage;
use omega_ui::paint_boxes;
use omega_ui_windows::box_painter;
use dock_rows;
use omega_ui_windows::corner_cache;
use omega_ui_windows::fill_cache;
use text_clip;
use painting;
use dots;
use search;

data GalleryState {
    page: i32;
    range_mode: i32;
    paused: bool;
    clicks: i32 in Saturating;
    notifications: bool;
    sync_enabled: bool;
    live_anim: bool;
    dark_mode: bool;
    hi_contrast: bool;
    turbo_step: bool;
    volume: i32;
    speed: i32;
    accent_index: i32;
    task_count: i32;
    task_done: [bool; 5];
    tick: i32 in Saturating;
    drag_slider: i32;
    t0_anim: i32;
    t1_anim: i32;
    t2_anim: i32;
    t3_anim: i32;
    t4_anim: i32;
    text_buf: [u8; 16];
    text_len: i32;
    text_focused: bool;
    list_scroll: i32;
    list_filter: i32;
    drag_list_sb: bool;
    flow_step: i32;
    palette_open: bool;
    palette_pick: i32;
    palette_scope: i32;
    palette_highlight: i32;
    search: GallerySearch;
    dock: DockTree;
}

data Main
where
    pumped >= 0 && pumped <= 16,
{
    cls: [u8; 7];
    title: [u8; 9];
    info: [i32; 11];
    pixels: [i32; 4096];
    cursor_pt: [i32; 2];
    prev_lbutton: bool;
    lbutton_msg_down: bool;
    message: WindowsMessage;
    close_requested: bool;
    redraw_requested: bool;
    full_redraw_requested: bool;
    damage: GalleryDamage;
    dock_damage: GalleryDockDamage;
    dock_paint: UiBoxList;
    prepared_dock: bool;
    flat_dock_background: bool;
    dock_background_slot: i32;
    reference_dock: bool;
    compare_drag: bool;
    captured_mouse: bool;
    text_phase: bool;
    text_drawn: bool;
    text_clip: GalleryTextClip;
    text_batches: u64 in Saturating;
    text_fallbacks: u64 in Saturating;
    flat_rows: u64 in Saturating;
    reused_rows: u64 in Saturating;
    corner_cache: WindowsCornerCache;
    dots: GalleryDots;
    reference_dots: bool;
    ignore_palette_character: bool;
    search_pointer_x: i32;
    search_pointer_y: i32;
    damage_left: i32;
    damage_right: i32;
    damage_top: i32;
    damage_bottom: i32;
    previous_frame_milliseconds: u64;
    pumped: i32;
    client_w: i32 in Saturating;
    client_h: i32 in Saturating;
    bitmap_pixels: u64;
    bitmap_stride: i32;
    bitmap_height: i32;
    direct_bitmap: bool;
    hdc_mem: u64;
    hbm_mem: u64;
    hbm_prev: u64;
    font_reg: u64;
    font_medium: u64;
    font_bold: u64;
    font_title: u64;
    font_mono: u64;
    font_hero: u64;
    f0_reg: u64;
    f0_medium: u64;
    f0_bold: u64;
    f0_title: u64;
    f0_mono: u64;
    f0_hero: u64;
    f1_reg: u64;
    f1_medium: u64;
    f1_bold: u64;
    f1_title: u64;
    f1_mono: u64;
    f1_hero: u64;
    f2_reg: u64;
    f2_medium: u64;
    f2_bold: u64;
    f2_title: u64;
    f2_mono: u64;
    f2_hero: u64;
    f3_reg: u64;
    f3_medium: u64;
    f3_bold: u64;
    f3_title: u64;
    f3_mono: u64;
    f3_hero: u64;
    fonts_ready: bool;
    ctx: UiContext;
    scene: UiScene;
    layout_error: i32;
    model: GalleryState;
}

machine compute_phase(model: &GalleryState) -> i32 {
    let spd: i32 = clamp_i32(model.speed, 1, 10);
    let raw: i32 = mul_i32((model.tick as i32) / 32, spd);
    raw % 64
}

machine compute_cpu_load(model: &GalleryState) -> i32 {
    let ph: i32 = compute_phase(model);
    let m16: i32 = ph % 16;
    let wave: i32 = select_i32(m16 < 8, mul_i32(m16, 2), mul_i32(sub_i32(16, m16), 2));
    clamp_i32(add_i32(add_i32(28, (mul_i32(model.volume, 3)) / 5), wave), 12, 98)
}

machine compute_mem_load(model: &GalleryState) -> i32 {
    let ph: i32 = compute_phase(model);
    let harm_boost: i32 = select_i32(model.notifications, 14, 0);
    clamp_i32(add_i32(add_i32(34, model.volume / 3), add_i32(harm_boost, mul_i32(ph, 3) % 11)), 16, 95)
}

machine count_done_tasks(model: &GalleryState) -> i32 {
    let n: i32 = clamp_i32(model.task_count, 0, 5);
    let d0: i32 = select_i32(n > 0 && model.task_done[0], 1, 0);
    let d1: i32 = select_i32(n > 1 && model.task_done[1], 1, 0);
    let d2: i32 = select_i32(n > 2 && model.task_done[2], 1, 0);
    let d3: i32 = select_i32(n > 3 && model.task_done[3], 1, 0);
    let d4: i32 = select_i32(n > 4 && model.task_done[4], 1, 0);
    add_i32(d0, add_i32(d1, add_i32(d2, add_i32(d3, d4))))
}

machine pack_toggles_mask(model: &GalleryState) -> i32 {
    let b0: i32 = select_i32(model.notifications, 1, 0);
    let b1: i32 = select_i32(model.sync_enabled, 2, 0);
    let b2: i32 = select_i32(model.live_anim, 4, 0);
    let b3: i32 = select_i32(model.dark_mode, 8, 0);
    let b4: i32 = select_i32(model.hi_contrast, 16, 0);
    let b5: i32 = select_i32(model.turbo_step, 32, 0);
    add_i32(b0, add_i32(b1, add_i32(b2, add_i32(b3, add_i32(b4, b5)))))
}

machine animate_gallery_button(context: &mut UiContext, identifier: i32, rectangle: Rect) {
    let hovered: bool = Rect::contains(&rectangle, context.mouse_x, context.mouse_y);
    let target: i32 = select_i32(hovered && context.mouse_down, 1000, select_i32(hovered, 400, 0));
    let feedback: i32 = UiMotion::target(&mut context.motion, identifier, target, select_i32(context.mouse_down, 120, 160));
}

machine sync_gallery_motion(context: &mut UiContext, model: &mut GalleryState) {
    model.palette_highlight = UiMotion::target(&mut context.motion, 91502, mul_i32(model.palette_pick, 200), 160);
    model.t0_anim = UiMotion::target(&mut context.motion, 1100, select_i32(model.notifications, 1000, 0), 260);
    model.t1_anim = UiMotion::target(&mut context.motion, 1101, select_i32(model.sync_enabled, 1000, 0), 260);
    model.t2_anim = UiMotion::target(&mut context.motion, 1102, select_i32(model.live_anim, 1000, 0), 260);
    model.t3_anim = model.t0_anim;
    model.t4_anim = UiMotion::target(&mut context.motion, 1103, select_i32(!model.paused, 1000, 0), 260);
    transition model.page == 0 {
        true -> controls(context, model)
        _ -> done()
    }
    state controls(context: &mut UiContext, model: &mut GalleryState) {
        let dark: i32 = UiMotion::target(&mut context.motion, 1110, select_i32(model.dark_mode, 1000, 0), 260);
        let contrast: i32 = UiMotion::target(&mut context.motion, 1111, select_i32(model.hi_contrast, 1000, 0), 260);
        let turbo: i32 = UiMotion::target(&mut context.motion, 1112, select_i32(model.turbo_step, 1000, 0), 260);
        let buttons: Rect = UiContext::previous_rect(context, 20);
        let sliders: Rect = UiContext::previous_rect(context, 22);
        let volume: Rect = Rect { x: sliders.x + (72 as i32 in Saturating), y: sliders.y + (30 as i32 in Saturating), w: 300, h: 36 };
        let speed: Rect = Rect { x: sliders.x + (72 as i32 in Saturating), y: sliders.y + (84 as i32 in Saturating), w: 300, h: 36 };
        let volume_on: bool = model.drag_slider == 1 || Rect::contains(&volume, context.mouse_x, context.mouse_y);
        let speed_on: bool = model.drag_slider == 2 || Rect::contains(&speed, context.mouse_x, context.mouse_y);
        let volume_lift: i32 = UiMotion::target(&mut context.motion, 1120, select_i32(volume_on, 1000, 0), 260);
        let speed_lift: i32 = UiMotion::target(&mut context.motion, 1121, select_i32(speed_on, 1000, 0), 260);
        transition { _ -> button(context, buttons, 0) }
    }
    state button(context: &mut UiContext, rectangle: Rect, index: i32) {
        transition index >= 0 && index < 8 {
            true -> animate(context, rectangle, index)
            _ -> done()
        }
    }
    state animate(context: &mut UiContext, rectangle: Rect, index: i32) requires index >= 0 && index < 8 {
        let offsets: [i32; 8] = [18,124,242,348,446,546,588,636];
        let widths: [i32; 8] = [96,108,96,88,84,36,36,90];
        let button: Rect = Rect { x: rectangle.x + (offsets[index] as i32 in Saturating), y: rectangle.y + (42 as i32 in Saturating), w: widths[index] as i32 in Saturating, h: 36 };
        animate_gallery_button(context, add_i32(1140, index), button);
        transition { _ -> button(context, rectangle, index + 1) }
    }
    state done() {}
}

machine advance_gallery_animation(context: &mut UiContext, model: &mut GalleryState, elapsed_ms: i32) -> bool {
    let changed: bool = UiMotion::advance(&mut context.motion, elapsed_ms);
    let running: bool = model.page == 2 && !model.paused && !model.palette_open;
    let step: i32 in Saturating = select_sat(running, elapsed_ms as i32 in Saturating, 0);
    model.tick = (model.tick + step) % (10000 as i32 in Saturating);
    changed || running
}

machine pack_toggle_anims(model: &GalleryState) -> i32 {
    let s0: i32 = clamp_i32(model.t0_anim, 0, 1000);
    let s1: i32 = mul_i32(clamp_i32(model.t1_anim, 0, 1000), 1024);
    let s2: i32 = mul_i32(clamp_i32(model.t2_anim, 0, 1000), 1048576);
    add_i32(s0, add_i32(s1, s2))
}

machine handle_buttons_card(model: &mut GalleryState, it: Interaction) {
    transition it.clicked {
        true -> dispatch_btn(model, it.relative_x as i32)
        _ -> done()
    }
    state dispatch_btn(model: &mut GalleryState, rx: i32) {
        let mul: i32 = select_i32(model.turbo_step, 5, 1);
        let d_prim: i32 = select_i32(rx >= 18 && rx < 114, mul, 0);
        let d_sec: i32 = select_i32(rx >= 124 && rx < 232, mul_i32(5, mul), d_prim);
        let d_gho: i32 = select_i32(rx >= 242 && rx < 338, mul_i32(10, mul), d_sec);
        let d_minus: i32 = select_i32(rx >= 546 && rx < 582, 0 - mul, d_gho);
        let d_plus: i32 = select_i32(rx >= 588 && rx < 624, mul, d_minus);
        let is_rst: bool = rx >= 348 && rx < 436;
        let next_c: i32 = select_i32(is_rst, 0, clamp_i32(add_i32(model.clicks as i32, d_plus), 0, 999));
        model.clicks = next_c as i32 in Saturating;
    }
    state done() {}
}

machine handle_toggles_card(ctx: &UiContext, model: &mut GalleryState, it: Interaction) {
    let rel_y: i32 = sub_i32(ctx.mouse_y, 200);
    let row_idx: i32 = select_i32(rel_y < 68, 0, select_i32(rel_y < 100, 1, 2));
    let is_right: bool = (it.relative_x as i32) >= 370;
    transition it.clicked {
        true -> apply_toggle(model, row_idx, is_right)
        _ -> done()
    }
    state apply_toggle(model: &mut GalleryState, row_idx: i32, is_right: bool) {
        transition is_right {
            true -> right_col(model, row_idx)
            _ -> left_col(model, row_idx)
        }
    }
    state left_col(model: &mut GalleryState, row_idx: i32) {
        model.notifications = select_i32(row_idx == 0, select_i32(!model.notifications, 1, 0), select_i32(model.notifications, 1, 0)) == 1;
        model.sync_enabled = select_i32(row_idx == 1, select_i32(!model.sync_enabled, 1, 0), select_i32(model.sync_enabled, 1, 0)) == 1;
        model.live_anim = select_i32(row_idx == 2, select_i32(!model.live_anim, 1, 0), select_i32(model.live_anim, 1, 0)) == 1;
        model.paused = !model.live_anim;
    }
    state right_col(model: &mut GalleryState, row_idx: i32) {
        model.dark_mode = select_i32(row_idx == 0, select_i32(!model.dark_mode, 1, 0), select_i32(model.dark_mode, 1, 0)) == 1;
        model.hi_contrast = select_i32(row_idx == 1, select_i32(!model.hi_contrast, 1, 0), select_i32(model.hi_contrast, 1, 0)) == 1;
        model.turbo_step = select_i32(row_idx == 2, select_i32(!model.turbo_step, 1, 0), select_i32(model.turbo_step, 1, 0)) == 1;
    }
    state done() {}
}

machine handle_sliders_card(ctx: &UiContext, model: &mut GalleryState, it: Interaction) {
    let rectangle: Rect = UiContext::previous_rect(ctx, 22);
    let rx: i32 = sub_i32(ctx.mouse_x, rectangle.x as i32);
    let ry: i32 = sub_i32(ctx.mouse_y, rectangle.y as i32);
    transition !ctx.mouse_down {
        true -> release_slider(model, it.clicked, rx)
        _ -> check_start(ctx, model, it, rx, ry)
    }
    state release_slider(model: &mut GalleryState, clicked: bool, rx: i32) {
        model.drag_slider = 0;
        transition { _ -> check_presets(model, clicked, rx) }
    }
    state check_start(ctx: &UiContext, model: &mut GalleryState, it: Interaction, rx: i32, ry: i32) {
        transition ctx.mouse_pressed && it.hovered && rx >= 72 && rx <= 376 {
            true -> lock_slider(model, rx, ry)
            _ -> check_drag(model, it.clicked, rx)
        }
    }
    state lock_slider(model: &mut GalleryState, rx: i32, ry: i32) {
        model.drag_slider = select_i32(ry < 84, 1, 2);
        transition { _ -> check_drag(model, false, rx) }
    }
    state check_drag(model: &mut GalleryState, clicked: bool, rx: i32) {
        transition model.drag_slider == 1 || model.drag_slider == 2 {
            true -> drag_sliders(model, rx)
            _ -> check_presets(model, clicked, rx)
        }
    }
    state drag_sliders(model: &mut GalleryState, rx: i32) {
        let pct: i32 = clamp_i32((mul_i32(sub_i32(rx, 86), 100)) / 270, 0, 100);
        let spd: i32 = clamp_i32(add_i32(1, (mul_i32(pct, 9)) / 100), 1, 10);
        model.volume = select_i32(model.drag_slider == 1, pct, model.volume);
        model.speed = select_i32(model.drag_slider == 2, spd, model.speed);
    }
    state check_presets(model: &mut GalleryState, clicked: bool, rx: i32) {
        transition clicked && rx >= 436 {
            true -> apply_preset(model, rx)
            _ -> done()
        }
    }
    state apply_preset(model: &mut GalleryState, rx: i32) {
        let p0: i32 = select_i32(rx >= 436 && rx < 502, 25, model.volume);
        let p1: i32 = select_i32(rx >= 508 && rx < 574, 50, p0);
        let p2: i32 = select_i32(rx >= 580 && rx < 646, 75, p1);
        model.volume = select_i32(rx >= 652 && rx < 724, 100, p2);
    }
    state done() {}
}

machine accept_ghost_text(model: &mut GalleryState) {
    model.text_buf = "Jarod-Omega     ";
    model.text_len = 11;
    model.text_focused = true;
}

machine handle_palette_card(model: &mut GalleryState, it: Interaction) {
    let rx: i32 = it.relative_x as i32;
    transition it.clicked {
        true -> dispatch_tf(model, rx)
        _ -> done()
    }
    state dispatch_tf(model: &mut GalleryState, rx: i32) {
        transition rx >= 18 && rx < 252 {
            true -> focus_tf(model)
            _ -> check_ghost_btn(model, rx)
        }
    }
    state focus_tf(model: &mut GalleryState) {
        model.text_focused = true;
    }
    state check_ghost_btn(model: &mut GalleryState, rx: i32) {
        transition rx >= 252 && rx < 288 {
            true -> do_ghost(model)
            _ -> check_clr(model, rx)
        }
    }
    state do_ghost(model: &mut GalleryState) {
        accept_ghost_text(model);
    }
    state check_clr(model: &mut GalleryState, rx: i32) {
        transition rx >= 294 && rx < 362 {
            true -> do_clr(model)
            _ -> check_swatches(model, rx)
        }
    }
    state do_clr(model: &mut GalleryState) {
        model.text_buf = "                ";
        model.text_len = 0;
        model.text_focused = true;
    }
    state check_swatches(model: &mut GalleryState, rx: i32) {
        transition rx >= 370 && rx < 598 {
            true -> pick_swatch(model, rx)
            _ -> done()
        }
    }
    state pick_swatch(model: &mut GalleryState, rx: i32) {
        let s0: i32 = select_i32(rx < 414, 0, model.accent_index);
        let s1: i32 = select_i32(rx >= 414 && rx < 460, 1, s0);
        let s2: i32 = select_i32(rx >= 460 && rx < 506, 2, s1);
        let s3: i32 = select_i32(rx >= 506 && rx < 552, 3, s2);
        model.accent_index = select_i32(rx >= 552, 4, s3);
    }
    state done() {}
}

// Page 0: Interactive Controls & Widget Playground.
machine build_controls_page(ctx: &mut UiContext, model: &mut GalleryState) {
    let c_acc: i32 = ctx.theme.accent;
    let c_suc: i32 = ctx.theme.success;
    let c_pur: i32 = ctx.theme.purple;
    let mask: i32 = pack_toggles_mask(model);
    let anim_steps: i32 = pack_toggle_anims(model);
    let caret_off: i32 = clamp_i32(mul_i32(model.text_len, 7), 0, 200);
    let packed_tf: i32 = add_i32(select_i32(model.text_focused, 1, 0), mul_i32(caret_off, 2));

    let it1: Interaction = GalleryUi::playground_card(ctx, 20, 744, 102, 1, model.clicks as i32, 0, c_acc);
    let it2: Interaction = GalleryUi::playground_card(ctx, 21, 744, 142, 2, mask, anim_steps, c_suc);
    let it3: Interaction = GalleryUi::playground_card(ctx, 22, 744, 134, 3, model.volume, model.speed, c_pur);
    let it4: Interaction = GalleryUi::playground_card(ctx, 23, 744, 96, 4, model.accent_index, packed_tf, c_acc);

    handle_buttons_card(model, it1);
    handle_toggles_card(ctx, model, it2);
    handle_sliders_card(ctx, model, it3);
    handle_palette_card(model, it4);
    Ui::row(ctx, 16, 0, true, true);
    let speed_changed: bool = Ui::number_field(ctx, 24, &mut model.speed, 1, 10, 1, 168);
    let label_color: i32 = ctx.theme.text;
    let playback_label: i32 = Ui::text(ctx, "Playback speed", 20, label_color, 500);
    Ui::end(ctx);
    model.text_focused = model.text_focused && ctx.focus != 24;
}

machine handle_tasks_toolbar(model: &mut GalleryState, it: Interaction) {
    let rx: i32 = it.relative_x as i32;
    transition it.clicked {
        true -> dispatch_tb(model, rx)
        _ -> done()
    }
    state dispatch_tb(model: &mut GalleryState, rx: i32) {
        transition rx >= 16 && rx < 130 {
            true -> add_task(model)
            _ -> check_all(model, rx)
        }
    }
    state add_task(model: &mut GalleryState) {
        let cur: i32 = clamp_i32(model.task_count, 0, 3);
        transition cur >= 0 && cur < 3 {
            true -> push_one(model, cur)
            _ -> done()
        }
    }
    state push_one(model: &mut GalleryState, cur: i32)
    requires cur >= 0 && cur < 3 {
        model.task_done[cur] = false;
        model.task_count = cur + 1;
    }
    state check_all(model: &mut GalleryState, rx: i32) {
        transition rx >= 136 && rx < 250 {
            true -> mark_all(model)
            _ -> check_clear(model, rx)
        }
    }
    state mark_all(model: &mut GalleryState) {
        model.task_done[0] = true;
        model.task_done[1] = true;
        model.task_done[2] = true;
    }
    state check_clear(model: &mut GalleryState, rx: i32) {
        transition rx >= 256 && rx < 354 {
            true -> clear_last(model)
            _ -> check_rst(model, rx)
        }
    }
    state clear_last(model: &mut GalleryState) {
        model.task_count = max_i32(sub_i32(model.task_count, 1), 1);
    }
    state check_rst(model: &mut GalleryState, rx: i32) {
        transition rx >= 360 && rx < 444 {
            true -> reset_tasks(model)
            _ -> done()
        }
    }
    state reset_tasks(model: &mut GalleryState) {
        model.task_count = 3;
        model.task_done[0] = true;
        model.task_done[1] = true;
        model.task_done[2] = false;
    }
    state done() {}
}

machine handle_task_row_click(model: &mut GalleryState, slot: i32, it: Interaction)
requires slot >= 0 && slot < 5 {
    let rx: i32 = it.relative_x as i32;
    transition it.clicked && slot < model.task_count {
        true -> check_remove(model, slot, rx)
        _ -> done()
    }
    state check_remove(model: &mut GalleryState, slot: i32, rx: i32)
    requires slot >= 0 && slot < 5 {
        transition rx >= 636 {
            true -> do_remove(model)
            _ -> toggle_task(model, slot)
        }
    }
    state do_remove(model: &mut GalleryState) {
        model.task_count = max_i32(sub_i32(model.task_count, 1), 0);
    }
    state toggle_task(model: &mut GalleryState, slot: i32)
    requires slot >= 0 && slot < 5 {
        model.task_done[slot] = !model.task_done[slot];
    }
    state done() {}
}

machine handle_virtual_list(ctx: &UiContext, model: &mut GalleryState, it: Interaction) {
    let rectangle: Rect = UiContext::previous_rect(ctx, 36);
    let rx: i32 = sub_i32(ctx.mouse_x, rectangle.x as i32);
    let ry: i32 = sub_i32(ctx.mouse_y, rectangle.y as i32);
    transition !ctx.mouse_down {
        true -> release_sb(model, it.clicked, rx, ry)
        _ -> check_sb_start(ctx, model, it, rx, ry)
    }
    state release_sb(model: &mut GalleryState, clicked: bool, rx: i32, ry: i32) {
        model.drag_list_sb = false;
        transition { _ -> check_pills(model, clicked, rx, ry) }
    }
    state check_sb_start(ctx: &UiContext, model: &mut GalleryState, it: Interaction, rx: i32, ry: i32) {
        transition ctx.mouse_pressed && it.hovered && rx >= 704 && ry >= 36 {
            true -> lock_sb(model, ry)
            _ -> check_sb_drag(model, it.clicked, rx, ry)
        }
    }
    state lock_sb(model: &mut GalleryState, ry: i32) {
        model.drag_list_sb = true;
        transition { _ -> drag_sb(model, ry) }
    }
    state check_sb_drag(model: &mut GalleryState, clicked: bool, rx: i32, ry: i32) {
        transition model.drag_list_sb {
            true -> drag_sb(model, ry)
            _ -> check_pills(model, clicked, rx, ry)
        }
    }
    state drag_sb(model: &mut GalleryState, ry: i32) {
        let rel_s: i32 = clamp_i32(sub_i32(ry, 46), 0, 152);
        model.list_scroll = clamp_i32((mul_i32(rel_s, 9995)) / 152, 0, 9995);
    }
    state check_pills(model: &mut GalleryState, clicked: bool, rx: i32, ry: i32) {
        transition clicked && ry < 38 {
            true -> apply_pill(model, rx)
            _ -> check_row_step(model, clicked, rx, ry)
        }
    }
    state apply_pill(model: &mut GalleryState, rx: i32) {
        model.list_filter = select_i32(rx >= 332 && rx < 422, 0, select_i32(rx >= 426 && rx < 524, 1, model.list_filter));
        let step100: i32 = clamp_i32(add_i32(model.list_scroll, 100), 0, 9995);
        let jump5k: i32 = select_i32(model.list_scroll >= 5000, 0, 5000);
        let s1: i32 = select_i32(rx >= 528 && rx < 622, step100, model.list_scroll);
        model.list_scroll = select_i32(rx >= 626 && rx < 730, jump5k, s1);
    }
    state check_row_step(model: &mut GalleryState, clicked: bool, rx: i32, ry: i32) {
        transition clicked && ry >= 40 && rx < 704 {
            true -> step_rows(model, ry)
            _ -> done()
        }
    }
    state step_rows(model: &mut GalleryState, ry: i32) {
        let delta: i32 = select_i32(ry < 112, 0 - 5, 5);
        model.list_scroll = clamp_i32(add_i32(model.list_scroll, delta), 0, 9995);
    }
    state done() {}
}

// Page 1: Interactive Task Manager + 10,000-Row Virtualized `uniform_list`.
machine build_tasks_page(ctx: &mut UiContext, model: &mut GalleryState) {
    let accent: i32 = ctx.theme.accent;
    let total: i32 = clamp_i32(model.task_count, 0, 3);
    let done_count: i32 = add_i32(select_i32(total > 0 && model.task_done[0], 1, 0), add_i32(select_i32(total > 1 && model.task_done[1], 1, 0), select_i32(total > 2 && model.task_done[2], 1, 0)));
    let toolbar: Interaction = GalleryUi::playground_card(ctx, 30, 744, 52, 5, done_count, total, accent);
    handle_tasks_toolbar(model, toolbar);
    Ui::card(ctx, 0, 0, true);
    transition total == 0 {
        true -> empty(ctx, model)
        _ -> rows(ctx, model, total, 0)
    }
    state empty(ctx: &mut UiContext, model: &mut GalleryState) {
        let accent: i32 = ctx.theme.accent;
        let placeholder: Interaction = GalleryUi::playground_card(ctx, 31, 744, 104, 6, 0, 10, accent);
        transition { _ -> collection(ctx, model) }
    }
    state rows(ctx: &mut UiContext, model: &mut GalleryState, total: i32, slot: i32) {
        transition slot < total && slot >= 0 && slot < 3 {
            true -> row(ctx, model, total, slot)
            _ -> collection(ctx, model)
        }
    }
    state row(ctx: &mut UiContext, model: &mut GalleryState, total: i32, slot: i32)
    requires slot >= 0 && slot < 3 {
        let accent: i32 = ctx.theme.accent;
        let completed: i32 = select_i32(model.task_done[slot], 1, 0);
        let item: Interaction = GalleryUi::playground_card(ctx, add_i32(31, slot), 744, 52, 6, completed, 0, accent);
        handle_task_row_click(model, slot, item);
        transition { _ -> rows(ctx, model, total, add_i32(slot, 1)) }
    }
    state collection(ctx: &mut UiContext, model: &mut GalleryState) {
        let accent: i32 = ctx.theme.accent;
        Ui::end(ctx);
        let list: Interaction = GalleryUi::playground_card(ctx, 36, 744, 232, 11, model.list_scroll, model.list_filter, accent);
        handle_virtual_list(ctx, model, list);
    }
}

machine handle_synth_controls(ctx: &UiContext, model: &mut GalleryState, it: Interaction) {
    let rx: i32 = sub_i32(ctx.mouse_x, 264);
    let ry: i32 = sub_i32(ctx.mouse_y, 482);
    transition !ctx.mouse_down {
        true -> release_synth(model, it.clicked, rx, ry)
        _ -> check_start(ctx, model, it, rx, ry)
    }
    state release_synth(model: &mut GalleryState, clicked: bool, rx: i32, ry: i32) {
        model.drag_slider = 0;
        transition { _ -> check_synth_toggles(model, clicked, rx, ry) }
    }
    state check_start(ctx: &UiContext, model: &mut GalleryState, it: Interaction, rx: i32, ry: i32) {
        transition ctx.mouse_pressed && it.hovered && rx >= 84 && rx < 576 {
            true -> lock_synth(model, rx, ry)
            _ -> check_drag(model, it.clicked, rx, ry)
        }
    }
    state lock_synth(model: &mut GalleryState, rx: i32, ry: i32) {
        model.drag_slider = select_i32(rx < 338, 3, 4);
        transition { _ -> check_drag(model, false, rx, ry) }
    }
    state check_drag(model: &mut GalleryState, clicked: bool, rx: i32, ry: i32) {
        transition model.drag_slider == 3 || model.drag_slider == 4 {
            true -> drag_synth(model, rx)
            _ -> check_synth_toggles(model, clicked, rx, ry)
        }
    }
    state drag_synth(model: &mut GalleryState, rx: i32) {
        let amp: i32 = clamp_i32((mul_i32(sub_i32(rx, 98), 100)) / 190, 0, 100);
        let freq_pct: i32 = clamp_i32((mul_i32(sub_i32(rx, 388), 100)) / 170, 0, 100);
        let spd: i32 = clamp_i32(add_i32(1, (mul_i32(freq_pct, 9)) / 100), 1, 10);
        model.volume = select_i32(model.drag_slider == 3, amp, model.volume);
        model.speed = select_i32(model.drag_slider == 4, spd, model.speed);
    }
    state check_synth_toggles(model: &mut GalleryState, clicked: bool, rx: i32, ry: i32) {
        transition clicked && rx >= 600 {
            true -> flip_synth(model, ry)
            _ -> done()
        }
    }
    state flip_synth(model: &mut GalleryState, ry: i32) {
        model.notifications = select_i32(ry < 50, select_i32(!model.notifications, 1, 0), select_i32(model.notifications, 1, 0)) == 1;
        model.paused = select_i32(ry >= 50, select_i32(!model.paused, 1, 0), select_i32(model.paused, 1, 0)) == 1;
        model.live_anim = !model.paused;
    }
    state done() {}
}

// Page 2: Interactive Dot-Matrix Synthesizer & Telemetry Playground.
machine build_synth_page(ctx: &mut UiContext, model: &mut GalleryState) {
    let ph: i32 = compute_phase(model);
    let cpu_v: i32 = compute_cpu_load(model);
    let sys_v: i32 = clamp_i32(cpu_v / 3, 8, 42);
    let mem_v: i32 = compute_mem_load(model);
    let wired_v: i32 = clamp_i32(mem_v / 3, 10, 38);
    let c_acc: i32 = ctx.theme.accent;
    let c_red: i32 = ctx.theme.danger;
    let c_grn: i32 = ctx.theme.success;
    let c_org: i32 = ctx.theme.orange;

    Ui::row(ctx, 16, 0, true, false);
    let go_c: bool = GalleryUi::metric_tile(ctx, 40, 364, 184, 5, 7, c_acc, c_red, cpu_v, sys_v, ph);
    let go_m: bool = GalleryUi::metric_tile(ctx, 41, 364, 184, 6, 9, c_grn, c_org, mem_v, wired_v, add_i32(ph, 7));
    Ui::end(ctx);

    GalleryUi::dot_graph_card(ctx, 42, 744, 188, 5, 13, c_acc, c_org, cpu_v, sys_v, ph);

    let harm_step: i32 = mul_i32(clamp_i32(model.t3_anim, 0, 1000), 16);
    let anim_step: i32 = mul_i32(clamp_i32(model.t4_anim, 0, 1000), 16384);
    let packed_synth: i32 = add_i32(clamp_i32(model.speed, 1, 10), add_i32(harm_step, anim_step));
    let it_syn: Interaction = GalleryUi::playground_card(ctx, 43, 744, 92, 7, model.volume, packed_synth, c_acc);
    handle_synth_controls(ctx, model, it_syn);
}

machine handle_mermaid_flow(model: &mut GalleryState, it: Interaction) {
    let rx: i32 = it.relative_x as i32;
    transition it.clicked {
        true -> pick_step(model, rx)
        _ -> done()
    }
    state pick_step(model: &mut GalleryState, rx: i32) {
        let s0: i32 = select_i32(rx < 186, 0, model.flow_step);
        let s1: i32 = select_i32(rx >= 186 && rx < 366, 1, s0);
        let s2: i32 = select_i32(rx >= 366 && rx < 546, 2, s1);
        model.flow_step = select_i32(rx >= 546, 3, s2);
    }
    state done() {}
}

machine handle_theme_studio(model: &mut GalleryState, it: Interaction) {
    let rx: i32 = it.relative_x as i32;
    transition it.clicked {
        true -> dispatch_studio(model, rx)
        _ -> done()
    }
    state dispatch_studio(model: &mut GalleryState, rx: i32) {
        model.dark_mode = select_i32(rx >= 18 && rx < 172, 1, select_i32(rx >= 180 && rx < 334, 0, select_i32(model.dark_mode, 1, 0))) == 1;
        let s0: i32 = select_i32(rx >= 356 && rx < 424, 0, model.accent_index);
        let s1: i32 = select_i32(rx >= 430 && rx < 498, 1, s0);
        let s2: i32 = select_i32(rx >= 504 && rx < 572, 2, s1);
        let s3: i32 = select_i32(rx >= 578 && rx < 646, 3, s2);
        model.accent_index = select_i32(rx >= 652 && rx < 722, 4, s3);
    }
    state done() {}
}

// Page 3: Flowchart State Flowchart + ClearType Typography Specimen + Theme Studio.
machine build_theme_page(ctx: &mut UiContext, model: &mut GalleryState) {
    let c_acc: i32 = ctx.theme.accent;
    let is_dk: i32 = select_i32(model.dark_mode, 1, 0);
    let it_flw: Interaction = GalleryUi::playground_card(ctx, 50, 744, 214, 12, model.flow_step, 0, c_acc);
    let it_typ: Interaction = GalleryUi::playground_card(ctx, 51, 744, 166, 8, model.clicks as i32, model.volume, c_acc);
    let it_stu: Interaction = GalleryUi::playground_card(ctx, 52, 744, 118, 9, is_dk, model.accent_index, c_acc);
    handle_mermaid_flow(model, it_flw);
    handle_theme_studio(model, it_stu);
}

machine pack_dock_vis_mask(tree: &DockTree) -> i32 {
    let v0: i32 = select_i32(DockTree::is_window_enabled(tree, 1), 1, 0);
    let v1: i32 = select_i32(DockTree::is_window_enabled(tree, 3), 2, 0);
    let v2: i32 = select_i32(DockTree::is_window_enabled(tree, 4), 4, 0);
    let v3: i32 = select_i32(DockTree::is_window_enabled(tree, 5), 8, 0);
    let v4: i32 = select_i32(DockTree::is_window_enabled(tree, 6), 16, 0);
    add_i32(v0, add_i32(v1, add_i32(v2, add_i32(v3, v4))))
}

machine handle_dock_toolbar(model: &mut GalleryState, it: Interaction) {
    let rx: i32 = it.relative_x as i32;
    transition it.clicked {
        true -> dispatch_dock_tb(model, rx)
        _ -> done()
    }
    state dispatch_dock_tb(model: &mut GalleryState, rx: i32) {
        transition rx >= 12 && rx < 100 {
            true -> do_eq(model)
            _ -> check_rep(model, rx)
        }
    }
    state do_eq(model: &mut GalleryState) {
        DockTree::equalize_splits(&mut model.dock);
    }
    state check_rep(model: &mut GalleryState, rx: i32) {
        transition rx >= 106 && rx < 226 {
            true -> do_rep(model)
            _ -> check_rst(model, rx)
        }
    }
    state do_rep(model: &mut GalleryState) {
        DockTree::toggle_reparent_struct_tab(&mut model.dock);
    }
    state check_rst(model: &mut GalleryState, rx: i32) {
        transition rx >= 232 && rx < 298 {
            true -> do_rst(model)
            _ -> check_vis(model, rx)
        }
    }
    state do_rst(model: &mut GalleryState) {
        model.dock = DockTree::workspace_preset();
    }
    state check_vis(model: &mut GalleryState, rx: i32) {
        let w0: i32 = select_i32(rx >= 312 && rx < 392, 1, 0);
        let w1: i32 = select_i32(rx >= 398 && rx < 478, 3, w0);
        let w2: i32 = select_i32(rx >= 484 && rx < 564, 4, w1);
        let w3: i32 = select_i32(rx >= 570 && rx < 650, 5, w2);
        let win_id: i32 = select_i32(rx >= 654 && rx < 734, 6, w3);
        transition win_id > 0 {
            true -> flip_w(model, win_id)
            _ -> done()
        }
    }
    state flip_w(model: &mut GalleryState, win_id: i32) {
        DockTree::toggle_window_visibility(&mut model.dock, win_id);
    }
    state done() {}
}

machine build_dock_page(ctx: &mut UiContext, model: &mut GalleryState) {
    let c_acc: i32 = ctx.theme.accent;
    let vis_mask: i32 = pack_dock_vis_mask(&model.dock);
    let as_tab: i32 = select_i32(model.dock.struct_docked_as_tab, 1, 0);
    let it_tb: Interaction = GalleryUi::playground_card(ctx, 60, 744, 46, 10, vis_mask, as_tab, c_acc);
    handle_dock_toolbar(model, it_tb);

    let canvas_r0: Rect = Rect { x: 264, y: 146, w: 744, h: 510 };
    DockTree::solve_layout(&mut model.dock, canvas_r0);
    let moved: bool = DockTree::handle_pointer(&mut model.dock, ctx.mouse_x, ctx.mouse_y, ctx.mouse_pressed, ctx.mouse_down, ctx.mouse_released);
    let canvas_r1: Rect = Rect { x: 264, y: 146, w: 744, h: 510 };
    DockTree::solve_layout(&mut model.dock, canvas_r1);

    let r6: Rect = DockTree::window_rect(&model.dock, 6);
    let rx6: i32 = sub_i32(ctx.mouse_x, r6.x as i32);
    let ry6: i32 = sub_i32(ctx.mouse_y, r6.y as i32);
    transition ctx.mouse_pressed && r6.w > 80 && rx6 >= sub_i32(r6.w as i32, 80) && rx6 < sub_i32(r6.w as i32, 10) && ry6 >= 112 && ry6 <= 140 {
        true -> rerun_command(model)
        _ -> done_dock()
    }
    state rerun_command(model: &mut GalleryState) {
        model.clicks = clamp_i32(add_i32(model.clicks as i32, 1), 0, 999) as i32 in Saturating;
    }
    state done_dock() {}
}

machine execute_palette_command(model: &mut GalleryState) {
    let index: i32 = model.palette_pick;
    transition index >= 0 && index < model.search.count && index < 6 {
        true -> selected(model, index)
        _ -> done()
    }
    state selected(model: &mut GalleryState, index: i32) requires index >= 0 && index < 6 {
    let pick: i32 = model.search.results[index];
    transition pick <= 4 {
        true -> go_page(model, clamp_i32(pick, 0, 4))
        _ -> flip_theme(model)
    }
    }
    state go_page(model: &mut GalleryState, p: i32) {
        model.page = p;
        model.palette_open = false;
    }
    state flip_theme(model: &mut GalleryState) {
        model.dark_mode = !model.dark_mode;
        model.palette_open = false;
    }
    state done() {}
}

machine handle_palette_modal_mouse(ctx: &UiContext, model: &mut GalleryState) {
    let mx: i32 = ctx.mouse_x;
    let my: i32 = ctx.mouse_y;
    let bottom: i32 = add_i32(214, mul_i32(max_i32(model.search.count, 2), 36));
    transition ctx.mouse_pressed {
        true -> click(ctx, model, mx, my, bottom)
        _ -> done()
    }
    state click(ctx: &UiContext, model: &mut GalleryState, mx: i32, my: i32, bottom: i32) {
        transition mx < 412 || mx >= 860 || my < 110 || my >= bottom || (mx >= 814 && my >= 124 && my < 156) {
            true -> close(model)
            _ -> row(model, mx, my)
        }
    }
    state close(model: &mut GalleryState) { model.palette_open = false; }
    state row(model: &mut GalleryState, mx: i32, my: i32) {
        let index: i32 = sub_i32(my, 172) / 36;
        transition mx >= 420 && mx < 852 && my >= 172 && index >= 0 && index < model.search.count {
            true -> execute(model, index)
            _ -> done()
        }
    }
    state execute(model: &mut GalleryState, index: i32) {
        model.palette_pick = index;
        execute_palette_command(model);
    }
    state done() {}
}

machine gallery_fonts(main: &Main) -> WindowsUiFonts {
    WindowsUiFonts { device: main.hdc_mem, regular: main.font_reg, medium: main.font_medium,
        bold: main.font_bold, width: clamp_i32(main.client_w as i32, 320, 3840), height: clamp_i32(main.client_h as i32, 240, 2160) }
}

machine build_gallery_frame(main: &mut Main) reaches WindowsGuiHost {
    let mouse_x: i32 = main.ctx.mouse_x;
    let mouse_y: i32 = main.ctx.mouse_y;
    UiContext::set_theme(&mut main.ctx, main.model.dark_mode);
    let font_height: i32 = clamp_i32(main.client_h as i32, 240, 2160);
    select_font_tier(main, font_height);
    let mut frame: UiFrame = UiFrame::begin(&mut main.ctx);
    transition { _ -> build(main, &mut frame, mouse_x, mouse_y) }
    state build(main: &mut Main, frame: &mut UiFrame, mouse_x: i32, mouse_y: i32) {
        sync_gallery_motion(&mut main.ctx, &mut main.model);
        let volume: i32 = main.model.volume;
        let speed: i32 = main.model.speed;
        let scroll: i32 = main.model.list_scroll;
        build_gallery_view(&mut main.ctx, &mut main.model);
        main.ctx.changed = main.ctx.changed || main.model.volume != volume || main.model.speed != speed || main.model.list_scroll != scroll;
        main.ctx.nodes[0].style.background = main.ctx.theme.background;
        let fonts: WindowsUiFonts = gallery_fonts(main);
        WindowsUiFonts::measure(&fonts, &mut main.ctx);
        transition UiFrame::next_pass(frame, &mut main.ctx) {
            true -> build(main, frame, mouse_x, mouse_y)
            _ -> finish(main, mouse_x, mouse_y)
        }
    }
    state finish(main: &mut Main, mouse_x: i32, mouse_y: i32) {
        main.layout_error = select_i32(main.layout_error == 0, main.ctx.frame_error, main.layout_error);
        main.ctx.mouse_x = mouse_x;
        main.ctx.mouse_y = mouse_y;
    }
}

machine build_gallery_view(ctx: &mut UiContext, model: &mut GalleryState) {
    ctx.accent_index = model.accent_index;
    UiContext::set_theme(ctx, model.dark_mode);
    transition model.hi_contrast {
        true -> boost_border(ctx, model)
        _ -> start_ui(ctx, model)
    }
    state boost_border(ctx: &mut UiContext, model: &mut GalleryState) {
        ctx.theme.border = select_i32(model.dark_mode, 0x475569, 0x94A3B8);
        transition { _ -> start_ui(ctx, model) }
    }
    state start_ui(ctx: &mut UiContext, model: &mut GalleryState) {
        let was_open: bool = model.palette_open;
        transition was_open {
            true -> modal_input(ctx, model)
            _ -> run_layout(ctx, model, false)
        }
    }
    state modal_input(ctx: &mut UiContext, model: &mut GalleryState) {
        handle_palette_modal_mouse(ctx, model);
        ctx.mouse_x = -1;
        ctx.mouse_y = -1;
        ctx.mouse_pressed = false;
        ctx.mouse_released = false;
        UiContext::update_hot(ctx);
        transition { _ -> run_layout(ctx, model, true) }
    }
    state run_layout(ctx: &mut UiContext, model: &mut GalleryState, was_open: bool) {
        let col_muted: i32 = ctx.theme.text_muted;
        let col_accent: i32 = ctx.theme.accent;
        let col_success: i32 = ctx.theme.success;
        let col_purple: i32 = ctx.theme.purple;
        let col_orange: i32 = ctx.theme.orange;

        // Left Sidebar (width 248px, gap 5px, padding 12px)
        Ui::sidebar(ctx, 248, 6, 16);
        GalleryUi::sidebar_label(ctx, 0, 1, 40);
        let nav0: bool = GalleryUi::sidebar_item(ctx, 10, model.page == 0, 8, 2, col_muted);
        let nav1: bool = GalleryUi::sidebar_item(ctx, 11, model.page == 1, 5, 5, col_accent);
        let nav2: bool = GalleryUi::sidebar_item(ctx, 12, model.page == 2, 6, 6, col_success);
        let nav3: bool = GalleryUi::sidebar_item(ctx, 13, model.page == 3, 4, 10, col_purple);
        let nav4: bool = GalleryUi::sidebar_item(ctx, 16, model.page == 4, 2, 4, col_orange);
        let launcher: Interaction = Ui::button(ctx, 9, "Search", ButtonOptions { variant: ButtonVariant::Secondary, width: 216, height: 36 });
        let pal_btn: bool = launcher.clicked;
        Ui::spacer(ctx);
        let th_click: bool = GalleryUi::sidebar_action(ctx, 14, 4, 32);
        Ui::end(ctx);

        // Main Interactive Playground Pane (width 776px, gap 12px, padding 16px)
        Ui::column(ctx, 12, 16, true, true);
        let title_lbl: i32 = select_i32(model.page == 0, 2, select_i32(model.page == 1, 5, select_i32(model.page == 2, 6, 10)));
        GalleryUi::header_bar(ctx, 15, title_lbl, &mut model.page, &mut model.range_mode, &mut model.paused);

        let nav_picked: i32 = select_i32(nav0, 0, select_i32(nav1, 1, select_i32(nav2, 2, select_i32(nav3, 3, select_i32(nav4, 4, -1)))));
        transition model.page == 0 {
            true -> page_ctrl(ctx, model, nav_picked, pal_btn, th_click, was_open)
            _ -> check_page1(ctx, model, nav_picked, pal_btn, th_click, was_open)
        }
    }
    state page_ctrl(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        build_controls_page(ctx, model);
        transition { _ -> finish_view(ctx, model, nav_picked, pal_btn, th_click, was_open) }
    }
    state check_page1(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        transition model.page == 1 {
            true -> page_tasks(ctx, model, nav_picked, pal_btn, th_click, was_open)
            _ -> check_page2(ctx, model, nav_picked, pal_btn, th_click, was_open)
        }
    }
    state page_tasks(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        build_tasks_page(ctx, model);
        transition { _ -> finish_view(ctx, model, nav_picked, pal_btn, th_click, was_open) }
    }
    state check_page2(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        transition model.page == 2 {
            true -> page_synth(ctx, model, nav_picked, pal_btn, th_click, was_open)
            _ -> check_page3(ctx, model, nav_picked, pal_btn, th_click, was_open)
        }
    }
    state page_synth(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        build_synth_page(ctx, model);
        transition { _ -> finish_view(ctx, model, nav_picked, pal_btn, th_click, was_open) }
    }
    state check_page3(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        transition model.page == 3 {
            true -> page_theme(ctx, model, nav_picked, pal_btn, th_click, was_open)
            _ -> page_dock(ctx, model, nav_picked, pal_btn, th_click, was_open)
        }
    }
    state page_theme(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        build_theme_page(ctx, model);
        transition { _ -> finish_view(ctx, model, nav_picked, pal_btn, th_click, was_open) }
    }
    state page_dock(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        build_dock_page(ctx, model);
        transition { _ -> finish_view(ctx, model, nav_picked, pal_btn, th_click, was_open) }
    }
    state finish_view(ctx: &mut UiContext, model: &mut GalleryState, nav_picked: i32, pal_btn: bool, th_click: bool, was_open: bool) {
        Ui::end(ctx);

        model.page = select_i32(!was_open && nav_picked >= 0, nav_picked, model.page);
        let flipped: i32 = select_i32(!model.dark_mode, 1, 0);
        let kept: i32 = select_i32(model.dark_mode, 1, 0);
        model.dark_mode = select_i32(!was_open && th_click, flipped, kept) == 1;
        transition !was_open && pal_btn {
            true -> open_pal(model)
            _ -> done_frame()
        }
    }
    state open_pal(model: &mut GalleryState) {
        model.palette_open = true;
        model.palette_pick = 0;
    }
    state done_frame() {}
}

// Query live client rectangle every frame so window resizing / maximizing
// immediately updates `main.client_w`, `main.client_h`, and `main.ctx.aspect_pct`.
machine sync_client_size(main: &mut Main, hwnd: u64)
reaches WindowsGuiHost {
    let mut rc: WindowsRectangle = WindowsRectangle { left: 0, top: 0, right: 0, bottom: 0 };
    let ok: i32 = WindowsGuiHost::client_rectangle(hwnd, &mut rc);
    let rw: i32 = sub_i32(rc.right, rc.left);
    let rh: i32 = sub_i32(rc.bottom, rc.top);
    transition ok != 0 && rw >= 320 && rh >= 240 {
        true -> apply_sz(main, clamp_i32(rw, 320, 3840), clamp_i32(rh, 240, 2160))
        _ -> done()
    }
    state apply_sz(main: &mut Main, cw: i32, ch: i32) {
        main.redraw_requested = main.redraw_requested || main.client_w != cw || main.client_h != ch;
        main.client_w = cw as i32 in Saturating;
        main.client_h = ch as i32 in Saturating;
        let safe_cw: i32 = clamp_i32(cw, 320, 3840);
        transition safe_cw > 0 {
            true -> set_ap(main, safe_cw, ch)
            _ -> done()
        }
    }
    state set_ap(main: &mut Main, safe_cw: i32, ch: i32)
    requires safe_cw > 0 {
        main.ctx.aspect_pct = clamp_i32(add_i32(mul_i32(ch, 1524), safe_cw / 2) / safe_cw, 600, 1400);
    }
    state done() {}
}

// Poll physical cursor position and left mouse button state directly from Win32
// when our window is in the foreground so hover, clicks, and slider dragging work
// reliably at 60fps across any resized window dimensions.
machine poll_live_mouse(main: &mut Main, hwnd: u64)
reaches WindowsGuiHost {
    refresh_drag_capture(main, hwnd);
    sync_client_size(main, hwnd);
    let fg: u64 = WindowsGuiHost::foreground_window();
    let ok1: i32 = WindowsGuiHost::get_cursor_pos(&mut main.cursor_pt[0]);
    let ok2: i32 = WindowsGuiHost::screen_to_client(hwnd, &mut main.cursor_pt[0]);
    let cx: i32 = main.cursor_pt[0];
    let cy: i32 = main.cursor_pt[1];
    let cw: i32 = clamp_i32(main.client_w as i32, 320, 3840);
    let ch: i32 = clamp_i32(main.client_h as i32, 240, 2160);
    let inside: bool = cx >= 0 && cx < cw && cy >= 0 && cy < ch;
    transition (inside || main.prev_lbutton || main.lbutton_msg_down) && cw > 0 && ch > 0 {
        true -> apply_cursor(main, fg == hwnd, clamp_i32(mul_i32(cx, 1024) / cw, 0, 1023), clamp_i32(mul_i32(cy, 672) / ch, 0, 671))
        _ -> release_outside(main)
    }
    state apply_cursor(main: &mut Main, is_fg: bool, lx: i32, ly: i32) {
        main.redraw_requested = main.redraw_requested || main.ctx.mouse_x != lx || main.ctx.mouse_y != ly;
        main.ctx.mouse_x = select_i32(main.lbutton_msg_down, main.ctx.mouse_x, lx);
        main.ctx.mouse_y = select_i32(main.lbutton_msg_down, main.ctx.mouse_y, ly);
        let ks: i32 = WindowsGuiHost::get_async_key_state(1);
        let async_down: bool = (ks & 32768) != 0;
        let is_down: bool = main.lbutton_msg_down || ((is_fg || main.prev_lbutton) && async_down);
        let was_down: bool = main.prev_lbutton;
        main.redraw_requested = main.redraw_requested || is_down != was_down;
        main.ctx.mouse_pressed = is_down && !was_down;
        main.ctx.mouse_released = !is_down && was_down;
        main.ctx.mouse_down = is_down;
        main.prev_lbutton = is_down;
        main.lbutton_msg_down = false;
    }
    state release_outside(main: &mut Main) {
        main.redraw_requested = main.redraw_requested || main.ctx.mouse_x != -1 || main.ctx.mouse_y != -1;
        main.ctx.mouse_x = -1;
        main.ctx.mouse_y = -1;
        let ks: i32 = WindowsGuiHost::get_async_key_state(1);
        let async_down: bool = (ks & 32768) != 0;
        let is_down: bool = main.prev_lbutton && async_down;
        let was_down: bool = main.prev_lbutton;
        main.redraw_requested = main.redraw_requested || is_down != was_down;
        main.ctx.mouse_pressed = false;
        main.ctx.mouse_released = !is_down && was_down;
        main.ctx.mouse_down = is_down;
        main.prev_lbutton = is_down;
        main.lbutton_msg_down = false;
    }
}

machine handle_mouse_message(main: &mut Main, kind: u64, wp: u64, lp: u64) {
    let raw_x: i32 = (lp & 65535) as i32;
    let raw_y: i32 = ((lp / 65536) & 65535) as i32;
    let cw: i32 = clamp_i32(main.client_w as i32, 320, 3840);
    let ch: i32 = clamp_i32(main.client_h as i32, 240, 2160);
    transition cw > 0 && ch > 0 {
        true -> apply_msg(main, kind, wp, clamp_i32(mul_i32(raw_x, 1024) / cw, 0, 1023), clamp_i32(mul_i32(raw_y, 672) / ch, 0, 671))
        _ -> done()
    }
    state apply_msg(main: &mut Main, kind: u64, wp: u64, lx: i32, ly: i32) {
        main.ctx.mouse_x = lx;
        main.ctx.mouse_y = ly;
        transition kind == 513 || (kind == 512 && (wp & 1) == 1 && !main.prev_lbutton) {
            true -> down(main)
            _ -> done()
        }
    }
    state down(main: &mut Main) {
        main.lbutton_msg_down = true;
    }
    state done() {}
}

machine append_char_to_buf(model: &mut GalleryState, ch: u8) {
    let cur: i32 = clamp_i32(model.text_len, 0, 14);
    transition cur >= 0 && cur < 14 {
        true -> put_ch(model, cur, ch)
        _ -> done()
    }
    state put_ch(model: &mut GalleryState, cur: i32, ch: u8)
    requires cur >= 0 && cur < 14 {
        model.text_buf[cur] = ch;
        model.text_len = cur + 1;
    }
    state done() {}
}

machine handle_text_edit_key(model: &mut GalleryState, k: i32) -> bool {
    transition k == 8 {
        true -> do_bs(model)
        _ -> check_right(model, k)
    }
    state do_bs(model: &mut GalleryState) -> bool {
        let next_len: i32 = clamp_i32(sub_i32(model.text_len, 1), 0, 15);
        transition next_len >= 0 && next_len < 16 {
            true -> clr_ch(model, next_len)
            _ -> (true)
        }
    }
    state clr_ch(model: &mut GalleryState, next_len: i32) -> bool
    requires next_len >= 0 && next_len < 16 {
        model.text_buf[next_len] = 32;
        model.text_len = next_len;
        transition { _ -> (true) }
    }
    state check_right(model: &mut GalleryState, k: i32) -> bool {
        transition k == 39 {
            true -> do_accept(model)
            _ -> check_space(model, k)
        }
    }
    state do_accept(model: &mut GalleryState) -> bool {
        accept_ghost_text(model);
        transition { _ -> (true) }
    }
    state check_space(model: &mut GalleryState, k: i32) -> bool {
        transition k == 32 || k == 189 {
            true -> do_sp(model, select_i32(k == 189, 45, 32) as u8)
            _ -> check_alnum(model, k)
        }
    }
    state do_sp(model: &mut GalleryState, ch: u8) -> bool {
        append_char_to_buf(model, ch);
        transition { _ -> (true) }
    }
    state check_alnum(model: &mut GalleryState, k: i32) -> bool {
        let is_let: bool = k >= 65 && k <= 90;
        let is_dig: bool = k >= 48 && k <= 57;
        transition is_let || is_dig {
            true -> do_alnum(model, k, is_let)
            _ -> (false)
        }
    }
    state do_alnum(model: &mut GalleryState, k: i32, is_let: bool) -> bool {
        let ch_code: i32 = clamp_i32(select_i32(is_let && model.text_len > 0, add_i32(k, 32), k), 32, 122);
        transition ch_code >= 32 && ch_code <= 122 {
            true -> push_alnum(model, ch_code)
            _ -> (true)
        }
    }
    state push_alnum(model: &mut GalleryState, ch_code: i32) -> bool
    requires ch_code >= 32 && ch_code <= 122 {
        append_char_to_buf(model, ch_code as u8);
        transition { _ -> (true) }
    }
}

machine handle_palette_key(main: &mut Main, key: i32) reaches WindowsGuiHost {
    transition key {
        27 -> close(main)
        13 -> execute(main)
        38 -> navigate(main, -1)
        40 -> navigate(main, 1)
        _ -> edit(main, key)
    }
    state close(main: &mut Main) { main.model.palette_open = false; }
    state execute(main: &mut Main) { execute_palette_command(&mut main.model); }
    state navigate(main: &mut Main, direction: i32) {
        main.model.palette_pick = clamp_i32(add_i32(main.model.palette_pick, direction), 0, max_i32(sub_i32(main.model.search.count, 1), 0));
    }
    state edit(main: &mut Main, key: i32) {
        let control: i32 = WindowsGuiHost::get_key_state(17);
        let shift: i32 = WindowsGuiHost::get_key_state(16);
        GallerySearch::key(&mut main.model.search, key, (control & 32768) != 0, (shift & 32768) != 0);
        main.model.palette_pick = 0;
    }
}

machine handle_key_message(main: &mut Main, k: i32) {
    transition main.model.palette_open {
        true -> modal_key(main, k)
        _ -> check_open_pal(main, k)
    }
    state modal_key(main: &mut Main, k: i32) {
        main.ctx.key_code = k;
    }
    state check_open_pal(main: &mut Main, k: i32) {
        transition k == 191 || k == 111 || (k == 75 && !main.model.text_focused) {
            true -> do_open_pal(main)
            _ -> check_esc(main, k)
        }
    }
    state do_open_pal(main: &mut Main) {
        main.ignore_palette_character = true;
        main.model.palette_open = true;
        main.model.palette_pick = 0;
    }
    state check_esc(main: &mut Main, k: i32) {
        transition k == 27 {
            true -> do_esc(main)
            _ -> check_tf_edit(main, k)
        }
    }
    state do_esc(main: &mut Main) {
        transition main.model.text_focused {
            true -> unfocus_tf(main)
            _ -> close_app(main)
        }
    }
    state unfocus_tf(main: &mut Main) {
        main.model.text_focused = false;
    }
    state close_app(main: &mut Main) {
        main.close_requested = true;
    }
    state check_tf_edit(main: &mut Main, k: i32) {
        transition k == 9 {
            true -> focus_control(main)
            _ -> check_activation(main, k)
        }
    }
    state focus_control(main: &mut Main) {
        UiContext::focus_next(&mut main.ctx, false);
        main.model.text_focused = false;
    }
    state check_activation(main: &mut Main, k: i32) {
        transition !main.model.text_focused && (k == 13 || k == 32) {
            true -> stage_activation(main, k)
            _ -> check_tab_navigation(main, k)
        }
    }
    state check_tab_navigation(main: &mut Main, k: i32) {
        transition main.ctx.focus == 15 && (k == 37 || k == 39 || k == 36 || k == 35) {
            true -> navigate_tabs(main, k)
            _ -> check_number_field(main, k)
        }
    }
    state navigate_tabs(main: &mut Main, k: i32) {
        let step: i32 = select_i32(k == 37, 4, 1);
        main.model.page = select_i32(k == 36, 0, select_i32(k == 35, 4, add_i32(main.model.page, step) % 5));
    }
    state stage_activation(main: &mut Main, k: i32) {
        main.ctx.key_code = k;
    }
    state check_number_field(main: &mut Main, k: i32) {
        transition main.model.page == 0 && main.ctx.focus == 24 && (k == 38 || k == 40 || k == 36 || k == 35) {
            true -> number_field_key(main, k)
            _ -> check_text_field(main, k)
        }
    }
    state number_field_key(main: &mut Main, k: i32) {
        main.ctx.key_code = k;
    }
    state check_text_field(main: &mut Main, k: i32) {
        transition main.model.page == 0 && main.model.text_focused {
            true -> try_tf_key(main, k)
            _ -> check_tab(main, k)
        }
    }
    state try_tf_key(main: &mut Main, k: i32) {
        let handled: bool = handle_text_edit_key(&mut main.model, k);
        transition !handled {
            true -> check_tab(main, k)
            _ -> done_key()
        }
    }
    state check_tab(main: &mut Main, k: i32) {
        transition k == 9 {
            true -> do_tab(main)
            _ -> check_num_tab(main, k)
        }
    }
    state do_tab(main: &mut Main) {
        main.model.page = add_i32(main.model.page, 1) % 5;
    }
    state check_num_tab(main: &mut Main, k: i32) {
        transition k >= 49 && k <= 53 {
            true -> do_num_tab(main, sub_i32(k, 49))
            _ -> check_toggles(main, k)
        }
    }
    state do_num_tab(main: &mut Main, p: i32) {
        main.model.page = p;
    }
    state check_toggles(main: &mut Main, k: i32) {
        transition k == 84 {
            true -> do_theme(main)
            _ -> check_pause(main, k)
        }
    }
    state do_theme(main: &mut Main) {
        main.model.dark_mode = !main.model.dark_mode;
    }
    state check_pause(main: &mut Main, k: i32) {
        transition k == 80 {
            true -> do_pause(main)
            _ -> do_arrows(main, k)
        }
    }
    state do_pause(main: &mut Main) {
        main.model.paused = !main.model.paused;
        main.model.live_anim = !main.model.paused;
    }
    state do_arrows(main: &mut Main, k: i32) {
        let c_delta: i32 in Saturating = select_sat(k == 38, 1, select_sat(k == 40, -1, 0));
        main.model.clicks = clamp_i32((main.model.clicks + c_delta) as i32, 0, 999) as i32 in Saturating;
        let v_delta: i32 in Saturating = select_sat(k == 39, 5, select_sat(k == 37, -5, 0));
        main.model.volume = clamp_i32(((main.model.volume as i32 in Saturating) + v_delta) as i32, 0, 100);
    }
    state done_key() {}
}

machine handle_win32_message(main: &mut Main) reaches WindowsGuiHost {
    let kind: u64 = WindowsMessage::kind(&main.message);
    let wp: u64 = WindowsMessage::word_parameter(&main.message);
    let lp: u64 = main.message.words[3];
    update_drag_capture(main, kind);
    main.full_redraw_requested = main.full_redraw_requested || kind == 5 || kind == 15;
    main.redraw_requested = main.redraw_requested || kind == 5 || kind == 15
        || kind == 256 || kind == 258 || (kind >= 512 && kind <= 514);
    transition kind == 16 || (kind == 161 && wp == 20) {
        true -> req_close(main)
        _ -> check_sys(main, kind, wp, lp)
    }
    state req_close(main: &mut Main) {
        main.close_requested = true;
    }
    state check_sys(main: &mut Main, kind: u64, wp: u64, lp: u64) {
        transition (kind == 273 && (wp & 65535) == 2) || (kind == 274 && wp >= 61536 && wp < 61552) {
            true -> req_close(main)
            _ -> check_mouse(main, kind, wp, lp)
        }
    }
    state check_mouse(main: &mut Main, kind: u64, wp: u64, lp: u64) {
        transition kind >= 512 && kind <= 514 {
            true -> do_mouse(main, kind, wp, lp)
            _ -> check_character(main, kind, wp)
        }
    }
    state do_mouse(main: &mut Main, kind: u64, wp: u64, lp: u64) {
        handle_mouse_message(main, kind, wp, lp);
    }
    state check_character(main: &mut Main, kind: u64, wp: u64) {
        transition kind == 258 && main.model.palette_open {
            true -> character(main, wp)
            _ -> check_key(main, kind, wp)
        }
    }
    state character(main: &mut Main, value: u64) {
        transition main.ignore_palette_character {
            true -> opening_character(main)
            _ -> insert_character(main, value)
        }
    }
    state opening_character(main: &mut Main) { main.ignore_palette_character = false; }
    state insert_character(main: &mut Main, value: u64) {
        GallerySearch::character(&mut main.model.search, value);
        main.model.palette_pick = 0;
    }
    state check_key(main: &mut Main, kind: u64, wp: u64) {
        transition kind == 256 && ((wp != 13 && wp != 32) || (main.message.words[3] & 1073741824) == 0) {
            true -> do_key(main, (wp & 255) as i32)
            _ -> done()
        }
    }
    state do_key(main: &mut Main, k: i32) {
        transition main.model.palette_open {
            true -> palette_key(main, k)
            _ -> ordinary_key(main, k)
        }
    }
    state palette_key(main: &mut Main, k: i32) { handle_palette_key(main, k); }
    state ordinary_key(main: &mut Main, k: i32) {
        transition k == 9 {
            true -> focus_tab(main)
            _ -> dispatch_key(main, k)
        }
    }
    state focus_tab(main: &mut Main) {
        let shift: i32 = WindowsGuiHost::get_key_state(16);
        UiContext::focus_next(&mut main.ctx, (shift & 32768) != 0);
        main.model.text_focused = false;
    }
    state dispatch_key(main: &mut Main, k: i32) {
        handle_key_message(main, k);
    }
    state done() {}
}

machine gallery_window_create(class_name: [u8; 7], title: [u8; 9], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
reaches WindowsGuiHost {
    WindowsGuiHost::window_create_client(&class_name, &title, style, x, y, width, height)
}

machine gallery_blit_band_1to1(device: u64, dest_y: i32, left: i32, width: i32, pixels: &[i32; 4096], info: &[i32; 11]) -> i32
reaches WindowsGuiHost {
    WindowsGuiHost::stretch_dibits(
        device, left, dest_y, width, 1,
        left, 0, width, 1,
        &pixels[0], &info[0], 0, 13369376
    )
}

machine rgb_to_colorref(rgb: i32) -> u32 {
    let c: i32 in Saturating = clamp_i32(rgb, 0, 16777215) as i32 in Saturating;
    let r: i32 in Saturating = (c / (65536 as i32 in Saturating)) % (256 as i32 in Saturating);
    let g: i32 in Saturating = (c / (256 as i32 in Saturating)) % (256 as i32 in Saturating);
    let b: i32 in Saturating = c % (256 as i32 in Saturating);
    let bgr: i32 = ((b * (65536 as i32 in Saturating)) + (g * (256 as i32 in Saturating)) + r) as i32;
    transition bgr >= 0 {
        true -> (bgr as u32)
        _ -> (0u32)
    }
}

machine select_u64(cond: bool, t: u64, f: u64) -> u64 {
    transition cond {
        true -> (t)
        _ -> (f)
    }
}

// Map alignment mode (`0` = left+vcenter, `1` = center+vcenter, `2` = right+vcenter,
// `3` = clipped left+vcenter, `4` = clipped left+vcenter with `DT_END_ELLIPSIS`)
// to Win32 `DrawTextA` format flags (`DT_VCENTER = 4`, `DT_SINGLELINE = 32`,
// `DT_NOCLIP = 256`, `DT_END_ELLIPSIS = 32768`).
machine dt_format(align: i32) -> u32 {
    transition align == 1 {
        true -> (293u32)
        _ -> check_right(align)
    }
    state check_right(align: i32) -> u32 {
        transition align == 2 {
            true -> (294u32)
            _ -> check_clip(align)
        }
    }
    state check_clip(align: i32) -> u32 {
        transition align == 3 {
            true -> (36u32)
            _ -> check_ellip(align)
        }
    }
    state check_ellip(align: i32) -> u32 {
        transition align == 4 {
            true -> (32804u32)
            _ -> (292u32)
        }
    }
}

machine measure_ct_width(hdc: u64, font: u64, text: &[u8]) -> i32
reaches WindowsGuiHost {
    let prev: u64 = WindowsGuiHost::select_object(hdc, font);
    let mut ext: WindowsTextExtent = WindowsTextExtent { width: 0, height: 0 };
    let mut wide: UiUtf16Text;
    let valid: bool = UiUtf16Text::decode(&mut wide, text);
    transition valid && wide.length <= 8192u64 {
        true -> measure_wide(hdc, &wide.units[0..wide.length], &mut ext)
        _ -> (0)
    }
    state measure_wide(hdc: u64, text: &[u16], extent: &mut WindowsTextExtent) -> i32 {
        let ok: i32 = WindowsGuiHost::get_text_extent_wide(hdc, text, extent);
        extent.width
    }
}

machine draw_ct_box(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, text: &[u8], rgb: i32, align: i32)
reaches WindowsGuiHost {
    let cw: i32 = clamp_i32(main.client_w as i32, 320, 3840);
    let ch: i32 = clamp_i32(main.client_h as i32, 240, 2160);
    let sx: i32 = add_i32(mul_i32(x, cw), 512) / 1024;
    let sy: i32 = add_i32(mul_i32(y, ch), 336) / 672;
    let sw: i32 = max_i32(add_i32(mul_i32(w, cw), 512) / 1024, 1);
    let sh: i32 = max_i32(add_i32(mul_i32(h, ch), 336) / 672, 1);
    let rectangle: WindowsRectangle = WindowsRectangle { left: sx, top: sy, right: add_i32(sx, sw), bottom: add_i32(sy, sh) };
    let visible: i32 = WindowsGuiHost::rectangle_visible(main.hdc_mem, &rectangle);
    transition visible != 0 && text.len > 0u64 {
        true -> decode(main, font, rectangle, text, rgb, align)
        _ -> done()
    }
    state decode(main: &Main, font: u64, rectangle: WindowsRectangle, text: &[u8], rgb: i32, align: i32) {
        let mut wide: UiUtf16Text;
        let valid: bool = UiUtf16Text::decode(&mut wide, text);
        transition valid && wide.length <= 8192u64 {
            true -> paint(main, font, rectangle, &wide.units[0..wide.length], rgb, align)
            _ -> done()
        }
    }
    state paint(main: &Main, font: u64, rectangle: WindowsRectangle, text: &[u16], rgb: i32, align: i32) {
        let previous: u64 = WindowsGuiHost::select_object(main.hdc_mem, font);
        let color: u32 = WindowsGuiHost::set_text_color(main.hdc_mem, rgb_to_colorref(rgb));
        let format: i32 = select_i32(align == 1, 2085, select_i32(align == 2, 2086, 2084));
        let mut target: WindowsRectangle = rectangle;
        let drawn: i32 = WindowsGuiHost::draw_text_rect_wide(main.hdc_mem, text, &mut target, format as u32);
    }
    state done() {}
}

machine draw_ct_box_alpha(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, text: &[u8], bg_rgb: i32, fg_rgb: i32, alpha_pct: i32, align: i32)
reaches WindowsGuiHost {
    let blended: i32 = color_mix(bg_rgb, fg_rgb, alpha_pct);
    draw_ct_box(main, font, x, y, w, h, text, blended, align);
}

machine draw_ct_pct_box(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, val: i32, rgb: i32, align: i32)
reaches WindowsGuiHost {
    let v: i32 = clamp_i32(val, 0, 100);
    transition v >= 100 {
        true -> p100(main, font, x, y, w, h, rgb, align)
        _ -> check_p10(main, font, x, y, w, h, v, rgb, align)
    }
    state p100(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, rgb: i32, align: i32) {
        draw_ct_box(main, font, x, y, w, h, "100%", rgb, align);
    }
    state check_p10(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32, align: i32) {
        transition v >= 10 {
            true -> p10(main, font, x, y, w, h, v, rgb, align)
            _ -> p1(main, font, x, y, w, h, v, rgb, align)
        }
    }
    state p10(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32, align: i32) {
        let mut buf: [u8; 3] = "00%";
        buf[0] = (48 + ((v / 10) % 10)) as u8;
        buf[1] = (48 + (v % 10)) as u8;
        buf[2] = 37;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, align);
    }
    state p1(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32, align: i32) {
        let mut buf: [u8; 2] = "0%";
        buf[0] = (48 + (v % 10)) as u8;
        buf[1] = 37;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, align);
    }
}

machine draw_ct_num3_box(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, val: i32, rgb: i32, align: i32)
reaches WindowsGuiHost {
    let v: i32 = clamp_i32(val, 0, 999);
    transition v >= 100 {
        true -> d3(main, font, x, y, w, h, v, rgb, align)
        _ -> check_d2(main, font, x, y, w, h, v, rgb, align)
    }
    state d3(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32, align: i32) {
        let mut buf: [u8; 3] = "000";
        buf[0] = (48 + ((v / 100) % 10)) as u8;
        buf[1] = (48 + ((v / 10) % 10)) as u8;
        buf[2] = (48 + (v % 10)) as u8;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, align);
    }
    state check_d2(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32, align: i32) {
        transition v >= 10 {
            true -> d2(main, font, x, y, w, h, v, rgb, align)
            _ -> d1(main, font, x, y, w, h, v, rgb, align)
        }
    }
    state d2(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32, align: i32) {
        let mut buf: [u8; 2] = "00";
        buf[0] = (48 + ((v / 10) % 10)) as u8;
        buf[1] = (48 + (v % 10)) as u8;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, align);
    }
    state d1(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32, align: i32) {
        let mut buf: [u8; 1] = "0";
        buf[0] = (48 + (v % 10)) as u8;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, align);
    }
}

machine draw_ct_spd_box(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, spd: i32, rgb: i32, align: i32)
reaches WindowsGuiHost {
    let v: i32 = clamp_i32(spd, 1, 10);
