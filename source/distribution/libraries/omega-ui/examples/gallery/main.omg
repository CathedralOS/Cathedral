    let initial_speed: i32 = main.model.speed;
    main.model.dark_mode = false;
    main.model.speed = 1;
    build_gallery_frame(main);
    render_and_blit_frame(main, 0);
    save_offscreen_bmp(main, "snapshot_number_min.bmp\0");
    main.model.dark_mode = true;
