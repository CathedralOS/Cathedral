    draw_native_sidebar_link(main, 16, "Panels", main.model.page == 4);
    transition main.model.dark_mode {
        true -> dark(main)
        _ -> light(main)
    }
    state dark(main: &Main) { draw_native_sidebar_action_text(main, 14, "Theme", "Dark"); }
    state light(main: &Main) { draw_native_sidebar_action_text(main, 14, "Theme", "Light"); }
}

machine draw_native_header_bar(main: &Main)
reaches WindowsGuiHost {
    let dc: &Main = main;
    let p: i32 = main.model.page;
    let c0: i32 = select_i32(p == 0, main.ctx.theme.text, main.ctx.theme.text_muted);
    let c1: i32 = select_i32(p == 1, main.ctx.theme.text, main.ctx.theme.text_muted);
    let c2: i32 = select_i32(p == 2, main.ctx.theme.text, main.ctx.theme.text_muted);
    let c3: i32 = select_i32(p == 3, main.ctx.theme.text, main.ctx.theme.text_muted);
    let c4: i32 = select_i32(p == 4, main.ctx.theme.text, main.ctx.theme.text_muted);

    draw_ct_box(dc, main.font_bold, 972, 18, 32, 24, "||", main.ctx.theme.text_muted, 1);
    draw_ct_box(dc, main.font_medium, 268, 46, 84, 24, "Controls", c0, 1);
    draw_ct_box(dc, main.font_medium, 356, 46, 84, 24, "Tasks", c1, 1);
    draw_ct_box(dc, main.font_medium, 444, 46, 84, 24, "Synthesizer", c2, 1);
    draw_ct_box(dc, main.font_medium, 532, 46, 84, 24, "Appearance", c3, 1);
    draw_ct_box(dc, main.font_medium, 620, 46, 84, 24, "Panels", c4, 1);

    transition p <= 1 {
        true -> hdr_01(dc, main.font_title, p, main.ctx.theme.text)
        _ -> hdr_234(dc, main.font_title, p, main.ctx.theme.text)
    }
    state hdr_01(dc: &Main, f: u64, p: i32, col: i32) {
        transition p == 0 {
            true -> h0(dc, f, col)
            _ -> h1(dc, f, col)
        }
    }
    state h0(dc: &Main, f: u64, col: i32) {
        draw_ct_box(dc, f, 268, 16, 420, 26, "Controls", col, 0);
    }
    state h1(dc: &Main, f: u64, col: i32) {
        draw_ct_box(dc, f, 268, 16, 420, 26, "Tasks", col, 0);
    }
    state hdr_234(dc: &Main, f: u64, p: i32, col: i32) {
        transition p == 2 {
            true -> h2(dc, f, col)
            _ -> hdr_34(dc, f, p, col)
        }
    }
    state h2(dc: &Main, f: u64, col: i32) {
        draw_ct_box(dc, f, 268, 16, 420, 26, "Synthesizer", col, 0);
    }
    state hdr_34(dc: &Main, f: u64, p: i32, col: i32) {
        transition p == 3 {
            true -> h3(dc, f, col)
            _ -> h4(dc, f, col)
        }
    }
    state h3(dc: &Main, f: u64, col: i32) {
        draw_ct_box(dc, f, 268, 16, 420, 26, "Appearance", col, 0);
    }
    state h4(dc: &Main, f: u64, col: i32) {
        draw_ct_box(dc, f, 268, 16, 420, 26, "Panel workspace", col, 0);
    }
}

