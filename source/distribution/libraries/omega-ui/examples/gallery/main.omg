    let a1: i32 = select_i32(((vis_mask / 2) % 2) == 1, 100, 45);
    let a2: i32 = select_i32(((vis_mask / 4) % 2) == 1, 100, 45);
    let a3: i32 = select_i32(((vis_mask / 8) % 2) == 1, 100, 45);
    let a4: i32 = select_i32(((vis_mask / 16) % 2) == 1, 100, 45);
    let bg_w: i32 = main.ctx.theme.well;
