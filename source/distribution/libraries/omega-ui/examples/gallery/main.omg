    main.model.speed = initial_speed;
    main.ctx.focus = 0;

    main.model.page = 1;
    build_gallery_frame(main);
    render_and_blit_frame(main, 0);
    save_offscreen_bmp(main, "snapshot_tasks.bmp\0");
    main.model.dark_mode = false;
    build_gallery_frame(main);
    render_and_blit_frame(main, 0);
    save_offscreen_bmp(main, "snapshot_tasks_light.bmp\0");
    main.model.dark_mode = initial_dark;
    let initial_count: i32 = main.model.task_count;
    main.model.task_count = 0;
    build_gallery_frame(main);
    render_and_blit_frame(main, 0);
    save_offscreen_bmp(main, "snapshot_tasks_empty.bmp\0");
    main.model.task_count = 1;
    build_gallery_frame(main);
    render_and_blit_frame(main, 0);
    save_offscreen_bmp(main, "snapshot_tasks_single.bmp\0");
    main.model.task_count = initial_count;

}

