    draw_ct_box(dc, main.font_bold, 282, 496, 380, 22, "Appearance", main.ctx.theme.text, 0);
    draw_ct_box(dc, main.font_bold, 282, 528, 152, 38, "Dark Mode", 0xECEFF4, 1);
    draw_ct_box(dc, main.font_bold, 444, 528, 152, 38, "Light Mode", 0x0F172A, 1);
    draw_ct_box(dc, main.font_bold, 620, 528, 66, 38, "Sky", 0x0B0D11, 1);
    draw_ct_box(dc, main.font_bold, 694, 528, 66, 38, "Mint", 0x0B0D11, 1);
    draw_ct_box(dc, main.font_bold, 768, 528, 66, 38, "Amber", 0x0B0D11, 1);
    draw_ct_box(dc, main.font_bold, 842, 528, 66, 38, "Violet", 0x0B0D11, 1);
    draw_ct_box(dc, main.font_bold, 916, 528, 66, 38, "Rose", 0x0B0D11, 1);
