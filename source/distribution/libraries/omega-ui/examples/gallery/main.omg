// Exercise the real gallery view before rendering its pages. The host supplies
// one press edge per frame; repeated held frames must leave the counter alone.
machine verify_gallery_pointer(main: &mut Main) -> bool reaches WindowsGuiHost {
    build_gallery_frame(main);
    let initial_clicks: i32 in Saturating = main.model.clicks;
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 20);
    Tester::pointer_down_at(&mut main.ctx, add_i32(rectangle.x as i32, 32), add_i32(rectangle.y as i32, 20));
    build_gallery_frame(main);
    let pressed: bool = main.model.clicks == initial_clicks + (1 as i32 in Saturating);
    main.ctx.mouse_pressed = false;
    build_gallery_frame(main);
    let held: bool = main.model.clicks == initial_clicks + (1 as i32 in Saturating);
    Tester::pointer_up(&mut main.ctx);
    build_gallery_frame(main);
    let released: bool = main.model.clicks == initial_clicks + (1 as i32 in Saturating);
    main.model.clicks = initial_clicks;
    pressed && held && released
}

machine verify_gallery_navigation(main: &mut Main) -> bool reaches WindowsGuiHost {
    let staged: bool = Tester::stage_click_id(&mut main.ctx, 11);
    build_gallery_frame(main);
    let navigated: bool = main.model.page == 1;
    Tester::pointer_up(&mut main.ctx);
    build_gallery_frame(main);
    let initial_dark: bool = main.model.dark_mode;
    let theme_staged: bool = Tester::stage_click_id(&mut main.ctx, 14);
    build_gallery_frame(main);
    let themed: bool = main.model.dark_mode != initial_dark;
    Tester::pointer_up(&mut main.ctx);
    build_gallery_frame(main);
    let palette_staged: bool = Tester::stage_click_id(&mut main.ctx, 9);
    build_gallery_frame(main);
    let opened: bool = main.model.palette_open;
    main.model.dark_mode = initial_dark;
    main.model.page = 0;
    main.model.palette_open = false;
    main.model.palette_pick = 0;
    UiContext::setup(&mut main.ctx, 1024, 672, initial_dark);
    staged && navigated && theme_staged && themed && palette_staged && opened
}

machine verify_gallery_number_field(main: &mut Main) -> bool reaches WindowsGuiHost {
    build_gallery_frame(main);
    let initial_speed: i32 = main.model.speed;
    let initial_clicks: i32 in Saturating = main.model.clicks;
    let initial_volume: i32 = main.model.volume;
    main.model.speed = 4;
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 24);
    Tester::pointer_down_at(&mut main.ctx, add_i32(rectangle.x as i32, 156), add_i32(rectangle.y as i32, 18));
    build_gallery_frame(main);
    let pressed: bool = main.model.speed == 5 && main.ctx.focus == 24;
    main.ctx.mouse_pressed = false;
    build_gallery_frame(main);
    let held: bool = main.model.speed == 5;
    Tester::pointer_up(&mut main.ctx);
    build_gallery_frame(main);
    handle_key_message(main, 35);
    build_gallery_frame(main);
    let upper: bool = main.model.speed == 10;
    handle_key_message(main, 40);
    build_gallery_frame(main);
    let keyboard: bool = main.model.speed == 9 && main.model.clicks == initial_clicks && main.model.volume == initial_volume;
    main.model.speed = initial_speed;
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    pressed && held && upper && keyboard && rectangle.h == 36
}

// Exercise the same invalidation route as the native message loop. State-only
// widget tests cannot catch a host that keeps displaying its previous bitmap.
machine verify_gallery_redraw(main: &mut Main) -> bool reaches WindowsGuiHost {
    let initial_page: i32 = main.model.page;
    let initial_dark: bool = main.model.dark_mode;
    let initial_text_focus: bool = main.model.text_focused;
    main.model.page = 3;
    main.model.text_focused = false;
    main.message.words[1] = 256;
    main.message.words[2] = 49;
    main.message.words[3] = 0;
    main.redraw_requested = false;
    handle_win32_message(main);
    let navigation: bool = main.model.page == 0 && main.redraw_requested;
    main.message.words[2] = 84;
    main.redraw_requested = false;
    handle_win32_message(main);
    let theme: bool = main.model.dark_mode != initial_dark && main.redraw_requested;
    main.message.words[1] = 15;
    main.redraw_requested = false;
    handle_win32_message(main);
    let exposure: bool = main.redraw_requested;
    main.message.words[1] = 0;
    main.redraw_requested = false;
    handle_win32_message(main);
    let idle: bool = !main.redraw_requested;
    main.model.page = initial_page;
    main.model.dark_mode = initial_dark;
    main.model.text_focused = initial_text_focus;
    navigation && theme && exposure && idle
}

machine verify_task_layout(main: &mut Main) -> bool reaches WindowsGuiHost {
    let original_page: i32 = main.model.page;
    let original_count: i32 = main.model.task_count;
    let original_done: bool = main.model.task_done[0];
    main.model.page = 1;
    main.model.task_count = 0;
    build_gallery_frame(main);
    let empty: Rect = UiContext::previous_rect(&main.ctx, 31);
    let hidden: Rect = UiContext::previous_rect(&main.ctx, 32);
    let empty_list: Rect = UiContext::previous_rect(&main.ctx, 36);
    main.model.task_count = 1;
    build_gallery_frame(main);
    let single: Rect = UiContext::previous_rect(&main.ctx, 31);
    let single_list: Rect = UiContext::previous_rect(&main.ctx, 36);
    let staged: bool = Tester::stage_click_id(&mut main.ctx, 31);
    build_gallery_frame(main);
    let toggled: bool = main.model.task_done[0] != original_done;
    Tester::pointer_up(&mut main.ctx);
    let filter: Rect = UiContext::previous_rect(&main.ctx, 36);
    Tester::pointer_down_at(&mut main.ctx, add_i32(filter.x as i32, 450), add_i32(filter.y as i32, 20));
    build_gallery_frame(main);
    Tester::pointer_up(&mut main.ctx);
    build_gallery_frame(main);
    let filtered: bool = main.model.list_filter == 1;
    main.model.list_filter = 0;
    main.model.task_count = 3;
    build_gallery_frame(main);
    let last: Rect = UiContext::previous_rect(&main.ctx, 33);
    let full_list: Rect = UiContext::previous_rect(&main.ctx, 36);
    let bounded: bool = main.ctx.node_count < 128;
    main.model.page = original_page;
    main.model.task_count = original_count;
    main.model.task_done[0] = original_done;
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    empty.h == 104 && hidden.h == 0 && single.h == 52 && single_list.y < empty_list.y && full_list.y > single_list.y && full_list.y > last.y && staged && toggled && filtered && bounded
}

machine gallery_counter() -> u64 reaches WindowsGuiHost {
    let mut value: i64;
    let result: i32 = WindowsGuiHost::performance_counter(&mut value);
    transition result != 0 && value >= 0 {
        true -> (value as u64)
        _ -> (0)
    }
}

machine gallery_counter_frequency() -> u64 reaches WindowsGuiHost {
    let mut value: i64;
    let result: i32 = WindowsGuiHost::performance_frequency(&mut value);
    transition result != 0 && value > 0 {
        true -> (value as u64)
        _ -> (0)
    }
}

// Difference absolute milliseconds so fractional time survives high-refresh frames.
machine counter_milliseconds(ticks: u64, frequency: u64) -> u64 requires frequency > 0 {
    let seconds: u64 in Saturating = (ticks as u64 in Saturating) / (frequency as u64 in Saturating);
    let fraction: u64 in Saturating = (((ticks as u64 in Saturating) % (frequency as u64 in Saturating)) * (1000 as u64 in Saturating)) / (frequency as u64 in Saturating);
    (seconds * (1000 as u64 in Saturating) + fraction) as u64
}

machine gallery_milliseconds() -> u64 reaches WindowsGuiHost {
    let ticks: u64 = gallery_counter();
    let frequency: u64 = gallery_counter_frequency();
    transition frequency > 0 {
        true -> (counter_milliseconds(ticks, frequency))
        _ -> (0)
    }
}

machine verify_animation_clock() -> bool {
    let first: u64 = counter_milliseconds(6944, 1000000);
    let second: u64 = counter_milliseconds(13888, 1000000);
    let third: u64 = counter_milliseconds(20833, 1000000);
    first == 6 && second == 13 && third == 20
}

machine write_measurement(value: u64) reaches Console {
    transition value < 1000000 {
        true -> digits(value as i32)
        _ -> overflow()
    }
    state digits(value: i32) {
        Console::write_byte(48 + (value / 100000) % 10);
        Console::write_byte(48 + (value / 10000) % 10);
        Console::write_byte(48 + (value / 1000) % 10);
        Console::write_byte(48 + (value / 100) % 10);
        Console::write_byte(48 + (value / 10) % 10);
        Console::write_byte(48 + value % 10);
    }
    state overflow() { Console::write("OVERFLOW"); }
}

// Uses the same pointer handler, layout, raster, and native text path as a drag.
machine measure_slider_frames(main: &mut Main, compare: bool) reaches Console + WindowsGuiHost {
    main.compare_drag = compare;
    main.model.page = 0;
    main.ctx.motion.reduced = !compare;
    build_gallery_frame(main);
    main.ctx.motion.reduced = false;
    transition { _ -> frame(main, 0) }
    state frame(main: &mut Main, index: i32) {
        transition index >= 0 && index < 64 {
            true -> measure(main, index)
            _ -> finish(main)
        }
    }
    state measure(main: &mut Main, index: i32) requires index >= 0 && index < 64 {
        advance_measurement_motion(main, index);
        main.ctx.mouse_x = add_i32(350, select_i32(main.compare_drag, (index / 2) * 9, (index * 9) / 2));
        main.ctx.mouse_y = 406;
        main.ctx.mouse_down = main.compare_drag || index < 63;
        main.ctx.mouse_pressed = index == 0;
        main.ctx.mouse_released = !main.compare_drag && index == 63;
        main.direct_bitmap = !main.compare_drag || index % 2 == 0;
        main.full_redraw_requested = !main.direct_bitmap;
        let start: u64 = gallery_counter();
        build_gallery_frame(main);
        let arranged: u64 = gallery_counter();
        render_and_blit_frame(main, 0);
        let completed: i32 = WindowsGuiHost::flush_gdi();
        let end: u64 = gallery_counter();
        let frequency: u64 = gallery_counter_frequency();
        transition arranged >= start && end >= arranged && frequency > 0 {
            true -> report(main, index, arranged - start, end - arranged, frequency)
            _ -> finish(main)
        }
    }
    state report(main: &mut Main, index: i32, build_ticks: u64, render_ticks: u64, frequency: u64) requires frequency > 0 {
        write_stream_marker(main.compare_drag);
        Console::write("FRAME_US ");
        write_measurement(index as u64);
        Console::write(" ");
        write_measurement((((build_ticks as u64 in Saturating) * (1000000 as u64 in Saturating)) / (frequency as u64 in Saturating)) as u64);
        Console::write(" ");
        write_measurement((((render_ticks as u64 in Saturating) * (1000000 as u64 in Saturating)) / (frequency as u64 in Saturating)) as u64);
        Console::write_line("");
        capture_damage_comparison(main, index);
        transition { _ -> frame(main, index + 1) }
    }
    state finish(main: &mut Main) {
        main.direct_bitmap = true;
        main.ctx.mouse_down = false;
        main.ctx.mouse_pressed = false;
        main.ctx.mouse_x = -1;
        main.ctx.mouse_y = -1;
        main.model.drag_slider = 0;
        main.model.volume = 65;
        build_gallery_frame(main);
        save_final_comparison(main);
        main.direct_bitmap = true;
    }
}

// Both paths use direct bitmap writes and identical full-frame inputs.
// Captures and reporting stay outside the measured layout/render interval.
machine measure_dot_frames(main: &mut Main) reaches Console + WindowsGuiHost {
    let paused: bool = main.model.paused;
    main.model.paused = true;
    main.model.page = 2;
    main.direct_bitmap = true;
    main.ctx.mouse_down = false;
    main.ctx.mouse_pressed = false;
    main.ctx.mouse_released = false;
    build_gallery_frame(main);
    transition { _ -> frame(main, 0, paused) }
    state frame(main: &mut Main, index: i32, paused: bool) {
        transition index >= 0 && index < 32 {
            true -> measure(main, index, paused)
            _ -> finish(main, paused)
        }
    }
    state measure(main: &mut Main, index: i32, paused: bool)
    requires index >= 0 && index < 32 {
        let pair: i32 = (index % 16) / 2;
        let rectangle: Rect = UiContext::previous_rect(&main.ctx, 42);
        let offset: i32 = select_i32(pair == 0 || pair == 2, 20, select_i32(pair == 1 || pair == 6, 28, select_i32(pair == 3, 586, select_i32(pair == 4, 10, 50))));
        main.ctx.mouse_x = add_i32(rectangle.x as i32, offset);
        main.ctx.mouse_y = add_i32(rectangle.y as i32, select_i32(pair == 5, 2, 82));
        main.model.tick = mul_i32(select_i32(index < 16, pair, pair / 2), 64) as i32 in Saturating;
        main.reference_dots = index % 2 == 1;
        main.full_redraw_requested = main.reference_dots || index < 16;
        let start: u64 = gallery_counter();
        build_gallery_frame(main);
        render_and_blit_frame(main, 0);
        let flushed: i32 = WindowsGuiHost::flush_gdi();
        let end: u64 = gallery_counter();
        let frequency: u64 = gallery_counter_frequency();
        transition end >= start && frequency > 0 {
            true -> report(main, index, paused, end - start, frequency)
            _ -> finish(main, paused)
        }
    }
    state report(main: &mut Main, index: i32, paused: bool, elapsed: u64, frequency: u64)
    requires index >= 0 && index < 32 && frequency > 0 {
        write_dot_measurement_label(index);
        write_measurement(index as u64);
        Console::write(" ");
        write_measurement((((elapsed as u64 in Saturating) * (1000000 as u64 in Saturating)) / (frequency as u64 in Saturating)) as u64);
        Console::write_line("");
        capture_dot_comparison(main, index);
        transition { _ -> frame(main, index + 1, paused) }
    }
    state finish(main: &mut Main, paused: bool) {
        main.reference_dots = false;
    main.ignore_palette_character = false;
    main.model.search.field.view_start = 0;
    main.model.search.field.drag_anchor = -1;
    main.search_pointer_x = -1;
    main.search_pointer_y = -1;
        main.model.paused = paused;
        main.model.tick = 0;
        main.model.page = 0;
        main.ctx.mouse_x = -1;
        main.ctx.mouse_y = -1;
        main.full_redraw_requested = true;
        build_gallery_frame(main);
    }
}

machine write_dot_measurement_label(index: i32) reaches Console {
    transition index < 16 {
        true -> full()
        _ -> hover()
    }
    state full() { Console::write("DOT_FRAME_US "); }
    state hover() { Console::write("DOT_HOVER_US "); }
}

machine capture_dot_comparison(main: &mut Main, index: i32) reaches WindowsGuiHost
requires index >= 0 && index < 32 {
    transition index >= 16 && ((index % 16) / 2 == 1 || (index % 16) / 2 == 4) {
        true -> choose(main, index)
        _ -> done()
    }
    state choose(main: &mut Main, index: i32)
    requires index >= 0 && index < 32 {
        transition index % 2 == 0 {
            true -> fast(main, (index % 16) / 2)
            _ -> slow(main, (index % 16) / 2)
        }
    }
    state fast(main: &mut Main, pair: i32) requires pair >= 0 && pair < 8 {
        let mut path: [u8; 18] = "dot_d_fast_00.bmp\0";
        save_dot_comparison(main, pair, &mut path);
    }
    state slow(main: &mut Main, pair: i32) requires pair >= 0 && pair < 8 {
        let mut path: [u8; 18] = "dot_d_slow_00.bmp\0";
        save_dot_comparison(main, pair, &mut path);
    }
    state done() {}
}

machine save_dot_comparison(main: &mut Main, pair: i32, path: &mut [u8; 18]) reaches WindowsGuiHost requires pair >= 0 && pair < 10 {
    path[4] = select_i32(main.client_w > 2000, 52, 100) as u8;
    path[11] = 48;
    path[12] = (48 + pair) as u8;
    save_offscreen_bmp(main, path);
}

machine advance_measurement_motion(main: &mut Main, index: i32) {
    transition !main.compare_drag || index % 2 == 0 {
        true -> advance(main, index)
        _ -> done()
    }
    state advance(main: &mut Main, index: i32) { let elapsed: i32 = select_i32(main.compare_drag, 16, select_i32(index % 6 == 5, 5, 4)); let changed: bool = UiMotion::advance(&mut main.ctx.motion, elapsed); }
    state done() {}
}

machine save_final_comparison(main: &mut Main) reaches WindowsGuiHost {
    transition main.compare_drag { true -> draw_comparison(main) _ -> done_comparison() }
    state draw_comparison(main: &mut Main) {
    render_and_blit_frame(main, 0);
    transition main.client_w > 1440 {
        true -> direct_4k(main)
        _ -> direct_default(main)
    }
    }
    state direct_4k(main: &mut Main) {
        save_offscreen_bmp(main, "snapshot_4k_direct.bmp\0");
        transition { _ -> reference(main) }
    }
    state direct_default(main: &mut Main) {
        save_offscreen_bmp(main, "snapshot_direct.bmp\0");
        transition { _ -> reference(main) }
    }
    state reference(main: &mut Main) {
        main.direct_bitmap = false;
        main.full_redraw_requested = true;
        render_and_blit_frame(main, 0);
        transition main.client_w > 1440 {
            true -> upload_4k(main)
            _ -> upload_default(main)
        }
    }
    state upload_4k(main: &mut Main) { save_offscreen_bmp(main, "snapshot_4k_upload.bmp\0"); }
    state upload_default(main: &mut Main) { save_offscreen_bmp(main, "snapshot_upload.bmp\0"); }
    state done_comparison() {}
}

machine capture_damage_comparison(main: &mut Main, index: i32) reaches WindowsGuiHost {
    transition main.compare_drag { true -> select_capture(main, index) _ -> done() }
    state select_capture(main: &mut Main, index: i32) {
    let pair: i32 = index / 2;
    transition main.client_w > 1440 {
        true -> capture_4k(main, pair)
        _ -> select_frame(main, pair)
    }
    }
    state select_frame(main: &mut Main, pair: i32) {
        transition (pair == 0 || pair == 8 || pair == 16 || pair == 24 || pair == 30) && pair >= 0 && pair < 32 {
            true -> path(main, pair)
            _ -> done()
        }
    }
    state capture_4k(main: &mut Main, pair: i32) {
        transition pair == 16 {
            true -> choose_4k(main)
            _ -> done()
        }
    }
    state choose_4k(main: &mut Main) {
        transition main.direct_bitmap {
            true -> direct_4k(main)
            _ -> upload_4k(main)
        }
    }
    state direct_4k(main: &mut Main) { save_offscreen_bmp(main, "damage_4k_direct.bmp\0"); }
    state upload_4k(main: &mut Main) { save_offscreen_bmp(main, "damage_4k_upload.bmp\0"); }
    state path(main: &mut Main, pair: i32) requires pair >= 0 && pair < 32 {
        let mut path: [u8; 21] = "damage_direct_00.bmp\0";
        transition main.direct_bitmap {
            true -> digits(main, pair, &mut path)
            _ -> upload(main, pair, &mut path)
        }
    }
    state upload(main: &mut Main, pair: i32, path: &mut [u8; 21]) requires pair >= 0 && pair < 32 {
        path = "damage_upload_00.bmp\0";
        transition { _ -> digits(main, pair, path) }
    }
    state digits(main: &mut Main, pair: i32, path: &mut [u8; 21]) requires pair >= 0 && pair < 32 {
        path[14] = (48 + pair / 10) as u8;
        path[15] = (48 + pair % 10) as u8;
        save_offscreen_bmp(main, path);
    }
    state done() {}
}

machine capture_checkbox_motion(main: &mut Main) reaches WindowsGuiHost {
    main.model.page = 1;
    main.model.palette_open = false;
    main.model.task_count = 3;
    main.model.task_done[0] = false;
    build_gallery_frame(main);
    transition { _ -> frame(main, 0) }
    state frame(main: &mut Main, index: i32) {
        transition index >= 0 && index < 10 {
            true -> animate(main, index)
            _ -> done()
        }
    }
    state animate(main: &mut Main, index: i32) requires index >= 0 && index < 10 {
        main.model.task_done[0] = index >= 5;
        let changed: bool = UiMotion::advance(&mut main.ctx.motion, select_i32(index == 0 || index == 5, 0, 65));
        build_gallery_frame(main);
        main.direct_bitmap = true;
        main.full_redraw_requested = false;
        render_and_blit_frame(main, 0);
        let mut path: [u8; 21] = "motion_direct_00.bmp\0";
        save_comparison_capture(main, index, &mut path);
        main.direct_bitmap = false;
        main.full_redraw_requested = true;
        render_and_blit_frame(main, 0);
        let mut reference: [u8; 21] = "motion_upload_00.bmp\0";
        save_comparison_capture(main, index, &mut reference);
        transition { _ -> frame(main, index + 1) }
    }
    state done() {}
}

machine save_comparison_capture(main: &mut Main, index: i32, path: &mut [u8; 21])
reaches WindowsGuiHost
requires index >= 0 && index < 100 {
    path[14] = (48 + index / 10) as u8;
    path[15] = (48 + index % 10) as u8;
    save_offscreen_bmp(main, path);
}

machine drawn_slider_value(context: &UiContext) -> i32 {
    transition { _ -> find(context, 0) }
    state find(context: &UiContext, index: i32) -> i32 {
        transition index >= 0 && index < context.node_count && index < 128 {
            true -> node(context, index)
            _ -> (-1)
        }
    }
    state node(context: &UiContext, index: i32) -> i32 requires index >= 0 && index < 128 {
        transition context.nodes[index].id == 22 {
            true -> (context.nodes[index].content_value as i32)
            _ -> find(context, index + 1)
        }
    }
}

machine verify_gallery_slider(main: &mut Main) -> bool reaches WindowsGuiHost {
    main.model.page = 0;
    let initial: i32 = main.model.volume;
    build_gallery_frame(main);
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 22);
    Tester::pointer_down_at(&mut main.ctx, add_i32(rectangle.x as i32, 86), add_i32(rectangle.y as i32, 44));
    build_gallery_frame(main);
    let start: bool = main.model.volume == 0 && drawn_slider_value(&main.ctx) == 0;
    main.ctx.mouse_x = add_i32(rectangle.x as i32, 356);
    main.ctx.mouse_pressed = false;
    build_gallery_frame(main);
    let end: bool = main.model.volume == 100 && drawn_slider_value(&main.ctx) == 100;
    Tester::pointer_up(&mut main.ctx);
    build_gallery_frame(main);
    let released: bool = main.model.drag_slider == 0 && drawn_slider_value(&main.ctx) == 100;
    main.model.volume = initial;
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    start && end && released
}

machine verify_damage(main: &mut Main) -> bool reaches WindowsGuiHost {
    let initial_volume: i32 = main.model.volume;
    let initial_dark: bool = main.model.dark_mode;
    main.model.page = 0;
    UiContext::setup(&mut main.ctx, 1024, 672, initial_dark);
    build_gallery_frame(main);
    let mut damage: GalleryDamage;
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 0, false, true);
    let full: bool = damage.logical_top == 0 && damage.logical_bottom == 672;
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 0, false, false);
    let idle: bool = damage.logical_top >= damage.logical_bottom;
    main.model.volume = select_i32(initial_volume < 100, add_i32(initial_volume, 1), 99);
    build_gallery_frame(main);
    let slider: Rect = UiContext::previous_rect(&main.ctx, 22);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 0, false, false);
    let partial: bool = damage.logical_top > 0 && damage.logical_top <= add_i32(slider.y as i32, 30)
        && damage.logical_bottom >= add_i32(slider.y as i32, 92) && damage.logical_bottom < add_i32(slider.y as i32, slider.h as i32)
        && damage.logical_left > (slider.x as i32) && damage.logical_right < ((slider.x + slider.w) as i32);
    let number: Rect = UiContext::previous_rect(&main.ctx, 24);
    main.ctx.mouse_x = add_i32(number.x as i32, 6);
    main.ctx.mouse_y = add_i32(number.y as i32, 18);
    build_gallery_frame(main);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 0, false, false);
    let hover: bool = damage.logical_top >= sub_i32(number.y as i32, 8)
        && damage.logical_top < damage.logical_bottom;
    main.model.dark_mode = !initial_dark;
    build_gallery_frame(main);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 0, false, false);
    let theme: bool = damage.logical_top == 0 && damage.logical_bottom == 672;
    GalleryDamage::prepare(&mut damage, &main.ctx, 1280, 840, 0, false, false);
    let resize: bool = damage.logical_top == 0 && damage.logical_bottom == 672;
    main.model.volume = initial_volume;
    main.model.dark_mode = initial_dark;
    UiContext::setup(&mut main.ctx, 1024, 672, initial_dark);
    let mut separated: GalleryDamage;
    separated.width = 1024;
    separated.height = 672;
    separated.logical_left = 1024;
    separated.logical_top = 672;
    GalleryDamage::include_box(&mut separated, 300, 20, 100, 20);
    GalleryDamage::include_box(&mut separated, 400, 400, 100, 20);
    let first_region: GalleryDirtyRectangle = GalleryDamage::region(&separated, 12);
    let gap: GalleryDirtyRectangle = GalleryDamage::region(&separated, 100);
    let second_region: GalleryDirtyRectangle = GalleryDamage::region(&separated, 400);
    let regions: bool = first_region.left == 292 && first_region.right == 408 && first_region.bottom == 48 && gap.left >= gap.right && gap.bottom == 392 && second_region.left == 392 && second_region.right == 508;
    separated.rectangle_count = 32;
    GalleryDamage::include_box(&mut separated, 700, 500, 20, 20);
    let collapsed: GalleryDirtyRectangle = GalleryDamage::region(&separated, 400);
    let overflow: bool = separated.rectangle_count == 1 && collapsed.left == 292 && collapsed.right == 728 && collapsed.bottom == 528;
    full && idle && partial && hover && theme && resize && regions && overflow
}

machine verify_dot_paint_geometry(context: &mut UiContext) -> bool {
    context.nodes[0].rect = Rect { x: 10, y: 20, w: 100, h: 40 };
    transition { _ -> sample(context, 0) }
    state sample(context: &mut UiContext, index: i32) -> bool {
        transition index >= 0 && index < 7 {
            true -> compare(context, index)
            _ -> (true)
        }
    }
    state compare(context: &mut UiContext, index: i32) -> bool requires index >= 0 && index < 7 {
        let values: [i32; 7] = [-50, 0, 400, 401, 700, 1000, 1400];
        context.nodes[0].content_kind = select_i32(index == 6, 13, 1);
        context.nodes[0].aux_value = values[index] as i32 in Saturating;
        let actual: Rect = UiContext::paint_rect(context, 0);
        let original: Rect = UiContext::pressed_rect(Rect { x: 10, y: 20, w: 100, h: 40 }, select_i32(index == 6, 0, values[index]));
        transition actual.x == original.x && actual.y == original.y && actual.w == original.w && actual.h == original.h {
            true -> sample(context, index + 1)
            _ -> (false)
        }
    }
}

// Moving within one chart column must not schedule another identical repaint.
machine verify_dot_hover_damage(main: &mut Main) -> bool reaches WindowsGuiHost {
    main.model.page = 2;
    build_gallery_frame(main);
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 42);
    let mut damage: GalleryDamage;
    main.ctx.mouse_x = add_i32(rectangle.x as i32, 20);
    main.ctx.mouse_y = add_i32(rectangle.y as i32, 82);
    build_gallery_frame(main);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 2, false, true);
    main.ctx.mouse_x = add_i32(rectangle.x as i32, 23);
    build_gallery_frame(main);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 2, false, false);
    let same_column: bool = damage.logical_top >= damage.logical_bottom;
    main.ctx.mouse_x = add_i32(rectangle.x as i32, 28);
    build_gallery_frame(main);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 2, false, false);
    let next_column: bool = damage.logical_top < damage.logical_bottom;
    main.ctx.mouse_y = add_i32(rectangle.y as i32, 83);
    build_gallery_frame(main);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 2, false, false);
    let same_column_y: bool = damage.logical_top >= damage.logical_bottom;
    main.ctx.mouse_x = add_i32(rectangle.x as i32, 10);
    build_gallery_frame(main);
    GalleryDamage::prepare(&mut damage, &main.ctx, 1440, 945, 2, false, false);
    let leave: bool = damage.logical_top < damage.logical_bottom;
    main.ctx.mouse_x = -1;
    main.ctx.mouse_y = -1;
    main.model.page = 0;
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    same_column && next_column && same_column_y && leave
}

machine verify_flat_row_plan(main: &mut Main) -> bool {
    main.dock_paint.varying_rows[0] = 1073745920u64;
    let before: i32 = WindowsBoxPainter::flat_end(&main.dock_paint, 4, 20);
    let between: i32 = WindowsBoxPainter::flat_end(&main.dock_paint, 13, 20);
    let edge: i32 = WindowsBoxPainter::flat_end(&main.dock_paint, 30, 32);
    let empty: i32 = WindowsBoxPainter::flat_end(&main.dock_paint, 20, 20);
    main.dock_paint.varying_rows[0] = 0;
    before == 12 && between == 20 && edge == 30 && empty == 20
}

machine run_headless_snapshots(main: &mut Main)
reaches Console + WindowsGuiHost {
    let screen_dc: u64 = WindowsGuiHost::get_dc(0);
    main.client_w = 1440;
    main.client_h = 945;
    init_gdi_resources(main, screen_dc, 1440, 945);
    let released: i32 = WindowsGuiHost::release_dc(0, screen_dc);
    let pointer: bool = verify_gallery_pointer(main);
    let navigation: bool = verify_gallery_navigation(main);
    let number_field: bool = verify_gallery_number_field(main);
    let redraw: bool = verify_gallery_redraw(main);
    let tasks: bool = verify_task_layout(main);
    let slider: bool = verify_gallery_slider(main);
    let damage: bool = verify_damage(main);
    let clock: bool = verify_animation_clock();
    let search: bool = verify_search_editor(main);
    let input_batch: bool = verify_search_message_batch(main);
    let tabs: bool = verify_tabs_and_modal(main);
    let hover_border: bool = verify_hover_border(main);
    let dot_hover: bool = verify_dot_hover_damage(main);
    let paint_geometry: bool = verify_dot_paint_geometry(&mut main.ctx);
    let capture: bool = verify_capture_cancel(main);
    let flat_rows: bool = verify_flat_row_plan(main);
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    report_search_check(main.layout_error == 0, "FAIL: library frame contract in gallery");
    transition pointer && navigation && number_field && redraw && tasks && slider && damage && clock && dot_hover && paint_geometry && search && input_batch && tabs && hover_border && capture && flat_rows && main.layout_error == 0 {
        true -> render_snapshots(main)
        _ -> fail_input()
    }
    state fail_input() {
        Console::write_line("FAIL: Omega UI gallery input, redraw invalidation, or same-column dot hover verification");
        Console::exit_process(1);
    }
    state render_snapshots(main: &mut Main) {
        write_headless_snapshots(main);
    }
}

machine resize_capture_bitmap(main: &mut Main, width: i32, height: i32) -> bool
reaches WindowsGuiHost
requires width > 0 && width <= 3840 && height > 0 && height <= 2160 {
    let mut info: [i32; 11];
    info[0] = 40;
    info[1] = width;
    info[2] = sub_i32(0, height);
    info[3] = 2097153;
    let mut pixels: u64;
    let bitmap: u64 = WindowsGuiHost::create_dib_section(main.hdc_mem, &info[0], 0, &mut pixels, 0, 0);
    transition bitmap > 0 && pixels > 0 {
        true -> replace(main, width, height, info, bitmap, pixels)
        _ -> (false)
    }
    state replace(main: &mut Main, width: i32, height: i32, info: [i32; 11], bitmap: u64, pixels: u64) -> bool
    requires width > 0 && width <= 3840 && height > 0 && height <= 2160 {
        let flushed: i32 = WindowsGuiHost::flush_gdi();
        let previous: u64 = WindowsGuiHost::select_object(main.hdc_mem, bitmap);
        transition previous > 0 {
            true -> installed(main, width, height, info, bitmap, pixels, previous)
            _ -> failed(bitmap)
        }
    }
    state installed(main: &mut Main, width: i32, height: i32, info: [i32; 11], bitmap: u64, pixels: u64, previous: u64) -> bool
    requires width > 0 && width <= 3840 && height > 0 && height <= 2160 {
        let deleted: i32 = WindowsGuiHost::delete_object(previous);
        main.hbm_mem = bitmap;
        main.bitmap_pixels = pixels;
        main.bitmap_stride = width;
        main.bitmap_height = height;
        main.client_w = width as i32 in Saturating;
        main.client_h = height as i32 in Saturating;
        main.ctx.aspect_pct = clamp_i32(add_i32(mul_i32(height, 1524), width / 2) / width, 600, 1400);
        main.info = info;
        main.damage.ready = false;
        main.direct_bitmap = true;
        main.full_redraw_requested = true;
        deleted != 0
    }
    state failed(bitmap: u64) -> bool {
        let deleted: i32 = WindowsGuiHost::delete_object(bitmap);
        false
    }
}

machine write_headless_snapshots(main: &mut Main)
reaches Console + WindowsGuiHost {
    let screen_dc: u64 = WindowsGuiHost::get_dc(0);
    main.client_w = 1440;
    main.client_h = 945;
    let fills: bool = WindowsFillCache::verify(&mut main.corner_cache.fills, &mut main.pixels);
    transition main.fonts_ready && main.model.search.field.window > 0 && fills {
        true -> ready(main, screen_dc)
        _ -> missing_fonts()
    }
    state missing_fonts() {
        Console::write_line("FAIL: gallery bitmap, Inter fonts, or native fill verification");
        Console::exit_process(1);
    }
    state ready(main: &mut Main, screen_dc: u64) {
    Console::write_line("BENCHMARK 1440 945");
    measure_slider_frames(main, true);
    measure_panel_drags(main, true);
    run_headless_p01(main);
    run_headless_p23(main);
    run_headless_p4_pal(main);
    capture_checkbox_motion(main);
    capture_tab_motion(main);
    capture_hover_surface(main);
    capture_slider_motion(main);
    Console::write_line("DOT_BENCHMARK 1440 945");
    measure_dot_frames(main);
    Console::write_line("SEARCH_BENCHMARK 1440 945");
    measure_search_frames(main);
    Console::write_line("STREAM_BENCHMARK 1440 945");
    measure_slider_frames(main, false);
    measure_panel_drags(main, false);
    capture_dock_bitmap_fallback(main);
    let resized: bool = resize_capture_bitmap(main, 3840, 2160);
    transition resized {
        true -> measure_4k(main, screen_dc)
        _ -> fail_4k()
    }
    }
    state fail_4k() {
        Console::write_line("FAIL: 4K offscreen bitmap allocation");
        Console::exit_process(1);
    }
    state measure_4k(main: &mut Main, screen_dc: u64) {
    Console::write_line("BENCHMARK 3840 2160");
    measure_slider_frames(main, true);
    measure_panel_drags(main, true);
    Console::write_line("DOT_BENCHMARK 3840 2160");
    measure_dot_frames(main);
    Console::write_line("SEARCH_BENCHMARK 3840 2160");
    measure_search_frames(main);
    Console::write_line("STREAM_BENCHMARK 3840 2160");
    measure_slider_frames(main, false);
    measure_panel_drags(main, false);
    capture_dock_bitmap_fallback(main);
    let rel: i32 = WindowsGuiHost::release_dc(0, screen_dc);
    Console::write_line("PASS: Omega UI gallery input, same-frame sliders, damage invalidation, dot hover, eleven page snapshots and pixel comparison frames");
    WindowsCornerCache::close(&mut main.corner_cache);
    Console::exit_process(0);
    }
}

// Refuse a destination layout, then compare the complete fallback frame.
machine capture_dock_bitmap_fallback(main: &mut Main) reaches Console + WindowsGuiHost {
    main.model.page = 4;
    main.model.palette_open = false;
    main.model.dock = DockTree::workspace_preset();
    main.ctx.mouse_x = -1;
    main.ctx.mouse_y = -1;
    main.ctx.mouse_down = false;
    main.ctx.mouse_pressed = false;
    main.ctx.mouse_released = false;
    main.ctx.motion.reduced = true;
    build_gallery_frame(main);
    main.ctx.motion.reduced = false;
    main.full_redraw_requested = true;
    main.direct_bitmap = true;
    render_and_blit_frame(main, 0);
    let mut healthy: [u8; 20] = "fallback_d_good.bmp\0";
    healthy[9] = select_i32(main.client_w > 2000, 52, 100) as u8;
    save_offscreen_bmp(main, &healthy);
    let stride: i32 = main.bitmap_stride;
    main.bitmap_stride = 0;
    main.dock_damage.ready = false;
    main.full_redraw_requested = false;
    render_and_blit_frame(main, 0);
    let fell_back: bool = !main.direct_bitmap;
    main.bitmap_stride = stride;
    main.direct_bitmap = true;
    let mut declined: [u8; 20] = "fallback_d_test.bmp\0";
    declined[9] = select_i32(main.client_w > 2000, 52, 100) as u8;
    save_offscreen_bmp(main, &declined);
    transition fell_back { true -> done() _ -> failed() }
    state failed() {
        Console::write_line("FAIL: rejected dock bitmap layout must enter the scanline fallback");
        Console::exit_process(1);
    }
    state done() {}
}

machine Main::main(main: &mut Main) reaches Console + WindowsGuiHost {
    let dpi_ok: i32 = WindowsGuiHost::set_dpi_aware();
    main.cls = "#32770\0";
    main.title = "Omega UI\0";

    main.info[0] = 40;
    main.info[1] = 1024;
    main.info[2] = 0 - 4;
    main.info[3] = 2097153;

    main.model = GalleryState {
        page: 0,
        range_mode: 0,
        paused: false,
        clicks: 42,
        notifications: true,
        sync_enabled: true,
        live_anim: true,
        dark_mode: true,
        hi_contrast: false,
        turbo_step: false,
        volume: 65,
        speed: 4,
        accent_index: 0,
        task_count: 3,
        task_done: [true, true, false, false, false],
        tick: 0,
        drag_slider: 0,
        t0_anim: 1000,
        t1_anim: 1000,
        t2_anim: 1000,
        t3_anim: 1000,
        t4_anim: 1000,
        text_buf: "Omega           ",
        text_len: 5,
        text_focused: true,
        list_scroll: 0,
        list_filter: 0,
        drag_list_sb: false,
        flow_step: 2,
        palette_open: false,
        palette_pick: 0,
        palette_scope: 0,
        palette_highlight: 0,
        search: GallerySearch::new(WindowsGuiHost::edit_create()),
        dock: DockTree::workspace_preset()
    };
    main.client_w = 1024;
    main.client_h = 672;
    main.prev_lbutton = false;
    main.lbutton_msg_down = false;
    UiContext::setup(&mut main.ctx, 1024, 672, true);

    main.close_requested = false;
    main.redraw_requested = true;
    main.full_redraw_requested = true;
    main.reference_dots = false;
    main.previous_frame_milliseconds = gallery_milliseconds();
    let headless: bool = WindowsGuiHost::is_headless();
    transition headless {
        true -> do_headless(main)
        _ -> open_gui(main)
    }

    state do_headless(main: &mut Main) {
        run_headless_snapshots(main);
    }

    state open_gui(main: &mut Main) {
        main.client_w = 1440;
        main.client_h = 945;
        let hwnd: u64 = gallery_window_create(main.cls, main.title, 282001408, 60, 40, 1440, 945);
        transition hwnd > 0 {
            true -> acquire_dc(main, hwnd)
            _ -> fail(main)
        }
    }

    state acquire_dc(main: &mut Main, hwnd: u64) {
        let hdc: u64 = WindowsGuiHost::get_dc(hwnd);
        transition hdc > 0 {
            true -> setup_gdi(main, hwnd, hdc)
            _ -> fail_destroy(main, hwnd)
        }
    }

    state setup_gdi(main: &mut Main, hwnd: u64, hdc: u64) {
        init_gdi_resources(main, hdc, 3840, 2160);
        main.ctx.motion.reduced = WindowsGuiHost::reduced_motion();
        transition main.fonts_ready && main.model.search.field.window > 0 {
            true -> pump_init(main, hwnd, hdc)
            _ -> fail_destroy(main, hwnd)
        }
    }

    state pump_init(main: &mut Main, hwnd: u64, hdc: u64) {
        main.pumped = 0;
        transition { _ -> pump_loop(main, hwnd, hdc) }
    }

    state pump_loop(main: &mut Main, hwnd: u64, hdc: u64) {
        let present: bool = WindowsGuiHost::pump_message(&mut main.message);
        transition present {
            true -> process_msg(main, hwnd, hdc)
            _ -> check_liveness(main, hwnd, hdc)
        }
    }

    state process_msg(main: &mut Main, hwnd: u64, hdc: u64) {
        handle_win32_message(main);
        let kind: u64 = WindowsMessage::kind(&main.message);
        let urgent: bool = input_message_ends_batch(kind, main.model.palette_open);
        transition !urgent && main.pumped < 16 {
            true -> pump_next(main, hwnd, hdc)
            _ -> check_liveness(main, hwnd, hdc)
        }
    }

    state pump_next(main: &mut Main, hwnd: u64, hdc: u64) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main, hwnd, hdc) }
    }

    state check_liveness(main: &mut Main, hwnd: u64, hdc: u64) {
        let alive: bool = WindowsGuiHost::is_window(hwnd);
        transition alive && !main.close_requested {
            true -> run_ui_frame(main, hwnd, hdc)
            _ -> shutdown(main, hwnd, hdc)
        }
    }

    state run_ui_frame(main: &mut Main, hwnd: u64, hdc: u64) {
        poll_live_mouse(main, hwnd);
        handle_search_pointer(main);
        let now: u64 = gallery_milliseconds();
        transition now >= main.previous_frame_milliseconds {
            true -> animate_frame(main, hwnd, hdc, now)
            _ -> build_frame(main, hwnd, hdc, false)
        }
    }
    state animate_frame(main: &mut Main, hwnd: u64, hdc: u64, now: u64)
    requires now >= main.previous_frame_milliseconds {
        let elapsed: u64 = now - main.previous_frame_milliseconds;
        main.previous_frame_milliseconds = now;
        transition elapsed <= 1000 {
            true -> advance_frame(main, hwnd, hdc, elapsed as i32)
            _ -> advance_frame(main, hwnd, hdc, 1000)
        }
    }
    state advance_frame(main: &mut Main, hwnd: u64, hdc: u64, elapsed_ms: i32) {
        let animated: bool = advance_gallery_animation(&mut main.ctx, &mut main.model, elapsed_ms);
        transition { _ -> build_frame(main, hwnd, hdc, animated) }
    }
    state build_frame(main: &mut Main, hwnd: u64, hdc: u64, animated: bool) {
        build_gallery_frame(main);
        main.redraw_requested = main.redraw_requested || animated || main.ctx.changed || main.ctx.motion.animating;
        transition main.redraw_requested {
            true -> redraw_dirty(main, hwnd, hdc)
            _ -> idle_frame(main, hwnd, hdc)
        }
    }

    state redraw_dirty(main: &mut Main, hwnd: u64, hdc: u64) {
        render_and_blit_frame(main, hdc);
        main.redraw_requested = false;
        transition { _ -> pump_init(main, hwnd, hdc) }
    }

    state idle_frame(main: &mut Main, hwnd: u64, hdc: u64) {
        let awake: u32 = WindowsGuiHost::wait_for_input(16);
        transition { _ -> pump_init(main, hwnd, hdc) }
    }

    state shutdown(main: &mut Main, hwnd: u64, hdc: u64) {
        WindowsCornerCache::close(&mut main.corner_cache);
        let editor_closed: bool = WindowsGuiHost::window_destroy(main.model.search.field.window);
        let released: i32 = WindowsGuiHost::release_dc(hwnd, hdc);
        let destroyed: bool = WindowsGuiHost::window_destroy(hwnd);
        Console::write_line("Omega UI closed cleanly (exit 0)");
        Console::exit_process(0);
    }

    state fail_destroy(main: &mut Main, hwnd: u64) {
        let destroyed: bool = WindowsGuiHost::window_destroy(hwnd);
        transition { _ -> fail(main) }
    }

    state fail(main: &mut Main) {
        Console::write_line("FAIL: could not create Omega UI window (exit 1)");
        Console::exit_process(1);
    }
}

machine distance_i32(first: i32, second: i32) -> i32 {
    select_i32(first >= second, sub_i32(first, second), sub_i32(second, first))
}

machine verify_search_editor(main: &mut Main) -> bool reaches Console + WindowsGuiHost {
    GallerySearch::clear(&mut main.model.search);
    GallerySearch::character(&mut main.model.search, 84);
    GallerySearch::character(&mut main.model.search, 97);
    GallerySearch::character(&mut main.model.search, 115);
    GallerySearch::character(&mut main.model.search, 107);
    let filtered: bool = main.model.search.count == 1 && main.model.search.results[0] == 1 && main.model.search.field.length == 4;
    GallerySearch::key(&mut main.model.search, 65, true, false);
    let selected: bool = main.model.search.field.selection_start == 0 && main.model.search.field.selection_end == 4;
    GallerySearch::character(&mut main.model.search, 83);
    let replaced: bool = main.model.search.field.length == 1 && main.model.search.field.text[0] == 83;
    GallerySearch::key(&mut main.model.search, 90, true, false);
    let undo: bool = main.model.search.field.length == 4 && main.model.search.field.text[0] == 84;
    GallerySearch::key(&mut main.model.search, 89, true, false);
    let redo: bool = main.model.search.field.length == 1 && main.model.search.field.text[0] == 83;
    GallerySearch::clear(&mut main.model.search);
    GallerySearch::character(&mut main.model.search, 9731);
    let unicode: bool = main.model.search.field.length == 1 && main.model.search.field.text[0] == 9731 && main.model.search.count == 0;
    GallerySearch::key(&mut main.model.search, 8, false, false);
    let backspace: bool = main.model.search.field.length == 0 && main.model.search.count == 6;
    GallerySearch::character(&mut main.model.search, 65);
    GallerySearch::character(&mut main.model.search, 66);
    GallerySearch::key(&mut main.model.search, 36, false, false);
    GallerySearch::character(&mut main.model.search, 67);
    let home: bool = main.model.search.field.length == 3 && main.model.search.field.text[0] == 67;
    GallerySearch::key(&mut main.model.search, 46, false, false);
    let delete: bool = main.model.search.field.length == 2 && main.model.search.field.text[1] == 66;
    GallerySearch::clear(&mut main.model.search);
    report_search_check(main.model.search.field.window > 0, "FAIL: search native edit creation");
    report_search_check(filtered, "FAIL: search filtered");
    report_search_check(selected, "FAIL: search selected");
    report_search_check(replaced, "FAIL: search replaced");
    report_search_check(undo, "FAIL: search undo");
    report_search_check(redo, "FAIL: search redo");
    report_search_check(unicode, "FAIL: search unicode");
    report_search_check(backspace, "FAIL: search backspace");
    report_search_check(home, "FAIL: search home");
    report_search_check(delete, "FAIL: search delete");
    transition filtered && selected && replaced && undo && redo && unicode && backspace && home && delete {
        true -> passed()
        _ -> failed()
    }
    state passed() -> bool {
        Console::write_line("PASS: native search selection, replacement, undo/redo, Unicode, filtering, Home and Delete");
        true
    }
    state failed() -> bool {
        Console::write_line("FAIL: native search editing");
        false
    }
}

machine verify_tabs_and_modal(main: &mut Main) -> bool reaches WindowsGuiHost {
    main.model.page = 0;
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    build_gallery_frame(main);
    main.model.page = 4;
    build_gallery_frame(main);
    let initial: i32 = UiMotion::read(&main.ctx.motion, 91500, -1);
    let changed: bool = UiMotion::advance(&mut main.ctx.motion, 32);
    build_gallery_frame(main);
    let moving: i32 = UiMotion::read(&main.ctx.motion, 91500, -1);
    main.model.page = 1;
    build_gallery_frame(main);
    let interrupted: i32 = UiMotion::read(&main.ctx.motion, 91500, -1);
    main.ctx.motion.reduced = true;
    build_gallery_frame(main);
    let reduced: i32 = UiMotion::read(&main.ctx.motion, 91500, -1);
    main.ctx.focus = 15;
    main.model.text_focused = false;
    handle_key_message(main, 35);
    let keyboard_end: bool = main.model.page == 4;
    handle_key_message(main, 39);
    let keyboard_wrap: bool = main.model.page == 0;
    main.model.page = 2;
    main.model.paused = false;
    main.model.palette_open = true;
    let tick: i32 in Saturating = main.model.tick;
    let frozen: bool = advance_gallery_animation(&mut main.ctx, &mut main.model, 16);
    let hidden: bool = main.model.tick == tick;
    main.model.palette_open = false;
    main.model.page = 0;
    main.ctx.motion.reduced = false;
    initial == 0 && changed && moving > 0 && moving < 1000 && interrupted == moving && reduced == 250 && hidden && keyboard_end && keyboard_wrap
}

machine capture_tab_motion(main: &mut Main) reaches WindowsGuiHost {
    main.model.page = 0;
    main.model.palette_open = false;
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    build_gallery_frame(main);
    main.full_redraw_requested = true;
    render_and_blit_frame(main, 0);
    save_offscreen_bmp(main, "tab_start.bmp\0");
    main.model.page = 3;
    build_gallery_frame(main);
    transition { _ -> frame(main, 0) }
    state frame(main: &mut Main, index: i32) {
        transition index >= 0 && index < 27 { true -> capture(main, index) _ -> done(main) }
    }
    state capture(main: &mut Main, index: i32) requires index >= 0 && index < 27 {
        let advanced: bool = UiMotion::advance(&mut main.ctx.motion, 16);
        build_gallery_frame(main);
        render_and_blit_frame(main, 0);
        let mut path: [u8; 17] = "tab_frame_00.bmp\0";
        path[10] = (48 + index / 10) as u8;
        path[11] = (48 + index % 10) as u8;
        save_offscreen_bmp(main, &path);
        transition index == 3 { true -> moving(main, index) _ -> frame(main, index + 1) }
    }
    state moving(main: &mut Main, index: i32) {
        save_offscreen_bmp(main, "tab_moving.bmp\0");
        transition { _ -> frame(main, add_i32(index, 1)) }
    }
    state done(main: &mut Main) { save_offscreen_bmp(main, "tab_settled.bmp\0"); }
}

machine verify_hover_border(main: &mut Main) -> bool reaches WindowsGuiHost {
    main.model.page = 2;
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    build_gallery_frame(main);
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 41);
    main.ctx.mouse_x = add_i32(rectangle.x as i32, 20);
    main.ctx.mouse_y = add_i32(rectangle.y as i32, 20);
    build_gallery_frame(main);
    transition { _ -> node(main, 0) }
    state node(main: &mut Main, index: i32) -> bool {
        transition index >= 0 && index < main.ctx.node_count && index < 128 { true -> compare(main, index) _ -> (false) }
    }
    state compare(main: &mut Main, index: i32) -> bool requires index >= 0 && index < 128 {
        transition main.ctx.nodes[index].id == 41 {
            true -> (main.ctx.nodes[index].style.border == main.ctx.theme.border)
            _ -> node(main, index + 1)
        }
    }
}

machine capture_hover_surface(main: &mut Main) reaches WindowsGuiHost {
    main.model.page = 2;
    main.model.dark_mode = false;
    UiContext::setup(&mut main.ctx, 1024, 672, false);
    build_gallery_frame(main);
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 41);
    main.ctx.mouse_x = add_i32(rectangle.x as i32, 20);
    main.ctx.mouse_y = add_i32(rectangle.y as i32, 20);
    build_gallery_frame(main);
    main.full_redraw_requested = true;
    render_and_blit_frame(main, 0);
    save_offscreen_bmp(main, "snapshot_hover_light.bmp\0");
    main.model.dark_mode = true;
    main.ctx.mouse_x = -1;
    main.ctx.mouse_y = -1;
}

machine report_search_check(ok: bool, label: &[u8]) reaches Console {
    transition ok { true -> done() _ -> failed(label) }
    state failed(label: &[u8]) { Console::write_line(label); }
    state done() {}
}

machine measure_search_frames(main: &mut Main) reaches Console + WindowsGuiHost {
    main.model.page = 2;
    main.model.palette_open = true;
    main.model.palette_pick = 0;
    main.ctx.mouse_x = -1;
    main.ctx.mouse_y = -1;
    GallerySearch::clear(&mut main.model.search);
    UiContext::setup(&mut main.ctx, 1024, 672, main.model.dark_mode);
    build_gallery_frame(main);
    main.full_redraw_requested = true;
    render_and_blit_frame(main, 0);
    transition { _ -> frame(main, 0) }
    state frame(main: &mut Main, index: i32) {
        transition index >= 0 && index < 8 { true -> edit(main, index) _ -> done(main) }
    }
    state edit(main: &mut Main, index: i32) requires index >= 0 && index < 8 {
        let start: u64 = gallery_counter();
        GallerySearch::key(&mut main.model.search, 65, true, false);
        GallerySearch::character(&mut main.model.search, select_u64(index % 2 == 0, 84, 80));
        transition index == 2 {
            true -> selected(main, index, start)
            _ -> paint(main, index, start)
        }
    }
    state selected(main: &mut Main, index: i32, start: u64) requires index >= 0 && index < 8 {
        GallerySearch::key(&mut main.model.search, 65, true, false);
        transition { _ -> paint(main, index, start) }
    }
    state paint(main: &mut Main, index: i32, start: u64) requires index >= 0 && index < 8 {
        build_gallery_frame(main);
        render_and_blit_frame(main, 0);
        let flushed: i32 = WindowsGuiHost::flush_gdi();
        let end: u64 = gallery_counter();
        let frequency: u64 = gallery_counter_frequency();
        transition end >= start && frequency > 0 {
            true -> report(main, index, end - start, frequency)
            _ -> done(main)
        }
    }
    state report(main: &mut Main, index: i32, elapsed: u64, frequency: u64) requires frequency > 0 && index >= 0 && index < 8 {
        Console::write("SEARCH_FRAME_US ");
        write_measurement(index as u64);
        Console::write(" ");
        write_measurement((((elapsed as u64 in Saturating) * (1000000 as u64 in Saturating)) / (frequency as u64 in Saturating)) as u64);
        Console::write_line("");
        transition index == 1 || index == 2 { true -> capture(main, index) _ -> frame(main, add_i32(index, 1)) }
    }
    state capture(main: &mut Main, index: i32) {
        let mut path: [u8; 20] = "search_d_fast_0.bmp\0";
        save_search_comparison(main, index, &mut path);
        main.full_redraw_requested = true;
        render_and_blit_frame(main, 0);
        let mut reference: [u8; 20] = "search_d_slow_0.bmp\0";
        save_search_comparison(main, index, &mut reference);
        transition { _ -> frame(main, add_i32(index, 1)) }
    }
    state done(main: &mut Main) {
        main.model.palette_open = false;
        main.model.page = 0;
        GallerySearch::clear(&mut main.model.search);
    }
}
machine save_search_comparison(main: &mut Main, index: i32, path: &mut [u8; 20]) reaches WindowsGuiHost {
    transition index >= 0 && index < 10 { true -> save(main, index, path) _ -> done() }
    state save(main: &mut Main, index: i32, path: &mut [u8; 20]) requires index >= 0 && index < 10 {
        path[7] = select_i32(main.client_w > 2000, 52, 100) as u8;
        path[14] = (48 + index) as u8;
        save_offscreen_bmp(main, path);
    }
    state done() {}
}

// TranslateMessage queues WM_CHAR behind the keydown. Let the editor consume
// both before drawing; navigation still draws as soon as the queue is empty.
machine input_message_ends_batch(kind: u64, palette_open: bool) -> bool {
    kind == 513 || kind == 514 || kind == 258 || (kind == 256 && !palette_open)
}

machine verify_search_message_batch(main: &mut Main) -> bool reaches Console + WindowsGuiHost {
    main.model.palette_open = true;
    main.ignore_palette_character = false;
    GallerySearch::clear(&mut main.model.search);
    main.message.words[1] = 256;
    main.message.words[2] = 65;
    main.message.words[3] = 0;
    handle_win32_message(main);
    let premature: bool = input_message_ends_batch(WindowsMessage::kind(&main.message), main.model.palette_open);
    let pending: bool = main.model.search.field.length == 0;
    main.message.words[1] = 258;
    main.message.words[2] = 97;
    handle_win32_message(main);
    let completed: bool = input_message_ends_batch(WindowsMessage::kind(&main.message), main.model.palette_open);
    let inserted: bool = main.model.search.field.length == 1 && main.model.search.field.text[0] == 97 && main.redraw_requested;
    GallerySearch::clear(&mut main.model.search);
    main.model.palette_open = false;
    let passed: bool = !premature && pending && completed && inserted;
    report_search_check(passed, "FAIL: search keydown/character must reach the first frame together");
    passed
}

// Exercise the real hover target and damage path through growth and reversal.
machine capture_slider_motion(main: &mut Main) reaches Console + WindowsGuiHost {
    main.model.page = 0;
    main.model.dark_mode = false;
    main.model.volume = 67;
    main.model.speed = 1;
    main.ctx.mouse_x = -1;
    main.ctx.mouse_y = -1;
    main.ctx.motion.reduced = true;
    build_gallery_frame(main);
    main.ctx.motion.reduced = false;
    main.full_redraw_requested = true;
    transition { _ -> frame(main, 0) }
    state frame(main: &mut Main, index: i32) {
        transition index >= 0 && index < 30 {
            true -> paint(main, index)
            _ -> done(main)
        }
    }
    state paint(main: &mut Main, index: i32) requires index >= 0 && index < 30 {
        let rectangle: Rect = UiContext::previous_rect(&main.ctx, 22);
        main.ctx.mouse_x = select_i32(index < 14, add_i32(rectangle.x as i32, 260), -1);
        main.ctx.mouse_y = select_i32(index < 14, add_i32(rectangle.y as i32, 52), -1);
        let changed: bool = UiMotion::advance(&mut main.ctx.motion, 20);
        build_gallery_frame(main);
        render_and_blit_frame(main, 0);
        let mut path: [u8; 20] = "slider_frame_00.bmp\0";
        path[13] = (48 + index / 10) as u8;
        path[14] = (48 + index % 10) as u8;
        save_offscreen_bmp(main, &path);
        transition index == 6 || index == 20 {
            true -> reference(main, index)
            _ -> frame(main, index + 1)
        }
    }
    state reference(main: &mut Main, index: i32) requires index >= 0 && index < 30 {
        main.full_redraw_requested = true;
        render_and_blit_frame(main, 0);
        let mut path: [u8; 19] = "slider_full_00.bmp\0";
        path[12] = (48 + index / 10) as u8;
        path[13] = (48 + index % 10) as u8;
        save_offscreen_bmp(main, &path);
        transition { _ -> frame(main, index + 1) }
    }
    state done(main: &mut Main) {
        main.ctx.mouse_x = -1;
        main.ctx.mouse_y = -1;
    }
}

// Alternating partial/full frames share input and motion time. Includes releasing
// the drag so a cached preview cannot survive the final state transition.
machine measure_panel_drags(main: &mut Main, compare: bool) reaches Console + WindowsGuiHost {
    main.compare_drag = compare;
    transition { _ -> scenario(main, 0) }
    state scenario(main: &mut Main, kind: i32) {
        transition kind >= 0 && kind < 3 { true -> setup(main, kind) _ -> done(main) }
    }
    state setup(main: &mut Main, kind: i32) requires kind >= 0 && kind < 3 {
        main.reference_dock = false;
        main.model.page = 4;
        main.model.dock = DockTree::workspace_preset();
        main.model.palette_open = false;
        main.ctx.mouse_x = -1;
        main.ctx.mouse_y = -1;
        main.ctx.mouse_down = false;
        main.ctx.mouse_pressed = false;
        main.ctx.mouse_released = false;
        main.ctx.motion.reduced = true;
        build_gallery_frame(main);
        main.ctx.motion.reduced = false;
        main.full_redraw_requested = true;
        render_and_blit_frame(main, 0);
        transition kind == 0 {
            true -> root(main, kind)
            _ -> horizontal_or_window(main, kind)
        }
    }
    state root(main: &mut Main, kind: i32) requires kind >= 0 && kind < 3 {
        let rectangle: Rect = DockTree::div1_rect(&main.model.dock, 0);
        transition { _ -> frame(main, kind, 0, add_i32(rectangle.x as i32, 2), add_i32(rectangle.y as i32, 100)) }
    }
    state horizontal_or_window(main: &mut Main, kind: i32) requires kind >= 0 && kind < 3 {
        transition kind == 1 {
            true -> horizontal(main, kind)
            _ -> window(main, kind)
        }
    }
    state horizontal(main: &mut Main, kind: i32) requires kind >= 0 && kind < 3 {
        let rectangle: Rect = DockTree::div1_rect(&main.model.dock, 1);
        transition { _ -> frame(main, kind, 0, add_i32(rectangle.x as i32, 40), add_i32(rectangle.y as i32, 2)) }
    }
    state window(main: &mut Main, kind: i32) requires kind >= 0 && kind < 3 {
        let rectangle: Rect = DockTree::window_rect(&main.model.dock, 4);
        transition { _ -> frame(main, kind, 0, add_i32(rectangle.x as i32, 40), add_i32(rectangle.y as i32, 12)) }
    }
    state frame(main: &mut Main, kind: i32, index: i32, start_x: i32, start_y: i32) requires kind >= 0 && kind < 3 {
        transition index >= 0 && index < 26 {
            true -> measure(main, kind, index, start_x, start_y)
            _ -> report_cache(main, kind)
        }
    }
    state report_cache(main: &mut Main, kind: i32) requires kind >= 0 && kind < 3 {
        Console::write("PANEL_"); write_stream_marker(main.compare_drag); Console::write("CACHE "); write_measurement(kind as u64);
        Console::write(" "); write_measurement(main.corner_cache.reads as u64);
        Console::write(" "); write_measurement(main.corner_cache.misses as u64);
        Console::write(" "); Console::write_byte(select_i32(main.corner_cache.ready, 49, 48));
        Console::write(" "); Console::write_byte(select_i32(main.flat_dock_background, 49, 48));
        Console::write(" "); write_measurement(main.flat_rows as u64);
        Console::write(" "); write_measurement(main.reused_rows as u64);
        Console::write(" "); write_measurement(main.corner_cache.fills.reads as u64);
        Console::write(" "); Console::write_byte(select_i32(main.corner_cache.fills.ready, 49, 48));
        Console::write_line("");
        Console::write("TEXT_BATCH "); write_measurement(main.text_batches as u64);
        Console::write(" "); write_measurement(main.text_fallbacks as u64);
        Console::write_line("");
        transition { _ -> scenario(main, kind + 1) }
    }
    state measure(main: &mut Main, kind: i32, index: i32, start_x: i32, start_y: i32) requires index >= 0 && index < 26 && kind >= 0 && kind < 3 {
        let step: i32 = select_i32(main.compare_drag, min_i32(index / 2, 11), min_i32(index, 23));
        main.ctx.mouse_x = add_i32(start_x, select_i32(kind == 1, 0, mul_i32(step, select_i32(main.compare_drag, select_i32(kind == 2, 5, 4), 2))));
        main.ctx.mouse_y = add_i32(start_y, select_i32(kind == 0, 0, mul_i32(step, select_i32(main.compare_drag, select_i32(kind == 2, 30, 4), select_i32(kind == 2, 15, 2)))));
        main.ctx.mouse_down = index < 24;
        main.ctx.mouse_pressed = index == 0;
        main.ctx.mouse_released = index == 24;
        main.direct_bitmap = true;
        main.full_redraw_requested = main.compare_drag && index % 2 != 0;
        main.reference_dock = main.compare_drag && index % 2 != 0;
        let start: u64 = gallery_counter();
        build_panel_measurement(main, index);
        let built: u64 = gallery_counter();
        render_and_blit_frame(main, 0);
        let flushed: i32 = WindowsGuiHost::flush_gdi();
        let end: u64 = gallery_counter();
        let frequency: u64 = gallery_counter_frequency();
        transition built >= start && end >= built && frequency > 0 {
            true -> report(main, kind, index, start_x, start_y, built - start, end - built, frequency)
            _ -> done(main)
        }
    }
    state report(main: &mut Main, kind: i32, index: i32, start_x: i32, start_y: i32, layout: u64, render: u64, frequency: u64) requires frequency > 0 && index >= 0 && index < 26 && kind >= 0 && kind < 3 {
        Console::write("PANEL_"); write_stream_marker(main.compare_drag); Console::write("FRAME_US ");
        write_measurement(kind as u64);
        Console::write(" "); write_measurement(index as u64);
        Console::write(" "); write_measurement(((layout as u64 in Saturating) * (1000000 as u64 in Saturating) / (frequency as u64 in Saturating)) as u64);
        Console::write(" "); write_measurement(((render as u64 in Saturating) * (1000000 as u64 in Saturating) / (frequency as u64 in Saturating)) as u64);
        Console::write_line("");
        transition main.compare_drag && (index == 6 || index == 7 || index == 20 || index == 21 || index == 24 || index == 25) {
            true -> capture(main, kind, index, start_x, start_y)
            _ -> frame(main, kind, index + 1, start_x, start_y)
        }
    }
    state capture(main: &mut Main, kind: i32, index: i32, start_x: i32, start_y: i32) requires index >= 0 && index < 26 && kind >= 0 && kind < 3 {
        let mut path: [u8; 22] = "panel_d_0_fast_00.bmp\0";
        path[6] = select_i32(main.client_w > 2000, 52, 100) as u8;
        path[8] = (48 + kind) as u8;
        let paired: i32 = index - index % 2;
        path[15] = (48 + paired / 10) as u8;
        path[16] = (48 + paired % 10) as u8;
        transition index % 2 == 0 {
            true -> save(main, kind, index, start_x, start_y, path)
            _ -> reference(main, kind, index, start_x, start_y, path)
        }
    }
    state reference(main: &mut Main, kind: i32, index: i32, start_x: i32, start_y: i32, path: [u8; 22]) requires kind >= 0 && kind < 3 {
        let mut named: [u8; 22] = path;
        named[10] = 115; named[11] = 108; named[12] = 111; named[13] = 119;
        transition { _ -> save(main, kind, index, start_x, start_y, named) }
    }
    state save(main: &mut Main, kind: i32, index: i32, start_x: i32, start_y: i32, path: [u8; 22]) requires kind >= 0 && kind < 3 {
        save_offscreen_bmp(main, &path);
        transition { _ -> frame(main, kind, add_i32(index, 1), start_x, start_y) }
    }
    state done(main: &mut Main) {
        main.ctx.mouse_down = false;
        main.ctx.mouse_released = false;
        main.ctx.mouse_x = -1;
        main.ctx.mouse_y = -1;
        main.model.page = 0;
        main.reference_dock = false;
    }
}

machine build_panel_measurement(main: &mut Main, index: i32) reaches WindowsGuiHost {
    transition !main.compare_drag || index % 2 == 0 { true -> build(main) _ -> done() }
    state build(main: &mut Main) { build_gallery_frame(main); }
    state done() {}
}

machine update_drag_capture(main: &mut Main, kind: u64) reaches WindowsGuiHost {
    let window: u64 = main.message.words[0];
    transition kind == 513 && window > 0 { true -> capture(main, window) _ -> release_or_cancel(main, kind) }
    state capture(main: &mut Main, window: u64) { main.captured_mouse = WindowsGuiHost::capture_mouse(window); }
    state release_or_cancel(main: &mut Main, kind: u64) {
        transition kind == 514 && main.captured_mouse { true -> release(main) _ -> check_cancel(main, kind) }
    }
    state release(main: &mut Main) {
        main.captured_mouse = false;
        let released: bool = WindowsGuiHost::release_mouse();
    }
    state check_cancel(main: &mut Main, kind: u64) {
        transition kind == 533 && main.captured_mouse { true -> cancel(main) _ -> done() }
    }
    state cancel(main: &mut Main) {
        main.captured_mouse = false;
        main.model.drag_slider = 0;
        main.model.drag_list_sb = false;
        main.model.dock.drag_window_id = 0;
        main.model.dock.drag_divider_node = -1;
        main.model.dock.drop_target_window = 0;
        main.lbutton_msg_down = false;
        main.prev_lbutton = true;
        main.ctx.active = 0;
        main.ctx.mouse_pressed = false;
        main.ctx.mouse_released = false;
        main.redraw_requested = true;
    }
    state done() {}
}

machine verify_capture_cancel(main: &mut Main) -> bool reaches WindowsGuiHost {
    main.captured_mouse = true;
    main.model.drag_slider = 1;
    main.model.drag_list_sb = true;
    main.model.dock.drag_window_id = 4;
    main.model.dock.drag_divider_node = 0;
    main.ctx.active = 22;
    update_drag_capture(main, 533);
    let cancelled: bool = !main.captured_mouse && main.model.drag_slider == 0 && !main.model.drag_list_sb && main.model.dock.drag_window_id == 0 && main.model.dock.drag_divider_node == -1 && main.ctx.active == 0 && !main.ctx.mouse_pressed;
    main.prev_lbutton = false;
    cancelled
}

// Capture changes go to WindowProc; this polling host also checks ownership.
machine refresh_drag_capture(main: &mut Main, window: u64) reaches WindowsGuiHost {
    transition main.captured_mouse { true -> check(main, window) _ -> done() }
    state check(main: &mut Main, window: u64) {
        let owned: bool = WindowsGuiHost::mouse_captured(window);
        transition !owned { true -> lost(main) _ -> done() }
    }
    state lost(main: &mut Main) { update_drag_capture(main, 533); }
    state done() {}
}

machine write_stream_marker(compare: bool) reaches Console {
    transition !compare { true -> stream() _ -> done() }
    state stream() { Console::write("STREAM_"); }
    state done() {}
}
