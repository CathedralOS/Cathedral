    draw_ct_box(dc, main.font_reg, 496, 95, 62, 28, "Reset", main.ctx.theme.text_muted, 1);

    draw_ct_box_alpha(dc, main.font_reg, 592, 95, 58, 28, "Explorer", bg_w, fg_t, a0, 1);
    draw_ct_box_alpha(dc, main.font_reg, 678, 95, 58, 28, "Structs", bg_w, fg_t, a1, 1);
    draw_ct_box_alpha(dc, main.font_reg, 764, 95, 58, 28, "Scanner", bg_w, fg_t, a2, 1);
    draw_ct_box_alpha(dc, main.font_reg, 850, 95, 58, 28, "Memory", bg_w, fg_t, a3, 1);
    draw_ct_box_alpha(dc, main.font_reg, 934, 95, 58, 28, "Output", bg_w, fg_t, a4, 1);
}

machine draw_native_dock_left_panes(main: &Main)
reaches WindowsGuiHost {
    let dc: &Main = main;
    let r2: Rect = DockTree::node_rect(&main.model.dock, 2);
    transition r2.w > 70 && r2.h > 60 {
        true -> draw_r2(main, dc, r2.x as i32, r2.y as i32, r2.w as i32)
        _ -> check_r3(main, dc)
    }
    state draw_r2(main: &Main, dc: &Main, x: i32, y: i32, w: i32) {
        let act: i32 = main.model.dock.nodes[2].active_tab;
        let c_t0: i32 = select_i32(act == 0, main.ctx.theme.text, main.ctx.theme.text_muted);
        let c_t1: i32 = select_i32(act == 1, main.ctx.theme.text, main.ctx.theme.text_muted);
        draw_ct_box(dc, select_u64(act == 0, main.font_bold, main.font_reg), add_i32(x, 22), add_i32(y, 4), 68, 21, "Explorer", c_t0, 1);
        draw_ct_box(dc, select_u64(act == 1, main.font_bold, main.font_reg), add_i32(x, 94), add_i32(y, 4), 68, 21, "Settings", c_t1, 1);
        transition main.model.dock.struct_docked_as_tab {
            true -> draw_tab3(main, dc, x, y, w, act)
            _ -> draw_r2_body(main, dc, x, y, w)
        }
    }
    state draw_tab3(main: &Main, dc: &Main, x: i32, y: i32, w: i32, act: i32) {
        draw_ct_box(dc, select_u64(act == 2, main.font_bold, main.font_reg), add_i32(x, 166), add_i32(y, 4), 68, 21, "Structs", main.ctx.theme.purple, 1);
        transition { _ -> draw_r2_body(main, dc, x, y, w) }
    }
    state draw_r2_body(main: &Main, dc: &Main, x: i32, y: i32, w: i32) {
        let bw: i32 = max_i32(sub_i32(w, 34), 20);
        draw_ct_box(dc, main.font_bold, add_i32(x, 24), add_i32(y, 38), bw, 26, "src/dock.omg", main.ctx.theme.accent, 0);
        draw_ct_box(dc, main.font_reg, add_i32(x, 24), add_i32(y, 70), bw, 22, "src/context.omg", main.ctx.theme.text, 0);
        draw_ct_box(dc, main.font_reg, add_i32(x, 24), add_i32(y, 96), bw, 22, "src/widgets.omg", main.ctx.theme.text_muted, 0);
        draw_ct_box(dc, main.font_reg, add_i32(x, 24), add_i32(y, 122), bw, 22, "src/raster.omg", main.ctx.theme.text_muted, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 24), add_i32(y, 152), bw, 22, "[DockNode; 12] 0 allocs", main.ctx.theme.success, 0);
        transition { _ -> check_r3(main, dc) }
    }
    state check_r3(main: &Main, dc: &Main) {
        let r3: Rect = DockTree::window_rect(&main.model.dock, 3);
        let vis3: bool = !main.model.dock.struct_docked_as_tab && r3.w > 70 && r3.h > 70;
        transition vis3 {
            true -> draw_r3(main, dc, r3.x as i32, r3.y as i32, r3.w as i32)
            _ -> done()
        }
    }
    state draw_r3(main: &Main, dc: &Main, x: i32, y: i32, w: i32) {
        let hw: i32 = max_i32(sub_i32(w, 32), 20);
        let rx_val: i32 = add_i32(x, sub_i32(w, 60));
        draw_ct_box(dc, main.font_bold, add_i32(x, 24), add_i32(y, 1), hw, 27, "Struct Viewer", main.ctx.theme.text, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 38), 96, 26, "root.ratio_a", main.ctx.theme.text_muted, 0);
        draw_ct_num3_box(dc, main.font_mono, rx_val, add_i32(y, 38), 40, 26, main.model.dock.nodes[0].ratio_a, main.ctx.theme.accent, 2);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 70), 96, 26, "left.ratio_a", main.ctx.theme.text_muted, 0);
        draw_ct_num3_box(dc, main.font_mono, rx_val, add_i32(y, 70), 40, 26, main.model.dock.nodes[1].ratio_a, main.ctx.theme.purple, 2);
        draw_ct_box_alpha(dc, main.font_reg, add_i32(x, 14), add_i32(y, 104), hw, 22, "Drag any header or splitter", main.ctx.theme.surface, main.ctx.theme.text, 50, 0);
    }
    state done() {}
}

machine draw_native_dock_right_panes(main: &Main)
reaches WindowsGuiHost {
    let dc: &Main = main;
    let r4: Rect = DockTree::window_rect(&main.model.dock, 4);
    let r5: Rect = DockTree::window_rect(&main.model.dock, 5);
    let r6: Rect = DockTree::window_rect(&main.model.dock, 6);
    transition r4.w > 80 && r4.h > 80 {
        true -> draw_r4(main, dc, r4.x as i32, r4.y as i32, r4.w as i32, r5, r6)
        _ -> check_r5(main, dc, r5, r6)
    }
    state draw_r4(main: &Main, dc: &Main, x: i32, y: i32, w: i32, r5: Rect, r6: Rect) {
        let bw: i32 = max_i32(sub_i32(w, 36), 20);
        let rx_v: i32 = add_i32(x, sub_i32(w, 72));
        draw_ct_box(dc, main.font_bold, add_i32(x, 24), add_i32(y, 1), bw, 27, "Element scanner", main.ctx.theme.text, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 58), bw, 26, "0x7FF6_1020   i32", main.ctx.theme.accent, 0);
        draw_ct_box(dc, main.font_mono, rx_v, add_i32(y, 58), 50, 26, "1024", main.ctx.theme.text, 2);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 90), bw, 26, "0x7FF6_1024   i32", main.ctx.theme.success, 0);
        draw_ct_box(dc, main.font_mono, rx_v, add_i32(y, 90), 50, 26, "672", main.ctx.theme.text, 2);
        draw_ct_box(dc, main.font_reg, add_i32(x, 14), add_i32(y, 124), bw, 22, "Drag pane headers to swap, or drag splitters", main.ctx.theme.text_muted, 0);
        transition { _ -> check_r5(main, dc, r5, r6) }
    }
    state check_r5(main: &Main, dc: &Main, r5: Rect, r6: Rect) {
        transition r5.w > 80 && r5.h > 80 {
            true -> draw_r5(main, dc, r5.x as i32, r5.y as i32, r5.w as i32, r6)
            _ -> check_r6(main, dc, r6)
        }
    }
    state draw_r5(main: &Main, dc: &Main, x: i32, y: i32, w: i32, r6: Rect) {
        let bw: i32 = max_i32(sub_i32(w, 36), 20);
        draw_ct_box(dc, main.font_bold, add_i32(x, 24), add_i32(y, 1), bw, 27, "Memory Viewer (Hex)", main.ctx.theme.text, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 22), add_i32(y, 46), bw, 22, "0040: 4F 4D 45 47 41 5F 55 49", main.ctx.theme.success, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 22), add_i32(y, 72), bw, 22, "0050: 53 51 55 41 4C 52 5F 30", main.ctx.theme.text, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 22), add_i32(y, 98), bw, 22, "0060: 4E 41 4E 4F 54 45 52 4D", main.ctx.theme.accent, 0);
        transition { _ -> check_r6(main, dc, r6) }
    }
    state check_r6(main: &Main, dc: &Main, r6: Rect) {
        transition r6.w > 80 && r6.h > 80 {
            true -> draw_r6(main, dc, r6.x as i32, r6.y as i32, r6.w as i32)
            _ -> done()
        }
    }
    state draw_r6(main: &Main, dc: &Main, x: i32, y: i32, w: i32) {
        let bw: i32 = max_i32(sub_i32(w, 32), 20);
        let lw: i32 = max_i32(sub_i32(w, 24), 16);
        let rx_val: i32 = add_i32(x, sub_i32(w, 60));
        draw_ct_box(dc, main.font_bold, add_i32(x, 24), add_i32(y, 1), bw, 27, "Terminal and commands", main.ctx.theme.text, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 36), 96, 24, "center.ratio", main.ctx.theme.text_muted, 0);
        draw_ct_num3_box(dc, main.font_mono, rx_val, add_i32(y, 36), 40, 24, main.model.dock.nodes[0].ratio_b, main.ctx.theme.accent, 2);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 64), 96, 24, "right.ratio", main.ctx.theme.text_muted, 0);
        draw_ct_num3_box(dc, main.font_mono, rx_val, add_i32(y, 64), 40, 24, main.model.dock.nodes[0].ratio_c, main.ctx.theme.success, 2);

        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 117), bw, 18, "~/omega-ui (master)", main.ctx.theme.success, 0);
        draw_ct_box(dc, main.font_bold, add_i32(x, sub_i32(lw, 48)), add_i32(y, 117), 54, 18, "Re-run", main.ctx.theme.accent, 1);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 135), bw, 18, "$ omega gallery/main.omg", main.ctx.theme.text, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 20), add_i32(y, 151), bw, 18, "PASS: 1:1 HiDPI SDF", main.ctx.theme.accent, 0);

        draw_ct_box(dc, main.font_bold, add_i32(x, 20), add_i32(y, 180), bw, 18, "Agent Turn (5 wired)", main.ctx.theme.purple, 0);
        draw_ct_box(dc, main.font_mono, add_i32(x, 26), add_i32(y, 200), bw, 18, "> 4 tool calls folded", main.ctx.theme.text_muted, 0);
        draw_ct_box(dc, main.font_reg, add_i32(x, 20), add_i32(y, 222), bw, 18, "Command blocks ready.", main.ctx.theme.text, 0);
    }
    state done() {}
}

machine draw_native_dock_drag_ghost(main: &Main)
reaches WindowsGuiHost {
    let w: i32 = main.model.dock.drag_window_id;
    let gx: i32 = clamp_i32(sub_i32(main.ctx.mouse_x, 76), 266, 860);
    let gy: i32 = clamp_i32(sub_i32(main.ctx.mouse_y, 14), 146, 624);
    transition w <= 2 {
        true -> g12(main, gx, gy)
        _ -> check_g34(main, w, gx, gy)
    }
    state g12(main: &Main, gx: i32, gy: i32) {
        draw_ct_box(main, main.font_bold, gx, gy, 152, 28, "Dock: Explorer", main.ctx.theme.text, 1);
    }
    state check_g34(main: &Main, w: i32, gx: i32, gy: i32) {
        transition w == 3 {
            true -> g3(main, gx, gy)
            _ -> check_g45(main, w, gx, gy)
        }
    }
    state g3(main: &Main, gx: i32, gy: i32) {
        draw_ct_box(main, main.font_bold, gx, gy, 152, 28, "Dock: Struct Viewer", main.ctx.theme.text, 1);
    }
    state check_g45(main: &Main, w: i32, gx: i32, gy: i32) {
        transition w == 4 {
            true -> g4(main, gx, gy)
            _ -> check_g56(main, w, gx, gy)
        }
    }
    state g4(main: &Main, gx: i32, gy: i32) {
        draw_ct_box(main, main.font_bold, gx, gy, 152, 28, "Dock: Scanner", main.ctx.theme.text, 1);
    }
    state check_g56(main: &Main, w: i32, gx: i32, gy: i32) {
        transition w == 5 {
            true -> g5(main, gx, gy)
            _ -> g6(main, gx, gy)
        }
    }
    state g5(main: &Main, gx: i32, gy: i32) {
        draw_ct_box(main, main.font_bold, gx, gy, 152, 28, "Dock: Memory Viewer", main.ctx.theme.text, 1);
    }
    state g6(main: &Main, gx: i32, gy: i32) {
        draw_ct_box(main, main.font_bold, gx, gy, 152, 28, "Dock: Output", main.ctx.theme.text, 1);
    }
}

machine draw_native_dock_page(main: &Main)
reaches WindowsGuiHost {
    draw_native_dock_toolbar(main);
    draw_native_dock_left_panes(main);
    draw_native_dock_right_panes(main);
    transition main.model.dock.drag_window_id > 0 {
        true -> ghost(main)
        _ -> done()
    }
    state ghost(main: &Main) {
        draw_native_dock_drag_ghost(main);
    }
    state done() {}
}

machine prepare_search_text(main: &mut Main) reaches WindowsGuiHost {
    transition main.model.palette_open { true -> prepare(main) _ -> done() }
    state prepare(main: &mut Main) {
        let fonts: WindowsUiFonts = gallery_fonts(main);
        WindowsTextField::prepare(&mut main.model.search.field, &fonts, main.ctx.width as i32, 336);
    }
    state done() {}
}

machine handle_search_pointer(main: &mut Main) reaches WindowsGuiHost {
    let moved: bool = main.ctx.mouse_x != main.search_pointer_x || main.ctx.mouse_y != main.search_pointer_y;
    main.search_pointer_x = main.ctx.mouse_x;
    main.search_pointer_y = main.ctx.mouse_y;
    transition moved && main.model.palette_open && main.ctx.mouse_x >= 420 && main.ctx.mouse_x < 852 && main.ctx.mouse_y >= 172 && main.ctx.mouse_y < add_i32(172, mul_i32(main.model.search.count, 36)) {
        true -> hover(main)
        _ -> pointer(main)
    }
    state hover(main: &mut Main) {
        main.model.palette_pick = sub_i32(main.ctx.mouse_y, 172) / 36;
        transition { _ -> pointer(main) }
    }
    state pointer(main: &mut Main) {
        let fonts: WindowsUiFonts = gallery_fonts(main);
        let bounds: Rect = Rect { x: 450, y: 120, w: 350, h: 40 };
        let down: bool = main.ctx.mouse_down && main.model.palette_open;
        let changed: bool = WindowsTextField::pointer(&mut main.model.search.field, &fonts, main.ctx.width as i32,
            bounds, main.ctx.mouse_x, main.ctx.mouse_y, main.ctx.mouse_pressed, down);
    }
}

machine draw_native_palette_modal(main: &Main) reaches WindowsGuiHost {
    let length: i32 = main.model.search.field.length;
    let start: i32 = main.model.search.field.view_start;
    transition length > 0 && start >= 0 && start <= length && length <= 255 {
        true -> query(main, start as u64, length as u64)
        _ -> placeholder(main)
    }
    state query(main: &Main, start: u64, length: u64) requires start <= length && length <= 255u64 {
        let width: i32 = clamp_i32(main.client_w as i32, 320, 3840);
        let height: i32 = clamp_i32(main.client_h as i32, 240, 2160);
        let previous: u64 = WindowsGuiHost::select_object(main.hdc_mem, main.font_reg);
        let color: u32 = WindowsGuiHost::set_text_color(main.hdc_mem, rgb_to_colorref(main.ctx.theme.text));
        let mut rectangle: WindowsRectangle = WindowsRectangle { left: mul_i32(450, width) / 1024, top: mul_i32(122, height) / 672, right: mul_i32(800, width) / 1024, bottom: mul_i32(158, height) / 672 };
        let drawn: i32 = WindowsGuiHost::draw_text_rect_wide(main.hdc_mem, &main.model.search.field.text[start..length], &mut rectangle, 2084);
        transition { _ -> rows(main, 0) }
    }
    state placeholder(main: &Main) {
        draw_ct_box(main, main.font_reg, 450, 122, 350, 36, "Search commands...", main.ctx.theme.tertiary, 0);
        transition { _ -> rows(main, 0) }
    }
    state rows(main: &Main, row: i32) {
        transition row >= 0 && row < main.model.search.count && row < 6 {
            true -> result(main, row)
            _ -> footer(main)
        }
    }
    state result(main: &Main, row: i32) requires row >= 0 && row < 6 {
        let command: i32 = main.model.search.results[row];
        let title: GalleryCommand = GallerySearch::title(command);
        draw_ct_box(main, main.font_medium, 452, add_i32(172, mul_i32(row, 36)), 340, 34, &title.label[0..title.length], main.ctx.theme.text, 0);
        transition { _ -> rows(main, row + 1) }
    }
    state footer(main: &Main) {
        let y: i32 = add_i32(184, mul_i32(max_i32(main.model.search.count, 2), 36));
        draw_ct_box(main, main.font_reg, 428, y, 236, 24, "Up / Down to navigate", main.ctx.theme.tertiary, 0);
        draw_ct_box(main, main.font_reg, 722, y, 120, 24, "Enter to open", main.ctx.theme.text_muted, 2);
        draw_ct_box(main, main.font_reg, 814, 126, 30, 24, "esc", main.ctx.theme.tertiary, 1);
        transition main.model.search.count == 0 { true -> empty(main) _ -> done() }
    }
    state empty(main: &Main) { draw_ct_box(main, main.font_reg, 428, 184, 416, 48, "No commands found", main.ctx.theme.text_muted, 1); }
    state done() {}
}

machine draw_native_number_field(main: &Main)
reaches WindowsGuiHost {
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 24);
    let x: i32 = rectangle.x as i32;
    let y: i32 = rectangle.y as i32;
    let width: i32 = rectangle.w as i32;
    draw_ct_num3_box(main, main.font_mono, add_i32(x, 36), y, sub_i32(width, 72), 36, main.model.speed, main.ctx.theme.text, 1);
}

machine render_text_nodes(main: &Main) reaches WindowsGuiHost {
    let fonts: WindowsUiFonts = gallery_fonts(main);
    WindowsUiFonts::paint(&fonts, &main.ctx);
}

machine render_cleartype_ui(main: &Main) reaches WindowsGuiHost {
    let background_mode: i32 = WindowsGuiHost::set_bk_mode(main.hdc_mem, 1);
    draw_native_sidebar_top(main);
    draw_native_sidebar_sessions(main);
    draw_native_sidebar_bottom(main);
    draw_native_header_bar(main);
    transition main.model.palette_open { true -> modal(main) _ -> page(main) }
    state page(main: &Main) { render_native_page_text(main); }
    state modal(main: &Main) {
        let width: i32 = clamp_i32(main.client_w as i32, 320, 3840);
        let height: i32 = clamp_i32(main.client_h as i32, 240, 2160);
        let bottom: i32 = add_i32(214, mul_i32(max_i32(main.model.search.count, 2), 36));
        let excluded: i32 = WindowsGuiHost::exclude_clip_rectangle(main.hdc_mem, mul_i32(412, width) / 1024, mul_i32(110, height) / 672,
            add_i32(mul_i32(860, width), 1023) / 1024, add_i32(mul_i32(bottom, height), 671) / 672);
        render_native_page_text(main);
        GalleryTextClip::restore(&main.text_clip, main.hdc_mem, main.damage_left, main.damage_top, main.damage_right, main.damage_bottom);
        draw_native_palette_modal(main);
    }
}

machine render_native_page_text(main: &Main) reaches WindowsGuiHost {
    render_text_nodes(main);
    transition { _ -> check_p0(main, main.model.page) }
    state check_p0(main: &Main, p: i32) {
        transition p == 0 {
            true -> pg0(main)
            _ -> check_p1(main, p)
        }
    }
    state pg0(main: &Main) {
        draw_native_controls_top(main);
        draw_native_controls_mid(main);
        draw_native_controls_bot(main);
        draw_native_palette_card(main, 500);
        draw_native_number_field(main);
    }
    state check_p1(main: &Main, p: i32) {
        transition p == 1 {
            true -> pg1(main)
            _ -> check_p2(main, p)
        }
    }
    state pg1(main: &Main) {
        draw_native_tasks_page(main);
    }
    state check_p2(main: &Main, p: i32) {
        transition p == 2 {
            true -> pg2(main)
            _ -> check_p3(main, p)
        }
    }
    state pg2(main: &Main) {
        draw_native_synth_page(main);
    }
    state check_p3(main: &Main, p: i32) {
        transition p == 3 {
            true -> pg3(main)
            _ -> pg4(main)
        }
    }
    state pg3(main: &Main) {
        draw_native_theme_page(main);
    }
    state pg4(main: &Main) {
        draw_native_dock_page(main);
    }
}

machine select_font_tier(main: &mut Main, ch: i32) {
    transition ch > 1220 {
        true -> tier3(main)
        _ -> check_t2(main, ch)
    }
    state check_t2(main: &mut Main, ch: i32) {
        transition ch > 980 {
            true -> tier2(main)
            _ -> check_t1(main, ch)
        }
    }
    state check_t1(main: &mut Main, ch: i32) {
        transition ch > 760 {
            true -> tier1(main)
            _ -> tier0(main)
        }
    }
    state tier0(main: &mut Main) {
        main.font_reg = main.f0_reg;
        main.font_medium = main.f0_medium;
        main.font_bold = main.f0_bold;
        main.font_title = main.f0_title;
        main.font_mono = main.f0_mono;
        main.font_hero = main.f0_hero;
    }
    state tier1(main: &mut Main) {
        main.font_reg = main.f1_reg;
        main.font_medium = main.f1_medium;
        main.font_bold = main.f1_bold;
        main.font_title = main.f1_title;
        main.font_mono = main.f1_mono;
        main.font_hero = main.f1_hero;
    }
    state tier2(main: &mut Main) {
        main.font_reg = main.f2_reg;
        main.font_medium = main.f2_medium;
        main.font_bold = main.f2_bold;
        main.font_title = main.f2_title;
        main.font_mono = main.f2_mono;
        main.font_hero = main.f2_hero;
    }
    state tier3(main: &mut Main) {
        main.font_reg = main.f3_reg;
        main.font_medium = main.f3_medium;
        main.font_bold = main.f3_bold;
        main.font_title = main.f3_title;
        main.font_mono = main.f3_mono;
        main.font_hero = main.f3_hero;
    }
}

machine render_and_blit_frame(main: &mut Main, hdc: u64)
reaches WindowsGuiHost {
    let cw: i32 = clamp_i32(main.client_w as i32, 320, 3840);
    let ch: i32 = clamp_i32(main.client_h as i32, 240, 2160);
    UiScene::prepare(&mut main.scene, &main.ctx);
    main.text_phase = false;
    main.text_drawn = false;
    GalleryTextClip::begin(&mut main.text_clip);
    prepare_search_text(main);
    let flushed: i32 = WindowsGuiHost::flush_gdi();
    let cpu_v: i32 = compute_cpu_load(&main.model);
    Raster::configure_for_context(&main.ctx, &mut main.pixels, 0);
    main.pixels[4094] = cw;
    main.pixels[4095] = ch;
    main.info[1] = cw;
    main.info[2] = 0 - 1;
    transition main.reference_dots {
        true -> prepare_damage(main, hdc, cw, ch, cpu_v)
        _ -> prepare_dots(main, hdc, cw, ch, cpu_v)
    }
    state prepare_dots(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32) {
        GalleryDots::prepare(&mut main.dots, &main.ctx, cw);
        transition { _ -> prepare_damage(main, hdc, cw, ch, cpu_v) }
    }
    state prepare_damage(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32) {
        GalleryDamage::prepare(&mut main.damage, &main.ctx, cw, ch, main.model.page, main.model.palette_open, main.full_redraw_requested);
        transition main.model.page == 4 {
            true -> dock_damage(main, hdc, cw, ch, cpu_v)
            _ -> damage_bounds(main, hdc, cw, ch, cpu_v)
        }
    }
    state dock_damage(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32) {
        GalleryDockDamage::prepare(&mut main.dock_damage, &mut main.damage, &main.ctx, &main.model.dock, cpu_v);
        main.dock_paint.count = 0;
        main.dock_paint.overflow = false;
        main.dock_paint.logical_width = main.ctx.width as i32;
        main.dock_paint.logical_height = main.ctx.height as i32;
        main.dock_paint.width = cw;
        main.dock_paint.height = ch;
        main.dock_paint.recording = true;
        GalleryRaster::render_dock_tree_band(&mut main.dock_paint, &mut main.pixels, 0, &main.ctx, &main.model.dock, cpu_v);
        main.dock_paint.recording = false;
        WindowsBoxPainter::prepare_styles(&mut main.dock_paint, &mut main.corner_cache, &mut main.pixels);
        let background: i32 = main.ctx.theme.background;
        main.dock_background_slot = WindowsFillCache::style(&mut main.corner_cache.fills, &mut main.pixels, background);
        main.flat_dock_background = GalleryDockRows::flat_background(&main.ctx);
        transition main.direct_bitmap { true -> damage_bounds(main, hdc, cw, ch, cpu_v) _ -> scanline_plan(main, hdc, cw, ch, cpu_v) }
    }
    state scanline_plan(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32) {
        GalleryDockRows::prepare_rows(&mut main.dock_paint, &main.ctx);
        transition { _ -> damage_bounds(main, hdc, cw, ch, cpu_v) }
    }
    state damage_bounds(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32) {
        main.pixels[4090] = -271828;

        transition { _ -> region(main, hdc, cw, ch, cpu_v, 0) }
    }
    state region(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32, row: i32) {
        transition row >= 0 && row < ch && row < 2160 {
            true -> begin_region(main, hdc, cw, ch, cpu_v, row)
            _ -> finished(main, hdc)
        }
    }
    state begin_region(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32, row: i32) {
        let rectangle: GalleryDirtyRectangle = GalleryDamage::region(&main.damage, row);
        main.damage_left = rectangle.left;
        main.damage_right = rectangle.right;
        main.damage_top = rectangle.top;
        main.damage_bottom = rectangle.bottom;
        main.pixels[4090] = select_i32(rectangle.left > 0 || rectangle.right < cw, -271828, 0);
        main.pixels[4091] = main.damage_left;
        main.pixels[4092] = main.damage_right;
        main.prepared_dock = main.model.page == 4 && !main.model.palette_open && !main.reference_dock && !main.dock_paint.overflow
            && rectangle.left >= (Raster::to_physical_x(250, cw as i32 in Saturating, false, main.ctx.width) as i32);
        transition rectangle.left < rectangle.right && rectangle.bottom > row {
            true -> region_phase(main, hdc, cw, ch, cpu_v, row)
            _ -> region(main, hdc, cw, ch, cpu_v, max_i32(add_i32(row, 1), rectangle.bottom))
        }
    }
    state region_phase(main: &mut Main, hdc: u64, cw: i32, ch: i32, cpu_v: i32, row: i32) {
        transition main.text_phase { true -> text_region(main, hdc, cw, ch) _ -> cpu_region(main, hdc, row, cw, ch, cpu_v) }
    }
    state cpu_region(main: &mut Main, hdc: u64, row: i32, cw: i32, ch: i32, cpu_v: i32) {
        let left: i32 = main.damage_left;
        let top: i32 = main.damage_top;
        let right: i32 = main.damage_right;
        let bottom: i32 = main.damage_bottom;
        GalleryTextClip::include(&mut main.text_clip, left, top, right, bottom);
        transition { _ -> band_loop(main, hdc, row, cw, ch, cpu_v) }
    }
    state text_region(main: &mut Main, hdc: u64, cw: i32, ch: i32) {
        transition main.text_drawn { true -> present(main, hdc, cw, ch) _ -> paint_text(main, hdc, cw, ch) }
    }
    state band_loop(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        transition py >= 0 && py < ch && py < 2160 && py < main.damage_bottom {
            true -> choose_dock_bitmap(main, hdc, py, cw, ch, cpu_v)
            _ -> finish_frame(main, hdc, cw, ch)
        }
    }
    state choose_dock_bitmap(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) requires py >= 0 && py < ch && py < 2160 {
        transition main.prepared_dock && main.flat_dock_background && main.direct_bitmap && py >= (Raster::to_physical_y(170, ch as i32 in Saturating, false, main.ctx.height) as i32) {
            true -> dock_bitmap(main, hdc, py, cw, ch, cpu_v)
            _ -> reuse_band(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state dock_bitmap(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) requires py >= 0 && py < ch && py < 2160 {
        let target: WindowsBitmapTarget = WindowsBitmapTarget { pixels: main.bitmap_pixels, stride: main.bitmap_stride, height: main.bitmap_height, left: main.damage_left, top: py, right: main.damage_right, bottom: min_i32(main.damage_bottom, add_i32(mul_i32(667, ch), 671) / 672) };
        let copied: bool = WindowsBoxPainter::render_bitmap(&main.dock_paint, &mut main.corner_cache, &mut main.pixels, &target, main.ctx.theme.background, main.dock_background_slot);
        // A failed copy repaints this entire region through the existing path.
        transition copied { true -> finish_frame(main, hdc, cw, ch) _ -> failed_dock_bitmap(main, hdc, py, cw, ch, cpu_v) }
    }
    state failed_dock_bitmap(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) requires py >= 0 && py < ch && py < 2160 {
        main.direct_bitmap = false;
        GalleryDockRows::prepare_rows(&mut main.dock_paint, &main.ctx);
        transition { _ -> band_step(main, hdc, py, cw, ch, cpu_v) }
    }
    state reuse_band(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) requires py >= 0 && py < ch && py < 2160 {
        // A region can cross the toolbar; apply the empty-canvas cutoff per row.
        transition main.prepared_dock && main.flat_dock_background && py > 0 && py > main.damage_top && py > (Raster::to_physical_y(170, ch as i32 in Saturating, false, main.ctx.height) as i32) {
            true -> check_flat(main, hdc, py, cw, ch, cpu_v)
            _ -> band_step(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state check_flat(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) requires py > 0 && py < 2160 {
        transition !WindowsBoxPainter::varying(&main.dock_paint, py) && !WindowsBoxPainter::varying(&main.dock_paint, py - 1) {
            true -> reuse_flat(main, hdc, py, cw, ch, cpu_v)
            _ -> band_step(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state reuse_flat(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        transition main.direct_bitmap {
            true -> copy_flat_rows(main, hdc, py, cw, ch, cpu_v)
            _ -> reuse_one_row(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state copy_flat_rows(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        let end: i32 = WindowsBoxPainter::flat_end(&main.dock_paint, py, main.damage_bottom);
        transition py >= 0 && end > py && end <= 2160 {
            true -> copy_flat_range(main, hdc, py, end, cw, ch, cpu_v)
            _ -> reuse_one_row(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state copy_flat_range(main: &mut Main, hdc: u64, py: i32, end: i32, cw: i32, ch: i32, cpu_v: i32)
    requires py >= 0 && end > py && end <= 2160 {
        let count: i32 = end - py;
        let copied: bool = WindowsGuiHost::copy_bitmap_rows(main.bitmap_pixels, main.bitmap_stride, main.bitmap_height, py, main.damage_left, sub_i32(main.damage_right, main.damage_left), count, &main.pixels);
        transition copied {
            true -> copied_flat_rows(main, hdc, end, count as u64, cw, ch, cpu_v)
            _ -> reuse_one_row(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state copied_flat_rows(main: &mut Main, hdc: u64, end: i32, count: u64, cw: i32, ch: i32, cpu_v: i32) {
        main.reused_rows = main.reused_rows + (count as u64 in Saturating);
        transition { _ -> band_loop(main, hdc, end, cw, ch, cpu_v) }
    }
    state reuse_one_row(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        main.reused_rows = main.reused_rows + (1u64 as u64 in Saturating);
        transition { _ -> blit_band(main, hdc, py, cw, ch, cpu_v) }
    }
    state band_step(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32)
    requires py >= 0 && py < ch && py < 2160 {
        transition main.prepared_dock && main.flat_dock_background && py >= (Raster::to_physical_y(170, ch as i32 in Saturating, false, main.ctx.height) as i32) {
            true -> flat_background(main, hdc, py, cw, ch, cpu_v)
            _ -> paint_band(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state flat_background(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        main.flat_rows = main.flat_rows + (1u64 as u64 in Saturating);
        let background: i32 = main.ctx.theme.background;
        let left: i32 in Saturating = main.damage_left as i32 in Saturating;
        let right: i32 in Saturating = main.damage_right as i32 in Saturating;
        let slot: i32 = main.dock_background_slot;
        WindowsFillCache::fill_span(&mut main.corner_cache.fills, &mut main.pixels, py, left, right, background, slot);
        transition { _ -> overlay_dock(main, hdc, py, cw, ch, cpu_v) }
    }
    state paint_band(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        GalleryRaster::render_band(&main.scene, &main.dots, main.reference_dots, &main.ctx, &mut main.pixels, py);
        transition main.model.page == 4 {
            true -> overlay_dock(main, hdc, py, cw, ch, cpu_v)
            _ -> check_pal_band(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state overlay_dock(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        transition !main.reference_dock && !main.dock_paint.overflow {
            true -> prepared_dock(main, hdc, py, cw, ch, cpu_v)
            _ -> scalar_dock(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state prepared_dock(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        WindowsBoxPainter::render(&main.dock_paint, &mut main.corner_cache, &mut main.pixels, py);
        transition { _ -> check_pal_band(main, hdc, py, cw, ch, cpu_v) }
    }
    state scalar_dock(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        GalleryRaster::render_dock_tree_band(&mut main.dock_paint, &mut main.pixels, py, &main.ctx, &main.model.dock, cpu_v);
        transition { _ -> check_pal_band(main, hdc, py, cw, ch, cpu_v) }
    }
    state check_pal_band(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        transition main.model.palette_open {
            true -> overlay_pal(main, hdc, py, cw, ch, cpu_v)
            _ -> blit_band(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state overlay_pal(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        GalleryRaster::render_palette_modal(&mut main.pixels, py, &main.ctx, clamp_i32(main.model.palette_highlight, 0, mul_i32(max_i32(sub_i32(main.model.search.count, 1), 0), 200)), main.model.search.count, main.model.search.field.selection_left_x, main.model.search.field.selection_right_x, main.model.search.field.caret_x);
        transition { _ -> blit_band(main, hdc, py, cw, ch, cpu_v) }
    }
    state blit_band(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        transition main.direct_bitmap {
            true -> copy_bitmap_row(main, hdc, py, cw, ch, cpu_v)
            _ -> upload_bitmap_row(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state copy_bitmap_row(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        let copied: bool = WindowsGuiHost::copy_bitmap_span(main.bitmap_pixels, main.bitmap_stride, main.bitmap_height, py, main.damage_left, sub_i32(main.damage_right, main.damage_left), &main.pixels);
        transition copied {
            true -> band_loop(main, hdc, py + 1, cw, ch, cpu_v)
            _ -> upload_bitmap_row(main, hdc, py, cw, ch, cpu_v)
        }
    }
    state upload_bitmap_row(main: &mut Main, hdc: u64, py: i32, cw: i32, ch: i32, cpu_v: i32) {
        let copied: i32 = gallery_blit_band_1to1(main.hdc_mem, py, main.damage_left, sub_i32(main.damage_right, main.damage_left), &main.pixels, &main.info);
        transition { _ -> band_loop(main, hdc, py + 1, cw, ch, cpu_v) }
    }
    state finish_frame(main: &mut Main, hdc: u64, cw: i32, ch: i32) {
        // Finish every CPU write before queuing GDI text into the frame bitmap.
        transition { _ -> region(main, hdc, cw, ch, compute_cpu_load(&main.model), main.damage_bottom) }
    }
    state paint_text(main: &mut Main, hdc: u64, cw: i32, ch: i32) {
        let clipped: i32 = WindowsGuiHost::intersect_clip_rectangle(main.hdc_mem, main.damage_left, main.damage_top, main.damage_right, main.damage_bottom);
        select_font_tier(main, ch);
        render_cleartype_ui(main);
        let restored: i32 = WindowsGuiHost::select_clip_region(main.hdc_mem, 0);
        transition { _ -> present(main, hdc, cw, ch) }
    }
    state present(main: &mut Main, hdc: u64, cw: i32, ch: i32) {
        transition hdc > 0 && main.damage_top < main.damage_bottom {
            true -> do_blt(main, hdc, cw, ch)
            _ -> region(main, hdc, cw, ch, compute_cpu_load(&main.model), main.damage_bottom)
        }
    }
    state do_blt(main: &mut Main, hdc: u64, cw: i32, ch: i32) {
        let blt_ok: i32 = WindowsGuiHost::bit_blt(hdc, main.damage_left, main.damage_top, sub_i32(main.damage_right, main.damage_left), sub_i32(main.damage_bottom, main.damage_top), main.hdc_mem, main.damage_left, main.damage_top, 13369376);
        transition { _ -> region(main, hdc, cw, ch, compute_cpu_load(&main.model), main.damage_bottom) }
    }
    state finished(main: &mut Main, hdc: u64) {
        transition main.text_phase { true -> presented(main, hdc) _ -> combined_text(main, hdc) }
    }
    state combined_text(main: &mut Main, hdc: u64) {
        let device: u64 = main.hdc_mem;
        let selected: bool = GalleryTextClip::select(&mut main.text_clip, device);
        transition selected { true -> paint_combined_text(main, hdc) _ -> fallback_text(main, hdc) }
    }
    state paint_combined_text(main: &mut Main, hdc: u64) {
        main.text_batches = main.text_batches + (1u64 as u64 in Saturating);
        let height: i32 = clamp_i32(main.client_h as i32, 240, 2160);
        select_font_tier(main, height);
        render_cleartype_ui(main);
        let reset: i32 = WindowsGuiHost::select_clip_region(main.hdc_mem, 0);
        GalleryTextClip::close(&mut main.text_clip);
        main.text_drawn = true;
        transition { _ -> start_text(main, hdc) }
    }
    state fallback_text(main: &mut Main, hdc: u64) {
        main.text_fallbacks = main.text_fallbacks + (1u64 as u64 in Saturating);
        GalleryTextClip::close(&mut main.text_clip);
        transition { _ -> start_text(main, hdc) }
    }
    state start_text(main: &mut Main, hdc: u64) {
        main.text_phase = true;
        let cw: i32 = clamp_i32(main.client_w as i32, 320, 3840);
        let ch: i32 = clamp_i32(main.client_h as i32, 240, 2160);
        transition { _ -> region(main, hdc, cw, ch, compute_cpu_load(&main.model), 0) }
    }
    state presented(main: &mut Main, hdc: u64) {
        GalleryTextClip::close(&mut main.text_clip);
        main.full_redraw_requested = false;
        transition hdc > 0 { true -> pace() _ -> done() }
    }
    state pace() { let paced: i32 = WindowsGuiHost::wait_for_compositor(); }
    state done() {}
}

machine add_gallery_font(filename: &[u8]) -> bool reaches WindowsGuiHost {
    let mut path: [u16; 1024];
    let length: u32 = WindowsGuiHost::module_filename(&mut path);
    let mut suffix: UiUtf16Text;
    let valid: bool = UiUtf16Text::decode(&mut suffix, filename);
    transition length > 0u32 && length < 1024u32 && valid && suffix.length > 0u64 && suffix.length <= 128u64 {
        true -> directory(&mut path, length as u64, 0, 0, &suffix)
        _ -> (false)
    }
    state directory(path: &mut [u16; 1024], length: u64, index: u64, start: u64, suffix: &UiUtf16Text) -> bool
    requires length < 1024u64 && index <= 1024u64 && start <= 1024u64 && suffix.length <= 128u64 {
        transition index < length {
            true -> character(path, length, index, start, suffix)
            _ -> fits(path, start, suffix)
        }
    }
    state character(path: &mut [u16; 1024], length: u64, index: u64, start: u64, suffix: &UiUtf16Text) -> bool
    requires length < 1024u64 && index < length && start <= 1024u64 && suffix.length <= 128u64 {
        let next_start: u64 = start;
        transition path[index] == 92u16 || path[index] == 47u16 {
            true -> directory(path, length, index + 1u64, index + 1u64, suffix)
            _ -> directory(path, length, index + 1u64, next_start, suffix)
        }
    }
    state fits(path: &mut [u16; 1024], start: u64, suffix: &UiUtf16Text) -> bool
    requires start <= 1024u64 && suffix.length <= 128u64 {
        transition start > 0u64 && start + suffix.length <= 1024u64 {
            true -> copy(path, start, suffix, 0)
            _ -> (false)
        }
    }
    state copy(path: &mut [u16; 1024], start: u64, suffix: &UiUtf16Text, index: u64) -> bool
    requires start <= 1024u64 && suffix.length <= 128u64 && index <= 128u64 {
        let destination: u64 = start + index;
        transition index < suffix.length && destination < 1024u64 {
            true -> unit(path, start, suffix, index, destination)
            _ -> finish(path, start, suffix)
        }
    }
    state unit(path: &mut [u16; 1024], start: u64, suffix: &UiUtf16Text, index: u64, destination: u64) -> bool
    requires start <= 1024u64 && suffix.length <= 128u64 && index < suffix.length && destination < 1024u64 {
        path[destination] = suffix.units[index];
        transition { _ -> copy(path, start, suffix, index + 1u64) }
    }
    state finish(path: &mut [u16; 1024], start: u64, suffix: &UiUtf16Text) -> bool
    requires start <= 1024u64 && suffix.length <= 128u64 {
        let end: u64 = start + suffix.length;
        transition end <= 1024u64 {
            true -> (WindowsGuiHost::add_private_font(&path[0..end]) > 0)
            _ -> (false)
        }
    }
}

machine selected_inter_face(device: u64, font: u64) -> bool reaches WindowsGuiHost {
    let previous: u64 = WindowsGuiHost::select_object(device, font);
    let mut face: [u16; 64];
    let count: i32 = WindowsGuiHost::text_face(device, &mut face);
    let restored: u64 = WindowsGuiHost::select_object(device, previous);
    font != 0u64 && count >= 5 && face[0] == 73u16 && face[1] == 110u16 && face[2] == 116u16 && face[3] == 101u16 && face[4] == 114u16
}

machine init_gdi_resources(main: &mut Main, hdc: u64, max_w: i32, max_h: i32)
reaches WindowsGuiHost {
    main.text_batches = 0; main.text_fallbacks = 0;
    WindowsCornerCache::init(&mut main.corner_cache, hdc);
    let regular: bool = add_gallery_font("fonts/Inter-Regular.ttf\0");
    let medium: bool = add_gallery_font("fonts/Inter-Medium.ttf\0");
    let semibold: bool = add_gallery_font("fonts/Inter-SemiBold.ttf\0");
    main.fonts_ready = regular && medium && semibold;

    main.hdc_mem = WindowsGuiHost::create_compatible_dc(hdc);
    main.info[1] = max_w;
    main.info[2] = sub_i32(0, max_h);
    main.hbm_mem = WindowsGuiHost::create_dib_section(hdc, &main.info[0], 0, &mut main.bitmap_pixels, 0, 0);
    main.bitmap_stride = max_w;
    main.bitmap_height = max_h;
    main.direct_bitmap = main.hbm_mem > 0 && main.bitmap_pixels > 0;
    main.hbm_prev = WindowsGuiHost::select_object(main.hdc_mem, main.hbm_mem);

    main.f0_reg = WindowsGuiHost::create_font(0 - 14, 400, "Inter\0");
    main.f0_medium = WindowsGuiHost::create_font(0 - 14, 500, "Inter Medium\0");
    main.f0_bold = WindowsGuiHost::create_font(0 - 14, 600, "Inter SemiBold\0");
    main.f0_title = WindowsGuiHost::create_font(0 - 21, 600, "Inter SemiBold\0");
    main.f0_mono = WindowsGuiHost::create_font(0 - 12, 400, "Consolas\0");
    main.f0_hero = WindowsGuiHost::create_font(0 - 22, 600, "Inter SemiBold\0");

    main.f1_reg = WindowsGuiHost::create_font(0 - 18, 400, "Inter\0");
    main.f1_medium = WindowsGuiHost::create_font(0 - 18, 500, "Inter Medium\0");
    main.f1_bold = WindowsGuiHost::create_font(0 - 18, 600, "Inter SemiBold\0");
    main.f1_title = WindowsGuiHost::create_font(0 - 27, 600, "Inter SemiBold\0");
    main.f1_mono = WindowsGuiHost::create_font(0 - 15, 400, "Consolas\0");
    main.f1_hero = WindowsGuiHost::create_font(0 - 28, 600, "Inter SemiBold\0");

    main.f2_reg = WindowsGuiHost::create_font(0 - 22, 400, "Inter\0");
    main.f2_medium = WindowsGuiHost::create_font(0 - 22, 500, "Inter Medium\0");
    main.f2_bold = WindowsGuiHost::create_font(0 - 22, 600, "Inter SemiBold\0");
    main.f2_title = WindowsGuiHost::create_font(0 - 34, 600, "Inter SemiBold\0");
    main.f2_mono = WindowsGuiHost::create_font(0 - 19, 400, "Consolas\0");
    main.f2_hero = WindowsGuiHost::create_font(0 - 35, 600, "Inter SemiBold\0");

    main.f3_reg = WindowsGuiHost::create_font(0 - 26, 400, "Inter\0");
    main.f3_medium = WindowsGuiHost::create_font(0 - 26, 500, "Inter Medium\0");
    main.f3_bold = WindowsGuiHost::create_font(0 - 26, 600, "Inter SemiBold\0");
    main.f3_title = WindowsGuiHost::create_font(0 - 41, 600, "Inter SemiBold\0");
    main.f3_mono = WindowsGuiHost::create_font(0 - 22, 400, "Consolas\0");
    main.f3_hero = WindowsGuiHost::create_font(0 - 42, 600, "Inter SemiBold\0");

    main.font_reg = main.f0_reg;
    main.font_medium = main.f0_medium;
    main.font_bold = main.f0_bold;
    main.font_title = main.f0_title;
    main.font_mono = main.f0_mono;
    main.font_hero = main.f0_hero;
    let regular_face: bool = selected_inter_face(main.hdc_mem, main.f0_reg);
    let medium_face: bool = selected_inter_face(main.hdc_mem, main.f0_medium);
    let semibold_face: bool = selected_inter_face(main.hdc_mem, main.f0_bold);
    main.fonts_ready = main.direct_bitmap && main.fonts_ready && regular_face && medium_face && semibold_face;
}

machine save_offscreen_bmp(main: &mut Main, path: &[u8]) reaches WindowsGuiHost {
    let file: u64 = WindowsGuiHost::open_bmp_file(path);
    let width: i32 = clamp_i32(main.client_w as i32, 320, 3840);
    let height: i32 = clamp_i32(main.client_h as i32, 240, 2160);
    transition file > 0 {
        true -> header(main, file, width, height)
        _ -> done()
    }
    state header(main: &mut Main, file: u64, width: i32, height: i32) {
        let flushed: i32 = WindowsGuiHost::flush_gdi();
        let original: u64 = WindowsGuiHost::select_object(main.hdc_mem, main.hbm_prev);
        let bytes: i32 = mul_i32(mul_i32(width, height), 4);
        main.pixels[0] = 19778;
        let signature: i32 = WindowsGuiHost::write_bmp_band(file, &main.pixels, 2);
        main.pixels[0] = add_i32(bytes, 54);
        main.pixels[1] = 0;
        main.pixels[2] = 54;
        main.pixels[3] = 40;
        main.pixels[4] = width;
        main.pixels[5] = height;
        main.pixels[6] = 2097153;
        main.pixels[7] = 0;
        main.pixels[8] = bytes;
        main.pixels[9] = 0;
        main.pixels[10] = 0;
        main.pixels[11] = 0;
        main.pixels[12] = 0;
        let header: i32 = WindowsGuiHost::write_bmp_band(file, &main.pixels, 52);
        main.info[1] = width;
        main.info[2] = height;
        main.info[5] = bytes;
        transition { _ -> row(main, file, width, height, 0) }
    }
    state row(main: &mut Main, file: u64, width: i32, height: i32, index: i32) {
        transition index >= 0 && index < height && index < 2160 && width > 0 && width <= 3840 {
            true -> write_row(main, file, width, height, index)
            _ -> finish(main, file)
        }
    }
    state write_row(main: &mut Main, file: u64, width: i32, height: i32, index: i32)
    requires index >= 0 && index < 2160 && width > 0 && width <= 3840 {
        let count: i32 = WindowsGuiHost::get_di_bits(main.hdc_mem, main.hbm_mem, index as u32, 1, &mut main.pixels[0], &main.info[0], 0);
        let written: i32 = WindowsGuiHost::write_bmp_band(file, &main.pixels, (width * 4) as u32);
        transition { _ -> row(main, file, width, height, index + 1) }
    }
    state finish(main: &mut Main, file: u64) {
        main.info[2] = -1;
        main.info[5] = 0;
        let selected: u64 = WindowsGuiHost::select_object(main.hdc_mem, main.hbm_mem);
        let closed: i32 = WindowsGuiHost::close_bmp_file(file);
    }
    state done() {}
}

machine run_headless_p01(main: &mut Main)
reaches WindowsGuiHost {
