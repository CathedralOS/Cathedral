machine draw_native_palette_card(main: &Main, y0: i32)
reaches WindowsGuiHost {
    let dc: &Main = main;
    let y_hdr: i32 = add_i32(y0, 8);
    let sy: i32 = add_i32(y0, 40);
    let coff: i32 = clamp_i32(mul_i32(main.model.text_len, 7), 0, 180);
    draw_ct_box(dc, main.font_bold, 282, y_hdr, 460, 24, "Text and color", main.ctx.theme.text, 0);

    transition main.model.text_len > 0 {
        true -> draw_typed(main, dc, sy, coff)
        _ -> draw_placeholder(main, dc, sy)
    }
    state draw_typed(main: &Main, dc: &Main, sy: i32, coff: i32) {
        draw_ct_box(dc, main.font_mono, 292, sy, 200, 36, &main.model.text_buf, main.ctx.theme.text, 0);
        transition main.model.text_len < 10 {
            true -> draw_ghost(main, dc, sy, coff)
            _ -> draw_rest(main, dc, sy)
        }
    }
    state draw_ghost(main: &Main, dc: &Main, sy: i32, coff: i32) {
        draw_ct_box_alpha(dc, main.font_mono, add_i32(296, coff), sy, 90, 36, "-Omega", main.ctx.theme.well, main.ctx.theme.text_muted, 55, 0);
        transition { _ -> draw_rest(main, dc, sy) }
    }
    state draw_placeholder(main: &Main, dc: &Main, sy: i32) {
        draw_ct_box_alpha(dc, main.font_reg, 296, sy, 180, 36, "Your name... (type)", main.ctx.theme.well, main.ctx.theme.text_muted, 55, 0);
        transition { _ -> draw_rest(main, dc, sy) }
    }
    state draw_rest(main: &Main, dc: &Main, sy: i32) {
        draw_ct_box(dc, main.font_mono, 518, add_i32(sy, 6), 24, 24, "->", main.ctx.theme.accent, 1);
        draw_ct_box(dc, main.font_reg, 558, sy, 64, 36, "Clear", main.ctx.theme.text_muted, 1);
        draw_ct_box(dc, main.font_bold, 634, sy, 40, 36, "Sky", 0x0B0D11, 1);
        draw_ct_box(dc, main.font_bold, 680, sy, 40, 36, "Mnt", 0x0B0D11, 1);
        draw_ct_box(dc, main.font_bold, 726, sy, 40, 36, "Amb", 0x0B0D11, 1);
        draw_ct_box(dc, main.font_bold, 772, sy, 40, 36, "Vio", 0x0B0D11, 1);
        draw_ct_box(dc, main.font_bold, 818, sy, 40, 36, "Rse", 0x0B0D11, 1);
    }
}

machine draw_native_task_row_text(main: &Main, slot: i32, title: &[u8]) reaches WindowsGuiHost
requires slot >= 0 && slot < 5 {
    transition slot < main.model.task_count {
        true -> row(main, slot, title)
        _ -> done()
    }
    state row(main: &Main, slot: i32, title: &[u8]) requires slot >= 0 && slot < 5 {
        let rectangle: Rect = UiContext::previous_rect(&main.ctx, add_i32(31, slot));
        let color: i32 = select_i32(main.model.task_done[slot], main.ctx.theme.text_muted, main.ctx.theme.text);
        draw_ct_box(main, main.font_reg, add_i32(rectangle.x as i32, 52), rectangle.y as i32, 530, rectangle.h as i32, title, color, 0);
        draw_ct_box(main, main.font_reg, add_i32(rectangle.x as i32, 640), rectangle.y as i32, 86, rectangle.h as i32, "Remove", main.ctx.theme.text_muted, 1);
    }
    state done() {}
}

machine draw_native_virtual_rows(main: &Main) reaches WindowsGuiHost {
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, 36);
    let step: i32 = select_i32(main.model.list_filter == 1, 3, 1);
    let rows: UiListRange = UiListRange::visible(select_i32(step == 3, 3334, 10000), 35, 0,
        max_i32(sub_i32(rectangle.h as i32, 57), 0), mul_i32(main.model.list_scroll, 35), 0);
    transition { _ -> row(main, &rows, rectangle, step, rows.first) }
    state row(main: &Main, rows: &UiListRange, rectangle: Rect, step: i32, index: i32) {
        transition index >= 0 && index < rows.end && index < 10000 {
            true -> label(main, rows, rectangle, step, index)
            _ -> done()
        }
    }
    state label(main: &Main, rows: &UiListRange, rectangle: Rect, step: i32, index: i32) requires index >= 0 && index < 10000 {
        let item: i32 = clamp_i32(mul_i32(index, step), 0, 9999);
        let mut label: [u8; 11] = "Record 0000";
        label[7] = (48 + ((item / 1000) % 10)) as u8;
        label[8] = (48 + ((item / 100) % 10)) as u8;
        label[9] = (48 + ((item / 10) % 10)) as u8;
        label[10] = (48 + (item % 10)) as u8;
        draw_ct_box(main, main.font_reg, add_i32(rectangle.x as i32, 52), add_i32(rectangle.y as i32, add_i32(44, UiListRange::row_y(rows, index))), 600, 31, &label, main.ctx.theme.text, 0);
        transition { _ -> row(main, rows, rectangle, step, index + 1) }
    }
    state done() {}
}

machine draw_native_tasks_empty(main: &Main) reaches WindowsGuiHost {
    transition main.model.task_count == 0 {
        true -> empty(main)
        _ -> done()
    }
    state empty(main: &Main) {
        let rectangle: Rect = UiContext::previous_rect(&main.ctx, 31);
        draw_ct_box(main, main.font_reg, rectangle.x as i32, rectangle.y as i32, rectangle.w as i32, rectangle.h as i32, "No tasks yet", main.ctx.theme.text_muted, 1);
    }
    state done() {}
}

machine draw_native_tasks_page(main: &Main)
reaches WindowsGuiHost {
    let dc: &Main = main;
    let tot_cnt: i32 = clamp_i32(main.model.task_count, 0, 3);
    let d0: i32 = select_i32(tot_cnt > 0 && main.model.task_done[0], 1, 0);
    let d1: i32 = select_i32(tot_cnt > 1 && main.model.task_done[1], 1, 0);
    let d2: i32 = select_i32(tot_cnt > 2 && main.model.task_done[2], 1, 0);
    let done_cnt: i32 = add_i32(d0, add_i32(d1, d2));

    draw_ct_box(dc, main.font_bold, 280, 97, 112, 30, "+ New task", main.ctx.theme.accent_text, 1);
    draw_ct_box(dc, main.font_bold, 400, 97, 112, 30, "Complete all", main.ctx.theme.text, 1);
    draw_ct_box(dc, main.font_reg, 520, 97, 96, 30, "Remove last", main.ctx.theme.text_muted, 1);
    draw_ct_box(dc, main.font_reg, 624, 97, 80, 30, "Reset", main.ctx.theme.text_muted, 1);
    draw_ct_completed_stat(dc, main.font_reg, 724, 92, 260, 20, done_cnt, tot_cnt, main.ctx.theme.text);

    draw_native_tasks_empty(main);
    draw_native_task_row_text(main, 0, "Build the native backbuffer");
    draw_native_task_row_text(main, 1, "Render rounded components");
    draw_native_task_row_text(main, 2, "Connect the interactive controls");

    let list_rectangle: Rect = UiContext::previous_rect(&main.ctx, 36);
    let list_top: i32 = add_i32(list_rectangle.y as i32, 8);
    let f0_col: i32 = select_i32(main.model.list_filter == 0, main.ctx.theme.accent_text, main.ctx.theme.text);
    let f1_col: i32 = select_i32(main.model.list_filter == 1, main.ctx.theme.accent_text, main.ctx.theme.text);
    draw_ct_box(dc, main.font_bold, 282, list_top, 300, 24, "Records", main.ctx.theme.text, 0);
    draw_ct_box(dc, main.font_bold, 596, list_top, 88, 24, "All", f0_col, 1);
    draw_ct_box(dc, main.font_bold, 690, list_top, 96, 24, "Starred", f1_col, 1);
    draw_ct_box(dc, main.font_reg, 792, list_top, 92, 24, "Next 100", main.ctx.theme.text, 1);
    draw_ct_box(dc, main.font_reg, 890, list_top, 100, 24, "Jump 5000", main.ctx.theme.accent, 1);

    draw_native_virtual_rows(main);
}

machine draw_native_synth_header(main: &Main, identifier: i32, title: &[u8], color: i32, value: i32) reaches WindowsGuiHost {
    let rectangle: Rect = UiContext::previous_rect(&main.ctx, identifier);
    let header: Rect = GalleryUi::card_header(&rectangle);
    draw_ct_box(main, main.font_bold, add_i32(header.x as i32, 34), header.y as i32, max_i32(sub_i32(header.w as i32, 34), 0), header.h as i32, title, color, 0);
    draw_ct_pct_box(main, main.font_hero, header.x as i32, add_i32(rectangle.y as i32, 40), 100, 24, value, main.ctx.theme.text, 0);
}

