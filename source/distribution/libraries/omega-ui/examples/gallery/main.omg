machine draw_ct_clicks_badge(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, val: i32, rgb: i32)
reaches WindowsGuiHost {
    let v: i32 = clamp_i32(val, 0, 999);
    transition v >= 100 {
        true -> c3(main, font, x, y, w, h, v, rgb)
        _ -> check_c2(main, font, x, y, w, h, v, rgb)
    }
    state c3(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32) {
        let mut buf: [u8; 10] = "000 clicks";
        buf[0] = (48 + ((v / 100) % 10)) as u8;
        buf[1] = (48 + ((v / 10) % 10)) as u8;
        buf[2] = (48 + (v % 10)) as u8;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, 1);
    }
    state check_c2(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32) {
        transition v >= 10 {
            true -> c2(main, font, x, y, w, h, v, rgb)
            _ -> c1(main, font, x, y, w, h, v, rgb)
        }
    }
    state c2(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32) {
        let mut buf: [u8; 9] = "00 clicks";
        buf[0] = (48 + ((v / 10) % 10)) as u8;
        buf[1] = (48 + (v % 10)) as u8;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, 1);
    }
    state c1(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, v: i32, rgb: i32) {
        let mut buf: [u8; 8] = "0 clicks";
        buf[0] = (48 + (v % 10)) as u8;
        draw_ct_box(main, font, x, y, w, h, &buf, rgb, 1);
    }
}

machine draw_ct_completed_stat(main: &Main, font: u64, x: i32, y: i32, w: i32, h: i32, done_cnt: i32, tot_cnt: i32, rgb: i32)
reaches WindowsGuiHost {
    let d: i32 = clamp_i32(done_cnt, 0, 9);
    let t: i32 = clamp_i32(tot_cnt, 0, 9);
    let mut buf: [u8; 17] = "Completed: 0 of 0";
    buf[11] = (48 + (d % 10)) as u8;
    buf[16] = (48 + (t % 10)) as u8;
    draw_ct_box(main, font, x, y, w, h, &buf, rgb, 0);
}

