// Render a semantic label ID by dispatching to `draw_str` (only in 64x64 mode; ClearType handles window text).
public machine draw_label(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
    transition band_y < 0 {
        true -> dispatch_lbl(pixels, band_y, x, y, label_id, color)
        _ -> done()
    }
    machine dispatch_lbl(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id <= 6 {
            true -> low_lbl(pixels, band_y, x, y, label_id, color)
            _ -> high_lbl(pixels, band_y, x, y, label_id, color)
        }
    }
    machine low_lbl(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 1 {
            true -> l1(pixels, band_y, x, y, color)
            _ -> low2(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l1(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str_bold(pixels, band_y, x, y, "Omega UI", color);
    }
    machine low2(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 2 {
            true -> l2(pixels, band_y, x, y, color)
            _ -> low4(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l2(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "Advance Command Request", color);
    }
    machine low4(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 4 {
            true -> l4(pixels, band_y, x, y, color)
            _ -> low5(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l4(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "Workspaces", color);
    }
    machine low5(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 5 {
            true -> l5(pixels, band_y, x, y, color)
            _ -> l6(pixels, band_y, x, y, color)
        }
    }
    machine l5(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "Pull main and advance", color);
    }
    machine l6(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "Runtime trajectory", color);
    }
    machine high_lbl(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 7 {
            true -> l7(pixels, band_y, x, y, color)
            _ -> high9(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l7(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "Omega 05 RegAlloc", color);
    }
    machine high9(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 9 {
            true -> l9(pixels, band_y, x, y, color)
            _ -> high10(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l9(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "Token Stream", color);
    }
    machine high10(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 10 {
            true -> l10(pixels, band_y, x, y, color)
            _ -> high11(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l10(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "Harness controls", color);
    }
    machine high11(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 11 {
            true -> l11(pixels, band_y, x, y, color)
            _ -> high13(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l11(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str_bold(pixels, band_y, x, y, "To-dos", color);
    }
    machine high13(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 13 {
            true -> l13(pixels, band_y, x, y, color)
            _ -> high14(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l13(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str_bold(pixels, band_y, x, y, "Compiler Stage Load", color);
    }
    machine high14(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 14 {
            true -> l14(pixels, band_y, x, y, color)
            _ -> high16(pixels, band_y, x, y, label_id, color)
        }
    }
    machine l14(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str_bold(pixels, band_y, x, y, "Worker Threads", color);
    }
    machine high16(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, label_id: i32, color: i32) {
        transition label_id == 16 {
            true -> l16(pixels, band_y, x, y, color)
            _ -> l33(pixels, band_y, x, y, color)
        }
    }
    machine l16(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str(pixels, band_y, x, y, "More", color);
    }
    machine l33(pixels: &mut [i32; 4096], band_y: i32, x: i32 in Saturating, y: i32 in Saturating, color: i32) {
        omega_ui::raster::draw_str_bold(pixels, band_y, x, y, "Arena Memory Usage", color);
    }
    machine done() {}
}

public machine dot_cell_color(context: &UiContext, node_index: i32, y_off: i32 in Saturating, bottom_pad: i32 in Saturating, py: i32 in Saturating, color: i32) -> i32
requires node_index >= 0 && node_index < 128 && color >= 0 && color < 72 {
    let nr: Rect = omega_ui::context::paint_rect(context, node_index);
    let ix: i32 in Saturating = nr.x + (18 as i32 in Saturating);
    let iy: i32 in Saturating = nr.y + y_off + (8 as i32 in Saturating);
    let ih: i32 in Saturating = max_sat(nr.h - (y_off + bottom_pad + (16 as i32 in Saturating)), 6);
    let rows: i32 in Saturating = (ih + (2 as i32 in Saturating)) / (6 as i32 in Saturating);
    let rel_y: i32 in Saturating = py - iy;
    let row_from_bottom: i32 in Saturating = (rows - (1 as i32 in Saturating)) - (rel_y / (6 as i32 in Saturating));

    let packed_val: i32 in Saturating = context.nodes[node_index].content_value;
    let packed_aux: i32 in Saturating = context.nodes[node_index].aux_value;
    let series_col: i32 = context.nodes[node_index].content_color;
    let aux_col: i32 = context.nodes[node_index].aux_color;

    let primary_val: i32 in Saturating = packed_val % (1000 as i32 in Saturating);
    let sub_val: i32 in Saturating = packed_aux % (100 as i32 in Saturating);
    let phase: i32 in Saturating = packed_aux / (100 as i32 in Saturating);
    let col_s: i32 in Saturating = color as i32 in Saturating;

    let t: i32 in Saturating = (col_s + phase) % (16 as i32 in Saturating);
    let wave1: i32 in Saturating = select_sat(t < 8, t * (3 as i32 in Saturating), ((16 as i32 in Saturating) - t) * (3 as i32 in Saturating)) - (10 as i32 in Saturating);
    let wave2: i32 in Saturating = ((col_s * (5 as i32 in Saturating) + phase) % (11 as i32 in Saturating)) - (5 as i32 in Saturating);
    let tot_pct: i32 in Saturating = clamp_sat(primary_val + wave1 + wave2, 12, 96);
    let sub_pct: i32 in Saturating = clamp_sat(sub_val + (wave2 / (2 as i32 in Saturating)), 6, tot_pct - (4 as i32 in Saturating));

    let total_dots: i32 in Saturating = (tot_pct * rows + (50 as i32 in Saturating)) / (100 as i32 in Saturating);
    let bottom_dots: i32 in Saturating = (sub_pct * rows + (50 as i32 in Saturating)) / (100 as i32 in Saturating);

    let is_bottom: bool = row_from_bottom < bottom_dots;
    let is_top: bool = !is_bottom && row_from_bottom < total_dots;
    let raw_col: i32 = select_i32(is_bottom, aux_col, select_i32(is_top, series_col, context.theme.empty));

    let mx: i32 in Saturating = context.mouse_x as i32 in Saturating;
    let my: i32 in Saturating = context.mouse_y as i32 in Saturating;
    let in_well_x: bool = select_i32(mx >= ix, select_i32(mx < (nr.x + nr.w - (18 as i32 in Saturating)), 1, 0), 0) == 1;
    let in_well_y: bool = select_i32(my >= iy, select_i32(my < (iy + ih), 1, 0), 0) == 1;
    let hot_col: i32 in Saturating = (mx - ix) / (8 as i32 in Saturating);
    let is_lit: bool = row_from_bottom < total_dots;
    let dim: bool = select_i32(in_well_x, select_i32(in_well_y, select_i32(hot_col != col_s, select_i32(is_lit, 1, 0), 0), 0), 0) == 1;
    select_i32(dim, color_mix(context.theme.well, raw_col, 48), raw_col)
}

public machine draw_node_dots_well(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32, y_off: i32 in Saturating, bottom_pad: i32 in Saturating)
requires node_index >= 0 && node_index < 128 {
    let rectangle: Rect = omega_ui::context::paint_rect(context, node_index);
    let well_r: Rect = Rect {
        x: rectangle.x + (12 as i32 in Saturating),
        y: rectangle.y + y_off,
        w: max_sat(rectangle.w - (24 as i32 in Saturating), 40),
        h: max_sat(rectangle.h - (y_off + bottom_pad), 24)
    };
    let well_y: i32 in Saturating = well_r.y;
    let well_h: i32 in Saturating = well_r.h;
    omega_ui::raster::draw_box_band(pixels, band_y, well_r, context.theme.well, context.theme.border, 1, 6);

    let is_64: bool = band_y < 0;
    let cw: i32 in Saturating = omega_ui::raster::band_width(pixels, band_y);
    let ch: i32 in Saturating = omega_ui::raster::band_height(pixels, band_y);
    transition !is_64 && ch > 0 {
        true -> check_row(pixels, band_y, context, node_index, y_off, bottom_pad, well_y, well_h, cw, ch)
        _ -> done()
    }
    machine check_row(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32, y_off: i32 in Saturating, bottom_pad: i32 in Saturating, well_y: i32 in Saturating, well_h: i32 in Saturating, cw: i32 in Saturating, ch: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 && ch > 0 {
        let ly: i32 in Saturating = ((band_y as i32 in Saturating) * (672 as i32 in Saturating)) / ch;
        let iy: i32 in Saturating = well_y + (8 as i32 in Saturating);
        let ih: i32 in Saturating = max_sat(well_h - (14 as i32 in Saturating), 0);
        let rows: i32 in Saturating = (ih + (2 as i32 in Saturating)) / (6 as i32 in Saturating);
        let rel_y: i32 in Saturating = ly - iy;
        let sub_y: i32 in Saturating = rel_y % (6 as i32 in Saturating);
        let in_dot_y: bool = rel_y >= 0 && ly < (iy + rows * (6 as i32 in Saturating)) && sub_y < 4;
        transition in_dot_y {
            true -> loop_cols(pixels, band_y, context, node_index, y_off, bottom_pad, ly, cw, 0)
            _ -> done()
        }
    }
    machine loop_cols(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32, y_off: i32 in Saturating, bottom_pad: i32 in Saturating, ly: i32 in Saturating, cw: i32 in Saturating, color: i32)
    requires node_index >= 0 && node_index < 128 {
        let iw: i32 in Saturating = max_sat(omega_ui::context::paint_rect(context, node_index).w - (36 as i32 in Saturating), 0);
        let cols: i32 = ((iw + (2 as i32 in Saturating)) / (8 as i32 in Saturating)) as i32;
        transition color >= 0 && color < cols && color < 72 {
            true -> plot_col(pixels, band_y, context, node_index, y_off, bottom_pad, ly, cw, color)
            _ -> done()
        }
    }
    machine plot_col(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32, y_off: i32 in Saturating, bottom_pad: i32 in Saturating, ly: i32 in Saturating, cw: i32 in Saturating, color: i32)
    requires node_index >= 0 && node_index < 128 && color >= 0 && color < 72 {
        let dot_col: i32 = painting::dot_cell_color(context, node_index, y_off, bottom_pad, ly, color);
        let nr: Rect = omega_ui::context::paint_rect(context, node_index);
        let dx: i32 in Saturating = nr.x + (18 as i32 in Saturating) + ((color as i32 in Saturating) * (8 as i32 in Saturating));
        let px0: i32 in Saturating = omega_ui::raster::to_physical_x(dx, cw, false, 1024);
        let px1: i32 in Saturating = omega_ui::raster::to_physical_x(dx + (5 as i32 in Saturating), cw, false, 1024);
        omega_ui::raster::hline_raw(pixels, band_y, band_y as i32 in Saturating, px0, px1, dot_col);
        transition { _ -> loop_cols(pixels, band_y, context, node_index, y_off, bottom_pad, ly, cw, color + 1) }
    }
    machine done() {}
}


public machine render_sidebar_item(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32)
requires node_index >= 0 && node_index < 128 {}

public machine header_top_row(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect, lbl: i32, paused: bool) {
    painting::draw_label(pixels, band_y, rectangle.x + (4 as i32 in Saturating), rectangle.y + (5 as i32 in Saturating), lbl, context.theme.text);

    let pause_x: i32 in Saturating = rectangle.x + rectangle.w - (36 as i32 in Saturating);
    let pause_r: Rect = Rect { x: pause_x, y: rectangle.y + (2 as i32 in Saturating), w: 32, h: 24 };
    omega_ui::raster::draw_box_band(pixels, band_y, pause_r, context.theme.surface, context.theme.border, 1, 6);
}

public machine header_tab_row(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect, active_page: i32) {
    let track: Rect = Rect { x: rectangle.x, y: rectangle.y + (26 as i32 in Saturating), w: 448, h: 32 };
    omega_ui::raster::draw_box_band(pixels, band_y, track, context.theme.well, context.theme.border, 1, 12);
    let progress: i32 in Saturating = clamp_i32(active_page, 0, 1000) as i32 in Saturating;
    let ind_x: i32 in Saturating = rectangle.x + (4 as i32 in Saturating) + progress * (352 as i32 in Saturating) / (1000 as i32 in Saturating);
    let ind_r: Rect = Rect { x: ind_x, y: rectangle.y + (30 as i32 in Saturating), w: 84, h: 24 };
    omega_ui::raster::draw_box_band(pixels, band_y, ind_r, context.theme.surface, context.theme.border, 1, 9);
}

public machine render_header_bar(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32)
requires node_index >= 0 && node_index < 128 {
    let r1: Rect = omega_ui::context::paint_rect(context, node_index);
    let r2: Rect = omega_ui::context::paint_rect(context, node_index);
    let packed_state: i32 = context.nodes[node_index].content_value as i32;
    let active_page: i32 = context.nodes[node_index].aux_value as i32;
    let lbl: i32 = context.nodes[node_index].label_id;
    let paused: bool = (packed_state % 10) == 1;

    painting::header_top_row(pixels, band_y, context, r1, lbl, paused);
    painting::header_tab_row(pixels, band_y, context, r2, active_page);
}

public machine sidebar_nav_ws(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect) {
    let r_plug: Rect = Rect { x: rectangle.x + (8 as i32 in Saturating), y: rectangle.y + (4 as i32 in Saturating), w: 14, h: 14 };
    omega_ui::raster::draw_icon_band(pixels, band_y, r_plug, 2, context.theme.text_muted);

    let r_auto: Rect = Rect { x: rectangle.x + (8 as i32 in Saturating), y: rectangle.y + (28 as i32 in Saturating), w: 14, h: 14 };
    omega_ui::raster::draw_icon_band(pixels, band_y, r_auto, 3, context.theme.text_muted);

    let r_fld: Rect = Rect { x: rectangle.x + (8 as i32 in Saturating), y: rectangle.y + (81 as i32 in Saturating), w: 14, h: 14 };
    omega_ui::raster::draw_icon_band(pixels, band_y, r_fld, 4, context.theme.text_muted);
}

public machine render_sidebar_label(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32)
requires node_index >= 0 && node_index < 128 {
    let rectangle: Rect = omega_ui::context::paint_rect(context, node_index);
    let kind_mode: i32 = context.nodes[node_index].content_value as i32;
    transition kind_mode == 0 {
        true -> brand(pixels, band_y, context, rectangle)
        _ -> check_m1(pixels, band_y, context, rectangle, kind_mode)
    }
    machine brand(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect) {
        let chip_w: i32 in Saturating = omega_ui::raster::isotropic_width(context, 22);
        let r_box: Rect = Rect { x: rectangle.x + (4 as i32 in Saturating), y: rectangle.y + (6 as i32 in Saturating), w: chip_w, h: 22 };
        omega_ui::raster::draw_box_fill(pixels, band_y, r_box, context.theme.text, 8);
    }
    machine check_m1(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect, kind_mode: i32) {
        transition kind_mode == 1 {
            true -> nav_and_ws(pixels, band_y, context, rectangle)
            _ -> check_m2(pixels, band_y, context, rectangle, kind_mode)
        }
    }
    machine nav_and_ws(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect) {
        painting::sidebar_nav_ws(pixels, band_y, context, rectangle);
    }
    machine check_m2(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect, kind_mode: i32) {
        transition kind_mode == 2 {
            true -> lower_ws(pixels, band_y, context, rectangle)
            _ -> check_m3(pixels, band_y, context, rectangle, kind_mode)
        }
    }
    machine lower_ws(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect) {
        let r_f1: Rect = Rect { x: rectangle.x + (8 as i32 in Saturating), y: rectangle.y + (7 as i32 in Saturating), w: 14, h: 14 };
        omega_ui::raster::draw_icon_band(pixels, band_y, r_f1, 4, context.theme.text_muted);

        let r_f2: Rect = Rect { x: rectangle.x + (8 as i32 in Saturating), y: rectangle.y + (29 as i32 in Saturating), w: 14, h: 14 };
        omega_ui::raster::draw_icon_band(pixels, band_y, r_f2, 4, context.theme.text_muted);
    }
    machine check_m3(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect, kind_mode: i32) {
        transition kind_mode == 3 {
            true -> new_sess_btn()
            _ -> footer_row(pixels, band_y, context, rectangle)
        }
    }
    machine new_sess_btn() {}
    machine footer_row(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, rectangle: Rect) {}
}

public machine render_metric_tile(pixels: &mut [i32; 4096], band_y: i32, context: &UiContext, node_index: i32)
requires node_index >= 0 && node_index < 128 {
    let rectangle: Rect = omega_ui::context::paint_rect(context, node_index);
    let packed_val: i32 = context.nodes[node_index].content_value as i32;
    let series_col: i32 = context.nodes[node_index].content_color;
    let icon_id: i32 = (packed_val / 1000) % 16;

    let header: Rect = view::card_header(&rectangle);
    omega_ui::raster::draw_chip(pixels, band_y, header.x, header.y, header.h, icon_id, context.theme.surface, series_col, false);
}

