use context.omg;
use types.omg;


// Text editing backends provide logical selection offsets; every renderer uses
// this geometry, including reverse selections and a separately positioned caret.
use raster.omg;

public data UiTextSelection [copy] {
    left: i32;
    right: i32;
    caret: i32;
    focused: bool;
}
public machine paint_selection(pixels: &mut [i32; 4096], band_y: i32, ui_context: &|context|::UiContext, bounds: |types|::Rect, selection: UiTextSelection) {
    let left: i32 in Saturating = |types|::clamp_sat(|types|::min_i32(selection.left, selection.right) as i32 in Saturating, 0, bounds.w);
    let right: i32 in Saturating = |types|::clamp_sat(|types|::max_i32(selection.left, selection.right) as i32 in Saturating, 0, bounds.w);
    let highlight: |types|::Rect = |types|::Rect { x: bounds.x + left, y: bounds.y, w: right - left, h: bounds.h };
    |raster|::draw_box_fill(pixels, band_y, highlight, |types|::color_mix(ui_context.theme.surface, ui_context.theme.accent, 24), 2);
    transition selection.focused {
        true -> caret(pixels, band_y, ui_context, bounds, selection.caret)
        _ -> done()
    }
    machine caret(pixels: &mut [i32; 4096], band_y: i32, ui_context: &|context|::UiContext, bounds: |types|::Rect, caret: i32) {
        let cursor: |types|::Rect = |types|::Rect { x: bounds.x + |types|::clamp_sat(caret as i32 in Saturating, 0, bounds.w), y: bounds.y, w: 1, h: bounds.h };
        |raster|::draw_box_fill(pixels, band_y, cursor, ui_context.theme.text, 0);
    }
    machine done() {}
}
