use types.omg;


/*
Uniform lists retain scroll position in pixels and construct only the visible
range plus requested overscan. Item indices remain stable when the viewport
changes. Bounds use saturating arithmetic; an empty or invalid list has no rows.
The caller paints or builds rows inside the same viewport clip.
*/

public data UiListRange [copy] {
    first: i32;
    end: i32;
    scroll: i32;
    stride: i32;
    leading: i32;
    trailing: i32;
}

public machine visible(count: i32, row_height: i32, gap: i32, viewport_height: i32, scroll: i32, overscan: i32) -> UiListRange {
    let stride: i32 = |types|::max_i32(|types|::add_i32(row_height, |types|::max_i32(gap, 0)), 1);
    transition count > 0 && row_height > 0 && viewport_height > 0 && stride > 0 {
        true -> calculate(count, |types|::max_i32(gap, 0), viewport_height, scroll, |types|::clamp_i32(overscan, 0, 128), stride)
        _ -> (UiListRange { first: 0, end: 0, scroll: 0, stride: stride, leading: 0, trailing: 0 })
    }
    machine calculate(count: i32, gap: i32, viewport_height: i32, scroll: i32, overscan: i32, stride: i32) -> UiListRange
    requires stride > 0 {
        let extent: i32 = |types|::max_i32(|types|::sub_i32(|types|::mul_i32(count, stride), gap), 0);
        let position: i32 = |types|::clamp_i32(scroll, 0, |types|::max_i32(|types|::sub_i32(extent, viewport_height), 0));
        let first: i32 = |types|::max_i32(|types|::sub_i32(position / stride, overscan), 0);
        let end: i32 = |types|::min_i32(|types|::add_i32(|types|::add_i32(|types|::add_i32(position, viewport_height), |types|::sub_i32(stride, 1)) / stride, overscan), count);
        UiListRange { first: first, end: end, scroll: position, stride: stride,
            leading: |types|::mul_i32(first, stride), trailing: |types|::max_i32(|types|::sub_i32(extent, |types|::mul_i32(end, stride)), 0) }
    }
}

public machine row_y(range: &UiListRange, index: i32) -> i32 {
    |types|::sub_i32(|types|::mul_i32(index, range.stride), range.scroll)
}
