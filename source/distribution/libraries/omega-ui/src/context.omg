module context;

use motion::UiMotion;
use palette::ThemePalette;
use text::UiTextSpan;
use text::UiTextStore;
use types::Rect;
use types::Size;
use types::Style;
use types::Theme;
use types::UiAlignment;
use types::UiAxis;
use types::UiContentKind;
use types::UiJustify;
use types::UiSizing;
use types::clamp_i32;
use types::max_sat;
use types::select_i32;
use types::select_sat;
use types::sub_i32;


// Owns frame-local nodes, prior-frame hit rectangles, keyboard focus, and two-pass layout.

use types;
use motion;
use palette;
use text;

public data Interaction {
    id: i32;
    hovered: bool;
    pressed: bool;
    clicked: bool;
    focused: bool;
    relative_x: i32 in Saturating;
    rectangle_width: i32 in Saturating;
}

public data UiNode {
    id: i32;
    parent: i32; // -1 marks a root or unused slot; slot zero is a valid node.
    child_count: i32 in Saturating;
    first_child: i32;
    last_child: i32;
    next_sibling: i32;
    style: Style;
    content_kind: i32; // Core tags are 0..6, 18 (number field), and 19 (host text).
    content_value: i32 in Saturating;
    content_color: i32;
    aux_value: i32 in Saturating;
    aux_color: i32;
    label_id: i32;
    text: UiTextSpan;
    text_align: i32;
    interactive: bool;
    measured: Size;
    intrinsic: Size;
    text_measured: bool;
    rect: Rect;
}

public machine node_empty() -> UiNode {
    UiNode {
        id: 0,
        parent: -1,
        child_count: 0,
        first_child: -1,
        last_child: -1,
        next_sibling: -1,
        style: types::style_default_box(),
        content_kind: 0,
        content_value: 0,
        content_color: -1,
        aux_value: 0,
        aux_color: -1,
        label_id: 0,
        text: UiTextSpan { offset: 0, length: 0, generation: 0 },
        text_align: 0,
        interactive: false,
        measured: Size { w: 0, h: 0 },
        intrinsic: Size { w: 0, h: 0 },
        text_measured: false,
        rect: types::rect_zero()
    }
}

public data UiContext {
    theme: Theme;
    motion: UiMotion;
    text_store: UiTextStore;
    width: i32 in Saturating;
    height: i32 in Saturating;
    frame: i32 in Saturating;

    mouse_x: i32;
    mouse_y: i32;
    mouse_down: bool;
    mouse_pressed: bool;
    mouse_released: bool;
    key_code: i32;

    hot: i32; // Control ID, not a node slot; zero means no control.
    active: i32;
    focus: i32;
    focus_visible: bool;
    changed: bool;
    frame_error: i32; // 1: capacity, 2: nesting, 3: parent, 4: unbalanced, 5: font metrics, 6: unstable view, 7: reserved extension tag.
    rejected_containers: i32 in Saturating;
    accent_index: i32;
    aspect_pct: i32;

    nodes: [UiNode; 128];
    node_count: i32;
    stack: [i32; 8];
    stack_len: i32;

    hit_ids: [i32; 128];
    hit_rects: [Rect; 128];
    hit_count: i32;
}

public machine new(width: i32 in Saturating, height: i32 in Saturating) -> UiContext {
    let mut ui_context: UiContext;
    context::setup(&mut ui_context, width as i32, height as i32, true);
    ui_context
}

public machine set_accent(ui_context: &mut UiContext, requested_accent_index: i32) {
    let accent_index: i32 = clamp_i32(requested_accent_index, 0, 7);
    ui_context.accent_index = accent_index;
    let resolved_palette: ThemePalette = palette::resolve(ui_context.theme.is_dark, accent_index);
    ui_context.theme = palette::to_theme(&resolved_palette, ui_context.theme.is_dark);
}

public machine set_theme(ui_context: &mut UiContext, dark: bool) {
    ui_context.accent_index = clamp_i32(ui_context.accent_index, 0, 7);
    let resolved_palette: ThemePalette = palette::resolve(dark, ui_context.accent_index);
    ui_context.theme = palette::to_theme(&resolved_palette, dark);
}

public machine setup(ui_context: &mut UiContext, width: i32, height: i32, dark: bool) {
    let animation: UiMotion;
    ui_context.motion = animation;
    // Reinitialization retires earlier spans and scenes from this ui_context.
    text::begin_frame(&mut ui_context.text_store);
    ui_context.width = width as i32 in Saturating;
    ui_context.height = height as i32 in Saturating;
    ui_context.frame = 0;
    ui_context.mouse_x = -1;
    ui_context.mouse_y = -1;
    ui_context.mouse_down = false;
    ui_context.mouse_pressed = false;
    ui_context.mouse_released = false;
    ui_context.key_code = 0;
    ui_context.hot = 0;
    ui_context.active = 0;
    ui_context.focus = 0;
    ui_context.focus_visible = false;
    ui_context.changed = false;
    ui_context.frame_error = 0;
    ui_context.rejected_containers = 0;
    ui_context.accent_index = 0;
    ui_context.aspect_pct = 1000;
    ui_context.node_count = 0;
    ui_context.stack_len = 0;
    ui_context.hit_count = 0;
    context::set_theme(ui_context, dark);
}

// Copy the scalar fields of `context.nodes[node_index].rect` without moving out of borrowed storage.
public machine node_rect(ui_context: &UiContext, node_index: i32) -> Rect
requires node_index >= 0 && node_index < 128 {
    Rect {
        x: ui_context.nodes[node_index].rect.x,
        y: ui_context.nodes[node_index].rect.y,
        w: ui_context.nodes[node_index].rect.w,
        h: ui_context.nodes[node_index].rect.h
    }
}

// Copy the scalar fields of `context.hit_rects[hit_index]` without moving out of borrowed storage.
public machine hit_rect(ui_context: &UiContext, hit_index: i32) -> Rect
requires hit_index >= 0 && hit_index < 128 {
    Rect {
        x: ui_context.hit_rects[hit_index].x,
        y: ui_context.hit_rects[hit_index].y,
        w: ui_context.hit_rects[hit_index].w,
        h: ui_context.hit_rects[hit_index].h
    }
}

public machine update_hot(ui_context: &mut UiContext) {
    ui_context.hot = 0;
    transition { _ -> loop_hits(ui_context, 0) }

    machine loop_hits(ui_context: &mut UiContext, hit_index: i32) {
        transition hit_index >= 0 && hit_index < ui_context.hit_count && hit_index < 128 {
            true -> check_one(ui_context, hit_index)
            _ -> done()
        }
    }
    machine check_one(ui_context: &mut UiContext, hit_index: i32)
    requires hit_index >= 0 && hit_index < 128 {
        let r: Rect = context::hit_rect(ui_context, hit_index);
        let inside: bool = types::rect_contains(&r, ui_context.mouse_x, ui_context.mouse_y);
        transition inside {
            true -> mark_hot(ui_context, hit_index)
            _ -> loop_hits(ui_context, hit_index + 1)
        }
    }
    machine mark_hot(ui_context: &mut UiContext, hit_index: i32)
    requires hit_index >= 0 && hit_index < 128 {
        ui_context.hot = ui_context.hit_ids[hit_index];
        transition { _ -> loop_hits(ui_context, hit_index + 1) }
    }
    machine done() {}
}

public machine begin_frame(ui_context: &mut UiContext) {
    text::begin_frame(&mut ui_context.text_store);
    context::update_hot(ui_context);
    transition ui_context.mouse_pressed {
        true -> on_press(ui_context)
        _ -> after_press(ui_context)
    }
    machine on_press(ui_context: &mut UiContext) {
        ui_context.active = ui_context.hot;
        ui_context.focus = ui_context.hot;
        ui_context.focus_visible = false;
        transition { _ -> after_press(ui_context) }
    }
    machine after_press(ui_context: &mut UiContext) {
        ui_context.changed = false;
        ui_context.frame_error = 0;
        ui_context.rejected_containers = 0;
        ui_context.node_count = 1;
        ui_context.stack_len = 1;

        let mut root_style: Style = types::style_default_box();
        root_style.direction = UiAxis::Row; // row root
        root_style.width_mode = UiSizing::Fixed;
        root_style.width_px = ui_context.width;
        root_style.height_mode = UiSizing::Fixed;
        root_style.height_px = ui_context.height;
        root_style.background = ui_context.theme.background;

        ui_context.nodes[0] = UiNode {
            id: 1,
            parent: -1,
            child_count: 0,
            first_child: -1,
            last_child: -1,
            next_sibling: -1,
            style: root_style,
            content_kind: 0,
            content_value: 0,
            content_color: -1,
            aux_value: 0,
            aux_color: -1,
            label_id: 0,
            text: UiTextSpan { offset: 0, length: 0, generation: 0 },
            text_align: 0,
            interactive: false,
            measured: Size { w: ui_context.width, h: ui_context.height },
            intrinsic: Size { w: 0, h: 0 },
            text_measured: false,
            rect: Rect { x: 0, y: 0, w: ui_context.width, h: ui_context.height }
        };
        ui_context.stack[0] = 0;
    }
}

// Tab walks the previous frame's actual interactive nodes. A removed focus
// target starts at the appropriate edge; empty views clear focus.
public machine focus_next(ui_context: &mut UiContext, backward: bool) {
    transition { _ -> scan(ui_context, backward, 0, 0, 0, 0) }
    machine scan(ui_context: &mut UiContext, backward: bool, index: i32, first: i32, previous: i32, target: i32) {
        transition index >= 0 && index < ui_context.hit_count && index < 128 {
            true -> visit(ui_context, backward, index, first, previous, target)
            _ -> finish(ui_context, backward, first, previous, target)
        }
    }
    machine visit(ui_context: &mut UiContext, backward: bool, index: i32, first: i32, previous: i32, target: i32)
    requires index >= 0 && index < 128 {
        let identifier: i32 = ui_context.hit_ids[index];
        transition identifier != 0 {
            true -> consider(ui_context, backward, index, first, previous, target, identifier)
            _ -> scan(ui_context, backward, index + 1, first, previous, target)
        }
    }
    machine consider(ui_context: &mut UiContext, backward: bool, index: i32, first: i32, previous: i32, target: i32, identifier: i32)
    requires index >= 0 && index < 128 {
        let first_identifier: i32 = select_i32(first == 0, identifier, first);
        let follows_focus: bool = previous == ui_context.focus && ui_context.focus != 0;
        let precedes_focus: bool = identifier == ui_context.focus;
        let candidate: i32 = select_i32(backward, previous, identifier);
        let matched: bool = select_i32(backward, select_i32(precedes_focus, 1, 0), select_i32(follows_focus, 1, 0)) == 1;
        let next_target: i32 = select_i32(target == 0 && matched, candidate, target);
        transition { _ -> scan(ui_context, backward, index + 1, first_identifier, identifier, next_target) }
    }
    machine finish(ui_context: &mut UiContext, backward: bool, first: i32, last: i32, target: i32) {
        let wrapped: i32 = select_i32(backward, last, first);
        ui_context.focus = select_i32(target != 0, target, wrapped);
        ui_context.focus_visible = ui_context.focus != 0;
    }
}

// Button-like controls consume a staged key press through the same activation
// result as the pointer. The host stages edges; end_frame consumes the key.
public machine activate(ui_context: &mut UiContext, node_index: i32, identifier: i32) -> Interaction {
    let interaction: Interaction = context::interact(ui_context, node_index, identifier);
    let keyboard: bool = interaction.id != 0 && interaction.focused && (ui_context.key_code == 13 || ui_context.key_code == 32);
    Interaction {
        id: interaction.id,
        hovered: interaction.hovered,
        pressed: interaction.pressed || keyboard,
        clicked: interaction.clicked || keyboard,
        focused: interaction.focused,
        relative_x: interaction.relative_x,
        rectangle_width: interaction.rectangle_width
    }
}

public machine set_node_meta(ui_context: &mut UiContext, node_index: i32, aux_value: i32, aux_color: i32, label_id: i32) {
    transition node_index >= 0 && node_index < 128 {
        true -> apply(ui_context, node_index, aux_value, aux_color, label_id)
        _ -> done()
    }
    machine apply(ui_context: &mut UiContext, node_index: i32, aux_value: i32, aux_color: i32, label_id: i32)
    requires node_index >= 0 && node_index < 128 {
        ui_context.nodes[node_index].aux_value = aux_value as i32 in Saturating;
        ui_context.nodes[node_index].aux_color = aux_color;
        ui_context.nodes[node_index].label_id = label_id;
    }
    machine done() {}
}

public machine add_node(ui_context: &mut UiContext, id: i32, style: Style, content: UiContentKind, content_value: i32, content_color: i32, interactive: bool, push_stack: bool) -> i32 {
    let content_kind: i32 = types::content_kind_code(content);
    ui_context.frame_error = select_i32(ui_context.frame_error == 0 && content_kind < 0, 7, ui_context.frame_error);
    transition ui_context.frame_error == 0 && ui_context.node_count >= 1 && ui_context.node_count < 128 && ui_context.stack_len >= 1 && ui_context.stack_len <= 8 && (!push_stack || ui_context.stack_len < 8) {
        true -> check_parent(ui_context, id, style, content_kind, content_value, content_color, interactive, push_stack)
        _ -> reject(ui_context, push_stack)
    }
    machine check_parent(ui_context: &mut UiContext, id: i32, style: Style, content_kind: i32, content_value: i32, content_color: i32, interactive: bool, push_stack: bool) -> i32
    requires ui_context.node_count >= 1 && ui_context.node_count < 128 && ui_context.stack_len >= 1 && ui_context.stack_len <= 8 {
        let top_slot: i32 = ui_context.stack_len - 1;
        let parent_idx: i32 = ui_context.stack[top_slot];
        transition parent_idx >= 0 && parent_idx < ui_context.node_count && parent_idx < 128 {
            true -> insert_node(ui_context, id, style, content_kind, content_value, content_color, interactive, push_stack, parent_idx)
            _ -> reject(ui_context, push_stack)
        }
    }
    machine insert_node(ui_context: &mut UiContext, id: i32, style: Style, content_kind: i32, content_value: i32, content_color: i32, interactive: bool, push_stack: bool, parent_idx: i32) -> i32
    requires ui_context.node_count >= 1 && ui_context.node_count < 128 && parent_idx >= 0 && parent_idx < 128 {
        let node_index: i32 = ui_context.node_count;
        let init_w: i32 in Saturating = style.width_px;
        let init_h: i32 in Saturating = style.height_px;
        ui_context.nodes[node_index] = UiNode {
            id: id,
            parent: parent_idx,
            child_count: 0,
            first_child: -1,
            last_child: -1,
            next_sibling: -1,
            style: style,
            content_kind: content_kind,
            content_value: content_value as i32 in Saturating,
            content_color: content_color,
            aux_value: 0,
            aux_color: -1,
            label_id: 0,
            text: UiTextSpan { offset: 0, length: 0, generation: 0 },
            text_align: 0,
            interactive: interactive,
            measured: Size { w: init_w, h: init_h },
            intrinsic: Size { w: 0, h: 0 },
            text_measured: false,
            rect: types::rect_zero()
        };
        ui_context.node_count = node_index + 1;
        ui_context.nodes[parent_idx].child_count = ui_context.nodes[parent_idx].child_count + (1 as i32 in Saturating);
        let previous: i32 = ui_context.nodes[parent_idx].last_child;
        ui_context.nodes[parent_idx].last_child = node_index;
        transition previous >= 0 && previous < 128 {
            true -> link(ui_context, previous, node_index, push_stack)
            _ -> first(ui_context, parent_idx, node_index, push_stack)
        }
    }
    machine link(ui_context: &mut UiContext, previous: i32, node_index: i32, push_stack: bool) -> i32
    requires previous >= 0 && previous < 128 {
        ui_context.nodes[previous].next_sibling = node_index;
        transition { _ -> maybe_push(ui_context, node_index, push_stack) }
    }
    machine first(ui_context: &mut UiContext, parent: i32, node_index: i32, push_stack: bool) -> i32
    requires parent >= 0 && parent < 128 {
        ui_context.nodes[parent].first_child = node_index;
        transition { _ -> maybe_push(ui_context, node_index, push_stack) }
    }
    machine maybe_push(ui_context: &mut UiContext, node_index: i32, push_stack: bool) -> i32 {
        transition push_stack && ui_context.stack_len >= 1 && ui_context.stack_len < 8 {
            true -> do_push(ui_context, node_index)
            _ -> (node_index)
        }
    }
    machine do_push(ui_context: &mut UiContext, node_index: i32) -> i32
    requires ui_context.stack_len >= 1 && ui_context.stack_len < 8 {
        let s: i32 = ui_context.stack_len;
        ui_context.stack[s] = node_index;
        ui_context.stack_len = s + 1;
        node_index
    }
    machine reject(ui_context: &mut UiContext, push_stack: bool) -> i32 {
        ui_context.frame_error = select_i32(ui_context.frame_error != 0, ui_context.frame_error,
            select_i32(ui_context.node_count >= 128, 1, select_i32(push_stack && ui_context.stack_len >= 8, 2, 3)));
        ui_context.rejected_containers = ui_context.rejected_containers + select_sat(push_stack, 1, 0);
        -1
    }
}

public machine end_container(ui_context: &mut UiContext) {
    transition ui_context.rejected_containers > 0 {
        true -> reject_pop(ui_context)
        _ -> accepted(ui_context)
    }
    machine reject_pop(ui_context: &mut UiContext) {
        ui_context.rejected_containers = ui_context.rejected_containers - (1 as i32 in Saturating);
    }
    machine accepted(ui_context: &mut UiContext) {
        transition ui_context.stack_len > 1 {
            true -> pop(ui_context)
            _ -> unbalanced(ui_context)
        }
    }
    machine unbalanced(ui_context: &mut UiContext) {
        ui_context.frame_error = select_i32(ui_context.frame_error == 0, 4, ui_context.frame_error);
    }
    machine pop(ui_context: &mut UiContext)
    requires ui_context.stack_len > 1 {
        ui_context.stack_len = ui_context.stack_len - 1;
    }
    machine done() {}
}

public machine previous_rect(ui_context: &UiContext, id: i32) -> Rect {
    transition { _ -> search(ui_context, id, 0) }

    machine search(ui_context: &UiContext, id: i32, hit_index: i32) -> Rect {
        transition hit_index >= 0 && hit_index < ui_context.hit_count && hit_index < 128 {
            true -> check(ui_context, id, hit_index)
            _ -> (types::rect_zero())
        }
    }
    machine check(ui_context: &UiContext, id: i32, hit_index: i32) -> Rect
    requires hit_index >= 0 && hit_index < 128 {
        transition ui_context.hit_ids[hit_index] == id {
            true -> (context::hit_rect(ui_context, hit_index))
            _ -> search(ui_context, id, hit_index + 1)
        }
    }
}

public machine interact(ui_context: &mut UiContext, node_idx: i32, id: i32) -> Interaction {
    transition node_idx > 0 && node_idx < ui_context.node_count && node_idx < 128 {
        true -> mark_interactive(ui_context, node_idx, id)
        _ -> invalid()
    }
    machine mark_interactive(ui_context: &mut UiContext, node_idx: i32, id: i32) -> Interaction
    requires node_idx >= 0 && node_idx < 128 {
        ui_context.nodes[node_idx].interactive = true;
        transition { _ -> compute(ui_context, id) }
    }
    machine compute(ui_context: &mut UiContext, id: i32) -> Interaction {
        let r: Rect = context::previous_rect(ui_context, id);
        let hovered: bool = id != 0 && ui_context.hot == id;
        let pressed: bool = id != 0 && ui_context.active == id && ui_context.mouse_down;
        let clicked: bool = id != 0 && ui_context.hot == id && ui_context.mouse_pressed;
        let focused: bool = id != 0 && ui_context.focus == id;
        let mx: i32 in Saturating = ui_context.mouse_x as i32 in Saturating;
        let relative_x: i32 in Saturating = mx - r.x;
        Interaction {
            id: id,
            hovered: hovered,
            pressed: pressed,
            clicked: clicked,
            focused: focused,
            relative_x: relative_x,
            rectangle_width: r.w
        }
    }
    machine invalid() -> Interaction {
        Interaction { id: 0, hovered: false, pressed: false, clicked: false,
            focused: false, relative_x: 0, rectangle_width: 0 }
    }
}

// Single-cycle 1D child measurement helper for node `node_index`.
public machine measure_children_of(ui_context: &UiContext, node_index: i32, dir: UiAxis) -> Size
requires node_index >= 0 && node_index < 128 {
    transition { _ -> loop_children(ui_context, node_index, dir, ui_context.nodes[node_index].first_child, 0, 0) }

    machine loop_children(ui_context: &UiContext, node_index: i32, dir: UiAxis, child: i32, cw: i32 in Saturating, ch: i32 in Saturating) -> Size {
        transition child >= 0 && child < ui_context.node_count && child < 128 {
            true -> check_one(ui_context, node_index, dir, child, cw, ch)
            _ -> (Size { w: cw, h: ch })
        }
    }
    machine check_one(ui_context: &UiContext, node_index: i32, dir: UiAxis, child: i32, cw: i32 in Saturating, ch: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        transition ui_context.nodes[child].parent == node_index {
            true -> branch_dir(ui_context, node_index, dir, child, cw, ch)
            _ -> loop_children(ui_context, node_index, dir, ui_context.nodes[child].next_sibling, cw, ch)
        }
    }
    machine branch_dir(ui_context: &UiContext, node_index: i32, dir: UiAxis, child: i32, cw: i32 in Saturating, ch: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        let mw: i32 in Saturating = ui_context.nodes[child].measured.w;
        let mh: i32 in Saturating = ui_context.nodes[child].measured.h;
        transition types::axis_is_row(dir) {
            true -> accum_row(ui_context, node_index, dir, child, cw + mw, ch, mh)
            _ -> accum_col(ui_context, node_index, dir, child, cw, mw, ch + mh)
        }
    }
    machine accum_row(ui_context: &UiContext, node_index: i32, dir: UiAxis, child: i32, ncw: i32 in Saturating, ch: i32 in Saturating, mh: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        transition mh > ch {
            true -> loop_children(ui_context, node_index, dir, ui_context.nodes[child].next_sibling, ncw, mh)
            _ -> loop_children(ui_context, node_index, dir, ui_context.nodes[child].next_sibling, ncw, ch)
        }
    }
    machine accum_col(ui_context: &UiContext, node_index: i32, dir: UiAxis, child: i32, cw: i32 in Saturating, mw: i32 in Saturating, nch: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        transition mw > cw {
            true -> loop_children(ui_context, node_index, dir, ui_context.nodes[child].next_sibling, mw, nch)
            _ -> loop_children(ui_context, node_index, dir, ui_context.nodes[child].next_sibling, cw, nch)
        }
    }
}

public machine measure_all(ui_context: &mut UiContext) {
    transition ui_context.node_count > 0 && ui_context.node_count <= 128 {
        true -> measure_loop(ui_context, ui_context.node_count - 1)
        _ -> done()
    }

    machine measure_loop(ui_context: &mut UiContext, node_index: i32) {
        transition node_index >= 0 && node_index < 128 {
            true -> measure_node(ui_context, node_index)
            _ -> done()
        }
    }
    machine measure_node(ui_context: &mut UiContext, node_index: i32)
    requires node_index >= 0 && node_index < 128 {
        let dir: UiAxis = ui_context.nodes[node_index].style.direction;
        let child_sum: Size = context::measure_children_of(ui_context, node_index, dir);
        let count: i32 in Saturating = ui_context.nodes[node_index].child_count;
        let gap: i32 in Saturating = ui_context.nodes[node_index].style.gap;
        let pad_w: i32 in Saturating = ui_context.nodes[node_index].style.padding.left + ui_context.nodes[node_index].style.padding.right;
        let pad_h: i32 in Saturating = ui_context.nodes[node_index].style.padding.top + ui_context.nodes[node_index].style.padding.bottom;
        let gaps: i32 in Saturating = max_sat(count - (1 as i32 in Saturating), 0);
        let gap_total: i32 in Saturating = gap * gaps;
        transition types::axis_is_row(dir) {
            true -> finish_measure(ui_context, node_index, child_sum.w + pad_w + gap_total, child_sum.h + pad_h)
            _ -> finish_measure(ui_context, node_index, child_sum.w + pad_w, child_sum.h + pad_h + gap_total)
        }
    }
    machine finish_measure(ui_context: &mut UiContext, node_index: i32, base_w: i32 in Saturating, base_h: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 {
        let has_text: bool = ui_context.nodes[node_index].text.length > 0u64;
        ui_context.frame_error = select_i32(ui_context.frame_error == 0 && has_text && !ui_context.nodes[node_index].text_measured, 5, ui_context.frame_error);
        let w_mode: UiSizing = ui_context.nodes[node_index].style.width_mode;
        let h_mode: UiSizing = ui_context.nodes[node_index].style.height_mode;
        ui_context.nodes[node_index].measured.w = select_sat(types::sizing_is_fixed(w_mode), ui_context.nodes[node_index].style.width_px, max_sat(base_w, ui_context.nodes[node_index].intrinsic.w));
        ui_context.nodes[node_index].measured.h = select_sat(types::sizing_is_fixed(h_mode), ui_context.nodes[node_index].style.height_px, max_sat(base_h, ui_context.nodes[node_index].intrinsic.h));
        transition { _ -> measure_loop(ui_context, node_index - 1) }
    }
    machine done() {}
}

// Single-cycle 1D helper returning Size { w: used_main, h: grow_total } for children of `node_index`.
public machine sum_main_children(ui_context: &UiContext, node_index: i32, is_row: bool) -> Size
requires node_index >= 0 && node_index < 128 {
    transition { _ -> loop_children(ui_context, node_index, is_row, ui_context.nodes[node_index].first_child, 0, 0) }

    machine loop_children(ui_context: &UiContext, node_index: i32, is_row: bool, child: i32, used: i32 in Saturating, grow_total: i32 in Saturating) -> Size {
        transition child >= 0 && child < ui_context.node_count && child < 128 {
            true -> check_child(ui_context, node_index, is_row, child, used, grow_total)
            _ -> (Size { w: used, h: grow_total })
        }
    }
    machine check_child(ui_context: &UiContext, node_index: i32, is_row: bool, child: i32, used: i32 in Saturating, grow_total: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        transition ui_context.nodes[child].parent == node_index {
            true -> step_axis(ui_context, node_index, is_row, child, used, grow_total)
            _ -> loop_children(ui_context, node_index, is_row, ui_context.nodes[child].next_sibling, used, grow_total)
        }
    }
    machine step_axis(ui_context: &UiContext, node_index: i32, is_row: bool, child: i32, used: i32 in Saturating, grow_total: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        transition is_row {
            true -> step_mode(ui_context, node_index, is_row, child, used, grow_total, ui_context.nodes[child].style.width_mode, ui_context.nodes[child].measured.w, ui_context.nodes[child].style.grow)
            _ -> step_mode(ui_context, node_index, is_row, child, used, grow_total, ui_context.nodes[child].style.height_mode, ui_context.nodes[child].measured.h, ui_context.nodes[child].style.grow)
        }
    }
    machine step_mode(ui_context: &UiContext, node_index: i32, is_row: bool, child: i32, used: i32 in Saturating, grow_total: i32 in Saturating, main_mode: UiSizing, main_meas: i32 in Saturating, cg: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        transition types::sizing_is_fill(main_mode) {
            true -> step_fill(ui_context, node_index, is_row, child, used, grow_total, cg)
            _ -> loop_children(ui_context, node_index, is_row, ui_context.nodes[child].next_sibling, used + main_meas, grow_total + cg)
        }
    }
    machine step_fill(ui_context: &UiContext, node_index: i32, is_row: bool, child: i32, used: i32 in Saturating, grow_total: i32 in Saturating, cg: i32 in Saturating) -> Size
    requires child >= 0 && child < 128 {
        transition cg > 0 {
            true -> loop_children(ui_context, node_index, is_row, ui_context.nodes[child].next_sibling, used, grow_total + cg)
            _ -> loop_children(ui_context, node_index, is_row, ui_context.nodes[child].next_sibling, used, grow_total + (1 as i32 in Saturating))
        }
    }
}

// Single-cycle 1D helper to arrange direct children of `node_index`.
public machine place_children_of(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, init_pos: i32 in Saturating, spacing: i32 in Saturating)
requires node_index >= 0 && node_index < 128 {
    transition { _ -> loop_children(ui_context, node_index, inner, free, grow_total, init_pos, spacing, ui_context.nodes[node_index].first_child) }

    machine loop_children(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32) {
        transition node_index >= 0 && node_index < 128 && child >= 0 && child < ui_context.node_count && child < 128 {
            true -> check_child(ui_context, node_index, inner, free, grow_total, pos, spacing, child)
            _ -> done()
        }
    }
    machine check_child(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32)
    requires node_index >= 0 && node_index < 128 && child >= 0 && child < 128 {
        transition ui_context.nodes[child].parent == node_index {
            true -> branch_axis(ui_context, node_index, inner, free, grow_total, pos, spacing, child)
            _ -> loop_children(ui_context, node_index, inner, free, grow_total, pos, spacing, ui_context.nodes[child].next_sibling)
        }
    }
    machine branch_axis(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32)
    requires node_index >= 0 && node_index < 128 && child >= 0 && child < 128 {
        let ih: i32 in Saturating = inner.h;
        let iw: i32 in Saturating = inner.w;
        transition types::axis_is_row(ui_context.nodes[node_index].style.direction) {
            true -> compute_main(ui_context, node_index, inner, free, grow_total, pos, spacing, child, true, ih, ui_context.nodes[child].style.width_mode, ui_context.nodes[child].style.height_mode, ui_context.nodes[child].measured.w, ui_context.nodes[child].measured.h)
            _ -> compute_main(ui_context, node_index, inner, free, grow_total, pos, spacing, child, false, iw, ui_context.nodes[child].style.height_mode, ui_context.nodes[child].style.width_mode, ui_context.nodes[child].measured.h, ui_context.nodes[child].measured.w)
        }
    }
    machine compute_main(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32, is_row: bool, inner_cross: i32 in Saturating, main_mode: UiSizing, cross_mode: UiSizing, meas_main: i32 in Saturating, meas_cross: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 && child >= 0 && child < 128 {
        let base_main: i32 in Saturating = select_sat(types::sizing_is_fill(main_mode), 0, meas_main);
        let cg: i32 in Saturating = ui_context.nodes[child].style.grow;
        let child_grow: i32 in Saturating = select_sat(cg > 0, cg, select_sat(types::sizing_is_fill(main_mode), 1, 0));
        transition free > 0 && grow_total > 0 && child_grow > 0 {
            true -> add_flex(ui_context, node_index, inner, free, grow_total, pos, spacing, child, is_row, inner_cross, cross_mode, base_main, meas_cross, child_grow)
            _ -> compute_cross(ui_context, node_index, inner, free, grow_total, pos, spacing, child, is_row, inner_cross, cross_mode, base_main, meas_cross)
        }
    }
    machine add_flex(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32, is_row: bool, inner_cross: i32 in Saturating, cross_mode: UiSizing, base_main: i32 in Saturating, meas_cross: i32 in Saturating, child_grow: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 && child >= 0 && child < 128 && grow_total > 0 {
        let extra_main: i32 in Saturating = (free * child_grow) / grow_total;
        transition { _ -> compute_cross(ui_context, node_index, inner, free, grow_total, pos, spacing, child, is_row, inner_cross, cross_mode, base_main + extra_main, meas_cross) }
    }
    machine compute_cross(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32, is_row: bool, inner_cross: i32 in Saturating, cross_mode: UiSizing, m_len: i32 in Saturating, meas_cross: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 && child >= 0 && child < 128 {
        let align_items: UiAlignment = ui_context.nodes[node_index].style.align_items;
        let stretch: bool = types::sizing_is_fill(cross_mode) || (types::alignment_is_stretch(align_items) && types::sizing_is_fit(cross_mode));
        let c_len: i32 in Saturating = select_sat(stretch, inner_cross, meas_cross);
        let rem_cross: i32 in Saturating = max_sat(inner_cross - c_len, 0);
        let c_pos: i32 in Saturating = select_sat(types::alignment_is_center(align_items), rem_cross / (2 as i32 in Saturating), select_sat(types::alignment_is_end(align_items), rem_cross, 0));
        transition is_row {
            true -> write_row(ui_context, node_index, inner, free, grow_total, pos, spacing, child, m_len, c_len, c_pos)
            _ -> write_col(ui_context, node_index, inner, free, grow_total, pos, spacing, child, m_len, c_len, c_pos)
        }
    }
    machine write_row(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32, m_len: i32 in Saturating, c_len: i32 in Saturating, c_pos: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 && child >= 0 && child < 128 {
        ui_context.nodes[child].rect = Rect {
            x: inner.x + pos,
            y: inner.y + c_pos,
            w: m_len,
            h: c_len
        };
        transition { _ -> loop_children(ui_context, node_index, inner, free, grow_total, pos + m_len + spacing, spacing, ui_context.nodes[child].next_sibling) }
    }
    machine write_col(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating, child: i32, m_len: i32 in Saturating, c_len: i32 in Saturating, c_pos: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 && child >= 0 && child < 128 {
        ui_context.nodes[child].rect = Rect {
            x: inner.x + c_pos,
            y: inner.y + pos,
            w: c_len,
            h: m_len
        };
        transition { _ -> loop_children(ui_context, node_index, inner, free, grow_total, pos + m_len + spacing, spacing, ui_context.nodes[child].next_sibling) }
    }
    machine done() {}
}

public machine arrange_all(ui_context: &mut UiContext) {
    ui_context.hit_count = 0;
    ui_context.nodes[0].rect = Rect { x: 0, y: 0, w: ui_context.width, h: ui_context.height };
    transition { _ -> arrange_loop(ui_context, 0) }

    machine arrange_loop(ui_context: &mut UiContext, node_index: i32) {
        transition node_index >= 0 && node_index < ui_context.node_count && node_index < 128 {
            true -> arrange_node(ui_context, node_index)
            _ -> finish_frame(ui_context)
        }
    }
    machine arrange_node(ui_context: &mut UiContext, node_index: i32)
    requires node_index >= 0 && node_index < 128 {
        let is_inter: bool = ui_context.nodes[node_index].interactive;
        transition is_inter && ui_context.hit_count >= 0 && ui_context.hit_count < 128 {
            true -> record_hit(ui_context, node_index)
            _ -> check_children(ui_context, node_index)
        }
    }
    machine record_hit(ui_context: &mut UiContext, node_index: i32)
    requires node_index >= 0 && node_index < 128 && ui_context.hit_count >= 0 && ui_context.hit_count < 128 {
        let h_idx: i32 = ui_context.hit_count;
        ui_context.hit_ids[h_idx] = ui_context.nodes[node_index].id;
        ui_context.hit_rects[h_idx] = context::node_rect(ui_context, node_index);
        ui_context.hit_count = h_idx + 1;
        transition { _ -> check_children(ui_context, node_index) }
    }
    machine check_children(ui_context: &mut UiContext, node_index: i32)
    requires node_index >= 0 && node_index < 128 {
        let count: i32 in Saturating = ui_context.nodes[node_index].child_count;
        transition count > 0 {
            true -> arrange_children(ui_context, node_index, count)
            _ -> arrange_loop(ui_context, node_index + 1)
        }
    }
    machine arrange_children(ui_context: &mut UiContext, node_index: i32, count: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 {
        let pad_l: i32 in Saturating = ui_context.nodes[node_index].style.padding.left;
        let pad_r: i32 in Saturating = ui_context.nodes[node_index].style.padding.right;
        let pad_t: i32 in Saturating = ui_context.nodes[node_index].style.padding.top;
        let pad_b: i32 in Saturating = ui_context.nodes[node_index].style.padding.bottom;
        let ix: i32 in Saturating = ui_context.nodes[node_index].rect.x + pad_l;
        let iy: i32 in Saturating = ui_context.nodes[node_index].rect.y + pad_t;
        let iw: i32 in Saturating = max_sat(ui_context.nodes[node_index].rect.w - (pad_l + pad_r), 0);
        let ih: i32 in Saturating = max_sat(ui_context.nodes[node_index].rect.h - (pad_t + pad_b), 0);
        let inner: Rect = Rect { x: ix, y: iy, w: iw, h: ih };
        let is_row: bool = types::axis_is_row(ui_context.nodes[node_index].style.direction);
        let summary: Size = context::sum_main_children(ui_context, node_index, is_row);
        let used: i32 in Saturating = summary.w;
        let grow_total: i32 in Saturating = summary.h;
        let gap: i32 in Saturating = ui_context.nodes[node_index].style.gap;
        let justify: UiJustify = ui_context.nodes[node_index].style.justify;
        let gaps: i32 in Saturating = max_sat(count - (1 as i32 in Saturating), 0);
        let total_used: i32 in Saturating = used + gap * gaps;
        let inner_main: i32 in Saturating = select_sat(is_row, inner.w, inner.h);
        let free: i32 in Saturating = max_sat(inner_main - total_used, 0);
        let can_justify: bool = grow_total == 0 && free > 0;
        let pos: i32 in Saturating = select_sat(can_justify && types::justify_is_center(justify), free / (2 as i32 in Saturating), select_sat(can_justify && types::justify_is_end(justify), free, 0));
        transition can_justify && types::justify_is_space_between(justify) && gaps > 0 {
            true -> place_between(ui_context, node_index, inner, free, grow_total, pos, gap, gaps)
            _ -> do_place(ui_context, node_index, inner, free, grow_total, pos, gap)
        }
    }
    machine place_between(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, gap: i32 in Saturating, gaps: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 && gaps > 0 {
        let extra: i32 in Saturating = free / gaps;
        transition { _ -> do_place(ui_context, node_index, inner, free, grow_total, pos, gap + extra) }
    }
    machine do_place(ui_context: &mut UiContext, node_index: i32, inner: Rect, free: i32 in Saturating, grow_total: i32 in Saturating, pos: i32 in Saturating, spacing: i32 in Saturating)
    requires node_index >= 0 && node_index < 128 {
        context::place_children_of(ui_context, node_index, inner, free, grow_total, pos, spacing);
        transition { _ -> arrange_loop(ui_context, node_index + 1) }
    }
    machine finish_frame(ui_context: &mut UiContext) {
        ui_context.active = select_i32(ui_context.mouse_down && !ui_context.mouse_released, ui_context.active, 0);
        ui_context.mouse_pressed = false;
        ui_context.mouse_released = false;
        ui_context.key_code = 0;
        ui_context.frame = ui_context.frame + (1 as i32 in Saturating);
    }
}

public machine end_frame(ui_context: &mut UiContext) {
    ui_context.frame_error = select_i32(ui_context.frame_error == 0 && (ui_context.stack_len != 1 || ui_context.rejected_containers != 0), 4, ui_context.frame_error);
    ui_context.frame_error = select_i32(ui_context.frame_error == 0 && ui_context.text_store.overflow, 1, ui_context.frame_error);
    context::measure_all(ui_context);
    context::arrange_all(ui_context);
}

// Width and height are logical units measured by the same font used to paint.
// A missing measurement is an explicit frame error, never a zero-width label.
public machine set_text_metrics(ui_context: &mut UiContext, index: i32, width: i32, height: i32) {
    transition index > 0 && index < ui_context.node_count && index < 128 && width >= 0 && height > 0 {
        true -> store(ui_context, index, width, height)
        _ -> done()
    }
    machine store(ui_context: &mut UiContext, index: i32, width: i32, height: i32)
    requires index > 0 && index < 128 {
        ui_context.nodes[index].intrinsic = Size { w: width as i32 in Saturating, h: height as i32 in Saturating };
        ui_context.nodes[index].text_measured = true;
    }
    machine done() {}
}

public machine paint_rect(ui_context: &UiContext, index: i32) -> Rect
requires index >= 0 && index < 128 {
    // Most nodes have no press transform; avoid recomputing it for every scanline.
    transition (ui_context.nodes[index].content_kind == 1 || (ui_context.nodes[index].content_kind == 19 && ui_context.nodes[index].interactive)) && ui_context.nodes[index].aux_value > 400 {
        true -> pressed(ui_context, index)
        _ -> (context::node_rect(ui_context, index))
    }
    machine pressed(ui_context: &UiContext, index: i32) -> Rect requires index >= 0 && index < 128 {
        let rectangle: Rect = context::node_rect(ui_context, index);
        context::pressed_rect(rectangle, ui_context.nodes[index].aux_value as i32)
    }
}

public machine pressed_rect(rectangle: Rect, feedback: i32) -> Rect {
    let press: i32 in Saturating = clamp_i32(sub_i32(feedback, 400), 0, 600) as i32 in Saturating;
    let depth: i32 in Saturating = select_sat(rectangle.w <= 48, 40, select_sat(rectangle.w > 220, 15, 30));
    let width: i32 in Saturating = rectangle.w - rectangle.w * press * depth / (600000 as i32 in Saturating);
    let height: i32 in Saturating = rectangle.h - rectangle.h * press * depth / (600000 as i32 in Saturating);
    Rect { x: rectangle.x + (rectangle.w - width) / (2 as i32 in Saturating), y: rectangle.y + (rectangle.h - height) / (2 as i32 in Saturating), w: width, h: height }
}
