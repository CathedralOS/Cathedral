module motion;

use types::add_i32;
use types::clamp_i32;
use types::max_i32;
use types::min_i32;
use types::mul_i32;
use types::select_i32;
use types::sub_i32;


/*
A host advances this store once per frame using elapsed milliseconds. Controls
retarget stable IDs while rebuilding the view; rebuilding twice never advances
time. New IDs start settled, and interrupted transitions start at their current
value. Pointer positions themselves stay immediate. Reduced motion snaps values.

The store holds 64 retained channels without allocation. Values are normalized
0..1000. Channels unseen for 120 frames can be reused. If all 64 channels are
still live, capacity overflow returns the target rather than losing input.
The cubic easing is a bounded transition, not a physical spring simulation.
*/
use types;

public data MotionValue {
    identifier: i32;
    start: i32;
    target: i32;
    current: i32;
    elapsed: i32;
    duration: i32;
    unseen_frames: i32;
}
public data UiMotion {
    values: [MotionValue; 64];
    count: i32;
    animating: bool;
    reduced: bool;
}

public machine target(animation: &mut UiMotion, identifier: i32, target: i32, duration: i32) -> i32 {
    let bounded: i32 = clamp_i32(target, 0, 1000);
    transition { _ -> find(animation, identifier, bounded, clamp_i32(duration, 1, 1000), 0) }
    machine find(animation: &mut UiMotion, identifier: i32, target: i32, duration: i32, index: i32) -> i32 {
        transition index >= 0 && index < animation.count && index < 64 {
            true -> compare(animation, identifier, target, duration, index)
            _ -> append(animation, identifier, target, duration)
        }
    }
    machine compare(animation: &mut UiMotion, identifier: i32, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        transition animation.values[index].identifier == identifier {
            true -> retarget(animation, target, duration, index)
            _ -> find(animation, identifier, target, duration, index + 1)
        }
    }
    machine retarget(animation: &mut UiMotion, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        let identifier: i32 = animation.values[index].identifier;
        transition animation.values[index].unseen_frames > 120 {
            true -> store(animation, identifier, target, duration, index)
            _ -> seen(animation, target, duration, index)
        }
    }
    machine seen(animation: &mut UiMotion, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        animation.values[index].unseen_frames = 0;
        transition animation.reduced {
            true -> snap(animation, target, duration, index)
            _ -> update(animation, target, duration, index)
        }
    }
    machine snap(animation: &mut UiMotion, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        animation.values[index] = MotionValue { identifier: animation.values[index].identifier, start: target, target: target, current: target, elapsed: duration, duration: duration, unseen_frames: 0 };
        target
    }
    machine update(animation: &mut UiMotion, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        transition animation.values[index].target != target {
            true -> changed(animation, target, duration, index)
            _ -> (animation.values[index].current)
        }
    }
    machine changed(animation: &mut UiMotion, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        animation.values[index].start = animation.values[index].current;
        animation.values[index].target = target;
        animation.values[index].elapsed = 0;
        animation.values[index].duration = duration;
        animation.animating = true;
        animation.values[index].current
    }
    machine append(animation: &mut UiMotion, identifier: i32, target: i32, duration: i32) -> i32 {
        let index: i32 = animation.count;
        transition index >= 0 && index < 64 {
            true -> store(animation, identifier, target, duration, index)
            _ -> recycle(animation, identifier, target, duration, 0)
        }
    }
    machine store(animation: &mut UiMotion, identifier: i32, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        animation.values[index] = MotionValue { identifier: identifier, start: target, target: target, current: target, elapsed: duration, duration: duration, unseen_frames: 0 };
        animation.count = max_i32(animation.count, index + 1);
        target
    }
    machine recycle(animation: &mut UiMotion, identifier: i32, target: i32, duration: i32, index: i32) -> i32 {
        transition index >= 0 && index < 64 {
            true -> retired(animation, identifier, target, duration, index)
            _ -> (target)
        }
    }
    machine retired(animation: &mut UiMotion, identifier: i32, target: i32, duration: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        transition animation.values[index].unseen_frames > 120 {
            true -> store(animation, identifier, target, duration, index)
            _ -> recycle(animation, identifier, target, duration, index + 1)
        }
    }
}

public machine advance(animation: &mut UiMotion, elapsed_ms: i32) -> bool {
    animation.animating = false;
    transition { _ -> next(animation, clamp_i32(elapsed_ms, 0, 1000), 0, false) }
    machine next(animation: &mut UiMotion, elapsed_ms: i32, index: i32, changed: bool) -> bool {
        transition index >= 0 && index < animation.count && index < 64 {
            true -> step(animation, elapsed_ms, index, changed)
            _ -> (changed)
        }
    }
    machine step(animation: &mut UiMotion, elapsed_ms: i32, index: i32, changed: bool) -> bool
    requires index >= 0 && index < 64 {
        animation.values[index].unseen_frames = min_i32(add_i32(animation.values[index].unseen_frames, 1), 121);
        let duration: i32 = clamp_i32(animation.values[index].duration, 1, 1000);
        let elapsed: i32 = min_i32(add_i32(animation.values[index].elapsed, elapsed_ms), duration);
        transition duration > 0 {
            true -> interpolate(animation, elapsed_ms, index, changed, duration, elapsed)
            _ -> next(animation, elapsed_ms, index + 1, changed)
        }
    }
    machine interpolate(animation: &mut UiMotion, elapsed_ms: i32, index: i32, changed: bool, duration: i32, elapsed: i32) -> bool
    requires index >= 0 && index < 64 && duration > 0 {
        let remaining: i32 = mul_i32(sub_i32(duration, elapsed), 1000) / duration;
        let eased: i32 = sub_i32(1000, mul_i32(mul_i32(remaining, remaining), remaining) / 1000000);
        let old: i32 = animation.values[index].current;
        let current: i32 = select_i32(animation.reduced || elapsed == duration, animation.values[index].target,
            add_i32(animation.values[index].start, mul_i32(sub_i32(animation.values[index].target, animation.values[index].start), eased) / 1000));
        animation.values[index].current = current;
        animation.values[index].elapsed = elapsed;
        animation.animating = animation.animating || current != animation.values[index].target;
        transition { _ -> next(animation, elapsed_ms, index + 1, changed || current != old) }
    }
}

public machine read(animation: &UiMotion, identifier: i32, fallback: i32) -> i32 {
    transition { _ -> find(animation, identifier, fallback, 0) }
    machine find(animation: &UiMotion, identifier: i32, fallback: i32, index: i32) -> i32 {
        transition index >= 0 && index < animation.count && index < 64 {
            true -> compare(animation, identifier, fallback, index)
            _ -> (fallback)
        }
    }
    machine compare(animation: &UiMotion, identifier: i32, fallback: i32, index: i32) -> i32
    requires index >= 0 && index < 64 {
        transition animation.values[index].identifier == identifier {
            true -> (animation.values[index].current)
            _ -> find(animation, identifier, fallback, index + 1)
        }
    }
}
