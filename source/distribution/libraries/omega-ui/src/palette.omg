module palette;

use types::Theme;


// Resolves two theme modes and eight accents into runtime color roles.

use types;

public data ThemePalette {
    background: i32;
    surface: i32;
    surface_raised: i32;
    surface_muted: i32;
    foreground: i32;
    text_secondary: i32;
    text_muted: i32;
    border: i32;
    border_subtle: i32;
    border_strong: i32;
    accent: i32;
    accent_strong: i32;
    accent_subtle: i32;
    accent_foreground: i32;
    control_on: i32;
    control_glyph: i32;
    control_track: i32;
    control_track_hover: i32;
    control_thumb: i32;
    control_thumb_on: i32;
    control_fill: i32;
    success: i32;
    warning: i32;
    danger: i32;
    series_1: i32;
    series_2: i32;
    series_3: i32;
    series_4: i32;
    accent_subtle_alpha: i32;
}

public machine resolve(dark: bool, accent: i32) -> ThemePalette {
    transition dark { true -> (dark_palette(accent)) _ -> (light_palette(accent)) }
}

machine light_palette(accent: i32) -> ThemePalette {
    transition accent {
        1 -> (light_violet())
        2 -> (light_blue())
        3 -> (light_green())
        4 -> (light_amber())
        5 -> (light_orange())
        6 -> (light_coral())
        7 -> (light_rose())
        _ -> (light_neutral())
    }
}

machine light_neutral() -> ThemePalette {
    ThemePalette {
        background: 0xFFFFFF,
        surface: 0xFFFFFF,
        surface_raised: 0xFFFFFF,
        surface_muted: 0xF8F8F8,
