machine dark_palette(accent: i32) -> ThemePalette {
    transition accent {
        1 -> (dark_violet())
        2 -> (dark_blue())
        3 -> (dark_green())
        4 -> (dark_amber())
        5 -> (dark_orange())
        6 -> (dark_coral())
        7 -> (dark_rose())
        _ -> (dark_neutral())
    }
}

