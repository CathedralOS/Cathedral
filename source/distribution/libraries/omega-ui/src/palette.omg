        text_muted: 0x7D7D7D,
        border: 0xE9E9E9,
        border_subtle: 0xF3F3F3,
        border_strong: 0xC4C4C4,
        accent: 0x353535,
        accent_strong: 0x1F1F1F,
        accent_subtle: 0x313131,
        accent_foreground: 0xFFFFFF,
        control_on: 0x1D1D1D,
        control_glyph: 0xFFFFFF,
        control_track: 0xDCDCDC,
        control_track_hover: 0xD1D1D1,
