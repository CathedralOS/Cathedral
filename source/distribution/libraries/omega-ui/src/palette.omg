public machine to_theme(resolved_palette: &ThemePalette, dark: bool) -> Theme {
    Theme {
        is_dark: dark,
        background: resolved_palette.background,
        sidebar_bg: resolved_palette.background,
        surface: resolved_palette.surface,
        surface_hover: resolved_palette.surface_muted,
        control_on: resolved_palette.control_on,
        control_glyph: resolved_palette.control_glyph,
        well: resolved_palette.surface_muted,
        empty: resolved_palette.control_track,
        border: resolved_palette.border_subtle,
        text: resolved_palette.foreground,
        text_muted: resolved_palette.text_secondary,
        tertiary: resolved_palette.text_muted,
        accent: resolved_palette.accent,
        accent_hover: resolved_palette.accent_strong,
        accent_text: resolved_palette.accent_foreground,
        danger: resolved_palette.danger,
        success: resolved_palette.success,
        orange: resolved_palette.warning,
        teal: resolved_palette.series_4,
        purple: resolved_palette.series_2,
        blue: resolved_palette.series_1,
        track: resolved_palette.control_track,
        knob: resolved_palette.control_thumb,
        knob_on: resolved_palette.control_thumb_on,
        shadow: 0x000000
    }
}
