machine build(builder: &mut Build) {
 Build::application(builder, "omega_ui_native_frame");
 Build::depend_as(builder, "native", Source::Path { location: "../../../platform/native" });
 Build::select_provider<native::UiNativeFrame, native::UiNativeFrameProvider>(builder, CompositionMode::Independent);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
