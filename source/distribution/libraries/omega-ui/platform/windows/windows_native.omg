    machine do_env(name: &[u8]) -> bool
    requires name.len > 0 {
        let mut buf: u32 = 0;
        WindowsUiIo::get_env_a(&name[0], &mut buf, 4) > 0
    }
}

machine window_create_utf8(class_name: &[u8], title: &[u8], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64 reaches WindowsUiHost {
    transition class_name.len > 0u64 && title.len > 0u64 && class_name.len <= 4096u64 && title.len <= 4096u64 {
        true -> decode(class_name, title, style, x, y, width, height)
        _ -> (0u64)
    }
    machine decode(class_name: &[u8], title: &[u8], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
    requires class_name.len > 0u64 && title.len > 0u64 && class_name.len <= 4096u64 && title.len <= 4096u64 {
        let mut wide_class: [u16; 512];
        let mut wide_title: [u16; 512];
        let class_length: i32 = WindowsUiIo::decode_utf8(65001, 8, &class_name[0], class_name.len as i32, &mut wide_class[0], 512);
        let title_length: i32 = WindowsUiIo::decode_utf8(65001, 8, &title[0], title.len as i32, &mut wide_title[0], 512);
        transition class_length > 0 && title_length > 0 {
            true -> (WindowsUiIo::edit_create(0, &wide_class[0], &wide_title[0], style, x, y, width, height, 0, 0, 0, 0))
            _ -> (0u64)
        }
    }
