use main.omg;

machine build(builder: &mut Build) {
    Build::package(builder, "omega_ui_native");
    Build::depend_as(builder, "omega_ui", Source::Path { location: "../../src" });
    Build::select_provider<|main|::UiNativeLayout, |main|::UiNativeLayoutProvider>(builder, linux_x86_64);
    Build::select_provider<|main|::UiNativeFrame, |main|::UiNativeFrameProvider>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |main|::component_entry);
}
