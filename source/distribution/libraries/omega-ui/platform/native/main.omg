
use omega_ui::text::UiTextStore;
use omega_ui::types::Rect;
use omega_ui::types::clamp_sat;
use omega_ui::types::select_sat;
use omega_ui::viewport::UiViewport;

/*
Caller-authored UI frames over ABI 2. Apps retain their models; core widgets own
input, layout, motion and rasterization. No application IDs or views live here.
0 resize; 1 pointer; 2 key; 3 row; 5 bounds; 6 motion; 7 theme; 10 begin;
11 finish pass; 12 abort; 20..32 widgets. Operation/arguments are 4080..4087.
Text is 0..255, length/caret/anchor/scroll are 4040..4043. Node/flags/value are
4060..4062, rebuild is 4064, status is 4068..4078. Raster owns 4088+.
UiTextStore copies labels; packet views never survive an invocation.
*/
use omega_ui::types;
use omega_ui::context;
use omega_ui::frame;
use omega_ui::scene;
use omega_ui::viewport;
use omega_ui::raster;
use omega_ui::motion;
use native_state;
use commands;
use editor;
use font;
use paint;
public boundary trait UiNativeLayout { machine query(kind: u64) -> u64 reaches; }
public boundary trait UiNativeFrame { machine apply(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 reaches; }
public UiNativeLayoutProvider satisfies UiNativeLayout {
    machine query(kind: u64) -> u64 {
        transition kind { 0u64 -> (size_of<NativeUiState>()) 1u64 -> (align_of<NativeUiState>()) 2u64 -> (2u64) _ -> (0u64) }
    }
}
public UiNativeFrameProvider satisfies UiNativeFrame {
    machine apply(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 { dispatch(surface, packet) }
}
machine dispatch(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
    packet[4060] = 0; packet[4061] = 0; packet[4062] = 0; packet[4064] = 0;
    transition packet[4080] == 0 { true -> resize(surface, packet) _ -> ready(surface, packet) }
    machine resize(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition packet[4081] >= 1 && packet[4081] <= 3840 && packet[4082] >= 1 && packet[4082] <= 2160 && !surface.building {
            true -> initialize(surface, packet) _ -> (3u64)
        }
    }
    machine initialize(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition surface.ready { true -> dimensions(surface, packet) _ -> first(surface, packet) }
    }
    machine first(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        omega_ui::context::setup(&mut surface.context, packet[4081], packet[4082], true);
        surface.ready = true;
        transition { _ -> dimensions(surface, packet) }
    }
    machine dimensions(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        surface.context.width = packet[4081] as i32 in Saturating;
        surface.context.height = packet[4082] as i32 in Saturating;
        surface.context.active = 0; surface.context.mouse_down = false; surface.prepared = false;
        transition { _ -> report(surface, packet) }
    }
    machine ready(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition surface.ready { true -> operation(surface, packet) _ -> (1u64) }
    }
    machine operation(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition packet[4080] {
            7 -> theme(surface, packet) 11 -> finish(surface, packet) 12 -> abort(surface, packet) _ -> phase(surface, packet)
        }
    }
    machine phase(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition surface.building { true -> (apply_widget(surface, packet)) _ -> idle(surface, packet) }
    }
    machine idle(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition packet[4080] {
            1 -> pointer(surface, packet) 2 -> key(surface, packet) 3 -> row(surface, packet)
            5 -> bounds(surface, packet, packet[4081]) 6 -> tick(surface, packet) 10 -> begin(surface, packet) _ -> (2u64)
        }
    }
    machine pointer(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        surface.context.mouse_x = packet[4081]; surface.context.mouse_y = packet[4082];
        surface.context.mouse_down = (packet[4083] & 1) != 0;
        surface.context.mouse_pressed = (packet[4083] & 2) != 0; surface.context.mouse_released = (packet[4083] & 4) != 0;
        transition { _ -> report(surface, packet) }
    }
    machine key(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        surface.context.key_code = packet[4081]; surface.character = packet[4082];
        surface.control = (packet[4083] & 1) != 0; surface.shift = (packet[4083] & 2) != 0;
        transition packet[4081] == 9 { true -> tab(surface, packet) _ -> report(surface, packet) }
    }
    machine tab(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        omega_ui::context::focus_next(&mut surface.context, surface.shift);
        surface.context.key_code = 0; surface.character = 0;
        transition { _ -> report(surface, packet) }
    }
    machine tick(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition packet[4081] >= 0 && packet[4081] <= 1000 { true -> advance(surface, packet) _ -> (3u64) }
    }
    machine advance(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        let changed: bool = omega_ui::motion::advance(&mut surface.context.motion, packet[4081]);
        transition { _ -> report(surface, packet) }
    }
    machine theme(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        let dark: bool = packet[4081] != 0;
        let changed: bool = dark != surface.context.theme.is_dark;
        omega_ui::context::set_theme(&mut surface.context, dark);
        surface.context.changed = surface.context.changed || changed;
        transition { _ -> report(surface, packet) }
    }
    machine begin(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        surface.frame = omega_ui::frame::begin(&mut surface.context);
        surface.building = true; surface.prepared = false; clear_paint(surface, 0);
        transition { _ -> report(surface, packet) }
    }
    machine finish(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        transition surface.building { true -> arrange(surface, packet) _ -> (2u64) }
    }
    machine arrange(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        font::measure(&mut surface.context);
        let again: bool = omega_ui::frame::next_pass(&mut surface.frame, &mut surface.context);
        surface.character = 0; surface.control = false; surface.shift = false;
        transition again { true -> rebuild(surface, packet) _ -> prepare(surface, packet) }
    }
    machine rebuild(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        packet[4064] = 1; clear_paint(surface, 0);
        transition { _ -> report(surface, packet) }
    }
    machine prepare(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        surface.building = false; surface.prepared = surface.context.frame_error == 0;
        omega_ui::scene::prepare(&mut surface.scene, &surface.context);
        surface.revision = surface.revision + (1 as i32 in Saturating);
        transition { _ -> report(surface, packet) }
    }
    machine abort(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        surface.building = false; surface.prepared = false;
        surface.context.mouse_pressed = false; surface.context.mouse_released = false;
        surface.context.key_code = 0; surface.character = 0; surface.context.frame_error = 0;
        transition { _ -> report(surface, packet) }
    }
    machine bounds(surface: &NativeUiState, packet: &mut [i32; 4096], node: i32) -> u64 {
        transition surface.prepared && node > 0 && node < surface.context.node_count && node < 128 {
            true -> rectangle(surface, packet, node) _ -> (4u64)
        }
    }
    machine rectangle(surface: &NativeUiState, packet: &mut [i32; 4096], node: i32) -> u64 requires node > 0 && node < 128 {
        let rectangle: Rect = omega_ui::context::node_rect(&surface.context, node);
        let outside: i32 in Saturating = select_sat(surface.context.nodes[node].content_kind == 4 && surface.context.nodes[node].interactive, 14, 0);
        let vertical: i32 in Saturating = select_sat(outside > 0, 6, 0);
        let left: i32 in Saturating = clamp_sat(rectangle.x - outside, 0, surface.context.width);
        let top: i32 in Saturating = clamp_sat(rectangle.y - vertical, 0, surface.context.height);
        packet[4000] = left as i32; packet[4001] = top as i32;
        packet[4002] = (clamp_sat(rectangle.x + rectangle.w + outside, left, surface.context.width) - left) as i32;
        packet[4003] = (clamp_sat(rectangle.y + rectangle.h + vertical, top, surface.context.height) - top) as i32;
        transition { _ -> report(surface, packet) }
    }
    machine row(surface: &mut NativeUiState, packet: &mut [i32; 4096]) -> u64 {
        let y: i32 = packet[4081];
        transition surface.prepared && y >= 0 && (y as i32 in Saturating) < surface.context.height {
            true -> render_row(surface, packet, y) _ -> (3u64)
        }
    }
    machine render_row(surface: &mut NativeUiState, packet: &mut [i32; 4096], y: i32) -> u64 {
        omega_ui::raster::configure(packet, UiViewport { logical_width: surface.context.width as i32, logical_height: surface.context.height as i32,
            physical_width: surface.context.width as i32, physical_height: surface.context.height as i32 });
        paint::paint(&surface.scene, &surface.context, packet, y);
        paint_selections(surface, packet, y, 1);
        font::paint(&surface.context, packet, y, &surface.text_paint);
        transition { _ -> report(surface, packet) }
    }
    machine report(surface: &NativeUiState, packet: &mut [i32; 4096]) -> u64 { native_report(surface, packet) }
}
machine clear_paint(surface: &mut NativeUiState, index: i32) {
    transition { _ -> scan(surface, index) }
    machine scan(surface: &mut NativeUiState, index: i32) {
        transition index >= 0 && index < 128 { true -> clear(surface, index) _ -> done() }
    }
    machine clear(surface: &mut NativeUiState, index: i32) requires index >= 0 && index < 128 {
        surface.text_paint[index] = NativeTextPaint { field: 0, scroll: 0, left: 0, right: 0, caret: 0 };
        transition { _ -> scan(surface, index + 1) }
    }
    machine done() {}
}
public machine component_entry() reaches UiNativeLayout, UiNativeFrame invokes UiNativeLayout; invokes UiNativeFrame; {
    let result: u64 = UiNativeLayout::query(0u64);
    let mut surface: NativeUiState; let mut packet: [i32; 4096];
    let applied: u64 = UiNativeFrame::apply(&mut surface, &mut packet);
}
