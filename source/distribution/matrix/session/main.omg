// Stock service turn: progress upstream work -> finish children -> choose work ->
// wait -> observe cancellation -> defer or dispatch the retained event.
// State 16: next command, or issued command + 64. State 17: needed observations.
use operations;
public machine session_decision(p: &mut [u64; 128]) -> u64 {
    transition p[1] { 0u64 -> command(p) 1u64 -> completed(p) _ -> (0u64) }
}
machine issue(p: &mut [u64; 128], command: u64) -> u64 requires command <= INVALID { p[16] = command + 64u64; command }
machine command(p: &mut [u64; 128]) -> u64 {
    transition p[16] {
        0u64 -> issue(p, INTERACTION)
        ADMIT_READY -> admission(p) REFRESH_RETAINED -> refreshed(p) FLUSH -> flush(p)
        LAUNCH -> launch(p) RECOVER -> recover(p) STARTUP -> startup(p)
        POLL -> poll(p) QUERY_LOSS -> loss(p) DEFER -> defer(p)
        LEGACY_REFRESH -> legacy(p) DISCONNECT -> dispatch(p)
        _ -> ordinary(p)
    }
    state ordinary(p: &mut [u64; 128]) -> u64 {
        let command: u64 = p[16];
        transition command >= INTERACTION && command <= LEGACY_REFRESH { true -> issue(p, command) _ -> (0u64) }
    }
    state admission(p: &mut [u64; 128]) -> u64 {
        transition (p[2] & (BUSY | READY_LAUNCH)) == READY_LAUNCH { true -> issue(p, ADMIT_READY) _ -> issue(p, BINDING) }
    }
    state refreshed(p: &mut [u64; 128]) -> u64 {
        transition (p[2] & (REFRESH_READY | PUBLISHING)) == REFRESH_READY { true -> issue(p, REFRESH_RETAINED) _ -> issue(p, FINISH_CHILDREN) }
    }
    state flush(p: &mut [u64; 128]) -> u64 { transition (p[2] & BUSY) == 0u64 { true -> issue(p, FLUSH) _ -> issue(p, PRUNE) } }
    state launch(p: &mut [u64; 128]) -> u64 { transition (p[2] & DEFERRED_READY) == 0u64 { true -> issue(p, LAUNCH) _ -> recover(p) } }
    state recover(p: &mut [u64; 128]) -> u64 { transition (p[2] & DEFERRED_EMPTY) != 0u64 { true -> issue(p, RECOVER) _ -> startup(p) } }
    state startup(p: &mut [u64; 128]) -> u64 { transition (p[2] & (BUSY | STORING)) == 0u64 { true -> issue(p, STARTUP) _ -> poll(p) } }
    state poll(p: &mut [u64; 128]) -> u64 { transition (p[2] & (CAN_POLL | DEFERRED_READY)) == CAN_POLL { true -> issue(p, POLL) _ -> issue(p, WAIT) } }
    state loss(p: &mut [u64; 128]) -> u64 { transition (p[2] & READY_LAUNCH) == 0u64 { true -> issue(p, QUERY_LOSS) _ -> issue(p, CANCEL) } }
    state defer(p: &mut [u64; 128]) -> u64 { transition (p[2] & EVENT_BLOCKED) != 0u64 { true -> issue(p, DEFER) _ -> legacy(p) } }
    state legacy(p: &mut [u64; 128]) -> u64 { transition (p[2] & (BUSY | HAS_WAKE)) == 0u64 { true -> issue(p, LEGACY_REFRESH) _ -> dispatch(p) } }
    state dispatch(p: &mut [u64; 128]) -> u64 {
        // Host classifies the retained event from authenticated connection facts.
        transition p[3] { 1u64 -> issue(p, DISCONNECT) 2u64 -> issue(p, PRODUCER_MEMORY) 3u64 -> issue(p, STORAGE_MEMORY) 4u64 -> issue(p, IMAGE_MEMORY) 5u64 -> issue(p, REQUEST) _ -> issue(p, INVALID) }
    }
}
machine completed(p: &mut [u64; 128]) -> u64 {
    transition p[2] >= INTERACTION && p[2] <= REQUEST && p[16] == p[2] + 64u64 {
        true -> advance(p) _ -> (0u64)
    }
    state advance(p: &mut [u64; 128]) -> u64 {
        transition p[2] {
            INTERACTION -> next(p, REFRESH) REFRESH -> next(p, STORAGE)
            STORAGE -> next(p, ADMIT_READY) ADMIT_READY -> next(p, BINDING)
            BINDING -> next(p, PRESENTATION) PRESENTATION -> next(p, SELECTION)
            SELECTION -> next(p, LAUNCH_SCENE) LAUNCH_SCENE -> next(p, REFRESH_RETAINED)
            REFRESH_RETAINED -> next(p, FINISH_CHILDREN) FINISH_CHILDREN -> next(p, FLUSH)
            FLUSH -> next(p, RESTORE_INPUT) RESTORE_INPUT -> next(p, CURSORS)
            CURSORS -> next(p, PRUNE) PRUNE -> next(p, LAUNCH)
            LAUNCH -> progressed(p, RECOVER) RECOVER -> progressed(p, STARTUP)
            STARTUP -> next(p, POLL) POLL -> next(p, WAIT)
            WAIT -> received(p) QUERY_LOSS -> handled(p)
            CANCEL -> next(p, DEFER) DEFER -> next(p, INTERACTION)
            LEGACY_REFRESH -> next(p, DISCONNECT)
            DISCONNECT -> next(p, INTERACTION) PRODUCER_MEMORY -> next(p, INTERACTION)
            STORAGE_MEMORY -> next(p, INTERACTION) IMAGE_MEMORY -> next(p, INTERACTION)
            REQUEST -> next(p, INTERACTION) _ -> (0u64)
        }
    }
    state progressed(p: &mut [u64; 128], following: u64) -> u64 { transition p[3] != 0u64 { true -> next(p, INTERACTION) _ -> next(p, following) } }
    state received(p: &mut [u64; 128]) -> u64 { transition p[3] != 0u64 { true -> next(p, QUERY_LOSS) _ -> next(p, INTERACTION) } }
    state handled(p: &mut [u64; 128]) -> u64 { transition p[3] != 0u64 { true -> next(p, INTERACTION) _ -> next(p, CANCEL) } }
}
machine next(p: &mut [u64; 128], following: u64) -> u64 {
    p[16] = following; p[17] = observations(following); 1u64
}
// Ask only for facts needed by this gate and the gates it may immediately skip to.
// In particular, ordinary upstream progress never scans the deferred-event queue.
machine observations(command: u64) -> u64 {
    transition command {
        ADMIT_READY -> (BUSY | READY_LAUNCH)
        REFRESH_RETAINED -> (REFRESH_READY | PUBLISHING)
        FLUSH -> (BUSY)
        LAUNCH -> (DEFERRED_READY | DEFERRED_EMPTY | BUSY | STORING | CAN_POLL)
        RECOVER -> (DEFERRED_EMPTY | BUSY | STORING | CAN_POLL | DEFERRED_READY)
        STARTUP -> (BUSY | STORING | CAN_POLL | DEFERRED_READY)
        POLL -> (CAN_POLL | DEFERRED_READY)
        QUERY_LOSS -> (READY_LAUNCH)
        DEFER -> (EVENT_BLOCKED | BUSY | HAS_WAKE)
        LEGACY_REFRESH -> (BUSY | HAS_WAKE)
        _ -> (0u64)
    }
}
