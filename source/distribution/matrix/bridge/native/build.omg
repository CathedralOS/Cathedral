use {policy}/main.omg as policy_main;
use main.omg;

machine build(builder: &mut Build) {
    Build::application(builder, "cathedral_matrix_policy_native");
    Build::depend_as(builder, "policy", Source::Path {
        location: "../policy"
    }
    );
    Build::select_provider<|policy_main|::Policy, |policy_main|::PolicyProvider>(builder, linux_x86_64, CompositionMode::Independent);
    Build::bind(builder, linux_x86_64::ProgramEntry, |main|::main);
}
