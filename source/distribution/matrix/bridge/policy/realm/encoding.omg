// Private native tags and existing host status codes, never service authority.
use {service}/children/startup/realm/operations.omg;

const BUSY_STATUS: u64 = 18446744073709551600u64;
const DENIED_STATUS: u64 = 18446744073709551603u64;
const PEER_CLOSED_STATUS: u64 = 18446744073709551584u64;

public machine job(value: u64) -> |operations|::Job {
    transition value {
        1u64 -> (|operations|::Job::Configuration)
        2u64 -> (|operations|::Job::Picker)
        3u64 -> (|operations|::Job::Background)
        4u64 -> (|operations|::Job::Discovery)
        _ -> (|operations|::Job::None)
    }
}

public machine job_tag(job: |operations|::Job) -> u64 {
    transition job {
        |operations|::Job::None -> (0u64)
        |operations|::Job::Configuration -> (1u64)
        |operations|::Job::Picker -> (2u64)
        |operations|::Job::Background -> (3u64)
        |operations|::Job::Discovery -> (4u64)
    }
}

public machine command(value: u64) -> |operations|::Command requires value >= 1u64 && value <= 36u64 {
    transition value {
        1u64 -> (|operations|::Command::Refresh)
        2u64 -> (|operations|::Command::ReadConfiguration)
        3u64 -> (|operations|::Command::ValidateConfiguration)
        4u64 -> (|operations|::Command::AdmitLauncher)
        5u64 -> (|operations|::Command::ReleaseImage)
        6u64 -> (|operations|::Command::BindLauncher)
        7u64 -> (|operations|::Command::InstallWorkspace)
        8u64 -> (|operations|::Command::PlaceLauncher)
        9u64 -> (|operations|::Command::StartBackground)
        10u64 -> (|operations|::Command::BackgroundFailed)
        11u64 -> (|operations|::Command::Flush)
        12u64 -> (|operations|::Command::Notify)
        13u64 -> (|operations|::Command::GrantChrome)
        14u64 -> (|operations|::Command::RecordLauncher)
        15u64 -> (|operations|::Command::StopLauncher)
        16u64 -> (|operations|::Command::ClearWorkspace)
        17u64 -> (|operations|::Command::ResetSurfaces)
        18u64 -> (|operations|::Command::PreparePicker)
        19u64 -> (|operations|::Command::ReadPicker)
        20u64 -> (|operations|::Command::ValidatePicker)
        21u64 -> (|operations|::Command::AdmitPicker)
        22u64 -> (|operations|::Command::BindPicker)
        23u64 -> (|operations|::Command::PlacePicker)
        24u64 -> (|operations|::Command::InstallPicker)
        25u64 -> (|operations|::Command::RecordPicker)
        26u64 -> (|operations|::Command::ReadBackground)
        27u64 -> (|operations|::Command::AdmitBackground)
        28u64 -> (|operations|::Command::PlaceBackground)
        29u64 -> (|operations|::Command::RecordBackground)
        30u64 -> (|operations|::Command::StopBackground)
        31u64 -> (|operations|::Command::InspectRealm)
        32u64 -> (|operations|::Command::ConfigureRealm)
        33u64 -> (|operations|::Command::StartPicker)
        34u64 -> (|operations|::Command::MarkHosted)
        35u64 -> (|operations|::Command::RecoverStartup)
        _ -> (|operations|::Command::Finish)
    }
}

public machine command_tag(command: |operations|::Command) -> u64 {
    transition command {
        |operations|::Command::Refresh -> (1u64)
        |operations|::Command::ReadConfiguration -> (2u64)
        |operations|::Command::ValidateConfiguration -> (3u64)
        |operations|::Command::AdmitLauncher -> (4u64)
        |operations|::Command::ReleaseImage -> (5u64)
        |operations|::Command::BindLauncher -> (6u64)
        |operations|::Command::InstallWorkspace -> (7u64)
        |operations|::Command::PlaceLauncher -> (8u64)
        |operations|::Command::StartBackground -> (9u64)
        |operations|::Command::BackgroundFailed -> (10u64)
        |operations|::Command::Flush -> (11u64)
        |operations|::Command::Notify -> (12u64)
        |operations|::Command::GrantChrome -> (13u64)
        |operations|::Command::RecordLauncher -> (14u64)
        |operations|::Command::StopLauncher -> (15u64)
        |operations|::Command::ClearWorkspace -> (16u64)
        |operations|::Command::ResetSurfaces -> (17u64)
        |operations|::Command::PreparePicker -> (18u64)
        |operations|::Command::ReadPicker -> (19u64)
        |operations|::Command::ValidatePicker -> (20u64)
        |operations|::Command::AdmitPicker -> (21u64)
        |operations|::Command::BindPicker -> (22u64)
        |operations|::Command::PlacePicker -> (23u64)
        |operations|::Command::InstallPicker -> (24u64)
        |operations|::Command::RecordPicker -> (25u64)
        |operations|::Command::ReadBackground -> (26u64)
        |operations|::Command::AdmitBackground -> (27u64)
        |operations|::Command::PlaceBackground -> (28u64)
        |operations|::Command::RecordBackground -> (29u64)
        |operations|::Command::StopBackground -> (30u64)
        |operations|::Command::InspectRealm -> (31u64)
        |operations|::Command::ConfigureRealm -> (32u64)
        |operations|::Command::StartPicker -> (33u64)
        |operations|::Command::MarkHosted -> (34u64)
        |operations|::Command::RecoverStartup -> (35u64)
        |operations|::Command::Finish -> (36u64)
    }
}

public machine phase(value: u64) -> |operations|::Phase {
    transition value >= 1u64 && value <= 36u64 {
        true -> ready(value)
        _ -> waiting_or_dormant(value)
    }
    machine ready(value: u64) -> |operations|::Phase requires value >= 1u64 && value <= 36u64 {
        |operations|::Phase::Ready { command: command(value) }
    }
    machine waiting_or_dormant(value: u64) -> |operations|::Phase {
        transition value >= 65u64 && value <= 100u64 {
            true -> waiting(value)
            _ -> (|operations|::Phase::Dormant)
        }
    }
    machine waiting(value: u64) -> |operations|::Phase requires value >= 65u64 && value <= 100u64 {
        |operations|::Phase::Waiting { command: command(value - 64u64) }
    }
}

public machine phase_tag(phase: |operations|::Phase) -> u64 {
    transition phase {
        |operations|::Phase::Dormant -> (0u64)
        |operations|::Phase::Ready { command } -> command_tag(command)
        |operations|::Phase::Waiting { command } -> waiting_tag(command)
    }
}

machine waiting_tag(command: |operations|::Command) -> u64 {
    // Exhaustive constants keep the native offset out of service state.
    transition command {
        |operations|::Command::Refresh -> (65u64)
        |operations|::Command::ReadConfiguration -> (66u64)
        |operations|::Command::ValidateConfiguration -> (67u64)
        |operations|::Command::AdmitLauncher -> (68u64)
        |operations|::Command::ReleaseImage -> (69u64)
        |operations|::Command::BindLauncher -> (70u64)
        |operations|::Command::InstallWorkspace -> (71u64)
        |operations|::Command::PlaceLauncher -> (72u64)
        |operations|::Command::StartBackground -> (73u64)
        |operations|::Command::BackgroundFailed -> (74u64)
        |operations|::Command::Flush -> (75u64)
        |operations|::Command::Notify -> (76u64)
        |operations|::Command::GrantChrome -> (77u64)
        |operations|::Command::RecordLauncher -> (78u64)
        |operations|::Command::StopLauncher -> (79u64)
        |operations|::Command::ClearWorkspace -> (80u64)
        |operations|::Command::ResetSurfaces -> (81u64)
        |operations|::Command::PreparePicker -> (82u64)
        |operations|::Command::ReadPicker -> (83u64)
        |operations|::Command::ValidatePicker -> (84u64)
        |operations|::Command::AdmitPicker -> (85u64)
        |operations|::Command::BindPicker -> (86u64)
        |operations|::Command::PlacePicker -> (87u64)
        |operations|::Command::InstallPicker -> (88u64)
        |operations|::Command::RecordPicker -> (89u64)
        |operations|::Command::ReadBackground -> (90u64)
        |operations|::Command::AdmitBackground -> (91u64)
        |operations|::Command::PlaceBackground -> (92u64)
        |operations|::Command::RecordBackground -> (93u64)
        |operations|::Command::StopBackground -> (94u64)
        |operations|::Command::InspectRealm -> (95u64)
        |operations|::Command::ConfigureRealm -> (96u64)
        |operations|::Command::StartPicker -> (97u64)
        |operations|::Command::MarkHosted -> (98u64)
        |operations|::Command::RecoverStartup -> (99u64)
        |operations|::Command::Finish -> (100u64)
    }
}

public machine outcome(value: u64) -> |operations|::Outcome {
    transition value {
        0u64 -> (|operations|::Outcome::Success)
        BUSY_STATUS -> (|operations|::Outcome::Busy)
        DENIED_STATUS -> (|operations|::Outcome::Denied)
        PEER_CLOSED_STATUS -> (|operations|::Outcome::PeerClosed)
        _ -> (|operations|::Outcome::Failed { status: value })
    }
}

public machine outcome_tag(outcome: |operations|::Outcome) -> u64 {
    transition outcome {
        |operations|::Outcome::Success -> (0u64)
        |operations|::Outcome::Busy -> (BUSY_STATUS)
        |operations|::Outcome::Denied -> (DENIED_STATUS)
        |operations|::Outcome::PeerClosed -> (PEER_CLOSED_STATUS)
        |operations|::Outcome::Failed { status } -> (status)
    }
}
