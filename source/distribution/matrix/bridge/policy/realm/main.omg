// Native setup invocation -> named job/state/completion -> updated opaque state.
// The service retains sequencing only; the host keeps all resource custody.
use realm/encoding.omg;
use {service}/children/startup/realm/main.omg;
use {service}/children/startup/realm/operations.omg;

public machine realm_decision(packet: &mut [u64; 128]) -> u64 {
    transition packet[16] == 0u64 || (packet[16] >= 1u64 && packet[16] <= 36u64)
        || (packet[16] >= 65u64 && packet[16] <= 100u64) {
        true -> decoded(packet)
        _ -> (0u64)
    }
    machine decoded(packet: &mut [u64; 128]) -> u64 {
        let mut setup: |operations|::Setup;
        setup.phase = |encoding|::phase(packet[16]);
        setup.job = |encoding|::job(packet[17]);
        setup.outcome = |encoding|::outcome(packet[18]);
        setup.background_outcome = |encoding|::outcome(packet[19]);
        setup.reset_surfaces = packet[20] != 0u64;
        let result: u64 = apply(packet, &mut setup);
        packet[16] = |encoding|::phase_tag(setup.phase);
        packet[17] = |encoding|::job_tag(setup.job);
        packet[18] = |encoding|::outcome_tag(setup.outcome);
        packet[19] = |encoding|::outcome_tag(setup.background_outcome);
        packet[20] = setup.reset_surfaces as u64;
        result
    }
}

machine apply(packet: &[u64; 128], setup: &mut |operations|::Setup) -> u64 {
    transition packet[1] {
        0u64 -> begin(packet, setup)
        1u64 -> next(setup)
        2u64 -> complete(packet, setup)
        _ -> (0u64)
    }
    machine begin(packet: &[u64; 128], setup: &mut |operations|::Setup) -> u64 {
        let job: |operations|::Job = |encoding|::job(packet[2]);
        let context: |operations|::Context = |operations|::Context { configured: packet[3] != 0u64,
            busy: packet[4] != 0u64, discover: packet[5] != 0u64 };
        let accepted: bool = |main|::begin(setup, job, &context);
        accepted as u64
    }
    machine next(setup: &mut |operations|::Setup) -> u64 {
        let dispatch: |operations|::Dispatch = |main|::next(setup);
        transition dispatch {
            |operations|::Dispatch::Wait -> (0u64)
            |operations|::Dispatch::Issue { command } -> |encoding|::command_tag(command)
        }
    }
}

machine complete(packet: &[u64; 128], setup: &mut |operations|::Setup) -> u64 {
    transition packet[2] >= 1u64 && packet[2] <= 36u64 {
        true -> decoded(packet, setup)
        _ -> (0u64)
    }
    machine decoded(packet: &[u64; 128], setup: &mut |operations|::Setup) -> u64
        requires packet[2] >= 1u64 && packet[2] <= 36u64 {
        let command: |operations|::Command = |encoding|::command(packet[2]);
        let completion: |operations|::Completion = |operations|::Completion {
            command: command, outcome: |encoding|::outcome(packet[3]),
            placed: command == |operations|::Command::Refresh && packet[4] != 0u64,
            entries: |operations|::Entries {
                matrix: command == |operations|::Command::InspectRealm && (packet[4] & 1u64) != 0u64,
                login: command == |operations|::Command::InspectRealm && (packet[4] & 2u64) != 0u64,
                users: command == |operations|::Command::InspectRealm && (packet[4] & 4u64) != 0u64
            }
        };
        let accepted: bool = |main|::complete(setup, completion);
        accepted as u64
    }
}
