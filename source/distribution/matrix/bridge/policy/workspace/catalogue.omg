// Eight opaque words: ticket high-water mark, selection and three instance rows.
// Packet layout and native query tags never enter the service's catalogue.
use {service}/children/workspace/catalogue.omg;

const PUBLISH: u64 = 0u64;
const RETIRE: u64 = 1u64;
const ACTIVATE: u64 = 2u64;
const ENTRY: u64 = 3u64;
const SELECT: u64 = 4u64;
const FALLBACK: u64 = 5u64;
const ACTIVE: u64 = 6u64;
const CAPACITY: u64 = 7u64;

public machine catalogue_decision(packet: &mut [u64; 128]) -> u64 {
    let mut catalogue: |catalogue|::Catalogue;
    catalogue.last_ticket = packet[16];
    catalogue.selected = decode_position(packet[17]);
    catalogue.instances[0] = decode_instance(packet[18], packet[19]);
    catalogue.instances[1] = decode_instance(packet[20], packet[21]);
    catalogue.instances[2] = decode_instance(packet[22], packet[23]);
    let result: u64 = apply(packet, &mut catalogue);
    packet[16] = catalogue.last_ticket;
    packet[17] = encode_position(catalogue.selected);
    encode_instance(packet, 18u64, catalogue.instances[0]);
    encode_instance(packet, 20u64, catalogue.instances[1]);
    encode_instance(packet, 22u64, catalogue.instances[2]);
    result
}

machine apply(packet: &mut [u64; 128], catalogue: &mut |catalogue|::Catalogue) -> u64 {
    transition packet[1] {
        PUBLISH -> boolean(|catalogue|::publish(catalogue, packet[2], packet[3]))
        RETIRE -> boolean(|catalogue|::retire(catalogue, packet[2]))
        ACTIVATE -> boolean(|catalogue|::activate(catalogue, packet[2]))
        ENTRY -> read_entry(packet, catalogue)
        SELECT -> selection(packet, catalogue)
        FALLBACK -> fallback(packet, catalogue)
        ACTIVE -> active(packet, catalogue)
        CAPACITY -> boolean(|catalogue|::has_ticket_capacity(catalogue))
        _ -> (0u64)
    }
    machine read_entry(packet: &mut [u64; 128], catalogue: &|catalogue|::Catalogue) -> u64 {
        let entry: |catalogue|::Entry = |catalogue|::entry(catalogue, packet[2]);
        encode_entry(packet, entry)
    }
    machine selection(packet: &mut [u64; 128], catalogue: &|catalogue|::Catalogue) -> u64 {
        let selection: |catalogue|::Selection = |catalogue|::select(catalogue, packet[2], packet[3] != 0u64);
        encode_selection(packet, selection)
    }
    machine fallback(packet: &mut [u64; 128], catalogue: &|catalogue|::Catalogue) -> u64 {
        let position: |catalogue|::Position = |catalogue|::fallback(catalogue);
        transition position {
            |catalogue|::Position::App { slot } -> found(packet, slot)
            |catalogue|::Position::None -> (0u64)
        }
    }
    machine found(packet: &mut [u64; 128], slot: u64) -> u64 {
        packet[8] = slot;
        1u64
    }
    machine active(packet: &mut [u64; 128], catalogue: &|catalogue|::Catalogue) -> u64 {
        packet[8] = encode_position(catalogue.selected);
        1u64
    }
}

machine decode_position(value: u64) -> |catalogue|::Position {
    transition value == 0u64 {
        true -> (|catalogue|::Position::None)
        _ -> (|catalogue|::Position::App { slot: value })
    }
}

machine encode_position(position: |catalogue|::Position) -> u64 {
    transition position {
        |catalogue|::Position::App { slot } -> (slot)
        |catalogue|::Position::None -> (0u64)
    }
}

machine decode_instance(ticket: u64, program: u64) -> |catalogue|::Instance {
    transition ticket == 0u64 {
        true -> (|catalogue|::Instance::Empty)
        _ -> (|catalogue|::Instance::Published { ticket: ticket, program: program })
    }
}

machine encode_instance(packet: &mut [u64; 128], offset: u64, instance: |catalogue|::Instance)
    requires offset < 127u64 {
    transition instance {
        |catalogue|::Instance::Published { ticket, program } -> populated(packet, offset, ticket, program)
        |catalogue|::Instance::Empty -> populated(packet, offset, 0u64, 0u64)
    }
    machine populated(packet: &mut [u64; 128], offset: u64, ticket: u64, program: u64)
        requires offset < 127u64 {
        packet[offset] = ticket;
        packet[offset + 1u64] = program;
    }
}

machine encode_entry(packet: &mut [u64; 128], entry: |catalogue|::Entry) -> u64 {
    transition entry {
        |catalogue|::Entry::Outside -> (0u64)
        |catalogue|::Entry::Empty -> (1u64)
        |catalogue|::Entry::Present { ticket, program, selected } -> present(packet, ticket, program, selected)
    }
    machine present(packet: &mut [u64; 128], ticket: u64, program: u64, selected: bool) -> u64 {
        packet[8] = ticket;
        packet[9] = program;
        packet[10] = boolean(selected);
        2u64
    }
}

machine encode_selection(packet: &mut [u64; 128], selection: |catalogue|::Selection) -> u64 {
    transition selection {
        |catalogue|::Selection::Missing -> (0u64)
        |catalogue|::Selection::Busy { slot } -> found(packet, slot, 1u64)
        |catalogue|::Selection::Current { slot } -> found(packet, slot, 2u64)
        |catalogue|::Selection::Switch { slot } -> found(packet, slot, 3u64)
    }
    machine found(packet: &mut [u64; 128], slot: u64, kind: u64) -> u64 {
        packet[8] = slot;
        kind
    }
}

machine boolean(value: bool) -> u64 {
    value as u64
}
