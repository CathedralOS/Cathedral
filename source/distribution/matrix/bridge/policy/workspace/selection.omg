module workspace::selection;

// Native switch encoding. The service carries a typed ready/waiting command;
// numeric tags and the historical waiting offset are confined to this file.
use service::children::workspace::main;
use service::children::workspace::operation::Switch;
use service::children::workspace::operation::Command;
use service::children::workspace::operation::Phase;
use service::children::workspace::operation::Dispatch;
use service::children::workspace::operation::Completion;

const BEGIN: u64 = 0u64;
const NEXT: u64 = 1u64;
const COMPLETE: u64 = 2u64;
const CANCEL: u64 = 3u64;

public machine selection_decision(packet: &mut [u64; 128]) -> u64 {
    transition packet[16] == 0u64 || (packet[16] >= 1u64 && packet[16] <= 7u64)
        || (packet[16] >= 33u64 && packet[16] <= 39u64) {
        true -> decoded(packet)
        _ -> (0u64)
    }
    machine decoded(packet: &mut [u64; 128]) -> u64 {
        let mut work: Switch;
        work.phase = decode_phase(packet[16]);
        work.ticket = packet[17];
        work.refusal = packet[18];
        let result: u64 = apply(packet, &mut work);
        packet[16] = encode_phase(work.phase);
        packet[17] = work.ticket;
        packet[18] = work.refusal;
        result
    }
}

machine apply(packet: &[u64; 128], work: &mut Switch) -> u64 {
    transition packet[1] {
        BEGIN -> boolean(service::children::workspace::main::begin(work, packet[2]))
        NEXT -> next(work)
        COMPLETE -> completion(packet, work)
        CANCEL -> boolean(service::children::workspace::main::cancel(work, packet[2]))
        _ -> (0u64)
    }
    machine next(work: &mut Switch) -> u64 {
        let dispatch: Dispatch = service::children::workspace::main::next(work);
        transition dispatch {
            Dispatch::Issue { command } -> encode_command(command)
            Dispatch::Wait -> (0u64)
        }
    }
}

machine completion(packet: &[u64; 128], work: &mut Switch) -> u64 {
    // The fatal Failed command cannot be completed into a successful finish.
    transition packet[3] >= 1u64 && packet[3] <= 6u64 {
        true -> decoded(packet, work)
        _ -> (0u64)
    }
    machine decoded(packet: &[u64; 128], work: &mut Switch) -> u64
        requires packet[3] >= 1u64 && packet[3] <= 6u64 {
        let completion: Completion = Completion {
            ticket: packet[2], command: decode_command(packet[3]),
            status: packet[4], committed: packet[5] != 0u64
        };
        boolean(service::children::workspace::main::complete(work, completion))
    }
}

machine decode_phase(value: u64) -> Phase {
    transition value >= 1u64 && value <= 7u64 {
        true -> ready(value)
        _ -> waiting_or_dormant(value)
    }
    machine ready(value: u64) -> Phase requires value >= 1u64 && value <= 7u64 {
        Phase::Ready { command: decode_command(value) }
    }
    machine waiting_or_dormant(value: u64) -> Phase {
        transition value >= 33u64 && value <= 39u64 {
            true -> waiting(value)
            _ -> (Phase::Dormant)
        }
    }
    machine waiting(value: u64) -> Phase requires value >= 33u64 && value <= 39u64 {
        Phase::Waiting { command: decode_command(value - 32u64) }
    }
}

machine decode_command(value: u64) -> Command requires value >= 1u64 && value <= 7u64 {
    transition value {
        1u64 -> (Command::BeginScene)
        2u64 -> (Command::AwaitScene)
        3u64 -> (Command::Activate)
        4u64 -> (Command::BeginRestore)
        5u64 -> (Command::AwaitRestore)
        6u64 -> (Command::Finish)
        _ -> (Command::Failed)
    }
}

machine encode_phase(phase: Phase) -> u64 {
    transition phase {
        Phase::Ready { command } -> encode_command(command)
        Phase::Waiting { command } -> encode_waiting(command)
        Phase::Dormant -> (0u64)
    }
}

machine encode_command(command: Command) -> u64 {
    transition command {
        Command::BeginScene -> (1u64)
        Command::AwaitScene -> (2u64)
        Command::Activate -> (3u64)
        Command::BeginRestore -> (4u64)
        Command::AwaitRestore -> (5u64)
        Command::Finish -> (6u64)
        Command::Failed -> (7u64)
    }
}

machine encode_waiting(command: Command) -> u64 {
    transition command {
        Command::BeginScene -> (33u64)
        Command::AwaitScene -> (34u64)
        Command::Activate -> (35u64)
        Command::BeginRestore -> (36u64)
        Command::AwaitRestore -> (37u64)
        Command::Finish -> (38u64)
        Command::Failed -> (39u64)
    }
}

machine boolean(value: bool) -> u64 {
    value as u64
}
