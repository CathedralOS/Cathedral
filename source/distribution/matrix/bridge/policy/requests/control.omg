// Native host envelope codec. No task, connection or grant handle is transferred.
use {service}/requests/control/main.omg;
use {service}/requests/control/wire.omg;
use {service}/requests/control/operation.omg;

public machine control_decision(packet: &mut [u64; 128]) -> u64 {
    let facts: |operation|::Facts = |operation|::Facts {
        owner: packet[2] != 0u64, loss: packet[3] != 0u64,
        launching: packet[4] != 0u64, storing: packet[5] != 0u64,
        occupied: packet[6], unavailable: packet[7], pending: packet[8], standing: packet[9],
        children: packet[10], images: packet[11], private_pages: packet[12], reader_pages: packet[13],
        supported_imports: packet[14], surfaces: packet[15], configure_deadline: packet[24]
    };
    let mut words: [u64; 8];
    words[0] = packet[16];
    words[1] = packet[17];
    words[2] = packet[18];
    words[3] = packet[19];
    words[4] = packet[20];
    words[5] = packet[21];
    words[6] = packet[22];
    words[7] = packet[23];
    let request: |operation|::Request = |wire|::decode(&words);
    let decision: |operation|::Decision = |main|::decide(&facts, request);
    packet[25] = decision.slot;
    packet[26] = decision.deadline;
    encode(decision.operation)
}

machine encode(operation: |operation|::Operation) -> u64 {
    transition operation {
        |operation|::Operation::Unhandled -> (0u64)
        |operation|::Operation::Deny -> (1u64)
        |operation|::Operation::Busy -> (2u64)
        |operation|::Operation::Invalid -> (3u64)
        |operation|::Operation::Survey -> (4u64)
        |operation|::Operation::Stored -> (5u64)
        |operation|::Operation::Forward -> (6u64)
        |operation|::Operation::Images -> (7u64)
        |operation|::Operation::Fallback -> (8u64)
        |operation|::Operation::Management -> (9u64)
        |operation|::Operation::Configure -> (10u64)
        |operation|::Operation::Restore -> (11u64)
        |operation|::Operation::Imports -> (12u64)
        |operation|::Operation::Pages -> (13u64)
        |operation|::Operation::Memory -> (14u64)
        |operation|::Operation::Policy -> (15u64)
        |operation|::Operation::Placement -> (16u64)
        |operation|::Operation::Spawn -> (17u64)
        |operation|::Operation::Run -> (18u64)
        |operation|::Operation::Stop -> (19u64)
    }
}
