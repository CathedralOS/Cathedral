// Temporary native envelope -> authenticated facts and real IPC words -> policy.
use {service}/requests/main.omg;
use {service}/requests/owner.omg;
use requests/control.omg;
use {service}/requests/wire.omg;
use {service}/requests/operations.omg;

public machine request_decision(packet: &mut [u64; 128]) -> u64 {
    transition packet[1] {
        4u64 -> |control|::control_decision(packet)
        _ -> ordinary(packet)
    }
}

machine ordinary(packet: &[u64; 128]) -> u64 {
    let facts: |operations|::Facts = |operations|::Facts { caller: caller(packet[2]),
        separate_producer: packet[4] != 0u64, storage_stream: packet[5] != 0u64 };
    let message: |operations|::Message = decode_message(packet);
    transition packet[1] {
        0u64 -> route(&facts, message)
        1u64 -> fallback(&facts, message)
        2u64 -> effects(&facts, message, packet[6], packet[7] != 0u64)
        3u64 -> attachment(&facts, message)
        _ -> (0u64)
    }
    machine route(facts: &|operations|::Facts, message: |operations|::Message) -> u64 {
        let operation: |operations|::Operation = |main|::route(facts, message);
        encode_operation(operation)
    }
    machine fallback(facts: &|operations|::Facts, message: |operations|::Message) -> u64 {
        let operation: |operations|::Operation = |owner|::fallback(facts, message);
        encode_operation(operation)
    }
    machine attachment(facts: &|operations|::Facts, message: |operations|::Message) -> u64 {
        let operation: |operations|::Operation = |main|::attachment(facts, message);
        encode_operation(operation)
    }
    machine effects(facts: &|operations|::Facts, message: |operations|::Message, children: u64, success: bool) -> u64 {
        let effects: |owner|::Effects = |owner|::effects(facts, message, children, success);
        encode_effects(&effects)
    }
}

machine decode_message(packet: &[u64; 128]) -> |operations|::Message {
    transition packet[3] != 0u64 {
        true -> present(packet)
        _ -> (|operations|::Message::Missing)
    }
    machine present(packet: &[u64; 128]) -> |operations|::Message {
        let mut words: [u64; 8];
        words[0] = packet[16];
        words[1] = packet[17];
        words[2] = packet[18];
        words[3] = packet[19];
        words[4] = packet[20];
        words[5] = packet[21];
        words[6] = packet[22];
        words[7] = packet[23];
        |wire|::decode(&words)
    }
}

machine caller(value: u64) -> |operations|::Caller {
    transition value {
        1u64 -> (|operations|::Caller::Owner)
        2u64 -> (|operations|::Caller::Source)
        3u64 -> (|operations|::Caller::Child)
        4u64 -> (|operations|::Caller::Storage)
        5u64 -> (|operations|::Caller::Producer)
        _ -> (|operations|::Caller::Unknown)
    }
}

machine encode_operation(operation: |operations|::Operation) -> u64 {
    transition operation {
        |operations|::Operation::Deny -> (0u64)
        |operations|::Operation::Producer -> (1u64)
        |operations|::Operation::Acquire -> (2u64)
        |operations|::Operation::Resolve -> (3u64)
        |operations|::Operation::Pixel -> (4u64)
        |operations|::Operation::Owner -> (5u64)
        |operations|::Operation::RecoveryOwner -> (6u64)
        |operations|::Operation::StorageOwner -> (7u64)
        |operations|::Operation::LayoutOwner -> (8u64)
        |operations|::Operation::Source -> (9u64)
        |operations|::Operation::Storage -> (10u64)
        |operations|::Operation::DenyNow -> (11u64)
        |operations|::Operation::Launch -> (12u64)
        |operations|::Operation::Close -> (13u64)
        |operations|::Operation::Fund -> (14u64)
        |operations|::Operation::AppEntry -> (15u64)
        |operations|::Operation::Select -> (16u64)
        |operations|::Operation::Layout -> (17u64)
        |operations|::Operation::Status -> (18u64)
        |operations|::Operation::SaveAvailability -> (19u64)
        |operations|::Operation::RetrySaves -> (20u64)
        |operations|::Operation::ManagedTask -> (21u64)
        |operations|::Operation::RetryLauncher -> (22u64)
        |operations|::Operation::Terminate -> (23u64)
        |operations|::Operation::Present -> (24u64)
        |operations|::Operation::Surface -> (25u64)
        |operations|::Operation::World -> (26u64)
    }
}

machine encode_effects(effects: &|owner|::Effects) -> u64 {
    (effects.changed as u64) | clearing(effects.clearing) | replay(effects.replay)
        | ((effects.remember_storage as u64) << 5u64)
}

machine clearing(value: |owner|::Clearing) -> u64 {
    transition value {
        |owner|::Clearing::None -> (0u64)
        |owner|::Clearing::Slot -> (2u64)
        |owner|::Clearing::Pair -> (4u64)
    }
}

machine replay(value: |owner|::Replay) -> u64 {
    transition value {
        |owner|::Replay::None -> (0u64)
        |owner|::Replay::Slot -> (8u64)
        |owner|::Replay::All -> (16u64)
    }
}
