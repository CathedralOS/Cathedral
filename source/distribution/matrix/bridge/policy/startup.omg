// Temporary native encoding. Retry budgets, child roles and recovery decisions
// belong to the typed startup policy; no kernel identity enters this packet.
use {service}/children/startup/main.omg;

const RETIRED: u64 = 0u64;
const PICKER_STARTED: u64 = 1u64;
const SELECTION_FAILED: u64 = 2u64;
const BACKGROUND_FAILED: u64 = 3u64;
const TAKE_PICKER: u64 = 4u64;
const TAKE_BACKGROUND: u64 = 5u64;

public machine startup_decision(packet: &mut [u64; 128]) -> u64 {
    let mut startup: |main|::Startup;
    startup.picker_attempts = packet[16];
    startup.picker_pending = packet[17] == 1u64;
    startup.selection_failed = packet[18] == 1u64;
    startup.background_pending = packet[19] == 1u64;
    startup.background_retry_spent = packet[20] != 0u64;
    let result: u64 = apply(packet, &mut startup);
    packet[16] = startup.picker_attempts;
    packet[17] = boolean(startup.picker_pending);
    packet[18] = boolean(startup.selection_failed);
    packet[19] = boolean(startup.background_pending);
    packet[20] = boolean(startup.background_retry_spent);
    result
}

machine apply(packet: &[u64; 128], startup: &mut |main|::Startup) -> u64 {
    transition packet[1] {
        RETIRED -> retired(packet, startup)
        PICKER_STARTED -> mode(|main|::picker_started(startup))
        SELECTION_FAILED -> retirement(|main|::selection_failed(startup, packet[2] != 0u64))
        BACKGROUND_FAILED -> background(startup)
        TAKE_PICKER -> picker(|main|::take_picker(startup, packet[2] != 0u64))
        TAKE_BACKGROUND -> boolean(|main|::take_background(startup, packet[2] != 0u64))
        _ -> (0u64)
    }
    machine retired(packet: &[u64; 128], startup: &mut |main|::Startup) -> u64 {
        let mut context: |main|::Context;
        context.login = packet[4] == 1u64;
        context.entered = packet[5] == 1u64;
        context.workspace = packet[6] == 1u64;
        context.owner_recovers = packet[7] == 1u64;
        let effect: |main|::RetirementEffect = |main|::child_retired(
            startup, role(packet[2]), packet[3] == 1u64, &context
        );
        retirement(effect)
    }
    machine background(startup: &mut |main|::Startup) -> u64 {
        |main|::background_failed(startup);
        0u64
    }
}

machine role(value: u64) -> |main|::ChildRole {
    transition value {
        0u64 -> (|main|::ChildRole::Picker)
        1u64 -> (|main|::ChildRole::User)
        2u64 -> (|main|::ChildRole::Background)
        _ -> (|main|::ChildRole::Other)
    }
}

machine retirement(effect: |main|::RetirementEffect) -> u64 {
    transition effect {
        |main|::RetirementEffect::ReturnToPicker -> (1u64)
        _ -> (0u64)
    }
}

machine mode(value: |main|::PickerMode) -> u64 {
    transition value {
        |main|::PickerMode::SelectionFailed -> (2u64)
        _ -> (1u64)
    }
}

machine picker(action: |main|::PickerAction) -> u64 {
    transition action {
        |main|::PickerAction::Restart -> (1u64)
        |main|::PickerAction::Exhausted -> (2u64)
        _ -> (0u64)
    }
}

machine boolean(value: bool) -> u64 {
    transition value {
        true -> (1u64)
        _ -> (0u64)
    }
}
