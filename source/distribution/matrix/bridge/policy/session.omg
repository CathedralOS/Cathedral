// Native reference adapter. Only this layer sees packet slots, operation numbers
// and the issued-command marker. The service policy consumes named facts/commands.
use {service}/main.omg;
use {service}/progress.omg;
use {service}/operations.omg;
use session_wire.omg;

const ISSUED: u64 = 64u64;
public machine session_decision(packet: &mut [u64; 128]) -> u64 {
    transition packet[1] {
        0u64 -> command(packet)
        1u64 -> completed(packet)
        _ -> (0u64)
    }
}

machine command(packet: &mut [u64; 128]) -> u64 {
    transition packet[16] {
        0u64 -> issue(packet, |session_wire|::INTERACTION)
        _ -> pending(packet)
    }
    machine pending(packet: &mut [u64; 128]) -> u64 {
        transition packet[16] >= |session_wire|::INTERACTION && packet[16] <= |session_wire|::DISCONNECT {
            true -> select(packet)
            _ -> (0u64)
        }
    }
    machine select(packet: &mut [u64; 128]) -> u64 {
        let mut facts: |operations|::TurnFacts;
        facts.interaction_busy = (packet[2] & |session_wire|::BUSY) != 0u64;
        facts.launch_ready = (packet[2] & |session_wire|::READY_LAUNCH) != 0u64;
        facts.refresh_ready = (packet[2] & |session_wire|::REFRESH_READY) != 0u64;
        facts.publishing = (packet[2] & |session_wire|::PUBLISHING) != 0u64;
        facts.deferred_ready = (packet[2] & |session_wire|::DEFERRED_READY) != 0u64;
        facts.deferred_empty = (packet[2] & |session_wire|::DEFERRED_EMPTY) != 0u64;
        facts.storing = (packet[2] & |session_wire|::STORING) != 0u64;
        facts.can_poll = (packet[2] & |session_wire|::CAN_POLL) != 0u64;
        facts.has_input_wake = (packet[2] & |session_wire|::HAS_WAKE) != 0u64;
        facts.event_blocked = (packet[2] & |session_wire|::EVENT_BLOCKED) != 0u64;
        let command: |operations|::Command = |main|::choose_work(|session_wire|::decode_command(packet[16]), &facts, |session_wire|::decode_event(packet[3]));
        issue(packet, |session_wire|::encode_command(command))
    }
}

machine issue(packet: &mut [u64; 128], command: u64) -> u64 {
    transition command <= |session_wire|::INVALID {
        true -> record(packet, command)
        _ -> (0u64)
    }
    machine record(packet: &mut [u64; 128], command: u64) -> u64 requires command <= |session_wire|::INVALID {
        packet[16] = command + ISSUED;
        command
    }
}

machine completed(packet: &mut [u64; 128]) -> u64 {
    transition packet[2] >= |session_wire|::INTERACTION && packet[2] <= |session_wire|::REQUEST
    && packet[16] == packet[2] + ISSUED {
        true -> advance(packet)
        _ -> (0u64)
    }
    machine advance(packet: &mut [u64; 128]) -> u64 {
        let command: |operations|::Command = |progress|::following_work(|session_wire|::decode_command(packet[2]), packet[3] != 0u64);
        let following: u64 = |session_wire|::encode_command(command);
        packet[16] = following;
        packet[17] = |session_wire|::observations(following);
        1u64
    }
}
