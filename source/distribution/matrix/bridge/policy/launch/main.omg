// Temporary Rust-call routing and encoding. Workflow state is private host
// storage; command tags, the waiting offset and role bits do not enter policy.
use {service}/children/launch/main.omg;
use {service}/children/launch/operation.omg;
use {service}/children/launch/roles.omg;
use launch/admission.omg;
use launch/imports.omg;
use launch/declaration.omg;
use launch/image.omg;

const BEGIN: u64 = 0u64;
const NEXT: u64 = 1u64;
const COMPLETE: u64 = 2u64;
const CANCEL: u64 = 3u64;
const ACCEPTS: u64 = 4u64;

public machine launch_decision(packet: &mut [u64; 128]) -> u64 {
    transition packet[1] {
        BEGIN -> workflow(packet)
        NEXT -> workflow(packet)
        COMPLETE -> workflow(packet)
        CANCEL -> workflow(packet)
        ACCEPTS -> workflow(packet)
        5u64 -> |admission|::launch_admission(packet)
        6u64 -> role_plan(packet)
        7u64 -> boolean(|roles|::needs_picker_lookup(packet[2] != 0u64, packet[3], packet[4] != 0u64))
        8u64 -> boolean(|roles|::matches_picker(packet[2], packet[3], packet[4], packet[5]))
        9u64 -> |imports|::import_binding(packet)
        10u64 -> |imports|::import_binding(packet)
        11u64 -> |declaration|::import_declaration(packet)
        12u64 -> |image|::import_image(packet)
        13u64 -> |image|::import_image(packet)
        _ -> (0u64)
    }
}

machine workflow(packet: &mut [u64; 128]) -> u64 {
    // Refuse corrupt opaque state instead of decoding it as a fresh operation.
    transition packet[16] == 0u64 || (packet[16] >= 1u64 && packet[16] <= 10u64)
        || (packet[16] >= 33u64 && packet[16] <= 42u64) {
        true -> decoded(packet)
        _ -> (0u64)
    }
    machine decoded(packet: &mut [u64; 128]) -> u64 {
        let mut launch: |operation|::Launch;
        launch.phase = decode_phase(packet[16]);
        launch.ticket = packet[17];
        launch.plan = decode_plan(packet[18]);
        launch.status = packet[19];
        launch.child_admitted = packet[20] != 0u64;
        launch.picker_retired = packet[21] != 0u64;
        let result: u64 = apply(packet, &mut launch);
        packet[16] = encode_phase(launch.phase);
        packet[17] = launch.ticket;
        packet[18] = encode_plan(launch.plan);
        packet[19] = launch.status;
        packet[20] = boolean(launch.child_admitted);
        packet[21] = boolean(launch.picker_retired);
        result
    }
}

machine apply(packet: &[u64; 128], launch: &mut |operation|::Launch) -> u64 {
    transition packet[1] {
        BEGIN -> begin(packet, launch)
        NEXT -> next(launch)
        COMPLETE -> completion(packet, launch)
        CANCEL -> boolean(|main|::cancel(launch, packet[2]))
        ACCEPTS -> completion(packet, launch)
        _ -> (0u64)
    }
    machine begin(packet: &[u64; 128], launch: &mut |operation|::Launch) -> u64 {
        let plan: |operation|::Plan = decode_plan(packet[3]);
        let accepted: bool = |main|::begin(launch, packet[2], plan);
        boolean(accepted)
    }
    machine next(launch: &mut |operation|::Launch) -> u64 {
        let dispatch: |operation|::Dispatch = |main|::next(launch);
        encode_dispatch(dispatch)
    }
}

machine completion(packet: &[u64; 128], launch: &mut |operation|::Launch) -> u64 {
    transition packet[3] >= 1u64 && packet[3] <= 10u64 {
        true -> decoded(packet, launch)
        _ -> (0u64)
    }
    machine decoded(packet: &[u64; 128], launch: &mut |operation|::Launch) -> u64
        requires packet[3] >= 1u64 && packet[3] <= 10u64 {
        let completion: |operation|::Completion = |operation|::Completion {
            ticket: packet[2], command: decode_command(packet[3]),
            status: packet[4], requires_storage: packet[5] != 0u64
        };
        transition packet[1] == COMPLETE {
            true -> boolean(|main|::complete(launch, completion))
            _ -> boolean(|main|::accepts(launch, completion.ticket, completion.command))
        }
    }
}

machine role_plan(packet: &[u64; 128]) -> u64 {
    let context: |roles|::Context = |roles|::Context {
        login: packet[2] != 0u64, entered: packet[3] != 0u64,
        target: packet[4], desktop: packet[5] != 0u64,
        requester: decode_requester(packet[6])
    };
    encode_plan(|roles|::plan(&context))
}

machine decode_requester(value: u64) -> |roles|::Requester {
    transition value != 0u64 {
        true -> child(value)
        _ -> (|roles|::Requester::Owner)
    }
    machine child(value: u64) -> |roles|::Requester requires value != 0u64 {
        |roles|::Requester::Child { slot: value - 1u64 }
    }
}

machine decode_plan(flags: u64) -> |operation|::Plan {
    |operation|::Plan {
        retire_picker: (flags & 1u64) != 0u64,
        place_child: (flags & 2u64) != 0u64,
        activate_desktop: (flags & 4u64) != 0u64
    }
}

machine encode_plan(plan: |operation|::Plan) -> u64 {
    (plan.retire_picker as u64) | ((plan.place_child as u64) << 1u64)
        | ((plan.activate_desktop as u64) << 2u64)
}

machine decode_phase(value: u64) -> |operation|::Phase {
    transition value >= 1u64 && value <= 10u64 {
        true -> ready(value)
        _ -> waiting_or_dormant(value)
    }
    machine ready(value: u64) -> |operation|::Phase requires value >= 1u64 && value <= 10u64 {
        |operation|::Phase::Ready { command: decode_command(value) }
    }
    machine waiting_or_dormant(value: u64) -> |operation|::Phase {
        transition value >= 33u64 && value <= 42u64 {
            true -> waiting(value)
            _ -> (|operation|::Phase::Dormant)
        }
    }
    machine waiting(value: u64) -> |operation|::Phase requires value >= 33u64 && value <= 42u64 {
        |operation|::Phase::Waiting { command: decode_command(value - 32u64) }
    }
}

machine decode_command(value: u64) -> |operation|::Command requires value >= 1u64 && value <= 10u64 {
    transition value {
        1u64 -> (|operation|::Command::Read)
        2u64 -> (|operation|::Command::RetirePicker)
        3u64 -> (|operation|::Command::Admit)
        4u64 -> (|operation|::Command::Bind)
        5u64 -> (|operation|::Command::Place)
        6u64 -> (|operation|::Command::Activate)
        7u64 -> (|operation|::Command::Publish)
        8u64 -> (|operation|::Command::Rollback)
        9u64 -> (|operation|::Command::RestorePicker)
        _ -> (|operation|::Command::Finish)
    }
}

machine encode_dispatch(dispatch: |operation|::Dispatch) -> u64 {
    transition dispatch {
        |operation|::Dispatch::Issue { command } -> encode_command(command)
        |operation|::Dispatch::Wait -> (0u64)
    }
}

machine encode_phase(phase: |operation|::Phase) -> u64 {
    transition phase {
        |operation|::Phase::Ready { command } -> encode_command(command)
        |operation|::Phase::Waiting { command } -> encode_waiting(command)
        |operation|::Phase::Dormant -> (0u64)
    }
}

machine encode_command(command: |operation|::Command) -> u64 {
    transition command {
        |operation|::Command::Read -> (1u64)
        |operation|::Command::RetirePicker -> (2u64)
        |operation|::Command::Admit -> (3u64)
        |operation|::Command::Bind -> (4u64)
        |operation|::Command::Place -> (5u64)
        |operation|::Command::Activate -> (6u64)
        |operation|::Command::Publish -> (7u64)
        |operation|::Command::Rollback -> (8u64)
        |operation|::Command::RestorePicker -> (9u64)
        |operation|::Command::Finish -> (10u64)
    }
}

machine encode_waiting(command: |operation|::Command) -> u64 {
    transition command {
        |operation|::Command::Read -> (33u64)
        |operation|::Command::RetirePicker -> (34u64)
        |operation|::Command::Admit -> (35u64)
        |operation|::Command::Bind -> (36u64)
        |operation|::Command::Place -> (37u64)
        |operation|::Command::Activate -> (38u64)
        |operation|::Command::Publish -> (39u64)
        |operation|::Command::Rollback -> (40u64)
        |operation|::Command::RestorePicker -> (41u64)
        |operation|::Command::Finish -> (42u64)
    }
}

machine boolean(value: bool) -> u64 {
    value as u64
}
