// Native facts become named policy inputs; refusal codes stay at this seam.
use {service}/children/launch/admission.omg;
use {service}/children/launch/roles.omg;

const BUSY: u64 = 18446744073709551600u64;
const DENIED: u64 = 18446744073709551603u64;
const NO_MEMORY: u64 = 18446744073709551604u64;
const INVALID_ARGUMENT: u64 = 18446744073709551594u64;

public machine launch_admission(packet: &mut [u64; 128]) -> u64 {
    let request: |admission|::Request = |admission|::Request {
        program_present: packet[11] != 0u64,
        withheld_imports: packet[12], supported_imports: packet[13]
    };
    let facts: |admission|::Facts = |admission|::Facts {
        busy: packet[2] != 0u64, desktop: packet[3] != 0u64,
        exact_chrome: packet[4] != 0u64, requester: requester(packet[5]),
        occupied_slots: packet[6], unavailable_connections: packet[7],
        storing: packet[8] != 0u64, has_receipt: packet[9] != 0u64,
        has_ticket: packet[10] != 0u64, standing_slots: packet[14],
        has_storage_binding: packet[15] != 0u64
    };
    let decision: |admission|::Decision = |admission|::admit(&request, &facts);
    transition decision {
        |admission|::Decision::Admitted { slot } -> admitted(packet, slot)
        |admission|::Decision::TargetRefused { slot, reason } -> target_refused(packet, slot, reason)
        |admission|::Decision::Refused { reason } -> refused(packet, reason)
    }
    machine admitted(packet: &mut [u64; 128], slot: u64) -> u64 {
        packet[24] = slot;
        0u64
    }
    machine target_refused(packet: &mut [u64; 128], slot: u64, reason: |admission|::Refusal) -> u64 {
        packet[24] = slot;
        refused(packet, reason)
    }
}

machine requester(value: u64) -> |roles|::Requester {
    transition value == 18446744073709551615u64 {
        true -> (|roles|::Requester::Owner)
        _ -> (|roles|::Requester::Child { slot: value })
    }
}

machine refused(packet: &mut [u64; 128], reason: |admission|::Refusal) -> u64 {
    transition reason {
        |admission|::Refusal::Busy -> (BUSY)
        |admission|::Refusal::Denied -> (DENIED)
        |admission|::Refusal::Capacity -> (NO_MEMORY)
        |admission|::Refusal::InvalidArguments -> (INVALID_ARGUMENT)
        |admission|::Refusal::AppPositionsFull -> full(packet)
    }
    machine full(packet: &mut [u64; 128]) -> u64 {
        packet[25] = 1u64;
        NO_MEMORY
    }
}
