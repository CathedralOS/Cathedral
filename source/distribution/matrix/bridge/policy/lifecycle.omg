// Temporary Rust native-call encoding. The close policy never sees this packet.
use {service}/children/control/main.omg;

const BEGIN_SURVEY: u64 = 3u64;
const RECORD_QUERY: u64 = 4u64;
const RECORD_ANSWER: u64 = 5u64;
const FINISH_SURVEY: u64 = 6u64;
const DECIDE_CLOSE: u64 = 7u64;
const WAIT_FOR_CLOSE: u64 = 8u64;
public machine lifecycle_decision(packet: &mut [u64; 128]) -> u64 {
    let mut survey: |main|::LossSurvey;
    survey.pending_children = packet[16];
    survey.loss_possible = packet[17] != 0u64;
    transition packet[0] {
        BEGIN_SURVEY -> begin(packet, &mut survey)
        RECORD_QUERY -> queried(packet, &mut survey)
        RECORD_ANSWER -> answered(packet, &mut survey)
        FINISH_SURVEY -> conclusion(|main|::finish_survey(&survey, packet[1] != 0u64))
        DECIDE_CLOSE -> close_result(|main|::decide_close(packet[1] != 0u64, child_answer(packet)))
        WAIT_FOR_CLOSE -> boolean_result(|main|::should_wait_for_close(packet[1] != 0u64, packet[2] != 0u64))
        _ -> (0u64)
    }
    machine begin(packet: &mut [u64; 128], survey: &mut |main|::LossSurvey) -> u64 {
        let accepted: bool = |main|::begin_survey(packet[1] != 0u64, survey);
        publish_survey(packet, survey, accepted)
    }
    machine queried(packet: &mut [u64; 128], survey: &mut |main|::LossSurvey) -> u64 {
        let accepted: bool = |main|::record_query(survey, packet[1], packet[2] == 1u64);
        publish_survey(packet, survey, accepted)
    }
    machine answered(packet: &mut [u64; 128], survey: &mut |main|::LossSurvey) -> u64 {
        let answer: |main|::LossAnswer = child_answer(packet);
        let accepted: bool = |main|::record_answer(survey, packet[1], answer);
        publish_survey(packet, survey, accepted)
    }
}

machine child_answer(packet: &[u64; 128]) -> |main|::LossAnswer {
    // Require transport success and the complete canonical empty-loss reply.
    transition packet[2] == 1u64
    && packet[24] == 0u64 && packet[25] == 0u64
    && packet[26] == 0u64 && packet[27] == 0u64
    && packet[28] == 0u64 && packet[29] == 0u64
    && packet[30] == 0u64 && packet[31] == 0u64 {
        true -> (|main|::LossAnswer::NothingToLose)
        _ -> (|main|::LossAnswer::Uncertain)
    }
}

machine publish_survey(packet: &mut [u64; 128], survey: &|main|::LossSurvey, accepted: bool) -> u64 {
    packet[16] = survey.pending_children;
    packet[17] = boolean_result(survey.loss_possible);
    boolean_result(accepted)
}

machine boolean_result(value: bool) -> u64 {
    transition value {
        true -> (1u64)
        _ -> (0u64)
    }
}

machine conclusion(value: |main|::SurveyConclusion) -> u64 {
    transition value {
        |main|::SurveyConclusion::Waiting -> (0u64)
        |main|::SurveyConclusion::NothingToLose -> (1u64)
        _ -> (2u64)
    }
}

machine close_result(value: |main|::CloseDecision) -> u64 {
    transition value {
        |main|::CloseDecision::Stop -> (2u64)
        |main|::CloseDecision::AlreadyStopped -> (3u64)
        _ -> (1u64)
    }
}
