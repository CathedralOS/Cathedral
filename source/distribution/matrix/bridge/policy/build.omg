use main.omg;

machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_matrix_policy");
    Build::depend_as(builder, "service", Source::Path {
        location: "../../service"
    }
    );
    Build::depend_as(builder, "services", Source::Path {
        location: "../../../../platform/contracts/imports"
    });
    Build::select_provider<|main|::Policy, |main|::PolicyProvider>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |main|::policy_entry);
}
