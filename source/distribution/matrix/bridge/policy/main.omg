// One temporary native export dispatches to independently owned stock policies.
use configuration/main.omg;
use lifecycle.omg;
use recovery.omg;
use startup.omg;
use launch/main.omg as launch_main;
use workspace/main.omg as workspace_main;
use session.omg;
use requests/main.omg as requests_main;
use realm/main.omg as realm_main;
use resources.omg;

public boundary trait Policy {
    machine decide(p: &mut [u64; 128]) -> u64 reaches;
}
public PolicyProvider satisfies Policy {
    machine decide(p: &mut [u64; 128]) -> u64 {
        choose(p)
    }
}

public machine choose(p: &mut [u64; 128]) -> u64 {
    transition p[0] {
        1u64 -> |main|::configuration_decision(p)
        2u64 -> |main|::configuration_decision(p)
        18u64 -> |main|::configuration_decision(p)
        9u64 -> |recovery|::recovery_decision(p)
        10u64 -> |startup|::startup_decision(p)
        11u64 -> |launch_main|::launch_decision(p)
        12u64 -> |workspace_main|::workspace_decision(p)
        13u64 -> |workspace_main|::workspace_decision(p)
        14u64 -> |session|::session_decision(p)
        15u64 -> |requests_main|::request_decision(p)
        16u64 -> |realm_main|::realm_decision(p)
        17u64 -> |resources|::resources_decision(p)
        _ -> |lifecycle|::lifecycle_decision(p)
    }
}

public machine policy_entry() reaches Policy invokes Policy {
    let mut p: [u64; 128];
    let result: u64 = Policy::decide(&mut p);
}
