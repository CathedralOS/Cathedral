// Private native-call codec. Domain policy sees roles, declarations and outcomes;
// exact grants, transport funding and disjoint allocation remain with the host.
use {service}/children/launch/resources/main.omg;
use {service}/children/launch/resources/recipes.omg;
use {service}/children/launch/resources/surfaces.omg;

const RECIPE: u64 = 1u64;
const ALLOCATE: u64 = 2u64;
const SURFACES: u64 = 3u64;
const INVALID_ARGUMENT: u64 = 18446744073709551594u64;
const NO_MEMORY: u64 = 18446744073709551604u64;

public machine resources_decision(packet: &mut [u64; 128]) -> u64 {
    transition packet[1] {
        RECIPE -> recipe(packet)
        ALLOCATE -> allocate(packet)
        SURFACES -> surfaces(packet)
        _ -> (INVALID_ARGUMENT)
    }
}

machine recipe(packet: &mut [u64; 128]) -> u64 {
    let private_pages: u64 = packet[3];
    let reader_pages: u64 = packet[4];
    let surfaces: u64 = packet[5];
    let backed_surfaces: u64 = packet[6];
    transition packet[2] {
        1u64 -> encode_offer(packet, |recipes|::offer(|recipes|::Role::Launcher { private_pages: private_pages }))
        2u64 -> encode_offer(packet, |recipes|::offer(|recipes|::Role::Picker { backed_surfaces: backed_surfaces }))
        3u64 -> encode_offer(packet, |recipes|::offer(|recipes|::Role::Background))
        4u64 -> encode_offer(packet, |recipes|::offer(|recipes|::Role::Workspace { private_pages: private_pages, reader_pages: reader_pages, surfaces: surfaces }))
        5u64 -> encode_offer(packet, |recipes|::offer(|recipes|::Role::User { backed_surfaces: backed_surfaces }))
        _ -> (INVALID_ARGUMENT)
    }
}

machine encode_offer(packet: &mut [u64; 128], decision: |recipes|::OfferDecision) -> u64 {
    transition decision {
        |recipes|::OfferDecision::Offered { offer } -> publish(packet, offer)
        |recipes|::OfferDecision::InsufficientBacking -> (NO_MEMORY)
    }
    machine publish(packet: &mut [u64; 128], offer: |recipes|::Offer) -> u64 {
        packet[32] = offer.private_pages;
        packet[33] = offer.reader_pages;
        packet[34] = offer.channels;
        packet[35] = offer.descendants;
        packet[36] = offer.cpu;
        packet[37] = offer.imports;
        packet[38] = offer.surfaces;
        0u64
    }
}

machine allocate(packet: &mut [u64; 128]) -> u64 {
    let offered: |main|::Capacity = |main|::Capacity {
        private_pages: packet[4], reader_pages: packet[5],
        channels: packet[13], descendants: packet[14]
    };
    let profile: |main|::Profile = decode_profile(packet);
    let declaration: |main|::Declaration = decode_declaration(packet);
    let decision: |main|::Admission = |main|::allocate(&offered, profile, declaration, packet[2] != 0u64 && packet[3] != 0u64);
    transition decision {
        |main|::Admission::Accepted { allocation } -> encode_allocation(packet, allocation)
        |main|::Admission::Refused -> (NO_MEMORY)
    }
}

machine decode_profile(packet: &[u64; 128]) -> |main|::Profile {
    transition packet[6] != 0u64 {
        true -> (|main|::Profile::Required { private_pages: packet[7], reader_pages: packet[8], surfaces: packet[9] })
        _ -> (|main|::Profile::Unspecified)
    }
}

machine decode_declaration(packet: &[u64; 128]) -> |main|::Declaration {
    transition packet[10] != 0u64 {
        true -> (|main|::Declaration::Required { channels: packet[11], descendants: packet[12] })
        _ -> (|main|::Declaration::Unspecified)
    }
}

machine encode_allocation(packet: &mut [u64; 128], allocation: |main|::Allocation) -> u64 {
    packet[32] = allocation.capacity.private_pages;
    packet[33] = allocation.capacity.reader_pages;
    packet[34] = allocation.capacity.channels;
    packet[35] = allocation.capacity.descendants;
    transition allocation.surfaces {
        |main|::SurfaceRequest::Request { count } -> requested(packet, count)
        |main|::SurfaceRequest::Inherit -> inherited(packet)
    }
    machine requested(packet: &mut [u64; 128], count: u64) -> u64 {
        packet[36] = 1u64;
        packet[37] = count;
        0u64
    }
    machine inherited(packet: &mut [u64; 128]) -> u64 {
        packet[36] = 0u64;
        packet[37] = 0u64;
        0u64
    }
}

machine surfaces(packet: &mut [u64; 128]) -> u64 {
    let demand: |surfaces|::Demand = |surfaces|::Demand {
        requested: packet[2], ceiling: packet[3],
        has_descendants: packet[4] != 0u64, explicit_profile: packet[5] != 0u64,
        backed: packet[6]
    };
    let preference: |surfaces|::Preference = |surfaces|::preferred(&demand);
    transition preference {
        |surfaces|::Preference::Preferred { count } -> publish(packet, count)
        |surfaces|::Preference::ExceedsCeiling -> (NO_MEMORY)
    }
    machine publish(packet: &mut [u64; 128], count: u64) -> u64 {
        packet[32] = count;
        0u64
    }
}
