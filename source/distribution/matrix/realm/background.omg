// Background has presentation only; failed placement must reclaim its admitted task.
use operations;
public machine background_next(p: &mut [u64; 128]) -> u64 {
    transition p[3] == 0u64 { true -> success(p) _ -> failed(p) }
    state failed(p: &mut [u64; 128]) -> u64 {
        p[18] = p[3]; transition p[2] == PLACE_BACKGROUND { true -> (STOP_BACKGROUND) _ -> (FINISH) }
    }
    state success(p: &mut [u64; 128]) -> u64 {
        transition p[2] { READ_BACKGROUND -> (ADMIT_BACKGROUND) ADMIT_BACKGROUND -> (PLACE_BACKGROUND) PLACE_BACKGROUND -> (RECORD_BACKGROUND) _ -> (FINISH) }
    }
}
