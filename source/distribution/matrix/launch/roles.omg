// Role facts are host-authenticated local observations, never caller-supplied claims.
// p2 login, p3 entered, p4 target slot, p5 desktop, p6 requester+1 (zero for owner).
public machine launch_roles(p: &mut [u64; 128]) -> u64 {
    let selection: bool = p[2] != 0u64 && p[3] == 0u64 && p[4] == 1u64;
    let child: bool = p[6] != 0u64;
    let desktop: bool = p[5] != 0u64 && p[6] == 1u64;
    (selection as u64) | ((child as u64) << 1u64) | ((desktop as u64) << 2u64)
}
// p2 upstream, p3 slot, p4 scope: root owner's first picker needs realm lookup.
public machine inspect_picker(p: &mut [u64; 128]) -> u64 {
    transition p[2] == 0u64 && p[3] == 0u64 && p[4] != 0u64 { true -> (1u64) _ -> (0u64) }
}
// p2/p3 are Login/Users found through the matrix's own realm; zero means absent.
public machine matches_picker(p: &mut [u64; 128]) -> u64 {
    transition p[2] != 0u64 && p[3] != 0u64 && p[2] == p[4] && p[3] == p[5] { true -> (1u64) _ -> (0u64) }
}
