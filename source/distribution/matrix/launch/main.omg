// Ordinary stored-program launch: commands, completions and rollback.
// State 16..21: next/waiting command, ticket, role flags, error, task, retired picker.
// A waiting command is command + 32. Only its ticket and command can complete it.
const READ: u64 = 1u64;
const RETIRE: u64 = 2u64;
const ADMIT: u64 = 3u64;
const BIND: u64 = 4u64;
const PLACE: u64 = 5u64;
const ACTIVATE: u64 = 6u64;
const PUBLISH: u64 = 7u64;
const ROLLBACK: u64 = 8u64;
const RESTORE: u64 = 9u64;
const FINISH: u64 = 10u64;
public machine launch_decision(p: &mut [u64; 128]) -> u64 {
    transition p[1] { 0u64 -> initialize(p) 1u64 -> next(p) 2u64 -> completed(p) 3u64 -> cancel(p) _ -> (0u64) }
}
machine initialize(p: &mut [u64; 128]) -> u64 {
    transition p[16] == 0u64 && p[2] != 0u64 {
        true -> start(p) _ -> (0u64)
    }
    state start(p: &mut [u64; 128]) -> u64 { p[16] = READ; p[17] = p[2]; p[18] = p[3]; 1u64 }
}
machine next(p: &mut [u64; 128]) -> u64 {
    transition p[16] >= READ && p[16] <= FINISH { true -> issue(p) _ -> (0u64) }
    state issue(p: &mut [u64; 128]) -> u64 { let command: u64 = p[16]; p[16] = command + 32u64; command }
}
machine fail(p: &mut [u64; 128]) -> u64 {
    transition p[20] != 0u64 { true -> rollback(p) _ -> restore(p) }
    state rollback(p: &mut [u64; 128]) -> u64 { p[16] = ROLLBACK; 1u64 }
    state restore(p: &mut [u64; 128]) -> u64 {
        transition p[21] != 0u64 { true -> picker(p) _ -> done(p) }
    }
    state picker(p: &mut [u64; 128]) -> u64 { p[16] = RESTORE; 1u64 }
    state done(p: &mut [u64; 128]) -> u64 { p[16] = FINISH; 1u64 }
}
machine cancel(p: &mut [u64; 128]) -> u64 {
    transition p[16] != 0u64 && p[19] == 0u64 && p[2] != 0u64 {
        true -> cancelled(p) _ -> (0u64)
    }
    state cancelled(p: &mut [u64; 128]) -> u64 { p[19] = p[2]; fail(p) }
}
machine completed(p: &mut [u64; 128]) -> u64 {
    transition p[2] == p[17] && p[3] >= READ && p[3] <= FINISH && p[16] == p[3] + 32u64 {
        true -> outcome(p) _ -> (0u64)
    }
    state outcome(p: &mut [u64; 128]) -> u64 {
        transition p[4] != 0u64 { true -> error(p) _ -> advance(p) }
    }
    state error(p: &mut [u64; 128]) -> u64 { p[19] = p[4]; fail(p) }
    state advance(p: &mut [u64; 128]) -> u64 {
        transition p[3] {
            READ -> read(p) RETIRE -> retired(p) ADMIT -> admitted(p)
            BIND -> bound(p) PLACE -> placed(p) ACTIVATE -> activated(p)
            PUBLISH -> published(p) ROLLBACK -> rolled_back(p)
            RESTORE -> restored(p) FINISH -> finished(p) _ -> (0u64)
        }
    }
    state read(p: &mut [u64; 128]) -> u64 { transition (p[18] & 1u64) != 0u64 { true -> retiring(p) _ -> admitting(p) } }
    state retiring(p: &mut [u64; 128]) -> u64 { p[16] = RETIRE; 1u64 }
    state admitting(p: &mut [u64; 128]) -> u64 { p[16] = ADMIT; 1u64 }
    state retired(p: &mut [u64; 128]) -> u64 { p[21] = 1u64; p[16] = ADMIT; 1u64 }
    state admitted(p: &mut [u64; 128]) -> u64 {
        p[20] = 1u64;
        transition p[5] != 0u64 { true -> binding(p) _ -> bound(p) }
    }
    state binding(p: &mut [u64; 128]) -> u64 { p[16] = BIND; 1u64 }
    state bound(p: &mut [u64; 128]) -> u64 {
        transition (p[18] & 2u64) != 0u64 { true -> placing(p) _ -> placed(p) }
    }
    state placing(p: &mut [u64; 128]) -> u64 { p[16] = PLACE; 1u64 }
    state placed(p: &mut [u64; 128]) -> u64 {
        transition (p[18] & 4u64) != 0u64 { true -> activating(p) _ -> activated(p) }
    }
    state activating(p: &mut [u64; 128]) -> u64 { p[16] = ACTIVATE; 1u64 }
    state activated(p: &mut [u64; 128]) -> u64 { p[16] = PUBLISH; 1u64 }
    state published(p: &mut [u64; 128]) -> u64 { p[16] = FINISH; 1u64 }
    state rolled_back(p: &mut [u64; 128]) -> u64 { p[20] = 0u64; fail(p) }
    state restored(p: &mut [u64; 128]) -> u64 { p[21] = 0u64; p[16] = FINISH; 1u64 }
    state finished(p: &mut [u64; 128]) -> u64 { p[16] = 0u64; 1u64 }
}
