// Live stock layout: authenticated authority/busy/extent/standing facts in 2..6;
// untrusted request in 16..23. Output five rectangles 32..51 and standing mask 52.
// Exact incarnation/epoch validation and atomic World mutation remain in the host.
use placement;
use protocol::main;
// Stock wire binding: source-rs/distribution/matrix/contracts/matrix.rs.
const APPLY_LAYOUT: u64 = 16u64;
const INVALID_ARGUMENT: u64 = 18446744073709551594u64;
public machine live_layout(p: &mut [u64; 128]) -> u64 {
    transition p[2] != 0u64 { true -> idle(p) _ -> (DENIED) }
    state idle(p: &mut [u64; 128]) -> u64 { transition p[3] == 0u64 { true -> canonical(p) _ -> (BUSY) } }
    state canonical(p: &mut [u64; 128]) -> u64 {
        transition p[16] == APPLY_LAYOUT && p[21] == 0u64 && p[22] == 0u64 && p[23] == 0u64 {
            true -> geometry(p) _ -> (INVALID_ARGUMENT)
        }
    }
    state geometry(p: &mut [u64; 128]) -> u64 {
        p[1] = p[18]; p[2] = p[19]; p[3] = p[20];
        let width: u64 = p[4]; let height: u64 = p[5];
        transition place(p) == 1u64 { true -> rectangles(p, width, height, 0u64) _ -> (INVALID_ARGUMENT) }
    }
    state rectangles(p: &mut [u64; 128], width: u64, height: u64, i: u64) -> u64 {
        transition i < 4u64 { true -> coordinate(p, width, height, i) _ -> background(p, width, height) }
    }
    state coordinate(p: &mut [u64; 128], width: u64, height: u64, i: u64) -> u64 requires i < 4u64 {
        p[32u64 + i] = p[16u64 + i];
        p[36u64 + i] = p[20u64 + i]; p[40u64 + i] = p[20u64 + i]; p[44u64 + i] = p[20u64 + i];
        transition { _ -> rectangles(p, width, height, i + 1u64) }
    }
    state background(p: &mut [u64; 128], width: u64, height: u64) -> u64 {
        p[48] = 0u64; p[49] = 0u64; p[50] = width; p[51] = height;
        p[52] = p[6] & 14u64; 0u64
    }
}
