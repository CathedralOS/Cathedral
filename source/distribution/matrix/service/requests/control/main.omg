// Recognize owner work, preserve loss exclusion, then forward or validate locally.
// wire.omg owns message syntax; local.omg owns operation-specific resource checks.
use requests/control/operation.omg;
use requests/control/local.omg;
use {protocol}/matrix.omg;

public machine decide(facts: &|operation|::Facts, request: |operation|::Request) -> |operation|::Decision {
    transition facts.owner && facts.children > 0u64 && facts.children <= 7u64 {
        true -> recognized(facts, request)
        _ -> result(|operation|::Operation::Deny)
    }
    machine recognized(facts: &|operation|::Facts, request: |operation|::Request) -> |operation|::Decision {
        transition request {
            |operation|::Request::Loss -> result(|operation|::Operation::Survey)
            |operation|::Request::Unknown -> result(|operation|::Operation::Unhandled)
            _ -> available(facts, request)
        }
    }
    machine available(facts: &|operation|::Facts, request: |operation|::Request) -> |operation|::Decision {
        transition facts.loss {
            true -> result(|operation|::Operation::Busy)
            _ -> dispatch(facts, request)
        }
    }
    machine dispatch(facts: &|operation|::Facts, request: |operation|::Request) -> |operation|::Decision {
        transition request {
            |operation|::Request::Forward { hop, configuration, stored } -> forward(facts, hop, configuration, stored)
            |operation|::Request::Configure { canonical } -> canonical_operation(canonical, |operation|::Operation::Configure)
            |operation|::Request::Restore { canonical } -> canonical_operation(canonical, |operation|::Operation::Restore)
            |operation|::Request::Fallback { canonical } -> canonical_operation(canonical, |operation|::Operation::Fallback)
            |operation|::Request::Child { slot, work } -> child(facts, slot, work)
            _ -> result(|operation|::Operation::Deny)
        }
    }
}

machine forward(facts: &|operation|::Facts, hop: u64, configuration: bool, stored: bool) -> |operation|::Decision {
    transition hop > 0u64 && hop <= facts.children && hop <= 7u64 {
        true -> pending(facts, hop - 1u64, configuration, stored)
        _ -> result(|operation|::Operation::Deny)
    }
    machine pending(facts: &|operation|::Facts, slot: u64, configuration: bool, stored: bool) -> |operation|::Decision requires slot < 7u64 {
        transition (facts.pending & (1u64 << slot)) != 0u64 {
            true -> result(|operation|::Operation::Busy)
            _ -> ready(facts, slot, configuration, stored)
        }
    }
    // The deadline covers the work the word names: configuration and a stored
    // launch read through storage hops; every other routed word is answered
    // from what the child already holds.
    machine ready(facts: &|operation|::Facts, slot: u64, configuration: bool, stored: bool) -> |operation|::Decision {
        transition {
            configuration -> issue(slot, facts.configure_deadline)
            stored -> issue(slot, |matrix|::RUN_OBJECT_DEADLINE_TICKS)
            _ -> issue(slot, 100u64)
        }
    }
    machine issue(slot: u64, deadline: u64) -> |operation|::Decision {
        |operation|::Decision { operation: |operation|::Operation::Forward, slot: slot, deadline: deadline }
    }
}

machine child(facts: &|operation|::Facts, slot: u64, work: |operation|::Local) -> |operation|::Decision {
    transition slot < facts.children && slot < 7u64 {
        true -> validate(facts, slot, work)
        _ -> result(|operation|::Operation::Deny)
    }
    machine validate(facts: &|operation|::Facts, slot: u64, work: |operation|::Local) -> |operation|::Decision requires slot < 7u64 {
        let operation: |operation|::Operation = |local|::decide(facts, slot, work);
        |operation|::Decision { operation: operation, slot: slot, deadline: 0u64 }
    }
}

machine canonical_operation(canonical: bool, operation: |operation|::Operation) -> |operation|::Decision {
    transition canonical {
        true -> result(operation)
        _ -> result(|operation|::Operation::Deny)
    }
}

machine result(operation: |operation|::Operation) -> |operation|::Decision {
    |operation|::Decision { operation: operation, slot: 0u64, deadline: 0u64 }
}
