// Recognize canonical loss independently of launch policy. Routed
// requests retain their first hop and whether the word configures or launches
// from storage; the host owns the original packet and reply.
use requests/control/operation.omg;
use requests/desktop.omg;
use requests/wire.omg;
use {protocol}/main.omg;
use {protocol}/matrix.omg;

public machine decode(words: &[u64; 8]) -> |operation|::Request {
    transition words[0] == |main|::LOSS && |wire|::zero_tail(words, 1u64) {
        true -> (|operation|::Request::Loss)
        _ -> routed(words)
    }
    machine routed(words: &[u64; 8]) -> |operation|::Request {
        let op: u64 = words[0] & 65535u64;
        transition words[0] >> 16u64 != 0u64 {
            true -> (|operation|::Request::Forward { hop: (words[0] >> 16u64) & 7u64,
                configuration: op == |desktop|::CONFIGURE, stored: op == |matrix|::RUN_OBJECT })
            _ -> local(words)
        }
    }
}

machine local(words: &[u64; 8]) -> |operation|::Request {
    transition words[0] {
        |desktop|::CONFIGURE -> (|operation|::Request::Configure { canonical: |wire|::zero_tail(words, 1u64) })
        |matrix|::RESTORE_STORAGE -> (|operation|::Request::Restore { canonical: |wire|::zero_tail(words, 1u64) })
        |desktop|::LAUNCHER_FALLBACK -> (|operation|::Request::Fallback { canonical: |wire|::zero_tail(words, 3u64) })
        |matrix|::RUN_OBJECT -> child(words[1], |operation|::Local::Stored { object: words[2] })
        |matrix|::LAUNCH_IMAGES -> child(words[1], |operation|::Local::Images { mask: words[2], canonical: |wire|::zero_tail(words, 3u64) })
        |matrix|::MANAGEMENT_GRANT -> child(words[1], |operation|::Local::Management { count: words[2], canonical: |wire|::zero_tail(words, 3u64) })
        |matrix|::LAUNCH_IMPORTS -> child(words[1], |operation|::Local::Imports { mask: words[2], canonical: |wire|::zero_tail(words, 3u64) })
        |matrix|::RUN_PAGES -> child(words[1], |operation|::Local::Pages { private_pages: words[2], reader_pages: words[3], canonical: |wire|::zero_tail(words, 4u64) })
        |matrix|::RUN_MEMORY -> child(words[1], |operation|::Local::Memory { canonical: |wire|::zero_tail(words, 3u64) })
        |matrix|::LAUNCH_POLICY -> child(words[1], |operation|::Local::Policy { private_pages: words[2], reader_pages: words[3], surfaces: words[7] })
        |matrix|::LAUNCH_PLACE -> child(words[1], |operation|::Local::Placement { canonical: words[7] == 0u64 })
        |matrix|::SPAWN -> child(words[1], |operation|::Local::Spawn { canonical: |wire|::zero_tail(words, 5u64) })
        |matrix|::RUN -> child(words[1], |operation|::Local::Run)
        |matrix|::STOP -> child(words[1], |operation|::Local::Stop { canonical: |wire|::zero_tail(words, 2u64) })
        _ -> (|operation|::Request::Unknown)
    }
}

machine child(slot: u64, work: |operation|::Local) -> |operation|::Request {
    |operation|::Request::Child { slot: slot, work: work }
}
