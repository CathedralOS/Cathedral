// Per-operation checks after owner, loss and target-position admission.
use requests/control/operation.omg;

public machine decide(facts: &|operation|::Facts, slot: u64, work: |operation|::Local) -> |operation|::Operation requires slot < 7u64 {
    transition work {
        |operation|::Local::Stored { object } -> stored(facts, slot, object)
        |operation|::Local::Images { mask, canonical } -> images(facts, mask, canonical)
        |operation|::Local::Management { count, canonical } -> accept(count <= facts.children && canonical, |operation|::Operation::Management)
        |operation|::Local::Imports { mask, canonical } -> accept((mask & ~facts.supported_imports) == 0u64 && canonical, |operation|::Operation::Imports)
        |operation|::Local::Pages { private_pages, reader_pages, canonical } -> pages(facts, slot, private_pages, reader_pages, canonical)
        |operation|::Local::Memory { canonical } -> memory(facts, slot, canonical)
        |operation|::Local::Policy { private_pages, reader_pages, surfaces } -> accept(private_pages <= facts.private_pages
            && reader_pages <= facts.reader_pages && surfaces <= facts.surfaces, |operation|::Operation::Policy)
        |operation|::Local::Placement { canonical } -> accept(canonical && (facts.standing & (1u64 << slot)) != 0u64, |operation|::Operation::Placement)
        |operation|::Local::Spawn { canonical } -> accept(canonical, |operation|::Operation::Spawn)
        |operation|::Local::Run -> (|operation|::Operation::Run)
        |operation|::Local::Stop { canonical } -> accept(canonical, |operation|::Operation::Stop)
    }
}

machine stored(facts: &|operation|::Facts, slot: u64, object: u64) -> |operation|::Operation requires slot < 7u64 {
    transition facts.launching || facts.storing || ((facts.occupied | facts.unavailable) & (1u64 << slot)) != 0u64 {
        true -> (|operation|::Operation::Busy)
        _ -> valid(object)
    }
    machine valid(object: u64) -> |operation|::Operation {
        transition object != 0u64 {
            true -> (|operation|::Operation::Stored)
            _ -> (|operation|::Operation::Invalid)
        }
    }
}

machine images(facts: &|operation|::Facts, mask: u64, canonical: bool) -> |operation|::Operation {
    transition facts.images < 64u64 {
        true -> fits(facts, mask, canonical)
        _ -> (|operation|::Operation::Deny)
    }
    machine fits(facts: &|operation|::Facts, mask: u64, canonical: bool) -> |operation|::Operation requires facts.images < 64u64 {
        accept((mask >> facts.images) == 0u64 && canonical, |operation|::Operation::Images)
    }
}

machine pages(facts: &|operation|::Facts, slot: u64, private_pages: u64, reader_pages: u64, canonical: bool) -> |operation|::Operation requires slot < 7u64 {
    transition private_pages <= facts.private_pages && reader_pages <= facts.reader_pages && canonical {
        true -> vacant(facts, slot, |operation|::Operation::Pages)
        _ -> (|operation|::Operation::Deny)
    }
}

machine memory(facts: &|operation|::Facts, slot: u64, canonical: bool) -> |operation|::Operation requires slot < 7u64 {
    transition canonical {
        true -> vacant(facts, slot, |operation|::Operation::Memory)
        _ -> (|operation|::Operation::Deny)
    }
}

machine vacant(facts: &|operation|::Facts, slot: u64, operation: |operation|::Operation) -> |operation|::Operation requires slot < 7u64 {
    transition (facts.occupied & (1u64 << slot)) == 0u64 {
        true -> (operation)
        _ -> (|operation|::Operation::Busy)
    }
}

machine accept(allowed: bool, operation: |operation|::Operation) -> |operation|::Operation {
    transition allowed {
        true -> (operation)
        _ -> (|operation|::Operation::Deny)
    }
}
