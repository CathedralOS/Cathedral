module requests::main;

// Authenticated connection -> decoded request family -> operation owner.
// The native bridge supplies facts; wire.omg classifies the actual IPC message.
use requests::operations::Caller;
use requests::operations::Facts;
use requests::operations::Message;
use requests::operations::Operation;
use requests::owner;
use requests::children;

public machine route(facts: &Facts, message: Message) -> Operation {
    transition facts.caller == Caller::Producer {
        true -> (Operation::Producer)
        _ -> decoded(facts, message)
    }
    machine decoded(facts: &Facts, message: Message) -> Operation {
        transition message {
            Message::Missing -> malformed(facts)
            Message::Acquire -> acquisition(facts, message)
            _ -> caller(facts, message)
        }
    }
    machine malformed(facts: &Facts) -> Operation {
        transition facts.caller == Caller::Storage {
            true -> (Operation::DenyNow)
            _ -> (Operation::Deny)
        }
    }
    machine acquisition(facts: &Facts, message: Message) -> Operation {
        transition facts.caller != Caller::Owner && facts.caller != Caller::Unknown {
            true -> (Operation::Acquire)
            _ -> caller(facts, message)
        }
    }
    machine caller(facts: &Facts, message: Message) -> Operation {
        transition facts.caller {
            Caller::Owner -> requests::owner::route(message)
            Caller::Source -> (Operation::Source)
            Caller::Child -> interaction(facts, message)
            Caller::Storage -> interaction(facts, message)
            _ -> (Operation::Deny)
        }
    }
    machine interaction(facts: &Facts, message: Message) -> Operation {
        transition message {
            Message::Storage -> storage(facts)
            _ -> child_connection(facts, message)
        }
    }
    machine storage(facts: &Facts) -> Operation {
        transition facts.storage_stream {
            true -> (Operation::Storage)
            _ -> (Operation::DenyNow)
        }
    }
    machine child_connection(facts: &Facts, message: Message) -> Operation {
        transition facts.caller == Caller::Storage {
            true -> (Operation::DenyNow)
            _ -> producer(facts, message)
        }
    }
    machine producer(facts: &Facts, message: Message) -> Operation {
        transition facts.separate_producer && (message in Message::Producer) {
            true -> (Operation::Deny)
            _ -> requests::children::route(message)
        }
    }
}

public machine attachment(facts: &Facts, message: Message) -> Operation {
    transition facts.caller == Caller::Storage && facts.storage_stream {
        true -> allowed(message)
        _ -> (Operation::DenyNow)
    }
    machine allowed(message: Message) -> Operation {
        transition message {
            Message::Storage { attachment } -> eligible(attachment)
            _ -> (Operation::DenyNow)
        }
    }
    machine eligible(allowed: bool) -> Operation {
        transition allowed {
            true -> (Operation::Storage)
            _ -> (Operation::DenyNow)
        }
    }
}
