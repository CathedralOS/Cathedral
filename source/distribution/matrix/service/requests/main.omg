// Authenticated connection -> decoded request family -> operation owner.
// The native bridge supplies facts; wire.omg classifies the actual IPC message.
use requests/operations.omg;
use requests/owner.omg;
use requests/children.omg;

public machine route(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
    transition facts.caller == |operations|::Caller::Producer {
        true -> (|operations|::Operation::Producer)
        _ -> decoded(facts, message)
    }
    machine decoded(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
        transition message {
            |operations|::Message::Missing -> malformed(facts)
            |operations|::Message::Acquire -> acquisition(facts, message)
            _ -> caller(facts, message)
        }
    }
    machine malformed(facts: &|operations|::Facts) -> |operations|::Operation {
        transition facts.caller == |operations|::Caller::Storage {
            true -> (|operations|::Operation::DenyNow)
            _ -> (|operations|::Operation::Deny)
        }
    }
    machine acquisition(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
        transition facts.caller != |operations|::Caller::Owner && facts.caller != |operations|::Caller::Unknown {
            true -> (|operations|::Operation::Acquire)
            _ -> caller(facts, message)
        }
    }
    machine caller(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
        transition facts.caller {
            |operations|::Caller::Owner -> |owner|::route(message)
            |operations|::Caller::Source -> (|operations|::Operation::Source)
            |operations|::Caller::Child -> interaction(facts, message)
            |operations|::Caller::Storage -> interaction(facts, message)
            _ -> (|operations|::Operation::Deny)
        }
    }
    machine interaction(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
        transition message {
            |operations|::Message::Storage -> storage(facts)
            _ -> child_connection(facts, message)
        }
    }
    machine storage(facts: &|operations|::Facts) -> |operations|::Operation {
        transition facts.storage_stream {
            true -> (|operations|::Operation::Storage)
            _ -> (|operations|::Operation::DenyNow)
        }
    }
    machine child_connection(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
        transition facts.caller == |operations|::Caller::Storage {
            true -> (|operations|::Operation::DenyNow)
            _ -> producer(facts, message)
        }
    }
    machine producer(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
        transition facts.separate_producer && (message in |operations|::Message::Producer) {
            true -> (|operations|::Operation::Deny)
            _ -> |children|::route(message)
        }
    }
}

public machine attachment(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
    transition facts.caller == |operations|::Caller::Storage && facts.storage_stream {
        true -> allowed(message)
        _ -> (|operations|::Operation::DenyNow)
    }
    machine allowed(message: |operations|::Message) -> |operations|::Operation {
        transition message {
            |operations|::Message::Storage { attachment } -> eligible(attachment)
            _ -> (|operations|::Operation::DenyNow)
        }
    }
    machine eligible(allowed: bool) -> |operations|::Operation {
        transition allowed {
            true -> (|operations|::Operation::Storage)
            _ -> (|operations|::Operation::DenyNow)
        }
    }
}
