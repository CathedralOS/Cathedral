// Classify the real eight-word Matrix IPC packet, not the native-call envelope.
// Reserved argument checks are syntax only; they never authorize a caller.
use requests/operations.omg;
use requests/desktop.omg;
use {protocol}/main.omg;
use {protocol}/matrix.omg;

public machine decode(words: &[u64; 8]) -> |operations|::Message {
    let opcode: u64 = words[0];
    let scoped: u64 = opcode & 65535u64;
    transition opcode == |matrix|::STORAGE_INFO || (scoped >= |matrix|::STORAGE_BASE && scoped < |matrix|::STORAGE_BASE + 256u64) {
        true -> storage(scoped)
        _ -> ordinary(words)
    }
    machine storage(scoped: u64) -> |operations|::Message {
        |operations|::Message::Storage { attachment: attachment_operation(scoped) }
    }
}

machine ordinary(words: &[u64; 8]) -> |operations|::Message {
    transition words[0] {
        |matrix|::SERVICE_ACQUIRE -> (|operations|::Message::Acquire)
        |matrix|::PRODUCER_INFO -> (|operations|::Message::Producer)
        |matrix|::PRODUCER_INFO + 1u64 -> (|operations|::Message::Producer)
        |matrix|::PRODUCER_INFO + 2u64 -> (|operations|::Message::Producer)
        |matrix|::PRODUCER_RELEASE -> (|operations|::Message::Producer)
        |matrix|::PRODUCER_DESCRIBE -> (|operations|::Message::Producer)
        |desktop|::LAUNCH -> canonical(words, 3u64, |operations|::Message::Launch)
        |desktop|::CLOSE -> canonical(words, 1u64, |operations|::Message::Close)
        |matrix|::FUND -> canonical(words, 6u64, |operations|::Message::Fund)
        |desktop|::APP_ENTRY -> canonical(words, 2u64, |operations|::Message::AppEntry)
        |desktop|::SELECT_APP -> canonical(words, 2u64, |operations|::Message::Select)
        |desktop|::APPLY_LAYOUT -> (|operations|::Message::Layout)
        |matrix|::LAUNCH_STATUS -> canonical(words, 2u64, |operations|::Message::Status)
        |desktop|::SAVE_AVAILABILITY -> canonical(words, 1u64, |operations|::Message::SaveAvailability)
        |desktop|::RETRY_SAVES -> canonical(words, 1u64, |operations|::Message::RetrySaves)
        |matrix|::MANAGED_TASK -> canonical(words, 1u64, |operations|::Message::ManagedTask)
        |desktop|::RETRY_LAUNCHER -> canonical(words, 1u64, |operations|::Message::RetryLauncher)
        |matrix|::TERMINATE_TASK -> canonical(words, 2u64, |operations|::Message::Terminate)
        |matrix|::PRESENT_BEGIN -> (|operations|::Message::Present)
        |matrix|::PRESENT_COMMIT -> (|operations|::Message::Present)
        |matrix|::PRESENT_ABORT -> (|operations|::Message::Present)
        |main|::PRESENT_RECTS -> (|operations|::Message::Present)
        |main|::SURFACE_CREATE -> (|operations|::Message::Surface)
        |main|::MATRIX_PAINT -> (|operations|::Message::Surface)
        |matrix|::MATRIX_ERASE -> (|operations|::Message::Surface)
        |main|::SURFACE_IMAGE -> (|operations|::Message::Surface)
        |matrix|::SURFACE_CURSOR -> (|operations|::Message::Surface)
        |matrix|::RESOLVE_PATH -> canonical(words, 5u64, |operations|::Message::Resolve)
        |matrix|::READ_PIXEL -> canonical(words, 3u64, |operations|::Message::Pixel)
        |desktop|::SAVE_RECOVERY_GRANT -> (|operations|::Message::RecoveryOwner)
        |desktop|::SAVE_RECOVERY_POLL -> (|operations|::Message::RecoveryOwner)
        |matrix|::STORAGE_GRANT -> (|operations|::Message::StorageOwner)
        |matrix|::STORAGE_REVOKE -> (|operations|::Message::StorageOwner)
        |matrix|::STORAGE_STATUS -> (|operations|::Message::StorageOwner)
        |matrix|::STORAGE_BINDING -> (|operations|::Message::StorageOwner)
        |matrix|::BIND -> (|operations|::Message::Bind)
        |matrix|::PLACE -> (|operations|::Message::Place)
        |matrix|::REVOKE -> (|operations|::Message::Revoke { slot: words[1], canonical: zero_tail(words, 2u64) })
        _ -> (|operations|::Message::Other)
    }
}

machine canonical(words: &[u64; 8], from: u64, message: |operations|::Message) -> |operations|::Message {
    transition zero_tail(words, from) {
        true -> (message)
        _ -> (|operations|::Message::Other)
    }
}

public machine zero_tail(words: &[u64; 8], from: u64) -> bool {
    transition from < 8u64 {
        true -> word(words, from)
        _ -> (true)
    }
    machine word(words: &[u64; 8], index: u64) -> bool requires index < 8u64 {
        transition words[index] == 0u64 {
            true -> zero_tail(words, index + 1u64)
            _ -> (false)
        }
    }
}

machine attachment_operation(opcode: u64) -> bool {
    transition opcode {
        |matrix|::STORAGE_BASE + |main|::STORE_PUBLISH -> (true)
        |matrix|::STORAGE_BASE + |matrix|::STORE_CREATE_NAMED -> (true)
        |matrix|::STORAGE_BASE + |matrix|::STORE_SET_METADATA -> (true)
        |matrix|::STORAGE_BASE + |matrix|::STORE_LOOKUP -> (true)
        |matrix|::STORAGE_BASE + |matrix|::STORE_FILTER -> (true)
        |matrix|::STORAGE_BASE + |matrix|::STORE_COPY_TREE -> (true)
        |matrix|::STORAGE_BASE + |main|::STORE_COPY -> (true)
        _ -> (false)
    }
}
