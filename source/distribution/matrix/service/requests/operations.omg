module requests::operations;

// Caller facts come from accepted host connections, never from request words.
// Message names describe decoded syntax; Operation names select host work.
public data Caller [copy] {
    case Unknown;
    case Owner;
    case Source;
    case Child;
    case Storage;
    case Producer;
}

public data Facts {
    caller: Caller;
    separate_producer: bool;
    storage_stream: bool;
}

public data Message [copy] {
    case Missing;
    case Other;
    case Acquire;
    case Storage(attachment: bool);
    case Producer;
    case Launch;
    case Close;
    case Fund;
    case AppEntry;
    case Select;
    case Layout;
    case Status;
    case SaveAvailability;
    case RetrySaves;
    case ManagedTask;
    case RetryLauncher;
    case Terminate;
    case Present;
    case Surface;
    case Resolve;
    case Pixel;
    case RecoveryOwner;
    case StorageOwner;
    case Bind;
    case Place;
    case Revoke(slot: u64, canonical: bool);
}

public data Operation [copy] {
    case Deny;
    case Producer;
    case Acquire;
    case Resolve;
    case Pixel;
    case Owner;
    case RecoveryOwner;
    case StorageOwner;
    case LayoutOwner;
    case Source;
    case Storage;
    case DenyNow;
    case Launch;
    case Close;
    case Fund;
    case AppEntry;
    case Select;
    case Layout;
    case Status;
    case SaveAvailability;
    case RetrySaves;
    case ManagedTask;
    case RetryLauncher;
    case Terminate;
    case Present;
    case Surface;
    case World;
}
