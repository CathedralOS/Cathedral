// Only a child interaction connection reaches this dispatch. Canonical syntax
// selects a workflow; live resource/authority validation stays with that owner.
use requests/operations.omg;

public machine route(message: |operations|::Message) -> |operations|::Operation {
    transition message {
        |operations|::Message::Launch -> (|operations|::Operation::Launch)
        |operations|::Message::Close -> (|operations|::Operation::Close)
        |operations|::Message::Fund -> (|operations|::Operation::Fund)
        |operations|::Message::AppEntry -> (|operations|::Operation::AppEntry)
        |operations|::Message::Select -> (|operations|::Operation::Select)
        |operations|::Message::Layout -> (|operations|::Operation::Layout)
        |operations|::Message::Status -> (|operations|::Operation::Status)
        |operations|::Message::SaveAvailability -> (|operations|::Operation::SaveAvailability)
        |operations|::Message::RetrySaves -> (|operations|::Operation::RetrySaves)
        |operations|::Message::ManagedTask -> (|operations|::Operation::ManagedTask)
        |operations|::Message::RetryLauncher -> (|operations|::Operation::RetryLauncher)
        |operations|::Message::Terminate -> (|operations|::Operation::Terminate)
        |operations|::Message::Present -> (|operations|::Operation::Present)
        |operations|::Message::Surface -> (|operations|::Operation::Surface)
        _ -> (|operations|::Operation::World)
    }
}
