// Owner-only routing and post-success consequences. No request supplies authority.
use requests/operations.omg;

public data Clearing [copy] {
    case None;
    case Slot;
    case Pair;
}

public data Replay [copy] {
    case None;
    case Slot;
    case All;
}

public data Effects {
    changed: bool;
    clearing: Clearing;
    replay: Replay;
    remember_storage: bool;
}

public machine route(message: |operations|::Message) -> |operations|::Operation {
    transition message {
        |operations|::Message::Resolve -> (|operations|::Operation::Resolve)
        |operations|::Message::Pixel -> (|operations|::Operation::Pixel)
        _ -> (|operations|::Operation::Owner)
    }
}

public machine fallback(facts: &|operations|::Facts, message: |operations|::Message) -> |operations|::Operation {
    transition facts.caller == |operations|::Caller::Owner && !(message in |operations|::Message::Missing) {
        true -> operation(message)
        _ -> (|operations|::Operation::Deny)
    }
    machine operation(message: |operations|::Message) -> |operations|::Operation {
        transition message {
            |operations|::Message::RecoveryOwner -> (|operations|::Operation::RecoveryOwner)
            |operations|::Message::StorageOwner -> (|operations|::Operation::StorageOwner)
            _ -> (|operations|::Operation::LayoutOwner)
        }
    }
}

public machine effects(facts: &|operations|::Facts, message: |operations|::Message, children: u64, success: bool) -> Effects {
    transition facts.caller == |operations|::Caller::Owner && !(message in |operations|::Message::Missing) && success {
        true -> operation(message, children)
        _ -> (Effects { changed: false, clearing: Clearing::None,
            replay: Replay::None, remember_storage: false })
    }
    machine operation(message: |operations|::Message, children: u64) -> Effects {
        transition message {
            |operations|::Message::StorageOwner -> changed(Clearing::None, Replay::None, true)
            |operations|::Message::Bind -> changed(Clearing::Pair, Replay::All, false)
            |operations|::Message::Place -> changed(Clearing::None, Replay::Slot, false)
            |operations|::Message::Revoke { slot, canonical } -> revoke(slot, canonical, children)
            _ -> changed(Clearing::None, Replay::None, false)
        }
    }
    machine revoke(slot: u64, canonical: bool, children: u64) -> Effects {
        transition canonical && slot < children {
            true -> changed(Clearing::Slot, Replay::Slot, false)
            _ -> changed(Clearing::None, Replay::Slot, false)
        }
    }
}

machine changed(clearing: Clearing, replay: Replay, storage: bool) -> Effects {
    Effects { changed: true, clearing: clearing, replay: replay, remember_storage: storage }
}
