module requests::owner;

// Owner-only routing and post-success consequences. No request supplies authority.
use requests::operations::Caller;
use requests::operations::Facts;
use requests::operations::Message;
use requests::operations::Operation;

public data Clearing [copy] {
    case None;
    case Slot;
    case Pair;
}

public data Replay [copy] {
    case None;
    case Slot;
    case All;
}

public data Effects {
    changed: bool;
    clearing: Clearing;
    replay: Replay;
    remember_storage: bool;
}

public machine route(message: Message) -> Operation {
    transition message {
        Message::Resolve -> (Operation::Resolve)
        Message::Pixel -> (Operation::Pixel)
        _ -> (Operation::Owner)
    }
}

public machine fallback(facts: &Facts, message: Message) -> Operation {
    transition facts.caller == Caller::Owner && !(message in Message::Missing) {
        true -> operation(message)
        _ -> (Operation::Deny)
    }
    machine operation(message: Message) -> Operation {
        transition message {
            Message::RecoveryOwner -> (Operation::RecoveryOwner)
            Message::StorageOwner -> (Operation::StorageOwner)
            _ -> (Operation::LayoutOwner)
        }
    }
}

public machine effects(facts: &Facts, message: Message, children: u64, success: bool) -> Effects {
    transition facts.caller == Caller::Owner && !(message in Message::Missing) && success {
        true -> operation(message, children)
        _ -> (Effects { changed: false, clearing: Clearing::None,
            replay: Replay::None, remember_storage: false })
    }
    machine operation(message: Message, children: u64) -> Effects {
        transition message {
            Message::StorageOwner -> changed(Clearing::None, Replay::None, true)
            Message::Bind -> changed(Clearing::Pair, Replay::All, false)
            Message::Place -> changed(Clearing::None, Replay::Slot, false)
            Message::Revoke { slot, canonical } -> revoke(slot, canonical, children)
            _ -> changed(Clearing::None, Replay::None, false)
        }
    }
    machine revoke(slot: u64, canonical: bool, children: u64) -> Effects {
        transition canonical && slot < children {
            true -> changed(Clearing::Slot, Replay::Slot, false)
            _ -> changed(Clearing::None, Replay::Slot, false)
        }
    }
}

machine changed(clearing: Clearing, replay: Replay, storage: bool) -> Effects {
    Effects { changed: true, clearing: clearing, replay: replay, remember_storage: storage }
}
