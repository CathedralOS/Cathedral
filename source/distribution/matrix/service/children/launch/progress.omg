// Successful steps acquire cleanup obligations as they complete. On failure,
// reclaim the admitted task before restoring a picker that this launch retired.
use children/launch/operation.omg;

public machine completed(launch: &mut |operation|::Launch, command: |operation|::Command, requires_storage: bool) -> bool {
    transition command {
        |operation|::Command::Read -> read(launch)
        |operation|::Command::RetirePicker -> retired(launch)
        |operation|::Command::Admit -> admitted(launch, requires_storage)
        |operation|::Command::Bind -> bound(launch)
        |operation|::Command::Place -> placed(launch)
        |operation|::Command::Activate -> queue(launch, |operation|::Command::Publish)
        |operation|::Command::Publish -> queue(launch, |operation|::Command::Finish)
        |operation|::Command::Rollback -> rolled_back(launch)
        |operation|::Command::RestorePicker -> restored(launch)
        |operation|::Command::Finish -> finished(launch)
    }
    machine read(launch: &mut |operation|::Launch) -> bool {
        transition launch.plan.retire_picker {
            true -> queue(launch, |operation|::Command::RetirePicker)
            _ -> queue(launch, |operation|::Command::Admit)
        }
    }
    machine retired(launch: &mut |operation|::Launch) -> bool {
        launch.picker_retired = true;
        queue(launch, |operation|::Command::Admit)
    }
    machine admitted(launch: &mut |operation|::Launch, requires_storage: bool) -> bool {
        launch.child_admitted = true;
        transition requires_storage {
            true -> queue(launch, |operation|::Command::Bind)
            _ -> bound(launch)
        }
    }
    machine bound(launch: &mut |operation|::Launch) -> bool {
        transition launch.plan.place_child {
            true -> queue(launch, |operation|::Command::Place)
            _ -> placed(launch)
        }
    }
    machine placed(launch: &mut |operation|::Launch) -> bool {
        transition launch.plan.activate_desktop {
            true -> queue(launch, |operation|::Command::Activate)
            _ -> queue(launch, |operation|::Command::Publish)
        }
    }
    machine rolled_back(launch: &mut |operation|::Launch) -> bool {
        launch.child_admitted = false;
        cleanup(launch)
    }
    machine restored(launch: &mut |operation|::Launch) -> bool {
        launch.picker_retired = false;
        queue(launch, |operation|::Command::Finish)
    }
    machine finished(launch: &mut |operation|::Launch) -> bool {
        launch.phase = |operation|::Phase::Dormant;
        true
    }
}

public machine cleanup(launch: &mut |operation|::Launch) -> bool {
    transition launch.child_admitted {
        true -> queue(launch, |operation|::Command::Rollback)
        _ -> restore(launch)
    }
    machine restore(launch: &mut |operation|::Launch) -> bool {
        transition launch.picker_retired {
            true -> queue(launch, |operation|::Command::RestorePicker)
            _ -> queue(launch, |operation|::Command::Finish)
        }
    }
}

machine queue(launch: &mut |operation|::Launch, command: |operation|::Command) -> bool {
    launch.phase = |operation|::Phase::Ready { command: command };
    true
}
