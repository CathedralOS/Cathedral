module children::launch::roles;

// Role facts are host-authenticated local observations, never caller claims.
use children::launch::operation::Plan;

public data Requester [copy] {
    case Owner;
    case Child(slot: u64);
}

public data Context {
    login: bool;
    entered: bool;
    target: u64;
    desktop: bool;
    requester: Requester;
}

public machine plan(context: &Context) -> Plan {
    let selecting_user: bool = context.login && !context.entered && context.target == 1u64;
    transition context.requester {
        Requester::Owner -> (Plan {
            retire_picker: selecting_user, place_child: false, activate_desktop: false
        })
        Requester::Child { slot } -> (Plan {
            retire_picker: selecting_user, place_child: true,
            activate_desktop: context.desktop && slot == 0u64
        })
    }
}

// The root owner's first picker is recognized through its supplied realm.
public machine needs_picker_lookup(upstream: bool, slot: u64, has_scope: bool) -> bool {
    !upstream && slot == 0u64 && has_scope
}

public machine matches_picker(found_login: u64, found_users: u64, program: u64, scope: u64) -> bool {
    found_login != 0u64 && found_users != 0u64 && found_login == program && found_users == scope
}
