module children::launch::main;

// Begin, issue once, accept only the outstanding ticket/command, then advance.
// progress.omg owns the successful sequence and cleanup after partial failure.
use children::launch::operation::Launch;
use children::launch::operation::Plan;
use children::launch::operation::Command;
use children::launch::operation::Phase;
use children::launch::operation::Dispatch;
use children::launch::operation::Completion;
use children::launch::progress;

public machine begin(launch: &mut Launch, ticket: u64, plan: Plan) -> bool {
    transition (launch.phase in Phase::Dormant) && ticket != 0u64 {
        true -> start(launch, ticket, plan)
        _ -> (false)
    }
    machine start(launch: &mut Launch, ticket: u64, plan: Plan) -> bool {
        launch.phase = Phase::Ready { command: Command::Read };
        launch.ticket = ticket;
        launch.plan = plan;
        true
    }
}

public machine next(launch: &mut Launch) -> Dispatch {
    transition launch.phase {
        Phase::Ready { command } -> issue(launch, command)
        _ -> (Dispatch::Wait)
    }
    machine issue(launch: &mut Launch, command: Command) -> Dispatch {
        launch.phase = Phase::Waiting { command: command };
        Dispatch::Issue { command: command }
    }
}

// A held reply remains usable only while this exact work is outstanding.
public machine accepts(launch: &Launch, ticket: u64, requested: Command) -> bool {
    transition launch.phase {
        Phase::Waiting { command } -> (launch.ticket == ticket && command == requested)
        _ -> (false)
    }
}

public machine complete(launch: &mut Launch, completion: Completion) -> bool {
    transition accepts(launch, completion.ticket, completion.command) {
        true -> outcome(launch, completion)
        _ -> (false)
    }
    machine outcome(launch: &mut Launch, completion: Completion) -> bool {
        transition completion.status == 0u64 {
            true -> children::launch::progress::completed(launch, completion.command, completion.requires_storage)
            _ -> failed(launch, completion.status)
        }
    }
    machine failed(launch: &mut Launch, status: u64) -> bool {
        launch.status = status;
        children::launch::progress::cleanup(launch)
    }
}

public machine cancel(launch: &mut Launch, status: u64) -> bool {
    transition !(launch.phase in Phase::Dormant) && launch.status == 0u64 && status != 0u64 {
        true -> cancelled(launch, status)
        _ -> (false)
    }
    machine cancelled(launch: &mut Launch, status: u64) -> bool {
        launch.status = status;
        children::launch::progress::cleanup(launch)
    }
}
