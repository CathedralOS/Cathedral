module children::launch::resources::main;

// Stock resource offers and admission policy. The host retains grants and allocation.
use children::launch::resources::recipes;
use children::launch::resources::allocation;

public machine resources_decision(p: &mut [u64; 128]) -> u64 {
    transition p[1] {
        1u64 -> children::launch::resources::recipes::recipe(p)
        2u64 -> children::launch::resources::allocation::allocation(p)
        3u64 -> children::launch::resources::allocation::surfaces(p)
        _ -> (18446744073709551594u64)
    }
}
