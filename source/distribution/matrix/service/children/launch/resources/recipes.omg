module children::launch::resources::recipes;

// Distribution-owned offers, never kernel grants. CPU zero inherits the ceiling.
public data Role [copy] {
    case Launcher(private_pages: u64);
    case Picker(backed_surfaces: u64);
    case Background;
    case Workspace(private_pages: u64, reader_pages: u64, surfaces: u64);
    case User(backed_surfaces: u64);
}

public data Offer [copy] {
    private_pages: u64;
    reader_pages: u64;
    channels: u64;
    descendants: u64;
    cpu: u64;
    imports: u64;
    surfaces: u64;
}

public data OfferDecision [copy] {
    case InsufficientBacking;
    case Offered(offer: Offer);
}

const INTERACTION: u64 = 1u64;
const ALL_SERVICES: u64 = 3u64;
public const HOST_SURFACES: u64 = 24u64;
const PICKER_SURFACES: u64 = 6u64;

public machine offer(role: Role) -> OfferDecision {
    transition role {
        Role::Launcher { private_pages } -> offered(private_pages, 4u64, 3u64, 0u64, ALL_SERVICES, 8u64)
        Role::Picker { backed_surfaces } -> picker(backed_surfaces)
        Role::Background -> offered(5u64, 2u64, 2u64, 0u64, INTERACTION, 1u64)
        Role::Workspace { private_pages, reader_pages, surfaces } -> offered(private_pages, reader_pages, 40u64, 5u64, ALL_SERVICES, surfaces)
        Role::User { backed_surfaces } -> user(backed_surfaces)
    }
    machine picker(backed: u64) -> OfferDecision {
        transition backed >= HOST_SURFACES {
            true -> offered(48u64, 4u64, 3u64, 0u64, ALL_SERVICES, PICKER_SURFACES)
            _ -> (OfferDecision::InsufficientBacking)
        }
    }
    machine user(backed: u64) -> OfferDecision {
        transition backed >= HOST_SURFACES {
            true -> selected_user(backed)
            _ -> (OfferDecision::InsufficientBacking)
        }
    }
    machine selected_user(backed: u64) -> OfferDecision requires backed >= HOST_SURFACES {
        offered(256u64, 384u64, 24u64, 3u64, ALL_SERVICES, backed - PICKER_SURFACES)
    }
}

machine offered(private_pages: u64, reader_pages: u64, channels: u64, descendants: u64, imports: u64, surfaces: u64) -> OfferDecision {
    OfferDecision::Offered { offer: Offer {
        private_pages: private_pages,
        reader_pages: reader_pages,
        channels: channels,
        descendants: descendants,
        cpu: 0u64,
        imports: imports,
        surfaces: surfaces
    } }
}
