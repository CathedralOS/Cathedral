module children::launch::declaration;

// Private native adapter: raw length in 2, packed little-endian bytes in 16..36.
// Publish decoded metadata in 64..72 and entries in 80..95 only after validation.
use services::main;
use services::types;

public machine import_declaration(p: &mut [u64; 128]) -> u64 {
    let mut bytes: [u8; 168];
    transition {
        _ -> copy(p, &mut bytes, 0u64)
    }
    state copy(p: &mut [u64; 128], bytes: &mut [u8; 168], i: u64) -> u64 {
        transition i < 168u64 {
            true -> byte(p, bytes, i)
            _ -> validate(p, bytes)
        }
    }
    state byte(p: &mut [u64; 128], bytes: &mut [u8; 168], i: u64) -> u64 requires i < 168u64 {
        bytes[i] = ((p[16u64 + i / 8u64] >> ((i % 8u64) * 8u64)) & 255u64) as u8;
        transition {
            _ -> copy(p, bytes, i + 1u64)
        }
    }
    state validate(p: &mut [u64; 128], bytes: &[u8; 168]) -> u64 {
        let mut output: Declaration;
        transition decode(bytes, p[2], &mut output) {
            true -> publish(p, &output)
            _ -> (MALFORMED)
        }
    }
    state publish(p: &mut [u64; 128], output: &Declaration) -> u64 {
        p[64] = output.count;
        p[65] = output.brokered as u64;
        p[66] = output.funded as u64;
        p[67] = output.channels;
        p[68] = output.descendants;
        p[69] = output.profiled as u64;
        p[70] = output.private_pages;
        p[71] = output.reader_pages;
        p[72] = output.surfaces;
        transition {
            _ -> entries(p, output, 0u64)
        }
    }
    state entries(p: &mut [u64; 128], output: &Declaration, i: u64) -> u64 {
        transition i < output.count && i < 4u64 {
            true -> item(p, output, i)
            _ -> (0u64)
        }
    }
    state item(p: &mut [u64; 128], output: &Declaration, i: u64) -> u64 requires i < 4u64 {
        let item: Import = output.entries[i];
        let at: u64 = 80u64 + i * 4u64;
        p[at] = item.contract;
        p[at + 1u64] = item.minimum;
        p[at + 2u64] = item.maximum;
        p[at + 3u64] = item.required as u64;
        transition {
            _ -> entries(p, output, i + 1u64)
        }
    }
}
