module children::launch::admission;

// Child asks for a sibling: select a stock app position, then apply the owner's ceilings.
// Facts 2..15: busy, desktop, exact chrome, requester, occupied/unavailable masks,
// storing, receipt/ticket capacity, object, withheld/supported imports, standing mask, binding.
// Output 24: slot; 25: app positions exhausted (diagnostic only).
use protocol::main;

const INVALID_ARGUMENT: u64 = 18446744073709551594u64;
public machine launch_admission(p: &mut [u64; 128]) -> u64 {
    transition p[2] != 0u64 {
        true -> (BUSY)
        _ -> role(p)
    }
    state role(p: &mut [u64; 128]) -> u64 {
        transition p[3] != 0u64 {
            true -> chrome(p)
            _ -> sibling(p)
        }
    }
    state chrome(p: &mut [u64; 128]) -> u64 {
        transition p[4] != 0u64 {
            true -> free(p, 1u64)
            _ -> (DENIED)
        }
    }
    state free(p: &mut [u64; 128], slot: u64) -> u64 {
        transition slot < 4u64 {
            true -> present(p, slot)
            _ -> full(p)
        }
    }
    state present(p: &mut [u64; 128], slot: u64) -> u64 requires slot < 4u64 {
        transition (p[6] & (1u64 << slot)) == 0u64 {
            true -> selected(p, slot)
            _ -> free(p, slot + 1u64)
        }
    }
    state full(p: &mut [u64; 128]) -> u64 {
        p[25] = 1u64;
        NO_MEMORY
    }
    state sibling(p: &mut [u64; 128]) -> u64 {
        transition p[5] < 2u64 {
            true -> other(p)
            _ -> (DENIED)
        }
    }
    state other(p: &mut [u64; 128]) -> u64 requires p[5] < 2u64 {
        let slot: u64 = 1u64 - p[5];
        selected(p, slot)
    }
}

machine selected(p: &mut [u64; 128], slot: u64) -> u64 requires slot < 4u64 {
    p[24] = slot;
    transition p[8] != 0u64 || ((p[6] | p[7]) & (1u64 << slot)) != 0u64 {
        true -> (BUSY)
        _ -> capacity(p, slot)
    }
    state capacity(p: &mut [u64; 128], slot: u64) -> u64 requires slot < 4u64 {
        transition p[9] != 0u64 && p[10] != 0u64 {
            true -> arguments(p, slot)
            _ -> (NO_MEMORY)
        }
    }
    state arguments(p: &mut [u64; 128], slot: u64) -> u64 requires slot < 4u64 {
        transition p[11] != 0u64 && (p[12] & ~p[13]) == 0u64 {
            true -> authority(p, slot)
            _ -> (INVALID_ARGUMENT)
        }
    }
    state authority(p: &mut [u64; 128], slot: u64) -> u64 requires slot < 4u64 {
        transition (p[14] & (1u64 << slot)) != 0u64 && p[15] != 0u64 {
            true -> (0u64)
            _ -> (DENIED)
        }
    }
}
