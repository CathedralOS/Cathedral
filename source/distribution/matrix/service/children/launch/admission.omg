module children::launch::admission;

// Select a target before checking its pressure, arguments and standing authority.
// A free app position with a busy connection is not permission to skip that slot.
use children::launch::roles::Requester;

public data Request {
    program_present: bool;
    withheld_imports: u64;
    supported_imports: u64;
}

public data Facts {
    busy: bool;
    desktop: bool;
    exact_chrome: bool;
    requester: Requester;
    occupied_slots: u64;
    unavailable_connections: u64;
    storing: bool;
    has_receipt: bool;
    has_ticket: bool;
    standing_slots: u64;
    has_storage_binding: bool;
}

public data Refusal [copy] {
    case Busy;
    case Denied;
    case Capacity;
    case InvalidArguments;
    case AppPositionsFull;
}

public data Decision [copy] {
    case Refused(reason: Refusal);
    case Admitted(slot: u64);
    case TargetRefused(slot: u64, reason: Refusal);
}

public machine admit(request: &Request, facts: &Facts) -> Decision {
    transition facts.busy {
        true -> (Decision::Refused { reason: Refusal::Busy })
        _ -> role(request, facts)
    }
    machine role(request: &Request, facts: &Facts) -> Decision {
        transition facts.desktop {
            true -> chrome(request, facts)
            _ -> sibling(request, facts)
        }
    }
    machine chrome(request: &Request, facts: &Facts) -> Decision {
        transition facts.exact_chrome {
            true -> free(request, facts, 1u64)
            _ -> (Decision::Refused { reason: Refusal::Denied })
        }
    }
    machine free(request: &Request, facts: &Facts, slot: u64) -> Decision {
        transition slot < 4u64 {
            true -> present(request, facts, slot)
            _ -> (Decision::Refused { reason: Refusal::AppPositionsFull })
        }
    }
    machine present(request: &Request, facts: &Facts, slot: u64) -> Decision requires slot < 4u64 {
        transition (facts.occupied_slots & (1u64 << slot)) == 0u64 {
            true -> selected(request, facts, slot)
            _ -> free(request, facts, slot + 1u64)
        }
    }
    machine sibling(request: &Request, facts: &Facts) -> Decision {
        transition facts.requester {
            Requester::Child { slot } -> pair(request, facts, slot)
            Requester::Owner -> (Decision::Refused { reason: Refusal::Denied })
        }
    }
    machine pair(request: &Request, facts: &Facts, requester: u64) -> Decision {
        transition requester < 2u64 {
            true -> other(request, facts, requester)
            _ -> (Decision::Refused { reason: Refusal::Denied })
        }
    }
    machine other(request: &Request, facts: &Facts, requester: u64) -> Decision requires requester < 2u64 {
        selected(request, facts, 1u64 - requester)
    }
}

machine selected(request: &Request, facts: &Facts, slot: u64) -> Decision requires slot < 4u64 {
    transition facts.storing || ((facts.occupied_slots | facts.unavailable_connections) & (1u64 << slot)) != 0u64 {
        true -> (Decision::TargetRefused { slot: slot, reason: Refusal::Busy })
        _ -> capacity(request, facts, slot)
    }
    machine capacity(request: &Request, facts: &Facts, slot: u64) -> Decision requires slot < 4u64 {
        transition facts.has_receipt && facts.has_ticket {
            true -> arguments(request, facts, slot)
            _ -> (Decision::TargetRefused { slot: slot, reason: Refusal::Capacity })
        }
    }
    machine arguments(request: &Request, facts: &Facts, slot: u64) -> Decision requires slot < 4u64 {
        transition request.program_present && (request.withheld_imports & ~request.supported_imports) == 0u64 {
            true -> authority(facts, slot)
            _ -> (Decision::TargetRefused { slot: slot, reason: Refusal::InvalidArguments })
        }
    }
    machine authority(facts: &Facts, slot: u64) -> Decision requires slot < 4u64 {
        transition (facts.standing_slots & (1u64 << slot)) != 0u64 && facts.has_storage_binding {
            true -> (Decision::Admitted { slot: slot })
            _ -> (Decision::TargetRefused { slot: slot, reason: Refusal::Denied })
        }
    }
}
