module children::startup::main;

// Local startup recovery. The picker gets two admission attempts; the background
// gets one retry. Owner-managed login recovery belongs to the owner instead.
public data Startup {
    picker_attempts: u64;
    picker_pending: bool;
    selection_failed: bool;
    background_pending: bool;
    background_retry_spent: bool;
}

public data ChildRole [copy] {
    case Picker;
    case User;
    case Background;
    case Other;
}

public data Context {
    login: bool;
    entered: bool;
    workspace: bool;
    owner_recovers: bool;
}

public data RetirementEffect [copy] {
    case KeepSelection;
    case ReturnToPicker;
}

public data PickerAction [copy] {
    case Wait;
    case Restart;
    case Exhausted;
}

public data PickerMode [copy] {
    case Normal;
    case SelectionFailed;
}

public machine child_retired(
    startup: &mut Startup, role: ChildRole, failed: bool, context: &Context
) -> RetirementEffect {
    transition failed && !(context.login && context.owner_recovers) {
        true -> local(startup, role, context)
        _ -> (RetirementEffect::KeepSelection)
    }
    machine local(startup: &mut Startup, role: ChildRole, context: &Context) -> RetirementEffect {
        transition role {
            ChildRole::User -> user_retired(startup, context)
            ChildRole::Picker -> picker_retired(startup, context)
            ChildRole::Background -> background_retired(startup, context)
            _ -> (RetirementEffect::KeepSelection)
        }
    }
    machine user_retired(startup: &mut Startup, context: &Context) -> RetirementEffect {
        transition context.login && context.entered {
            true -> reset_picker(startup)
            _ -> (RetirementEffect::KeepSelection)
        }
    }
    machine picker_retired(startup: &mut Startup, context: &Context) -> RetirementEffect {
        transition context.login && !context.entered {
            true -> queue_picker(startup)
            _ -> (RetirementEffect::KeepSelection)
        }
    }
    machine background_retired(startup: &mut Startup, context: &Context) -> RetirementEffect {
        transition context.workspace && !startup.background_retry_spent {
            true -> queue_background(startup)
            _ -> (RetirementEffect::KeepSelection)
        }
    }
    machine queue_picker(startup: &mut Startup) -> RetirementEffect {
        startup.picker_pending = true;
        RetirementEffect::KeepSelection
    }
    machine queue_background(startup: &mut Startup) -> RetirementEffect {
        background_failed(startup);
        RetirementEffect::KeepSelection
    }
}

public machine selection_failed(startup: &mut Startup, owner_recovers: bool) -> RetirementEffect {
    transition owner_recovers {
        true -> (RetirementEffect::KeepSelection)
        _ -> reset_picker(startup)
    }
}

machine reset_picker(startup: &mut Startup) -> RetirementEffect {
    startup.picker_attempts = 0u64;
    startup.picker_pending = true;
    startup.selection_failed = true;
    RetirementEffect::ReturnToPicker
}

public machine picker_started(startup: &mut Startup) -> PickerMode {
    // Repeated host notifications must not wrap an exhausted budget.
    transition startup.picker_attempts < 2u64 {
        true -> count_attempt(startup)
        _ -> display_mode(startup)
    }
    machine count_attempt(startup: &mut Startup) -> PickerMode
        requires startup.picker_attempts < 2u64 {
        startup.picker_attempts = startup.picker_attempts + 1u64;
        display_mode(startup)
    }
    machine display_mode(startup: &Startup) -> PickerMode {
        transition startup.selection_failed {
            true -> (PickerMode::SelectionFailed)
            _ -> (PickerMode::Normal)
        }
    }
}

public machine background_failed(startup: &mut Startup) {
    startup.background_pending = true;
}

public machine take_picker(startup: &mut Startup, blocked: bool) -> PickerAction {
    transition !blocked && startup.picker_pending {
        true -> consume(startup)
        _ -> (PickerAction::Wait)
    }
    machine consume(startup: &mut Startup) -> PickerAction {
        startup.picker_pending = false;
        transition startup.picker_attempts >= 2u64 {
            true -> (PickerAction::Exhausted)
            _ -> (PickerAction::Restart)
        }
    }
}

public machine take_background(startup: &mut Startup, blocked: bool) -> bool {
    transition !blocked && startup.background_pending {
        true -> consume(startup)
        _ -> (false)
    }
    machine consume(startup: &mut Startup) -> bool {
        startup.background_pending = false;
        startup.background_retry_spent = true;
        true
    }
}
