module children::startup::realm::main;

// Begin one job, issue work once, and accept only its outstanding command.
// Each job's sequence lives beside this entrance; the native codec lives outside.
use children::startup::realm::operations::Setup;
use children::startup::realm::operations::Job;
use children::startup::realm::operations::Command;
use children::startup::realm::operations::Phase;
use children::startup::realm::operations::Outcome;
use children::startup::realm::operations::Context;
use children::startup::realm::operations::Completion;
use children::startup::realm::operations::Dispatch;
use children::startup::realm::configuration;
use children::startup::realm::picker;
use children::startup::realm::background;
use children::startup::realm::discovery;

public machine begin(setup: &mut Setup, job: Job, context: &Context) -> bool {
    transition (setup.phase in Phase::Dormant) && job != Job::None {
        true -> start(setup, job, context)
        _ -> (false)
    }
    machine start(setup: &mut Setup, job: Job, context: &Context) -> bool {
        setup.job = job;
        setup.outcome = Outcome::Success;
        setup.background_outcome = Outcome::Success;
        setup.reset_surfaces = false;
        let command: Command = first(setup, job, context);
        setup.phase = Phase::Ready { command: command };
        true
    }
}

machine first(setup: &mut Setup, job: Job, context: &Context) -> Command {
    transition job {
        Job::Configuration -> children::startup::realm::configuration::begin(setup, context)
        Job::Picker -> (Command::PreparePicker)
        Job::Background -> (Command::ReadBackground)
        Job::Discovery -> children::startup::realm::discovery::begin(context)
        Job::None -> (Command::Finish)
    }
}

public machine next(setup: &mut Setup) -> Dispatch {
    transition setup.phase {
        Phase::Ready { command } -> issue(setup, command)
        _ -> (Dispatch::Wait)
    }
    machine issue(setup: &mut Setup, command: Command) -> Dispatch {
        setup.phase = Phase::Waiting { command: command };
        Dispatch::Issue { command: command }
    }
}

public machine complete(setup: &mut Setup, completion: Completion) -> bool {
    transition setup.phase {
        Phase::Waiting { command } -> matching(setup, completion, command)
        _ -> (false)
    }
    machine matching(setup: &mut Setup, completion: Completion, command: Command) -> bool {
        transition command == completion.command {
            true -> completed(setup, completion)
            _ -> (false)
        }
    }
    machine completed(setup: &mut Setup, completion: Completion) -> bool {
        transition completion.command == Command::Finish {
            true -> finish(setup)
            _ -> advance(setup, completion)
        }
    }
    machine finish(setup: &mut Setup) -> bool {
        setup.phase = Phase::Dormant;
        true
    }
    machine advance(setup: &mut Setup, completion: Completion) -> bool {
        transition setup.job != Job::None {
            true -> queue(setup, completion)
            _ -> (false)
        }
    }
    machine queue(setup: &mut Setup, completion: Completion) -> bool {
        let command: Command = following(setup, completion);
        setup.phase = Phase::Ready { command: command };
        true
    }
}

machine following(setup: &mut Setup, completion: Completion) -> Command {
    transition setup.job {
        Job::Configuration -> children::startup::realm::configuration::completed(setup, completion)
        Job::Picker -> children::startup::realm::picker::completed(setup, completion)
        Job::Background -> children::startup::realm::background::completed(setup, completion)
        Job::Discovery -> children::startup::realm::discovery::completed(setup, completion)
        Job::None -> (Command::Finish)
    }
}
