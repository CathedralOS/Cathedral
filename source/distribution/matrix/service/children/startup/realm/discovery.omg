// A scoped Matrix configuration wins; Login plus Users selects a picker.
// Missing realm authority leaves setup to the owner. An unplaced view retries later.
use children/startup/realm/operations.omg;

public machine begin(context: &|operations|::Context) -> |operations|::Command {
    transition context.discover {
        true -> (|operations|::Command::Refresh)
        _ -> (|operations|::Command::RecoverStartup)
    }
}

public machine completed(setup: &mut |operations|::Setup, completion: |operations|::Completion) -> |operations|::Command {
    transition completion.command == |operations|::Command::InspectRealm {
        true -> inspected(setup, completion)
        _ -> required(setup, completion)
    }
    machine inspected(setup: &mut |operations|::Setup, completion: |operations|::Completion) -> |operations|::Command {
        transition completion.outcome {
            |operations|::Outcome::Success -> shape(completion.entries)
            |operations|::Outcome::Denied -> (|operations|::Command::MarkHosted)
            |operations|::Outcome::PeerClosed -> (|operations|::Command::MarkHosted)
            _ -> failed(setup, completion.outcome)
        }
    }
    machine required(setup: &mut |operations|::Setup, completion: |operations|::Completion) -> |operations|::Command {
        transition completion.outcome {
            |operations|::Outcome::Success -> succeeded(completion)
            _ -> failed(setup, completion.outcome)
        }
    }
}

machine shape(entries: |operations|::Entries) -> |operations|::Command {
    transition entries.matrix {
        true -> (|operations|::Command::ConfigureRealm)
        _ -> picker(entries)
    }
    machine picker(entries: |operations|::Entries) -> |operations|::Command {
        transition entries.login && entries.users {
            true -> (|operations|::Command::StartPicker)
            _ -> (|operations|::Command::MarkHosted)
        }
    }
}

machine failed(setup: &mut |operations|::Setup, outcome: |operations|::Outcome) -> |operations|::Command {
    setup.outcome = outcome;
    |operations|::Command::Finish
}

machine succeeded(completion: |operations|::Completion) -> |operations|::Command {
    transition completion.command {
        |operations|::Command::Refresh -> placed(completion.placed)
        |operations|::Command::ConfigureRealm -> (|operations|::Command::MarkHosted)
        |operations|::Command::StartPicker -> (|operations|::Command::MarkHosted)
        |operations|::Command::MarkHosted -> (|operations|::Command::RecoverStartup)
        _ -> (|operations|::Command::Finish)
    }
    machine placed(available: bool) -> |operations|::Command {
        transition available {
            true -> (|operations|::Command::InspectRealm)
            _ -> (|operations|::Command::Finish)
        }
    }
}
