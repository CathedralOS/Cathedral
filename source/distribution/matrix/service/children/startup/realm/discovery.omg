module children::startup::realm::discovery;

// A scoped Matrix configuration wins; Login plus Users selects a picker.
// Missing realm authority leaves setup to the owner. An unplaced view retries later.
use children::startup::realm::operations::Setup;
use children::startup::realm::operations::Command;
use children::startup::realm::operations::Outcome;
use children::startup::realm::operations::Completion;
use children::startup::realm::operations::Context;
use children::startup::realm::operations::Entries;

public machine begin(context: &Context) -> Command {
    transition context.discover {
        true -> (Command::Refresh)
        _ -> (Command::RecoverStartup)
    }
}

public machine completed(setup: &mut Setup, completion: Completion) -> Command {
    transition completion.command == Command::InspectRealm {
        true -> inspected(setup, completion)
        _ -> required(setup, completion)
    }
    machine inspected(setup: &mut Setup, completion: Completion) -> Command {
        transition completion.outcome {
            Outcome::Success -> shape(completion.entries)
            Outcome::Denied -> (Command::MarkHosted)
            Outcome::PeerClosed -> (Command::MarkHosted)
            _ -> failed(setup, completion.outcome)
        }
    }
    machine required(setup: &mut Setup, completion: Completion) -> Command {
        transition completion.outcome {
            Outcome::Success -> succeeded(completion)
            _ -> failed(setup, completion.outcome)
        }
    }
}

machine shape(entries: Entries) -> Command {
    transition entries.matrix {
        true -> (Command::ConfigureRealm)
        _ -> picker(entries)
    }
    machine picker(entries: Entries) -> Command {
        transition entries.login && entries.users {
            true -> (Command::StartPicker)
            _ -> (Command::MarkHosted)
        }
    }
}

machine failed(setup: &mut Setup, outcome: Outcome) -> Command {
    setup.outcome = outcome;
    Command::Finish
}

machine succeeded(completion: Completion) -> Command {
    transition completion.command {
        Command::Refresh -> placed(completion.placed)
        Command::ConfigureRealm -> (Command::MarkHosted)
        Command::StartPicker -> (Command::MarkHosted)
        Command::MarkHosted -> (Command::RecoverStartup)
        _ -> (Command::Finish)
    }
    machine placed(available: bool) -> Command {
        transition available {
            true -> (Command::InspectRealm)
            _ -> (Command::Finish)
        }
    }
}
