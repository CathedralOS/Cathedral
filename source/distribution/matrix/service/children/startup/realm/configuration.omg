module children::startup::realm::configuration;

// Bind/place before publication and chrome authority. Background failure is
// optional; rollback failures replace the original error rather than hide it.
use children::startup::realm::operations::Setup;
use children::startup::realm::operations::Command;
use children::startup::realm::operations::Outcome;
use children::startup::realm::operations::Completion;
use children::startup::realm::operations::Context;

public machine begin(setup: &mut Setup, context: &Context) -> Command {
    transition context.configured {
        true -> (Command::Finish)
        _ -> available(setup, context)
    }
    machine available(setup: &mut Setup, context: &Context) -> Command {
        transition context.busy {
            true -> busy(setup)
            _ -> (Command::Refresh)
        }
    }
    machine busy(setup: &mut Setup) -> Command {
        setup.outcome = Outcome::Busy;
        Command::Finish
    }
}

public machine completed(setup: &mut Setup, completion: Completion) -> Command {
    transition completion.command == Command::StartBackground {
        true -> background(setup, completion.outcome)
        _ -> required(setup, completion)
    }
    machine background(setup: &mut Setup, outcome: Outcome) -> Command {
        setup.background_outcome = outcome;
        transition outcome {
            Outcome::Success -> (Command::Flush)
            _ -> (Command::BackgroundFailed)
        }
    }
    machine required(setup: &mut Setup, completion: Completion) -> Command {
        transition completion.outcome {
            Outcome::Success -> succeeded(setup, completion.command)
            _ -> failed(setup, completion)
        }
    }
}

machine failed(setup: &mut Setup, completion: Completion) -> Command {
    setup.outcome = completion.outcome;
    transition completion.command {
        Command::AdmitLauncher -> (Command::StopLauncher)
        Command::BindLauncher -> (Command::StopLauncher)
        Command::PlaceLauncher -> clear(setup)
        _ -> (Command::Finish)
    }
    machine clear(setup: &mut Setup) -> Command {
        setup.reset_surfaces = true;
        Command::ClearWorkspace
    }
}

machine succeeded(setup: &Setup, command: Command) -> Command {
    transition command {
        Command::Refresh -> (Command::ReadConfiguration)
        Command::ReadConfiguration -> (Command::ValidateConfiguration)
        Command::ValidateConfiguration -> (Command::AdmitLauncher)
        Command::AdmitLauncher -> (Command::ReleaseImage)
        Command::ReleaseImage -> (Command::BindLauncher)
        Command::BindLauncher -> (Command::InstallWorkspace)
        Command::InstallWorkspace -> (Command::PlaceLauncher)
        Command::PlaceLauncher -> (Command::StartBackground)
        Command::BackgroundFailed -> (Command::Flush)
        Command::Flush -> (Command::Notify)
        Command::Notify -> (Command::GrantChrome)
        Command::GrantChrome -> (Command::RecordLauncher)
        Command::RecordLauncher -> (Command::Finish)
        Command::ClearWorkspace -> (Command::StopLauncher)
        Command::ResetSurfaces -> (Command::Finish)
        Command::StopLauncher -> stopped(setup)
        _ -> (Command::Finish)
    }
    machine stopped(setup: &Setup) -> Command {
        transition setup.reset_surfaces {
            true -> (Command::ResetSurfaces)
            _ -> (Command::Finish)
        }
    }
}
