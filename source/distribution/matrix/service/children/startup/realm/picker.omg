module children::startup::realm::picker;

// Recovery-budget arming precedes the read; setup refusal reaches the owner.
use children::startup::realm::operations::Setup;
use children::startup::realm::operations::Command;
use children::startup::realm::operations::Outcome;
use children::startup::realm::operations::Completion;

public machine completed(setup: &mut Setup, completion: Completion) -> Command {
    transition completion.outcome {
        Outcome::Success -> succeeded(completion.command)
        _ -> failed(setup, completion.outcome)
    }
    machine failed(setup: &mut Setup, outcome: Outcome) -> Command {
        setup.outcome = outcome;
        Command::Finish
    }
}

machine succeeded(command: Command) -> Command {
    transition command {
        Command::PreparePicker -> (Command::ReadPicker)
        Command::ReadPicker -> (Command::ValidatePicker)
        Command::ValidatePicker -> (Command::AdmitPicker)
        Command::AdmitPicker -> (Command::BindPicker)
        Command::BindPicker -> (Command::PlacePicker)
        Command::PlacePicker -> (Command::InstallPicker)
        Command::InstallPicker -> (Command::Notify)
        Command::Notify -> (Command::RecordPicker)
        Command::RecordPicker -> (Command::Finish)
        _ -> (Command::Finish)
    }
}
