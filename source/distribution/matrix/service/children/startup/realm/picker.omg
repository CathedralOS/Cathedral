// Recovery-budget arming precedes the read; setup refusal reaches the owner.
use children/startup/realm/operations.omg;

public machine completed(setup: &mut |operations|::Setup, completion: |operations|::Completion) -> |operations|::Command {
    transition completion.outcome {
        |operations|::Outcome::Success -> succeeded(completion.command)
        _ -> failed(setup, completion.outcome)
    }
    machine failed(setup: &mut |operations|::Setup, outcome: |operations|::Outcome) -> |operations|::Command {
        setup.outcome = outcome;
        |operations|::Command::Finish
    }
}

machine succeeded(command: |operations|::Command) -> |operations|::Command {
    transition command {
        |operations|::Command::PreparePicker -> (|operations|::Command::ReadPicker)
        |operations|::Command::ReadPicker -> (|operations|::Command::ValidatePicker)
        |operations|::Command::ValidatePicker -> (|operations|::Command::AdmitPicker)
        |operations|::Command::AdmitPicker -> (|operations|::Command::BindPicker)
        |operations|::Command::BindPicker -> (|operations|::Command::PlacePicker)
        |operations|::Command::PlacePicker -> (|operations|::Command::InstallPicker)
        |operations|::Command::InstallPicker -> (|operations|::Command::Notify)
        |operations|::Command::Notify -> (|operations|::Command::RecordPicker)
        |operations|::Command::RecordPicker -> (|operations|::Command::Finish)
        _ -> (|operations|::Command::Finish)
    }
}
