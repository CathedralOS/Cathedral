module children::startup::realm::background;

// Background has presentation only; failed placement must reclaim its admitted task.
use children::startup::realm::operations;

public machine background_next(p: &mut [u64; 128]) -> u64 {
    transition p[3] == 0u64 {
        true -> success(p)
        _ -> failed(p)
    }
    state failed(p: &mut [u64; 128]) -> u64 {
        p[18] = p[3];
        transition p[2] == children::startup::realm::operations::PLACE_BACKGROUND {
            true -> (children::startup::realm::operations::STOP_BACKGROUND)
            _ -> (children::startup::realm::operations::FINISH)
        }
    }
    state success(p: &mut [u64; 128]) -> u64 {
        transition p[2] {
            children::startup::realm::operations::READ_BACKGROUND -> (children::startup::realm::operations::ADMIT_BACKGROUND)
            children::startup::realm::operations::ADMIT_BACKGROUND -> (children::startup::realm::operations::PLACE_BACKGROUND)
            children::startup::realm::operations::PLACE_BACKGROUND -> (children::startup::realm::operations::RECORD_BACKGROUND)
            _ -> (children::startup::realm::operations::FINISH)
        }
    }
}
