// Background has presentation only. Failed placement reclaims the admitted task;
// failed reclamation remains a failure, replacing the preceding placement error.
use children/startup/realm/operations.omg;

public machine completed(setup: &mut |operations|::Setup, completion: |operations|::Completion) -> |operations|::Command {
    transition completion.outcome {
        |operations|::Outcome::Success -> succeeded(completion.command)
        _ -> failed(setup, completion)
    }
    machine failed(setup: &mut |operations|::Setup, completion: |operations|::Completion) -> |operations|::Command {
        setup.outcome = completion.outcome;
        transition completion.command {
            |operations|::Command::PlaceBackground -> (|operations|::Command::StopBackground)
            _ -> (|operations|::Command::Finish)
        }
    }
}

machine succeeded(command: |operations|::Command) -> |operations|::Command {
    transition command {
        |operations|::Command::ReadBackground -> (|operations|::Command::AdmitBackground)
        |operations|::Command::AdmitBackground -> (|operations|::Command::PlaceBackground)
        |operations|::Command::PlaceBackground -> (|operations|::Command::RecordBackground)
        _ -> (|operations|::Command::Finish)
    }
}
