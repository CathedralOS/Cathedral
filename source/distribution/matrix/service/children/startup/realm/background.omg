module children::startup::realm::background;

// Background has presentation only. Failed placement reclaims the admitted task;
// failed reclamation remains a failure, replacing the preceding placement error.
use children::startup::realm::operations::Setup;
use children::startup::realm::operations::Command;
use children::startup::realm::operations::Outcome;
use children::startup::realm::operations::Completion;

public machine completed(setup: &mut Setup, completion: Completion) -> Command {
    transition completion.outcome {
        Outcome::Success -> succeeded(completion.command)
        _ -> failed(setup, completion)
    }
    machine failed(setup: &mut Setup, completion: Completion) -> Command {
        setup.outcome = completion.outcome;
        transition completion.command {
            Command::PlaceBackground -> (Command::StopBackground)
            _ -> (Command::Finish)
        }
    }
}

machine succeeded(command: Command) -> Command {
    transition command {
        Command::ReadBackground -> (Command::AdmitBackground)
        Command::AdmitBackground -> (Command::PlaceBackground)
        Command::PlaceBackground -> (Command::RecordBackground)
        _ -> (Command::Finish)
    }
}
