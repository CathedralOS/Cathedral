module children::startup::realm::operations;

// One setup invocation. It records sequencing and outcomes, not resources or
// identity: the host retains images, tasks, connections and cleanup custody.
public data Job [copy] {
    case None;
    case Configuration;
    case Picker;
    case Background;
    case Discovery;
}

public data Command [copy] {
    case Refresh;
    case ReadConfiguration;
    case ValidateConfiguration;
    case AdmitLauncher;
    case ReleaseImage;
    case BindLauncher;
    case InstallWorkspace;
    case PlaceLauncher;
    case StartBackground;
    case BackgroundFailed;
    case Flush;
    case Notify;
    case GrantChrome;
    case RecordLauncher;
    case StopLauncher;
    case ClearWorkspace;
    case ResetSurfaces;
    case PreparePicker;
    case ReadPicker;
    case ValidatePicker;
    case AdmitPicker;
    case BindPicker;
    case PlacePicker;
    case InstallPicker;
    case RecordPicker;
    case ReadBackground;
    case AdmitBackground;
    case PlaceBackground;
    case RecordBackground;
    case StopBackground;
    case InspectRealm;
    case ConfigureRealm;
    case StartPicker;
    case MarkHosted;
    case RecoverStartup;
    case Finish;
}

public data Phase [copy] {
    case Dormant;
    case Ready(command: Command);
    case Waiting(command: Command);
}

public data Outcome [copy] {
    case Success;
    case Busy;
    case Denied;
    case PeerClosed;
    case Failed(status: u64);
}

public data Setup {
    phase: Phase;
    job: Job;
    outcome: Outcome;
    background_outcome: Outcome;
    reset_surfaces: bool;
}

public data Context {
    configured: bool;
    busy: bool;
    discover: bool;
}

public data Entries [copy] {
    matrix: bool;
    login: bool;
    users: bool;
}

public data Completion [copy] {
    command: Command;
    outcome: Outcome;
    placed: bool;
    entries: Entries;
}

public data Dispatch [copy] {
    case Wait;
    case Issue(command: Command);
}
