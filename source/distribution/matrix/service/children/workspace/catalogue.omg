module children::workspace::catalogue;

// The desktop owns three app positions; chrome/background are never catalogue entries.
// Opaque state 16..23: last issued ticket, active slot, three ticket/object pairs.
// Tickets name instances locally. They confer no authority over the host's tasks.
public machine catalogue_decision(p: &mut [u64; 128]) -> u64 {
    transition p[1] {
        0u64 -> publish(p)
        1u64 -> retire(p)
        2u64 -> activate(p)
        3u64 -> read_entry(p)
        4u64 -> select(p)
        5u64 -> fallback(p)
        6u64 -> active(p)
        7u64 -> capacity(p)
        _ -> (0u64)
    }
}

machine publish(p: &mut [u64; 128]) -> u64 {
    transition p[2] >= 1u64 && p[2] <= 3u64 && p[16] < 18446744073709551615u64 {
        true -> vacant(p, p[2])
        _ -> (0u64)
    }
    state vacant(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        transition p[16u64 + slot * 2u64] == 0u64 {
            true -> install(p, slot)
            _ -> (0u64)
        }
    }
    state install(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        p[16] = p[16] + 1u64;
        p[16u64 + slot * 2u64] = p[16];
        p[17u64 + slot * 2u64] = p[3];
        1u64
    }
}

machine retire(p: &mut [u64; 128]) -> u64 {
    transition p[2] >= 1u64 && p[2] <= 3u64 {
        true -> remove(p, p[2])
        _ -> (0u64)
    }
    state remove(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        p[16u64 + slot * 2u64] = 0u64;
        p[17u64 + slot * 2u64] = 0u64;
        transition p[17] == slot {
            true -> clear(p)
            _ -> (1u64)
        }
    }
    state clear(p: &mut [u64; 128]) -> u64 {
        p[17] = 0u64;
        1u64
    }
}

machine activate(p: &mut [u64; 128]) -> u64 {
    transition p[2] >= 1u64 && p[2] <= 3u64 {
        true -> occupied(p, p[2])
        _ -> (0u64)
    }
    state occupied(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        transition p[16u64 + slot * 2u64] != 0u64 {
            true -> commit(p, slot)
            _ -> (0u64)
        }
    }
    state commit(p: &mut [u64; 128], slot: u64) -> u64 {
        p[17] = slot;
        1u64
    }
}

machine read_entry(p: &mut [u64; 128]) -> u64 {
    transition p[2] < 3u64 {
        true -> row(p, p[2] + 1u64)
        _ -> (0u64)
    }
    state row(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        transition p[16u64 + slot * 2u64] != 0u64 {
            true -> found(p, slot)
            _ -> (1u64)
        }
    }
    state found(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        p[8] = p[16u64 + slot * 2u64];
        p[9] = p[17u64 + slot * 2u64];
        transition p[17] == slot {
            true -> selected(p)
            _ -> (2u64)
        }
    }
    state selected(p: &mut [u64; 128]) -> u64 {
        p[10] = 1u64;
        2u64
    }
}

machine select(p: &mut [u64; 128]) -> u64 {
    transition p[2] != 0u64 {
        true -> scan(p, 1u64)
        _ -> (0u64)
    }
    state scan(p: &mut [u64; 128], slot: u64) -> u64 {
        transition slot <= 3u64 && slot >= 1u64 {
            true -> row(p, slot)
            _ -> (0u64)
        }
    }
    state row(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        transition p[16u64 + slot * 2u64] == p[2] {
            true -> found(p, slot)
            _ -> scan(p, slot + 1u64)
        }
    }
    state found(p: &mut [u64; 128], slot: u64) -> u64 {
        p[8] = slot;
        transition p[3] != 0u64 {
            true -> (1u64)
            _ -> ready(p, slot)
        }
    }
    state ready(p: &mut [u64; 128], slot: u64) -> u64 {
        transition p[17] == slot {
            true -> (2u64)
            _ -> (3u64)
        }
    }
}

machine fallback(p: &mut [u64; 128]) -> u64 {
    transition p[17] == 0u64 {
        true -> scan(p, 1u64)
        _ -> (0u64)
    }
    state scan(p: &mut [u64; 128], slot: u64) -> u64 {
        transition slot >= 1u64 && slot <= 3u64 {
            true -> row(p, slot)
            _ -> (0u64)
        }
    }
    state row(p: &mut [u64; 128], slot: u64) -> u64 requires slot >= 1u64 && slot <= 3u64 {
        transition p[16u64 + slot * 2u64] != 0u64 {
            true -> found(p, slot)
            _ -> scan(p, slot + 1u64)
        }
    }
    state found(p: &mut [u64; 128], slot: u64) -> u64 {
        p[8] = slot;
        1u64
    }
}

machine active(p: &mut [u64; 128]) -> u64 {
    p[8] = p[17];
    1u64
}

machine capacity(p: &[u64; 128]) -> u64 {
    transition p[16] < 18446744073709551615u64 {
        true -> (1u64)
        _ -> (0u64)
    }
}
