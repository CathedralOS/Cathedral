module children::workspace::catalogue;

// Three stock app positions; chrome/background never enter this catalogue.
// Instance tickets are monotonic local names, not authority over host tasks.
public const LAST_TICKET: u64 = 18446744073709551615u64;

public data Instance [copy] {
    case Empty;
    case Published(ticket: u64, program: u64);
}

public data Position [copy] {
    case None;
    case App(slot: u64);
}

public data Catalogue {
    last_ticket: u64;
    selected: Position;
    instances: [Instance; 3];
}

public data Entry [copy] {
    case Outside;
    case Empty;
    case Present(ticket: u64, program: u64, selected: bool);
}

public data Selection [copy] {
    case Missing;
    case Busy(slot: u64);
    case Current(slot: u64);
    case Switch(slot: u64);
}

public machine publish(catalogue: &mut Catalogue, slot: u64, program: u64) -> bool {
    transition slot >= 1u64 && slot <= 3u64 && catalogue.last_ticket < LAST_TICKET {
        true -> vacant(catalogue, slot, program)
        _ -> (false)
    }
    machine vacant(catalogue: &mut Catalogue, slot: u64, program: u64) -> bool
        requires slot >= 1u64 && slot <= 3u64 && catalogue.last_ticket < LAST_TICKET {
        transition catalogue.instances[slot - 1u64] {
            Instance::Empty -> install(catalogue, slot, program)
            _ -> (false)
        }
    }
    machine install(catalogue: &mut Catalogue, slot: u64, program: u64) -> bool
        requires slot >= 1u64 && slot <= 3u64 && catalogue.last_ticket < LAST_TICKET {
        catalogue.last_ticket = catalogue.last_ticket + 1u64;
        catalogue.instances[slot - 1u64] = Instance::Published {
            ticket: catalogue.last_ticket, program: program
        };
        true
    }
}

public machine retire(catalogue: &mut Catalogue, slot: u64) -> bool {
    transition slot >= 1u64 && slot <= 3u64 {
        true -> remove(catalogue, slot)
        _ -> (false)
    }
    machine remove(catalogue: &mut Catalogue, slot: u64) -> bool requires slot >= 1u64 && slot <= 3u64 {
        catalogue.instances[slot - 1u64] = Instance::Empty;
        transition is_selected(catalogue, slot) {
            true -> clear(catalogue)
            _ -> (true)
        }
    }
    machine clear(catalogue: &mut Catalogue) -> bool {
        catalogue.selected = Position::None;
        true
    }
}

public machine activate(catalogue: &mut Catalogue, slot: u64) -> bool {
    transition slot >= 1u64 && slot <= 3u64 {
        true -> occupied(catalogue, slot)
        _ -> (false)
    }
    machine occupied(catalogue: &mut Catalogue, slot: u64) -> bool requires slot >= 1u64 && slot <= 3u64 {
        transition catalogue.instances[slot - 1u64] {
            Instance::Published -> commit(catalogue, slot)
            _ -> (false)
        }
    }
    machine commit(catalogue: &mut Catalogue, slot: u64) -> bool {
        catalogue.selected = Position::App { slot: slot };
        true
    }
}

public machine entry(catalogue: &Catalogue, index: u64) -> Entry {
    transition index < 3u64 {
        true -> row(catalogue, index)
        _ -> (Entry::Outside)
    }
    machine row(catalogue: &Catalogue, index: u64) -> Entry requires index < 3u64 {
        let instance: Instance = catalogue.instances[index];
        transition instance {
            Instance::Published { ticket, program } -> (Entry::Present {
                ticket: ticket, program: program, selected: is_selected(catalogue, index + 1u64)
            })
            Instance::Empty -> (Entry::Empty)
        }
    }
}

public machine select(catalogue: &Catalogue, ticket: u64, busy: bool) -> Selection {
    transition ticket != 0u64 {
        true -> scan(catalogue, ticket, busy, 1u64)
        _ -> (Selection::Missing)
    }
    machine scan(catalogue: &Catalogue, ticket: u64, busy: bool, slot: u64) -> Selection {
        transition slot >= 1u64 && slot <= 3u64 {
            true -> row(catalogue, ticket, busy, slot)
            _ -> (Selection::Missing)
        }
    }
    machine row(catalogue: &Catalogue, ticket: u64, busy: bool, slot: u64) -> Selection
        requires slot >= 1u64 && slot <= 3u64 {
        transition matches(catalogue.instances[slot - 1u64], ticket) {
            true -> found(catalogue, busy, slot)
            _ -> scan(catalogue, ticket, busy, slot + 1u64)
        }
    }
    machine found(catalogue: &Catalogue, busy: bool, slot: u64) -> Selection {
        transition busy {
            true -> (Selection::Busy { slot: slot })
            _ -> ready(catalogue, slot)
        }
    }
    machine ready(catalogue: &Catalogue, slot: u64) -> Selection {
        transition is_selected(catalogue, slot) {
            true -> (Selection::Current { slot: slot })
            _ -> (Selection::Switch { slot: slot })
        }
    }
}

public machine fallback(catalogue: &Catalogue) -> Position {
    transition catalogue.selected {
        Position::None -> scan(catalogue, 1u64)
        _ -> (Position::None)
    }
    machine scan(catalogue: &Catalogue, slot: u64) -> Position {
        transition slot >= 1u64 && slot <= 3u64 {
            true -> row(catalogue, slot)
            _ -> (Position::None)
        }
    }
    machine row(catalogue: &Catalogue, slot: u64) -> Position requires slot >= 1u64 && slot <= 3u64 {
        transition catalogue.instances[slot - 1u64] {
            Instance::Published -> (Position::App { slot: slot })
            _ -> scan(catalogue, slot + 1u64)
        }
    }
}

public machine has_ticket_capacity(catalogue: &Catalogue) -> bool {
    catalogue.last_ticket < LAST_TICKET
}

machine is_selected(catalogue: &Catalogue, wanted: u64) -> bool {
    transition catalogue.selected {
        Position::App { slot } -> (slot == wanted)
        Position::None -> (false)
    }
}

machine matches(instance: Instance, wanted: u64) -> bool {
    transition instance {
        Instance::Published { ticket, program } -> (ticket == wanted)
        Instance::Empty -> (false)
    }
}
