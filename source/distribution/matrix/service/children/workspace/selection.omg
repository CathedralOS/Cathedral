module children::workspace::selection;

// Observe the actual scene result before choosing activation or compensation.
// Failed restoration is terminal failure, never successful release of custody.
use children::workspace::operation::Switch;
use children::workspace::operation::Command;
use children::workspace::operation::Phase;
use children::workspace::operation::Completion;

public machine completed(work: &mut Switch, completion: Completion) -> bool {
    transition completion.command {
        Command::BeginScene -> begun(work)
        Command::AwaitScene -> observed(work, completion.committed)
        Command::Activate -> activated(work, completion.status)
        Command::BeginRestore -> restoring(work, completion.status)
        Command::AwaitRestore -> restored(work, completion.status, completion.committed)
        Command::Finish -> finished(work)
        Command::Failed -> (false)
    }
    machine begun(work: &mut Switch) -> bool {
        transition work.refusal == 0u64 {
            true -> queue(work, Command::AwaitScene)
            _ -> queue(work, Command::Finish)
        }
    }
    machine observed(work: &mut Switch, committed: bool) -> bool {
        transition committed {
            true -> after_commit(work)
            _ -> queue(work, Command::Finish)
        }
    }
    machine after_commit(work: &mut Switch) -> bool {
        transition work.refusal == 0u64 {
            true -> queue(work, Command::Activate)
            _ -> queue(work, Command::BeginRestore)
        }
    }
    machine activated(work: &mut Switch, status: u64) -> bool {
        transition status == 0u64 {
            true -> queue(work, Command::Finish)
            _ -> queue(work, Command::Failed)
        }
    }
    machine restoring(work: &mut Switch, status: u64) -> bool {
        transition status == 0u64 {
            true -> queue(work, Command::AwaitRestore)
            _ -> queue(work, Command::Failed)
        }
    }
    machine restored(work: &mut Switch, status: u64, committed: bool) -> bool {
        transition status == 0u64 && committed {
            true -> queue(work, Command::Finish)
            _ -> queue(work, Command::Failed)
        }
    }
    machine finished(work: &mut Switch) -> bool {
        work.phase = Phase::Dormant;
        true
    }
}

machine queue(work: &mut Switch, command: Command) -> bool {
    work.phase = Phase::Ready { command: command };
    true
}
