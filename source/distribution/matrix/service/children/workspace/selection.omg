module children::workspace::selection;

// Existing-app selection: publish a scene, activate locally, or restore before replying.
// State 16..18: command (issued + 32), operation ticket, first refusal.
// Only the host retains task identities, requests and scene-resource custody.
const BEGIN: u64 = 1u64;
const WAIT: u64 = 2u64;
const ACTIVATE: u64 = 3u64;
const RESTORE: u64 = 4u64;
const WAIT_RESTORE: u64 = 5u64;
const FINISH: u64 = 6u64;
const FAILED: u64 = 7u64;
public machine selection_decision(p: &mut [u64; 128]) -> u64 {
    transition p[1] {
        0u64 -> initialize(p)
        1u64 -> next(p)
        2u64 -> completed(p)
        3u64 -> cancel(p)
        _ -> (0u64)
    }
}

machine initialize(p: &mut [u64; 128]) -> u64 {
    transition p[16] == 0u64 && p[2] != 0u64 {
        true -> start(p)
        _ -> (0u64)
    }
    state start(p: &mut [u64; 128]) -> u64 {
        p[16] = BEGIN;
        p[17] = p[2];
        p[18] = 0u64;
        1u64
    }
}

machine next(p: &mut [u64; 128]) -> u64 {
    transition p[16] >= BEGIN && p[16] <= FAILED {
        true -> issue(p)
        _ -> (0u64)
    }
    state issue(p: &mut [u64; 128]) -> u64 {
        let command: u64 = p[16];
        p[16] = command + 32u64;
        command
    }
}

machine cancel(p: &mut [u64; 128]) -> u64 {
    transition p[2] != 0u64 && p[18] == 0u64 && (p[16] == BEGIN || p[16] == BEGIN + 32u64 || p[16] == WAIT || p[16] == WAIT + 32u64) {
        true -> refused(p)
        _ -> (0u64)
    }
    state refused(p: &mut [u64; 128]) -> u64 {
        p[18] = p[2];
        1u64
    }
}

machine completed(p: &mut [u64; 128]) -> u64 {
    transition p[2] == p[17] && p[3] >= BEGIN && p[3] <= FINISH && p[16] == p[3] + 32u64 {
        true -> remember(p)
        _ -> (0u64)
    }
    state remember(p: &mut [u64; 128]) -> u64 {
        transition p[18] == 0u64 {
            true -> status(p)
            _ -> advance(p)
        }
    }
    state status(p: &mut [u64; 128]) -> u64 {
        p[18] = p[4];
        transition true {
            true -> advance(p)
        }
    }
    state advance(p: &mut [u64; 128]) -> u64 {
        transition p[3] {
            BEGIN -> begun(p)
            WAIT -> observed(p)
            ACTIVATE -> activated(p)
            RESTORE -> restoring(p)
            WAIT_RESTORE -> restored(p)
            FINISH -> done(p)
            _ -> (0u64)
        }
    }
    state begun(p: &mut [u64; 128]) -> u64 {
        transition p[18] == 0u64 {
            true -> waiting(p)
            _ -> finish(p)
        }
    }
    state waiting(p: &mut [u64; 128]) -> u64 {
        p[16] = WAIT;
        1u64
    }
    state observed(p: &mut [u64; 128]) -> u64 {
        transition p[5] != 0u64 {
            true -> committed(p)
            _ -> finish(p)
        }
    }
    state committed(p: &mut [u64; 128]) -> u64 {
        transition p[18] == 0u64 {
            true -> activate(p)
            _ -> restore(p)
        }
    }
    state activate(p: &mut [u64; 128]) -> u64 {
        p[16] = ACTIVATE;
        1u64
    }
    state restore(p: &mut [u64; 128]) -> u64 {
        p[16] = RESTORE;
        1u64
    }
    state activated(p: &mut [u64; 128]) -> u64 {
        transition p[4] == 0u64 {
            true -> finish(p)
            _ -> failed(p)
        }
    }
    state restoring(p: &mut [u64; 128]) -> u64 {
        transition p[4] == 0u64 {
            true -> wait_restore(p)
            _ -> failed(p)
        }
    }
    state wait_restore(p: &mut [u64; 128]) -> u64 {
        p[16] = WAIT_RESTORE;
        1u64
    }
    state restored(p: &mut [u64; 128]) -> u64 {
        transition p[4] == 0u64 && p[5] != 0u64 {
            true -> finish(p)
            _ -> failed(p)
        }
    }
    state finish(p: &mut [u64; 128]) -> u64 {
        p[16] = FINISH;
        1u64
    }
    // A failed restoration cannot release visual custody as if rollback succeeded.
    state failed(p: &mut [u64; 128]) -> u64 {
        p[16] = FAILED;
        1u64
    }
    state done(p: &mut [u64; 128]) -> u64 {
        p[16] = 0u64;
        1u64
    }
}
