module children::configuration::encoding;

// CTHMAT02: preserve startup-only authority fields while editing geometry.
use children::configuration::name;

public machine word(bytes: &[u8; 104], at: u64) -> u64 {
    transition at <= 96u64 {
        true -> read(bytes, at, 0u64, 0u64)
        _ -> (0u64)
    }
    machine read(bytes: &[u8; 104], at: u64, i: u64, value: u64) -> u64 {
        transition at <= 96u64 && i < 8u64 {
            true -> byte(bytes, at, i, value)
            _ -> (value)
        }
    }
    machine byte(bytes: &[u8; 104], at: u64, i: u64, value: u64) -> u64 requires at <= 96u64 && i < 8u64 {
        transition {
            _ -> read(bytes, at, i + 1u64, value | ((bytes[at + i] as u64) << (i * 8u64)))
        }
    }
}

public machine set_word(bytes: &mut [u8; 104], at: u64, value: u64) {
    transition {
        _ -> write(bytes, at, value, 0u64)
    }
    machine write(bytes: &mut [u8; 104], at: u64, value: u64, i: u64) {
        transition at <= 96u64 && i < 8u64 {
            true -> byte(bytes, at, value, i)
            _ -> done()
        }
    }
    machine byte(bytes: &mut [u8; 104], at: u64, value: u64, i: u64) requires at <= 96u64 && i < 8u64 {
        bytes[at + i] = ((value >> (i * 8u64)) & 255u64) as u8;
        transition {
            _ -> write(bytes, at, value, i + 1u64)
        }
    }
    machine done() {
    }
}

public machine equal(a: &[u8; 104], b: &[u8; 104]) -> bool {
    transition {
        _ -> scan(a, b, 0u64)
    }
    machine scan(a: &[u8; 104], b: &[u8; 104], i: u64) -> bool {
        transition i < 104u64 {
            true -> byte(a, b, i)
            _ -> (true)
        }
    }
    machine byte(a: &[u8; 104], b: &[u8; 104], i: u64) -> bool requires i < 104u64 {
        transition a[i] == b[i] {
            true -> scan(a, b, i + 1u64)
            _ -> (false)
        }
    }
}

public machine normalize(bytes: &mut [u8; 104]) -> bool {
    transition bytes[0] == 67u8 && bytes[1] == 84u8 && bytes[2] == 72u8 && bytes[3] == 77u8 && bytes[4] == 65u8 && bytes[5] == 84u8 && bytes[6] == 48u8 && (bytes[7] == 49u8 || bytes[7] == 50u8) && children::configuration::name::valid_name(bytes) {
        true -> bounds(bytes)
        _ -> (false)
    }
    machine bounds(bytes: &mut [u8; 104]) -> bool {
        transition word(bytes, 40u64) <= 128u64 && word(bytes, 48u64) <= 1024u64 && word(bytes, 56u64) <= 1536u64 && word(bytes, 64u64) <= 4096u64 && word(bytes, 72u64) <= 4096u64 && word(bytes, 80u64) <= 4096u64 && word(bytes, 88u64) <= 64u64 && word(bytes, 96u64) & ~4503599627370367u64 == 0u64 {
            true -> version(bytes)
            _ -> (false)
        }
    }
    machine version(bytes: &mut [u8; 104]) -> bool {
        transition bytes[7] == 49u8 {
            true -> legacy(bytes)
            _ -> (true)
        }
    }
    machine legacy(bytes: &mut [u8; 104]) -> bool {
        let margin: u64 = small(word(bytes, 64u64));
        let gap: u64 = small(word(bytes, 80u64));
        set_word(bytes, 64u64, margin);
        set_word(bytes, 72u64, 80u64);
        set_word(bytes, 80u64, gap);
        bytes[7] = 50u8;
        true
    }
}

machine small(value: u64) -> u64 {
    transition value < 8u64 {
        true -> (value)
        _ -> (8u64)
    }
}
