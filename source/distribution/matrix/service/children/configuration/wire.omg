// Actual live-layout IPC syntax. The host retains the epoch and original request.
use requests/desktop.omg;
use children/configuration/main.omg;
use children/configuration/placement.omg;

public machine decode(words: &[u64; 8]) -> |main|::Request {
    transition words[0] == |desktop|::APPLY_LAYOUT
        && words[5] == 0u64 && words[6] == 0u64 && words[7] == 0u64 {
        true -> (|main|::Request::Layout { geometry: |placement|::Geometry {
            margin: words[2], bar_height: words[3], gap: words[4]
        } })
        _ -> (|main|::Request::Malformed)
    }
}
