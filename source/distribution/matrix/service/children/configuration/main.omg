module children::configuration::main;

// Live stock layout: authority, exclusion, syntax, geometry, then role placement.
// The host rechecks exact incarnation/epoch and owns atomic local mutation.
// Saved configuration bytes have their separate entrance in encoding.omg.
use children::configuration::placement;
use children::configuration::placement::Geometry;
use children::configuration::placement::Extent;
use children::configuration::placement::Rectangle;
use children::configuration::placement::Placement;

public data Facts {
    authorized: bool;
    busy: bool;
    extent: Extent;
    standing: u64;
}

public data Request [copy] {
    case Malformed;
    case Layout(geometry: Geometry);
}

public data Plan {
    chrome: Rectangle;
    apps: [Rectangle; 3];
    background: Rectangle;
    remember: u64;
}

public data Decision {
    case Denied;
    case Busy;
    case Invalid;
    case Ready(plan: Plan);
}

// Only stock app positions 1, 2 and 3 have standing placements to remember.
const APP_POSITIONS: u64 = 14u64;

public machine prepare(facts: &Facts, request: Request) -> Decision {
    transition facts.authorized {
        true -> idle(facts, request)
        _ -> (Decision::Denied)
    }
    machine idle(facts: &Facts, request: Request) -> Decision {
        transition facts.busy {
            true -> (Decision::Busy)
            _ -> canonical(facts, request)
        }
    }
    machine canonical(facts: &Facts, request: Request) -> Decision {
        transition request {
            Request::Layout { geometry } -> geometry_plan(facts, &geometry)
            Request::Malformed -> (Decision::Invalid)
        }
    }
    machine geometry_plan(facts: &Facts, geometry: &Geometry) -> Decision {
        let placement: Placement = children::configuration::placement::place(geometry, &facts.extent);
        transition placement {
            Placement::Placed { chrome, workspace } -> roles(facts, chrome, workspace)
            Placement::Invalid -> (Decision::Invalid)
        }
    }
}

machine roles(facts: &Facts, chrome: Rectangle, workspace: Rectangle) -> Decision {
    let mut plan: Plan;
    plan.chrome = chrome;
    plan.apps[0] = workspace;
    plan.apps[1] = workspace;
    plan.apps[2] = workspace;
    plan.background = Rectangle { x: 0u64, y: 0u64,
        width: facts.extent.width, height: facts.extent.height };
    plan.remember = facts.standing & APP_POSITIONS;
    Decision::Ready { plan: plan }
}
