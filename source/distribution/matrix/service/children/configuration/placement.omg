module children::configuration::placement;

// Checked stock bottom bar and workspace. Every subtraction follows its bound;
// extreme input values cannot wrap into an accepted rectangle.
public data Geometry [copy] {
    margin: u64;
    bar_height: u64;
    gap: u64;
}

public data Extent [copy] {
    width: u64;
    height: u64;
}

public data Rectangle [copy] {
    x: u64;
    y: u64;
    width: u64;
    height: u64;
}

public data Placement [copy] {
    case Invalid;
    case Placed(chrome: Rectangle, workspace: Rectangle);
}

public machine place(geometry: &Geometry, extent: &Extent) -> Placement {
    transition geometry.margin <= extent.width && geometry.margin <= extent.height
        && geometry.bar_height != 0u64 {
        true -> bar(geometry, extent)
        _ -> (Placement::Invalid)
    }
    machine bar(geometry: &Geometry, extent: &Extent) -> Placement
        requires geometry.margin <= extent.width && geometry.margin <= extent.height {
        transition geometry.bar_height <= extent.height - geometry.margin {
            true -> gap(geometry, extent)
            _ -> (Placement::Invalid)
        }
    }
    machine gap(geometry: &Geometry, extent: &Extent) -> Placement
        requires geometry.margin <= extent.width && geometry.margin <= extent.height
            && geometry.bar_height <= extent.height - geometry.margin {
        let y: u64 = extent.height - geometry.margin - geometry.bar_height;
        transition geometry.margin <= y {
            true -> space(geometry, extent, y)
            _ -> (Placement::Invalid)
        }
    }
    machine space(geometry: &Geometry, extent: &Extent, y: u64) -> Placement
        requires geometry.margin <= y && geometry.margin <= extent.width {
        let remaining_width: u64 = extent.width - geometry.margin;
        transition geometry.gap < y - geometry.margin && geometry.margin < remaining_width {
            true -> placed(geometry, y, remaining_width)
            _ -> (Placement::Invalid)
        }
    }
    machine placed(geometry: &Geometry, y: u64, remaining_width: u64) -> Placement
        requires geometry.margin <= y && geometry.gap < y - geometry.margin
            && geometry.margin < remaining_width {
        let width: u64 = remaining_width - geometry.margin;
        let height: u64 = y - geometry.margin - geometry.gap;
        Placement::Placed {
            chrome: Rectangle { x: geometry.margin, y: y, width: width, height: geometry.bar_height },
            workspace: Rectangle { x: geometry.margin, y: geometry.margin, width: width, height: height }
        }
    }
}
