module children::configuration::placement;

// Checked bottom bar + workspace. Subtractions only follow their bounds;
// reject huge wire values without ever wrapping into a valid rectangle.
public machine place(p: &mut [u64; 128]) -> u64 {
    transition p[1] <= p[4] / 2u64 && p[1] <= p[5] && p[2] != 0u64 {
        true -> bar(p)
        _ -> (0u64)
    }
    state bar(p: &mut [u64; 128]) -> u64 requires p[1] <= p[5] {
        transition p[2] <= p[5] - p[1] {
            true -> gap(p)
            _ -> (0u64)
        }
    }
    state gap(p: &mut [u64; 128]) -> u64 {
        let y: u64 = p[5] - p[1] - p[2];
        transition p[1] <= y {
            true -> space(p, y)
            _ -> (0u64)
        }
    }
    state space(p: &mut [u64; 128], y: u64) -> u64 requires p[1] <= y {
        transition p[3] < y - p[1] && p[1] * 2u64 < p[4] {
            true -> commit(p, y)
            _ -> (0u64)
        }
    }
    state commit(p: &mut [u64; 128], y: u64) -> u64 requires p[1] <= y && p[3] < y - p[1] {
        let w: u64 = p[4] - p[1] * 2u64;
        let h: u64 = y - p[1] - p[3];
        p[16] = p[1];
        p[17] = y;
        p[18] = w;
        p[19] = p[2];
        p[20] = p[1];
        p[21] = p[1];
        p[22] = w;
        p[23] = h;
        1u64
    }
}
