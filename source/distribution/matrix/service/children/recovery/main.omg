module children::recovery::main;

// One automatic retry, then owner-supplied fallback. Explicit retries never
// replenish the automatic allowance. Tickets correlate work; they grant no access.
public data Phase [copy] {
    case Disabled;
    case AutomaticAvailable;
    case AutomaticSpent;
    case ReadPending;
    case StartingRead;
    case Reading;
    case ReadReady;
    case Admitting;
    case NeedFallback;
    case Fallback;
    case RetryRequested;
}

public data Recovery {
    phase: Phase;
    ticket: u64;
}

public data Command [copy] {
    case Wait;
    case Cancel;
    case RetireFallback;
    case Read;
    case Admit(ticket: u64);
    case ShowFallback;
}

public machine configure(recovery: &mut Recovery) -> bool {
    transition recovery.phase {
        Phase::Disabled -> arm(recovery)
        _ -> (false)
    }
    machine arm(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::AutomaticAvailable;
        true
    }
}

public machine retired(recovery: &mut Recovery, failed: bool) -> bool {
    transition failed {
        true -> after_failure(recovery)
        _ -> discard(recovery)
    }
    machine after_failure(recovery: &mut Recovery) -> bool {
        transition recovery.phase {
            Phase::AutomaticAvailable -> retry(recovery)
            Phase::AutomaticSpent -> fallback(recovery)
            _ -> discard(recovery)
        }
    }
    machine retry(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::ReadPending;
        true
    }
    machine fallback(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::NeedFallback;
        true
    }
}

public machine ready(recovery: &Recovery, blocked: bool) -> bool {
    pending(recovery.phase) && !blocked
}

// Validate the captured authority before selecting work. An explicit retry may
// retire its own fallback; other recovery work requires an empty launcher slot.
public machine next_work(recovery: &mut Recovery, authority_matches: bool, vacant: bool) -> Command {
    transition pending(recovery.phase) {
        true -> authority(recovery, authority_matches, vacant)
        _ -> (Command::Wait)
    }
    machine authority(recovery: &mut Recovery, matches: bool, vacant: bool) -> Command {
        transition matches {
            true -> selected(recovery, vacant)
            _ -> cancel(recovery)
        }
    }
    machine selected(recovery: &mut Recovery, vacant: bool) -> Command {
        transition recovery.phase {
            Phase::RetryRequested -> (Command::RetireFallback)
            _ -> require_vacancy(recovery, vacant)
        }
    }
    machine require_vacancy(recovery: &mut Recovery, vacant: bool) -> Command {
        transition vacant {
            true -> advance(recovery)
            _ -> cancel(recovery)
        }
    }
    machine advance(recovery: &mut Recovery) -> Command {
        transition recovery.phase {
            Phase::NeedFallback -> (Command::ShowFallback)
            Phase::ReadPending -> start_read(recovery)
            Phase::ReadReady -> admit(recovery)
            _ -> (Command::Wait)
        }
    }
    machine start_read(recovery: &mut Recovery) -> Command {
        recovery.phase = Phase::StartingRead;
        Command::Read
    }
    machine admit(recovery: &mut Recovery) -> Command {
        recovery.phase = Phase::Admitting;
        Command::Admit { ticket: recovery.ticket }
    }
    machine cancel(recovery: &mut Recovery) -> Command {
        let discarded: bool = discard(recovery);
        Command::Cancel
    }
}

public machine read_started(recovery: &mut Recovery, ticket: u64) -> bool {
    transition (recovery.phase in Phase::StartingRead) && ticket != 0u64 {
        true -> remember(recovery, ticket)
        _ -> (false)
    }
    machine remember(recovery: &mut Recovery, ticket: u64) -> bool {
        recovery.ticket = ticket;
        recovery.phase = Phase::Reading;
        true
    }
}

public machine read_unavailable(recovery: &mut Recovery) -> bool {
    transition recovery.phase {
        Phase::StartingRead -> fallback(recovery)
        _ -> (false)
    }
    machine fallback(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::NeedFallback;
        true
    }
}

public machine read_completed(recovery: &mut Recovery, ticket: u64, success: bool) -> bool {
    transition (recovery.phase in Phase::Reading) && ticket != 0u64 && recovery.ticket == ticket {
        true -> completed(recovery, success)
        _ -> (false)
    }
    machine completed(recovery: &mut Recovery, success: bool) -> bool {
        transition success {
            true -> retain_image(recovery)
            _ -> fallback(recovery)
        }
    }
    machine retain_image(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::ReadReady;
        true
    }
    machine fallback(recovery: &mut Recovery) -> bool {
        recovery.ticket = 0u64;
        recovery.phase = Phase::NeedFallback;
        true
    }
}

public machine admission_finished(recovery: &mut Recovery, ticket: u64, success: bool) -> bool {
    transition (recovery.phase in Phase::Admitting) && ticket != 0u64 && recovery.ticket == ticket {
        true -> completed(recovery, success)
        _ -> (false)
    }
    machine completed(recovery: &mut Recovery, success: bool) -> bool {
        recovery.ticket = 0u64;
        transition success {
            true -> running(recovery)
            _ -> fallback(recovery)
        }
    }
    machine running(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::AutomaticSpent;
        true
    }
    machine fallback(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::NeedFallback;
        true
    }
}

public machine fallback_finished(recovery: &mut Recovery, success: bool) -> bool {
    transition recovery.phase {
        Phase::NeedFallback -> completed(recovery, success)
        _ -> (false)
    }
    machine completed(recovery: &mut Recovery, success: bool) -> bool {
        transition success {
            true -> running(recovery)
            _ -> discard(recovery)
        }
    }
    machine running(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::Fallback;
        true
    }
}

public machine request_retry(recovery: &mut Recovery, authenticated: bool) -> bool {
    transition (recovery.phase in Phase::Fallback) && authenticated {
        true -> request(recovery)
        _ -> (false)
    }
    machine request(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::RetryRequested;
        true
    }
}

public machine fallback_changed(recovery: &mut Recovery, initial_supply: bool) -> bool {
    transition initial_supply && ((recovery.phase in Phase::AutomaticAvailable)
        || (recovery.phase in Phase::AutomaticSpent)) {
        true -> (true)
        _ -> discard(recovery)
    }
}

public machine fallback_retired(recovery: &mut Recovery) -> bool {
    transition recovery.phase {
        Phase::RetryRequested -> retry(recovery)
        _ -> (false)
    }
    machine retry(recovery: &mut Recovery) -> bool {
        recovery.phase = Phase::ReadPending;
        true
    }
}

machine pending(phase: Phase) -> bool {
    transition phase {
        Phase::ReadPending -> (true)
        Phase::StartingRead -> (true)
        Phase::Reading -> (true)
        Phase::ReadReady -> (true)
        Phase::Admitting -> (true)
        Phase::NeedFallback -> (true)
        Phase::RetryRequested -> (true)
        _ -> (false)
    }
}

machine discard(recovery: &mut Recovery) -> bool {
    recovery.phase = Phase::Disabled;
    recovery.ticket = 0u64;
    false
}
