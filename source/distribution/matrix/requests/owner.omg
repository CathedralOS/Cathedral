// Owner-only routing and post-success consequences. Child packets cannot reach this path.
use operations;
use desktop;
use protocol::main;
use protocol::matrix;
public machine owner_request(p: &mut [u64; 128]) -> u64 {
    transition p[16] == RESOLVE_PATH && p[21] == 0u64 && p[22] == 0u64 && p[23] == 0u64 { true -> (DO_RESOLVE) _ -> pixel(p) }
    state pixel(p: &mut [u64; 128]) -> u64 {
        transition p[16] == READ_PIXEL && p[19] == 0u64 && p[20] == 0u64 && p[21] == 0u64 && p[22] == 0u64 && p[23] == 0u64 { true -> (DO_PIXEL) _ -> (DO_OWNER) }
    }
}
public machine owner_fallback(p: &mut [u64; 128]) -> u64 {
    transition p[2] == OWNER && p[3] != 0u64 { true -> operation(p) _ -> (DO_DENY) }
    state operation(p: &mut [u64; 128]) -> u64 {
        transition p[16] {
            SAVE_RECOVERY_GRANT -> (DO_RECOVERY_OWNER) SAVE_RECOVERY_POLL -> (DO_RECOVERY_OWNER)
            STORAGE_GRANT -> (DO_STORAGE_OWNER) STORAGE_REVOKE -> (DO_STORAGE_OWNER)
            STORAGE_STATUS -> (DO_STORAGE_OWNER) STORAGE_BINDING -> (DO_STORAGE_OWNER)
            _ -> (DO_LAYOUT_OWNER)
        }
    }
}
public machine owner_effects(p: &mut [u64; 128]) -> u64 {
    transition p[2] == OWNER && p[3] != 0u64 && p[7] != 0u64 { true -> operation(p) _ -> (0u64) }
    state operation(p: &mut [u64; 128]) -> u64 {
        transition p[16] {
            STORAGE_GRANT -> (CHANGED | REMEMBER_STORAGE) STORAGE_REVOKE -> (CHANGED | REMEMBER_STORAGE)
            STORAGE_STATUS -> (CHANGED | REMEMBER_STORAGE) STORAGE_BINDING -> (CHANGED | REMEMBER_STORAGE)
            BIND -> (CHANGED | CLEAR_PAIR | REPLAY_ALL) PLACE -> (CHANGED | REPLAY_SLOT)
            REVOKE -> revoke(p) _ -> (CHANGED)
        }
    }
    state revoke(p: &mut [u64; 128]) -> u64 {
        transition p[17] < p[6] && p[18] == 0u64 && p[19] == 0u64 && p[20] == 0u64 && p[21] == 0u64 && p[22] == 0u64 && p[23] == 0u64 { true -> (CHANGED | CLEAR_SLOT | REPLAY_SLOT) _ -> (CHANGED | REPLAY_SLOT) }
    }
}
