machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_matrix_policy");
    Build::depend_as(builder, "configuration", Source::Path { location: "../configuration" });
    Build::depend_as(builder, "lifecycle", Source::Path { location: "../lifecycle" });
    Build::depend_as(builder, "recovery", Source::Path { location: "../recovery" });
    Build::depend_as(builder, "startup", Source::Path { location: "../startup" });
    Build::depend_as(builder, "launch", Source::Path { location: "../launch" });
    Build::depend_as(builder, "workspace", Source::Path { location: "../workspace" });
    Build::depend_as(builder, "session", Source::Path { location: "../session" });
    Build::depend_as(builder, "requests", Source::Path { location: "../requests" });
    Build::depend_as(builder, "realm", Source::Path { location: "../realm" });
    Build::select_provider<Policy, PolicyProvider>(builder);
    Build::bind(builder, linux_x86_64::ProgramEntry, policy_entry);
}
