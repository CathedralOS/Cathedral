// Transitional callers: startup, owner grants, listing and launch binding wait.
// They drive the same retained exchange as child relays, never a second receiver.
// Drain accepted relays and scoped internal reads without admitting more, avoiding BUSY failures or
// deadlock when a launch shares a source with an app's outstanding file request.
use {shared}/state.omg as shared_state;
use {shared}/storage.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use {runtime}/waiting.omg;
use storage/exchange.omg;
use storage/children.omg;
use storage/reads.omg;

public machine request(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, source: u64, words: [u64; 8], object: u64) -> |storage|::Outcome
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block begin(gate, context, source, words, object, false)
}
public machine inform(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let words: [u64; 8];
    let outcome: |storage|::Outcome = block begin(gate, context, 0u64, words, 0u64, true);
    block |exchange|::release(gate, outcome.attachment);
    outcome.words[0]
}
machine begin(gate: &|kernel|::Gate, context: &mut |shared_state|::State, source: u64, words: [u64; 8], object: u64, info: bool) -> |storage|::Outcome reaches |kernel|::Kernel {
    let index: u64 = |exchange|::link_of(context, source);
    transition index <= 2u64 && source < 2u64 {
        true -> block drained(gate, context, source, index, words, object, info)
        _ -> (|exchange|::failed(|kernel|::DENIED))
    }
    machine drained(gate: &|kernel|::Gate, context: &mut |shared_state|::State, source: u64, index: u64 [0..=2], words: [u64; 8], object: u64, info: bool) -> |storage|::Outcome reaches |kernel|::Kernel {
        block drain(gate, context, index);
        let tick: |time|::Tick = |time|::read(gate, context.clock);
        transition tick {
            |time|::Tick::Read { value } -> block started(gate, context, source, index, words, object, info, value)
            |time|::Tick::Failed { code } -> (|exchange|::failed(code))
        }
    }
    machine started(gate: &|kernel|::Gate, context: &mut |shared_state|::State, source: u64, index: u64 [0..=2], words: [u64; 8], object: u64, info: bool, now: u64) -> |storage|::Outcome reaches |kernel|::Kernel {
        let status: u64 = block |exchange|::start(gate, context, now, source, words, object, |exchange|::LOCAL, 0u64, 0u64, info);
        transition status == 0u64 { true -> block await(gate, context, index) _ -> (|exchange|::failed(status)) }
    }
}
public machine drain(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition index <= 2u64 { true -> block bounded_drain(gate, context, index) _ -> done() }
}
machine bounded_drain(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2]) reaches |kernel|::Kernel {
    transition |exchange|::idle(context, index) {
        true -> done()
        _ -> block draining(gate, context, index)
    }
    machine draining(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2]) reaches |kernel|::Kernel {
        let tick: |time|::Tick = |time|::read(gate, context.clock);
        transition tick {
            |time|::Tick::Read { value } -> block progress(gate, context, index, value)
            |time|::Tick::Failed { code } -> done()
        }
    }
    machine progress(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2], now: u64) reaches |kernel|::Kernel {
        block |children|::advance(gate, context, now);
        block |reads|::step(gate, context, now);
        transition |exchange|::idle(context, index) {
            true -> done()
            _ -> block parked(gate, context, index, now)
        }
    }
    machine parked(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2], now: u64) reaches |kernel|::Kernel {
        block pause(gate, context, now);
        transition { _ -> block drain(gate, context, index) }
    }
}
machine await(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2]) -> |storage|::Outcome reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block progress(gate, context, index, value)
        |time|::Tick::Failed { code } -> block |exchange|::abort(gate, context, index, code)
    }
    machine progress(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2], now: u64) -> |storage|::Outcome reaches |kernel|::Kernel {
        block |children|::advance(gate, context, now);
        block |reads|::step(gate, context, now);
        transition |exchange|::ready(context, index, |exchange|::LOCAL) {
            true -> (|exchange|::take(context, index))
            _ -> block parked(gate, context, index, now)
        }
    }
    machine parked(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2], now: u64) -> |storage|::Outcome reaches |kernel|::Kernel {
        block pause(gate, context, now);
        block await(gate, context, index)
    }
}
machine pause(gate: &|kernel|::Gate, context: &|shared_state|::State, now: u64) reaches |kernel|::Kernel {
    let mut set: |waiting|::Set; |children|::waiting::reset(&mut set, |time|::after(now, 1u64));
    |exchange|::watch(context, &mut set, 0u64); |exchange|::watch(context, &mut set, 1u64); |exchange|::watch(context, &mut set, 2u64);
    let ignored: u64 = block |children|::waiting::wait(gate, &set);
}
machine done() {}
