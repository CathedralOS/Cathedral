use {runtime}/time.omg;
// Scoped internal reads share the exchange receiver with child relays. Taking
// the transport result into this record frees the link without running admission
// inside another caller's synchronous drain. No input attachment is borrowed.
use {shared}/state.omg as shared_state;
use {shared}/storage.omg;
use {runtime}/kernel.omg;
use {runtime}/waiting.omg;
use {protocol}/main.omg;
use {protocol}/matrix.omg;
use {protocol}/storage/operations.omg;
use {protocol}/storage/scope.omg;
use storage/exchange.omg;

public machine begin(context: &mut |shared_state|::State, now: u64, requester: u64 [0..=4], object: u64, stamp: u64) -> u64 {
    transition context.store.read.phase == 0u64 {
        true -> scoped(context, now, requester, object, stamp)
        _ -> (|kernel|::BUSY)
    }
    machine scoped(context: &mut |shared_state|::State, now: u64, requester: u64 [0..=4], object: u64, stamp: u64) -> u64 {
        let mut work: |storage|::Read;
        work.words[0] = ((|matrix|::STORAGE_BASE as u64 in Wrapping) + (|operations|::BULK as u64 in Wrapping)) as u64;
        work.words[1] = object;
        work.words[7] = |scope|::deadline(now, 0u64, |matrix|::STORAGE_DEADLINE_TICKS);
        let fits: bool = |scope|::stamp(&mut work.words, stamp);
        transition fits && work.words[7] != 0u64 {
            true -> queued(context, requester, work)
            _ -> (|kernel|::DENIED)
        }
    }
    machine queued(context: &mut |shared_state|::State, requester: u64 [0..=4], work: |storage|::Read) -> u64 {
        let mut pending: |storage|::Read = work;
        pending.phase = 1u64; pending.requester = requester;
        pending.incarnation = context.store.listeners[requester].incarnation;
        pending.revision = context.store.scopes.revisions[requester];
        context.store.read = pending;
        0u64
    }
}
public machine ready(context: &|shared_state|::State) -> bool { context.store.read.phase == 3u64 }
public machine take(context: &mut |shared_state|::State) -> |storage|::Outcome {
    let answer: |storage|::Outcome = context.store.read.answer;
    let empty: |storage|::Read; context.store.read = empty;
    answer
}
public machine step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let index: u64 = |exchange|::link_of(context, 0u64);
    transition context.store.read.phase != 0u64 && index <= 2u64 {
        true -> block progress(gate, context, now, index)
        _ -> done()
    }
    machine progress(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, index: u64 [0..=2]) reaches |kernel|::Kernel {
        let owner: u64 = |exchange|::READ + context.store.read.requester;
        transition {
            context.store.read.phase == 3u64 -> done()
            context.store.read.phase == 2u64 && |exchange|::ready(context, index, owner) -> completed(context, index)
            context.store.read.phase == 2u64 -> done()
            context.store.read.cancelled -> refused(context, |kernel|::DENIED)
            |time|::reached(now, context.store.read.words[7]) -> refused(context, |kernel|::TIMED_OUT)
            |exchange|::idle(context, index) -> block started(gate, context, now, owner)
            _ -> done()
        }
    }
    machine started(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, owner: u64) reaches |kernel|::Kernel {
        let words: [u64; 8] = context.store.read.words;
        let incarnation: u64 = context.store.read.incarnation;
        let revision: u64 = context.store.read.revision;
        let status: u64 = block |exchange|::refreshed(gate, context, now, 0u64, words, owner, incarnation, revision);
        transition status == 0u64 { true -> waiting(context) _ -> refused(context, status) }
    }
    machine waiting(context: &mut |shared_state|::State) { context.store.read.phase = 2u64; }
    machine completed(context: &mut |shared_state|::State, index: u64 [0..=2]) {
        let answer: |storage|::Outcome = |exchange|::take(context, index);
        context.store.read.answer = answer;
        context.store.read.phase = 3u64;
    }
    machine refused(context: &mut |shared_state|::State, code: u64) {
        context.store.read.answer = |exchange|::failed(code); context.store.read.phase = 3u64;
    }
}
public machine cancel(context: &mut |shared_state|::State) {
    context.store.read.cancelled = true;
    let index: u64 = |exchange|::link_of(context, 0u64);
    let owner: u64 = |exchange|::READ + context.store.read.requester;
    transition context.store.read.phase == 2u64 && index <= 2u64 {
        true -> |exchange|::cancel(context, index, owner)
        _ -> done()
    }
}
public machine watch(context: &|shared_state|::State, set: &mut |waiting|::Set) {
    let index: u64 = |exchange|::link_of(context, 0u64);
    transition context.store.read.phase != 0u64 && index <= 2u64 {
        true -> watched(context, set, index)
        _ -> done()
    }
    machine watched(context: &|shared_state|::State, set: &mut |waiting|::Set, index: u64 [0..=2]) {
        let owner: u64 = |exchange|::READ + context.store.read.requester;
        transition {
            |exchange|::ready(context, index, owner) -> |waiting|::expire_by(set, 0u64)
            context.store.read.phase == 1u64 && (|exchange|::idle(context, index) || context.store.read.cancelled) -> |waiting|::expire_by(set, 0u64)
            context.store.read.phase == 1u64 -> |waiting|::expire_by(set, context.store.read.words[7])
            _ -> done()
        }
    }
}
public machine close(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block |exchange|::release(gate, context.store.read.answer.attachment);
    let empty: |storage|::Read; context.store.read = empty;
}
machine done() {}
