// Storage authority and lifecycle. Child requests resume in children; exchange
// is the sole receiver per source; reads retains scoped internal results until
// their launch continuation takes them. Blocking owner/startup operations temporarily
// use synchronous, which drives that same exchange rather than reading around it.
use {protocol}/main.omg;
use {protocol}/matrix.omg;
use {protocol}/storage/scope.omg;
use {protocol}/storage/operations.omg;
use {shared}/state.omg as shared_state;
use {shared}/storage.omg;
use {shared}/report.omg;
use {runtime}/kernel.omg;
use {runtime}/link.omg;
use {runtime}/time.omg;
use {runtime}/connection/main.omg as connection_main;
use {runtime}/server/main.omg as server_main;
use {runtime}/waiting.omg;
use {world}/scopes.omg;
use {world}/geometry.omg;
use storage/children.omg;
use storage/exchange.omg;
use storage/binding.omg;
use storage/synchronous.omg;
use storage/reads.omg;

public const SOURCES: u64 = 2u64;
// The link that carries the parent's storage connection; under a parent the
// children's one source, source zero, travels over it.
public const UPSTREAM: u64 = 2u64;
// A child may acquire storage long after admission; its listener's handshake
// window is the child's lifetime.
public const OPENING_TICKS: u64 = 0x3fffffffffffffffu64;
// Supplied provider links make this instance the storage root; nothing else does.
public machine discover(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel invokes |kernel|::Kernel {
    let first: u64 = |link|::at(gate, 0u64);
    let second: u64 = |link|::at(gate, 1u64);
    transition first < |kernel|::ERROR_BASE && second < |kernel|::ERROR_BASE {
        true -> rooted(context, first, second)
        _ -> done()
    }
    machine rooted(context: &mut |shared_state|::State, first: u64, second: u64) {
        context.store.root = true;
        context.store.handles[0] = first;
        context.store.handles[1] = second;
    }
}
// The parent's storage connection, acquired from its broker at startup.
public machine connect_upstream(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, sender: u64, receiver: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block |connection_main|::connect(gate, &mut context.store.links[2], sender, receiver,
        |time|::after(now, 300u64));
    transition status == 0u64 {
        true -> connected(gate, context)
        _ -> (status)
    }
    machine connected(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> u64 reaches |kernel|::Kernel {
        context.store.linked[2] = true;
        context.store.has_upstream = true;
        |report|::parent_storage_ready(gate);
        0u64
    }
}

public machine owner_word(op: u64) -> bool {
    op == |matrix|::STORAGE_GRANT || op == |matrix|::STORAGE_REVOKE || op == |matrix|::STORAGE_STATUS || op == |matrix|::STORAGE_BINDING
}
public machine owner(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let reply: [u64; 8] = block decide(gate, context, now, frame);
    block |server_main|::reply(gate, &mut context.owner, &reply)
}
// Only the root reports failed sources; a nested matrix's one source is its parent.
machine decide(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, frame: |connection_main|::Frame) -> [u64; 8] reaches |kernel|::Kernel {
    let status: bool = frame.payload[0] == |matrix|::STORAGE_STATUS && |geometry|::zeros_from(&frame.payload, 1u64);
    transition {
        status && context.store.root -> (report_status(context))
        status -> (error(|kernel|::DENIED))
        frame.payload[1] < 5u64 -> block slotted(gate, context, now, frame, frame.payload[1])
        _ -> (error(|kernel|::DENIED))
    }
    machine slotted(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, frame: |connection_main|::Frame, slot: u64 [0..=4]) -> [u64; 8] reaches |kernel|::Kernel {
        transition {
            frame.payload[0] == |matrix|::STORAGE_BINDING && |geometry|::zeros_from(&frame.payload, 2u64) -> (bound_reply(context, slot))
            frame.payload[0] == |matrix|::STORAGE_GRANT && |geometry|::zeros_from(&frame.payload, 4u64) ->
                block granting(gate, context, now, slot, frame.payload[2], frame.payload[3])
            frame.payload[0] == |matrix|::STORAGE_REVOKE && |geometry|::zeros_from(&frame.payload, 2u64) -> (revoking(context, slot))
            _ -> (error(|kernel|::DENIED))
        }
    }
}
machine report_status(context: &|shared_state|::State) -> [u64; 8] {
    let mut words: [u64; 8];
    words[1] = context.store.failed;
    words
}
machine bound_reply(context: &|shared_state|::State, slot: u64 [0..=4]) -> [u64; 8] {
    let bound: |scopes|::Bound = |scopes|::binding(&context.store.scopes, slot, context.store.listeners[slot].incarnation);
    transition bound.status == 0u64 {
        true -> (binding_words(bound))
        _ -> (error(|kernel|::DENIED))
    }
}
machine binding_words(bound: |scopes|::Bound) -> [u64; 8] {
    let mut words: [u64; 8];
    words[1] = bound.source;
    words[2] = bound.scope;
    words
}
machine granting(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], source: u64, subtree: u64) -> [u64; 8] reaches |kernel|::Kernel {
    let status: u64 = block bind(gate, context, now, slot, source, subtree);
    error(status)
}
// Bind a child's live storage connection to a source and scope. The binding
// also re-establishes the source's link, so one made after provider
// replacement connects to the fresh incarnation; under a parent it learns
// this matrix's own binding again.
public machine bind(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], source: u64, subtree: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let available: u64 = available(context);
    transition source < available && source < 2u64 {
        true -> block refreshing(gate, context, now, slot, source, subtree, available)
        _ -> (|kernel|::DENIED)
    }
    machine refreshing(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], source: u64 [0..=1], subtree: u64, available: u64) -> u64
        reaches |kernel|::Kernel {
        let index: u64 = |exchange|::link_of(context, source);
        block |synchronous|::drain(gate, context, index);
        let status: u64 = block refresh(gate, context, now, source);
        transition status == 0u64 {
            true -> (installing(context, slot, source, subtree, available))
            _ -> (status)
        }
    }
    machine installing(context: &mut |shared_state|::State, slot: u64 [0..=4], source: u64 [0..=1], subtree: u64, available: u64) -> u64 {
        let incarnation: u64 = context.store.listeners[slot].incarnation;
        let status: u64 = |scopes|::grant(&mut context.store.scopes, slot, incarnation, source, subtree, available);
        transition status == 0u64 {
            true -> healthy(context, source)
            _ -> (status)
        }
    }
    machine healthy(context: &mut |shared_state|::State, source: u64 [0..=1]) -> u64 {
        context.store.failed = context.store.failed & ~(1u64 << source);
        0u64
    }
}
// The matrix's own read of a whole object over its first source: the sealed
// program behind a launch. `stamp` narrows a child's launch to its realm.
public machine read_object(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, object: u64, stamp: u64) -> |storage|::Outcome
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut words: [u64; 8];
    words[0] = ((|matrix|::STORAGE_BASE as u64 in Wrapping) + (|operations|::BULK as u64 in Wrapping)) as u64;
    words[1] = object;
    let fits: bool = |scope|::stamp(&mut words, stamp);
    transition fits && (context.store.root || context.store.has_upstream) {
        true -> block |synchronous|::request(gate, context, now, 0u64, words, 0u64)
        _ -> (failed(|kernel|::DENIED))
    }
}
// One request of this matrix's own over its first source with no scope of its
// own: a listing of its realm.
public machine request(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, words: [u64; 8]) -> |storage|::Outcome
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let request: [u64; 8] = words;
    transition context.store.root || context.store.has_upstream {
        true -> block |synchronous|::request(gate, context, now, 0u64, request, 0u64)
        _ -> (failed(|kernel|::DENIED))
    }
}
// This matrix's own binding: the store's root at the storage root, or the
// parent's report, learnt now if it has not been.
public machine learn(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition {
        context.store.root -> (0u64)
        context.store.informed -> (0u64)
        context.store.has_upstream -> block |synchronous|::inform(gate, context, now)
        _ -> (|kernel|::PEER_CLOSED)
    }
}
// The sources children may be bound to: both provider links at the root, the
// parent's one connection beneath it.
machine available(context: &|shared_state|::State) -> u64 {
    transition {
        context.store.root -> (SOURCES)
        context.store.has_upstream -> (1u64)
        _ -> (0u64)
    }
}
// Revocation is local: the stale scope simply stops authorizing.
machine revoking(context: &mut |shared_state|::State, slot: u64 [0..=4]) -> [u64; 8] {
    let ignored: u64 = |scopes|::revoke(&mut context.store.scopes, slot);
    ok()
}
// Make the source current: connect or reconnect its link at the root, or
// learn this matrix's binding from the parent.
machine refresh(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, source: u64 [0..=1]) -> u64 reaches |kernel|::Kernel {
    transition context.store.root {
        true -> block |scopes|::binding::relink(gate, context, now, source)
        _ -> block |synchronous|::inform(gate, context, now)
    }
}
// Serve an admitted child's storage connection from the pair admission
// retained. A slot's previous listener was closed; a fresh one keeps only
// the incarnation count, so no old binding or ticket can match the new child.
public machine listen(context: &mut |shared_state|::State, slot: u64 [0..=4], now: u64) -> u64 {
    let sender: u64 = context.slots[slot].storage.sender;
    let receiver: u64 = context.slots[slot].storage.receiver;
    context.slots[slot].storage.sender = 0u64;
    context.slots[slot].storage.receiver = 0u64;
    let incarnation: u64 = context.store.listeners[slot].incarnation;
    let fresh: |server_main|::Server;
    context.store.listeners[slot] = fresh;
    context.store.listeners[slot].incarnation = incarnation;
    |server_main|::begin(&mut context.store.listeners[slot], sender, receiver, |time|::after(now, OPENING_TICKS), true)
}
// The child is gone: drop its listener and binding.
public machine retire(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4]) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block |children|::cancel(gate, context, slot);
    block |server_main|::close(gate, &mut context.store.listeners[slot]);
    let ignored: u64 = |scopes|::revoke(&mut context.store.scopes, slot);
}
public machine step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block current(gate, context, value)
        |time|::Tick::Failed { code } -> (code)
    }
    machine current(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel {
        // Receive only into free child slots, then resume the accepted queue.
        // An arrival cannot grab a link just freed behind an older waiter.
        block |children|::receive(gate, context, now);
        block |children|::advance(gate, context, now);
        block |reads|::step(gate, context, now);
        0u64
    }
}
public machine watch(context: &|shared_state|::State, set: &mut |waiting|::Set) {
    |children|::watch(context, set);
    |reads|::watch(context, set);
    |exchange|::watch(context, set, 0u64);
    |exchange|::watch(context, set, 1u64);
    |exchange|::watch(context, set, 2u64);
}
public machine close(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block |children|::close(gate, context);
    block |reads|::close(gate, context);
    block |exchange|::close(gate, context, 0u64);
    block |exchange|::close(gate, context, 1u64);
    block |exchange|::close(gate, context, 2u64);
    block |server_main|::close(gate, &mut context.store.listeners[0]);
    block |server_main|::close(gate, &mut context.store.listeners[1]);
    block |server_main|::close(gate, &mut context.store.listeners[2]);
    block |server_main|::close(gate, &mut context.store.listeners[3]);
    block |server_main|::close(gate, &mut context.store.listeners[4]);
    let first: u64 = block |connection_main|::close(gate, &mut context.store.links[0]);
    let second: u64 = block |connection_main|::close(gate, &mut context.store.links[1]);
    let parent: u64 = block |connection_main|::close(gate, &mut context.store.links[2]);
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
machine ok() -> [u64; 8] {
    let words: [u64; 8];
    words
}
machine done() {}

machine failed(code: u64) -> |storage|::Outcome { |storage|::Outcome { words: error(code), attachment: 0u64 } }
