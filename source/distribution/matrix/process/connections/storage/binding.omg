use {runtime}/time.omg;
// Discovery, binding revisions and source retirement; transport progress is in exchange.
use {protocol}/storage/scope.omg;
use {shared}/state.omg as shared_state;
use {shared}/storage.omg;
use {shared}/report.omg;
use {runtime}/kernel.omg;
use {runtime}/ipc/main.omg;
use {runtime}/link.omg;
use {runtime}/connection/main.omg as connection_main;
use {world}/scopes.omg;
use storage/storage.omg as storage_storage;
public machine relink(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, source: u64 [0..=1]) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let opened: |main|::Opened = |link|::connect(gate, context.store.handles[source]);
    transition opened {
        |main|::Opened::Ready { channel } -> block adopting(gate, context, now, source, channel.sender, channel.receiver)
        |main|::Opened::Failed { code } -> (unchanged(context, source, code))
    }
    machine unchanged(context: &|shared_state|::State, source: u64 [0..=1], code: u64) -> u64 {
        transition code == |kernel|::BUSY && context.store.linked[source] {
            true -> (0u64)
            _ -> (code)
        }
    }
    machine adopting(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, source: u64 [0..=1], sender: u64, receiver: u64) -> u64 reaches |kernel|::Kernel {
        // The provider supplied a new channel. Old grants cannot survive even
        // if that channel's handshake fails before it becomes usable.
        |scopes|::revoke_source(&mut context.store.scopes, source);
        let closed: u64 = block |connection_main|::close(gate, &mut context.store.links[source]);
        let fresh: |connection_main|::Peer;
        context.store.links[source] = fresh;
        context.store.linked[source] = false;
        let status: u64 = block |connection_main|::connect(gate, &mut context.store.links[source], sender, receiver,
            |time|::after(now, 300u64));
        transition status == 0u64 {
            true -> adopted(gate, context, source)
            _ -> block refused(gate, context, source, status)
        }
    }
    machine refused(gate: &|kernel|::Gate, context: &mut |shared_state|::State, source: u64 [0..=1], code: u64) -> u64 reaches |kernel|::Kernel {
        let outcome: |storage|::Outcome = block retired(gate, context, source, code);
        code
    }
    machine adopted(gate: &|kernel|::Gate, context: &mut |shared_state|::State, source: u64 [0..=1]) -> u64 reaches |kernel|::Kernel {
        context.store.linked[source] = true;
        |report|::storage_ready(gate);
        0u64
    }
}
public machine client(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, index: u64 [0..=2]) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition {
        context.store.linked[index] -> (0u64)
        index == 0u64 -> block relink(gate, context, now, 0u64)
        index == 1u64 -> block relink(gate, context, now, 1u64)
        _ -> (|kernel|::PEER_CLOSED)
    }
}
public machine retired(gate: &|kernel|::Gate, context: &mut |shared_state|::State, index: u64 [0..=2], code: u64) -> |storage|::Outcome reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    |report|::storage_lost(gate, index, code);
    let closed: u64 = block |connection_main|::close(gate, &mut context.store.links[index]);
    context.store.linked[index] = false;
    transition index == |storage_storage|::UPSTREAM {
        true -> (parent_lost(context, code))
        _ -> (source_lost(context, index, code))
    }
    machine source_lost(context: &mut |shared_state|::State, index: u64 [0..=2], code: u64) -> |storage|::Outcome {
        context.store.failed = context.store.failed | (1u64 << index);
        |scopes|::revoke_source(&mut context.store.scopes, index);
        failed(code)
    }
    machine parent_lost(context: &mut |shared_state|::State, code: u64) -> |storage|::Outcome {
        context.store.failed = context.store.failed | 1u64;
        context.store.informed = false;
        context.store.revision = 0u64;
        context.store.realm = 0u64;
        |scopes|::revoke_source(&mut context.store.scopes, 0u64);
        failed(code)
    }
}

public machine accept(context: &mut |shared_state|::State, words: [u64; 8]) -> u64 {
    let revision: u64 = words[1];
    transition words[0] == 0u64 && revision != 0u64 && revision <= |scope|::MAX_REVISION {
        true -> learned(context, revision, words[2])
        _ -> unbound(context, words[0])
    }
    machine learned(context: &mut |shared_state|::State, revision: u64, realm: u64) -> u64 {
        transition revision == context.store.revision {
            true -> kept(context, realm)
            _ -> replaced(context, revision, realm)
        }
    }
    machine replaced(context: &mut |shared_state|::State, revision: u64, realm: u64) -> u64 {
        |scopes|::clear(&mut context.store.scopes);
        context.store.revision = revision;
        kept(context, realm)
    }
    machine kept(context: &mut |shared_state|::State, realm: u64) -> u64 {
        context.store.realm = realm;
        context.store.informed = true;
        context.store.failed = context.store.failed & ~1u64;
        0u64
    }
    machine unbound(context: &mut |shared_state|::State, status: u64) -> u64 {
        |scopes|::clear(&mut context.store.scopes);
        context.store.revision = 0u64;
        context.store.realm = 0u64;
        context.store.informed = false;
        transition status == 0u64 { true -> (|kernel|::DENIED) _ -> (status) }
    }
}
machine failed(code: u64) -> |storage|::Outcome { let mut words: [u64; 8]; words[0] = code; |storage|::Outcome { words: words, attachment: 0u64 } }

// An executable was read through this refreshed source. Capture its identity
// before retiring a login picker. Installing its child's grant does no IPC;
// replacement or retirement of the source cannot inherit this preparation.
public machine prepare(context: &|shared_state|::State) -> |storage|::Prepared {
    transition context.store.root { true -> captured(context, 0u64) _ -> captured(context, |storage_storage|::UPSTREAM) }
    machine captured(context: &|shared_state|::State, index: u64 [0..=2]) -> |storage|::Prepared {
        let mut grant: |storage|::Prepared;
        grant.status = |kernel|::DENIED;
        grant.index = index; grant.receiver = context.store.links[index].receiver;
        grant.revision = context.store.revision; grant.realm = context.store.realm; grant.root = context.store.root;
        transition context.store.linked[index] && context.store.links[index].fault == 0u64 && grant.receiver != 0u64
            && (context.store.root || (context.store.has_upstream && context.store.informed && grant.revision != 0u64)) {
            true -> accepted(grant)
            _ -> (grant)
        }
    }
    machine accepted(grant: |storage|::Prepared) -> |storage|::Prepared { let mut ready: |storage|::Prepared = grant; ready.status = 0u64; ready }
}
public machine install(context: &mut |shared_state|::State, slot: u64 [0..=4], subtree: u64, prepared: |storage|::Prepared) -> u64 {
    let current: |storage|::Prepared = prepare(context);
    transition prepared.status == 0u64 && current.status == 0u64 && context.slots[slot].live
        && current.index == prepared.index && current.receiver == prepared.receiver
        && current.revision == prepared.revision && current.realm == prepared.realm && current.root == prepared.root {
        true -> installed(context, slot, subtree)
        _ -> (|kernel|::DENIED)
    }
    machine installed(context: &mut |shared_state|::State, slot: u64 [0..=4], subtree: u64) -> u64 {
        let available: u64 = sources(context);
        let status: u64 = |scopes|::grant(&mut context.store.scopes, slot, context.store.listeners[slot].incarnation, 0u64, subtree, available);
        transition status == 0u64 { true -> healthy(context) _ -> (status) }
    }
    machine healthy(context: &mut |shared_state|::State) -> u64 { context.store.failed = context.store.failed & ~1u64; 0u64 }
    machine sources(context: &|shared_state|::State) -> u64 { transition context.store.root { true -> (2u64) _ -> (1u64) } }
}
