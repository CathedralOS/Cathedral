module scene;
// The root's display connection: one shared client to the compositor, speaking
// six-word frames. It moves the physical cursor and carries each child's tile
// updates, sealed images and the begin/commit transaction around a batch.
use protocol::main;
use protocol::display;
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::connection::call;
use runtime::connection::call::CallReply;
use runtime::connection::main::Frame;

public machine connect(gate: &Gate, context: &mut State, sender: u64, receiver: u64, deadline: u64) -> u64
    reaches Kernel blocks; invokes Kernel; {
    let status: u64 = block runtime::connection::main::connect(gate, &mut context.scene, sender, receiver, deadline);
    context.has_scene = status == 0u64;
    status
}
// Report the physical pointer's position; the compositor draws its cursor there.
public machine pointer(gate: &Gate, context: &mut State, x: u64, y: u64) -> u64 reaches Kernel blocks; invokes Kernel; {
    let mut words: [u64; 6];
    words[0] = display::MATRIX_POINTER;
    words[1] = x;
    words[2] = y;
    block command(gate, context, words)
}
// One six-word exchange with the compositor; a lost connection stays lost.
public machine command(gate: &Gate, context: &mut State, words: [u64; 6]) -> u64 reaches Kernel blocks; invokes Kernel; {
    block command_object(gate, context, words, 0u64)
}
// The same exchange carrying a sealed image the compositor gains its own
// right to; this matrix's right stays with it.
public machine command_object(gate: &Gate, context: &mut State, words: [u64; 6], object: u64) -> u64 reaches Kernel blocks; invokes Kernel; {
    transition context.has_scene {
        true -> block sending(gate, context, words, object)
        _ -> (DENIED)
    }
    machine sending(gate: &Gate, context: &mut State, words: [u64; 6], object: u64) -> u64 reaches Kernel {
        let mut payload: [u64; 8];
        payload[0] = words[0];
        payload[1] = words[1];
        payload[2] = words[2];
        payload[3] = words[3];
        payload[4] = words[4];
        payload[5] = words[5];
        let reply: CallReply = block call::exchange_object_bytes(gate, &mut context.scene, context.clock, &payload, object, 48u64);
        transition reply {
            CallReply::Received { frame, notification } -> (status_of(frame))
            CallReply::Failed { code } -> lost(context, code)
            _ -> lost(context, kernel::IO_ERROR)
        }
    }
    machine lost(context: &mut State, code: u64) -> u64 {
        context.has_scene = false;
        code
    }
}
machine status_of(frame: Frame) -> u64 {
    transition frame.bytes == 48u64 {
        true -> (frame.payload[0])
        _ -> (IO_ERROR)
    }
}
