module scene;
// Sole receiver for the root compositor. Regular drawing resumes across turns;
// lifecycle callers still use the synchronous compatibility exchange below.
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::connection::main::Reply;
use runtime::connection::main::Frame;
use runtime::waiting;
use runtime::waiting::Set;
use runtime::time::Tick;

public machine connect(gate: &Gate, context: &mut State, sender: u64, receiver: u64, deadline: u64) -> u64
    reaches Kernel blocks invokes Kernel {
    let status: u64 = block runtime::connection::main::connect(gate, &mut context.scene, sender, receiver, deadline);
    context.has_scene = status == 0u64;
    status
}
public machine pointer(context: &mut State, x: u64, y: u64) -> u64 {
    context.display_work.pointer = true;
    context.display_work.x = x;
    context.display_work.y = y;
    0u64
}
public machine submit(gate: &Gate, context: &mut State, words: [u64; 6], object: u64) -> u64
    reaches Kernel blocks invokes Kernel {
    transition {
        !context.has_scene -> (kernel::DENIED)
        context.display_work.request != 0u64 || context.display_work.ready -> (kernel::WOULD_BLOCK)
        _ -> block sending(gate, context, words, object)
    }
    machine sending(gate: &Gate, context: &mut State, words: [u64; 6], object: u64) -> u64 reaches Kernel {
        let payload: [u64; 8] = [words[0],words[1],words[2],words[3],words[4],words[5],0u64,0u64];
        let status: u64 = block runtime::connection::main::begin_object_bytes(gate, &mut context.scene, &payload, object, 48u64);
        transition {
            status == 0u64 -> submitted(context)
            context.scene.fault == 0u64 && (status == kernel::BUSY || status == kernel::WOULD_BLOCK) -> (kernel::WOULD_BLOCK)
            _ -> block failed(gate, context, status)
        }
    }
    machine submitted(context: &mut State) -> u64 { context.display_work.request = context.scene.next_id; 0u64 }
    machine failed(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
        block close(gate, context);
        status
    }
}
public machine step(gate: &Gate, context: &mut State, now: u64) reaches Kernel blocks invokes Kernel {
    transition context.display_work.request != 0u64 {
        true -> block receiving(gate, context, now)
        _ -> done()
    }
    machine receiving(gate: &Gate, context: &mut State, now: u64) reaches Kernel {
        let reply: Reply = block runtime::connection::main::poll(gate, &mut context.scene, now);
        transition reply {
            Reply::Pending -> done()
            Reply::Complete { frame, notification } -> block received(gate, context, frame, notification)
            Reply::Object { frame, object } -> block object(gate, context, object)
            Reply::Endpoint { frame, endpoint } -> block endpoint(gate, context, endpoint)
            Reply::Failed { code } -> block failed(gate, context, code)
        }
    }
    machine received(gate: &Gate, context: &mut State, frame: Frame, notification: u64) reaches Kernel {
        transition frame.id == context.display_work.request && frame.bytes == 48u64 && notification == 0u64 {
            true -> completed(context, frame.payload[0])
            _ -> block malformed(gate, context, notification)
        }
    }
    machine malformed(gate: &Gate, context: &mut State, notification: u64) reaches Kernel {
        let ignored: u64 = Kernel::notify_drop(gate, notification);
        block failed(gate, context, kernel::IO_ERROR);
    }
    machine object(gate: &Gate, context: &mut State, object: u64) reaches Kernel {
        let ignored: u64 = block Kernel::memory_release(gate, object);
        block failed(gate, context, kernel::IO_ERROR);
    }
    machine endpoint(gate: &Gate, context: &mut State, endpoint: u64) reaches Kernel {
        let ignored: u64 = Kernel::close(gate, endpoint);
        block failed(gate, context, kernel::IO_ERROR);
    }
    machine failed(gate: &Gate, context: &mut State, status: u64) reaches Kernel {
        block close(gate, context);
        completed(context, status);
    }
}
machine completed(context: &mut State, status: u64) {
    context.display_work.request = 0u64;
    context.display_work.ready = true;
    context.display_work.status = status;
}
public machine take(context: &mut State) -> u64 { context.display_work.ready = false; context.display_work.status }
public machine close(gate: &Gate, context: &mut State) reaches Kernel blocks invokes Kernel {
    let ignored: u64 = block runtime::connection::main::close(gate, &mut context.scene);
    context.has_scene = false;
    context.display_work.request = 0u64;
}
public machine watch(context: &State, set: &mut Set) {
    transition context.display_work.request != 0u64 {
        true -> watched(context, set)
        _ -> done()
    }
    machine watched(context: &State, set: &mut Set) {
        waiting::add(set, waiting::IPC, context.scene.receiver);
        waiting::add(set, waiting::NOTIFICATION, context.scene.bell.wait);
        transition context.scene.partial { true -> waiting::expire_by(set, context.scene.partial_deadline) _ -> done() }
    }
}
public machine command(gate: &Gate, context: &mut State, words: [u64; 6]) -> u64 reaches Kernel blocks invokes Kernel {
    block command_object(gate, context, words, 0u64)
}
public machine command_object(gate: &Gate, context: &mut State, words: [u64; 6], object: u64) -> u64
    reaches Kernel blocks invokes Kernel {
    let status: u64 = block submit(gate, context, words, object);
    transition status == 0u64 { true -> block waiting(gate, context) _ -> (status) }
    machine waiting(gate: &Gate, context: &mut State) -> u64 reaches Kernel {
        let tick: Tick = runtime::time::read(gate, context.clock);
        transition tick { Tick::Read { value } -> block checked(gate, context, value) _ -> (kernel::IO_ERROR) }
    }
    machine checked(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
        block step(gate, context, now);
        transition context.display_work.ready { true -> (take(context)) _ -> block parked(gate, context, now) }
    }
    machine parked(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
        let ignored: u64 = block runtime::connection::main::wait(gate, &context.scene, runtime::time::after(now, 1u64));
        block waiting(gate, context)
    }
}
machine done() {}
