// Sole receiver for the root compositor. Regular drawing resumes across turns;
// lifecycle callers still use the synchronous compatibility exchange below.
use {shared}/state.omg as shared_state;
use {runtime}/kernel.omg;
use {runtime}/connection/main.omg;
use {runtime}/waiting.omg;
use {runtime}/time.omg;

public machine connect(gate: &|kernel|::Gate, context: &mut |shared_state|::State, sender: u64, receiver: u64, deadline: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block |main|::connect(gate, &mut context.scene, sender, receiver, deadline);
    context.has_scene = status == 0u64;
    status
}
public machine pointer(context: &mut |shared_state|::State, x: u64, y: u64) -> u64 {
    context.display_work.pointer = true;
    context.display_work.x = x;
    context.display_work.y = y;
    0u64
}
public machine submit(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 6], object: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition {
        !context.has_scene -> (|kernel|::DENIED)
        context.display_work.request != 0u64 || context.display_work.ready -> (|kernel|::WOULD_BLOCK)
        _ -> block sending(gate, context, words, object)
    }
    machine sending(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 6], object: u64) -> u64 reaches |kernel|::Kernel {
        let payload: [u64; 8] = [words[0],words[1],words[2],words[3],words[4],words[5],0u64,0u64];
        let status: u64 = block |main|::begin_object_bytes(gate, &mut context.scene, &payload, object, 48u64);
        transition {
            status == 0u64 -> submitted(context)
            context.scene.fault == 0u64 && (status == |kernel|::BUSY || status == |kernel|::WOULD_BLOCK) -> (|kernel|::WOULD_BLOCK)
            _ -> block failed(gate, context, status)
        }
    }
    machine submitted(context: &mut |shared_state|::State) -> u64 { context.display_work.request = context.scene.next_id; 0u64 }
    machine failed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) -> u64 reaches |kernel|::Kernel {
        block close(gate, context);
        status
    }
}
public machine step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.display_work.request != 0u64 {
        true -> block receiving(gate, context, now)
        _ -> done()
    }
    machine receiving(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) reaches |kernel|::Kernel {
        let reply: |main|::Reply = block |main|::poll(gate, &mut context.scene, now);
        transition reply {
            |main|::Reply::Pending -> done()
            |main|::Reply::Complete { frame, notification } -> block received(gate, context, frame, notification)
            |main|::Reply::Object { frame, object } -> block object(gate, context, object)
            |main|::Reply::Endpoint { frame, endpoint } -> block endpoint(gate, context, endpoint)
            |main|::Reply::Failed { code } -> block failed(gate, context, code)
        }
    }
    machine received(gate: &|kernel|::Gate, context: &mut |shared_state|::State, frame: |main|::Frame, notification: u64) reaches |kernel|::Kernel {
        transition frame.id == context.display_work.request && frame.bytes == 48u64 && notification == 0u64 {
            true -> completed(context, frame.payload[0])
            _ -> block malformed(gate, context, notification)
        }
    }
    machine malformed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, notification: u64) reaches |kernel|::Kernel {
        let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
        block failed(gate, context, |kernel|::IO_ERROR);
    }
    machine object(gate: &|kernel|::Gate, context: &mut |shared_state|::State, object: u64) reaches |kernel|::Kernel {
        let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
        block failed(gate, context, |kernel|::IO_ERROR);
    }
    machine endpoint(gate: &|kernel|::Gate, context: &mut |shared_state|::State, endpoint: u64) reaches |kernel|::Kernel {
        let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
        block failed(gate, context, |kernel|::IO_ERROR);
    }
    machine failed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) reaches |kernel|::Kernel {
        block close(gate, context);
        completed(context, status);
    }
}
machine completed(context: &mut |shared_state|::State, status: u64) {
    context.display_work.request = 0u64;
    context.display_work.ready = true;
    context.display_work.status = status;
}
public machine take(context: &mut |shared_state|::State) -> u64 { context.display_work.ready = false; context.display_work.status }
public machine close(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let ignored: u64 = block |main|::close(gate, &mut context.scene);
    context.has_scene = false;
    context.display_work.request = 0u64;
}
public machine watch(context: &|shared_state|::State, set: &mut |waiting|::Set) {
    transition context.display_work.request != 0u64 {
        true -> watched(context, set)
        _ -> done()
    }
    machine watched(context: &|shared_state|::State, set: &mut |waiting|::Set) {
        |waiting|::add(set, |waiting|::IPC, context.scene.receiver);
        |waiting|::add(set, |waiting|::NOTIFICATION, context.scene.bell.wait);
        transition context.scene.partial { true -> |waiting|::expire_by(set, context.scene.partial_deadline) _ -> done() }
    }
}
public machine command(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 6]) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block command_object(gate, context, words, 0u64)
}
public machine command_object(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 6], object: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block submit(gate, context, words, object);
    transition status == 0u64 { true -> block waiting(gate, context) _ -> (status) }
    machine waiting(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> u64 reaches |kernel|::Kernel {
        let tick: |time|::Tick = |time|::read(gate, context.clock);
        transition tick { |time|::Tick::Read { value } -> block checked(gate, context, value) _ -> (|kernel|::IO_ERROR) }
    }
    machine checked(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel {
        block step(gate, context, now);
        transition context.display_work.ready { true -> (take(context)) _ -> block parked(gate, context, now) }
    }
    machine parked(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel {
        let ignored: u64 = block |main|::wait(gate, &context.scene, |time|::after(now, 1u64));
        block waiting(gate, context)
    }
}
machine done() {}
