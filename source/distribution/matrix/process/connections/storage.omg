module storage;
// This matrix's storage. At the root the composition supplied provider links,
// one per source; under a parent matrix the broker supplied one upstream
// storage connection, over which the parent reports this matrix's binding
// revision and realm and relays its requests in turn. The owner binds each
// child's storage connection to a source and a scope object, and every child
// request is relayed one hop: authenticate the connection and binding
// revision, stamp the owner's scope, prove containment first when both scope
// words are taken, forward over the source's link with any sealed attachment,
// stamped with this matrix's own revision on the way up, and answer with the
// reply and attachment. The matrix holds one relay at a time and the hop's
// deadline bounds it; a lost or late link retires that source's bindings
// until a grant reconnects it, and a parent that refuses this matrix's
// revision is asked for the binding again once.
use protocol::main;
use protocol::matrix;
use protocol::storage::scope;
use protocol::storage::operations;
use shared::state::State;
use shared::state::Store;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::ipc::main::Opened;
use runtime::link;
use runtime::time::Tick;
use runtime::connection::main::Peer;
use runtime::connection::main::Reply;
use runtime::connection::main::Frame;
use runtime::server::main::Server;
use runtime::server::main::Event;
use runtime::server::main::Ticket;
use runtime::waiting::Set;
use world::scopes;
use world::scopes::Scopes;
use world::scopes::Bound;
use world::scopes::Prepared;
use world::scopes::Proof;
use world::geometry::zeros_from;
use shared::report;

public const SOURCES: u64 = 2u64;
// The link that carries the parent's storage connection; under a parent the
// children's one source, source zero, travels over it.
public const UPSTREAM: u64 = 2u64;
// A child may acquire storage long after admission; its listener's handshake
// window is the child's lifetime.
public const OPENING_TICKS: u64 = 0x3fffffffffffffffu64;
// The provider's reply words, with any sealed attachment this matrix now holds.
public data Outcome [copy] {
    words: [u64; 8];
    attachment: u64;
}

// Supplied provider links make this instance the storage root; nothing else does.
public machine discover(gate: &Gate, context: &mut State) reaches Kernel invokes Kernel {
    let first: u64 = link::at(gate, 0u64);
    let second: u64 = link::at(gate, 1u64);
    transition first < kernel::ERROR_BASE && second < kernel::ERROR_BASE {
        true -> rooted(context, first, second)
        _ -> done()
    }
    machine rooted(context: &mut State, first: u64, second: u64) {
        context.store.root = true;
        context.store.handles[0] = first;
        context.store.handles[1] = second;
    }
}
// The parent's storage connection, acquired from its broker at startup.
public machine connect_upstream(gate: &Gate, context: &mut State, now: u64, sender: u64, receiver: u64) -> u64
    reaches Kernel blocks invokes Kernel {
    let status: u64 = block runtime::connection::main::connect(gate, &mut context.store.links[2], sender, receiver,
        runtime::time::after(now, 300u64));
    transition status == 0u64 {
        true -> connected(gate, context)
        _ -> (status)
    }
    machine connected(gate: &Gate, context: &mut State) -> u64 reaches Kernel {
        context.store.linked[2] = true;
        context.store.has_upstream = true;
        report::parent_storage_ready(gate);
        0u64
    }
}

public machine owner_word(op: u64) -> bool {
    op == STORAGE_GRANT || op == STORAGE_REVOKE || op == STORAGE_STATUS || op == STORAGE_BINDING
}
public machine owner(gate: &Gate, context: &mut State, now: u64, frame: Frame) -> u64 reaches Kernel blocks invokes Kernel {
    let reply: [u64; 8] = block decide(gate, context, now, frame);
    block runtime::server::main::reply(gate, &mut context.owner, &reply)
}
// Only the root reports failed sources; a nested matrix's one source is its parent.
machine decide(gate: &Gate, context: &mut State, now: u64, frame: Frame) -> [u64; 8] reaches Kernel {
    let status: bool = frame.payload[0] == STORAGE_STATUS && zeros_from(&frame.payload, 1u64);
    transition {
        status && context.store.root -> (report_status(context))
        status -> (error(kernel::DENIED))
        frame.payload[1] < 5u64 -> block slotted(gate, context, now, frame, frame.payload[1])
        _ -> (error(kernel::DENIED))
    }
    machine slotted(gate: &Gate, context: &mut State, now: u64, frame: Frame, slot: u64 [0..=4]) -> [u64; 8] reaches Kernel {
        transition {
            frame.payload[0] == STORAGE_BINDING && zeros_from(&frame.payload, 2u64) -> (bound_reply(context, slot))
            frame.payload[0] == STORAGE_GRANT && zeros_from(&frame.payload, 4u64) ->
                block granting(gate, context, now, slot, frame.payload[2], frame.payload[3])
            frame.payload[0] == STORAGE_REVOKE && zeros_from(&frame.payload, 2u64) -> (revoking(context, slot))
            _ -> (error(kernel::DENIED))
        }
    }
}
machine report_status(context: &State) -> [u64; 8] {
    let mut words: [u64; 8];
    words[1] = context.store.failed;
    words
}
machine bound_reply(context: &State, slot: u64 [0..=4]) -> [u64; 8] {
    let bound: Bound = scopes::binding(&context.store.scopes, slot, context.store.listeners[slot].incarnation);
    transition bound.status == 0u64 {
        true -> (binding_words(bound))
        _ -> (error(kernel::DENIED))
    }
}
machine binding_words(bound: Bound) -> [u64; 8] {
    let mut words: [u64; 8];
    words[1] = bound.source;
    words[2] = bound.scope;
    words
}
machine granting(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], source: u64, subtree: u64) -> [u64; 8] reaches Kernel {
    let status: u64 = block bind(gate, context, now, slot, source, subtree);
    error(status)
}
// Bind a child's live storage connection to a source and scope. The binding
// also re-establishes the source's link, so one made after provider
// replacement connects to the fresh incarnation; under a parent it learns
// this matrix's own binding again.
public machine bind(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], source: u64, subtree: u64) -> u64
    reaches Kernel blocks invokes Kernel {
    let available: u64 = available(context);
    transition source < available && source < 2u64 {
        true -> block refreshing(gate, context, now, slot, source, subtree, available)
        _ -> (kernel::DENIED)
    }
    machine refreshing(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], source: u64 [0..=1], subtree: u64, available: u64) -> u64
        reaches Kernel {
        let status: u64 = block refresh(gate, context, now, source);
        transition status == 0u64 {
            true -> (installing(context, slot, source, subtree, available))
            _ -> (status)
        }
    }
    machine installing(context: &mut State, slot: u64 [0..=4], source: u64 [0..=1], subtree: u64, available: u64) -> u64 {
        let incarnation: u64 = context.store.listeners[slot].incarnation;
        let status: u64 = scopes::grant(&mut context.store.scopes, slot, incarnation, source, subtree, available);
        transition status == 0u64 {
            true -> healthy(context, source)
            _ -> (status)
        }
    }
    machine healthy(context: &mut State, source: u64 [0..=1]) -> u64 {
        context.store.failed = context.store.failed & ~(1u64 << source);
        0u64
    }
}
// The matrix's own read of a whole object over its first source: the sealed
// program behind a launch. `stamp` narrows a child's launch to its realm.
public machine read_object(gate: &Gate, context: &mut State, now: u64, object: u64, stamp: u64) -> Outcome
    reaches Kernel blocks invokes Kernel {
    let mut words: [u64; 8];
    words[0] = ((STORAGE_BASE as u64 in Wrapping) + (operations::BULK as u64 in Wrapping)) as u64;
    words[1] = object;
    let fits: bool = scope::stamp(&mut words, stamp);
    transition fits && (context.store.root || context.store.has_upstream) {
        true -> block exchange(gate, context, now, 0u64, words, 0u64)
        _ -> (failed(kernel::DENIED))
    }
}
// One request of this matrix's own over its first source with no scope of its
// own: a listing of its realm.
public machine request(gate: &Gate, context: &mut State, now: u64, words: [u64; 8]) -> Outcome
    reaches Kernel blocks invokes Kernel {
    let request: [u64; 8] = words;
    transition context.store.root || context.store.has_upstream {
        true -> block exchange(gate, context, now, 0u64, request, 0u64)
        _ -> (failed(kernel::DENIED))
    }
}
// This matrix's own binding: the store's root at the storage root, or the
// parent's report, learnt now if it has not been.
public machine learn(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel blocks invokes Kernel {
    transition {
        context.store.root -> (0u64)
        context.store.informed -> (0u64)
        context.store.has_upstream -> block inform(gate, context, now)
        _ -> (kernel::PEER_CLOSED)
    }
}
// The sources children may be bound to: both provider links at the root, the
// parent's one connection beneath it.
machine available(context: &State) -> u64 {
    transition {
        context.store.root -> (SOURCES)
        context.store.has_upstream -> (1u64)
        _ -> (0u64)
    }
}
// Revocation is local: the stale scope simply stops authorizing.
machine revoking(context: &mut State, slot: u64 [0..=4]) -> [u64; 8] {
    let ignored: u64 = scopes::revoke(&mut context.store.scopes, slot);
    ok()
}
// Make the source current: connect or reconnect its link at the root, or
// learn this matrix's binding from the parent.
machine refresh(gate: &Gate, context: &mut State, now: u64, source: u64 [0..=1]) -> u64 reaches Kernel {
    transition context.store.root {
        true -> block relink(gate, context, now, source)
        _ -> block inform(gate, context, now)
    }
}
// Connect the source's link, or reconnect it to a replaced provider. A still
// live accepted link answers BUSY and keeps the client it has.
machine relink(gate: &Gate, context: &mut State, now: u64, source: u64 [0..=1]) -> u64 reaches Kernel {
    let opened: Opened = link::connect(gate, context.store.handles[source]);
    transition opened {
        Opened::Ready { channel } -> block adopting(gate, context, now, source, channel.sender, channel.receiver)
        Opened::Failed { code } -> (unchanged(context, source, code))
    }
    machine unchanged(context: &State, source: u64 [0..=1], code: u64) -> u64 {
        transition code == kernel::BUSY && context.store.linked[source] {
            true -> (0u64)
            _ -> (code)
        }
    }
    machine adopting(gate: &Gate, context: &mut State, now: u64, source: u64 [0..=1], sender: u64, receiver: u64) -> u64 reaches Kernel {
        let closed: u64 = block runtime::connection::main::close(gate, &mut context.store.links[source]);
        let fresh: Peer;
        context.store.links[source] = fresh;
        context.store.linked[source] = false;
        let status: u64 = block runtime::connection::main::connect(gate, &mut context.store.links[source], sender, receiver,
            runtime::time::after(now, 300u64));
        transition status == 0u64 {
            true -> adopted(gate, context, source)
            _ -> (status)
        }
    }
    machine adopted(gate: &Gate, context: &mut State, source: u64 [0..=1]) -> u64 reaches Kernel {
        context.store.linked[source] = true;
        scopes::revoke_source(&mut context.store.scopes, source);
        report::storage_ready(gate);
        0u64
    }
}
// Ask the parent for this matrix's binding: the revision that stamps every
// request upward and the realm children without a scope of their own inherit.
// A changed revision means an ancestor revoked the old binding, which empties
// every grant made under it.
machine inform(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    let mut words: [u64; 8];
    words[0] = STORAGE_INFO;
    words[7] = scope::deadline(now, 0u64, STORAGE_DEADLINE_TICKS);
    transition context.store.linked[2] && words[7] != 0u64 {
        true -> block asking(gate, context, words)
        _ -> (kernel::PEER_CLOSED)
    }
    machine asking(gate: &Gate, context: &mut State, words: [u64; 8]) -> u64 reaches Kernel {
        let request: [u64; 8] = words;
        let status: u64 = block runtime::connection::main::begin_object(gate, &mut context.store.links[2], &request, 0u64);
        transition status == 0u64 {
            true -> block told(gate, context, request[7])
            _ -> block failing(gate, context, status)
        }
    }
    machine told(gate: &Gate, context: &mut State, deadline: u64) -> u64 reaches Kernel {
        let outcome: Outcome = block awaiting(gate, context, UPSTREAM, deadline);
        block release(gate, outcome.attachment);
        let revision: u64 = outcome.words[1];
        transition outcome.words[0] == 0u64 && revision != 0u64 && revision <= scope::MAX_REVISION {
            true -> (learned(context, revision, outcome.words[2]))
            _ -> (unbound(context, outcome.words[0]))
        }
    }
    machine learned(context: &mut State, revision: u64, realm: u64) -> u64 {
        transition revision == context.store.revision {
            true -> kept(context, realm)
            _ -> replaced(context, revision, realm)
        }
    }
    machine replaced(context: &mut State, revision: u64, realm: u64) -> u64 {
        scopes::clear(&mut context.store.scopes);
        context.store.revision = revision;
        transition { _ -> kept(context, realm) }
    }
    machine kept(context: &mut State, realm: u64) -> u64 {
        context.store.realm = realm;
        context.store.informed = true;
        context.store.failed = context.store.failed & ~1u64;
        0u64
    }
    machine unbound(context: &mut State, status: u64) -> u64 {
        scopes::clear(&mut context.store.scopes);
        context.store.revision = 0u64;
        context.store.realm = 0u64;
        context.store.informed = false;
        transition status == 0u64 {
            true -> (kernel::DENIED)
            _ -> (status)
        }
    }
    machine failing(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
        let outcome: Outcome = block retired(gate, context, UPSTREAM, status);
        status
    }
}

// Serve an admitted child's storage connection from the pair admission
// retained. A slot's previous listener was closed; a fresh one keeps only
// the incarnation count, so no old binding or ticket can match the new child.
public machine listen(context: &mut State, slot: u64 [0..=4], now: u64) -> u64 {
    let sender: u64 = context.slots[slot].storage.sender;
    let receiver: u64 = context.slots[slot].storage.receiver;
    context.slots[slot].storage.sender = 0u64;
    context.slots[slot].storage.receiver = 0u64;
    let incarnation: u64 = context.store.listeners[slot].incarnation;
    let fresh: Server;
    context.store.listeners[slot] = fresh;
    context.store.listeners[slot].incarnation = incarnation;
    runtime::server::main::begin(&mut context.store.listeners[slot], sender, receiver, runtime::time::after(now, OPENING_TICKS), true)
}
// The child is gone: drop its listener and binding.
public machine retire(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel blocks invokes Kernel {
    block runtime::server::main::close(gate, &mut context.store.listeners[slot]);
    let ignored: u64 = scopes::revoke(&mut context.store.scopes, slot);
}
// One request per child connection per turn; a failed relay answers the
// child and never takes the matrix down.
public machine step(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel blocks invokes Kernel {
    block slot_step(gate, context, 0u64, now);
    block slot_step(gate, context, 1u64, now);
    block slot_step(gate, context, 2u64, now);
    block slot_step(gate, context, 3u64, now);
    block slot_step(gate, context, 4u64, now);
    0u64
}
machine slot_step(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64) reaches Kernel {
    transition {
        context.store.listeners[slot].peer.receiver == 0u64 || context.store.listeners[slot].peer.fault != 0u64 -> done()
        context.store.listeners[slot].pending != 0u64 -> block held(gate, context, slot, now)
        _ -> block receive(gate, context, slot, now)
    }
}
machine held(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64) reaches Kernel {
    let status: u64 = block runtime::server::main::maintain(gate, &mut context.store.listeners[slot], now);
}
machine receive(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64) reaches Kernel {
    let event: Event = block runtime::server::main::poll(gate, &mut context.store.listeners[slot], now);
    transition event {
        Event::Request { frame } -> block serve(gate, context, slot, now, frame)
        Event::Pending -> done()
        Event::Failed { code } -> failed(gate, context, slot, code)
    }
}
// The child's storage connection retired; its binding goes with it.
// Diagnostic links 0..2 name providers; 3..7 name child storage connections.
machine failed(gate: &Gate, context: &mut State, slot: u64 [0..=4], code: u64) reaches Kernel {
    report::storage_lost(gate, slot + 3u64, code);
    lost(context, slot);
}
machine lost(context: &mut State, slot: u64 [0..=4]) {
    let ignored: u64 = scopes::revoke(&mut context.store.scopes, slot);
}
machine serve(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64, frame: Frame) reaches Kernel {
    let issued: Ticket = runtime::server::main::ticket(&context.store.listeners[slot]);
    let incarnation: u64 = context.store.listeners[slot].incarnation;
    let object: u64 = context.store.listeners[slot].object;
    context.store.listeners[slot].object = 0u64;
    transition frame.bytes == 64u64 {
        true -> block prepared(gate, context, slot, now, issued, incarnation, object, frame.payload)
        _ -> block answer(gate, context, slot, issued, error(kernel::DENIED), 0u64, object)
    }
}
// Children bound with a scope of zero see this matrix's own realm, as the
// parent reported it; at the root there is none to report.
machine prepared(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64, issued: Ticket, incarnation: u64, object: u64,
    request: [u64; 8]) reaches Kernel {
    let prepared: Prepared = scopes::prepare(&context.store.scopes, slot, incarnation, request, context.store.realm);
    transition prepared {
        Prepared::Reply { words } -> block answer(gate, context, slot, issued, words, 0u64, object)
        Prepared::Refused { code } -> block answer(gate, context, slot, issued, error(code), 0u64, object)
        Prepared::Forward { source, words } -> block forwarding(gate, context, slot, now, issued, source, words, object)
        Prepared::Validate { source, check, words, proof } ->
            block validating(gate, context, slot, now, issued, source, check, words, proof, object)
    }
}
// The read-only containment check goes first; only its success lets the
// folded request follow, and the attachment waits with it.
machine validating(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64, issued: Ticket, source: u64, check: [u64; 8],
    words: [u64; 8], proof: Proof, object: u64) reaches Kernel {
    let outcome: Outcome = block exchange(gate, context, now, source, check, 0u64);
    block release(gate, outcome.attachment);
    transition outcome.words[0] == 0u64 {
        true -> block confirming(gate, context, slot, now, issued, source, words, proof, object)
        _ -> block answer(gate, context, slot, issued, outcome.words, 0u64, object)
    }
}
machine confirming(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64, issued: Ticket, source: u64, words: [u64; 8],
    proof: Proof, object: u64) reaches Kernel {
    let status: u64 = scopes::confirm(&mut context.store.scopes, proof);
    transition status == 0u64 {
        true -> block forwarding(gate, context, slot, now, issued, source, words, object)
        _ -> block answer(gate, context, slot, issued, error(status), 0u64, object)
    }
}
machine forwarding(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64, issued: Ticket, source: u64, words: [u64; 8],
    object: u64) reaches Kernel {
    let outcome: Outcome = block exchange(gate, context, now, source, words, object);
    // The next hop received its own right to the attachment; this one is done.
    block release(gate, object);
    block answer(gate, context, slot, issued, outcome.words, outcome.attachment, 0u64)
}
// Reply, then drop the rights this matrix still holds: the attachment the
// reply carried, now the child's own, and one it never forwarded.
machine answer(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, words: [u64; 8], attachment: u64, unused: u64)
    reaches Kernel {
    let payload: [u64; 8] = words;
    let status: u64 = block runtime::server::main::reply_object_to(gate, &mut context.store.listeners[slot], issued, &payload, attachment);
    block release(gate, attachment);
    block release(gate, unused);
}
machine release(gate: &Gate, handle: u64) reaches Kernel {
    transition handle != 0u64 {
        true -> block releasing(gate, handle)
        _ -> done()
    }
    machine releasing(gate: &Gate, handle: u64) reaches Kernel {
        let ignored: u64 = block Kernel::memory_release(gate, handle);
    }
}

// One request over a source's link, bounded by the hop's deadline. A failure
// retires the link and every binding naming the source, and is the answer.
machine exchange(gate: &Gate, context: &mut State, now: u64, source: u64, request: [u64; 8], object: u64) -> Outcome reaches Kernel {
    let deadline: u64 = scope::deadline(now, request[7], STORAGE_DEADLINE_TICKS);
    let index: u64 = link_of(context, source);
    transition deadline != 0u64 && source < 2u64 && index <= 2u64 {
        true -> block linked(gate, context, now, index, request, object, deadline)
        _ -> (failed(kernel::TIMED_OUT))
    }
    machine linked(gate: &Gate, context: &mut State, now: u64, index: u64 [0..=2], request: [u64; 8], object: u64, deadline: u64) -> Outcome
        reaches Kernel {
        let status: u64 = block client(gate, context, now, index);
        transition status == 0u64 {
            true -> block sending(gate, context, now, index, request, object, deadline)
            _ -> (failed(status))
        }
    }
    machine sending(gate: &Gate, context: &mut State, now: u64, index: u64 [0..=2], request: [u64; 8], object: u64, deadline: u64) -> Outcome
        reaches Kernel {
        transition index == UPSTREAM {
            true -> block relaying(gate, context, now, request, object, deadline, false)
            _ -> block plain_send(gate, context, index, request, object, deadline)
        }
    }
}
// At the root each source has its own link; under a parent every source is the upstream one.
machine link_of(context: &State, source: u64) -> u64 {
    transition context.store.root {
        true -> (source)
        _ -> (UPSTREAM)
    }
}
// A provider link connects when the first grant or request needs it; the
// parent's connection cannot be remade once lost.
machine client(gate: &Gate, context: &mut State, now: u64, index: u64 [0..=2]) -> u64 reaches Kernel {
    transition {
        context.store.linked[index] -> (0u64)
        index == 0u64 -> block relink(gate, context, now, 0u64)
        index == 1u64 -> block relink(gate, context, now, 1u64)
        _ -> (kernel::PEER_CLOSED)
    }
}
machine failed(code: u64) -> Outcome {
    Outcome { words: error(code), attachment: 0u64 }
}
// At the root the provider sees the plain operation and this hop's deadline.
machine plain_send(gate: &Gate, context: &mut State, index: u64 [0..=2], request: [u64; 8], object: u64, deadline: u64) -> Outcome reaches Kernel {
    let mut words: [u64; 8] = request;
    words[0] = (((request[0] & 0xffffu64) as u64 in Wrapping) - (STORAGE_BASE as u64 in Wrapping)) as u64;
    words[7] = deadline;
    let status: u64 = block runtime::connection::main::begin_object(gate, &mut context.store.links[index], &words, object);
    transition status == 0u64 {
        true -> block awaiting(gate, context, index, deadline)
        _ -> block retired(gate, context, index, status)
    }
}
// Up to the parent the operation keeps its base and takes this matrix's
// revision, learnt first when it is not yet known. A parent that refuses the
// revision is asked once more and the request repeated under the new one.
machine relaying(gate: &Gate, context: &mut State, now: u64, request: [u64; 8], object: u64, deadline: u64, retried: bool) -> Outcome
    reaches Kernel {
    transition context.store.informed {
        true -> block stamped(gate, context, now, request, object, deadline, retried)
        _ -> block learning(gate, context, now, request, object, deadline, retried)
    }
    machine learning(gate: &Gate, context: &mut State, now: u64, request: [u64; 8], object: u64, deadline: u64, retried: bool) -> Outcome
        reaches Kernel {
        let status: u64 = block inform(gate, context, now);
        transition status == 0u64 {
            true -> block stamped(gate, context, now, request, object, deadline, retried)
            _ -> (failed(status))
        }
    }
    machine stamped(gate: &Gate, context: &mut State, now: u64, request: [u64; 8], object: u64, deadline: u64, retried: bool) -> Outcome
        reaches Kernel {
        let revision: u64 = context.store.revision;
        transition revision <= scope::MAX_REVISION && context.store.linked[2] {
            true -> block sent(gate, context, now, request, object, deadline, retried, revision)
            _ -> (failed(kernel::PEER_CLOSED))
        }
    }
    machine sent(gate: &Gate, context: &mut State, now: u64, request: [u64; 8], object: u64, deadline: u64, retried: bool, revision: u64) -> Outcome
        reaches Kernel requires revision <= scope::MAX_REVISION {
        let mut words: [u64; 8] = request;
        words[0] = (revision << 16u64) | (request[0] & 0xffffu64);
        words[7] = deadline;
        let status: u64 = block runtime::connection::main::begin_object(gate, &mut context.store.links[2], &words, object);
        transition status == 0u64 {
            true -> block answered(gate, context, now, request, object, deadline, retried)
            _ -> block retired(gate, context, UPSTREAM, status)
        }
    }
    machine answered(gate: &Gate, context: &mut State, now: u64, request: [u64; 8], object: u64, deadline: u64, retried: bool) -> Outcome
        reaches Kernel {
        let outcome: Outcome = block awaiting(gate, context, UPSTREAM, deadline);
        transition outcome.words[0] == kernel::DENIED && outcome.attachment == 0u64 && !retried {
            true -> block relearning(gate, context, now, request, object, deadline)
            _ -> (outcome)
        }
    }
    // One refusal may mean a binding revoked and granted again: learn it and repeat once.
    machine relearning(gate: &Gate, context: &mut State, now: u64, request: [u64; 8], object: u64, deadline: u64) -> Outcome reaches Kernel {
        let previous: u64 = context.store.revision;
        let status: u64 = block inform(gate, context, now);
        transition status == 0u64 && context.store.revision != previous {
            true -> block stamped(gate, context, now, request, object, deadline, true)
            _ -> (failed(kernel::DENIED))
        }
    }
}
machine awaiting(gate: &Gate, context: &mut State, index: u64 [0..=2], deadline: u64) -> Outcome reaches Kernel {
    let tick: Tick = runtime::time::read(gate, context.clock);
    transition tick {
        Tick::Read { value } -> block polling(gate, context, index, deadline, value)
        Tick::Failed { code } -> block retired(gate, context, index, code)
    }
}
machine polling(gate: &Gate, context: &mut State, index: u64 [0..=2], deadline: u64, now: u64) -> Outcome reaches Kernel {
    let reply: Reply = block runtime::connection::main::poll(gate, &mut context.store.links[index], now);
    transition reply {
        Reply::Complete { frame, notification } -> block plain(gate, context, index, frame, notification)
        Reply::Object { frame, object } -> block attached(gate, context, index, frame, object)
        Reply::Endpoint { frame, endpoint } -> block stray(gate, context, index, endpoint)
        Reply::Failed { code } -> block retired(gate, context, index, code)
        Reply::Pending -> block waiting(gate, context, index, deadline, now)
    }
}
machine waiting(gate: &Gate, context: &mut State, index: u64 [0..=2], deadline: u64, now: u64) -> Outcome reaches Kernel {
    transition runtime::time::reached(now, deadline) {
        true -> block retired(gate, context, index, kernel::TIMED_OUT)
        _ -> block parked(gate, context, index, deadline)
    }
}
machine parked(gate: &Gate, context: &mut State, index: u64 [0..=2], deadline: u64) -> Outcome reaches Kernel {
    let status: u64 = block runtime::connection::main::wait(gate, &context.store.links[index], deadline);
    transition status < kernel::ERROR_BASE || status == kernel::TIMED_OUT || status == kernel::PEER_CLOSED {
        true -> block awaiting(gate, context, index, deadline)
        _ -> block retired(gate, context, index, status)
    }
}
machine plain(gate: &Gate, context: &mut State, index: u64 [0..=2], frame: Frame, notification: u64) -> Outcome reaches Kernel {
    transition frame.bytes == 64u64 && notification == 0u64 {
        true -> (Outcome { words: frame.payload, attachment: 0u64 })
        _ -> block malformed(gate, context, index, notification)
    }
}
machine malformed(gate: &Gate, context: &mut State, index: u64 [0..=2], notification: u64) -> Outcome reaches Kernel {
    let ignored: u64 = Kernel::notify_drop(gate, notification);
    block retired(gate, context, index, kernel::IO_ERROR)
}
machine attached(gate: &Gate, context: &mut State, index: u64 [0..=2], frame: Frame, object: u64) -> Outcome reaches Kernel {
    transition frame.bytes == 64u64 {
        true -> (Outcome { words: frame.payload, attachment: object })
        _ -> block dropped(gate, context, index, object)
    }
}
machine dropped(gate: &Gate, context: &mut State, index: u64 [0..=2], object: u64) -> Outcome reaches Kernel {
    block release(gate, object);
    block retired(gate, context, index, kernel::IO_ERROR)
}
machine stray(gate: &Gate, context: &mut State, index: u64 [0..=2], endpoint: u64) -> Outcome reaches Kernel {
    let ignored: u64 = Kernel::close(gate, endpoint);
    block retired(gate, context, index, kernel::IO_ERROR)
}
// A lost or late link: forget its client and every binding that named its
// source. The parent's connection also forgets the binding it reported.
machine retired(gate: &Gate, context: &mut State, index: u64 [0..=2], code: u64) -> Outcome reaches Kernel {
    report::storage_lost(gate, index, code);
    let closed: u64 = block runtime::connection::main::close(gate, &mut context.store.links[index]);
    context.store.linked[index] = false;
    transition index == UPSTREAM {
        true -> (parent_lost(context, code))
        _ -> (source_lost(context, index, code))
    }
    machine source_lost(context: &mut State, index: u64 [0..=2], code: u64) -> Outcome {
        context.store.failed = context.store.failed | (1u64 << index);
        scopes::revoke_source(&mut context.store.scopes, index);
        failed(code)
    }
    machine parent_lost(context: &mut State, code: u64) -> Outcome {
        context.store.failed = context.store.failed | 1u64;
        context.store.informed = false;
        context.store.revision = 0u64;
        context.store.realm = 0u64;
        scopes::revoke_source(&mut context.store.scopes, 0u64);
        failed(code)
    }
}

public machine watch(context: &State, set: &mut Set) {
    runtime::server::main::watch(&context.store.listeners[0], set);
    runtime::server::main::watch(&context.store.listeners[1], set);
    runtime::server::main::watch(&context.store.listeners[2], set);
    runtime::server::main::watch(&context.store.listeners[3], set);
    runtime::server::main::watch(&context.store.listeners[4], set);
}
public machine close(gate: &Gate, context: &mut State) reaches Kernel blocks invokes Kernel {
    block runtime::server::main::close(gate, &mut context.store.listeners[0]);
    block runtime::server::main::close(gate, &mut context.store.listeners[1]);
    block runtime::server::main::close(gate, &mut context.store.listeners[2]);
    block runtime::server::main::close(gate, &mut context.store.listeners[3]);
    block runtime::server::main::close(gate, &mut context.store.listeners[4]);
    let first: u64 = block runtime::connection::main::close(gate, &mut context.store.links[0]);
    let second: u64 = block runtime::connection::main::close(gate, &mut context.store.links[1]);
    let parent: u64 = block runtime::connection::main::close(gate, &mut context.store.links[2]);
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
machine ok() -> [u64; 8] {
    let words: [u64; 8];
    words
}
machine done() {}
