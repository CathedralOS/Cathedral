module parent::calls;
// Remaining synchronous callers reserve the visual lane explicitly. A poll can
// stay outstanding beside it; replies are always dispatched by connection.omg.
// Event-loop work will replace these waits operation by operation.
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::time::Tick;
use parent::connection;
public machine exchange(gate: &Gate, context: &mut State, words: [u64; 8], image: u64) -> [u64; 8] reaches Kernel blocks invokes Kernel {
    let tick: Tick = runtime::time::read(gate, context.clock);
    transition tick {
        Tick::Read { value } -> block submitted(gate, context, words, image, value)
        _ -> (error(kernel::IO_ERROR))
    }
}
machine submitted(gate: &Gate, context: &mut State, words: [u64; 8], image: u64, now: u64) -> [u64; 8] reaches Kernel {
    block connection::step(gate, context, now);
    let status: u64 = block connection::visual(gate, context, words, image);
    transition {
        status == 0u64 -> block waiting(gate, context)
        status == kernel::WOULD_BLOCK -> block retry(gate, context, words, image, now)
        _ -> (error(status))
    }
}
machine retry(gate: &Gate, context: &mut State, words: [u64; 8], image: u64, now: u64) -> [u64; 8] reaches Kernel {
    let status: u64 = block runtime::connection::main::wait(gate, &context.parent.broker, runtime::time::after(now, 1u64));
    block exchange(gate, context, words, image)
}
machine waiting(gate: &Gate, context: &mut State) -> [u64; 8] reaches Kernel {
    let tick: Tick = runtime::time::read(gate, context.clock);
    transition tick { Tick::Read { value } -> block poll(gate, context, value) _ -> (error(kernel::IO_ERROR)) }
}
machine poll(gate: &Gate, context: &mut State, now: u64) -> [u64; 8] reaches Kernel {
    block connection::step(gate, context, now);
    transition context.parent_work.visual_ready { true -> (connection::take_visual(context)) _ -> block parked(gate, context, now) }
}
machine parked(gate: &Gate, context: &mut State, now: u64) -> [u64; 8] reaches Kernel {
    let status: u64 = block runtime::connection::main::wait(gate, &context.parent.broker, runtime::time::after(now, 1u64));
    block waiting(gate, context)
}
machine error(code: u64) -> [u64; 8] { [code,0u64,0u64,0u64,0u64,0u64,0u64,0u64] }
