use {runtime}/connection/main.omg;
// Remaining synchronous callers reserve the visual lane explicitly. A poll can
// stay outstanding beside it; replies are always dispatched by connection.omg.
// Event-loop work will replace these waits operation by operation.
use {shared}/state.omg as shared_state;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use parent/connection.omg;
public machine exchange(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8], image: u64) -> [u64; 8] reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block submitted(gate, context, words, image, value)
        _ -> (error(|kernel|::IO_ERROR))
    }
}
machine submitted(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8], image: u64, now: u64) -> [u64; 8] reaches |kernel|::Kernel {
    block |connection|::step(gate, context, now);
    let status: u64 = block |connection|::visual(gate, context, words, image);
    transition {
        status == 0u64 -> block waiting(gate, context)
        status == |kernel|::WOULD_BLOCK -> block retry(gate, context, words, image, now)
        _ -> (error(status))
    }
}
machine retry(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8], image: u64, now: u64) -> [u64; 8] reaches |kernel|::Kernel {
    let status: u64 = block |main|::wait(gate, &context.parent.broker, |time|::after(now, 1u64));
    block exchange(gate, context, words, image)
}
machine waiting(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> [u64; 8] reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick { |time|::Tick::Read { value } -> block poll(gate, context, value) _ -> (error(|kernel|::IO_ERROR)) }
}
machine poll(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> [u64; 8] reaches |kernel|::Kernel {
    block |connection|::step(gate, context, now);
    transition context.parent_work.visual_ready { true -> (|connection|::take_visual(context)) _ -> block parked(gate, context, now) }
}
machine parked(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> [u64; 8] reaches |kernel|::Kernel {
    let status: u64 = block |main|::wait(gate, &context.parent.broker, |time|::after(now, 1u64));
    block waiting(gate, context)
}
machine error(code: u64) -> [u64; 8] { [code,0u64,0u64,0u64,0u64,0u64,0u64,0u64] }
