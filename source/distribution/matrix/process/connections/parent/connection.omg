use {runtime}/services/main.omg as services_main;
// One receiver dispatches the broker's exact request IDs to the poll, visual and funding
// callers. Neither caller reads the transport behind the other's back. A reply
// remains owned by its caller until consumed, even after its transport slot freed.
use {shared}/state.omg as shared_state;
use {runtime}/kernel.omg;
use {runtime}/connection/main.omg;
use {protocol}/main.omg as protocol_main;
use {runtime}/waiting.omg;

public machine poll(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.parent_work.poll != 0u64 || context.parent_work.poll_ready {
        true -> (|kernel|::BUSY)
        _ -> block submit(gate, context, [|protocol_main|::MATRIX_POLL,0u64,0u64,0u64,0u64,0u64,0u64,0u64], 0u64, Lane::Poll)
    }
}
public machine visual(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8], image: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.parent_work.visual != 0u64 || context.parent_work.visual_ready {
        true -> (|kernel|::BUSY)
        _ -> block submit(gate, context, words, image, Lane::Visual)
    }
}
data Lane [copy] { case Poll; case Visual; case Funding; }
public machine funding(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8]) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.parent_work.funding != 0u64 || context.parent_work.funding_ready {
        true -> (|kernel|::BUSY)
        _ -> block submit(gate, context, words, 0u64, Lane::Funding)
    }
}
machine submit(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8], image: u64, lane: Lane) -> u64 reaches |kernel|::Kernel {
    let request: [u64; 8] = words;
    let result: |main|::Submission = block |main|::submit(gate, &mut context.parent.broker, &request, image);
    transition result {
        |main|::Submission::Submitted { request } -> submitted(context, request, lane)
        |main|::Submission::Backpressure -> (|kernel|::WOULD_BLOCK)
        |main|::Submission::Failed { code } -> failed(context, code)
    }
}
machine submitted(context: &mut |shared_state|::State, id: u64, lane: Lane) -> u64 {
    transition lane { Lane::Poll -> polled(context, id) Lane::Visual -> visual(context, id) Lane::Funding -> funded(context, id) }
    machine funded(context: &mut |shared_state|::State, id: u64) -> u64 { context.parent_work.funding = id; 0u64 }
    machine polled(context: &mut |shared_state|::State, id: u64) -> u64 { context.parent_work.poll = id; context.refresh_due = false; 0u64 }
    machine visual(context: &mut |shared_state|::State, id: u64) -> u64 { context.parent_work.visual = id; 0u64 }
}
// At most three replies per turn; all other event-loop work gets its turn too.
public machine step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block receive(gate, context, now);
    block receive(gate, context, now);
    block receive(gate, context, now);
}
machine receive(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) reaches |kernel|::Kernel {
    transition context.parent_work.poll != 0u64 || context.parent_work.visual != 0u64 || context.parent_work.funding != 0u64 {
        true -> block incoming(gate, context, now)
        _ -> done()
    }
}
machine incoming(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) reaches |kernel|::Kernel {
    let reply: |main|::Reply = block |main|::poll(gate, &mut context.parent.broker, now);
    transition reply {
        |main|::Reply::Pending -> done()
        |main|::Reply::Complete { frame, notification } -> block decoded(gate, context, frame, notification)
        |main|::Reply::Object { frame, object } -> block object(gate, context, object)
        |main|::Reply::Endpoint { frame, endpoint } -> block endpoint(gate, context, endpoint)
        |main|::Reply::Failed { code } -> failure(context, code)
    }
}
machine decoded(gate: &|kernel|::Gate, context: &mut |shared_state|::State, frame: |main|::Frame, notification: u64) reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && notification == 0u64 {
        true -> block delivered(gate, context, frame.id, frame.payload)
        _ -> block malformed(gate, context, notification)
    }
}
machine malformed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, notification: u64) reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    block corrupt(gate, context);
}
machine delivered(gate: &|kernel|::Gate, context: &mut |shared_state|::State, id: u64, words: [u64; 8]) reaches |kernel|::Kernel {
    transition {
        id != 0u64 && id == context.parent_work.poll -> polled(context, words)
        id != 0u64 && id == context.parent_work.visual -> visual(context, words)
        id != 0u64 && id == context.parent_work.funding -> funded(context, words)
        _ -> block corrupt(gate, context)
    }
    machine funded(context: &mut |shared_state|::State, words: [u64; 8]) { context.parent_work.funding = 0u64; context.parent_work.funding_ready = true; context.parent_work.funding_answer = words; }
    machine polled(context: &mut |shared_state|::State, words: [u64; 8]) { context.parent_work.poll = 0u64; context.parent_work.poll_ready = true; context.parent_work.snapshot = words; }
    machine visual(context: &mut |shared_state|::State, words: [u64; 8]) { context.parent_work.visual = 0u64; context.parent_work.visual_ready = true; context.parent_work.answer = words; }
}
machine corrupt(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel {
    block |services_main|::close(gate, &mut context.parent);
    failure(context, |kernel|::IO_ERROR);
}
machine object(gate: &|kernel|::Gate, context: &mut |shared_state|::State, object: u64) reaches |kernel|::Kernel {
    let reply: |services_main|::Reply = block |services_main|::unexpected_object(gate, &mut context.parent, object);
    failure(context, |kernel|::IO_ERROR);
}
machine endpoint(gate: &|kernel|::Gate, context: &mut |shared_state|::State, endpoint: u64) reaches |kernel|::Kernel {
    let reply: |services_main|::Reply = block |services_main|::unexpected_endpoint(gate, &mut context.parent, endpoint);
    failure(context, |kernel|::IO_ERROR);
}
machine failed(context: &mut |shared_state|::State, code: u64) -> u64 { failure(context, code); code }
machine failure(context: &mut |shared_state|::State, code: u64) {
    context.parent_work.poll_ready = context.parent_work.poll_ready || context.parent_work.poll != 0u64;
    context.parent_work.visual_ready = context.parent_work.visual_ready || context.parent_work.visual != 0u64;
    context.parent_work.funding_ready = context.parent_work.funding_ready || context.parent_work.funding != 0u64;
    context.parent_work.funding = 0u64;
    context.parent_work.funding_answer = [code,0u64,0u64,0u64,0u64,0u64,0u64,0u64];
    context.parent_work.poll = 0u64;
    context.parent_work.visual = 0u64;
    context.parent_work.snapshot = [code,0u64,0u64,0u64,0u64,0u64,0u64,0u64];
    context.parent_work.answer = context.parent_work.snapshot;
}
public machine take_visual(context: &mut |shared_state|::State) -> [u64; 8] {
    context.parent_work.visual_ready = false;
    context.parent_work.answer
}
public machine take_funding(context: &mut |shared_state|::State) -> [u64; 8] {
    context.parent_work.funding_ready = false;
    context.parent_work.funding_answer
}
public machine watch(context: &|shared_state|::State, set: &mut |waiting|::Set) {
    transition context.parent_work.poll != 0u64 || context.parent_work.visual != 0u64 || context.parent_work.funding != 0u64 {
        true -> watched(context, set)
        _ -> done()
    }
    machine watched(context: &|shared_state|::State, set: &mut |waiting|::Set) {
        |waiting|::add(set, |waiting|::IPC, context.parent.broker.receiver);
        |waiting|::add(set, |waiting|::NOTIFICATION, context.parent.broker.bell.wait);
        transition context.parent.broker.partial { true -> |waiting|::expire_by(set, context.parent.broker.partial_deadline) _ -> done() }
    }
}
machine done() {}
