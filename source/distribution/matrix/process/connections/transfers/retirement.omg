module transfers::retirement;
// A settled scene owns its obsolete backings until cleanup finishes. Detach a
// rejected batch atomically; then release at most one handle per continuation.
// Shutdown alone drains this custody synchronously. Individual memory-release
// syscalls still park the caller; this bounds their batch, not each syscall.
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use world::batch;
use presentation;

public machine discard_batch(context: &mut State, slot: u64 [0..=4], revision: u64, stale: bool) {
    detach(context, slot, 0u64);
    transition stale {
        true -> reset(context, slot)
        _ -> abort(context, slot, revision)
    }
    machine detach(context: &mut State, slot: u64 [0..=4], index: u64 [0..=64]) {
        transition index < 64u64 { true -> taken(context, slot, index) _ -> done() }
    }
    machine taken(context: &mut State, slot: u64 [0..=4], index: u64 [0..=63]) {
        context.presentation_work.releases[index] = batch::take_payload(&mut context.batches[slot], index);
        transition { _ -> detach(context, slot, index + 1u64) }
    }
    machine reset(context: &mut State, slot: u64 [0..=4]) { batch::reset(&mut context.batches[slot]); }
    machine abort(context: &mut State, slot: u64 [0..=4], revision: u64) {
        let ignored: u64 = batch::abort(&mut context.batches[slot], revision);
    }
}
public machine step(gate: &Gate, context: &mut State) -> bool reaches Kernel blocks invokes Kernel {
    let index: u64 [0..=64] = next(context, context.presentation_work.release_index);
    transition index < 64u64 {
        true -> block released(gate, context, index)
        _ -> (true)
    }
    machine released(gate: &Gate, context: &mut State, index: u64 [0..=63]) -> bool reaches Kernel {
        let handle: u64 = context.presentation_work.releases[index];
        context.presentation_work.releases[index] = 0u64;
        context.presentation_work.release_index = index + 1u64;
        block presentation::release(gate, handle);
        next(context, context.presentation_work.release_index) == 64u64
    }
}
machine next(context: &State, index: u64 [0..=64]) -> u64 [0..=64] {
    transition index < 64u64 {
        true -> checked(context, index)
        _ -> (64u64)
    }
    machine checked(context: &State, index: u64 [0..=63]) -> u64 [0..=64] {
        transition context.presentation_work.releases[index] != 0u64 {
            true -> (index)
            _ -> next(context, index + 1u64)
        }
    }
}
public machine drain(gate: &Gate, context: &mut State) reaches Kernel blocks invokes Kernel {
    let complete: bool = block step(gate, context);
    transition complete { true -> done() _ -> block drain(gate, context) }
}
machine done() {}
