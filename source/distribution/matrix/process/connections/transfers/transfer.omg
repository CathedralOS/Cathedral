module transfers::transfer;
// One scene writer at a time. Input and service acquisition remain independent;
// image and transaction continuations share the parent receiver and reply outbox.
use shared::state::State;
use shared::presentation::Transfer;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::server::deferred;
use world::level;
use transfers::forwarded;
use transfers::transaction;
use transfers::backing;
use transfers::maintenance;
use shared::presentation::Maintenance;
use presentation;

public machine step(gate: &Gate, context: &mut State) reaches Kernel blocks invokes Kernel {
    let child: bool = context.presentation_work.active && context.presentation_work.maintenance == Maintenance::None;
    block advance(gate, context);
    transition child && !context.presentation_work.active { true -> maintenance::pointer(context) _ -> done() }
}
machine advance(gate: &Gate, context: &mut State) reaches Kernel {
    transition context.presentation_work.maintenance != Maintenance::None {
        true -> block maintenance::step(gate, context)
        _ -> block publication(gate, context)
    }
}
machine publication(gate: &Gate, context: &mut State) reaches Kernel {
    transition context.presentation_work.batch {
        true -> block transaction::step(gate, context)
        _ -> block forwarded::step(gate, context)
    }
}
public machine current(context: &State) -> bool {
    deferred::matches(&context.slots[context.presentation_work.slot].listener, context.presentation_work.ticket)
        && !context.retire_after_present[context.presentation_work.slot]
        && level::binding_matches(&context.world, context.presentation_work.slot, context.presentation_work.ticket.incarnation,
            context.presentation_work.frame.payload[1])
        && context.world.parent.epoch == context.presentation_work.parent_epoch
        && (context.has_parent || context.has_scene)
}
// Shutdown abandons the link, never reuses it for another publication. Batch
// payloads remain in their slot and are released by ordinary child reclamation.
public machine discard(gate: &Gate, context: &mut State) reaches Kernel blocks invokes Kernel {
    transition context.presentation_work.active {
        true -> block abandoned(gate, context)
        _ -> done()
    }
    machine abandoned(gate: &Gate, context: &mut State) reaches Kernel {
        block backing::close(gate, context);
        block presentation::release(gate, context.presentation_work.object);
        let empty: Transfer;
        context.presentation_work = empty;
    }
}
machine done() {}
