// One scene writer at a time. Input and service acquisition remain independent;
// image and transaction continuations share the parent receiver and reply outbox.
use {shared}/state.omg as shared_state;
use {shared}/presentation.omg;
use {runtime}/kernel.omg;
use {runtime}/server/deferred.omg;
use {world}/level.omg;
use transfers/forwarded.omg;
use transfers/transaction.omg;
use transfers/retirement.omg;
use transfers/backing.omg;
use transfers/maintenance.omg;
use presentation.omg as presentation_file;

public machine step(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let child: bool = context.presentation_work.active && context.presentation_work.maintenance == |presentation|::Maintenance::None;
    block advance(gate, context);
    transition child && !context.presentation_work.active { true -> |maintenance|::pointer(context) _ -> done() }
}
machine advance(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel {
    transition context.presentation_work.operation != |presentation|::SceneOperation::Content {
        true -> done()
        _ -> block rendering(gate, context)
    }
}
machine rendering(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel {
    transition context.presentation_work.maintenance != |presentation|::Maintenance::None {
        true -> block |maintenance|::step(gate, context)
        _ -> block publication(gate, context)
    }
}
machine publication(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel {
    transition context.presentation_work.batch {
        true -> block |transaction|::step(gate, context)
        _ -> block |forwarded|::step(gate, context)
    }
}
public machine current(context: &|shared_state|::State) -> bool {
    |deferred|::matches(&context.slots[context.presentation_work.slot].listener, context.presentation_work.ticket)
        && !context.retire_after_present[context.presentation_work.slot]
        && |level|::binding_matches(&context.world, context.presentation_work.slot, context.presentation_work.ticket.incarnation,
            context.presentation_work.frame.payload[1])
        && context.world.parent.epoch == context.presentation_work.parent_epoch
        && (context.has_parent || context.has_scene)
}
// Shutdown abandons the link, never reuses it for another publication. Batch
// payloads still staged remain in their slot for child reclamation. Detached
// predecessors/discards belong to the transfer and must be drained here.
public machine discard(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.presentation_work.active {
        true -> block abandoned(gate, context)
        _ -> done()
    }
    machine abandoned(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel {
        block |backing|::close(gate, context);
        block |presentation_file|::release(gate, context.presentation_work.object);
        block |retirement|::drain(gate, context);
        let empty: |presentation|::Transfer;
        context.presentation_work = empty;
    }
}
machine done() {}
