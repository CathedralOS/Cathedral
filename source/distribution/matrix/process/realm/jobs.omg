use {runtime}/server/main.omg as server_main;
// Realm setup under the stock startup policy, which sequences each job while
// this process executes its commands. Discovery takes the parent's snapshot,
// lists the realm for a Matrix configuration, a Login and a Users folder,
// configures a workspace from the first or starts a scoped picker from the
// other two, and then marks this matrix hosted, after which the owner's
// words drive it. A nested instance discovers its realm itself once the
// parent has placed it; the owner's CONFIGURE runs the configuration job
// directly, idempotent once a workspace stands. On later turns the startup
// recovery policy replays a failed picker or background within its budget.
// Jobs run on a small stack in the State, one command per turn, so this
// matrix keeps answering its owner and children between them; a command that
// starts another job waits for that job's result. Each job keeps a setup
// record of its own: [configuration.omg](configuration.omg),
// [background.omg](background.omg) and [picker.omg](picker.omg) execute theirs.
use {protocol}/main.omg;
use {protocol}/matrix.omg;
use {shared}/state.omg as shared_state;
use {policy}/children/startup/realm/operations.omg;
use {runtime}/kernel.omg;
use {policy}/children/startup/realm/main.omg as realm_main;
use {policy}/children/startup/main.omg as startup_main;
use {world}/geometry.omg;
use {connections}/upstream.omg;
use {children}/forward.omg;
use {children}/lifecycle.omg;
use {connections}/storage/storage.omg;
use {connections}/listing.omg;
use realm_names.omg;
use configuration.omg;
use background.omg;
use picker.omg;
use {shared}/report.omg;

// The jobs a frame runs.
public const DISCOVERY: u64 = 1u64;
public const CONFIGURATION: u64 = 2u64;
public const BACKGROUND: u64 = 3u64;
public const PICKER: u64 = 4u64;
// What one command did: finished with a completion, or started a nested job
// whose result becomes the command's.
public data Step [copy] {
    case Done(completion: |operations|::Completion);
    case Nested(job: u64);
}

// One turn advances the innermost job by one command. With none running, an
// owner's CONFIGURE that waited for the jobs ahead of it starts; otherwise a
// nested instance not yet hosted starts discovery, as pending startup
// recovery does.
public machine step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    // A new child accepts owner control, then connects to its supplied broker.
    // Keep serving those handshakes before the next realm command can wait on
    // upstream storage or background loading. No deadline is restarted here.
    transition context.presentation_work.active || context.owner_launch.phase != 0u64 || |lifecycle|::starting(context) {
        true -> (0u64)
        _ -> block idle_step(gate, context, now)
    }
}
machine idle_step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let pending: bool = context.startup.picker_pending || context.startup.background_pending;
    let unhosted: bool = context.has_parent && !context.hosted;
    transition {
        context.frame_count != 0u64 -> block advance(gate, context, now)
        context.configure_queued -> block queued(gate, context)
        unhosted || pending -> (discovering(context))
        _ -> (0u64)
    }
    machine discovering(context: &mut |shared_state|::State) -> u64 {
        let started: bool = push(context, DISCOVERY);
        0u64
    }
    machine queued(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> u64 reaches |kernel|::Kernel {
        context.configure_queued = false;
        block owned(gate, context)
    }
}
// The owner's CONFIGURE: its reply waits with its job over later turns, and
// behind jobs already running it waits for them first.
public machine configure(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    context.configure_ticket = |server_main|::ticket(&context.owner);
    transition context.frame_count != 0u64 {
        true -> (behind(context))
        _ -> block owned(gate, context)
    }
    machine behind(context: &mut |shared_state|::State) -> u64 {
        context.configure_queued = true;
        0u64
    }
}
machine owned(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> u64 reaches |kernel|::Kernel {
    let started: bool = push(context, CONFIGURATION);
    transition started {
        true -> (held(context))
        _ -> block answer(gate, context, |kernel|::BUSY)
    }
    machine held(context: &mut |shared_state|::State) -> u64 {
        context.configure_held = true;
        0u64
    }
}
machine answer(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) -> u64 reaches |kernel|::Kernel {
    context.configure_held = false;
    let mut words: [u64; 8];
    words[0] = status;
    let issued: |server_main|::Ticket = context.configure_ticket;
    let replied: u64 = block |server_main|::reply_to(gate, &mut context.owner, issued, &words);
    0u64
}
// Begin a job on a fresh frame above the others.
machine push(context: &mut |shared_state|::State, job: u64) -> bool {
    transition context.frame_count < 3u64 {
        true -> fresh(context, job, context.frame_count)
        _ -> (false)
    }
    machine fresh(context: &mut |shared_state|::State, job: u64, index: u64 [0..=2]) -> bool {
        let empty: |shared_state|::Frame;
        context.frames[index] = empty;
        context.frames[index].job = job;
        let facts: |operations|::Context = facts_for(context, job);
        let admissible: bool = job != PICKER || (context.picker_object != 0u64 && context.users_object != 0u64);
        let started: bool = |realm_main|::begin(&mut context.frames[index].setup, kind_of(job), &facts);
        transition started && admissible {
            true -> counted(context, index)
            _ -> (false)
        }
    }
    machine counted(context: &mut |shared_state|::State, index: u64 [0..=2]) -> bool {
        context.frame_count = index + 1u64;
        true
    }
}
machine facts_for(context: &|shared_state|::State, job: u64) -> |operations|::Context {
    transition {
        job == DISCOVERY -> (|operations|::Context { configured: false, busy: false, discover: context.has_parent && !context.hosted })
        job == CONFIGURATION -> (|operations|::Context { configured: context.desktop, busy: occupied(context), discover: false })
        _ -> (|operations|::Context { configured: false, busy: false, discover: false })
    }
}
machine kind_of(job: u64) -> |operations|::Job {
    transition {
        job == DISCOVERY -> (|operations|::Job::Discovery)
        job == CONFIGURATION -> (|operations|::Job::Configuration)
        job == BACKGROUND -> (|operations|::Job::Background)
        _ -> (|operations|::Job::Picker)
    }
}
// The innermost frame's next command, executed by the job it belongs to.
machine advance(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition context.frame_count >= 1u64 && context.frame_count <= 3u64 {
        true -> block topmost(gate, context, now, context.frame_count - 1u64)
        _ -> (0u64)
    }
    machine topmost(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, top: u64 [0..=2]) -> u64 reaches |kernel|::Kernel {
        let dispatch: |operations|::Dispatch = |realm_main|::next(&mut context.frames[top].setup);
        transition dispatch {
            |operations|::Dispatch::Issue { command } -> block issued(gate, context, now, top, command)
            |operations|::Dispatch::Wait -> block finished(gate, context, top, status_of(context.frames[top].setup.outcome))
        }
    }
    machine issued(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, top: u64 [0..=2], command: |operations|::Command) -> u64 reaches |kernel|::Kernel {
        let job: u64 = context.frames[top].job;
        let step: Step = block execute_for(gate, context, now, job, command);
        transition step {
            Step::Done { completion } -> block completed_step(gate, context, top, command, completion)
            Step::Nested { job } -> block nested(gate, context, top, command, job)
        }
    }
    machine nested(gate: &|kernel|::Gate, context: &mut |shared_state|::State, top: u64 [0..=2], command: |operations|::Command, job: u64) -> u64 reaches |kernel|::Kernel {
        context.frames[top].waiting = true;
        context.frames[top].command = command;
        let started: bool = push(context, job);
        transition started {
            true -> (0u64)
            _ -> block unstarted(gate, context, top, command)
        }
    }
    machine unstarted(gate: &|kernel|::Gate, context: &mut |shared_state|::State, top: u64 [0..=2], command: |operations|::Command) -> u64 reaches |kernel|::Kernel {
        context.frames[top].waiting = false;
        block completed_step(gate, context, top, command, completed(command, |kernel|::BUSY))
    }
}
machine execute_for(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, job: u64, command: |operations|::Command) -> Step reaches |kernel|::Kernel {
    transition {
        job == DISCOVERY -> block execute(gate, context, now, command)
        job == CONFIGURATION -> block |configuration|::execute(gate, context, now, command)
        job == BACKGROUND -> block |background|::execute(gate, context, now, command)
        _ -> block |picker|::execute(gate, context, now, command)
    }
}
// The policy takes the command's completion; a refused completion or the
// job's last command ends the frame.
machine completed_step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, top: u64 [0..=2], command: |operations|::Command, completion: |operations|::Completion) -> u64 reaches |kernel|::Kernel {
    let accepted: bool = |realm_main|::complete(&mut context.frames[top].setup, completion);
    transition {
        !accepted -> block finished(gate, context, top, |kernel|::IO_ERROR)
        command == |operations|::Command::Finish -> block finished(gate, context, top, status_of(context.frames[top].setup.outcome))
        _ -> (0u64)
    }
}
// A job's end: its result answers the command waiting on it, or the owner's
// CONFIGURE that started it. A background retried by recovery is not that
// recovery's failure.
machine finished(gate: &|kernel|::Gate, context: &mut |shared_state|::State, top: u64 [0..=2], status: u64) -> u64 reaches |kernel|::Kernel {
    let job: u64 = context.frames[top].job;
    context.frame_count = top;
    transition {
        top >= 1u64 -> block resumed(gate, context, top - 1u64, job, status)
        context.configure_held -> block answer(gate, context, status)
        _ -> (0u64)
    }
    machine resumed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, parent: u64 [0..=2], job: u64, status: u64) -> u64 reaches |kernel|::Kernel {
        let command: |operations|::Command = context.frames[parent].command;
        context.frames[parent].waiting = false;
        let recovered: bool = command == |operations|::Command::RecoverStartup && job == BACKGROUND;
        transition recovered {
            true -> block completed_step(gate, context, parent, command, completed(command, 0u64))
            _ -> block completed_step(gate, context, parent, command, completed(command, status))
        }
    }
}
machine execute(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, command: |operations|::Command) -> Step reaches |kernel|::Kernel {
    transition command {
        |operations|::Command::ConfigureRealm -> (Step::Nested { job: CONFIGURATION })
        |operations|::Command::StartPicker -> (Step::Nested { job: PICKER })
        |operations|::Command::RecoverStartup -> (recovered(gate, context))
        _ -> block done_with(gate, context, now, command)
    }
    machine done_with(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, command: |operations|::Command) -> Step reaches |kernel|::Kernel {
        let completion: |operations|::Completion = block run_command(gate, context, now, command);
        Step::Done { completion: completion }
    }
}
machine run_command(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, command: |operations|::Command) -> |operations|::Completion reaches |kernel|::Kernel {
    transition command {
        |operations|::Command::Refresh -> block refreshed(gate, context, now)
        |operations|::Command::InspectRealm -> block inspected(gate, context, now)
        |operations|::Command::MarkHosted -> (hosted(context))
        _ -> (completed(command, 0u64))
    }
}
// Take the parent's snapshot; a view it has not granted yet retries next turn.
machine refreshed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let status: u64 = block |upstream|::refresh(gate, context, now);
    let placed: bool = |geometry|::valid_grant(context.world.parent);
    |operations|::Completion { command: |operations|::Command::Refresh, outcome: outcome_of(status), placed: placed, entries: no_entries() }
}
// What the realm holds: refused when this matrix has no binding of its own,
// which leaves setup to the owner.
machine inspected(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let status: u64 = block |storage|::learn(gate, context, now);
    transition status == 0u64 {
        true -> block looking(gate, context, now)
        _ -> (completed(|operations|::Command::InspectRealm, status))
    }
}
machine looking(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> |operations|::Completion reaches |kernel|::Kernel {
    let parent: u64 = |listing|::realm(context);
    let matrix_name: [u64; 4] = |realm_names|::matrix();
    let matrix: u64 = block |listing|::find(gate, context, now, parent, &matrix_name);
    let login_name: [u64; 4] = |realm_names|::login();
    let login: u64 = block |listing|::find(gate, context, now, parent, &login_name);
    let users_name: [u64; 4] = |realm_names|::users();
    let users: u64 = block |listing|::find(gate, context, now, parent, &users_name);
    context.config_object = matrix;
    context.picker_object = login;
    context.users_object = users;
    |operations|::Completion { command: |operations|::Command::InspectRealm, outcome: |operations|::Outcome::Success, placed: false,
        entries: |operations|::Entries { matrix: matrix != 0u64, login: login != 0u64, users: users != 0u64 } }
}
machine hosted(context: &mut |shared_state|::State) -> |operations|::Completion {
    context.hosted = true;
    completed(|operations|::Command::MarkHosted, 0u64)
}
// Pending recovery work within the policy's budget, one job per command: a
// picker to restart, else a background to retry; a turn with a routed word in
// flight keeps it pending, and what remains runs on a later turn.
machine recovered(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> Step reaches |kernel|::Kernel invokes |kernel|::Kernel {
    let blocked: bool = |forward|::busy(context);
    let action: |startup_main|::PickerAction = |startup_main|::take_picker(&mut context.startup, blocked);
    transition action {
        |startup_main|::PickerAction::Wait -> (background_retry(context, blocked))
        |startup_main|::PickerAction::Restart -> (restarting(gate))
        |startup_main|::PickerAction::Exhausted -> (exhausted(gate))
    }
    machine restarting(gate: &|kernel|::Gate) -> Step reaches |kernel|::Kernel {
        |report|::picker_restored(gate);
        Step::Nested { job: PICKER }
    }
    // The owner sees a failed nested desktop; another launch is an explicit attempt.
    machine exhausted(gate: &|kernel|::Gate) -> Step reaches |kernel|::Kernel {
        |report|::picker_exhausted(gate);
        Step::Done { completion: completed(|operations|::Command::RecoverStartup, |kernel|::IO_ERROR) }
    }
    machine background_retry(context: &mut |shared_state|::State, blocked: bool) -> Step {
        let retry: bool = |startup_main|::take_background(&mut context.startup, blocked);
        transition retry {
            true -> (Step::Nested { job: BACKGROUND })
            _ -> (Step::Done { completion: completed(|operations|::Command::RecoverStartup, 0u64) })
        }
    }
}
// A completion that reports only a status.
public machine completed(command: |operations|::Command, status: u64) -> |operations|::Completion {
    |operations|::Completion { command: command, outcome: outcome_of(status), placed: false, entries: no_entries() }
}
public machine no_entries() -> |operations|::Entries {
    |operations|::Entries { matrix: false, login: false, users: false }
}
public machine outcome_of(status: u64) -> |operations|::Outcome {
    transition {
        status == 0u64 -> (|operations|::Outcome::Success)
        status == |kernel|::BUSY -> (|operations|::Outcome::Busy)
        status == |kernel|::DENIED -> (|operations|::Outcome::Denied)
        status == |kernel|::PEER_CLOSED -> (|operations|::Outcome::PeerClosed)
        _ -> (|operations|::Outcome::Failed { status: status })
    }
}
public machine status_of(outcome: |operations|::Outcome) -> u64 {
    transition outcome {
        |operations|::Outcome::Success -> (0u64)
        |operations|::Outcome::Busy -> (|kernel|::BUSY)
        |operations|::Outcome::Denied -> (|kernel|::DENIED)
        |operations|::Outcome::PeerClosed -> (|kernel|::PEER_CLOSED)
        |operations|::Outcome::Failed { status } -> (status)
    }
}
// Whether any slot holds a child.
public machine occupied(context: &|shared_state|::State) -> bool {
    context.slots[0].live || context.slots[1].live || context.slots[2].live || context.slots[3].live || context.slots[4].live
}
// A program's first argument: its object above the role it was launched in.
public machine launch_argument(role: u64, object: u64) -> u64 {
    (((object as u64 in Wrapping) << 8u64) as u64) | (role & 255u64)
}
