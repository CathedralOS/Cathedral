use {policy}/children/launch/resources/funding.omg as resources_funding;
use {runtime}/server/main.omg as server_main;
use {runtime}/task/main.omg as task_main;
// Owner launches and admission from a sealed executable. RUN_OBJECT resumes
// in owner_launch/owner_launch.omg; child requests in launch/launch.omg.
// Both enter admit_plan here; startup uses admit_image. Declaration, capacity,
// reservation and binding have rollback before placement publishes the child.
use {protocol}/main.omg;
use {protocol}/matrix.omg;
use {protocol}/services.omg;
use {shared}/state.omg as shared_state;
use {runtime}/kernel.omg;
use {runtime}/connection/main.omg as connection_main;
use {world}/geometry.omg;
use {policy}/children/launch/resources/main.omg as resources_main;
use {connections}/storage/storage.omg;
use lifecycle.omg;
use construction/construction.omg;
use {shared}/report.omg;
use funding.omg;
use {shared}/admission.omg;
use launch/resources.omg;
use launch/authority.omg;
use owner_launch/owner_launch.omg;

public machine owner_word(op: u64) -> bool {
    op == |matrix|::RUN_OBJECT || op == |matrix|::LAUNCH_IMPORTS
}
public machine owner(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition {
        frame.payload[0] == |matrix|::RUN_OBJECT && context.launch.phase != 0u64 -> block reply(gate, context, error(|kernel|::BUSY))
        frame.payload[1] < 5u64 -> block slotted(gate, context, now, frame, frame.payload[1])
        _ -> block reply(gate, context, error(|kernel|::DENIED))
    }
    machine slotted(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, frame: |connection_main|::Frame, slot: u64 [0..=4]) -> u64 reaches |kernel|::Kernel {
        transition {
            frame.payload[0] == |matrix|::LAUNCH_IMPORTS && |geometry|::zeros_from(&frame.payload, 3u64) -> block imported(gate, context, slot, frame.payload[2])
            frame.payload[0] == |matrix|::RUN_OBJECT -> block running(gate, context, now, slot, frame)
            _ -> block reply(gate, context, error(|kernel|::DENIED))
        }
    }
    // The services a later launch into this slot is offered; callers may only
    // withhold from them.
    machine imported(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], mask: u64) -> u64 reaches |kernel|::Kernel {
        |authority|::policy_changed(context, slot);
        context.policies[slot].imports = mask;
        context.policies[slot].imports_set = true;
        block reply(gate, context, ok())
    }
    // [RUN_OBJECT, slot, object, scope, argument, channels, descendants, cpu]
    machine running(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
        let status: u64 = |owner_launch|::begin(gate, context, slot, frame);
        transition status == 0u64 { true -> (0u64) _ -> block reply(gate, context, error(status)) }
    }
}
// Admit a child from a sealed image this matrix holds: resolve its
// declaration, fit it to the allowances with the stock resource policy (an
// app in a desktop takes the desktop's share), reserve it, admit it, and
// bind its storage to `subtree` when `bound`. The image stays the caller's
// to release; the services granted and the surfaces allotted stay readable
// afterwards. Every failed step releases anything reserved behind it.
public machine admit_image(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], image: u64, length: u64, subtree: u64, argument: u64,
    channels: u64, descendants: u64, cpu: u64, private_pages: u64, reader_pages: u64, frames: u64, offered: u64, desktop_app: bool, bound: bool) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    context.last_granted = 0u64;
    context.allotted_surfaces = 0u64;
    transition !context.retire_after_present[slot] && !context.slots[slot].live && context.slots[slot].pending == 0u64 && descendants < 64u64 && image != 0u64
        && !(context.launch.phase != 0u64 && context.launch.slot == slot) {
        true -> block declared(gate, context, now, slot, subtree, argument, channels, descendants, cpu, image, length, private_pages, reader_pages,
            frames, offered, desktop_app, bound)
        _ -> (|kernel|::BUSY)
    }
    machine declared(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64, argument: u64, channels: u64,
        descendants: u64, cpu: u64, image: u64, length: u64, private_pages: u64, reader_pages: u64, frames: u64,
        offered: u64, desktop_app: bool, bound: bool) -> u64 reaches |kernel|::Kernel {
        let capacity: |resources_main|::Capacity = |resources_main|::Capacity { private_pages: private_pages, reader_pages: reader_pages, channels: channels, descendants: descendants };
        let plan: |admission|::Plan = block |resources|::prepare(gate, image, length, offered, capacity, frames, desktop_app);
        transition plan.status == 0u64 {
            true -> block funded(gate, context, now, slot, subtree, argument, cpu, image, plan, bound)
            _ -> (failed_stage(gate, slot, plan.stage, plan.status))
        }
    }
    machine funded(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64, argument: u64,
        cpu: u64, image: u64, plan: |admission|::Plan, bound: bool) -> u64 reaches |kernel|::Kernel {
        let status: u64 = block |funding|::ensure(gate, context, now, |resources|::needed(plan));
        transition status == 0u64 {
            true -> block admit_plan(gate, context, now, slot, subtree, argument, cpu, image, plan, bound, false)
            _ -> (failed_stage(gate, slot, 7u64, status))
        }
    }
}
// The caller retained the image and obtained funding. Install the plan only at
// admission, so intervening owner work cannot overwrite its resource choices.
public machine admit_plan(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64, argument: u64,
    cpu: u64, image: u64, plan: |admission|::Plan, bound: bool, deferred: bool) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition plan.status == 0u64 && !context.retire_after_present[slot] && !context.slots[slot].live && context.slots[slot].pending == 0u64 && image != 0u64
        && !(deferred && bound) {
        true -> block prepared(gate, context, now, slot, subtree, argument, cpu, image, plan, bound, deferred)
        _ -> (|kernel|::DENIED)
    }
    machine prepared(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64, argument: u64,
        cpu: u64, image: u64, plan: |admission|::Plan, bound: bool, deferred: bool) -> u64 reaches |kernel|::Kernel {
        context.last_granted = 0u64;
        context.allotted_surfaces = plan.surfaces;
        context.allotted_descendants = plan.descendants;
        context.allotted_profiled = plan.profiled;
        block imaging(gate, context, now, slot, subtree, argument, cpu, image, plan, plan.private_pages, plan.reader_pages,
            plan.channels, plan.descendants, plan.frames, bound, deferred)
    }
    machine imaging(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64, argument: u64, cpu: u64, image: u64,
        found: |admission|::Plan, private_pages: u64, reader_pages: u64, channels: u64, descendants: u64, frames: u64, bound: bool, deferred: bool) -> u64
        reaches |kernel|::Kernel {
        let executable: u64 = |task_main|::image_from_object(gate, image, 0u64);
        context.funding[slot] = |resources_funding|::policy([private_pages, reader_pages, channels, descendants, frames]);
        transition executable < |kernel|::ERROR_BASE {
            true -> block reserved(gate, context, now, slot, subtree, argument, cpu, found, executable,
                |task_main|::reserve(gate, executable, private_pages, reader_pages, channels, descendants, |kernel|::MAX_ADMISSION_FRAMES, frames),
                bound, deferred)
            _ -> (failed_stage(gate, slot, 3u64, executable))
        }
    }
    // A reservation consumes the image grant; a refused one leaves it to release.
    machine reserved(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64, argument: u64, cpu: u64,
        found: |admission|::Plan, executable: u64, launch: u64, bound: bool, deferred: bool) -> u64 reaches |kernel|::Kernel {
        transition launch < |kernel|::ERROR_BASE {
            true -> block admitting(gate, context, now, slot, subtree, argument, cpu, found, launch, bound, deferred)
            _ -> (unreserved(gate, slot, executable, launch))
        }
    }
    machine unreserved(gate: &|kernel|::Gate, slot: u64 [0..=4], executable: u64, status: u64) -> u64 reaches |kernel|::Kernel {
        let ignored: u64 = |task_main|::image_release(gate, executable);
        failed_stage(gate, slot, 4u64, status)
    }
    // The kernel keeps its own reference to the code once it is reserved.
    machine admitting(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64, argument: u64, cpu: u64,
        found: |admission|::Plan, launch: u64, bound: bool, deferred: bool) -> u64 reaches |kernel|::Kernel {
        let granted: u64 = found.mask & (|services|::INTERACTION | |services|::STORAGE);
        let images: u64 = context.policies[slot].images;
        let status: u64 = block |construction|::start_reserved(gate, context, slot, launch, argument, images, cpu, granted, deferred);
        context.last_granted = granted;
        admitted_budget(gate, slot, status, deferred);
        transition {
            status != 0u64 -> (failed_stage(gate, slot, 5u64, status))
            bound && (granted & |services|::STORAGE) != 0u64 -> block binding(gate, context, now, slot, subtree)
            _ -> (0u64)
        }
    }
    // A launched child's storage is bound to the realm the owner named; a
    // binding that cannot be made takes the child back down.
    machine binding(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, slot: u64 [0..=4], subtree: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = block |storage|::bind(gate, context, now, slot, 0u64, subtree);
        transition status == 0u64 {
            true -> (0u64)
            _ -> block unbound(gate, context, slot, status)
        }
    }
    machine unbound(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], status: u64) -> u64 reaches |kernel|::Kernel {
        block |lifecycle|::reclaim(gate, context, slot);
        failed_stage(gate, slot, 6u64, status)
    }
}
// What the matrix itself uses once a child stands, for the lab to size manifests by.
machine admitted_budget(gate: &|kernel|::Gate, slot: u64, status: u64, deferred: bool) reaches |kernel|::Kernel invokes |kernel|::Kernel {
    transition status == 0u64 && !deferred { true -> reported(gate, slot) _ -> idle() }
    machine reported(gate: &|kernel|::Gate, slot: u64) reaches |kernel|::Kernel {
        |report|::launch_stage(gate, slot, 0u64, 0u64);
        |report|::budget(gate);
    }
}
machine idle() {}
// A failed stage goes to the console, where a proof can read where and why.
machine failed_stage(gate: &|kernel|::Gate, slot: u64, stage: u64, code: u64) -> u64 reaches |kernel|::Kernel invokes |kernel|::Kernel {
    |report|::launch_stage(gate, slot, stage, code);
    code
}
machine reply(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    block |server_main|::reply(gate, &mut context.owner, &words)
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
machine ok() -> [u64; 8] {
    let words: [u64; 8];
    words
}
machine done() {}
