// Publish a proposal or restore the old scene after a late COMMIT cancellation.
// Empty draws preserve upstream names until local acceptance; releasing names
// here would make restoration impossible. Transport custody stays in backing.
use {shared}/state.omg as shared_state;
use {shared}/presentation.omg;
use {runtime}/kernel.omg;
use {protocol}/matrix.omg;
use {world}/surfaces.omg;
use {world}/layout.omg;
use {world}/level.omg;
use {world}/geometry.omg;
use {connections}/transfers/backing.omg;
use {connections}/presentation.omg as connections_presentation;
use arrangement/arrangement.omg;

public machine receive(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition |backing|::ready(context) { true -> block received(gate, context) _ -> done() }
    machine received(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel {
        let status: u64 = |backing|::take(context);
        context.presentation_work.submitted = false;
        block answered(gate, context, status);
    }
}
machine answered(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) reaches |kernel|::Kernel {
    transition context.presentation_work.phase {
        |presentation|::Phase::Begin -> block begun(gate, context, status)
        |presentation|::Phase::Entry -> entry(context, status)
        |presentation|::Phase::Commit -> committed(gate, context, status)
        |presentation|::Phase::Abort -> block aborted(gate, context, status)
        _ -> block lost(gate, context, |kernel|::IO_ERROR)
    }
    machine begun(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) reaches |kernel|::Kernel {
        transition {
            status == 0u64 -> entering(context)
            context.arrangement_work.restoring -> block lost(gate, context, status)
            _ -> completed(context, status)
        }
    }
    machine entering(context: &mut |shared_state|::State) { context.presentation_work.phase = |presentation|::Phase::Entry; }
    machine entry(context: &mut |shared_state|::State, status: u64) {
        transition status == 0u64 && context.arrangement_work.rank < 320u64 {
            true -> advanced(context)
            _ -> aborting(context, status)
        }
    }
    machine advanced(context: &mut |shared_state|::State) requires context.arrangement_work.rank < 320u64 {
        context.arrangement_work.rank = context.arrangement_work.rank + 1u64;
    }
    machine committed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) reaches |kernel|::Kernel {
        transition {
            status != 0u64 -> aborting(context, status)
            context.arrangement_work.restoring -> restored(context)
            |arrangement|::current(context) -> completed(context, 0u64)
            context.world.parent.epoch != context.presentation_work.parent_epoch -> completed(context, |kernel|::DENIED)
            _ -> restoring(context)
        }
    }
    machine restored(context: &mut |shared_state|::State) {
        completed(context, |kernel|::DENIED);
    }
    machine restoring(context: &mut |shared_state|::State) {
        context.revision = ((context.revision as u64 in Wrapping) + 1u64) as u64;
        context.presentation_work.upstream_revision = context.revision;
        context.presentation_work.phase = |presentation|::Phase::Begin;
        context.arrangement_work.rank = 0u64;
        context.arrangement_work.restoring = true;
    }
}
machine aborted(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) reaches |kernel|::Kernel {
    transition {
        context.world.parent.epoch != context.presentation_work.parent_epoch -> completed(context, |kernel|::DENIED)
        status == 0u64 && !context.arrangement_work.restoring -> completed(context, context.presentation_work.status)
        _ -> block lost(gate, context, |kernel|::IO_ERROR)
    }
}
public machine invalidated(context: &mut |shared_state|::State) {
    transition context.presentation_work.phase == |presentation|::Phase::Begin {
        true -> completed(context, |kernel|::DENIED)
        _ -> aborting(context, |kernel|::DENIED)
    }
}
public machine entries(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let rank: u64 = context.arrangement_work.rank;
    transition rank < 320u64 {
        true -> block previewed(gate, context, rank)
        _ -> block committing(gate, context)
    }
    machine previewed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, rank: u64 [0..=319]) reaches |kernel|::Kernel {
        let retained: |surfaces|::Retained = preview(context, rank);
        transition retained {
            |surfaces|::Retained::Packet { words } -> block sending(gate, context, words)
            |surfaces|::Retained::Nothing -> block skipped(gate, context, rank)
        }
    }
    machine sending(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8]) reaches |kernel|::Kernel {
        let object: u64 = |connections_presentation|::retained_image(context, words);
        block submit(gate, context, words, object);
    }
    machine skipped(gate: &|kernel|::Gate, context: &mut |shared_state|::State, rank: u64 [0..=319]) reaches |kernel|::Kernel {
        context.arrangement_work.rank = rank + 1u64;
        transition { _ -> block entries(gate, context) }
    }
    machine committing(gate: &|kernel|::Gate, context: &mut |shared_state|::State) reaches |kernel|::Kernel {
        context.presentation_work.phase = |presentation|::Phase::Commit;
        block control(gate, context, |matrix|::PRESENT_COMMIT);
    }
}
machine preview(context: &|shared_state|::State, rank: u64 [0..=319]) -> |surfaces|::Retained {
    |layout|::layout::preview(&context.world, &context.arrangement_work.proposal, rank / 64u64, rank % 64u64, context.arrangement_work.restoring)
}
public machine control(gate: &|kernel|::Gate, context: &mut |shared_state|::State, op: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let words: [u64; 8] = [op,context.presentation_work.parent_epoch,context.presentation_work.upstream_revision,0u64,0u64,0u64,0u64,0u64];
    block submit(gate, context, words, 0u64);
}
machine submit(gate: &|kernel|::Gate, context: &mut |shared_state|::State, words: [u64; 8], object: u64) reaches |kernel|::Kernel {
    let status: u64 = block |backing|::submit(gate, context, words, object);
    transition {
        status == 0u64 -> submitted(context)
        status == |kernel|::WOULD_BLOCK -> done()
        _ -> block lost(gate, context, status)
    }
    machine submitted(context: &mut |shared_state|::State) { context.presentation_work.submitted = true; }
}
machine lost(gate: &|kernel|::Gate, context: &mut |shared_state|::State, status: u64) reaches |kernel|::Kernel {
    block |backing|::close(gate, context);
    |level|::inherit(&mut context.world, |geometry|::no_grant());
    completed(context, status);
}
machine aborting(context: &mut |shared_state|::State, status: u64) { context.presentation_work.status = status; context.presentation_work.phase = |presentation|::Phase::Abort; }
machine completed(context: &mut |shared_state|::State, status: u64) {
    // A terminal result can also abandon a submitted request on a lost transport.
    // No reply remains to receive before finishing the arrangement.
    context.presentation_work.submitted = false;
    context.presentation_work.status = status;
    context.presentation_work.phase = |presentation|::Phase::Finished;
}
machine done() {}
