module lifecycle;
// Children this matrix funds and admits itself. RUN_PAGES and RUN_MEMORY stage
// the next launch's allowances for a slot; RUN reserves a launch for an image
// from the owner's catalogue under those allowances, admits the child through
// the runtime's brokered admission with interaction, and the child's listener
// serves it from then on. STOP reclaims the whole subtree and returns the
// reservation. Launches from the realm's objects, storage grants and the stock
// launch policy arrive in later slices.
use protocol::main;
use protocol::matrix;
use protocol::services::INTERACTION;
use protocol::services::STORAGE;
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::connection::main::Frame;
use runtime::connection::main::Peer;
use runtime::task::main::Exit;
use runtime::time::Tick;
use runtime::waiting::Set;
use world::level;
use world::launches;
use world::geometry::zeros_from;
use connections::storage::storage;
use connections::presentation;
use recovery;
use shared::report;
use workspace;
use policy::children::launch::resources::funding::Funding;

// How long a child has to complete each startup handshake, as the Rust host allows.
public const HANDSHAKE_TICKS: u64 = 300u64;
// The frames the stock host funds per descendant slot and the least it funds
// a load: below the kernel's bootstrap allowance per slot, so a funder keeps
// its own frames beside what it lends.
public const SLOT_FRAMES: u64 = 256u64;
// The page tables that map a load, as the kernel's admission ceiling counts them.
public const TABLE_FRAMES: u64 = 48u64;
public const MAX_IMAGES: u64 = 14u64;

public machine owner_word(op: u64) -> bool {
    op == RUN_PAGES || op == RUN_MEMORY || op == RUN || op == STOP
}
public machine owner(gate: &Gate, context: &mut State, now: u64, frame: Frame) -> u64 reaches Kernel blocks invokes Kernel {
    transition frame.payload[1] < 5u64 {
        true -> block slotted(gate, context, now, frame, frame.payload[1])
        _ -> block reply(gate, context, error(kernel::DENIED))
    }
    machine slotted(gate: &Gate, context: &mut State, now: u64, frame: Frame, slot: u64 [0..=4]) -> u64 reaches Kernel {
        transition {
            frame.payload[0] == RUN_PAGES && zeros_from(&frame.payload, 4u64) -> block paged(gate, context, slot, frame.payload[2], frame.payload[3])
            frame.payload[0] == RUN_MEMORY && zeros_from(&frame.payload, 3u64) -> block funded(gate, context, slot, frame.payload[2])
            frame.payload[0] == RUN && frame.payload[5] < 16384u64 && frame.payload[4] < 64u64 -> block running(gate, context, now, slot, frame)
            frame.payload[0] == STOP && zeros_from(&frame.payload, 2u64) -> block stopping(gate, context, slot)
            _ -> block reply(gate, context, error(kernel::DENIED))
        }
    }
    // Allowances for the next launch into this slot.
    machine paged(gate: &Gate, context: &mut State, slot: u64 [0..=4], private_pages: u64, reader_pages: u64) -> u64 reaches Kernel {
        context.staged_private[slot] = private_pages;
        context.staged_reader[slot] = reader_pages;
        block reply(gate, context, ok())
    }
    machine funded(gate: &Gate, context: &mut State, slot: u64 [0..=4], frames: u64) -> u64 reaches Kernel {
        context.staged_frames[slot] = frames;
        block reply(gate, context, ok())
    }
    machine running(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], frame: Frame) -> u64 reaches Kernel {
        let status: u64 = block run(gate, context, now, slot, frame.payload[2], frame.payload[3], frame.payload[4],
            frame.payload[5], frame.payload[6], frame.payload[7]);
        block reply(gate, context, error(status))
    }
    machine stopping(gate: &Gate, context: &mut State, slot: u64 [0..=4]) -> u64 reaches Kernel {
        transition context.slots[slot].live {
            true -> block stopped(gate, context, slot)
            _ -> block reply(gate, context, error(kernel::PEER_CLOSED))
        }
    }
    machine stopped(gate: &Gate, context: &mut State, slot: u64 [0..=4]) -> u64 reaches Kernel {
        block reclaim(gate, context, slot);
        block reply(gate, context, ok())
    }
}
// Reserve and admit: the image grant from the owner's catalogue, the staged
// allowances (physical frames default to the load plus the private pages, or a
// whole admission allowance per descendant slot), the CPU ceiling and the
// images the child may run in turn, then the brokered admission offering
// interaction and storage, as the Rust host offers every catalogue program.
// Every failed step leaves no reservation behind.
public machine run(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], image: u64, argument: u64, channels: u64,
    descendants: u64, images: u64, cpu: u64) -> u64 reaches Kernel blocks invokes Kernel {
    transition !context.slots[slot].live && images < 16384u64 && descendants < 64u64 {
        true -> block imaged(gate, context, now, slot, image, argument, channels, descendants, images, cpu)
        _ -> (kernel::BUSY)
    }
    machine imaged(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], image: u64, argument: u64, channels: u64,
        descendants: u64, images: u64, cpu: u64) -> u64 reaches Kernel requires images < 16384u64 && descendants < 64u64 {
        let executable: u64 = runtime::task::main::image_at(gate, image);
        transition executable < kernel::ERROR_BASE {
            true -> block reserving(gate, context, now, slot, executable, argument, channels, descendants, images, cpu)
            _ -> (executable)
        }
    }
    machine reserving(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], executable: u64, argument: u64, channels: u64,
        descendants: u64, images: u64, cpu: u64) -> u64 reaches Kernel requires images < 16384u64 && descendants < 64u64 {
        let private_pages: u64 = context.staged_private[slot];
        let reader_pages: u64 = context.staged_reader[slot];
        // An image from the owner's catalogue has no size here; it is funded as one slot's load.
        let frames: u64 = physical_frames(context.staged_frames[slot], 0u64, 0u64, private_pages, descendants);
        context.staged_private[slot] = 0u64;
        context.staged_reader[slot] = 0u64;
        context.staged_frames[slot] = 0u64;
        let launch: u64 = runtime::task::main::reserve(gate, executable, private_pages, reader_pages, channels,
            descendants, kernel::MAX_ADMISSION_FRAMES, frames);
        context.funding[slot] = policy::children::launch::resources::funding::policy([private_pages, reader_pages, channels, descendants, frames]);
        transition launch < kernel::ERROR_BASE {
            true -> block limited(gate, context, now, slot, launch, argument, images, cpu)
            _ -> (launch)
        }
    }
    machine limited(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64, argument: u64, images: u64, cpu: u64) -> u64
        reaches Kernel requires images < 16384u64 {
        block admit_reserved(gate, context, now, slot, launch, argument, images, cpu, INTERACTION | STORAGE)
    }
}
// Admit a reserved launch into a slot: the CPU ceiling, the catalogue images
// the child may run in turn, the brokered admission offering `granted`, the
// owner-control client and the storage listener. A refused step returns the
// reservation.
public machine admit_reserved(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64, argument: u64, images: u64,
    cpu: u64, granted: u64) -> u64 reaches Kernel blocks invokes Kernel {
    let status: u64 = cpu_ceiling(gate, launch, cpu);
    transition status == 0u64 && images < 16384u64 {
        true -> block allowing(gate, context, now, slot, launch, argument, images, 0u64, granted)
        _ -> refused(gate, launch, status)
    }
    // Each set bit lends the child the same catalogue executable.
    machine allowing(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64, argument: u64, images: u64, index: u64,
        granted: u64) -> u64 reaches Kernel requires index <= 14u64 {
        transition index < 14u64 {
            true -> block allowed(gate, context, now, slot, launch, argument, images, index, granted)
            _ -> block admitting(gate, context, now, slot, launch, argument, granted)
        }
    }
    machine allowed(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64, argument: u64, images: u64, index: u64,
        granted: u64) -> u64 reaches Kernel requires index < 14u64 {
        transition ((images >> index) & 1u64) == 1u64 {
            true -> block lending(gate, context, now, slot, launch, argument, images, index, granted)
            _ -> block allowing(gate, context, now, slot, launch, argument, images, index + 1u64, granted)
        }
    }
    machine lending(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64, argument: u64, images: u64, index: u64,
        granted: u64) -> u64 reaches Kernel requires index < 14u64 {
        let grant: u64 = runtime::task::main::image_at(gate, index);
        let status: u64 = allow(gate, launch, grant);
        transition status == 0u64 {
            true -> block allowing(gate, context, now, slot, launch, argument, images, index + 1u64, granted)
            _ -> refused(gate, launch, status)
        }
    }
    // The handshake windows start at admission, after the reservation work above.
    machine admitting(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64, argument: u64, granted: u64) -> u64 reaches Kernel {
        let tick: Tick = runtime::time::read(gate, context.clock);
        transition tick {
            Tick::Read { value } -> block spawning(gate, context, value, slot, launch, argument, granted)
            Tick::Failed { code } -> refused(gate, launch, code)
        }
    }
    machine spawning(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64, argument: u64, granted: u64) -> u64 reaches Kernel {
        let loans: [u64; 14];
        level::disconnected(&mut context.world, slot);
        let status: u64 = block runtime::admission::main::admit(gate, &mut context.slots[slot], launch, argument,
            &loans, 0u64, granted, context.clock, HANDSHAKE_TICKS, true);
        transition status == 0u64 {
            true -> block admitted_now(gate, context, slot, launch)
            _ -> refused(gate, launch, status)
        }
    }
    // The owner-control window, like the service handshake's, starts once the child exists.
    machine admitted_now(gate: &Gate, context: &mut State, slot: u64 [0..=4], launch: u64) -> u64 reaches Kernel {
        let enabled: u64 = runtime::server::main::enable_pipeline(&mut context.slots[slot].listener);
        let tick: Tick = runtime::time::read(gate, context.clock);
        transition tick {
            Tick::Read { value } -> block controlling(gate, context, value, slot, launch)
            Tick::Failed { code } -> block uncontrolled(gate, context, slot, launch, code)
        }
    }
    // The child's owner control opens without blocking: a host with
    // descendants sets up its broker services before it accepts control, so
    // this matrix sends the hello and keeps serving, and each turn finishes
    // the handshake once the child answers, within the handshake window. The
    // connection takes custody of the kernel-installed pair either way; a
    // slot's previous occupant left its client closed, so a fresh one stands first.
    machine controlling(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64) -> u64 reaches Kernel {
        let sender: u64 = context.slots[slot].control.sender;
        let receiver: u64 = context.slots[slot].control.receiver;
        context.slots[slot].control.sender = 0u64;
        context.slots[slot].control.receiver = 0u64;
        let fresh: Peer;
        context.controls[slot] = fresh;
        let status: u64 = block runtime::connection::main::connect_start(gate, &mut context.controls[slot], sender, receiver);
        transition status == 0u64 {
            true -> block controlled(gate, context, now, slot, launch)
            _ -> block uncontrolled(gate, context, slot, launch, status)
        }
    }
    machine controlled(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64) -> u64 reaches Kernel {
        context.opening[slot] = runtime::time::after(now, HANDSHAKE_TICKS);
        block storing(gate, context, now, slot, launch)
    }
    // The child's storage connection is served from admission on, whenever it
    // chooses to acquire it; the owner or the launch binds it.
    machine storing(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], launch: u64) -> u64 reaches Kernel {
        let status: u64 = storage::listen(context, slot, now);
        transition status == 0u64 || status == kernel::INVALID_ARGUMENT {
            true -> admitted(context, slot, launch)
            _ -> block uncontrolled(gate, context, slot, launch, status)
        }
    }
    machine uncontrolled(gate: &Gate, context: &mut State, slot: u64 [0..=4], launch: u64, status: u64) -> u64 reaches Kernel {
        block storage::retire(gate, context, slot);
        let exit: Exit = block runtime::admission::main::stop(gate, &mut context.slots[slot]);
        refused(gate, launch, status)
    }
    machine admitted(context: &mut State, slot: u64 [0..=4], launch: u64) -> u64 {
        context.reservations[slot] = launch;
        0u64
    }
}
machine refused(gate: &Gate, launch: u64, status: u64) -> u64 reaches Kernel {
    let ignored: u64 = runtime::task::main::release(gate, launch);
    status
}
machine cpu_ceiling(gate: &Gate, launch: u64, cpu: u64) -> u64 reaches Kernel invokes Kernel {
    transition cpu == 0u64 {
        true -> (0u64)
        _ -> (runtime::task::main::assign_cpu(gate, launch, cpu))
    }
}
machine allow(gate: &Gate, launch: u64, grant: u64) -> u64 reaches Kernel invokes Kernel {
    transition grant < kernel::ERROR_BASE {
        true -> (runtime::task::main::allow_image(gate, launch, grant))
        _ -> (grant)
    }
}
// Backing for the load and its private pages, then one slot's frames per
// descendant slot the child may fill, unless the owner staged an amount. The
// load is the image's pages, the stack it declares and the tables that map
// them, never below one slot's frames; the kernel reserves the load itself
// under its admission ceiling.
public machine physical_frames(staged: u64, image_pages: u64, stack_pages: u64, private_pages: u64, descendants: u64) -> u64
    requires descendants < 64u64 {
    let mapped: u64 = world::geometry::plus(world::geometry::plus(image_pages, stack_pages), TABLE_FRAMES);
    let load: u64 = world::geometry::plus(larger(SLOT_FRAMES, mapped), private_pages);
    transition staged != 0u64 {
        true -> (staged)
        _ -> (world::geometry::plus(load, descendants * SLOT_FRAMES))
    }
}
machine larger(a: u64, b: u64) -> u64 {
    transition a < b { true -> (b) _ -> (a) }
}
// Drop the owner control and the storage listener, stop and collect the
// child, return its reservation and forget its view and staged batch.
// Handshake failure can request retirement only once. Retain that request while
// a publication fences scene reuse, then drain it before admitting any replacement.
public machine retire_pending(gate: &Gate, context: &mut State) reaches Kernel blocks invokes Kernel {
    transition context.presentation_work.active { true -> done() _ -> block visit(gate, context, 0u64) }
    machine visit(gate: &Gate, context: &mut State, slot: u64) reaches Kernel requires slot <= 5u64 {
        transition slot < 5u64 { true -> block one(gate, context, slot) _ -> done() }
    }
    machine one(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
        transition context.retire_after_present[slot] {
            true -> block retired(gate, context, slot)
            _ -> block visit(gate, context, slot + 1u64)
        }
    }
    machine retired(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
        block reclaim(gate, context, slot);
        transition { _ -> block visit(gate, context, slot + 1u64) }
    }
}
public machine reclaim(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel blocks invokes Kernel {
    cancel_launch(context, slot);
    transition context.presentation_work.active {
        true -> queued(context, slot)
        _ -> block idle_reclaim(gate, context, slot)
    }
    machine queued(context: &mut State, slot: u64 [0..=4]) { context.retire_after_present[slot] = true; }
}
machine idle_reclaim(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel blocks invokes Kernel {
    context.retire_after_present[slot] = false;
    context.answers[slot].active = false;
    transition context.slots[slot].live {
        true -> block stopping(gate, context, slot)
        _ -> done()
    }
    machine stopping(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
        context.opening[slot] = 0u64;
        let closed: u64 = block runtime::connection::main::close(gate, &mut context.controls[slot]);
        block storage::retire(gate, context, slot);
        context.scene_children[slot].active = false;
        block presentation::release_slot(gate, context, slot);
        let task: u64 = context.slots[slot].task;
        let exit: Exit = block runtime::admission::main::stop(gate, &mut context.slots[slot]);
        exited(gate, slot, exit);
        recovery::retired(context, slot, exit);
        let observer: u64 = launches::finished(&mut context.observations, task, outcome_of(exit));
        launches::disconnected(&mut context.observations, slot);
        let launch: u64 = context.reservations[slot];
        retire_reservation(gate, context, slot, launch);
        sweep_returned(gate);
        context.reservations[slot] = 0u64;
        context.funding[slot] = Funding::Fixed;
        level::disconnected(&mut context.world, slot);
        block workspace::retired(gate, context, slot);
        report::reclaimed(gate, slot);
    }
}
// What a requester's receipt reports for the ended child.
machine outcome_of(exit: Exit) -> u64 {
    transition exit {
        Exit::Returned { status } -> returned(status)
        Exit::Fault { vector, error, address, instruction } -> (LAUNCH_FAILED)
        Exit::Cancelled -> (LAUNCH_STOPPED)
        Exit::Failed { code } -> (LAUNCH_FAILED)
    }
    machine returned(status: u64) -> u64 {
        transition status == 0u64 {
            true -> (LAUNCH_EXITED)
            _ -> (LAUNCH_FAILED)
        }
    }
}
// The exit goes to the console; the Rust host keeps child exits silent, but a
// proof over this program reads them there.
machine exited(gate: &Gate, slot: u64, exit: Exit) reaches Kernel invokes Kernel {
    transition exit {
        Exit::Returned { status } -> report::child(gate, slot, 1u64, status)
        Exit::Fault { vector, error, address, instruction } -> faulted(gate, slot, vector, address, instruction)
        Exit::Cancelled -> report::child(gate, slot, 3u64, 0u64)
        Exit::Failed { code } -> report::child(gate, slot, 4u64, code)
    }
    machine faulted(gate: &Gate, slot: u64, vector: u64, address: u64, instruction: u64) reaches Kernel {
        report::child(gate, slot, 2u64, vector);
        report::child(gate, slot, 0x2au64, address);
        report::child(gate, slot, 0x2bu64, instruction);
    }
}
// A child whose view or queues changed since its last poll is woken through
// its interaction bell, once it holds the wait right; until then the hint
// stays with the World.
public machine notify(gate: &Gate, context: &mut State) reaches Kernel invokes Kernel {
    wake(gate, context, 0u64);
    wake(gate, context, 1u64);
    wake(gate, context, 2u64);
    wake(gate, context, 3u64);
    wake(gate, context, 4u64);
}
machine wake(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
    transition context.slots[slot].live && context.slots[slot].bell.wait == 0u64 {
        true -> hinted(gate, context, slot)
        _ -> done()
    }
    machine hinted(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
        let pending: bool = level::take_notification(&mut context.world, slot);
        transition pending {
            true -> rung(gate, context, slot)
            _ -> done()
        }
    }
    machine rung(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
        let status: u64 = Kernel::notify_signal(gate, context.slots[slot].bell.signal);
    }
}
public machine watch(context: &State, slot: u64 [0..=4], set: &mut Set) {
    transition context.slots[slot].live {
        true -> watched(context, slot, set)
        _ -> done()
    }
    machine watched(context: &State, slot: u64 [0..=4], set: &mut Set) {
        runtime::server::main::watch(&context.slots[slot].listener, set);
        transition context.opening[slot] != 0u64 && context.controls[slot].receiver != 0u64 {
            true -> runtime::waiting::add(set, runtime::waiting::IPC, context.controls[slot].receiver)
            _ -> done()
        }
    }
}
machine reply(gate: &Gate, context: &mut State, words: [u64; 8]) -> u64 reaches Kernel {
    block runtime::server::main::reply(gate, &mut context.owner, &words)
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
machine ok() -> [u64; 8] {
    let words: [u64; 8];
    words
}
machine done() {}
// Finish opening each child's owner control once the child answers; a child
// that never does within the window is taken back down.
public machine open_controls(gate: &Gate, context: &mut State, now: u64) reaches Kernel blocks invokes Kernel {
    block opening_slot(gate, context, now, 0u64, 1u64);
    block opening_slot(gate, context, now, 1u64, 1u64);
    block opening_slot(gate, context, now, 2u64, 1u64);
    block opening_slot(gate, context, now, 3u64, 1u64);
    block opening_slot(gate, context, now, 4u64, 1u64);
}
// A child just admitted gets a short wait for its answer before this matrix
// starts longer work in the same turn: an ordinary app accepts its owner
// control at once and holds that handshake to its own window, which a long
// scene switch here would otherwise outlast. A host that sets up its
// services first answers on a later turn.
public machine open_control(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4]) reaches Kernel blocks invokes Kernel {
    block opening_slot(gate, context, now, slot, FIRST_ANSWER_TICKS);
}
// How long a just-admitted child's first answer is waited for.
const FIRST_ANSWER_TICKS: u64 = 30u64;
machine opening_slot(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], window: u64) reaches Kernel {
    let deadline: u64 = context.opening[slot];
    transition {
        deadline == 0u64 -> done()
        !context.slots[slot].live -> forgotten(context, slot)
        runtime::time::reached(now, deadline) -> block abandoned(gate, context, slot)
        window < 0x8000000000000000u64 -> block probed(gate, context, now, slot, deadline, window)
        _ -> done()
    }
    machine forgotten(context: &mut State, slot: u64 [0..=4]) {
        context.opening[slot] = 0u64;
    }
    machine probed(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], deadline: u64, window: u64) reaches Kernel
        requires window < 0x8000000000000000u64 {
        let status: u64 = block runtime::connection::setup::ready(gate, context.controls[slot].receiver, runtime::time::after(now, window));
        let answered: bool = status == 0u64;
        transition answered {
            true -> block finishing(gate, context, slot, deadline)
            _ -> done()
        }
    }
    machine finishing(gate: &Gate, context: &mut State, slot: u64 [0..=4], deadline: u64) reaches Kernel {
        let status: u64 = block runtime::connection::main::connect_resume(gate, &mut context.controls[slot], deadline);
        context.opening[slot] = 0u64;
        transition status == 0u64 {
            true -> report::child_control_ready(gate)
            _ -> block reclaim(gate, context, slot)
        }
    }
    machine abandoned(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
        context.opening[slot] = 0u64;
        block reclaim(gate, context, slot);
    }
}
// An ended child's reservation goes back to this matrix. The kernel refuses
// while the child's frames are still charged, which retained images and its
// own deferred reclamation keep for a while after the exit; such a
// reservation waits in `releasing` and is retried each turn and before any
// funding is reckoned, so what it held is never stranded.
machine retire_reservation(gate: &Gate, context: &mut State, slot: u64 [0..=4], launch: u64) reaches Kernel {
    settle_slot(gate, context, slot);
    let released: u64 = runtime::task::main::release(gate, launch);
    transition released == kernel::BUSY && launch != 0u64 {
        true -> parked(context, slot, launch)
        _ -> unreleased(gate, slot, released)
    }
    machine parked(context: &mut State, slot: u64 [0..=4], launch: u64) {
        context.releasing[slot] = launch;
    }
}
// An ended host's descendant reservations come back to this matrix under
// fresh local names. Each one the kernel takes back is released; live and
// static launches refuse and are passed over, as are any still charged.
public machine sweep_returned(gate: &Gate) reaches Kernel invokes Kernel {
    sweeping(gate, 0u64, 0u64);
}
machine sweeping(gate: &Gate, index: u64, attempts: u64) reaches Kernel requires index <= RETURNED_LAUNCHES && attempts <= RETURNED_LAUNCHES {
    let launch: u64 = runtime::task::main::launch(gate, index);
    transition index < RETURNED_LAUNCHES && attempts < RETURNED_LAUNCHES && launch < kernel::ERROR_BASE {
        true -> released_at(gate, index, attempts, runtime::task::main::release(gate, launch))
        _ -> done()
    }
    // A released launch's index now names the next one.
    machine released_at(gate: &Gate, index: u64, attempts: u64, status: u64) reaches Kernel
        requires index < RETURNED_LAUNCHES && attempts < RETURNED_LAUNCHES {
        transition status == 0u64 {
            true -> sweeping(gate, index, attempts + 1u64)
            _ -> sweeping(gate, index + 1u64, attempts + 1u64)
        }
    }
}
// More launches than one process can hold.
const RETURNED_LAUNCHES: u64 = 32u64;
public machine settle(gate: &Gate, context: &mut State) reaches Kernel invokes Kernel {
    settle_slot(gate, context, 0u64);
    settle_slot(gate, context, 1u64);
    settle_slot(gate, context, 2u64);
    settle_slot(gate, context, 3u64);
    settle_slot(gate, context, 4u64);
}
machine settle_slot(gate: &Gate, context: &mut State, slot: u64 [0..=4]) reaches Kernel {
    transition context.releasing[slot] != 0u64 {
        true -> settling(gate, context, slot, runtime::task::main::release(gate, context.releasing[slot]))
        _ -> done()
    }
    machine settling(gate: &Gate, context: &mut State, slot: u64 [0..=4], status: u64) reaches Kernel {
        transition status == kernel::BUSY {
            true -> done()
            _ -> released(gate, context, slot, status)
        }
    }
    machine released(gate: &Gate, context: &mut State, slot: u64 [0..=4], status: u64) reaches Kernel {
        context.releasing[slot] = 0u64;
        unreleased(gate, slot, status);
    }
}
// Anything else the kernel says about a release goes to the console.
machine unreleased(gate: &Gate, slot: u64, status: u64) reaches Kernel invokes Kernel {
    transition status == 0u64 {
        true -> done()
        _ -> report::launch_stage(gate, slot, 8u64, status)
    }
}

// Stopping either the requester or its reserved target cancels a pending read.
// During synchronous admission the picker is intentionally retired instead.
machine cancel_launch(context: &mut State, slot: u64 [0..=4]) {
    transition context.launch.phase == 1u64 && (context.launch.requester == slot || context.launch.slot == slot) {
        true -> cancelled(context)
        _ -> done()
    }
    machine cancelled(context: &mut State) { context.launch.cancelled = true; }
}
