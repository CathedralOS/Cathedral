module slots;
// One admitted child's listener per turn. A retired listener means the child
// left: stop, collect and release it and drop its view. Service acquisition goes
// to the runtime's offer, surface and batch words to presentation (a sealed
// attachment is accepted only behind an image word), a launch and its receipt
// query to the stored launches, a request for more funding to the funding,
// the chrome's app entries and selection to the workspace, every other 64-byte request to the World
// under the connection's incarnation; shorter requests are denied.
use protocol::main;
use protocol::matrix;
use protocol::services::ACQUIRE;
use policy::requests::desktop::LAUNCH;
use policy::requests::desktop::APP_ENTRY;
use policy::requests::desktop::SELECT_APP;
use policy::requests::desktop::APPLY_LAYOUT;
use policy::requests::desktop::CLOSE;
use workspace::Closing;
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::server::main::Event;
use runtime::server::main::Ticket;
use runtime::connection::main::Frame;
use runtime::admission::offer;
use world::main::request;
use world::geometry::zeros_from;
use lifecycle;
use connections::presentation;
use stored;
use funding;
use workspace;

public machine step(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64) -> u64 reaches Kernel blocks; invokes Kernel; {
    transition {
        !context.slots[slot].live -> (0u64)
        context.slots[slot].listener.peer.fault != 0u64 -> block departed(gate, context, slot)
        context.slots[slot].listener.pending != 0u64 -> block held(gate, context, slot, now)
        _ -> block receive(gate, context, slot, now)
    }
}
machine departed(gate: &Gate, context: &mut State, slot: u64 [0..=4]) -> u64 reaches Kernel {
    block lifecycle::reclaim(gate, context, slot);
    0u64
}
machine held(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64) -> u64 reaches Kernel {
    let status: u64 = block runtime::server::main::maintain(gate, &mut context.slots[slot].listener, now);
    0u64
}
machine receive(gate: &Gate, context: &mut State, slot: u64 [0..=4], now: u64) -> u64 reaches Kernel {
    let event: Event = block runtime::server::main::poll(gate, &mut context.slots[slot].listener, now);
    transition event {
        Event::Request { frame } -> block routed(gate, context, slot, frame, now)
        Event::Pending -> (0u64)
        Event::Failed { code } -> block departed(gate, context, slot)
    }
}
machine routed(gate: &Gate, context: &mut State, slot: u64 [0..=4], frame: Frame, now: u64) -> u64 reaches Kernel {
    let issued: Ticket = runtime::server::main::ticket(&context.slots[slot].listener);
    let incarnation: u64 = context.slots[slot].listener.incarnation;
    let attached: bool = frame.attachment != 0u64;
    let batch: bool = frame.payload[0] == PRESENT_BEGIN || frame.payload[0] == PRESENT_COMMIT || frame.payload[0] == PRESENT_ABORT
        || frame.payload[0] == PRESENT_RECTS;
    transition {
        frame.bytes != 64u64 -> block answered(gate, context, slot, issued, error(kernel::DENIED))
        attached && frame.payload[0] == SURFACE_IMAGE -> block imaging(gate, context, slot, issued, frame, incarnation)
        attached -> block answered(gate, context, slot, issued, error(kernel::DENIED))
        frame.payload[0] == SURFACE_IMAGE -> block unattached(gate, context, slot, issued)
        frame.payload[0] == ACQUIRE -> block acquire(gate, context, slot, issued, frame)
        frame.payload[0] == SURFACE_CREATE -> block creating(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == MATRIX_PAINT || frame.payload[0] == MATRIX_ERASE || frame.payload[0] == SURFACE_CURSOR
            -> block updating(gate, context, slot, issued, frame, incarnation)
        batch -> block presenting(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == LAUNCH -> block launching(gate, context, slot, issued, frame, incarnation, now)
        frame.payload[0] == LAUNCH_STATUS && zeros_from(&frame.payload, 2u64) -> block observing(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == FUND -> block funding(gate, context, slot, issued, frame, now)
        frame.payload[0] == APP_ENTRY -> block answered(gate, context, slot, issued, workspace::entry(context, slot, incarnation, frame.payload))
        frame.payload[0] == SELECT_APP -> block selecting(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == APPLY_LAYOUT -> block arranging(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == CLOSE -> block closing(gate, context, slot, issued, frame, incarnation, now)
        _ -> block asked(gate, context, slot, issued, frame, incarnation)
    }
}
machine launching(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64, now: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = block stored::child_launch(gate, context, now, slot, incarnation, frame.payload);
    block answered(gate, context, slot, issued, reply)
}
machine funding(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, now: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = block funding::fund(gate, context, now, slot, frame.payload);
    block answered(gate, context, slot, issued, reply)
}
// A held close is answered when the target has said what it would lose.
machine closing(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64, now: u64) -> u64 reaches Kernel {
    let closing: Closing = block workspace::close(gate, context, now, slot, incarnation, issued, frame.payload);
    transition closing {
        Closing::Held -> (0u64)
        Closing::Answer { words } -> block answered(gate, context, slot, issued, words)
    }
}
machine arranging(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = block workspace::apply_layout(gate, context, slot, incarnation, frame.payload);
    block answered(gate, context, slot, issued, reply)
}
machine selecting(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = block workspace::select(gate, context, slot, incarnation, frame.payload);
    block answered(gate, context, slot, issued, reply)
}
machine observing(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = stored::status(context, slot, incarnation, frame.payload[1]);
    block answered(gate, context, slot, issued, reply)
}
// The listener holds the sealed attachment until the reply; presentation
// takes it over, to forward, retain or release.
machine imaging(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let object: u64 = context.slots[slot].listener.object;
    context.slots[slot].listener.object = 0u64;
    let reply: [u64; 8] = block presentation::image(gate, context, slot, incarnation, frame, object);
    block answered(gate, context, slot, issued, reply)
}
machine unattached(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket) -> u64 reaches Kernel {
    let reply: [u64; 8] = presentation::image_missing(context, slot);
    block answered(gate, context, slot, issued, reply)
}
machine presenting(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = block presentation::batch_word(gate, context, slot, incarnation, frame);
    block answered(gate, context, slot, issued, reply)
}
machine acquire(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame) -> u64 reaches Kernel {
    let status: u64 = block offer::reply(gate, &mut context.slots[slot], issued, &frame.payload);
    0u64
}
machine creating(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = block presentation::create(gate, context, slot, incarnation, &frame.payload);
    block answered(gate, context, slot, issued, reply)
}
machine updating(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = block presentation::update(gate, context, slot, incarnation, frame);
    block answered(gate, context, slot, issued, reply)
}
machine asked(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, frame: Frame, incarnation: u64) -> u64 reaches Kernel {
    let reply: [u64; 8] = request(&mut context.world, slot, incarnation, &frame.payload);
    block answered(gate, context, slot, issued, reply)
}
machine answered(gate: &Gate, context: &mut State, slot: u64 [0..=4], issued: Ticket, reply: [u64; 8]) -> u64 reaches Kernel {
    let status: u64 = block runtime::server::main::reply_to(gate, &mut context.slots[slot].listener, issued, &reply);
    0u64
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
