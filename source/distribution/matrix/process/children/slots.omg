use {shared}/report.omg;
// One admitted child's listener per turn. A retired listener means the child
// left: stop, collect and release it and drop its view. Service acquisition goes
// to the runtime's offer, surface and batch words to presentation (a sealed
// attachment is accepted only behind an image word), a launch and its receipt
// query to the stored launches, a request for more funding to the funding,
// the chrome's app entries and selection to the workspace, every other 64-byte request to the World
// under the connection's incarnation; shorter requests are denied.
use {protocol}/main.omg;
use {protocol}/matrix.omg;
use {protocol}/services.omg;
use {policy}/requests/desktop.omg;
use workspace.omg;
use {shared}/state.omg as shared_state;
use {runtime}/kernel.omg;
use {runtime}/server/main.omg as server_main;
use {runtime}/connection/main.omg as connection_main;
use {runtime}/admission/offer.omg;
use {world}/main.omg as world_main;
use {world}/geometry.omg;
use lifecycle.omg;
use {connections}/presentation.omg;
use launch/launch.omg;
use funding.omg;
use {connections}/responses.omg;

// Resume after the last publication's sender, so a constantly repainting child
// cannot always take the scene before its waiting siblings.
public machine all(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block visit(gate, context, now, context.next_child, 0u64)
    machine visit(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, first: u64 [0..=4], rank: u64) -> u64
        reaches |kernel|::Kernel requires rank <= 5u64 {
        transition rank < 5u64 { true -> block one(gate, context, now, first, rank) _ -> (0u64) }
    }
    machine one(gate: &|kernel|::Gate, context: &mut |shared_state|::State, now: u64, first: u64 [0..=4], rank: u64) -> u64
        reaches |kernel|::Kernel requires rank < 5u64 {
        let status: u64 = block step(gate, context, (first + rank) % 5u64, now);
        transition status == 0u64 { true -> block visit(gate, context, now, first, rank + 1u64) _ -> (status) }
    }
}
public machine step(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition {
        |shared_state|::unserved(context, slot) -> (0u64)
        context.retire_after_present[slot] -> (0u64)
        context.launch.phase == 2u64 && context.launch.cancelled && context.launch.slot == slot -> (0u64)
        !context.slots[slot].live -> (0u64)
        context.slots[slot].listener.peer.fault != 0u64 -> departed(context, slot)
        context.answers[slot].active -> block |responses|::step(gate, context, slot)
        context.scene_children[slot].active && !context.presentation_work.active -> block queued(gate, context, slot, now)
        context.slots[slot].listener.pending != 0u64 -> block held(gate, context, slot, now)
        _ -> block receive(gate, context, slot, now)
    }
}
machine departed(context: &mut |shared_state|::State, slot: u64 [0..=4]) -> u64 {
    |lifecycle|::request_retirement(context, slot);
    0u64
}
machine held(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], now: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |server_main|::maintain(gate, &mut context.slots[slot].listener, now);
    0u64
}
machine receive(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], now: u64) -> u64 reaches |kernel|::Kernel {
    let event: |server_main|::Event = block |server_main|::poll(gate, &mut context.slots[slot].listener, now);
    transition event {
        |server_main|::Event::Request { frame } -> block routed(gate, context, slot, frame, now)
        |server_main|::Event::Pending -> (0u64)
        |server_main|::Event::Failed { code } -> departed(context, slot)
    }
}
machine queued(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], now: u64) -> u64 reaches |kernel|::Kernel {
    let frame: |connection_main|::Frame = context.scene_children[slot].frame;
    context.scene_children[slot].active = false;
    block routed(gate, context, slot, frame, now)
}
machine routed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], frame: |connection_main|::Frame, now: u64) -> u64 reaches |kernel|::Kernel {
    // Polls and acquisition of already-granted rights are independent of scene
    // publication. In particular, an admitted child must finish its handshake
    // while an older sibling's publication waits. Other requests retain their input.
    transition context.presentation_work.active && frame.payload[0] != |main|::MATRIX_POLL && frame.payload[0] != |main|::POLL_TAGGED
        && frame.payload[0] != |services|::ACQUIRE {
        true -> queued(gate, context, slot, frame)
        _ -> block dispatch(gate, context, slot, frame, now)
    }
    machine queued(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
        control_request(gate, context, slot, 9u64, frame.payload[0]);
        context.scene_children[slot].active = true;
        context.scene_children[slot].frame = frame;
        0u64
    }
}
machine dispatch(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], frame: |connection_main|::Frame, now: u64) -> u64 reaches |kernel|::Kernel {
    control_request(gate, context, slot, 8u64, frame.payload[0]);
    let issued: |server_main|::Ticket = |server_main|::ticket(&context.slots[slot].listener);
    let incarnation: u64 = context.slots[slot].listener.incarnation;
    let attached: bool = frame.attachment != 0u64;
    let batch: bool = frame.payload[0] == |matrix|::PRESENT_BEGIN || frame.payload[0] == |matrix|::PRESENT_COMMIT || frame.payload[0] == |matrix|::PRESENT_ABORT
        || frame.payload[0] == |main|::PRESENT_RECTS;
    transition {
        frame.bytes != 64u64 -> block answered(gate, context, slot, issued, error(|kernel|::DENIED))
        attached && frame.payload[0] == |main|::SURFACE_IMAGE -> block imaging(gate, context, slot, issued, frame, incarnation)
        attached -> block answered(gate, context, slot, issued, error(|kernel|::DENIED))
        frame.payload[0] == |main|::SURFACE_IMAGE -> block unattached(gate, context, slot, issued)
        frame.payload[0] == |services|::ACQUIRE -> block acquire(gate, context, slot, issued, frame)
        frame.payload[0] == |main|::SURFACE_CREATE -> block creating(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == |main|::MATRIX_PAINT || frame.payload[0] == |matrix|::MATRIX_ERASE || frame.payload[0] == |matrix|::SURFACE_CURSOR
            -> block updating(gate, context, slot, issued, frame, incarnation)
        batch -> block presenting(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == |desktop|::LAUNCH -> block launching(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == |matrix|::LAUNCH_STATUS && |geometry|::zeros_from(&frame.payload, 2u64) -> block observing(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == |matrix|::FUND -> block funding(gate, context, slot, issued, frame, now)
        frame.payload[0] == |desktop|::APP_ENTRY -> block answered(gate, context, slot, issued, |workspace|::entry(context, slot, incarnation, frame.payload))
        frame.payload[0] == |desktop|::SELECT_APP -> block selecting(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == |desktop|::APPLY_LAYOUT -> block arranging(gate, context, slot, issued, frame, incarnation)
        frame.payload[0] == |desktop|::CLOSE -> block closing(gate, context, slot, issued, frame, incarnation, now)
        _ -> block asked(gate, context, slot, issued, frame, incarnation)
    }
}
machine launching(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let result: |presentation|::Submission = |launch|::begin(gate, context, slot, incarnation, frame.payload);
    transition result {
        |presentation|::Submission::Pending -> (0u64)
        |presentation|::Submission::Answer { words } -> block answered(gate, context, slot, issued, words)
    }
}
machine funding(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, now: u64) -> u64 reaches |kernel|::Kernel {
    let result: |presentation|::Submission = |funding|::fund(context, slot, frame.payload);
    transition result {
        |presentation|::Submission::Pending -> (0u64)
        |presentation|::Submission::Answer { words } -> block answered(gate, context, slot, issued, words)
    }
}
// A held close is answered when the target has said what it would lose.
machine closing(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    let closing: |workspace|::Closing = block |workspace|::close(gate, context, now, slot, incarnation, issued, frame.payload);
    transition closing {
        |workspace|::Closing::Held -> (0u64)
        |workspace|::Closing::Answer { words } -> block answered(gate, context, slot, issued, words)
    }
}
machine arranging(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let result: |presentation|::Submission = |workspace|::apply_layout(context, slot, incarnation, frame.payload);
    transition result {
        |presentation|::Submission::Pending -> (0u64)
        |presentation|::Submission::Answer { words } -> block answered(gate, context, slot, issued, words)
    }
}
machine selecting(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let result: |presentation|::Submission = |workspace|::select(context, slot, incarnation, frame.payload);
    transition result {
        |presentation|::Submission::Pending -> (0u64)
        |presentation|::Submission::Answer { words } -> block answered(gate, context, slot, issued, words)
    }
}
machine observing(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let reply: [u64; 8] = |launch|::status(context, slot, incarnation, frame.payload[1]);
    block answered(gate, context, slot, issued, reply)
}
// The listener holds the sealed attachment until the reply; presentation
// takes it over, to forward, retain or release.
machine imaging(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let object: u64 = context.slots[slot].listener.object;
    context.slots[slot].listener.object = 0u64;
    let result: |presentation|::Submission = block |presentation|::image(gate, context, slot, incarnation, frame, object);
    transition result {
        |presentation|::Submission::Pending -> (0u64)
        |presentation|::Submission::Answer { words } -> block answered(gate, context, slot, issued, words)
    }
}
machine unattached(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket) -> u64 reaches |kernel|::Kernel {
    let reply: [u64; 8] = |presentation|::image_missing(context, slot);
    block answered(gate, context, slot, issued, reply)
}
machine presenting(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let result: |presentation|::Submission = block |presentation|::batch_word(gate, context, slot, incarnation, frame);
    transition result { |presentation|::Submission::Pending -> (0u64) |presentation|::Submission::Answer { words } -> block answered(gate, context, slot, issued, words) }
}
machine acquire(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |offer|::reply(gate, &mut context.slots[slot], issued, &frame.payload);
    0u64
}
machine creating(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let reply: [u64; 8] = block |presentation|::create(gate, context, slot, incarnation, &frame.payload);
    block answered(gate, context, slot, issued, reply)
}
machine updating(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let result: |presentation|::Submission = block |presentation|::update(gate, context, slot, incarnation, frame);
    transition result { |presentation|::Submission::Pending -> (0u64) |presentation|::Submission::Answer { words } -> block answered(gate, context, slot, issued, words) }
}
machine asked(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, frame: |connection_main|::Frame, incarnation: u64) -> u64 reaches |kernel|::Kernel {
    let reply: [u64; 8] = |world_main|::request(&mut context.world, slot, incarnation, &frame.payload);
    block answered(gate, context, slot, issued, reply)
}
machine answered(gate: &|kernel|::Gate, context: &mut |shared_state|::State, slot: u64 [0..=4], issued: |server_main|::Ticket, reply: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    block |responses|::send(gate, context, slot, issued, reply)
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}

machine control_request(gate: &|kernel|::Gate, context: &|shared_state|::State, slot: u64, event: u64, op: u64) reaches |kernel|::Kernel {
    transition op == |desktop|::SELECT_APP || op == |desktop|::CLOSE {
        true -> |report|::control(gate, context.clock, context.trace_origin, event, slot, op)
        _ -> done()
    }
    machine done() {}
}
