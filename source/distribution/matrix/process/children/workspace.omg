module workspace;
// The workspace's app instances under the stock catalogue: the three app
// slots, the one that is active, and the chrome's words over them. A launch
// into an app slot publishes the instance and activates it; activation hides
// the other apps, switches the scene in one transaction, then gives the new
// app the input routes and the chrome its management. When an app ends, the
// chrome hears of it and the next instance, if any, becomes active. Only the
// placed chrome of a workspace may list the instances or select one.
use protocol::main;
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use world::level;
use world::demand;
use world::management;
use world::geometry::zeros_from;
use policy::children::workspace::catalogue;
use policy::children::workspace::catalogue::Entry;
use policy::children::workspace::catalogue::Position;
use policy::children::workspace::catalogue::Selection;
use policy::children::configuration::main::prepare;
use policy::children::configuration::main::Facts;
use policy::children::configuration::main::Decision;
use policy::children::configuration::main::Plan;
use policy::children::configuration::wire::decode;
use policy::children::configuration::placement::Extent;
use policy::children::configuration::placement::Rectangle;
use world::layout;
use world::geometry::Rect;
use connections::presentation;
use forward;
use selection;
use connections::presentation::Submission;

const CHROME: u64 = 0u64;

// The active app's slot, or zero.
public machine active(context: &State) -> u64 {
    transition context.catalogue.selected {
        Position::App { slot } -> (slot)
        Position::None -> (0u64)
    }
}

// APP_ENTRY [23, index]: the instance at a catalogue position, as
// [0, ticket, program, selected]; an empty position is all zeros.
public machine entry(context: &State, slot: u64 [0..=4], incarnation: u64, words: [u64; 8]) -> [u64; 8] {
    transition chrome(context, slot, incarnation) && zeros_from(&words, 2u64) {
        true -> listed(catalogue::entry(&context.catalogue, words[1]))
        _ -> (error(kernel::DENIED))
    }
    machine listed(found: Entry) -> [u64; 8] {
        transition found {
            Entry::Present { ticket, program, selected } -> ([0u64, ticket, program, flag(selected), 0u64, 0u64, 0u64, 0u64])
            Entry::Empty -> (error(0u64))
            Entry::Outside -> (error(kernel::DENIED))
        }
    }
}

// SELECT_APP [24, ticket]: make the instance with that ticket the active app.
public machine select(context: &mut State, slot: u64 [0..=4], incarnation: u64, words: [u64; 8]) -> Submission {
    transition chrome(context, slot, incarnation) && zeros_from(&words, 2u64) {
        true -> chosen(context, slot, catalogue::select(&context.catalogue, words[1], forward::busy(context)))
        _ -> (Submission::Answer { words: error(kernel::DENIED) })
    }
    machine chosen(context: &mut State, requester: u64 [0..=4], choice: Selection) -> Submission {
        transition choice {
            Selection::Switch { slot } -> started(context, requester, slot)
            Selection::Current { slot } -> (Submission::Answer { words: error(0u64) })
            Selection::Busy { slot } -> (Submission::Answer { words: error(kernel::BUSY) })
            Selection::Missing -> (Submission::Answer { words: error(kernel::DENIED) })
        }
    }
    machine started(context: &mut State, requester: u64 [0..=4], slot: u64) -> Submission {
        let previous: u64 = active(context);
        let status: u64 = selection::begin(context, requester, previous, slot);
        transition status == 0u64 {
            true -> (Submission::Pending)
            _ -> (Submission::Answer { words: error(status) })
        }
    }
}

// APPLY_LAYOUT [16, epoch, margin, bar height, gap]: the chrome rearranges the
// workspace. The stock layout plans the chrome, app and background places in
// this matrix's view; the World moves every placed child at once, the app
// slots keep their new places for later launches, and the moved surfaces are
// published again.
public machine apply_layout(gate: &Gate, context: &mut State, slot: u64 [0..=4], incarnation: u64, words: [u64; 8]) -> [u64; 8]
    reaches Kernel blocks invokes Kernel {
    let facts: Facts = Facts { authorized: layout::allowed(&context.world, slot, incarnation, words[1]), busy: forward::busy(context),
        extent: Extent { width: context.world.parent.width, height: context.world.parent.height }, standing: standing(context) };
    let decision: Decision = prepare(&facts, decode(&words));
    transition decision {
        Decision::Ready { plan } -> block arranged(gate, context, slot, incarnation, words[1], plan)
        Decision::Denied -> (error(kernel::DENIED))
        Decision::Busy -> (error(kernel::BUSY))
        Decision::Invalid -> (error(kernel::INVALID_ARGUMENT))
    }
    machine arranged(gate: &Gate, context: &mut State, slot: u64 [0..=4], incarnation: u64, epoch: u64, plan: Plan) -> [u64; 8] reaches Kernel {
        let rects: [Rect; 5] = [rect(plan.chrome), rect(plan.apps[0]), rect(plan.apps[1]), rect(plan.apps[2]), rect(plan.background)];
        let status: u64 = layout::layout(&mut context.world, slot, incarnation, epoch, &rects);
        transition status == 0u64 {
            true -> block moved(gate, context, rects, plan.remember)
            _ -> (error(status))
        }
    }
    machine moved(gate: &Gate, context: &mut State, rects: [Rect; 5], remember: u64) -> [u64; 8] reaches Kernel {
        remembered(context, 1u64, rects[1], remember);
        remembered(context, 2u64, rects[2], remember);
        remembered(context, 3u64, rects[3], remember);
        let status: u64 = block presentation::republish(gate, context);
        error(status)
    }
}
// The app slots whose standing policy places their launches.
machine standing(context: &State) -> u64 {
    flag(context.policies[1].placed) * 2u64 + flag(context.policies[2].placed) * 4u64 + flag(context.policies[3].placed) * 8u64
}
machine remembered(context: &mut State, slot: u64 [0..=4], place: Rect, remember: u64) {
    transition ((remember >> slot) & 1u64) == 1u64 {
        true -> kept(context, slot, place)
        _ -> done()
    }
    machine kept(context: &mut State, slot: u64 [0..=4], place: Rect) {
        context.policies[slot].x = place.x;
        context.policies[slot].y = place.y;
        context.policies[slot].width = place.width;
        context.policies[slot].height = place.height;
    }
}
machine rect(from: Rectangle) -> Rect {
    Rect { x: from.x, y: from.y, width: from.width, height: from.height }
}
// What a child's CLOSE gets: an answer now, or one held until the target
// answers what it would lose.
public data Closing [copy] {
    case Held;
    case Answer(words: [u64; 8]);
}
// CLOSE [15]: in a workspace the placed chrome closes the active app;
// elsewhere either of the first two children closes the other.
public machine close(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], incarnation: u64, request: runtime::server::main::Ticket,
    words: [u64; 8]) -> Closing reaches Kernel blocks invokes Kernel {
    let target: u64 = target_of(context, slot, incarnation);
    transition {
        !zeros_from(&words, 1u64) || target == DENIED_TARGET -> (Closing::Answer { words: error(kernel::DENIED) })
        target == NO_TARGET -> (Closing::Answer { words: error(kernel::PEER_CLOSED) })
        target < 5u64 -> block asking(gate, context, now, target, slot, request)
        _ -> (Closing::Answer { words: error(kernel::DENIED) })
    }
    machine asking(gate: &Gate, context: &mut State, now: u64, target: u64 [0..=4], slot: u64, request: runtime::server::main::Ticket) -> Closing
        reaches Kernel {
        let status: u64 = block forward::close(gate, context, now, target, slot, request);
        transition status == 0u64 {
            true -> (Closing::Held)
            _ -> (Closing::Answer { words: error(status) })
        }
    }
}
const DENIED_TARGET: u64 = 6u64;
const NO_TARGET: u64 = 7u64;
machine target_of(context: &State, slot: u64, incarnation: u64) -> u64 {
    let active: u64 = active(context);
    transition {
        context.desktop && chrome(context, slot, incarnation) && active != 0u64 -> (active)
        context.desktop && chrome(context, slot, incarnation) -> (NO_TARGET)
        context.desktop -> (DENIED_TARGET)
        slot < 2u64 -> (1u64 - slot)
        _ -> (DENIED_TARGET)
    }
}
// Reserve the new instance's catalogue ticket while keeping it hidden. The
// scene barrier defers catalogue queries; commit_selection publishes visibility
// and input only after the remote transaction succeeds. Reclaim removes failures.
public machine prepare_launch(context: &mut State, slot: u64 [0..=4], program: u64) -> u64 {
    transition catalogue::publish(&mut context.catalogue, slot, program) {
        true -> hidden(context, slot)
        _ -> (kernel::NO_MEMORY)
    }
    machine hidden(context: &mut State, slot: u64 [0..=4]) -> u64 {
        // The first poll must not look like a new occupant during activation.
        let identified: bool = level::identify(&mut context.world, slot, context.slots[slot].listener.incarnation);
        demand::visible(&mut context.world, slot, false)
    }
}

// An app's end: it leaves the catalogue, the chrome hears of it, and the next
// instance becomes active when none is.
public machine retired(context: &mut State, slot: u64 [0..=4]) {
    transition context.desktop && slot >= 1u64 && slot <= 3u64 {
        true -> retiring(context, slot)
        _ -> done()
    }
    machine retiring(context: &mut State, slot: u64 [0..=4]) {
        let removed: bool = catalogue::retire(&mut context.catalogue, slot);
        level::notify(&mut context.world, CHROME);
        let fallback: Position = catalogue::fallback(&context.catalogue);
        following(context, slot, fallback);
    }
    machine following(context: &mut State, retiring: u64 [0..=4], fallback: Position) {
        transition fallback {
            Position::App { slot } -> selected(context, retiring, slot)
            Position::None -> done()
        }
    }
    machine selected(context: &mut State, retiring: u64 [0..=4], slot: u64) {
        let status: u64 = selection::begin_retirement(context, retiring, slot);
    }
}
// The asynchronous selection has committed its preview. Publish local visibility,
// input retirement and chrome authority together, before serving more input.
public machine commit_selection(context: &mut State, previous: u64, slot: u64 [0..=4]) -> u64 {
    shown(context, slot);
    committed(context, previous, slot)
}
machine shown(context: &mut State, slot: u64) {
    let first: u64 = demand::visible(&mut context.world, 1u64, slot == 1u64);
    let second: u64 = demand::visible(&mut context.world, 2u64, slot == 2u64);
    let third: u64 = demand::visible(&mut context.world, 3u64, slot == 3u64);
}
machine committed(context: &mut State, previous: u64, slot: u64 [0..=4]) -> u64 {
    let quiet: u64 = deactivated(context, previous);
    let activated: bool = catalogue::activate(&mut context.catalogue, slot);
    let incarnation: u64 = context.slots[CHROME].listener.incarnation;
    let managed: u64 = management::grant(&mut context.managers, CHROME, incarnation, slot, 5u64);
    level::notify(&mut context.world, CHROME);
    0u64
}
// The former app keeps its view and grant, but its holds and routes end.
machine deactivated(context: &mut State, previous: u64) -> u64 {
    transition previous != 0u64 {
        true -> (demand::deactivate_input(&mut context.world, previous))
        _ -> (0u64)
    }
}
machine chrome(context: &State, slot: u64, incarnation: u64) -> bool {
    context.desktop && slot == CHROME && context.slots[CHROME].live && context.slots[CHROME].listener.incarnation == incarnation
}
machine flag(set: bool) -> u64 {
    transition set { true -> (1u64) _ -> (0u64) }
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
machine done() {}
