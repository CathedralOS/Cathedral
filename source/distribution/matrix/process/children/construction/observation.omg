// An explicitly configured observation window, never a kernel admission policy.
// Construction may commit behind the window; authority checks and STOP still
// run normally, and cancellation must collect any already committed child.
use {shared}/state.omg as shared_state;
use {shared}/report.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;

public machine defer_construction(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> bool reaches |kernel|::Kernel invokes |kernel|::Kernel {
    let ticks: u64 [0..=100] = context.construction_window;
    transition ticks == 0u64 { true -> (false) _ -> timed(gate, context, ticks) }
    machine timed(gate: &|kernel|::Gate, context: &mut |shared_state|::State, ticks: u64 [0..=100]) -> bool reaches |kernel|::Kernel {
        let now: |time|::Tick = |time|::read(gate, context.clock);
        transition now {
            |time|::Tick::Read { value } -> checked(gate, context, ticks, value)
            _ -> (false)
        }
    }
    machine checked(gate: &|kernel|::Gate, context: &mut |shared_state|::State, ticks: u64 [0..=100], now: u64) -> bool reaches |kernel|::Kernel {
        transition {
            !context.launch.probe_started -> started(gate, context, ticks, now)
            context.launch.probe_until == 0u64 -> (false)
            |time|::reached(now, context.launch.probe_until) -> released(gate, context)
            _ -> (true)
        }
    }
    machine started(gate: &|kernel|::Gate, context: &mut |shared_state|::State, ticks: u64 [0..=100], now: u64) -> bool reaches |kernel|::Kernel {
        context.launch.probe_started = true;
        context.launch.probe_until = |time|::after(now, ticks);
        |report|::construction_held(gate);
        true
    }
    machine released(gate: &|kernel|::Gate, context: &mut |shared_state|::State) -> bool reaches |kernel|::Kernel {
        context.launch.probe_until = 0u64;
        |report|::construction_released(gate);
        false
    }
}
