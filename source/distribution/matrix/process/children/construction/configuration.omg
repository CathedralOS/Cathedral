use {runtime}/task/main.omg;
// Finish the bounded CPU and image grants before submitting construction.
use {runtime}/kernel.omg;
public machine configure(gate: &|kernel|::Gate, launch: u64, images: u64, cpu: u64) -> u64 reaches |kernel|::Kernel invokes |kernel|::Kernel {
    transition images < 16384u64 {
        true -> configured(gate, launch, images, cpu)
        _ -> (|kernel|::INVALID_ARGUMENT)
    }
    machine configured(gate: &|kernel|::Gate, launch: u64, images: u64, cpu: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = ceiling(gate, launch, cpu);
        transition status == 0u64 { true -> allowing(gate, launch, images, 0u64) _ -> (status) }
    }
}
machine ceiling(gate: &|kernel|::Gate, launch: u64, cpu: u64) -> u64 reaches |kernel|::Kernel {
    transition cpu == 0u64 { true -> (0u64) _ -> (|main|::assign_cpu(gate, launch, cpu)) }
}
machine allowing(gate: &|kernel|::Gate, launch: u64, images: u64, index: u64) -> u64 reaches |kernel|::Kernel requires index <= 14u64 {
    transition index < 14u64 { true -> chosen(gate, launch, images, index) _ -> (0u64) }
    machine chosen(gate: &|kernel|::Gate, launch: u64, images: u64, index: u64 [0..=13]) -> u64 reaches |kernel|::Kernel {
        transition ((images >> index) & 1u64) == 1u64 {
            true -> lending(gate, launch, images, index)
            _ -> allowing(gate, launch, images, index + 1u64)
        }
    }
    machine lending(gate: &|kernel|::Gate, launch: u64, images: u64, index: u64 [0..=13]) -> u64 reaches |kernel|::Kernel {
        let grant: u64 = |main|::image_at(gate, index);
        transition grant < |kernel|::ERROR_BASE {
            true -> lent(gate, launch, images, index, |main|::allow_image(gate, launch, grant))
            _ -> (grant)
        }
    }
    machine lent(gate: &|kernel|::Gate, launch: u64, images: u64, index: u64 [0..=13], status: u64) -> u64 reaches |kernel|::Kernel {
        transition status == 0u64 { true -> allowing(gate, launch, images, index + 1u64) _ -> (status) }
    }
}
