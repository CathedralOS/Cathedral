module launch::completion;
// A failed admitted launch keeps its request until lifecycle has collected its
// child. Finalization owns picker recovery and the exact reply, not placement.
use shared::state::State;
use shared::state::Launch;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::server::main::Ticket;
use runtime::server::deferred;
use policy::children::startup::main::RetirementEffect;
use connections::responses;
use shared::report;
use lifecycle;

public const PHASE: u64 = 5u64;

public machine retire(context: &mut State, status: u64, login: bool) {
    let slot: u64 [0..=4] = context.launch.slot;
    context.launch.phase = PHASE;
    context.launch.refusal = status;
    context.launch.recover_picker = login;
    lifecycle::request_retirement(context, slot);
}
public machine step(gate: &Gate, context: &mut State) reaches Kernel blocks invokes Kernel {
    let slot: u64 [0..=4] = context.launch.slot;
    transition !context.retire_after_present[slot] && context.retirement_failure == 0u64 && ready(context) {
        true -> block finished(gate, context)
        _ -> done()
    }
    machine finished(gate: &Gate, context: &mut State) reaches Kernel {
        let mut words: [u64; 8];
        words[0] = context.launch.refusal;
        let login: bool = context.launch.recover_picker;
        report::launch_refused(gate, words[0]);
        block answer(gate, context, words, login);
    }
}
machine ready(context: &State) -> bool {
    let requester: u64 [0..=4] = context.launch.requester;
    // A replacement's outbox cannot keep an obsolete request alive.
    !deferred::matches(&context.slots[requester].listener, context.launch.ticket)
        || !context.answers[requester].active
}
// Callers with a current ticket first ensure the requester's outbox is free.
// responses then owns any reply backpressure; stale callers receive nothing.
public machine answer(gate: &Gate, context: &mut State, words: [u64; 8], login: bool) reaches Kernel blocks invokes Kernel {
    let requester: u64 [0..=4] = context.launch.requester;
    let ticket: Ticket = context.launch.ticket;
    let current: bool = deferred::matches(&context.slots[requester].listener, ticket);
    recover(context, login && words[0] != 0u64);
    let empty: Launch;
    context.launch = empty;
    transition current {
        true -> block sent(gate, context, requester, ticket, words)
        _ -> done()
    }
    machine sent(gate: &Gate, context: &mut State, requester: u64 [0..=4], ticket: Ticket, words: [u64; 8]) reaches Kernel {
        let ignored: u64 = block responses::send(gate, context, requester, ticket, words);
    }
}
machine recover(context: &mut State, failed: bool) {
    transition failed { true -> selected(context) _ -> done() }
    machine selected(context: &mut State) {
        let effect: RetirementEffect = policy::children::startup::main::selection_failed(&mut context.startup, false);
    }
}
machine done() {}
