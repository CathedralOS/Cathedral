module funding;
// Funding between this matrix, its owner and its children, under the stock
// funding policy. Before a launch from the realm this matrix makes sure its
// own allowances cover what the child and the connections to it take, asking
// its owner with FUND for any shortfall; the root has no one to ask. A child
// admitted with descendant capacity may ask in turn: within its grant's
// ceiling this matrix covers the request from its own allowances, asking its
// owner first if it must, and grows the child's launch in place.
use protocol::matrix;
use shared::state::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::task::main::Spare;
use world::geometry::zeros_from;
use policy::children::launch::resources::funding::Funding;
use policy::children::launch::resources::funding::Grant;
use policy::children::launch::resources::funding::Increase;
use policy::children::launch::resources::funding::increased;
use policy::children::launch::resources::funding::shortfall;
use policy::children::launch::resources::funding::nothing;
use connections::upstream;
use shared::report;
use lifecycle;
use transport_funding;

// Cover `needed` from this matrix's own allowances, asking its owner for
// whatever they lack.
public machine ensure(gate: &Gate, context: &mut State, now: u64, needed: [u64; 5]) -> u64 reaches Kernel blocks invokes Kernel {
    lifecycle::settle(gate, context);
    lifecycle::sweep_returned(gate);
    let spare: Spare = runtime::task::main::spare(gate);
    transition spare {
        Spare::Known { amounts } -> block short(gate, context, now, shortfall(amounts, transport_funding::owed(context, needed)))
        Spare::Failed { code } -> (code)
    }
    machine short(gate: &Gate, context: &mut State, now: u64, delta: [u64; 5]) -> u64 reaches Kernel {
        transition nothing(delta) {
            true -> (0u64)
            _ -> block request(gate, context, now, delta)
        }
    }
}
// Ask this matrix's owner for `delta`, all or nothing.
public machine request(gate: &Gate, context: &mut State, now: u64, delta: [u64; 5]) -> u64 reaches Kernel blocks invokes Kernel {
    transition context.has_parent {
        true -> block asking(gate, context, delta)
        _ -> refused_root(gate, delta)
    }
    machine refused_root(gate: &Gate, delta: [u64; 5]) -> u64 reaches Kernel {
        report::funding_shortfall(gate, delta);
        kernel::NO_MEMORY
    }
    machine asking(gate: &Gate, context: &mut State, delta: [u64; 5]) -> u64 reaches Kernel {
        report::funding_asked(gate, delta);
        let reply: [u64; 8] = block upstream::exchange(gate, context, [FUND, delta[0], delta[1], delta[2], delta[3], delta[4], 0u64, 0u64]);
        reply[0]
    }
}

// A child's FUND: [FUND, five increments, 0, 0].
public machine fund(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], words: [u64; 8]) -> [u64; 8] reaches Kernel blocks invokes Kernel {
    let delta: [u64; 5] = [words[1], words[2], words[3], words[4], words[5]];
    transition zeros_from(&words, 6u64) && context.reservations[slot] != 0u64 {
        true -> block granted(gate, context, now, slot, delta, context.funding[slot])
        _ -> (error(kernel::DENIED))
    }
    machine granted(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], delta: [u64; 5], funding: Funding) -> [u64; 8] reaches Kernel {
        transition funding {
            Funding::Growable { grant } -> block increasing(gate, context, now, slot, delta, increased(grant, delta))
            Funding::Fixed -> (error(kernel::DENIED))
        }
    }
    machine increasing(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], delta: [u64; 5], increase: Increase) -> [u64; 8]
        reaches Kernel {
        transition increase {
            Increase::Granted { grant } -> block covering(gate, context, now, slot, delta, grant)
            Increase::Refused -> (refused(gate, slot, 1u64))
        }
    }
    // A refusal upstream is this child's refusal; a transport failure is not
    // retried here.
    machine covering(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], delta: [u64; 5], grant: Grant) -> [u64; 8] reaches Kernel {
        let status: u64 = block ensure(gate, context, now, delta);
        transition {
            status == 0u64 -> block growing(gate, context, now, slot, delta, grant)
            status == kernel::NO_MEMORY || status == kernel::DENIED -> (refused(gate, slot, 2u64))
            _ -> (error(status))
        }
    }
    machine growing(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], delta: [u64; 5], grant: Grant) -> [u64; 8] reaches Kernel {
        let status: u64 = runtime::task::main::grow(gate, context.reservations[slot], delta);
        transition {
            status == 0u64 -> (funded(context, slot, grant))
            status == kernel::NO_PROCESS_CAPACITY && delta[3] != 0u64 -> block slotted(gate, context, now, slot, delta, grant)
            _ -> (refused(gate, slot, 3u64))
        }
    }
    // A retired sibling can leave free process slots below this child's
    // ordering boundary, which it cannot take; ask the owner once for as many
    // more.
    machine slotted(gate: &Gate, context: &mut State, now: u64, slot: u64 [0..=4], delta: [u64; 5], grant: Grant) -> [u64; 8] reaches Kernel {
        let status: u64 = block request(gate, context, now, [0u64, 0u64, 0u64, delta[3], 0u64]);
        transition status == 0u64 {
            true -> regrowing(gate, context, slot, delta, grant)
            _ -> (error(kernel::NO_MEMORY))
        }
    }
    machine regrowing(gate: &Gate, context: &mut State, slot: u64 [0..=4], delta: [u64; 5], grant: Grant) -> [u64; 8] reaches Kernel {
        let status: u64 = runtime::task::main::grow(gate, context.reservations[slot], delta);
        transition status == 0u64 {
            true -> (funded(context, slot, grant))
            _ -> (error(kernel::NO_MEMORY))
        }
    }
}
machine refused(gate: &Gate, slot: u64, reason: u64) -> [u64; 8] reaches Kernel invokes Kernel {
    report::funding_refused(gate, slot, reason);
    error(kernel::NO_MEMORY)
}
machine funded(context: &mut State, slot: u64 [0..=4], grant: Grant) -> [u64; 8] {
    context.funding[slot] = Funding::Growable { grant: grant };
    error(0u64)
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
