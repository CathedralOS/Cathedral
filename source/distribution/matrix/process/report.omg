module report;
// Startup diagnostics on the console, worded as the Rust host's lines so the
// boot harness can key on them.
use runtime::kernel::Gate;
use runtime::kernel::Kernel;

public machine display_ready(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: shared display connection ready\n";
    line(gate, &text);
}
public machine storage_ready(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: shared storage connection ready\n";
    line(gate, &text);
}
public machine parent_interaction_ready(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: shared parent interaction ready\n";
    line(gate, &text);
}
public machine parent_storage_ready(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: parent storage connection ready\n";
    line(gate, &text);
}
public machine configured(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: configured from the realm paths\n";
    line(gate, &text);
}
public machine background_admitted(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: background admitted, presenting\n";
    line(gate, &text);
}
public machine picker_placed(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: scoped picker placed over users\n";
    line(gate, &text);
}
public machine picker_exhausted(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: picker retries spent, giving up\n";
    line(gate, &text);
}
public machine picker_restored(gate: &Gate) reaches Kernel invokes Kernel; {
    let text: [u8; 50] = "Cathedral matrix: the local picker restored again\n";
    line(gate, &text);
}
machine line(gate: &Gate, text: &[u8; 50]) reaches Kernel {
    let mut words: [u64; 8];
    transition { _ -> pack(gate, text, &mut words, 0u64) }
    machine pack(gate: &Gate, text: &[u8; 50], words: &mut [u64; 8], index: u64) requires index <= 50u64 reaches Kernel {
        transition index < 50u64 {
            true -> byte(gate, text, words, index)
            _ -> written(gate, words)
        }
    }
    machine byte(gate: &Gate, text: &[u8; 50], words: &mut [u64; 8], index: u64) requires index < 50u64 reaches Kernel {
        let word: u64 = index / 8u64;
        words[word] = words[word] | ((text[index] as u64) << ((index % 8u64) * 8u64));
        transition { _ -> pack(gate, text, words, index + 1u64) }
    }
    machine written(gate: &Gate, words: &[u64; 8]) reaches Kernel {
        let status: u64 = Kernel::write(gate, words, 50u64);
    }
}
// A child's retirement on the console: its slot, then the exit's variant and
// code in hex (1 returned, 2 fault with 2a address and 2b instruction,
// 3 cancelled, 4 failed).
public machine child(gate: &Gate, slot: u64, kind: u64, value: u64) reaches Kernel invokes Kernel; {
    let text: [u8; 24] = "Cathedral matrix: child ";
    let mut words: [u64; 8];
    transition { _ -> pack(gate, &text, &mut words, 0u64, slot, kind, value) }
    machine pack(gate: &Gate, text: &[u8; 24], words: &mut [u64; 8], index: u64, slot: u64, kind: u64, value: u64) requires index <= 24u64 reaches Kernel {
        transition index < 24u64 {
            true -> byte(gate, text, words, index, slot, kind, value)
            _ -> numbered(gate, words, slot, kind, value)
        }
    }
    machine byte(gate: &Gate, text: &[u8; 24], words: &mut [u64; 8], index: u64, slot: u64, kind: u64, value: u64) requires index < 24u64 reaches Kernel {
        let word: u64 = index / 8u64;
        words[word] = words[word] | ((text[index] as u64) << ((index % 8u64) * 8u64));
        transition { _ -> pack(gate, text, words, index + 1u64, slot, kind, value) }
    }
    machine numbered(gate: &Gate, words: &mut [u64; 8], slot: u64, kind: u64, value: u64) reaches Kernel {
        put(words, 24u64, 48u64 + (slot & 7u64));
        put(words, 25u64, 32u64);
        hex(words, 26u64, kind, 0u64);
        put(words, 42u64, 32u64);
        hex(words, 43u64, value, 0u64);
        put(words, 59u64, 10u64);
        let status: u64 = Kernel::write(gate, words, 60u64);
    }
}
// Where a child's admission from an image failed: the slot, then the stage
// (1 declaration, 2 fit, 3 image grant, 4 reservation, 5 admission, 6
// binding) and the code in hex.
public machine launch_stage(gate: &Gate, slot: u64, stage: u64, code: u64) reaches Kernel invokes Kernel; {
    let text: [u8; 25] = "Cathedral matrix: launch ";
    let mut words: [u64; 8];
    transition { _ -> pack(gate, &text, &mut words, 0u64, slot, stage, code) }
    machine pack(gate: &Gate, text: &[u8; 25], words: &mut [u64; 8], index: u64, slot: u64, stage: u64, code: u64) requires index <= 25u64 reaches Kernel {
        transition index < 25u64 {
            true -> byte(gate, text, words, index, slot, stage, code)
            _ -> numbered(gate, words, slot, stage, code)
        }
    }
    machine byte(gate: &Gate, text: &[u8; 25], words: &mut [u64; 8], index: u64, slot: u64, stage: u64, code: u64) requires index < 25u64 reaches Kernel {
        let word: u64 = index / 8u64;
        words[word] = words[word] | ((text[index] as u64) << ((index % 8u64) * 8u64));
        transition { _ -> pack(gate, text, words, index + 1u64, slot, stage, code) }
    }
    machine numbered(gate: &Gate, words: &mut [u64; 8], slot: u64, stage: u64, code: u64) reaches Kernel {
        put(words, 25u64, 48u64 + (slot & 7u64));
        put(words, 26u64, 32u64);
        hex(words, 27u64, stage, 0u64);
        put(words, 43u64, 32u64);
        hex(words, 44u64, code, 0u64);
        put(words, 60u64, 10u64);
        let status: u64 = Kernel::write(gate, words, 61u64);
    }
}
// The matrix's own use in hex: private pages, reader pages and channels, as
// the lab sizes a manifest from the console.
public machine budget(gate: &Gate) reaches Kernel invokes Kernel; {
    let mut record: [u64; 8];
    let status: u64 = Kernel::resource_budget(gate, &mut record);
    transition status == 0u64 { true -> known(gate, record[3], record[4], record[5]) _ -> done() }
    machine known(gate: &Gate, pages: u64, readers: u64, channels: u64) reaches Kernel {
        let text: [u8; 25] = "Cathedral matrix: budget ";
        let mut words: [u64; 8];
        transition { _ -> pack(gate, &text, &mut words, 0u64, pages, readers, channels) }
    }
    machine pack(gate: &Gate, text: &[u8; 25], words: &mut [u64; 8], index: u64, pages: u64, readers: u64, channels: u64)
        requires index <= 25u64 reaches Kernel {
        transition index < 25u64 {
            true -> byte(gate, text, words, index, pages, readers, channels)
            _ -> numbered(gate, words, pages, readers, channels)
        }
    }
    machine byte(gate: &Gate, text: &[u8; 25], words: &mut [u64; 8], index: u64, pages: u64, readers: u64, channels: u64)
        requires index < 25u64 reaches Kernel {
        let word: u64 = index / 8u64;
        words[word] = words[word] | ((text[index] as u64) << ((index % 8u64) * 8u64));
        transition { _ -> pack(gate, text, words, index + 1u64, pages, readers, channels) }
    }
    machine numbered(gate: &Gate, words: &mut [u64; 8], pages: u64, readers: u64, channels: u64) reaches Kernel {
        short(words, 25u64, pages, 0u64);
        put(words, 29u64, 32u64);
        short(words, 30u64, readers, 0u64);
        put(words, 34u64, 32u64);
        short(words, 35u64, channels, 0u64);
        put(words, 39u64, 10u64);
        let status: u64 = Kernel::write(gate, words, 40u64);
    }
}
// Four hex digits of a count below 65536.
machine short(words: &mut [u64; 8], start: u64, value: u64, digit: u64) requires start <= 60u64 && digit <= 4u64 {
    transition digit < 4u64 {
        true -> nibble(words, start, value, digit, (value >> (12u64 - 4u64 * digit)) & 15u64)
        _ -> done()
    }
    machine nibble(words: &mut [u64; 8], start: u64, value: u64, digit: u64, nibble: u64) requires start <= 60u64 && digit < 4u64 {
        transition {
            nibble < 10u64 -> placed(words, start, value, digit, 48u64 + nibble)
            nibble < 16u64 -> placed(words, start, value, digit, 87u64 + nibble)
            _ -> done()
        }
    }
    machine placed(words: &mut [u64; 8], start: u64, value: u64, digit: u64, byte: u64) requires start <= 60u64 && digit < 4u64 {
        put(words, start + digit, byte);
        transition { _ -> short(words, start, value, digit + 1u64) }
    }
}
// A child's launch this matrix refused, with the code in hex.
public machine launch_refused(gate: &Gate, code: u64) reaches Kernel invokes Kernel; {
    let text: [u8; 33] = "Cathedral matrix: launch refused ";
    let mut words: [u64; 8];
    transition { _ -> pack(gate, &text, &mut words, 0u64, code) }
    machine pack(gate: &Gate, text: &[u8; 33], words: &mut [u64; 8], index: u64, code: u64) requires index <= 33u64 reaches Kernel {
        transition index < 33u64 {
            true -> byte(gate, text, words, index, code)
            _ -> numbered(gate, words, code)
        }
    }
    machine byte(gate: &Gate, text: &[u8; 33], words: &mut [u64; 8], index: u64, code: u64) requires index < 33u64 reaches Kernel {
        let word: u64 = index / 8u64;
        words[word] = words[word] | ((text[index] as u64) << ((index % 8u64) * 8u64));
        transition { _ -> pack(gate, text, words, index + 1u64, code) }
    }
    machine numbered(gate: &Gate, words: &mut [u64; 8], code: u64) reaches Kernel {
        hex(words, 33u64, code, 0u64);
        put(words, 49u64, 10u64);
        let status: u64 = Kernel::write(gate, words, 50u64);
    }
}
machine put(words: &mut [u64; 8], index: u64, byte: u64) requires index < 64u64 {
    let word: u64 = index / 8u64;
    words[word] = words[word] | ((byte & 255u64) << ((index % 8u64) * 8u64));
}
machine hex(words: &mut [u64; 8], start: u64, value: u64, digit: u64) requires start <= 48u64 && digit <= 16u64 {
    transition digit < 16u64 {
        true -> nibble(words, start, value, digit, (value >> (60u64 - 4u64 * digit)) & 15u64)
        _ -> done()
    }
    machine nibble(words: &mut [u64; 8], start: u64, value: u64, digit: u64, nibble: u64) requires start <= 48u64 && digit < 16u64 {
        transition {
            nibble < 10u64 -> placed(words, start, value, digit, 48u64 + nibble)
            nibble < 16u64 -> placed(words, start, value, digit, 87u64 + nibble)
            _ -> done()
        }
    }
    machine placed(words: &mut [u64; 8], start: u64, value: u64, digit: u64, byte: u64) requires start <= 48u64 && digit < 16u64 {
        put(words, start + digit, byte);
        transition { _ -> hex(words, start, value, digit + 1u64) }
    }
}
machine done() {}
