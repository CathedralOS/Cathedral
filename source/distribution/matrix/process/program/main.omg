module main;
// The stock matrix as a standalone Omega process. At the display root it owns
// the owner-control connection the desktop supervises it through, the display
// connection it presents on, the source connection physical input arrives on,
// the provider links its storage comes over, the children it funds and admits,
// and the World that attenuates them. Under a parent matrix it owns the same
// owner control, the parent's broker connection it polls for its view and
// input and presents through, and the upstream storage connection its realm
// comes over. One turn takes the parent's snapshot when one is due, serves the
// owner, relays routed owner words to the children they name, serves the
// source and each child's interaction and storage connections, wakes the
// children the World has hints for, flushes owed erasures, then parks on
// every live interest. A nested instance also discovers its realm under the
// stock startup policy once the parent has placed it, configuring a workspace
// from the realm's saved record or starting a scoped picker, and the owner's
// CONFIGURE runs that configuration directly. In a workspace the chrome lists
// and selects the app instances; the Rust host remains the F5 matrix until
// this program reaches parity.
use runtime::entry::Program;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::time::Tick;
use runtime::waiting::Set;
use shared::state::State;
use startup;
use commands;
use children::forward;
use connections::upstream;
use realm::jobs;
use connections::source;
use children::slots;
use children::lifecycle;
use connections::presentation;
use connections::storage;

// How long a turn parks with nothing due, and with a parent's snapshot still owed.
public const IDLE_TICKS: u64 = 1000u64;
public const OWED_TICKS: u64 = 10u64;
public ProgramProvider satisfies Program {
    machine run(gate: &Gate, first: u64, second: u64) -> u64 reaches Kernel blocks; invokes Kernel; {
        let mut context: State;
        let status: u64 = block startup::open(gate, &mut context);
        transition status == 0u64 {
            true -> block serve(gate, &mut context)
            _ -> block cleanup(gate, &mut context, status)
        }
    }
}
machine serve(gate: &Gate, context: &mut State) -> u64 reaches Kernel {
    let tick: Tick = runtime::time::read(gate, context.clock);
    transition tick {
        Tick::Read { value } -> block turn(gate, context, value)
        _ -> block cleanup(gate, context, 401u64)
    }
}
machine turn(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    let polled: u64 = block upstream::step(gate, context, now);
    let settled: u64 = block jobs::step(gate, context, now);
    let commanded: u64 = block commands::step(gate, context, now);
    block lifecycle::open_controls(gate, context, now);
    let forwarded: u64 = block forward::step(gate, context, now);
    let sourced: u64 = block source::step(gate, context, now);
    let first: u64 = block slots::step(gate, context, 0u64, now);
    let second: u64 = block slots::step(gate, context, 1u64, now);
    let third: u64 = block slots::step(gate, context, 2u64, now);
    let fourth: u64 = block slots::step(gate, context, 3u64, now);
    let fifth: u64 = block slots::step(gate, context, 4u64, now);
    let stored: u64 = block storage::step(gate, context, now);
    lifecycle::notify(gate, context);
    let flushed: u64 = block presentation::flush(gate, context);
    lifecycle::settle(gate, context);
    transition polled == 0u64 && settled == 0u64 && commanded == 0u64 && forwarded == 0u64 && sourced == 0u64 && first == 0u64
        && second == 0u64 && third == 0u64 && fourth == 0u64 && fifth == 0u64 && stored == 0u64 && flushed == 0u64 {
        true -> block parked(gate, context, now)
        _ -> block cleanup(gate, context, 403u64)
    }
}
// Park on every live interest; the wake interval only bounds the next look,
// sooner while a parent's snapshot is still owed.
machine parked(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    let mut set: Set;
    runtime::waiting::reset(&mut set, runtime::time::after(now, park_ticks(context)));
    runtime::server::main::watch(&context.owner, &mut set);
    runtime::server::main::watch(&context.source, &mut set);
    upstream::watch(context, &mut set);
    forward::watch(context, &mut set);
    lifecycle::watch(context, 0u64, &mut set);
    lifecycle::watch(context, 1u64, &mut set);
    lifecycle::watch(context, 2u64, &mut set);
    lifecycle::watch(context, 3u64, &mut set);
    lifecycle::watch(context, 4u64, &mut set);
    storage::watch(context, &mut set);
    let status: u64 = block runtime::waiting::wait(gate, &set);
    transition status < kernel::ERROR_BASE || status == kernel::TIMED_OUT || status == kernel::PEER_CLOSED {
        true -> block serve(gate, context)
        _ -> block cleanup(gate, context, 404u64)
    }
}
machine park_ticks(context: &State) -> u64 {
    transition {
        context.frame_count != 0u64 || context.configure_queued -> (1u64)
        context.refresh_due -> (OWED_TICKS)
        _ -> (IDLE_TICKS)
    }
}
machine cleanup(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
    block lifecycle::reclaim(gate, context, 0u64);
    block lifecycle::reclaim(gate, context, 1u64);
    block lifecycle::reclaim(gate, context, 2u64);
    block lifecycle::reclaim(gate, context, 3u64);
    block lifecycle::reclaim(gate, context, 4u64);
    block storage::close(gate, context);
    block presentation::release_images(gate, context, 0u64);
    block runtime::server::main::close(gate, &mut context.source);
    block runtime::server::main::close(gate, &mut context.owner);
    block upstream::close(gate, context);
    transition context.has_scene {
        true -> block scene_closed(gate, context, status)
        _ -> (status)
    }
}
machine scene_closed(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
    let ignored: u64 = block runtime::connection::main::close(gate, &mut context.scene);
    status
}
public machine component_entry() reaches Program + Kernel blocks; invokes Program; invokes Kernel; {
    let gate: Gate;
    let status: u64 = block Program::run(&gate, 0u64, 0u64);
}
