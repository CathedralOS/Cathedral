module main;
// The stock matrix as a standalone Omega process. At the display root it owns
// the owner-control connection the desktop supervises it through, the display
// connection it presents on, the source connection physical input arrives on,
// and the World that attenuates its children. One turn serves the owner and
// the source, then parks on both. Children, presentation, storage and nested
// operation arrive slice by slice; the Rust host remains the F5 matrix until
// this program reaches parity.
use runtime::entry::Program;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::server::main::Server;
use runtime::connection::main::Peer;
use runtime::time::Tick;
use runtime::waiting::Set;
use world::level::World;
use startup;
use commands;
use source;

public const CHILDREN: u64 = 5u64;
// Owner-declared policy for the next launch into a slot.
public data SlotPolicy [copy] {
    images: u64;
    private_pages: u64;
    reader_pages: u64;
    channels: u64;
    descendants: u64;
    cpu: u64;
    surfaces: u64;
    placed: bool;
    x: u64;
    y: u64;
    width: u64;
    height: u64;
    keys: u64;
}
public data State {
    owner: Server;
    source: Server;
    scene: Peer;
    has_scene: bool;
    world: World;
    clock: u64;
    // The bound extent and keys of the root display.
    width: u64;
    height: u64;
    keys: u64;
    policies: [SlotPolicy; 5];
}
public ProgramProvider satisfies Program {
    machine run(gate: &Gate, first: u64, second: u64) -> u64 reaches Kernel blocks; invokes Kernel; {
        let mut context: State;
        let status: u64 = block startup::open(gate, &mut context);
        transition status == 0u64 {
            true -> block serve(gate, &mut context)
            _ -> block cleanup(gate, &mut context, status)
        }
    }
}
machine serve(gate: &Gate, context: &mut State) -> u64 reaches Kernel {
    let tick: Tick = runtime::time::read(gate, context.clock);
    transition tick {
        Tick::Read { value } -> block turn(gate, context, value)
        _ -> block cleanup(gate, context, 401u64)
    }
}
machine turn(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    let commanded: u64 = block commands::step(gate, context, now);
    let sourced: u64 = block source::step(gate, context, now);
    transition commanded == 0u64 && sourced == 0u64 {
        true -> block parked(gate, context, now)
        _ -> block cleanup(gate, context, 403u64)
    }
}
// Park on every live interest; the wake interval only bounds the next look.
machine parked(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    let mut set: Set;
    runtime::waiting::reset(&mut set, runtime::time::after(now, 1000u64));
    runtime::server::main::watch(&context.owner, &mut set);
    runtime::server::main::watch(&context.source, &mut set);
    let status: u64 = block runtime::waiting::wait(gate, &set);
    transition status < kernel::ERROR_BASE || status == kernel::TIMED_OUT || status == kernel::PEER_CLOSED {
        true -> block serve(gate, context)
        _ -> block cleanup(gate, context, 404u64)
    }
}
machine cleanup(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
    block runtime::server::main::close(gate, &mut context.source);
    block runtime::server::main::close(gate, &mut context.owner);
    transition context.has_scene {
        true -> block scene_closed(gate, context, status)
        _ -> (status)
    }
}
machine scene_closed(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
    let ignored: u64 = block runtime::connection::main::close(gate, &mut context.scene);
    status
}
public machine component_entry() reaches Program + Kernel blocks; invokes Program; invokes Kernel; {
    let gate: Gate;
    let status: u64 = block Program::run(&gate, 0u64, 0u64);
}
