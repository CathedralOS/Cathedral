use {background}/startup.omg;
// Exit after Background's actual startup acquired its service custody. The
// kernel must reap that custody; the owning matrix decides retry and fallback.
use {runtime}/entry.omg;
use {runtime}/kernel.omg;
use {background}/main.omg;
public ProgramProvider satisfies |entry|::Program {
    machine run(gate: &|kernel|::Gate, first: u64, second: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
        let mut context: |main|::Context;
        let status: u64 = block |startup|::open(gate, &mut context);
        transition status == 0u64 {
            true -> failed(gate)
            _ -> (status)
        }
    }
}
machine failed(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8];
    words[0] = 0x61726562696c6564u64;
    words[1] = 0x676b636162206574u64;
    words[2] = 0x747320646e756f72u64;
    words[3] = 0x6166207075747261u64;
    words[4] = 0x00000a6572756c69u64;
    let written: u64 = |kernel|::Kernel::write(gate, &words, 38u64);
    1u64
}

public machine component_entry() reaches |entry|::Program + |kernel|::Kernel blocks invokes |entry|::Program invokes |kernel|::Kernel {
    let gate: |kernel|::Gate;
    let status: u64 = block |entry|::Program::run(&gate, 0u64, 0u64);
}
