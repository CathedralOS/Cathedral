use {runtime}/kernel.omg;
use {runtime}/notification/main.omg;
use {runtime}/ipc/main.omg as ipc_main;

public machine check(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let first: u64 = block once(gate);
    transition first == 0u64 {
        true -> block once(gate)
        _ -> (first)
    }
}
machine once(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel {
    let opened: |ipc_main|::Opened = |ipc_main|::open(gate);
    transition opened {
        |ipc_main|::Opened::Ready { channel } -> block created(gate, channel)
        _ -> (140u64)
    }
}
machine created(gate: &|kernel|::Gate, channel: |ipc_main|::Channel) -> u64 reaches |kernel|::Kernel {
    let creation: |main|::Creation = |main|::create(gate);
    transition creation {
        |main|::Creation::Ready { bell } -> block transferred(gate, channel, bell)
        _ -> finish(gate, channel, 141u64)
    }
}
machine transferred(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell) -> u64 reaches |kernel|::Kernel {
    let sent: u64 = |main|::delegate(gate, bell.signal, channel.sender, 0x123456789abcdef0u64);
    transition sent == 8u64 {
        true -> block accepted(gate, channel, bell)
        _ -> close(gate, channel, bell, 142u64)
    }
}
machine accepted(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell) -> u64 reaches |kernel|::Kernel {
    let acceptance: |main|::Acceptance = block |main|::accept(gate, channel.receiver);
    transition acceptance {
        |main|::Acceptance::Ready { signal, correlation } -> block checked(gate, channel, bell, signal, correlation)
        _ -> close(gate, channel, bell, 143u64)
    }
}
machine checked(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell, signal: |main|::Signal, correlation: u64) -> u64 reaches |kernel|::Kernel {
    let denied: u64 = |kernel|::Kernel::notify_signal(gate, bell.wait);
    let sent: u64 = |main|::signal(gate, &signal);
    transition denied == 0xfffffffffffffff3u64 && sent == 0u64 && signal.handle != bell.signal
        && correlation == 0x123456789abcdef0u64 {
        true -> block received(gate, channel, bell, signal)
        _ -> release(gate, channel, bell, signal, 144u64)
    }
}
machine received(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell, signal: |main|::Signal) -> u64 reaches |kernel|::Kernel {
    let outcome: |main|::Outcome = block |main|::wait(gate, &bell, 0u64, 0u64);
    transition outcome {
        |main|::Outcome::Signaled -> block revoked(gate, channel, bell, signal)
        _ -> release(gate, channel, bell, signal, 145u64)
    }
}
machine revoked(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell, signal: |main|::Signal) -> u64 reaches |kernel|::Kernel {
    let revoked: u64 = |kernel|::Kernel::notify_control(gate, bell.control, 1u64);
    let outcome: |main|::Outcome = block |main|::wait(gate, &bell, 0u64, 0u64);
    transition outcome {
        // A wait already parked gets Outcome::Revoked. A NEW wait on withdrawn
        // authority is refused before registration, with the kernel error.
        |main|::Outcome::Failed { code } -> refusal(gate, channel, bell, signal, revoked, code)
        _ -> release(gate, channel, bell, signal, 146u64)
    }
}
machine refusal(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell, signal: |main|::Signal, revoked: u64, code: u64) -> u64 reaches |kernel|::Kernel {
    transition revoked == 0u64 && code == 0xffffffffffffff83u64 {
        true -> release(gate, channel, bell, signal, 0u64)
        _ -> release(gate, channel, bell, signal, 146u64)
    }
}
machine release(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell, signal: |main|::Signal, result: u64) -> u64 reaches |kernel|::Kernel {
    let mut owned: |main|::Signal = signal;
    let old: u64 = owned.handle;
    let released: u64 = |main|::release(gate, &mut owned);
    let stale: u64 = |kernel|::Kernel::notify_signal(gate, old);
    transition released == 0u64 && owned.handle == 0u64 && stale == 0xfffffffffffffff7u64 {
        true -> close(gate, channel, bell, result)
        _ -> close(gate, channel, bell, 147u64)
    }
}
machine close(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, bell: |main|::Bell, result: u64) -> u64 reaches |kernel|::Kernel {
    let mut owned: |main|::Bell = bell;
    let closed: u64 = |main|::close(gate, &mut owned);
    transition closed == 0u64 {
        true -> finish(gate, channel, result)
        _ -> finish(gate, channel, 148u64)
    }
}
machine finish(gate: &|kernel|::Gate, channel: |ipc_main|::Channel, result: u64) -> u64 reaches |kernel|::Kernel {
    let closed: u64 = |ipc_main|::close(gate, channel);
    transition closed == 0u64 {
        true -> (result)
        _ -> (149u64)
    }
}
