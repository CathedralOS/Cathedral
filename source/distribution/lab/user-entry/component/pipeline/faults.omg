use {runtime}/connection/mailbox.omg;
// Deliberately bypass reply tickets to test rejection at the receiving peer.
use {runtime}/kernel.omg;
use {runtime}/server/main.omg;
public machine wrong_reply(gate: &|kernel|::Gate, listener: &mut |main|::Server, id: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = 2u64;
    block |mailbox|::send(gate, &mut listener.peer, id, &words, 0u64)
}
// A valid sealed grant arrives for the second request, but no frame follows.
// The receiver must expire the partial pair and release that reader too.
public machine attachment_only(gate: &|kernel|::Gate, listener: &|main|::Server) -> u64 reaches |kernel|::Kernel invokes |kernel|::Kernel {
    let mut packet: [u64; 10];
    packet[0] = 8u64;
    packet[1] = listener.held_object;
    packet[2] = listener.pending;
    let sent: u64 = |kernel|::Kernel::object_send(gate, listener.peer.sender, &packet);
    transition sent == 8u64 { true -> (0u64) _ -> (sent) }
}
