module pipeline::main;
// Both ends are ordinary Omega programs in separate tasks. The first operation
// remains outstanding while the second returns its sealed input, then a third
// operation reuses the freed slot before the first is answered.
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use pipeline::client;
use pipeline::server;
public machine check(gate: &Gate, mode: u64) -> u64 reaches Kernel blocks invokes Kernel {
    transition (mode & 1u64) != 0u64 {
        true -> block server::check(gate, mode)
        _ -> block client::check(gate, mode)
    }
}
