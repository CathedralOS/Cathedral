use {runtime}/connection/requests.omg;
use pipeline/barrier.omg;
use {runtime}/kernel.omg;
use {runtime}/connection/main.omg;
use {runtime}/time.omg;
public data State {
    peer: |main|::Peer;
    mode: u64;
    stopped: bool;
    barrier: u64;
    backpressured: bool;
    clock: u64;
    deadline: u64;
    object: u64;
    stage: u64;
    first: u64;
    second: u64;
    third: u64;
    first_done: bool;
    third_done: bool;
}
public machine check(gate: &|kernel|::Gate, mode: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut context: State;
    context.mode = mode;
    context.clock = |kernel|::Kernel::clock(gate);
    let mut env: [u64; 8];
    let installed: u64 = |kernel|::Kernel::environment(gate, &mut env);
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block open(gate, &mut context, installed, env, value)
        _ -> (500u64)
    }
}
machine open(gate: &|kernel|::Gate, context: &mut State, installed: u64, env: [u64; 8], now: u64) -> u64 reaches |kernel|::Kernel {
    context.barrier = env[3];
    transition installed == 0u64 && env[0] == 3u64 {
        true -> block connecting(gate, context, env, now)
        _ -> (501u64)
    }
    machine connecting(gate: &|kernel|::Gate, context: &mut State, env: [u64; 8], now: u64) -> u64 reaches |kernel|::Kernel {
        context.deadline = |time|::after(now, 2000u64);
        let status: u64 = block |main|::connect_pipeline(gate, &mut context.peer, env[1], env[2], |time|::after(now, 300u64));
        transition status == 0u64 { true -> block backing(gate, context) _ -> block close(gate, context, 502u64) }
    }
}
machine backing(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 2048];
    words[0] = 173u64;
    let object: u64 = block |kernel|::Kernel::object_create(gate, &words, 8u64);
    transition object != 0u64 && object < |kernel|::ERROR_BASE {
        true -> block ready(gate, context, object)
        _ -> block close(gate, context, 503u64)
    }
    machine ready(gate: &|kernel|::Gate, context: &mut State, object: u64) -> u64 reaches |kernel|::Kernel {
        context.object = object;
        block run(gate, context)
    }
}
machine run(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block turn(gate, context, value)
        _ -> block close(gate, context, 504u64)
    }
}
machine turn(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition |time|::reached(now, context.deadline) {
        true -> block close(gate, context, 505u64)
        _ -> block advancing(gate, context, now)
    }
    machine advancing(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = block step(gate, context, now);
        transition {
            status != 0u64 -> block close(gate, context, status)
            context.stopped -> block close(gate, context, 0u64)
            context.first_done && context.third_done -> block finished(gate, context)
            _ -> block parked(gate, context, now)
        }
    }
    machine parked(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
        let ignored: u64 = block |time|::park_until(gate, |time|::after(now, 1u64));
        block run(gate, context)
    }
}
machine step(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition {
        context.stage == 0u64 -> block send(gate, context, 1u64, context.object)
        context.stage == 1u64 -> block send(gate, context, 2u64, context.object)
        context.stage == 2u64 -> block bounded(gate, context)
        context.stage == 4u64 -> block send(gate, context, 3u64, 0u64)
        _ -> block receive(gate, context, now)
    }
}
machine send(gate: &|kernel|::Gate, context: &mut State, op: u64, object: u64) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = op;
    let sent: |main|::Submission = block |main|::submit(gate, &mut context.peer, &words, object);
    transition sent {
        |main|::Submission::Submitted { request } -> submitted(context, op, request)
        |main|::Submission::Backpressure -> block backpressure(gate, context, op)
        |main|::Submission::Failed { code } -> (506u64)
    }
}
// The provider waits on this separate test channel before consuming request one.
// Only an attached submission that really hit mailbox backpressure opens it.
machine backpressure(gate: &|kernel|::Gate, context: &mut State, op: u64) -> u64 reaches |kernel|::Kernel {
    transition op == 2u64 && context.barrier != 0u64 {
        true -> block checked(gate, context)
        _ -> (0u64)
    }
    machine checked(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
        transition context.mode == 410u64 {
            true -> block consumed(gate, context)
            _ -> released(gate, context)
        }
    }
    machine consumed(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
        let ready: bool = block |barrier|::consumed(gate, &context.peer);
        transition ready { true -> released(gate, context) _ -> (0u64) }
    }
    machine released(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
        let status: u64 = |barrier|::release(gate, context.barrier);
        context.barrier = 0u64;
        context.backpressured = status == 0u64;
        status
    }
}
machine submitted(context: &mut State, op: u64, id: u64) -> u64 {
    transition op {
        1u64 -> first(context, id)
        2u64 -> second(context, id)
        _ -> third(context, id)
    }
    machine first(context: &mut State, id: u64) -> u64 { context.first = id; context.stage = 1u64; 0u64 }
    machine second(context: &mut State, id: u64) -> u64 { context.second = id; context.stage = 2u64; 0u64 }
    machine third(context: &mut State, id: u64) -> u64 { context.third = id; context.stage = 5u64; 0u64 }
}
machine bounded(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = 99u64;
    let ordinary: u64 = block |main|::begin(gate, &mut context.peer, &words);
    let extra: |main|::Submission = block |main|::submit(gate, &mut context.peer, &words, 0u64);
    transition extra {
        |main|::Submission::Backpressure -> checked(context, ordinary)
        _ -> (507u64)
    }
    machine checked(context: &mut State, ordinary: u64) -> u64 {
        context.stage = 3u64;
        transition ordinary == |kernel|::BUSY && context.backpressured { true -> (0u64) _ -> (508u64) }
    }
}
machine receive(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    // Do not consume the first plain reply until the provider has actually
    // filled its reply mailbox and parked for the acknowledgement wake.
    transition context.mode == 400u64 && context.stage == 5u64 && !context.first_done {
        true -> block gated(gate, context, now)
        _ -> block receiving(gate, context, now)
    }
    machine gated(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
        let ready: bool = block |barrier|::reply_blocked(gate, &context.peer);
        transition ready { true -> block receiving(gate, context, now) _ -> (0u64) }
    }
}
machine receiving(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    let reply: |main|::Reply = block |main|::poll(gate, &mut context.peer, now);
    transition reply {
        |main|::Reply::Pending -> (0u64)
        |main|::Reply::Object { frame, object } -> block image(gate, context, frame.id, frame.payload, object)
        |main|::Reply::Complete { frame, notification } -> plain(gate, context, frame.id, frame.payload, notification)
        |main|::Reply::Endpoint { frame, endpoint } -> endpoint(gate, endpoint)
        |main|::Reply::Failed { code } -> failed(context, code)
    }
}
machine image(gate: &|kernel|::Gate, context: &mut State, id: u64, words: [u64; 8], object: u64) -> u64 reaches |kernel|::Kernel {
    let mut data: [u64; 8];
    let read: u64 = block |kernel|::Kernel::object_read(gate, object, 0u64, &mut data, 1u64);
    let released: u64 = block |kernel|::Kernel::memory_release(gate, object);
    transition context.stage == 3u64 && id == context.second && words[0] == 2u64 && data[0] == 173u64 && read == 0u64 && released == 0u64 {
        true -> next(context)
        _ -> (510u64)
    }
    machine next(context: &mut State) -> u64 { context.stage = 4u64; 0u64 }
}
machine plain(gate: &|kernel|::Gate, context: &mut State, id: u64, words: [u64; 8], notification: u64) -> u64 reaches |kernel|::Kernel {
    transition notification != 0u64 {
        true -> drop_notification(gate, notification)
        _ -> arrived(context, id, words)
    }
    machine arrived(context: &mut State, id: u64, words: [u64; 8]) -> u64 {
        transition {
            context.stage != 5u64 -> (511u64)
            id == context.first && words[0] == 1u64 && !context.first_done -> first(context)
            id == context.third && words[0] == 3u64 && !context.third_done -> third(context)
            _ -> (512u64)
        }
    }
    machine first(context: &mut State) -> u64 { context.first_done = true; 0u64 }
    machine third(context: &mut State) -> u64 { context.third_done = true; 0u64 }
    machine drop_notification(gate: &|kernel|::Gate, notification: u64) -> u64 reaches |kernel|::Kernel { let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification); 513u64 }
}
machine endpoint(gate: &|kernel|::Gate, endpoint: u64) -> u64 reaches |kernel|::Kernel { let ignored: u64 = |kernel|::Kernel::close(gate, endpoint); 514u64 }
machine finished(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    transition |requests|::empty(&context.peer.requests) && context.first < context.second && context.second < context.third {
        true -> block close(gate, context, 0u64)
        _ -> block close(gate, context, 515u64)
    }
}
machine close(gate: &|kernel|::Gate, context: &mut State, status: u64) -> u64 reaches |kernel|::Kernel {
    let closed: u64 = block |main|::close(gate, &mut context.peer);
    |barrier|::close(gate, context.barrier);
    context.barrier = 0u64;
    transition context.object != 0u64 {
        true -> block release(gate, context, status)
        _ -> (status)
    }
    machine release(gate: &|kernel|::Gate, context: &mut State, status: u64) -> u64 reaches |kernel|::Kernel { let ignored: u64 = block |kernel|::Kernel::memory_release(gate, context.object); context.object = 0u64; status }
}

// Failure must retire both outstanding IDs and every partial reply right.
machine failed(context: &mut State, code: u64) -> u64 {
    let expected: u64 = failure_code(context.mode);
    transition {
        expected == 0u64 -> (509u64)
        code != expected -> (code)
        context.peer.fault != code -> (516u64)
        |requests|::empty(&context.peer.requests) -> stopped(context)
        _ -> (517u64)
    }
    machine stopped(context: &mut State) -> u64 { context.stopped = true; 0u64 }
}
machine failure_code(mode: u64) -> u64 {
    transition mode {
        402u64 -> (|kernel|::PEER_CLOSED)
        404u64 -> (|kernel|::IO_ERROR)
        406u64 -> (|kernel|::IO_ERROR)
        408u64 -> (|kernel|::TIMED_OUT)
        _ -> (0u64)
    }
}
