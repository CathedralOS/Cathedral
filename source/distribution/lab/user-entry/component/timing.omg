use {runtime}/kernel.omg;
use {runtime}/time.omg;

public machine check(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let clock: u64 = |kernel|::Kernel::clock(gate);
    transition clock < 0x8000000000000000u64 {
        true -> block read(gate, clock)
        _ -> block denied(gate, clock)
    }
}
machine denied(gate: &|kernel|::Gate, clock: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |time|::park_until(gate, 0u64);
    transition clock == 0xfffffffffffffff3u64 && status == clock {
        true -> (0u64)
        _ -> (111u64)
    }
}
machine read(gate: &|kernel|::Gate, clock: u64) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> block park(gate, clock, |time|::after(value, 2u64))
        _ -> (112u64)
    }
}
machine park(gate: &|kernel|::Gate, clock: u64, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |time|::park_until(gate, deadline);
    transition status == 0xffffffffffffff92u64 {
        true -> awakened(gate, clock, deadline)
        _ -> (113u64)
    }
}
machine awakened(gate: &|kernel|::Gate, clock: u64, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> elapsed(gate, |time|::reached(value, deadline))
        _ -> (114u64)
    }
}
machine elapsed(gate: &|kernel|::Gate, reached: bool) -> u64 reaches |kernel|::Kernel {
    transition reached {
        true -> report(gate)
        _ -> (115u64)
    }
}
machine report(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel {
    let mut message: [u64; 8];
    // "Omega wait ready\n".
    message[0] = 0x6177206167656d4fu64;
    message[1] = 0x7964616572207469u64;
    message[2] = 10u64;
    let bytes: u64 = |kernel|::Kernel::write(gate, &message, 17u64);
    transition bytes == 17u64 {
        true -> (0u64)
        _ -> (116u64)
    }
}
