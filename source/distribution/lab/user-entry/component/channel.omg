use {runtime}/kernel.omg;
use {runtime}/ipc/main.omg;

// Two transport objects of quota; repeated exchange proves close refunded it.
public machine check(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let result: u64 = block once(gate);
    transition result == 0u64 {
        true -> block once(gate)
        _ -> (result)
    }
}

machine once(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel {
    let opened: |main|::Opened = |main|::open(gate);
    transition opened {
        |main|::Opened::Ready { channel } -> block capacity(gate, channel)
        _ -> (102u64)
    }
}

machine capacity(gate: &|kernel|::Gate, channel: |main|::Channel) -> u64 reaches |kernel|::Kernel {
    let extra: |main|::Opened = |main|::open(gate);
    transition extra {
        |main|::Opened::Failed { code } -> cleanup(gate, channel, 109u64)
        |main|::Opened::Ready { channel as other } -> block exhausted(gate, channel, other)
    }
}
machine exhausted(gate: &|kernel|::Gate, channel: |main|::Channel, other: |main|::Channel) -> u64 reaches |kernel|::Kernel {
    let extra: |main|::Opened = |main|::open(gate);
    let ignored: u64 = |main|::close(gate, other);
    transition extra {
        |main|::Opened::Failed { code } -> block exchange(gate, channel)
        |main|::Opened::Ready { channel as third } -> unexpected_capacity(gate, channel, third)
    }
}
machine unexpected_capacity(gate: &|kernel|::Gate, channel: |main|::Channel, other: |main|::Channel) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |main|::close(gate, other);
    cleanup(gate, channel, 109u64)
}

machine exchange(gate: &|kernel|::Gate, channel: |main|::Channel) -> u64 reaches |kernel|::Kernel {
    let mut sent: [u64; 8];
    sent[0] = 0x123456789abcdef0u64;
    sent[7] = 0xfedcba9876543210u64;
    let bytes: u64 = |main|::send(gate, channel.sender, &sent, 64u64);
    transition bytes == 64u64 && sent[0] == 0x123456789abcdef0u64
        && sent[7] == 0xfedcba9876543210u64 {
        true -> block receive(gate, channel)
        _ -> cleanup(gate, channel, 103u64)
    }
}

machine receive(gate: &|kernel|::Gate, channel: |main|::Channel) -> u64 reaches |kernel|::Kernel {
    let mut received: [u64; 8];
    let result: |main|::Received = block |main|::receive(gate, channel.receiver, &mut received);
    transition result {
        |main|::Received::Message { bytes } -> contents(gate, channel, bytes, received)
        _ -> cleanup(gate, channel, 104u64)
    }
}
machine contents(gate: &|kernel|::Gate, channel: |main|::Channel, bytes: u64, received: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    transition bytes == 64u64 && received[0] == 0x123456789abcdef0u64
        && received[7] == 0xfedcba9876543210u64 {
        true -> cleanup(gate, channel, 0u64)
        _ -> cleanup(gate, channel, 104u64)
    }
}

machine cleanup(gate: &|kernel|::Gate, channel: |main|::Channel, result: u64) -> u64 reaches |kernel|::Kernel {
    let sender: u64 = channel.sender;
    let closed: u64 = |main|::close(gate, channel);
    transition closed == 0u64 {
        true -> retired(gate, sender, result)
        _ -> (105u64)
    }
}
machine retired(gate: &|kernel|::Gate, sender: u64, result: u64) -> u64 reaches |kernel|::Kernel {
    let message: [u64; 8];
    let sent: u64 = |main|::send(gate, sender, &message, 0u64);
    transition sent == 0xfffffffffffffff7u64 {
        true -> (result)
        _ -> (110u64)
    }
}
