module service::main;
// Three independent connections: two clients plus the supplied owner. One turn
// polls each exactly once, then parks on all live interests and bounded deadlines.
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::server::main::Server;
use runtime::time::Tick;
use runtime::waiting::Set;
use service::requests;
use service::startup;
public data State {
    clients: [Server; 3];
    clock: u64;
    deadline: u64;
    stopped: bool;
    handled: u64;
    parks: u64;
}
public machine check(gate: &Gate) -> u64 reaches Kernel blocks; invokes Kernel; {
    let mut context: State;
    let status: u64 = block startup::open(gate, &mut context);
    transition status == 0u64 {
        true -> block run(gate, &mut context)
        _ -> block cleanup(gate, &mut context, status)
    }
}
machine run(gate: &Gate, context: &mut State) -> u64 reaches Kernel {
    let tick: Tick = runtime::time::read(gate, context.clock);
    transition tick {
        Tick::Read { value } -> block turn(gate, context, value)
        _ -> block cleanup(gate, context, 201u64)
    }
}
machine turn(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    transition runtime::time::reached(now, context.deadline) {
        true -> block cleanup(gate, context, 202u64)
        _ -> block clients(gate, context, now)
    }
}
machine clients(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    let first: u64 = block requests::step(gate, context, 0u64, now);
    let second: u64 = block requests::step(gate, context, 1u64, now);
    let owner: u64 = block requests::step(gate, context, 2u64, now);
    transition first == 0u64 && second == 0u64 && owner == 0u64 {
        true -> block wait(gate, context, now)
        _ -> block cleanup(gate, context, 203u64)
    }
}
machine wait(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
    transition context.stopped {
        true -> block cleanup(gate, context, 0u64)
        _ -> block parked(gate, context, now)
    }
    machine parked(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel {
        let mut set: Set;
        runtime::waiting::reset(&mut set, context.deadline);
        runtime::server::main::watch(&context.clients[0], &mut set);
        runtime::server::main::watch(&context.clients[1], &mut set);
        runtime::server::main::watch(&context.clients[2], &mut set);
        let status: u64 = block runtime::waiting::wait(gate, &set);
        context.parks = ((context.parks as u64 in Wrapping) + 1u64) as u64;
        transition status < kernel::ERROR_BASE || status == kernel::TIMED_OUT || status == kernel::PEER_CLOSED {
            true -> block run(gate, context)
            _ -> block cleanup(gate, context, 204u64)
        }
    }
}
machine cleanup(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
    block runtime::server::main::close(gate, &mut context.clients[0]);
    block runtime::server::main::close(gate, &mut context.clients[1]);
    block runtime::server::main::close(gate, &mut context.clients[2]);
    status
}
