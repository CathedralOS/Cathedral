// Three independent connections: two clients plus the supplied owner. One turn
// polls each exactly once, then parks on all live interests and bounded deadlines.
use {runtime}/kernel.omg;
use {runtime}/server/main.omg;
use {runtime}/time.omg;
use {runtime}/waiting.omg;
use service/requests.omg;
use service/startup.omg;
public data State {
    clients: [|main|::Server; 3];
    clock: u64;
    deadline: u64;
    stopped: bool;
    handled: u64;
    parks: u64;
}
public machine check(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut context: State;
    let status: u64 = block |startup|::open(gate, &mut context);
    transition status == 0u64 {
        true -> block run(gate, &mut context)
        _ -> block cleanup(gate, &mut context, status)
    }
}
machine run(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block turn(gate, context, value)
        _ -> block cleanup(gate, context, 201u64)
    }
}
machine turn(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition |time|::reached(now, context.deadline) {
        true -> block cleanup(gate, context, 202u64)
        _ -> block clients(gate, context, now)
    }
}
machine clients(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    let first: u64 = block |requests|::step(gate, context, 0u64, now);
    let second: u64 = block |requests|::step(gate, context, 1u64, now);
    let owner: u64 = block |requests|::step(gate, context, 2u64, now);
    transition first == 0u64 && second == 0u64 && owner == 0u64 {
        true -> block wait(gate, context, now)
        _ -> block cleanup(gate, context, 203u64)
    }
}
machine wait(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition context.stopped {
        true -> block cleanup(gate, context, 0u64)
        _ -> block parked(gate, context, now)
    }
    machine parked(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
        let mut set: |waiting|::Set;
        |waiting|::reset(&mut set, context.deadline);
        |main|::watch(&context.clients[0], &mut set);
        |main|::watch(&context.clients[1], &mut set);
        |main|::watch(&context.clients[2], &mut set);
        let status: u64 = block |waiting|::wait(gate, &set);
        context.parks = ((context.parks as u64 in Wrapping) + 1u64) as u64;
        transition status < |kernel|::ERROR_BASE || status == |kernel|::TIMED_OUT || status == |kernel|::PEER_CLOSED {
            true -> block run(gate, context)
            _ -> block cleanup(gate, context, 204u64)
        }
    }
}
machine cleanup(gate: &|kernel|::Gate, context: &mut State, status: u64) -> u64 reaches |kernel|::Kernel {
    block |main|::close(gate, &mut context.clients[0]);
    block |main|::close(gate, &mut context.clients[1]);
    block |main|::close(gate, &mut context.clients[2]);
    status
}
