use {runtime}/server/main.omg as server_main;
use service/main.omg;
use {runtime}/kernel.omg;
use {runtime}/time.omg;
public machine open(gate: &|kernel|::Gate, context: &mut |main|::State) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    context.clock = |kernel|::Kernel::clock(gate);
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> installed(gate, context, value)
        _ -> (205u64)
    }
}
machine installed(gate: &|kernel|::Gate, context: &mut |main|::State, now: u64) -> u64 reaches |kernel|::Kernel {
    let mut env: [u64; 8];
    let status: u64 = |kernel|::Kernel::environment(gate, &mut env);
    transition status == 0u64 && env[0] == 4u64 {
        true -> connections(gate, context, now, env)
        _ -> (206u64)
    }
}
machine connections(gate: &|kernel|::Gate, context: &mut |main|::State, now: u64, env: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    let receiver: u64 = |kernel|::Kernel::bootstrap(gate, 0u64);
    let sender: u64 = |kernel|::Kernel::bootstrap(gate, 1u64);
    let deadline: u64 = |time|::after(now, 300u64);
    context.deadline = |time|::after(now, 3000u64);
    let a: u64 = |server_main|::begin(&mut context.clients[0], env[2], env[1], deadline, true);
    let b: u64 = |server_main|::begin(&mut context.clients[1], env[4], env[3], deadline, true);
    let c: u64 = |server_main|::begin(&mut context.clients[2], sender, receiver, deadline, false);
    transition a == 0u64 && b == 0u64 && c == 0u64 { true -> (0u64) _ -> (207u64) }
}
