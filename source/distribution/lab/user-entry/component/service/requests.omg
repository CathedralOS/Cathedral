use service/main.omg;
use {runtime}/kernel.omg;
use {runtime}/server/main.omg as server_main;
use {runtime}/connection/main.omg as connection_main;
public machine step(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.clients[index].peer.fault != 0u64 {
        true -> (0u64)
        _ -> block active(gate, context, index, now)
    }
}
machine active(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], now: u64) -> u64 reaches |kernel|::Kernel {
    transition context.clients[index].pending != 0u64 {
        true -> block held(gate, context, index, now)
        _ -> block receive(gate, context, index, now)
    }
}
machine held(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], now: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |server_main|::maintain(gate, &mut context.clients[index], now);
    0u64
}
machine receive(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], now: u64) -> u64 reaches |kernel|::Kernel {
    let event: |server_main|::Event = block |server_main|::poll(gate, &mut context.clients[index], now);
    transition event {
        |server_main|::Event::Request { frame } -> block request(gate, context, index, frame)
        |server_main|::Event::Pending -> (0u64)
        |server_main|::Event::Failed { code } -> (0u64)
    }
}
machine request(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 {
        true -> block routed(gate, context, index, frame)
        _ -> (208u64)
    }
}
machine routed(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    transition index == 2u64 {
        true -> block owner(gate, context, frame)
        _ -> block client(gate, context, index, frame)
    }
}
machine owner(gate: &|kernel|::Gate, context: &mut |main|::State, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let mut reply: [u64; 8];
    reply[0] = context.clients[0].peer.fault;
    reply[1] = context.clients[0].object;
    reply[2] = context.clients[0].pending;
    reply[3] = context.handled;
    reply[4] = context.parks;
    reply[5] = context.clients[0].peer.grant;
    reply[6] = context.clients[0].peer.frame.id;
    context.stopped = frame.payload[0] == 99u64;
    block |server_main|::reply(gate, &mut context.clients[2], &reply)
}
machine client(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let issued: |server_main|::Ticket = |server_main|::ticket(&context.clients[index]);
    // Wrong generation, then wrong ID: neither may consume the real request.
    let stale: |server_main|::Ticket = |server_main|::Ticket { incarnation: 0u64, receiver: issued.receiver, request: issued.request };
    let wrong: u64 = block |server_main|::reply_to(gate, &mut context.clients[index], stale, &frame.payload);
    let stale_id: |server_main|::Ticket = |server_main|::Ticket { incarnation: issued.incarnation, receiver: issued.receiver, request: 0u64 };
    let wrong_id: u64 = block |server_main|::reply_to(gate, &mut context.clients[index], stale_id, &frame.payload);
    transition wrong != 0u64 && wrong_id != 0u64 {
        true -> block connection(gate, context, index, frame, issued)
        _ -> (209u64)
    }
}
// The first B request has the same generation and request ID as held A.
// Its genuine ticket must still be rejected when presented to B's server.
machine connection(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], frame: |connection_main|::Frame, issued: |server_main|::Ticket) -> u64 reaches |kernel|::Kernel {
    transition index == 1u64 && context.clients[0].pending != 0u64 {
        true -> block foreign_ticket(gate, context, index, frame, issued)
        _ -> block valid(gate, context, index, frame, issued)
    }
}
machine foreign_ticket(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], frame: |connection_main|::Frame, issued: |server_main|::Ticket) -> u64 reaches |kernel|::Kernel {
    let foreign: |server_main|::Ticket = |server_main|::ticket(&context.clients[0]);
    let status: u64 = block |server_main|::reply_to(gate, &mut context.clients[index], foreign, &frame.payload);
    transition status != 0u64 {
        true -> block valid(gate, context, index, frame, issued)
        _ -> (210u64)
    }
}
machine valid(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], frame: |connection_main|::Frame, issued: |server_main|::Ticket) -> u64 reaches |kernel|::Kernel {
    transition frame.payload[0] == 10u64 {
        true -> (0u64)
        _ -> block reply(gate, context, index, frame, issued)
    }
}
machine reply(gate: &|kernel|::Gate, context: &mut |main|::State, index: u64 [0..=2], frame: |connection_main|::Frame, issued: |server_main|::Ticket) -> u64 reaches |kernel|::Kernel {
    let object: u64 = context.clients[index].object;
    context.handled = ((context.handled as u64 in Wrapping) + 1u64) as u64;
    block |server_main|::reply_object_to(gate, &mut context.clients[index], issued, &frame.payload, object)
}
