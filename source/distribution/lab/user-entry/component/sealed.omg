use {runtime}/connection/main.omg as connection_main;
use {runtime}/kernel.omg;
use {runtime}/services/main.omg;
use {runtime}/memory/object.omg;
use {runtime}/connection/call.omg;

public machine check(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut bytes: [u64; 2048];
    bytes[0] = 0xffff123456789abcu64;
    let created: |object|::Creation = block |object|::create(gate, &bytes, 6u64);
    transition created {
        |object|::Creation::Ready { object } -> block send(gate, binding, clock, object)
        _ -> (212u64)
    }
}
machine send(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64, object: |object|::Object) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = 135u64;
    let refused: u64 = block |kernel|::Kernel::shared_write(gate, object.handle, 0u64, &words, 1u64);
    let reply: |call|::CallReply = block |call|::exchange_object(gate, &mut binding.broker, clock, &words, object.handle);
    let released: u64 = block |kernel|::Kernel::memory_release(gate, object.handle);
    block |main|::close(gate, binding);
    transition reply {
        |call|::CallReply::Received { frame, notification } -> notification_reply(gate, frame, notification, refused, released)
        |call|::CallReply::Object { frame, object } -> block object_reply(gate, object)
        |call|::CallReply::Endpoint { frame, endpoint } -> endpoint_reply(gate, endpoint)
        |call|::CallReply::Failed { code } -> (code)
    }
}
machine notification_reply(gate: &|kernel|::Gate, frame: |connection_main|::Frame, notification: u64, refused: u64, released: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    transition frame.bytes == 64u64 && frame.payload[0] == 0u64 && notification == 0u64
        && refused >= |kernel|::ERROR_BASE && released == 0u64 {
        true -> (0u64)
        _ -> (214u64)
    }
}
machine endpoint_reply(gate: &|kernel|::Gate, endpoint: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    215u64
}

machine object_reply(gate: &|kernel|::Gate, object: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    215u64
}
