// Reuse the Rust connection lab's malicious and split-delivery peers. These
// checks exercise the same public Omega client as the ordinary echo witness.
use {runtime}/kernel.omg;
use {runtime}/connection/main.omg;
use {runtime}/time.omg;

public machine check(gate: &|kernel|::Gate, peer: &mut |main|::Peer, clock: u64, mode: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut payload: [u64; 8];
    let status: u64 = block |main|::begin(gate, peer, &payload);
    transition status == 0u64 {
        true -> (block started(gate, peer, clock, mode))
        _ -> (block finish(gate, peer, 180u64))
    }
}
machine started(gate: &|kernel|::Gate, peer: &mut |main|::Peer, clock: u64, mode: u64) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> (block poll(gate, peer, clock, mode, |time|::after(value, 700u64)))
        _ -> (block finish(gate, peer, 181u64))
    }
}
machine poll(gate: &|kernel|::Gate, peer: &mut |main|::Peer, clock: u64, mode: u64, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> (block polled(gate, peer, clock, mode, deadline, value))
        _ -> (block finish(gate, peer, 181u64))
    }
}
machine polled(gate: &|kernel|::Gate, peer: &mut |main|::Peer, clock: u64, mode: u64, deadline: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    let reply: |main|::Reply = block |main|::poll(gate, peer, now);
    transition reply {
        |main|::Reply::Object { frame, object } -> block unexpected_object(gate, peer, object)
        |main|::Reply::Endpoint { frame, endpoint } -> block unexpected(gate, peer, endpoint)
        |main|::Reply::Failed { code } -> (block refused(gate, peer, mode, code))
        |main|::Reply::Complete { frame, notification } -> (block delivered(gate, peer, mode, frame, notification))
        |main|::Reply::Pending -> (block pending(gate, peer, clock, mode, deadline, now))
    }
}
machine unexpected(gate: &|kernel|::Gate, peer: &mut |main|::Peer, endpoint: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    block finish(gate, peer, 184u64)
}
machine pending(gate: &|kernel|::Gate, peer: &mut |main|::Peer, clock: u64, mode: u64, deadline: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    transition |time|::reached(now, deadline) {
        true -> (block finish(gate, peer, 182u64))
        _ -> (block waited(gate, peer, clock, mode, deadline))
    }
}
machine waited(gate: &|kernel|::Gate, peer: &mut |main|::Peer, clock: u64, mode: u64, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |main|::wait(gate, peer, deadline);
    transition { _ -> (block poll(gate, peer, clock, mode, deadline)) }
}
machine refused(gate: &|kernel|::Gate, peer: &mut |main|::Peer, mode: u64, code: u64) -> u64 reaches |kernel|::Kernel {
    let expected: u64 = |kernel|::IO_ERROR;
    transition mode == 95u64 || mode == 96u64 {
        true -> (block refused_with(gate, peer, mode, code, |kernel|::TIMED_OUT))
        _ -> (block refused_with(gate, peer, mode, code, expected))
    }
}
machine refused_with(gate: &|kernel|::Gate, peer: &mut |main|::Peer, mode: u64, code: u64, expected: u64) -> u64 reaches |kernel|::Kernel {
    transition mode != 98u64 && code == expected && peer.grant == 0u64
        && peer.sender == 0u64 && peer.reader.handle == 0u64 && peer.writer.handle == 0u64 {
        true -> (block finish(gate, peer, 0u64))
        _ -> (block finish(gate, peer, 183u64))
    }
}
machine delivered(gate: &|kernel|::Gate, peer: &mut |main|::Peer, mode: u64, frame: |main|::Frame, notification: u64) -> u64 reaches |kernel|::Kernel {
    transition notification != 0u64 {
        true -> (block release(gate, peer, mode, frame, notification))
        _ -> (block finish(gate, peer, 184u64))
    }
}
machine release(gate: &|kernel|::Gate, peer: &mut |main|::Peer, mode: u64, frame: |main|::Frame, notification: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    transition mode == 98u64 && frame.bytes == 4u64
        && frame.payload[0] == 0x74696177u64 && status == 0u64 {
        true -> (block finish(gate, peer, 0u64))
        _ -> (block finish(gate, peer, 185u64))
    }
}
machine finish(gate: &|kernel|::Gate, peer: &mut |main|::Peer, result: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |main|::close(gate, peer);
    result
}

machine unexpected_object(gate: &|kernel|::Gate, peer: &mut |main|::Peer, object: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    block finish(gate, peer, 184u64)
}
