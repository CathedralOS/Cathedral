module connection_faults;
// Reuse the Rust connection lab's malicious and split-delivery peers. These
// checks exercise the same public Omega client as the ordinary echo witness.
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::connection::main::Peer;
use runtime::connection::main::Reply;
use runtime::time::Tick;
use runtime::time;

public machine check(gate: &Gate, peer: &mut Peer, clock: u64, mode: u64) -> u64
    reaches Kernel blocks; invokes Kernel; {
    let mut payload: [u64; 8];
    let status: u64 = block runtime::connection::main::begin(gate, peer, &payload);
    transition status == 0u64 {
        true -> (block started(gate, peer, clock, mode))
        _ -> (block finish(gate, peer, 180u64))
    }
}
machine started(gate: &Gate, peer: &mut Peer, clock: u64, mode: u64) -> u64 reaches Kernel {
    let tick: Tick = time::read(gate, clock);
    transition tick {
        Tick::Read { value } -> (block poll(gate, peer, clock, mode, time::after(value, 700u64)))
        _ -> (block finish(gate, peer, 181u64))
    }
}
machine poll(gate: &Gate, peer: &mut Peer, clock: u64, mode: u64, deadline: u64) -> u64 reaches Kernel {
    let tick: Tick = time::read(gate, clock);
    transition tick {
        Tick::Read { value } -> (block polled(gate, peer, clock, mode, deadline, value))
        _ -> (block finish(gate, peer, 181u64))
    }
}
machine polled(gate: &Gate, peer: &mut Peer, clock: u64, mode: u64, deadline: u64, now: u64) -> u64 reaches Kernel {
    let reply: Reply = block runtime::connection::main::poll(gate, peer, now);
    transition reply {
        Reply::Endpoint { frame, endpoint } -> block unexpected(gate, peer, endpoint)
        Reply::Failed { code } -> (block refused(gate, peer, mode, code))
        Reply::Complete { frame, notification } -> (block delivered(gate, peer, mode, frame, notification))
        Reply::Pending -> (block pending(gate, peer, clock, mode, deadline, now))
    }
}
machine unexpected(gate: &Gate, peer: &mut Peer, endpoint: u64) -> u64 reaches Kernel {
    let ignored: u64 = Kernel::close(gate, endpoint);
    block finish(gate, peer, 184u64)
}
machine pending(gate: &Gate, peer: &mut Peer, clock: u64, mode: u64, deadline: u64, now: u64) -> u64 reaches Kernel {
    transition time::reached(now, deadline) {
        true -> (block finish(gate, peer, 182u64))
        _ -> (block waited(gate, peer, clock, mode, deadline))
    }
}
machine waited(gate: &Gate, peer: &mut Peer, clock: u64, mode: u64, deadline: u64) -> u64 reaches Kernel {
    let ignored: u64 = block runtime::connection::main::wait(gate, peer, deadline);
    transition { _ -> (block poll(gate, peer, clock, mode, deadline)) }
}
machine refused(gate: &Gate, peer: &mut Peer, mode: u64, code: u64) -> u64 reaches Kernel {
    let expected: u64 = kernel::IO_ERROR;
    transition mode == 95u64 || mode == 96u64 {
        true -> (block refused_with(gate, peer, mode, code, kernel::TIMED_OUT))
        _ -> (block refused_with(gate, peer, mode, code, expected))
    }
}
machine refused_with(gate: &Gate, peer: &mut Peer, mode: u64, code: u64, expected: u64) -> u64 reaches Kernel {
    transition mode != 98u64 && code == expected && peer.grant == 0u64
        && peer.sender == 0u64 && peer.reader.handle == 0u64 && peer.writer.handle == 0u64 {
        true -> (block finish(gate, peer, 0u64))
        _ -> (block finish(gate, peer, 183u64))
    }
}
machine delivered(gate: &Gate, peer: &mut Peer, mode: u64, frame: runtime::connection::main::Frame, notification: u64) -> u64 reaches Kernel {
    transition notification != 0u64 {
        true -> (block release(gate, peer, mode, frame, notification))
        _ -> (block finish(gate, peer, 184u64))
    }
}
machine release(gate: &Gate, peer: &mut Peer, mode: u64, frame: runtime::connection::main::Frame, notification: u64) -> u64 reaches Kernel {
    let status: u64 = Kernel::notify_drop(gate, notification);
    transition mode == 98u64 && frame.bytes == 4u64
        && frame.payload[0] == 0x74696177u64 && status == 0u64 {
        true -> (block finish(gate, peer, 0u64))
        _ -> (block finish(gate, peer, 185u64))
    }
}
machine finish(gate: &Gate, peer: &mut Peer, result: u64) -> u64 reaches Kernel {
    let ignored: u64 = block runtime::connection::main::close(gate, peer);
    result
}
