use {runtime}/kernel.omg;
use {runtime}/main.omg;
use {runtime}/connection/main.omg as connection_main;
use {runtime}/time.omg;
use connection_faults.omg;

// The peer is the existing Rust Server, running in a separately isolated task.
public machine check(gate: &|kernel|::Gate, mode: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let startup: |main|::Startup = |main|::start(gate);
    transition startup {
        |main|::Startup::Ready { environment } -> (block environment_ready(gate, mode, environment))
        _ -> (160u64)
    }
}
machine environment_ready(gate: &|kernel|::Gate, mode: u64, environment: |main|::Environment) -> u64 reaches |kernel|::Kernel {
    transition environment.count == 2u64 {
        true -> (block timed(gate, mode, environment))
        _ -> (161u64)
    }
}
machine timed(gate: &|kernel|::Gate, mode: u64, environment: |main|::Environment) -> u64 reaches |kernel|::Kernel {
    let clock: u64 = |kernel|::Kernel::clock(gate);
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> (block connected(gate, mode, environment, clock, value))
        _ -> (162u64)
    }
}
machine connected(gate: &|kernel|::Gate, mode: u64, environment: |main|::Environment, clock: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    let mut peer: |connection_main|::Peer;
    let status: u64 = block |connection_main|::connect(gate, &mut peer,
        environment.endpoints[0], environment.endpoints[1], |time|::after(now, 300u64));
    transition mode {
        2u64 -> refused(peer, status, |kernel|::IO_ERROR)
        3u64 -> refused(peer, status, |kernel|::TIMED_OUT)
        _ -> (block connected_mode(gate, &mut peer, clock, mode, status))
    }
}
machine connected_mode(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, mode: u64, status: u64) -> u64 reaches |kernel|::Kernel {
    transition mode >= 94u64 && status == 0u64 {
        true -> (block |connection_faults|::check(gate, peer, clock, mode))
        _ -> (block ready(gate, peer, clock, status))
    }
}
machine refused(peer: |connection_main|::Peer, status: u64, expected: u64) -> u64 {
    transition status == expected && peer.sender == 0u64 && peer.receiver == 0u64
        && peer.writer.handle == 0u64 && peer.reader.handle == 0u64 && peer.bell.wait == 0u64
        && peer.bell.control == 0u64 && peer.signal == 0u64 {
        true -> (0u64)
        _ -> (163u64)
    }
}
machine ready(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, status: u64) -> u64 reaches |kernel|::Kernel {
    transition status == 0u64 {
        true -> (block request(gate, peer, clock, 1u64))
        _ -> (block finish(gate, peer, 164u64))
    }
}
machine request(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16]) -> u64 reaches |kernel|::Kernel {
    let mut payload: [u64; 8];
    payload[0] = index;
    // Distinct words cross both native copy boundaries, including the tail.
    payload[1] = 0x1111222233334444u64;
    payload[2] = 0x2222333344445555u64;
    payload[3] = 0xabcdef9876543210u64;
    payload[4] = 0x4444555566667777u64;
    payload[5] = 0x5555666677778888u64;
    payload[6] = 0x6666777788889999u64;
    payload[7] = index;
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> (block begin(gate, peer, clock, index, &payload, |time|::after(value, 300u64)))
        _ -> (block finish(gate, peer, 165u64))
    }
}
machine begin(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16], payload: &[u64; 8], deadline: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |connection_main|::begin(gate, peer, payload);
    transition status == 0u64 {
        true -> (block busy(gate, peer, clock, index, payload, deadline))
        _ -> (block finish(gate, peer, 166u64))
    }
}
machine busy(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16], payload: &[u64; 8], deadline: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |connection_main|::begin(gate, peer, payload);
    transition status == |kernel|::BUSY {
        true -> (block poll(gate, peer, clock, index, deadline))
        _ -> (block finish(gate, peer, 167u64))
    }
}
machine poll(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16], deadline: u64) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> (block polled(gate, peer, clock, index, deadline, value))
        _ -> (block finish(gate, peer, 168u64))
    }
}
machine polled(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16], deadline: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    let reply: |connection_main|::Reply = block |connection_main|::poll(gate, peer, now);
    transition reply {
        |connection_main|::Reply::Complete { frame, notification } -> (block received(gate, peer, clock, index, frame, notification))
        |connection_main|::Reply::Object { frame, object } -> block unexpected_object(gate, object)
        |connection_main|::Reply::Endpoint { frame, endpoint } -> unexpected(gate, endpoint)
        |connection_main|::Reply::Failed { code } -> (block finish(gate, peer, 169u64))
        |connection_main|::Reply::Pending -> (block pending(gate, peer, clock, index, deadline, now))
    }
}
machine pending(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16], deadline: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    transition |time|::reached(now, deadline) {
        true -> (block finish(gate, peer, 170u64))
        _ -> (block waited(gate, peer, clock, index, deadline))
    }
}
machine waited(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16], deadline: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |connection_main|::wait(gate, peer, deadline);
    transition { _ -> (block poll(gate, peer, clock, index, deadline)) }
}
machine received(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16], frame: |connection_main|::Frame, notification: u64) -> u64 reaches |kernel|::Kernel {
    let rights: bool = release(gate, index, notification);
    transition rights && frame.bytes == 64u64 && frame.payload[0] == index
        && frame.payload[1] == 0x1111222233334444u64 && frame.payload[2] == 0x2222333344445555u64
        && frame.payload[3] == 0xabcdef9876543210u64 && frame.payload[4] == 0x4444555566667777u64
        && frame.payload[5] == 0x5555666677778888u64 && frame.payload[6] == 0x6666777788889999u64
        && frame.payload[7] == index {
        true -> (block next(gate, peer, clock, index))
        _ -> (block finish(gate, peer, 171u64))
    }
}
machine release(gate: &|kernel|::Gate, index: u64, notification: u64) -> bool reaches |kernel|::Kernel {
    transition notification != 0u64 {
        true -> released(gate, index, notification)
        _ -> (index % 2u64 == 1u64)
    }
    machine released(gate: &|kernel|::Gate, index: u64, notification: u64) -> bool reaches |kernel|::Kernel {
        let denied: u64 = |kernel|::Kernel::notify_signal(gate, notification);
        let status: u64 = |kernel|::Kernel::notify_drop(gate, notification);
        index % 2u64 == 0u64 && denied == 0xfffffffffffffff3u64 && status == 0u64
    }
}
machine next(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, clock: u64, index: u64 [1..=16]) -> u64 reaches |kernel|::Kernel {
    transition index < 16u64 {
        true -> (block request(gate, peer, clock, index + 1u64))
        _ -> (block finish(gate, peer, 0u64))
    }
}
machine finish(gate: &|kernel|::Gate, peer: &mut |connection_main|::Peer, result: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |connection_main|::close(gate, peer);
    result
}
machine unexpected(gate: &|kernel|::Gate, endpoint: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    171u64
}

machine unexpected_object(gate: &|kernel|::Gate, object: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    171u64
}
