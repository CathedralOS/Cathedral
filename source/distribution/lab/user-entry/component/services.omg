use {runtime}/kernel.omg;
use {runtime}/services/main.omg;
use {runtime}/main.omg as runtime_main;
use {runtime}/time.omg;
use endpoints.omg;
use sealed.omg;
use objects.omg;
use construction.omg;

public machine check(gate: &|kernel|::Gate, mode: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let startup: |runtime_main|::Startup = |runtime_main|::start(gate);
    transition startup {
        |runtime_main|::Startup::Ready { environment } -> block timed(gate, mode, environment)
        _ -> (190u64)
    }
}
machine timed(gate: &|kernel|::Gate, mode: u64, environment: |runtime_main|::Environment) -> u64 reaches |kernel|::Kernel {
    let clock: u64 = |kernel|::Kernel::clock(gate);
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> block open(gate, mode, environment, clock, value)
        _ -> (191u64)
    }
}
machine open(gate: &|kernel|::Gate, mode: u64, environment: |runtime_main|::Environment, clock: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    let mut binding: |main|::Services;
    let status: u64 = block |main|::open(gate, &mut binding, &environment, |time|::after(now, 300u64));
    transition status == 0u64 {
        true -> block acquire(gate, &mut binding, mode, clock)
        _ -> (192u64)
    }
}
machine acquire(gate: &|kernel|::Gate, binding: &mut |main|::Services, mode: u64, clock: u64) -> u64 reaches |kernel|::Kernel {
    transition {
        mode == 140u64 -> block |construction|::check(gate, binding, clock)
        mode >= 136u64 -> block |objects|::check(gate, binding, clock, mode)
        mode == 135u64 -> block |sealed|::check(gate, binding, clock)
        mode >= 130u64 -> block |endpoints|::check(gate, binding, mode, clock)
        _ -> block interaction(gate, binding, mode, clock)
    }
}
machine interaction(gate: &|kernel|::Gate, binding: &mut |main|::Services, mode: u64, clock: u64) -> u64 reaches |kernel|::Kernel {
    let incompatible: u64 = block |main|::interaction(gate, binding, clock, 2u64, 2u64);
    transition incompatible != 0u64 && binding.broker.next_id == 0u64 {
        true -> block compatible(gate, binding, mode, clock)
        _ -> (193u64)
    }
}
machine compatible(gate: &|kernel|::Gate, binding: &mut |main|::Services, mode: u64, clock: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |main|::interaction(gate, binding, clock, 1u64, 1u64);
    transition {
        mode == 121u64 -> block refused(gate, binding, clock, status)
        mode >= 122u64 && mode <= 124u64 -> malformed(binding, status)
        _ -> block granted(gate, binding, clock, status)
    }
}
machine malformed(binding: &|main|::Services, status: u64) -> u64 {
    transition status == |kernel|::IO_ERROR && binding.wake == 0u64 && binding.broker.sender == 0u64
        && binding.broker.receiver == 0u64 && binding.broker.writer.handle == 0u64 && binding.broker.reader.handle == 0u64 {
        true -> (0u64)
        _ -> (194u64)
    }
}
machine refused(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64, status: u64) -> u64 reaches |kernel|::Kernel {
    transition status == 0x53520001u64 && binding.broker.fault == 0u64 {
        true -> block retry(gate, binding, clock)
        _ -> (195u64)
    }
    machine retry(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = block |main|::interaction(gate, binding, clock, 1u64, 1u64);
        transition { _ -> (block granted(gate, binding, clock, status)) }
    }
}
machine granted(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64, status: u64) -> u64 reaches |kernel|::Kernel {
    let previous: u64 = binding.broker.next_id;
    let cached: u64 = block |main|::interaction(gate, binding, clock, 1u64, 1u64);
    transition status == 0u64 && cached == 0u64 && binding.wake != 0u64 && binding.broker.next_id == previous {
        true -> block storage(gate, binding, clock)
        _ -> (196u64)
    }
}
machine storage(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8];
    words[0] = 0x53525601u64; words[1] = 2u64; words[2] = 2u64; words[3] = 1u64; words[4] = 1u64;
    let reply: |main|::Reply = block |main|::exchange(gate, binding, clock, &words);
    transition reply {
        |main|::Reply::Received { words } -> block denied(gate, binding, clock, words[0])
        _ -> (197u64)
    }
}
machine denied(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64, code: u64) -> u64 reaches |kernel|::Kernel {
    transition code == 0x53520001u64 && binding.broker.fault == 0u64 {
        true -> block continued(gate, binding, clock)
        _ -> (198u64)
    }
}
machine continued(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8]; words[0] = 5u64;
    let reply: |main|::Reply = block |main|::exchange(gate, binding, clock, &words);
    transition reply {
        |main|::Reply::Received { words } -> block finish(gate, binding, words)
        _ -> (199u64)
    }
}
machine finish(gate: &|kernel|::Gate, binding: &mut |main|::Services, words: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    block |main|::close(gate, binding);
    transition words[0] == 0u64 && words[1] == 77u64 && words[2] == 640u64 && words[3] == 480u64
        && binding.wake == 0u64 && binding.broker.writer.handle == 0u64 && binding.broker.reader.handle == 0u64 {
        true -> (0u64)
        _ -> (200u64)
    }
}
