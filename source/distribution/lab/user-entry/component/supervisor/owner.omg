module supervisor::owner;
// Owner commands: 1 admit [slot, granted, launch, argument], 2 stop [slot],
// 3 status, 99 exit. Replies report the admission status or the slot's exit.
// Status words: slot liveness, handled echoes, stored storage messages, last
// exit kinds and whether each slot holds a request. Any owner failure ends the witness.
use supervisor::main::State;
use supervisor::slots;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::kernel;
use runtime::server::main::Event;
use runtime::connection::main::Frame;
public machine step(gate: &Gate, context: &mut State, now: u64) -> u64 reaches Kernel blocks; invokes Kernel; {
    let event: Event = block runtime::server::main::poll(gate, &mut context.owner, now);
    transition event {
        Event::Request { frame } -> block command(gate, context, now, frame)
        Event::Pending -> (0u64)
        Event::Failed { code } -> (code)
    }
}
machine command(gate: &Gate, context: &mut State, now: u64, frame: Frame) -> u64 reaches Kernel {
    transition frame.bytes == 64u64 {
        true -> block routed(gate, context, now, frame)
        _ -> (307u64)
    }
}
machine routed(gate: &Gate, context: &mut State, now: u64, frame: Frame) -> u64 reaches Kernel {
    transition frame.payload[0] {
        1u64 -> block admit(gate, context, now, frame)
        2u64 -> block stop(gate, context, frame)
        3u64 -> block status(gate, context)
        99u64 -> block exit(gate, context)
        _ -> block reply(gate, context, kernel::INVALID_ARGUMENT, 0u64)
    }
}
machine admit(gate: &Gate, context: &mut State, now: u64, frame: Frame) -> u64 reaches Kernel {
    transition frame.payload[1] < 2u64 {
        true -> block slot(gate, context, now, frame, frame.payload[1])
        _ -> block reply(gate, context, kernel::INVALID_ARGUMENT, 0u64)
    }
    machine slot(gate: &Gate, context: &mut State, now: u64, frame: Frame, slot: u64 [0..=1]) -> u64 reaches Kernel {
        transition context.slots[slot].live {
            true -> block reply(gate, context, kernel::BUSY, 0u64)
            _ -> block launch(gate, context, now, frame, slot)
        }
    }
    machine launch(gate: &Gate, context: &mut State, now: u64, frame: Frame, slot: u64 [0..=1]) -> u64 reaches Kernel {
        let launch: u64 = runtime::task::main::launch(gate, frame.payload[3]);
        transition launch < kernel::ERROR_BASE {
            true -> block admitted(gate, context, now, frame, slot, launch)
            _ -> block reply(gate, context, launch, 0u64)
        }
    }
    machine admitted(gate: &Gate, context: &mut State, now: u64, frame: Frame, slot: u64 [0..=1], launch: u64) -> u64 reaches Kernel {
        let loans: [u64; 14];
        let status: u64 = block runtime::admission::main::admit(gate, &mut context.slots[slot], launch,
            frame.payload[4], &loans, 0u64, frame.payload[2], runtime::time::after(now, 300u64), false);
        context.exits[slot] = 0u64;
        block reply(gate, context, status, 0u64)
    }
}
machine stop(gate: &Gate, context: &mut State, frame: Frame) -> u64 reaches Kernel {
    transition frame.payload[1] < 2u64 {
        true -> block slot(gate, context, frame.payload[1])
        _ -> block reply(gate, context, kernel::INVALID_ARGUMENT, 0u64)
    }
    machine slot(gate: &Gate, context: &mut State, slot: u64 [0..=1]) -> u64 reaches Kernel {
        transition context.slots[slot].live {
            true -> block stopping(gate, context, slot)
            _ -> block reply(gate, context, kernel::PEER_CLOSED, 0u64)
        }
    }
    machine stopping(gate: &Gate, context: &mut State, slot: u64 [0..=1]) -> u64 reaches Kernel {
        block slots::reclaim(gate, context, slot);
        let kind: u64 = context.exits[slot];
        block reply(gate, context, 0u64, kind)
    }
}
machine status(gate: &Gate, context: &mut State) -> u64 reaches Kernel {
    let mut words: [u64; 8];
    words[0] = slots::flag(context.slots[0].live);
    words[1] = slots::flag(context.slots[1].live);
    words[2] = context.handled;
    words[3] = context.stored;
    words[4] = context.exits[0];
    words[5] = context.exits[1];
    words[6] = slots::flag(context.slots[0].listener.pending != 0u64);
    words[7] = slots::flag(context.slots[1].listener.pending != 0u64);
    block runtime::server::main::reply(gate, &mut context.owner, &words)
}
machine exit(gate: &Gate, context: &mut State) -> u64 reaches Kernel {
    context.stopped = true;
    block reply(gate, context, 0u64, 0u64)
}
machine reply(gate: &Gate, context: &mut State, first: u64, second: u64) -> u64 reaches Kernel {
    let mut words: [u64; 8];
    words[0] = first;
    words[1] = second;
    block runtime::server::main::reply(gate, &mut context.owner, &words)
}
