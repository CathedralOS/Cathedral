// Child admission witness: a standalone Omega process admits Rust peers into two
// slots on owner command, offers them services, echoes their requests, reclaims
// them when they exit or die, and keeps answering its owner throughout. One turn
// polls the owner and each live slot once, then parks on every live interest.
// Two slots, the echo protocol and the status words are fixture policy only.
use {runtime}/kernel.omg;
use {runtime}/server/main.omg;
use {runtime}/admission/main.omg as admission_main;
use {runtime}/task/main.omg as task_main;
use {runtime}/time.omg;
use {runtime}/waiting.omg;
use supervisor/owner.omg;
use supervisor/slots.omg;
use supervisor/retirement.omg;
public data State {
    owner: |main|::Server;
    slots: [|admission_main|::Admitted; 2];
    exits: [u64; 2];
    stopping: [bool; 2];
    admission_failures: [u64; 2];
    invalid_clock: [bool; 2];
    clock: u64;
    deadline: u64;
    stopped: bool;
    handled: u64;
    stored: u64;
}
public machine check(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block |retirement|::check(gate);
    transition status == 0u64 {
        true -> block checked(gate)
        _ -> (status)
    }
}
machine checked(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel {
    let mut context: State;
    let status: u64 = startup(gate, &mut context);
    transition status == 0u64 {
        true -> block run(gate, &mut context)
        _ -> block cleanup(gate, &mut context, status)
    }
}
machine startup(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    context.clock = |kernel|::Kernel::clock(gate);
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> installed(gate, context, value)
        _ -> (305u64)
    }
}
// The owner connects through the kernel-installed control pair. No environment
// endpoint is expected: this process owns only lent launches.
machine installed(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    let mut env: [u64; 8];
    let status: u64 = |kernel|::Kernel::environment(gate, &mut env);
    transition status == 0u64 && env[0] == 0u64 {
        true -> control(gate, context, now)
        _ -> (306u64)
    }
}
machine control(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    let receiver: u64 = |kernel|::Kernel::bootstrap(gate, 0u64);
    let sender: u64 = |kernel|::Kernel::bootstrap(gate, 1u64);
    context.deadline = |time|::after(now, 6000u64);
    |main|::begin(&mut context.owner, sender, receiver, |time|::after(now, 300u64), false)
}
machine run(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block turn(gate, context, value)
        _ -> block cleanup(gate, context, 301u64)
    }
}
machine turn(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition |time|::reached(now, context.deadline) {
        true -> block cleanup(gate, context, 302u64)
        _ -> block served(gate, context, now)
    }
}
machine served(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    let commanded: u64 = block |owner|::step(gate, context, now);
    let first: u64 = block |slots|::step(gate, context, 0u64, now);
    let second: u64 = block |slots|::step(gate, context, 1u64, now);
    transition commanded == 0u64 && first == 0u64 && second == 0u64 {
        true -> block wait(gate, context, now)
        _ -> block cleanup(gate, context, 303u64)
    }
}
machine wait(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition context.stopped {
        true -> block cleanup(gate, context, 0u64)
        _ -> block parked(gate, context, now)
    }
    machine parked(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
        let mut set: |waiting|::Set;
        |waiting|::reset(&mut set, context.deadline);
        pending_wake(context, &mut set, now);
        |main|::watch(&context.owner, &mut set);
        |slots|::watch(context, 0u64, &mut set);
        |slots|::watch(context, 1u64, &mut set);
        let status: u64 = block |waiting|::wait(gate, &set);
        transition status < |kernel|::ERROR_BASE || status == |kernel|::TIMED_OUT || status == |kernel|::PEER_CLOSED {
            true -> block run(gate, context)
            _ -> block cleanup(gate, context, 304u64)
        }
    }
}
machine pending_wake(context: &State, set: &mut |waiting|::Set, now: u64) {
    transition context.slots[0].pending != 0u64 || context.slots[1].pending != 0u64
        || context.stopping[0] || context.stopping[1] {
        true -> |waiting|::expire_by(set, |time|::after(now, 1u64))
        _ -> done()
    }
    machine done() {}
}
machine cleanup(gate: &|kernel|::Gate, context: &mut State, status: u64) -> u64 reaches |kernel|::Kernel {
    block |slots|::reclaim(gate, context, 0u64);
    block |slots|::reclaim(gate, context, 1u64);
    block |main|::close(gate, &mut context.owner);
    status
}
