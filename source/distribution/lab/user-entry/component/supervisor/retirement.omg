// A rejected receipt observation must preserve a real allocated bundle. Repair
// the deliberately invalid fixture receipt, then prove ordinary release closes it.
use {runtime}/kernel.omg;
use {runtime}/admission/main.omg;
use {runtime}/admission/retirement.omg;
use {protocol}/services.omg;

public machine check(gate: &|kernel|::Gate) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut child: |main|::Admitted;
    let status: u64 = block |main|::prepare_bundle(gate, &mut child, |services|::INTERACTION | |services|::STORAGE);
    transition status == 0u64 {
        true -> block rejected(gate, &mut child)
        _ -> (320u64)
    }
}
machine rejected(gate: &|kernel|::Gate, child: &mut |main|::Admitted) -> u64 reaches |kernel|::Kernel {
    child.pending = |kernel|::BAD_HANDLE;
    let result: |retirement|::Retirement = |retirement|::poll(gate, child);
    transition result {
        |retirement|::Retirement::Failed { code } -> block retained(gate, child, code)
        _ -> (321u64)
    }
}
machine retained(gate: &|kernel|::Gate, child: &mut |main|::Admitted, code: u64) -> u64 reaches |kernel|::Kernel {
    let sender: u64 = child.handoff[0];
    block |main|::release(gate, child);
    let mut packet: [u64; 8];
    let status: u64 = |kernel|::Kernel::send(gate, sender, &packet, 8u64);
    transition code == |kernel|::BAD_HANDLE && child.pending == |kernel|::BAD_HANDLE
        && child.handoff[0] == sender && status == 8u64 {
        true -> block repaired(gate, child, sender)
        _ -> (322u64)
    }
}
machine repaired(gate: &|kernel|::Gate, child: &mut |main|::Admitted, sender: u64) -> u64 reaches |kernel|::Kernel {
    child.pending = 0u64;
    block |main|::release(gate, child);
    let mut packet: [u64; 8];
    let status: u64 = |kernel|::Kernel::send(gate, sender, &packet, 8u64);
    transition child.handoff[0] == 0u64 && status == |kernel|::BAD_HANDLE {
        true -> (0u64)
        _ -> (323u64)
    }
}
