// Real installed owner endpoints, not an environment-provided stand-in.
use {runtime}/kernel.omg;
use {runtime}/time.omg;
use {runtime}/server/main.omg;
use {runtime}/server/owner.omg;
use {runtime}/connection/main.omg as connection_main;

public machine check(gate: &|kernel|::Gate, mode: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let clock: u64 = |kernel|::Kernel::clock(gate);
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> block open(gate, mode, clock, value)
        _ -> (180u64)
    }
}
machine open(gate: &|kernel|::Gate, mode: u64, clock: u64, now: u64) -> u64 reaches |kernel|::Kernel {
    let mut listener: |main|::Server;
    let status: u64 = block |owner|::open(gate, &mut listener, |time|::after(now, 300u64));
    transition mode == 111u64 || mode == 112u64 || mode == 114u64 {
        true -> refused(listener, mode, status)
        _ -> block opened(gate, &mut listener, mode, clock, status)
    }
}
machine refused(listener: |main|::Server, mode: u64, status: u64) -> u64 {
    transition status != 0u64 && listener.peer.sender == 0u64 && listener.peer.receiver == 0u64
        && listener.peer.writer.handle == 0u64 && listener.peer.reader.handle == 0u64
        && listener.peer.bell.wait == 0u64 && listener.peer.bell.control == 0u64
        && (mode != 112u64 || status == |kernel|::TIMED_OUT) {
        true -> (0u64)
        _ -> (181u64)
    }
}
machine opened(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, status: u64) -> u64 reaches |kernel|::Kernel {
    transition status == 0u64 {
        true -> block poll(gate, listener, mode, clock, 1u64)
        _ -> (182u64)
    }
}
machine poll(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16]) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> block receive(gate, listener, mode, clock, index, value)
        _ -> (183u64)
    }
}
machine receive(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16], now: u64) -> u64 reaches |kernel|::Kernel {
    let event: |main|::Event = block |main|::poll(gate, listener, now);
    transition event {
        |main|::Event::Request { frame } -> block received(gate, listener, mode, clock, index, now, frame)
        |main|::Event::Pending -> block wait(gate, listener, mode, clock, index, now)
        |main|::Event::Failed { code } -> failed(mode, code)
    }
}
machine failed(mode: u64, code: u64) -> u64 {
    transition mode == 113u64 && code == |kernel|::IO_ERROR {
        true -> (0u64)
        _ -> (184u64)
    }
}
machine wait(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16], now: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |connection_main|::wait(gate, &listener.peer, |time|::after(now, 100u64));
    transition { _ -> (block poll(gate, listener, mode, clock, index)) }
}
machine received(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16], now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    transition frame.bytes == 64u64 && frame.payload[0] == index && frame.payload[7] == index {
        true -> block retained(gate, listener, mode, clock, index, now, frame)
        _ -> (185u64)
    }
}
machine retained(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16], now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let event: |main|::Event = block |main|::poll(gate, listener, now);
    transition event {
        |main|::Event::Failed { code } -> block reply(gate, listener, mode, clock, index, frame, code)
        _ -> (186u64)
    }
}
machine reply(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16], frame: |connection_main|::Frame, code: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |main|::reply(gate, listener, &frame.payload);
    transition code == |kernel|::BUSY && status == 0u64 {
        true -> block replied(gate, listener, mode, clock, index, frame)
        _ -> (187u64)
    }
}
machine replied(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16], frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |main|::reply(gate, listener, &frame.payload);
    transition status != 0u64 {
        true -> block next(gate, listener, mode, clock, index)
        _ -> (188u64)
    }
}
machine next(gate: &|kernel|::Gate, listener: &mut |main|::Server, mode: u64, clock: u64, index: u64 [1..=16]) -> u64 reaches |kernel|::Kernel {
    transition index < 16u64 {
        true -> (block poll(gate, listener, mode, clock, index + 1u64))
        _ -> block done(gate, listener)
    }
}
machine done(gate: &|kernel|::Gate, listener: &mut |main|::Server) -> u64 reaches |kernel|::Kernel {
    block |main|::close(gate, listener);
    0u64
}
