machine build(builder: &mut Build) {
    Build::application(builder, "cathedral_matrix_handoff_native");
    Build::depend_as(builder, "runtime", Source::Path { location: "../../../../platform/libraries/user-runtime" });
    Build::depend_as(builder, "fixture", Source::Path { location: "../process" });
    Build::select_provider<runtime::entry::Program, fixture::main::ProgramProvider>(builder, linux_x86_64, CompositionMode::Independent);
    Build::select_provider<runtime::kernel::Kernel, runtime::arch::x86_64::gate::NativeKernel>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
