use {runtime}/entry.omg;
use {runtime}/kernel.omg;
use {component}/main.omg;
// Below the ordinary child's startup timeout. The test must observe its owner
// replies before this window releases; elapsed host time is not the oracle.
public ProgramProvider satisfies |entry|::Program {
    machine run(gate: &|kernel|::Gate, first: u64, second: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
        block |main|::start(gate, 0u64, 100u64)
    }
}
public machine component_entry() reaches |entry|::Program + |kernel|::Kernel blocks invokes |entry|::Program invokes |kernel|::Kernel {
    let gate: |kernel|::Gate;
    let status: u64 = block |entry|::Program::run(&gate, 0u64, 0u64);
}
