// Private proof-host operations. Not the app-host ABI or a proposed OS protocol.
public const NEXT: u64 = 10u64;
public const SPAWN: u64 = 11u64;
public const STOP: u64 = 12u64;
public const INITIALIZE: u64 = 13u64;
public const OWNER_COMMAND: u64 = 14u64;
public const CHILD_REQUEST: u64 = 15u64;
public const REPLY: u64 = 16u64;
public const OFFER: u64 = 17u64;
public const RELAY_PROBE: u64 = 18u64;
public const SOURCE_COMMAND: u64 = 19u64;
public const CHECK_ROLLBACK: u64 = 20u64;
public const REFRESH: u64 = 21u64;
public machine packet(p: &mut [u64; 4096], a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) {
    p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h;
}
