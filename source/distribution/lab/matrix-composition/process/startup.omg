use {runtime}/admission/main.omg as admission_main;
use {runtime}/services/main.omg as services_main;
use {runtime}/task/main.omg as task_main;
// Learn the granted area, open owner control, admit the three peers and place
// them. An empty environment means the top-level proof with a fixed grant; a
// supplied broker pair means a real parent whose poll decides the area.
// Rollback probes run after the first and the last admission.
use {protocol}/main.omg;
use main.omg as main_file;
use {runtime}/kernel.omg;
use {runtime}/main.omg as runtime_main;
use {runtime}/time.omg;
use {world}/level.omg;
use {world}/surfaces.omg;
use {world}/geometry.omg;
use {protocol}/services.omg;
use {runtime}/server/owner.omg;
use rollback.omg;
use upstream.omg;

public machine open(gate: &|kernel|::Gate, context: &mut |main_file|::State) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    context.clock = |kernel|::Kernel::clock(gate);
    context.world.slots = 3u64;
    let startup: |runtime_main|::Startup = |runtime_main|::start(gate);
    transition startup {
        |runtime_main|::Startup::Ready { environment } -> block timed(gate, context, environment)
        |runtime_main|::Startup::Failed { code } -> (code)
        |runtime_main|::Startup::InvalidEnvironment -> (|kernel|::INVALID_ARGUMENT)
    }
}
machine timed(gate: &|kernel|::Gate, context: &mut |main_file|::State, environment: |runtime_main|::Environment) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block control(gate, context, environment, value)
        |time|::Tick::Failed { code } -> (code)
    }
}
// Accept owner control first. A supplied parent connects it right after admission
// and only then serves this broker, so the handshake cannot wait behind a poll.
// Its wake bell is also charged before the rollback probes count what is left.
machine control(gate: &|kernel|::Gate, context: &mut |main_file|::State, environment: |runtime_main|::Environment, now: u64) -> u64 reaches |kernel|::Kernel {
    context.deadline = |time|::after(now, 30000u64);
    let handshake: u64 = |time|::after(now, 300u64);
    let status: u64 = block |owner|::open(gate, &mut context.owner, handshake);
    transition status == 0u64 {
        true -> block area(gate, context, environment, now)
        _ -> (status)
    }
}
machine area(gate: &|kernel|::Gate, context: &mut |main_file|::State, environment: |runtime_main|::Environment, now: u64) -> u64 reaches |kernel|::Kernel {
    transition environment.count {
        0u64 -> block fixed(gate, context, now)
        2u64 -> block supplied(gate, context, environment, now)
        _ -> (|kernel|::INVALID_ARGUMENT)
    }
}
// The top-level proof owns a virtual 300 by 600 area with the navigation keys.
machine fixed(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64) -> u64 reaches |kernel|::Kernel {
    |level|::inherit(&mut context.world, |geometry|::Grant { epoch: 1u64, width: 300u64, height: 600u64, keys: |main|::KEY_MASK });
    // Virtual backing for twelve surfaces; there is no display behind them.
    |surfaces|::capacity(&mut context.world, 12u64);
    let grant: |geometry|::Grant = context.world.parent;
    transition { _ -> block layout(gate, context, now, grant) }
}
machine supplied(gate: &|kernel|::Gate, context: &mut |main_file|::State, environment: |runtime_main|::Environment, now: u64) -> u64 reaches |kernel|::Kernel {
    context.has_parent = true;
    let status: u64 = block |services_main|::open(gate, &mut context.parent, &environment, |time|::after(now, 300u64));
    transition status == 0u64 {
        true -> block acquired(gate, context, now)
        _ -> (status)
    }
}
machine acquired(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |services_main|::interaction(gate, &mut context.parent, context.clock, 1u64, 1u64);
    transition status == 0u64 {
        true -> block polled(gate, context, now)
        _ -> (status)
    }
}
machine polled(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |upstream|::refresh(gate, context);
    let grant: |geometry|::Grant = context.world.parent;
    transition status == 0u64 {
        true -> block layout(gate, context, now, grant)
        _ -> (status)
    }
}
// Three equal horizontal regions; every peer receives the whole granted key set.
machine layout(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, grant: |geometry|::Grant) -> u64 reaches |kernel|::Kernel {
    transition grant.epoch != 0u64 && grant.width > 0u64 && grant.width <= 4096u64 && grant.height >= 3u64 && grant.height <= 4096u64 {
        true -> block measured(gate, context, now, grant)
        _ -> (|kernel|::DENIED)
    }
    machine measured(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, grant: |geometry|::Grant) -> u64 reaches |kernel|::Kernel requires grant.height >= 3u64 {
        context.width = grant.width;
        context.height = grant.height / 3u64;
        context.keys = grant.keys;
        transition { _ -> block admit(gate, context, now, 0u64) }
    }
}
machine admit(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64) -> u64 reaches |kernel|::Kernel requires slot <= 3u64 {
    transition slot < 3u64 {
        true -> block starting(gate, context, now, slot)
        _ -> armed(context)
    }
    machine armed(context: &mut |main_file|::State) -> u64 {
        context.probe_rollback = true;
        0u64
    }
    machine starting(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64) -> u64 reaches |kernel|::Kernel requires slot < 3u64 {
        let status: u64 = block start(gate, context, now, slot, 0u64);
        transition status == 0u64 {
            true -> block placing(gate, context, now, slot)
            _ -> (status)
        }
    }
    machine placing(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64) -> u64 reaches |kernel|::Kernel requires slot < 3u64 {
        let status: u64 = place(context, slot);
        transition { _ -> block admitted(gate, context, now, slot, status) }
    }
    machine admitted(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64, status: u64) -> u64 reaches |kernel|::Kernel requires slot < 3u64 {
        transition {
            status != 0u64 -> (status)
            slot == 0u64 -> block first(gate, context, now)
            _ -> block admit(gate, context, now, slot + 1u64)
        }
    }
    machine first(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = block |rollback|::check(gate, context, now, |kernel|::BUSY);
        transition status == 0u64 {
            true -> block admit(gate, context, now, 1u64)
            _ -> (status)
        }
    }
}
// Admit the peer for `slot` from the lent launch of the same index. Mode zero
// starts the slot's ordinary program; modes one and two start its interrupted-
// handoff variants (arguments three and four). A replacement is not placed:
// the owner places it, so a new occupant never inherits the old view.
public machine start(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64 [0..=2], mode: u64 [0..=2]) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.slots[slot].live {
        true -> (|kernel|::BUSY)
        _ -> block launching(gate, context, now, slot, mode)
    }
    machine launching(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64 [0..=2], mode: u64 [0..=2]) -> u64 reaches |kernel|::Kernel {
        let launch: u64 = |task_main|::launch(gate, slot);
        transition launch < |kernel|::ERROR_BASE {
            true -> block spawned(gate, context, now, slot, launch, argument(slot, mode))
            _ -> (launch)
        }
    }
    machine spawned(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64 [0..=2], launch: u64, argument: u64) -> u64 reaches |kernel|::Kernel {
        let loans: [u64; 14];
        |level|::disconnected(&mut context.world, slot);
        block |admission_main|::admit(gate, &mut context.slots[slot], launch, argument,
            &loans, 0u64, services(slot), context.clock, 300u64, false)
    }
}
// Each slot owns a third of the area, stacked vertically, with the full key set.
machine place(context: &mut |main_file|::State, slot: u64 [0..=2]) -> u64 {
    let region: |geometry|::Rect = |geometry|::Rect { x: 0u64, y: ((slot as u64 in Wrapping) * (context.height as u64 in Wrapping)) as u64,
        width: context.width, height: context.height };
    let keys: u64 = context.keys;
    |level|::place(&mut context.world, slot, region, keys)
}
machine argument(slot: u64 [0..=2], mode: u64 [0..=2]) -> u64 {
    transition mode == 0u64 { true -> (slot) _ -> (mode + 2u64) }
}
// Slot two alone is offered storage as well as interaction.
public machine services(slot: u64) -> u64 {
    transition slot == 2u64 { true -> (|services|::INTERACTION | |services|::STORAGE) _ -> (|services|::INTERACTION) }
}
