// With a supplied parent, poll it once before each local decision and adopt the
// snapshot. The top-level proof has no parent and refreshes nothing. This proof
// refreshes synchronously on local requests; a slow parent delays local dispatch.
use {protocol}/main.omg;
use main.omg as main_file;
use {runtime}/kernel.omg;
use {runtime}/services/main.omg as services_main;
use {world}/geometry.omg;
use {world}/upstream.omg;

public machine refresh(gate: &|kernel|::Gate, context: &mut |main_file|::State) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.has_parent {
        true -> block polling(gate, context)
        _ -> (0u64)
    }
    machine polling(gate: &|kernel|::Gate, context: &mut |main_file|::State) -> u64 reaches |kernel|::Kernel {
        let mut words: [u64; 8];
        words[0] = |main|::MATRIX_POLL;
        let reply: |services_main|::Reply = block |services_main|::exchange(gate, &mut context.parent, context.clock, &words);
        transition reply {
            |services_main|::Reply::Received { words } -> adopted(context, words)
            |services_main|::Reply::Failed { code } -> (code)
        }
    }
    machine adopted(context: &mut |main_file|::State, words: [u64; 8]) -> u64 {
        let grant: |geometry|::Grant = |upstream|::inherit_poll(&mut context.world, &words);
        0u64
    }
}
