// Owner commands over the kernel-installed control pair. A nonzero high word
// relays the packet to that child's control link (a proof-only probe). STOP and
// SPAWN change slots; source words inject input; delegation words grant a child
// authority beyond its view; everything else is a world command. With a parent,
// each decision follows one upstream poll.
use {protocol}/main.omg;
use {protocol}/matrix.omg;
use main.omg as main_file;
use {runtime}/kernel.omg;
use {runtime}/server/main.omg as server_main;
use {runtime}/connection/main.omg as connection_main;
use {runtime}/task/main.omg as task_main;
use {world}/main.omg as world_main;
use {world}/geometry.omg;
use startup.omg;
use slots.omg;
use probe.omg;
use upstream.omg;
use inspection.omg;
use delegation.omg;

public machine step(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition context.owner.pending != 0u64 {
        true -> block held(gate, context, now)
        _ -> block receive(gate, context, now)
    }
}
// A relayed probe keeps the owner's request until the child answers.
machine held(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |server_main|::maintain(gate, &mut context.owner, now);
    transition context.owner.peer.fault == 0u64 { true -> (0u64) _ -> (context.owner.peer.fault) }
}
machine receive(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64) -> u64 reaches |kernel|::Kernel {
    let event: |server_main|::Event = block |server_main|::poll(gate, &mut context.owner, now);
    transition event {
        |server_main|::Event::Request { frame } -> block refreshed(gate, context, now, frame)
        |server_main|::Event::Pending -> (0u64)
        |server_main|::Event::Failed { code } -> (code)
    }
}
machine refreshed(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |upstream|::refresh(gate, context);
    transition status == 0u64 {
        true -> block command(gate, context, now, frame)
        _ -> (status)
    }
}
machine command(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let issued: |server_main|::Ticket = |server_main|::ticket(&context.owner);
    let delegated: bool = |delegation|::owner_word(frame.payload[0]);
    transition {
        frame.bytes != 64u64 -> block reply(gate, context, |kernel|::DENIED)
        frame.payload[0] >> 32u64 != 0u64 -> block probing(gate, context, now, issued, frame.payload)
        frame.payload[0] == |matrix|::STOP -> block stop(gate, context, frame)
        frame.payload[0] == |matrix|::SPAWN -> block spawn(gate, context, now, frame)
        frame.payload[0] == |main|::POINTER_SOURCE || frame.payload[0] == |main|::KEY_SOURCE -> block source(gate, context, frame)
        delegated -> block |delegation|::owner(gate, context, frame)
        frame.payload[0] >= |inspection|::LAST_PRESENTED && frame.payload[0] <= |inspection|::CURSOR -> block |inspection|::answer(gate, context, frame)
        _ -> block arranged(gate, context, frame)
    }
}
// A probe that cannot start is answered with its refusal; one that started
// keeps the owner's request until the child's answer arrives.
machine probing(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, issued: |server_main|::Ticket, words: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |probe|::start(gate, context, now, issued, words);
    transition status == 0u64 {
        true -> (0u64)
        _ -> block reply(gate, context, status)
    }
}
machine source(gate: &|kernel|::Gate, context: &mut |main_file|::State, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let reply: [u64; 8] = |world_main|::source_command(&mut context.world, &frame.payload);
    block answer(gate, context, reply)
}
machine arranged(gate: &|kernel|::Gate, context: &mut |main_file|::State, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let reply: [u64; 8] = |world_main|::owner_command(&mut context.world, &frame.payload);
    block answer(gate, context, reply)
}
machine stop(gate: &|kernel|::Gate, context: &mut |main_file|::State, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let padded: bool = |geometry|::zeros_from(&frame.payload, 2u64);
    transition padded {
        true -> block bounded(gate, context, frame)
        _ -> block reply(gate, context, |kernel|::DENIED)
    }
    machine bounded(gate: &|kernel|::Gate, context: &mut |main_file|::State, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
        transition frame.payload[1] < 3u64 {
            true -> block stopping(gate, context, frame.payload[1])
            _ -> block reply(gate, context, |kernel|::DENIED)
        }
    }
    machine stopping(gate: &|kernel|::Gate, context: &mut |main_file|::State, slot: u64 [0..=2]) -> u64 reaches |kernel|::Kernel {
        transition context.slots[slot].live {
            true -> block stopped(gate, context, slot)
            _ -> block reply(gate, context, |kernel|::PEER_CLOSED)
        }
    }
    machine stopped(gate: &|kernel|::Gate, context: &mut |main_file|::State, slot: u64 [0..=2]) -> u64 reaches |kernel|::Kernel {
        block |slots|::reclaim(gate, context, slot);
        block reply(gate, context, 0u64)
    }
}
machine spawn(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
    let padded: bool = |geometry|::zeros_from(&frame.payload, 3u64);
    transition padded {
        true -> block bounded(gate, context, now, frame)
        _ -> block reply(gate, context, |kernel|::DENIED)
    }
    machine bounded(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel {
        transition frame.payload[1] < 3u64 {
            true -> block moded(gate, context, now, frame, frame.payload[1])
            _ -> block reply(gate, context, |kernel|::DENIED)
        }
    }
    machine moded(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, frame: |connection_main|::Frame, slot: u64 [0..=2]) -> u64 reaches |kernel|::Kernel {
        transition frame.payload[2] <= 2u64 {
            true -> block spawning(gate, context, now, slot, frame.payload[2])
            _ -> block reply(gate, context, |kernel|::DENIED)
        }
    }
    machine spawning(gate: &|kernel|::Gate, context: &mut |main_file|::State, now: u64, slot: u64 [0..=2], mode: u64 [0..=2]) -> u64 reaches |kernel|::Kernel {
        let status: u64 = block |startup|::start(gate, context, now, slot, mode);
        block reply(gate, context, status)
    }
}
machine answer(gate: &|kernel|::Gate, context: &mut |main_file|::State, words: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    block |server_main|::reply(gate, &mut context.owner, &words)
}
machine reply(gate: &|kernel|::Gate, context: &mut |main_file|::State, code: u64) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8];
    words[0] = code;
    block |server_main|::reply(gate, &mut context.owner, &words)
}
