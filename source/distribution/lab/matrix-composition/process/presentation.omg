module presentation;
// A peer's surface traffic. Creation validates locally, allocates upstream (a
// parent's SURFACE_CREATE, or a virtual name at the top level), then publishes
// the child-local name. Updates are previewed into the parent's coordinates,
// forwarded or recorded, and committed only after the upstream accepts them.
// Erasures owed for retired surfaces are flushed between turns the same way.
use protocol::main;
use protocol::matrix;
use main::State;
use runtime::kernel::Gate;
use runtime::kernel::Kernel;
use runtime::services::main::Reply;
use runtime::connection::main::Frame;
use world::surfaces;
use world::surfaces::Prepared;
use world::surfaces::Updated;
use world::surfaces::Retained;

public machine create(gate: &Gate, context: &mut State, slot: u64 [0..=2], incarnation: u64, words: &[u64; 8]) -> [u64; 8]
    reaches Kernel blocks; invokes Kernel; {
    let prepared: Prepared = surfaces::prepare(&mut context.world, slot, incarnation, words[1], words[2]);
    transition prepared {
        Prepared::Rank { upstream } -> block allocating(gate, context, slot, words[2], upstream)
        Prepared::Refused { code } -> (error(code))
    }
    machine allocating(gate: &Gate, context: &mut State, slot: u64 [0..=2], rank: u64, upstream: u64) -> [u64; 8] reaches Kernel {
        transition context.has_parent && rank < 64u64 {
            true -> block forwarded(gate, context, slot, rank, upstream)
            _ -> virtual(context, slot, rank, upstream)
        }
    }
    // The top-level proof has no parent: name the backing after its rank.
    machine virtual(context: &mut State, slot: u64 [0..=2], rank: u64, upstream: u64) -> [u64; 8] {
        transition rank < 64u64 && upstream < 64u64 {
            true -> named(context, slot, rank, upstream + 1u64)
            _ -> (error(DENIED))
        }
    }
    machine forwarded(gate: &Gate, context: &mut State, slot: u64 [0..=2], rank: u64, upstream: u64) -> [u64; 8] reaches Kernel requires rank < 64u64 {
        let mut request: [u64; 8];
        request[0] = SURFACE_CREATE;
        request[1] = context.world.parent.epoch;
        request[2] = upstream;
        let reply: Reply = block runtime::services::main::exchange(gate, &mut context.parent, context.clock, &request);
        transition reply {
            Reply::Received { words } -> accepted(context, slot, rank, words)
            Reply::Failed { code } -> (error(code))
        }
    }
    machine accepted(context: &mut State, slot: u64 [0..=2], rank: u64, words: [u64; 8]) -> [u64; 8] requires rank < 64u64 {
        transition words[0] == 0u64 {
            true -> named(context, slot, rank, words[1])
            _ -> (error(words[0]))
        }
    }
    machine named(context: &mut State, slot: u64 [0..=2], rank: u64, upstream: u64) -> [u64; 8] requires rank < 64u64 {
        let name: u64 = surfaces::create(&mut context.world, slot, rank, upstream);
        let mut reply: [u64; 8];
        reply[1] = name;
        reply
    }
}
public machine update(gate: &Gate, context: &mut State, slot: u64 [0..=2], incarnation: u64, frame: Frame) -> [u64; 8]
    reaches Kernel blocks; invokes Kernel; {
    let preview: Updated = surfaces::update(&mut context.world, slot, incarnation, &frame.payload, false);
    transition preview {
        Updated::Packet { words } -> block publishing(gate, context, slot, incarnation, frame, words)
        Updated::Refused { code } -> (error(code))
    }
    machine publishing(gate: &Gate, context: &mut State, slot: u64 [0..=2], incarnation: u64, frame: Frame, packet: [u64; 8]) -> [u64; 8] reaches Kernel {
        transition context.has_parent {
            true -> block forwarded(gate, context, slot, incarnation, frame, packet)
            _ -> recorded(context, slot, incarnation, frame, packet)
        }
    }
    machine recorded(context: &mut State, slot: u64 [0..=2], incarnation: u64, frame: Frame, packet: [u64; 8]) -> [u64; 8] {
        context.last_presented = packet;
        transition { _ -> committed(context, slot, incarnation, frame) }
    }
    machine forwarded(gate: &Gate, context: &mut State, slot: u64 [0..=2], incarnation: u64, frame: Frame, packet: [u64; 8]) -> [u64; 8] reaches Kernel {
        let reply: Reply = block runtime::services::main::exchange(gate, &mut context.parent, context.clock, &packet);
        transition reply {
            Reply::Received { words } -> accepted(context, slot, incarnation, frame, words)
            Reply::Failed { code } -> (error(code))
        }
    }
    machine accepted(context: &mut State, slot: u64 [0..=2], incarnation: u64, frame: Frame, words: [u64; 8]) -> [u64; 8] {
        transition words[0] == 0u64 {
            true -> committed(context, slot, incarnation, frame)
            _ -> (words)
        }
    }
    machine committed(context: &mut State, slot: u64 [0..=2], incarnation: u64, frame: Frame) -> [u64; 8] {
        let committed: Updated = surfaces::update(&mut context.world, slot, incarnation, &frame.payload, true);
        let reply: [u64; 8];
        reply
    }
}
// Erasures owed since the last flush: forwarded to the parent, which may already
// have retired that backing, or counted at the top level.
public machine flush(gate: &Gate, context: &mut State) -> u64 reaches Kernel blocks; invokes Kernel; {
    let owed: Retained = surfaces::take_owed(&mut context.world);
    transition owed {
        Retained::Packet { words } -> block owed_one(gate, context, words)
        Retained::Nothing -> (0u64)
    }
    machine owed_one(gate: &Gate, context: &mut State, words: [u64; 8]) -> u64 reaches Kernel {
        context.erased = ((context.erased as u64 in Wrapping) + 1u64) as u64;
        transition context.has_parent {
            true -> block forwarded(gate, context, words)
            _ -> block flush(gate, context)
        }
    }
    machine forwarded(gate: &Gate, context: &mut State, words: [u64; 8]) -> u64 reaches Kernel {
        let reply: Reply = block runtime::services::main::exchange(gate, &mut context.parent, context.clock, &words);
        transition reply {
            Reply::Received { words } -> block answered(gate, context, words[0])
            Reply::Failed { code } -> (code)
        }
    }
    machine answered(gate: &Gate, context: &mut State, status: u64) -> u64 reaches Kernel {
        transition status == 0u64 || status == DENIED || status == BAD_HANDLE {
            true -> block flush(gate, context)
            _ -> (status)
        }
    }
}
public machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
