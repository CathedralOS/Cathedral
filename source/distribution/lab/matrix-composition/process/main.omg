// Independent matrix: admit three peers from lent launches, give each a third
// of the granted area, offer them services, and route attenuated input. No stock
// desktop, launcher, configuration object, taskbar or filesystem is involved.
// One turn serves the owner, each slot and the relay probe, then parks on every
// live interest. Three slots, equal regions and the probe are this proof's policy.
use {runtime}/entry.omg;
use {runtime}/kernel.omg;
use {runtime}/server/main.omg;
use {runtime}/admission/main.omg as admission_main;
use {runtime}/services/main.omg as services_main;
use {runtime}/time.omg;
use {runtime}/waiting.omg;
use {world}/level.omg;
use {world}/management.omg;
use {world}/launches.omg;
use {world}/layout.omg;
use {world}/geometry.omg;
use startup.omg;
use commands.omg;
use slots.omg;
use probe.omg;
use rollback.omg;
use presentation.omg;
public data State {
    owner: |main|::Server;
    slots: [|admission_main|::Admitted; 3];
    world: |level|::World;
    parent: |services_main|::Services;
    has_parent: bool;
    probe: |probe|::Probe;
    clock: u64;
    deadline: u64;
    // The channel-exhaustion probe waits until every listener holds its bell.
    probe_rollback: bool;
    // Proof-only observations: the last packet presented upstream, erasures flushed.
    last_presented: [u64; 8];
    erased: u64;
    width: u64;
    height: u64;
    keys: u64;
    // Delegated authority: management grants, launch observations, the owner's
    // one placement snapshot and the arrangement a controller stages row by row.
    managers: |management|::Management;
    observations: |launches|::Launches;
    saved_placement: |layout|::Placement;
    layout_rows: [|geometry|::Rect; 5];
}
public ProgramProvider satisfies |entry|::Program {
    machine run(gate: &|kernel|::Gate, first: u64, second: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
        let mut context: State;
        let status: u64 = block |startup|::open(gate, &mut context);
        transition status == 0u64 {
            true -> block serve(gate, &mut context)
            _ -> block cleanup(gate, &mut context, status)
        }
    }
}
machine serve(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    let tick: |time|::Tick = |time|::read(gate, context.clock);
    transition tick {
        |time|::Tick::Read { value } -> block turn(gate, context, value)
        _ -> block cleanup(gate, context, 401u64)
    }
}
machine turn(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    transition |time|::reached(now, context.deadline) {
        true -> block cleanup(gate, context, 402u64)
        _ -> block served(gate, context, now)
    }
}
machine served(gate: &|kernel|::Gate, context: &mut State, now: u64) -> u64 reaches |kernel|::Kernel {
    let probed: u64 = block |rollback|::deferred(gate, context, now);
    let commanded: u64 = block |commands|::step(gate, context, now);
    let first: u64 = block |slots|::step(gate, context, 0u64, now);
    let second: u64 = block |slots|::step(gate, context, 1u64, now);
    let third: u64 = block |slots|::step(gate, context, 2u64, now);
    let relayed: u64 = block |probe|::progress(gate, context, now);
    let flushed: u64 = block |presentation|::flush(gate, context);
    transition probed == 0u64 && commanded == 0u64 && first == 0u64 && second == 0u64 && third == 0u64 && relayed == 0u64 && flushed == 0u64 {
        true -> block parked(gate, context)
        _ -> block cleanup(gate, context, 403u64)
    }
}
machine parked(gate: &|kernel|::Gate, context: &mut State) -> u64 reaches |kernel|::Kernel {
    let mut set: |waiting|::Set;
    |waiting|::reset(&mut set, context.deadline);
    |main|::watch(&context.owner, &mut set);
    |slots|::watch(context, 0u64, &mut set);
    |slots|::watch(context, 1u64, &mut set);
    |slots|::watch(context, 2u64, &mut set);
    |probe|::watch(context, &mut set);
    let status: u64 = block |waiting|::wait(gate, &set);
    transition status < |kernel|::ERROR_BASE || status == |kernel|::TIMED_OUT || status == |kernel|::PEER_CLOSED {
        true -> block serve(gate, context)
        _ -> block cleanup(gate, context, 404u64)
    }
}
machine cleanup(gate: &|kernel|::Gate, context: &mut State, status: u64) -> u64 reaches |kernel|::Kernel {
    block |slots|::reclaim(gate, context, 0u64);
    block |slots|::reclaim(gate, context, 1u64);
    block |slots|::reclaim(gate, context, 2u64);
    block |main|::close(gate, &mut context.owner);
    block |services_main|::close(gate, &mut context.parent);
    status
}
public machine component_entry() reaches |entry|::Program + |kernel|::Kernel blocks invokes |entry|::Program invokes |kernel|::Kernel {
    let gate: |kernel|::Gate;
    let status: u64 = block |entry|::Program::run(&gate, 0u64, 0u64);
}
