use {runtime}/server/main.omg as server_main;
// Proof-only owner words, numbered far above the platform's: read the last
// packet this matrix presented upstream, count the erasures it flushed, drive
// the owner side of frame demand and visibility for one slot, and resolve the
// cursor a local stream currently presents. The stock matrix reaches the same
// World operations from its capture, layout and cursor policy. This is lab
// orchestration, not a platform protocol.
use main.omg;
use {runtime}/kernel.omg;
use {runtime}/connection/main.omg as connection_main;
use {world}/demand.omg;
use {world}/names.omg;
use {world}/input/main.omg as input_main;
use {world}/input/cursor.omg;

public const LAST_PRESENTED: u64 = 900u64;
public const ERASED: u64 = 901u64;
public const REQUEST_FRAME: u64 = 902u64;
public const FRAME_READY: u64 = 903u64;
public const RELEASE_FRAME: u64 = 904u64;
public const VISIBLE: u64 = 905u64;
public const CURSOR: u64 = 906u64;

public machine answer(gate: &|kernel|::Gate, context: &mut |main|::State, frame: |connection_main|::Frame) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition {
        frame.payload[0] == LAST_PRESENTED -> block reply(gate, context, context.last_presented)
        frame.payload[0] == ERASED -> block counted(gate, context)
        frame.payload[0] == CURSOR -> block resolved(gate, context, frame.payload[1])
        frame.payload[1] < 3u64 -> block slotted(gate, context, frame, frame.payload[1])
        _ -> block refused(gate, context, |kernel|::DENIED)
    }
    machine counted(gate: &|kernel|::Gate, context: &mut |main|::State) -> u64 reaches |kernel|::Kernel {
        let mut words: [u64; 8];
        words[1] = context.erased;
        block reply(gate, context, words)
    }
    // The cursor behind a local stream name: found, channel, inherited, cycle, mode.
    machine resolved(gate: &|kernel|::Gate, context: &mut |main|::State, channel: u64) -> u64 reaches |kernel|::Kernel {
        let index: u64 = |input_main|::stream_of(&context.world.input, |names|::local(channel));
        let found: |cursor|::Found = |cursor|::cursor::cursor(&context.world, index);
        transition found {
            |cursor|::Found::Observed { seen } -> block observed(gate, context, seen)
            |cursor|::Found::Nothing -> block refused(gate, context, 0u64)
        }
    }
    machine observed(gate: &|kernel|::Gate, context: &mut |main|::State, seen: |cursor|::Cursor) -> u64 reaches |kernel|::Kernel {
        let mut words: [u64; 8];
        words[1] = 1u64;
        words[2] = seen.channel;
        words[3] = flag(seen.inherited);
        words[4] = seen.cycle;
        words[5] = seen.mode;
        block reply(gate, context, words)
    }
    machine slotted(gate: &|kernel|::Gate, context: &mut |main|::State, frame: |connection_main|::Frame, slot: u64 [0..=2]) -> u64 reaches |kernel|::Kernel {
        let incarnation: u64 = context.world.children[slot].incarnation;
        let epoch: u64 = context.world.children[slot].grant.epoch;
        transition {
            frame.payload[0] == REQUEST_FRAME -> block requested(gate, context, slot, incarnation, epoch)
            frame.payload[0] == FRAME_READY -> block ready(gate, context, slot, incarnation, epoch, frame.payload[2])
            frame.payload[0] == RELEASE_FRAME -> block released(gate, context, slot, incarnation, epoch, frame.payload[2])
            frame.payload[0] == VISIBLE -> block shown(gate, context, slot, frame.payload[2] != 0u64)
            _ -> block refused(gate, context, |kernel|::DENIED)
        }
    }
    machine requested(gate: &|kernel|::Gate, context: &mut |main|::State, slot: u64 [0..=2], incarnation: u64, epoch: u64) -> u64 reaches |kernel|::Kernel {
        let requested: |demand|::Requested = |demand|::request_frame(&mut context.world, slot, incarnation, epoch);
        transition requested {
            |demand|::Requested::Ticket { ticket } -> block ticketed(gate, context, ticket)
            |demand|::Requested::Refused { code } -> block refused(gate, context, code)
        }
    }
    machine ticketed(gate: &|kernel|::Gate, context: &mut |main|::State, ticket: u64) -> u64 reaches |kernel|::Kernel {
        let mut words: [u64; 8];
        words[1] = ticket;
        block reply(gate, context, words)
    }
    machine ready(gate: &|kernel|::Gate, context: &mut |main|::State, slot: u64 [0..=2], incarnation: u64, epoch: u64, ticket: u64) -> u64 reaches |kernel|::Kernel {
        let mut words: [u64; 8];
        words[1] = flag(|demand|::frame_ready(&context.world, slot, incarnation, epoch, ticket));
        block reply(gate, context, words)
    }
    machine released(gate: &|kernel|::Gate, context: &mut |main|::State, slot: u64 [0..=2], incarnation: u64, epoch: u64, ticket: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = |demand|::release_frame(&mut context.world, slot, incarnation, epoch, ticket);
        block refused(gate, context, status)
    }
    machine shown(gate: &|kernel|::Gate, context: &mut |main|::State, slot: u64 [0..=2], visible: bool) -> u64 reaches |kernel|::Kernel {
        let status: u64 = |demand|::visible(&mut context.world, slot, visible);
        block refused(gate, context, status)
    }
}
machine flag(value: bool) -> u64 {
    transition value { true -> (1u64) _ -> (0u64) }
}
machine refused(gate: &|kernel|::Gate, context: &mut |main|::State, code: u64) -> u64 reaches |kernel|::Kernel {
    let mut words: [u64; 8];
    words[0] = code;
    block reply(gate, context, words)
}
machine reply(gate: &|kernel|::Gate, context: &mut |main|::State, words: [u64; 8]) -> u64 reaches |kernel|::Kernel {
    block |server_main|::reply(gate, &mut context.owner, &words)
}
