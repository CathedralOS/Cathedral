// Requested repr(C) operand geometry, independently measured in the pinned Rust mirror.
use {omega}/language/core/layout.omg;
pub data InvpcidDescriptorLayout {}
pub InvpcidDescriptorPolicy: InvpcidDescriptorLayout satisfies |layout|::Layout;
pub machine InvpcidDescriptorLayout::plan(schema: |layout|::Schema) -> |layout|::Plan satisfies |layout|::Layout::plan {
    let mut entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, placement: |layout|::FieldPlan::At { offset: 0 } };
    entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, placement: |layout|::FieldPlan::At { offset: 8 } };
    |layout|::Plan { entries: entries, entry_count: 2, size_fixed: 16, size_is_dynamic: false, align: 8 }
}
