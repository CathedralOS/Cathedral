module storage::entries;
// ENTRIES: ordered 80-byte rows, canonical metadata, and an exact final cursor.
use storage::metadata;
public machine valid(words: &[u64; 510], count: u64, after: u64, last: u64) -> bool {
    transition count > 0u64 && count <= 51u64 && last > after {
        true -> row(words, count, after, last, 0u64)
        _ -> (false)
    }
}
machine row(words: &[u64; 510], count: u64, previous: u64, last: u64, i: u64) -> bool {
    transition i < count && i < 51u64 {
        true -> ordered(words, count, previous, last, i)
        _ -> (previous == last)
    }
}
machine ordered(words: &[u64; 510], count: u64, previous: u64, last: u64, i: u64) -> bool requires i < 51u64 {
    transition words[i * 10u64] > previous && field(words, i * 10u64 + 2u64, true) && field(words, i * 10u64 + 6u64, false) {
        true -> row(words, count, words[i * 10u64], last, i + 1u64)
        _ -> (false)
    }
}
machine field(words: &[u64; 510], offset: u64, name: bool) -> bool {
    let mut text: [u8; 32];
    unpack(words, &mut text, offset, 0u64);
    storage::metadata::valid(&text, name)
}
machine unpack(words: &[u64; 510], text: &mut [u8; 32], offset: u64, i: u64) {
    transition offset <= 506u64 && i < 32u64 {
        true -> byte(words, text, offset, i)
        _ -> done()
    }
    machine byte(words: &[u64; 510], text: &mut [u8; 32], offset: u64, i: u64) requires offset <= 506u64 && i < 32u64 {
        text[i] = ((words[offset + i / 8u64] >> ((i % 8u64) * 8u64)) & 255u64) as u8;
        transition { _ -> unpack(words, text, offset, i + 1u64) }
    }
}
machine done() {}
