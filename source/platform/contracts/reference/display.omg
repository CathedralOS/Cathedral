module display;
// Display service protocol: the six-word frames a root matrix exchanges with
// the compositor. Wire owner: source-rs/platform/contracts/display/.
public const REQUEST_BYTES: u64 = 48u64;
public const INFO: u64 = 0u64;
public const CLEAR: u64 = 1u64;
public const RECT: u64 = 2u64;
public const TEXT: u64 = 3u64;
public const BLIT: u64 = 4u64;
// The retained compositor (display/composition.rs): control words, and the
// root adapter's tiles, cursor, pointer and begin/commit transaction. Tile
// words carry the tile index in their high bits.
public const COMPOSITION_MODE: u64 = 0x434f4d50u64;
public const SUBMIT: u64 = 16u64;
public const BACKGROUND: u64 = 17u64;
public const PLACE: u64 = 18u64;
public const PIXEL: u64 = 19u64;
public const STATUS: u64 = 20u64;
public const MATRIX_RECT: u64 = 21u64;
public const MATRIX_POINTER: u64 = 22u64;
public const MATRIX_IMAGE: u64 = 23u64;
public const MATRIX_BEGIN: u64 = 24u64;
public const MATRIX_COMMIT: u64 = 25u64;
public const MATRIX_ABORT: u64 = 26u64;
public const MATRIX_CURSOR: u64 = 27u64;
public const MATRIX_POINTER_STYLE: u64 = 28u64;
public const MATRIX_TILES: u64 = 64u64;
