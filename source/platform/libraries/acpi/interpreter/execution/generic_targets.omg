// Primary ACPI 6.6 binding semantics. Reads and writable target selection are
// distinct; Shared argument objects are never overwritten by ordinary Arg writes.
use {aml}/model.omg;
use {aml}/object_references.omg;
use execution_model.omg;
use generic_values.omg;

pub machine read_generic_target(store:&|model|::ObjectStore,frame:&|execution_model|::Frame,target:|execution_model|::Target)->|execution_model|::OperandResult {
 transition target {
  |execution_model|::Target::Local {local_index} -> local(frame,local_index)
  |execution_model|::Target::Argument {argument_index} -> argument(store,frame,argument_index)
  |execution_model|::Target::Named {object_id} -> (|execution_model|::OperandResult {operand:|execution_model|::Operand::Object {object_id:object_id}})
  |execution_model|::Target::Null -> (|execution_model|::OperandResult {outcome:|execution_model|::ExecutionOutcome::InvalidTarget})
  |execution_model|::Target::Debug -> (|execution_model|::OperandResult {outcome:|execution_model|::ExecutionOutcome::UnresolvedService})
 }
 state local(frame:&|execution_model|::Frame,index:u64)->|execution_model|::OperandResult {
  transition index<8 {true -> binding(frame.locals[index]) _ -> (|execution_model|::OperandResult {outcome:|execution_model|::ExecutionOutcome::InvalidTarget})}
 }
 state binding(value:|execution_model|::Binding)->|execution_model|::OperandResult {let operand:|execution_model|::Operand=|generic_values|::binding_operand(value);|execution_model|::OperandResult {operand:operand}}
 state argument(store:&|model|::ObjectStore,frame:&|execution_model|::Frame,index:u64)->|execution_model|::OperandResult {
  transition index<7 {true -> arg_binding(store,frame.arguments[index]) _ -> (|execution_model|::OperandResult {outcome:|execution_model|::ExecutionOutcome::InvalidTarget})}
 }
 state arg_binding(store:&|model|::ObjectStore,binding:|execution_model|::Binding)->|execution_model|::OperandResult {
  let operand:|execution_model|::Operand=|generic_values|::binding_operand(binding);let value:|execution_model|::ValueResult=|generic_values|::read_value(store,operand);
  transition value.outcome==|execution_model|::ExecutionOutcome::Success {true -> arg_value(store,operand,value.value) _ -> (|execution_model|::OperandResult {outcome:value.outcome})}
 }
 state arg_value(store:&|model|::ObjectStore,operand:|execution_model|::Operand,value:|model|::Value)->|execution_model|::OperandResult {
  transition value {|model|::Value::Reference {kind,object_id} -> arg_reference(store,kind,object_id) _ -> (|execution_model|::OperandResult {operand:operand})}
 }
 state arg_reference(store:&|model|::ObjectStore,kind:|model|::ReferenceKind,id:u64)->|execution_model|::OperandResult {
  transition kind {|model|::ReferenceKind::RefOf -> dereference(store,id) |model|::ReferenceKind::Index -> dereference(store,id) _ -> (|execution_model|::OperandResult {outcome:|execution_model|::ExecutionOutcome::InvalidTarget})}
 }
 state dereference(store:&|model|::ObjectStore,id:u64)->|execution_model|::OperandResult {
  let found:|model|::ReferenceState=|object_references|::unwrap_all(&store.space,id,64);let outcome:|execution_model|::ExecutionOutcome=|generic_values|::object_outcome(found.outcome);
  |execution_model|::OperandResult {outcome:outcome,operand:|execution_model|::Operand::Object {object_id:found.object}}
 }
}

use generic_target_model.omg;
pub machine select_target(frame:&|execution_model|::Frame,target:|execution_model|::Target)->|generic_target_model|::TargetSelection {
 transition target {|execution_model|::Target::Null -> (|generic_target_model|::TargetSelection::Null) |execution_model|::Target::Debug -> (|generic_target_model|::TargetSelection::Debug) |execution_model|::Target::Named {object_id} -> (|generic_target_model|::TargetSelection::Named {object_id:object_id}) |execution_model|::Target::Local {local_index} -> local(frame,local_index) |execution_model|::Target::Argument {argument_index} -> argument(frame,argument_index)}
 state local(frame:&|execution_model|::Frame,index:u64)->|generic_target_model|::TargetSelection {transition index<8 {true -> (|generic_target_model|::TargetSelection::Local {local_index:index,local_binding:frame.locals[index]}) _ -> (|generic_target_model|::TargetSelection::Failure {outcome:|execution_model|::ExecutionOutcome::InvalidTarget})}}
 state argument(frame:&|execution_model|::Frame,index:u64)->|generic_target_model|::TargetSelection {transition index<7 {true -> (|generic_target_model|::TargetSelection::Argument {argument_index:index,argument_binding:frame.arguments[index]}) _ -> (|generic_target_model|::TargetSelection::Failure {outcome:|execution_model|::ExecutionOutcome::InvalidTarget})}}
}
pub machine publish_target(frame:&mut |execution_model|::Frame,selection:|generic_target_model|::TargetSelection,result:|execution_model|::BindingResult)->|execution_model|::ExecutionOutcome {
 transition result.outcome==|execution_model|::ExecutionOutcome::Success {true -> selected(frame,selection,result.binding) _ -> (result.outcome)}
 state selected(frame:&mut |execution_model|::Frame,selection:|generic_target_model|::TargetSelection,binding:|execution_model|::Binding)->|execution_model|::ExecutionOutcome {
  transition selection {|generic_target_model|::TargetSelection::Local {local_index,local_binding} -> local_bound(frame,local_index,binding) |generic_target_model|::TargetSelection::Argument {argument_index,argument_binding} -> argument_bound(frame,argument_index,binding) |generic_target_model|::TargetSelection::Failure {outcome} -> (outcome) _ -> (|execution_model|::ExecutionOutcome::Success)}
 }
 state local_bound(frame:&mut |execution_model|::Frame,index:u64,binding:|execution_model|::Binding)->|execution_model|::ExecutionOutcome {transition index<8 {true -> local(frame,index,binding) _ -> (|execution_model|::ExecutionOutcome::InvalidTarget)}}
 state argument_bound(frame:&mut |execution_model|::Frame,index:u64,binding:|execution_model|::Binding)->|execution_model|::ExecutionOutcome {transition index<7 {true -> argument(frame,index,binding) _ -> (|execution_model|::ExecutionOutcome::InvalidTarget)}}
 state local(frame:&mut |execution_model|::Frame,index:u64,binding:|execution_model|::Binding)->|execution_model|::ExecutionOutcome {frame.locals[index]=binding;|execution_model|::ExecutionOutcome::Success}
 state argument(frame:&mut |execution_model|::Frame,index:u64,binding:|execution_model|::Binding)->|execution_model|::ExecutionOutcome {frame.arguments[index]=binding;|execution_model|::ExecutionOutcome::Success}
}
