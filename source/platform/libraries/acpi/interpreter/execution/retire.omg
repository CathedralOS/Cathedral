// Retire a completed scalar/control operation. Divide writes remainder then
// quotient in AML grammar order. Namespace side effects are not rolled back.
use {aml}/model.omg;
use execution_model.omg;
use generic_values.omg;
use generic_target_bridge.omg;
use operands.omg;
use {aml}/bytes.omg;
use execution_names.omg;
use targets.omg;

use control.omg;
use operator_specs.omg;
use to_integer_execution.omg;
use mid_execution.omg;
use {integer_helpers}/integers.omg;
pub machine retire_operation(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,operation:|execution_model|::Operation)->|execution_model|::ExecutionOutcome {
 transition operation.opcode {
  0xa4 -> returned(input,space,frame,operation.operands[0])
  0xa0 -> branch(input,space,frame,operation.opcode,operation.body_end,operation.parent_end,operation.predicate,operation.operands[0])
  0xa2 -> branch(input,space,frame,operation.opcode,operation.body_end,operation.parent_end,operation.predicate,operation.operands[0])
  0x70 -> copy(input,space,frame,operation.first_target,operation.operands[0],false)
  0x99 -> integer_conversion_retirement(input,space,frame,operation.operands[0],operation.first_target)
  0x9e -> mid_retirement(input,space,frame,operation)
  0x9d -> copy(input,space,frame,operation.first_target,operation.operands[0],true)
  0x75 -> increment(input,space,frame,operation.opcode,operation.target_arity,operation.first_target,operation.second_target)
  0x76 -> increment(input,space,frame,operation.opcode,operation.target_arity,operation.first_target,operation.second_target)
  _ -> scalar_a(input,space,frame,operation.opcode,operation.value_arity,operation.target_arity,operation.first_target,operation.second_target,operation.operands[0],operation.operands[1])
 }
 state integer_conversion_retirement(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,operand:|execution_model|::Operand,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
  let result:|execution_model|::ExecutionOutcome=|to_integer_execution|::retire_to_integer(input,space,frame,operand,target);result
 }
 state mid_retirement(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,operation:|execution_model|::Operation)->|execution_model|::ExecutionOutcome {
  let result:|execution_model|::ExecutionOutcome=|mid_execution|::retire_mid(input,space,frame,operation.operands[0],operation.operands[1],operation.operands[2],operation.first_target);result
 }
 state returned(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
  let admitted:|execution_model|::ExecutionOutcome=|generic_values|::validate_operand(input,frame.source_length,frame.body.unit,space,operand);let normalized:|execution_model|::Operand=|generic_values|::normalized_operand(space,frame.size,operand);
  transition admitted==|execution_model|::ExecutionOutcome::Success {true -> return_value(frame,normalized) _ -> (admitted)}
 }
 state return_value(frame:&mut |execution_model|::Frame,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=|control|::return_operand(frame,operand);result}
 state branch(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,body_end:u64,parent_end:u64,predicate:u64,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
  let scalar:|execution_model|::SlotResult=|generic_values|::integer_operand(space,frame.size,operand);
  transition scalar.outcome==|execution_model|::ExecutionOutcome::Success {true -> branch_value(input,frame,opcode,body_end,parent_end,predicate,scalar.slot.number) _ -> (scalar.outcome)}
 }
 state branch_value(input:&[u8;1024],frame:&mut |execution_model|::Frame,opcode:u64,body_end:u64,parent_end:u64,predicate:u64,number:u64)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=retire_branch(input,frame,opcode,body_end,parent_end,predicate,number);result}
 state copy(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,operand:|execution_model|::Operand,is_copy:bool)->|execution_model|::ExecutionOutcome {
  let result:|execution_model|::ExecutionOutcome=|generic_target_bridge|::write_generic_target(input,space,frame,target,operand,is_copy);
  transition result==|execution_model|::ExecutionOutcome::Success {true -> copied(space,frame,target,operand,is_copy) _ -> (result)}
 }
 // ACPI 6.6 19.6.132: Store's expression result is the data written. Named
 // implicit conversion may change its type; CopyObject still contributes the
 // copied source. Arithmetic operators retain their own result contracts.
 state copied(space:&|model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,operand:|execution_model|::Operand,is_copy:bool)->|execution_model|::ExecutionOutcome {
  transition is_copy {true -> contribute(frame,operand) _ -> stored(space,frame,target,operand)}
 }
 state stored(space:&|model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
  transition target {|execution_model|::Target::Named {object_id} -> named_result(space,frame,object_id) _ -> contribute(frame,operand)}
 }
 state named_result(space:&|model|::ObjectStore,frame:&mut |execution_model|::Frame,id:u64)->|execution_model|::ExecutionOutcome {
  let operand:|execution_model|::Operand=|generic_values|::normalized_operand(space,frame.size,|execution_model|::Operand::Object {object_id:id});
  let result:|execution_model|::ExecutionOutcome=|operands|::contribute_operand(frame,operand);result
 }
 state contribute(frame:&mut |execution_model|::Frame,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=|operands|::contribute_operand(frame,operand);result}
 state increment(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,targets:u64,first:|execution_model|::Target,second:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
  let value:|execution_model|::SlotResult=|targets|::read_target(space,frame,first);
  transition value.outcome==|execution_model|::ExecutionOutcome::Success {true -> compute(input,space,frame,opcode,targets,first,second,value.slot.number,1) _ -> (value.outcome)}
 }
 state scalar_a(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,values:u64,targets:u64,first:|execution_model|::Target,second:|execution_model|::Target,a_operand:|execution_model|::Operand,b_operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
  let value:|execution_model|::SlotResult=|generic_values|::integer_operand(space,frame.size,a_operand);
  transition value.outcome==|execution_model|::ExecutionOutcome::Success {true -> scalar_b(input,space,frame,opcode,values,targets,first,second,value.slot.number,b_operand) _ -> (value.outcome)}
 }
 state scalar_b(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,values:u64,targets:u64,first:|execution_model|::Target,second:|execution_model|::Target,a:u64,b_operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
  transition values>1 {true -> scalar_second(input,space,frame,opcode,targets,first,second,a,b_operand) _ -> compute(input,space,frame,opcode,targets,first,second,a,0)}
 }
 state scalar_second(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,targets:u64,first:|execution_model|::Target,second:|execution_model|::Target,a:u64,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
  let value:|execution_model|::SlotResult=|generic_values|::integer_operand(space,frame.size,operand);
  transition value.outcome==|execution_model|::ExecutionOutcome::Success {true -> compute(input,space,frame,opcode,targets,first,second,a,value.slot.number) _ -> (value.outcome)}
 }
 state compute(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,targets:u64,first:|execution_model|::Target,second:|execution_model|::Target,a:u64,b:u64)->|execution_model|::ExecutionOutcome {
  let result:|integers|::IntegerResult=|operator_specs|::compute_integer(frame.size,opcode,a,b);
  transition {result.error==1 -> (|execution_model|::ExecutionOutcome::DivideByZero) result.error!=0 -> (|execution_model|::ExecutionOutcome::BadEncoding) _ -> store(input,space,frame,opcode,targets,first,second,result)}
 }
 state store(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,targets:u64,first:|execution_model|::Target,second:|execution_model|::Target,result:|integers|::IntegerResult)->|execution_model|::ExecutionOutcome {
  let outcome:|execution_model|::ExecutionOutcome=operation_stores(input,space,frame,opcode,targets,first,second,result);
  transition outcome==|execution_model|::ExecutionOutcome::Success {true -> integer(frame,result.value) _ -> (outcome)}
 }
 state integer(frame:&mut |execution_model|::Frame,number:u64)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=|operands|::contribute_integer(frame,number);result}
}
machine operation_stores(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,opcode:u64,targets:u64,first:|execution_model|::Target,second:|execution_model|::Target,result:|integers|::IntegerResult)->|execution_model|::ExecutionOutcome {
 transition {targets==0 -> (|execution_model|::ExecutionOutcome::Success) opcode==0x78 -> divide(input,space,frame,first,second,result) _ -> write_first(input,space,frame,first,result.value)}
 state write_first(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,number:u64)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=|targets|::store_target(input,space,frame,target,number);result}
 state divide(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,first:|execution_model|::Target,second:|execution_model|::Target,result:|integers|::IntegerResult)->|execution_model|::ExecutionOutcome {
  let outcome:|execution_model|::ExecutionOutcome=|targets|::store_target(input,space,frame,first,result.remainder);
  transition outcome==|execution_model|::ExecutionOutcome::Success {true -> quotient(input,space,frame,second,result.value) _ -> (outcome)}
 }
 state quotient(input:&[u8;1024],space:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,number:u64)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=|targets|::store_target(input,space,frame,target,number);result}
}
pub data ElseBranch [copy] { outcome: |execution_model|::ExecutionOutcome; present: bool; start: u64; end: u64; }
machine else_branch(input: &[u8; 1024], at: u64, end: u64) -> ElseBranch {
    transition at < end && end <= 1024 { true -> peek(input, at, end) _ -> (ElseBranch { end: at }) }
    state peek(input: &[u8; 1024], at: u64, end: u64) -> ElseBranch {
        let byte: |model|::Read = |bytes|::read_le(input, end, at, 1);
        transition byte.value == 0xa1 && at < 1024 { true -> package(input, at + 1, end) _ -> (ElseBranch { end: at }) }
    }
    state package(input: &[u8; 1024], at: u64, end: u64) -> ElseBranch {
        let body: |model|::Envelope = |bytes|::envelope(input, end, at);
        let outcome: |execution_model|::ExecutionOutcome = |execution_names|::decode_outcome(body.outcome);
        ElseBranch { outcome: outcome, present: true, start: body.body, end: body.end }
    }
}
machine retire_branch(input: &[u8; 1024], frame: &mut |execution_model|::Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> |execution_model|::ExecutionOutcome {
    transition frame.pc <= body_end && body_end <= parent_end && parent_end <= frame.body.end && frame.body.end <= 1024 {
        true -> restore(input, frame,opcode,body_end,parent_end,predicate,condition) _ -> (|execution_model|::ExecutionOutcome::BadEncoding)
    }
    state restore(input: &[u8; 1024], frame: &mut |execution_model|::Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> |execution_model|::ExecutionOutcome {
        frame.end = parent_end;
        transition opcode == 0xa2 { true -> while_branch(frame,opcode,body_end,parent_end,predicate,condition) _ -> if_branch(input, frame,opcode,body_end,parent_end,predicate,condition) }
    }
    state while_branch(frame: &mut |execution_model|::Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> |execution_model|::ExecutionOutcome {
        transition condition != 0 { true -> enter_while(frame,opcode,body_end,parent_end,predicate,condition) _ -> skip(frame, body_end) }
    }
    state enter_while(frame: &mut |execution_model|::Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> |execution_model|::ExecutionOutcome {
        let result: |execution_model|::ExecutionOutcome = |control|::enter_block(frame, frame.pc, body_end, body_end, true, predicate); result
    }
    state if_branch(input: &[u8; 1024], frame: &mut |execution_model|::Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,condition:u64) -> |execution_model|::ExecutionOutcome {
        let otherwise: ElseBranch = else_branch(input, body_end, parent_end);
        transition otherwise.outcome == |execution_model|::ExecutionOutcome::Success { true -> choose(frame,opcode,body_end,parent_end,predicate,otherwise,condition) _ -> (otherwise.outcome) }
    }
    state choose(frame: &mut |execution_model|::Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,otherwise:ElseBranch,condition:u64) -> |execution_model|::ExecutionOutcome {
        transition { condition != 0 -> then(frame,opcode,body_end,parent_end,predicate,otherwise,condition)
            otherwise.present -> otherwise(frame, otherwise,condition)
            _ -> skip(frame, body_end) }
    }
    state then(frame: &mut |execution_model|::Frame, opcode:u64,body_end:u64,parent_end:u64,predicate:u64,otherwise:ElseBranch,condition:u64) -> |execution_model|::ExecutionOutcome {
        let result: |execution_model|::ExecutionOutcome = |control|::enter_block(frame, frame.pc, body_end, otherwise.end, false, 0); result
    }
    state otherwise(frame: &mut |execution_model|::Frame, otherwise: ElseBranch, condition:u64) -> |execution_model|::ExecutionOutcome {
        let result: |execution_model|::ExecutionOutcome = |control|::enter_block(frame, otherwise.start, otherwise.end, otherwise.end, false, 0); result
    }
    state skip(frame: &mut |execution_model|::Frame, next: u64) -> |execution_model|::ExecutionOutcome { frame.pc = next; |execution_model|::ExecutionOutcome::Success }
}
