// SPDX-License-Identifier: MIT OR Apache-2.0
// Canonical external Values are staged outside Runtime. Failure publishes no
// object slots or byte blocks; standalone Owned locators remain inadmissible.
use {omega}/language/core/nat.omg;
use {aml}/model.omg;
use execution_model.omg;
use generic_values.omg;
use {integer_helpers}/integers.omg;
pub data ExternalArguments [copy] {outcome:|execution_model|::ExecutionOutcome;operands:[|execution_model|::Operand;7];}
data ExternalPreflight [copy] {values:[|execution_model|::ValueResult;7];}
pub machine prepare_external_arguments(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,arguments:&[|model|::Value;7],count:u64,size:|integers|::IntegerSize)->ExternalArguments {
 let objects:u64=store.space.object_count;let entries:u64=store.space.count;
 transition count<=7 && length<=1024 && objects<=64 && entries<=32 {true -> preflight(input,length,unit,store,arguments,count,size) _ -> (ExternalArguments {outcome:|execution_model|::ExecutionOutcome::Capacity})}
 state preflight(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,arguments:&[|model|::Value;7],count:u64,size:|integers|::IntegerSize)->ExternalArguments {
  let mut admitted:ExternalPreflight=ExternalPreflight {};
  let outcome:|execution_model|::ExecutionOutcome=ea_preflight(input,length,unit,store,arguments,&mut admitted,0,count);
  transition outcome==|execution_model|::ExecutionOutcome::Success {true -> stage(store,admitted,count,size) _ -> (ExternalArguments {outcome:outcome})}
 }
 state stage(store:&mut |model|::ObjectStore,admitted:ExternalPreflight,count:u64,size:|integers|::IntegerSize)->ExternalArguments {
  let mut staged:|model|::ObjectStore=|model|::ObjectStore {space:store.space,bytes:store.bytes};let mut result:ExternalArguments=ExternalArguments {};
  let outcome:|execution_model|::ExecutionOutcome=ea_stage(&mut staged,&admitted,&mut result,0,count,size);
  transition outcome==|execution_model|::ExecutionOutcome::Success {true -> commit(store,staged,result) _ -> (ExternalArguments {outcome:outcome})}
 }
 state commit(store:&mut |model|::ObjectStore,staged:|model|::ObjectStore,result:ExternalArguments)->ExternalArguments {
  store.space=staged.space;store.bytes=staged.bytes;result
 }
}
machine ea_preflight(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,arguments:&[|model|::Value;7],admitted:&mut ExternalPreflight,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->|execution_model|::ExecutionOutcome {
 let outcome:|execution_model|::ExecutionOutcome=ea_preflight_one(input,length,unit,store,arguments,admitted,index,count);
 transition {outcome!=|execution_model|::ExecutionOutcome::Success -> (outcome) index<count -> ea_preflight(input,length,unit,store,arguments,admitted,index+1,count) _ -> (outcome)}
}
machine ea_preflight_one(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,arguments:&[|model|::Value;7],admitted:&mut ExternalPreflight,index:u64,count:u64)->|execution_model|::ExecutionOutcome {
 transition index<count && index<7 {true -> one(input,length,unit,store,arguments,admitted,index,count) _ -> (|execution_model|::ExecutionOutcome::Success)}
 state one(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,arguments:&[|model|::Value;7],admitted:&mut ExternalPreflight,index:u64,count:u64)->|execution_model|::ExecutionOutcome {
  let found:|execution_model|::ValueResult=ea_value(store,arguments[index]);let checked:|execution_model|::ValueResult=|generic_values|::admit_value(input,length,unit,store,found);
  transition checked.outcome==|execution_model|::ExecutionOutcome::Success {true -> retain(input,length,unit,store,arguments,admitted,index,count,checked) _ -> (checked.outcome)}
 }
 state retain(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,arguments:&[|model|::Value;7],admitted:&mut ExternalPreflight,index:u64,count:u64,found:|execution_model|::ValueResult)->|execution_model|::ExecutionOutcome {
  transition index<7 {true -> write(admitted,index,found) _ -> (|execution_model|::ExecutionOutcome::Capacity)}
 }
 state write(admitted:&mut ExternalPreflight,index:u64,found:|execution_model|::ValueResult)->|execution_model|::ExecutionOutcome {admitted.values[index]=found;|execution_model|::ExecutionOutcome::Success}
}
machine ea_value(store:&|model|::ObjectStore,value:|model|::Value)->|execution_model|::ValueResult {
 transition value {|model|::Value::Reference {kind,object_id} -> reference(store,value,kind,object_id) _ -> (|execution_model|::ValueResult {value:value})}
 state reference(store:&|model|::ObjectStore,value:|model|::Value,kind:|model|::ReferenceKind,id:u64)->|execution_model|::ValueResult {
  transition kind {|model|::ReferenceKind::Named -> existing(store,id) |model|::ReferenceKind::Local -> existing(store,id) |model|::ReferenceKind::Arg -> existing(store,id) _ -> (|execution_model|::ValueResult {value:value})}
 }
 state existing(store:&|model|::ObjectStore,id:u64)->|execution_model|::ValueResult {let found:|execution_model|::ValueResult=|generic_values|::read_value(store,|execution_model|::Operand::Object {object_id:id});let mut retained:|execution_model|::ValueResult=found;retained.object=id;retained}
}
machine ea_stage(store:&mut |model|::ObjectStore,admitted:&ExternalPreflight,result:&mut ExternalArguments,index:u64,count:u64,size:|integers|::IntegerSize)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->|execution_model|::ExecutionOutcome {
 let outcome:|execution_model|::ExecutionOutcome=ea_stage_one(store,admitted,result,index,count,size);
 transition {outcome!=|execution_model|::ExecutionOutcome::Success -> (outcome) index<count -> ea_stage(store,admitted,result,index+1,count,size) _ -> (outcome)}
}
machine ea_stage_one(store:&mut |model|::ObjectStore,admitted:&ExternalPreflight,result:&mut ExternalArguments,index:u64,count:u64,size:|integers|::IntegerSize)->|execution_model|::ExecutionOutcome {
 transition index<count && index<7 {true -> one(store,admitted,result,index,count,size) _ -> (|execution_model|::ExecutionOutcome::Success)}
 state one(store:&mut |model|::ObjectStore,admitted:&ExternalPreflight,result:&mut ExternalArguments,index:u64,count:u64,size:|integers|::IntegerSize)->|execution_model|::ExecutionOutcome {
  let outcome:|execution_model|::ExecutionOutcome=ea_install(store,result,index,admitted.values[index],size);
  outcome
 }
}
machine ea_install(store:&mut |model|::ObjectStore,result:&mut ExternalArguments,index:u64,found:|execution_model|::ValueResult,size:|integers|::IntegerSize)->|execution_model|::ExecutionOutcome {
 transition index<7 {true -> observed(store,result,index,found,size) _ -> (|execution_model|::ExecutionOutcome::Capacity)}
 state observed(store:&mut |model|::ObjectStore,result:&mut ExternalArguments,index:u64,found:|execution_model|::ValueResult,size:|integers|::IntegerSize)->|execution_model|::ExecutionOutcome {
  transition found.has_object {true -> shared(result,index,found.object) _ -> kind(store,result,index,found,size,found.value)}
 }
 state kind(store:&mut |model|::ObjectStore,result:&mut ExternalArguments,index:u64,found:|execution_model|::ValueResult,size:|integers|::IntegerSize,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  transition value {|model|::Value::Integer {number} -> integer(result,index,size,number) _ -> identity(store,result,index,found)}
 }
 state integer(result:&mut ExternalArguments,index:u64,size:|integers|::IntegerSize,number:u64)->|execution_model|::ExecutionOutcome {let value:u64=|integers|::normalize(size,number);result.operands[index]=|execution_model|::Operand::Integer {number:value};|execution_model|::ExecutionOutcome::Success}
 state identity(store:&mut |model|::ObjectStore,result:&mut ExternalArguments,index:u64,found:|execution_model|::ValueResult)->|execution_model|::ExecutionOutcome {
  transition found.has_object {true -> shared(result,index,found.object) _ -> allocate(store,result,index,found.value)}
 }
 state shared(result:&mut ExternalArguments,index:u64,id:u64)->|execution_model|::ExecutionOutcome {result.operands[index]=|execution_model|::Operand::Object {object_id:id};|execution_model|::ExecutionOutcome::Success}
 state allocate(store:&mut |model|::ObjectStore,result:&mut ExternalArguments,index:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  let id:u64=store.space.object_count;
  transition id<64 {true -> write(store,result,index,value,id) _ -> (|execution_model|::ExecutionOutcome::Capacity)}
 }
 state write(store:&mut |model|::ObjectStore,result:&mut ExternalArguments,index:u64,value:|model|::Value,id:u64)->|execution_model|::ExecutionOutcome {
  store.space.objects[id]=|model|::Object {value:value};store.bytes.blocks[id]=|model|::ByteBlock {};store.space.object_count=id+1;result.operands[index]=|execution_model|::Operand::Object {object_id:id};|execution_model|::ExecutionOutcome::Success
 }
}
