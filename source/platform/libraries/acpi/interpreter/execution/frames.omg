// Bounded scalar MethodContext::new_from_method adaptation; unsupported values
// and serialized methods are rejected before execution, never silently emulated.
use {omega}/language/core/nat.omg;
use {aml}/model.omg;
use {aml}/names.omg;
use {integer_helpers}/integers.omg;
use execution_model.omg;
pub machine scalar_slot(size: |integers|::IntegerSize, value: |model|::Value) -> |execution_model|::SlotResult {
    transition value {
        |model|::Value::Integer { number } -> scalar(size, number)
        |model|::Value::Uninitialized -> (|execution_model|::SlotResult { outcome: |execution_model|::ExecutionOutcome::Uninitialized })
        |model|::Value::FieldUnit {binding,declaration,field} -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::UnresolvedRegion})
        |model|::Value::OperationRegion { space, base, length, scope } -> (|execution_model|::SlotResult { outcome: |execution_model|::ExecutionOutcome::UnresolvedRegion })
        _ -> (|execution_model|::SlotResult { outcome: |execution_model|::ExecutionOutcome::UnsupportedValue })
    }
    state scalar(size: |integers|::IntegerSize, number: u64) -> |execution_model|::SlotResult {
        let value: u64 = |integers|::normalize(size, number);
        |execution_model|::SlotResult { slot: |execution_model|::Slot { initialized: true, number: value } }
    }
}
pub machine new_frame(method: |model|::Value, scope: |model|::Path, arguments: &[|execution_model|::Operand; 7], count: u64,
    size: |integers|::IntegerSize, unit: u64, length: u64) -> |execution_model|::FrameResult {
    let valid: bool = |names|::path_valid(scope);
    transition length <= 1024 && count <= 7 && valid && scope.absolute {
        true -> kind(method, scope, arguments, count, size, unit, length)
        _ -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::InvalidState })
    }
    state kind(method: |model|::Value, scope: |model|::Path, arguments: &[|execution_model|::Operand; 7], count: u64,
        size: |integers|::IntegerSize, unit: u64, length: u64) -> |execution_model|::FrameResult {
        transition method { |model|::Value::Method { flags, body } -> method(scope, arguments, count, size, unit, length, flags, body)
            _ -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::UnsupportedValue }) }
    }
    state method(scope: |model|::Path, arguments: &[|execution_model|::Operand; 7], count: u64, size: |integers|::IntegerSize,
        unit: u64, length: u64, flags: u8, body: |model|::Span) -> |execution_model|::FrameResult {
        // Stage record values as typed scalars before unsigned ordering. The
        // pinned evaluator miscompares a direct field carrying u64::MAX.
        let start: u64 = body.start;
        let end: u64 = body.end;
        let source_unit: u64 = body.unit;
        let required: u64 = (flags & 7) as u64;
        let serialized: bool = (flags & 8) != 0;
        transition { source_unit != unit -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::SourceUnit })
            start > end || end > length -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::Truncated })
            required != count -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::ArgumentCount })
            serialized -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::UnresolvedSynchronization })
            _ -> seed(scope, arguments, count, size, body, length) }
    }
    state seed(scope: |model|::Path, arguments: &[|execution_model|::Operand; 7], count: u64, size: |integers|::IntegerSize, body: |model|::Span, length:u64) -> |execution_model|::FrameResult {
        let frame: |execution_model|::Frame = |execution_model|::Frame { scope: scope, body: body, source_length:length, size: size, pc: body.start, end: body.end };
        let result: |execution_model|::FrameResult = frame_arguments(arguments, 0, count, |execution_model|::FrameResult { frame: frame }); result
    }
}
machine frame_arguments(arguments: &[|execution_model|::Operand; 7], index: u64, count: u64, result: |execution_model|::FrameResult)
terminates by (index, count) -> |nat|::Nat::BoundedDistance;
-> |execution_model|::FrameResult {
    let next: |execution_model|::FrameResult = frame_argument(arguments, index, count, result);
    transition index < count { true -> frame_arguments(arguments, index + 1, count, next) _ -> (result) }
}
machine frame_argument(arguments: &[|execution_model|::Operand; 7], index: u64, count: u64, result: |execution_model|::FrameResult) -> |execution_model|::FrameResult {
    transition result.outcome == |execution_model|::ExecutionOutcome::Success && index < count && index < 7 {
        true -> convert(arguments, index, result) _ -> (result)
    }
    state convert(arguments: &[|execution_model|::Operand; 7], index: u64, result: |execution_model|::FrameResult) -> |execution_model|::FrameResult {
        let mut out:|execution_model|::FrameResult=result;
        out.frame.arguments[index]=argument_binding(result.frame.size,arguments[index]);out
    }
}
pub machine argument_binding(size:|integers|::IntegerSize,operand:|execution_model|::Operand)->|execution_model|::Binding {
 transition operand {|execution_model|::Operand::Uninitialized -> (|execution_model|::Binding::Uninitialized) |execution_model|::Operand::Integer {number} -> scalar(size,number) |execution_model|::Operand::Object {object_id} -> (|execution_model|::Binding::Shared {shared_id:object_id})}
 state scalar(size:|integers|::IntegerSize,number:u64)->|execution_model|::Binding {let value:u64=|integers|::normalize(size,number);|execution_model|::Binding::Integer {number:value}}
}

// Definition observations must be retained with their source unit when methods
// are declared. The namespace lookup path is deliberately not a scope input.
pub machine observed_frame(method: |model|::Value, object_id: u64, definitions: &[|model|::MethodDefinition; 64],
    arguments: &[|execution_model|::Operand; 7], count: u64, size: |integers|::IntegerSize, unit: u64, length: u64) -> |execution_model|::FrameResult {
    transition object_id < 64 { true -> definition(method, object_id, definitions[object_id], arguments, count, size, unit, length)
        _ -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::MethodDefinition }) }
    state definition(method: |model|::Value, object_id: u64, observation: |model|::MethodDefinition,
        arguments: &[|execution_model|::Operand; 7], count: u64, size: |integers|::IntegerSize, unit: u64, length: u64) -> |execution_model|::FrameResult {
        transition method { |model|::Value::Method { flags, body } -> compare(method, object_id, observation, flags, body, arguments, count, size, unit, length)
            _ -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::UnsupportedValue }) }
    }
    state compare(method: |model|::Value, object_id: u64, observation: |model|::MethodDefinition, flags: u8, body: |model|::Span,
        arguments: &[|execution_model|::Operand; 7], count: u64, size: |integers|::IntegerSize, unit: u64, length: u64) -> |execution_model|::FrameResult {
        transition observation.present && observation.object_id == object_id && observation.flags == flags &&
            observation.body.unit == body.unit && observation.body.start == body.start && observation.body.end == body.end {
            true -> start(method, observation.scope, arguments, count, size, unit, length)
            _ -> (|execution_model|::FrameResult { outcome: |execution_model|::ExecutionOutcome::MethodDefinition })
        }
    }
    state start(method: |model|::Value, scope: |model|::Path, arguments: &[|execution_model|::Operand; 7], count: u64, size: |integers|::IntegerSize, unit: u64, length: u64) -> |execution_model|::FrameResult {
        let result: |execution_model|::FrameResult = new_frame(method, scope, arguments, count, size, unit, length); result
    }
}
