use {aml}/model.omg;
use execution_model.omg;
use generic_target_model.omg;
use generic_values.omg;
use named_store.omg;
use {integer_helpers}/integers.omg;
// The scalar has already been normalized to the active AML IntegerSize.
pub machine apply_integer_action(input:&[u8;1024],length:u64,unit:u64,size:|integers|::IntegerSize,store:&mut |model|::ObjectStore,action:|generic_target_model|::TargetAction,number:u64)->|execution_model|::BindingResult {
 transition action {|generic_target_model|::TargetAction::StoreNamed {object_id} -> named(input,length,unit,size,store,object_id,number) |generic_target_model|::TargetAction::NoWrite -> (|execution_model|::BindingResult {}) |generic_target_model|::TargetAction::Failure {outcome} -> (|execution_model|::BindingResult {outcome:outcome}) |generic_target_model|::TargetAction::Replace {binding} -> replacement(input,length,unit,store,binding,number) |generic_target_model|::TargetAction::CopyTo {object_id,result_binding} -> copy(input,length,unit,store,object_id,result_binding,number)}
 state named(input:&[u8;1024],length:u64,unit:u64,size:|integers|::IntegerSize,store:&mut |model|::ObjectStore,id:u64,number:u64)->|execution_model|::BindingResult {
  let outcome:|execution_model|::ExecutionOutcome=|named_store|::store_named_operand(input,length,unit,size,store,id,|execution_model|::Operand::Integer {number:number});|execution_model|::BindingResult {outcome:outcome}
 }
 state replacement(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,binding:|execution_model|::Binding,number:u64)->|execution_model|::BindingResult {
  transition binding {|execution_model|::Binding::Cell {cell_id} -> copy(input,length,unit,store,cell_id,binding,number) _ -> (|execution_model|::BindingResult {binding:|execution_model|::Binding::Integer {number:number}})}
 }
 state copy(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,id:u64,binding:|execution_model|::Binding,number:u64)->|execution_model|::BindingResult {
  let outcome:|execution_model|::ExecutionOutcome=|generic_values|::copy_integer_into(input,length,unit,store,id,number);|execution_model|::BindingResult {outcome:outcome,binding:binding}
 }
}
