use {aml}/model.omg;
use {aml}/object_references.omg;
use {aml}/object_conversions.omg;
use execution_model.omg;
use generic_target_bridge.omg;
use named_store.omg;
use operands.omg;
use {integer_helpers}/integers.omg;

// Prepare the complete explicit conversion before any target mutation. The
// canonical helper owns byte admission and its StrictDecimalHex policy.
pub machine integer_conversion(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,operand:|execution_model|::Operand)->|execution_model|::SlotResult {
 transition operand {
  |execution_model|::Operand::Uninitialized -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::Uninitialized})
  |execution_model|::Operand::Integer {number} -> scalar(number,size)
  |execution_model|::Operand::Object {object_id} -> object(input,length,unit,store,size,object_id)
 }
 state scalar(number:u64,size:|integers|::IntegerSize)->|execution_model|::SlotResult {
  let value:u64=|integers|::normalize(size,number);|execution_model|::SlotResult {slot:|execution_model|::Slot {initialized:true,number:value}}
 }
 state object(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64)->|execution_model|::SlotResult {
  let found:|model|::ReferenceState=|object_references|::unwrap_transparent(&store.space,id,64);
  transition found.outcome {
   |model|::Outcome::Success -> resolved(input,length,unit,store,size,found.object)
   |model|::Outcome::ReferenceCycle -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::ReferenceCycle})
   |model|::Outcome::WorkLimit -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::WorkLimit})
   _ -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::InvalidState})
  }
 }
 state resolved(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64)->|execution_model|::SlotResult {
  let converted:|object_conversions|::ConversionResult=|object_conversions|::to_integer(input,length,unit,store,id,size);
  transition converted {
   |object_conversions|::ConversionResult::Integer {number} -> (|execution_model|::SlotResult {slot:|execution_model|::Slot {initialized:true,number:number}})
   |object_conversions|::ConversionResult::Failure {reason} -> failed(reason)
   _ -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::InvalidState})
  }
 }
 state failed(reason:|object_conversions|::ConversionFailure)->|execution_model|::SlotResult {
  let outcome:|execution_model|::ExecutionOutcome=|named_store|::conversion_outcome(reason);|execution_model|::SlotResult {outcome:outcome}
 }
}

pub machine retire_to_integer(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,operand:|execution_model|::Operand,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
 let prepared:|execution_model|::SlotResult=integer_conversion(input,frame.source_length,frame.body.unit,store,frame.size,operand);
 transition prepared.outcome==|execution_model|::ExecutionOutcome::Success {
  true -> write(input,store,frame,target,prepared.slot.number)
  _ -> (prepared.outcome)
 }
 state write(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,number:u64)->|execution_model|::ExecutionOutcome {
  transition target {|execution_model|::Target::Null -> contribute(frame,number)
   |execution_model|::Target::Debug -> (|execution_model|::ExecutionOutcome::UnresolvedService)
   _ -> copy_result(input,store,frame,target,number)}
 }
 state copy_result(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,number:u64)->|execution_model|::ExecutionOutcome {
  // ACPI 6.6 19.3.5.5: explicit conversion replaces the target directly.
  // The expression remains Integer even when the previous target was bytes.
  let written:|execution_model|::ExecutionOutcome=|generic_target_bridge|::write_generic_target(input,store,frame,target,|execution_model|::Operand::Integer {number:number},true);
  transition written==|execution_model|::ExecutionOutcome::Success {true -> contribute(frame,number) _ -> (written)}
 }
 state contribute(frame:&mut |execution_model|::Frame,number:u64)->|execution_model|::ExecutionOutcome {
  let result:|execution_model|::ExecutionOutcome=|operands|::contribute_integer(frame,number);result
 }
}
