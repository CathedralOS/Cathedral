// SPDX-License-Identifier: MIT OR Apache-2.0
// Modified AML StringPrefix/Buffer handling from rust-osdev/acpi
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5, copyright 2018 Isaac Woods.
// Pure literal preflight; no execution, allocation or namespace publication.
use {aml}/model.omg;
use {aml}/values.omg;
use {aml}/bytes.omg;
use {aml}/byte_storage.omg;
use {integer_helpers}/integers.omg;

// source_length/unit identify one retained immutable snapshot; frame_end is a
// possibly smaller active block limit. Failures publish no Value or next cursor.
pub machine preflight_byte_literal(input:&[u8;1024],source_length:u64,source_unit:u64,
 frame_unit:u64,frame_end:u64,at:u64,size:|integers|::IntegerSize)->|model|::ValueRead {
 transition {
  source_length>1024 || frame_end>source_length || at>frame_end || source_unit!=frame_unit -> (|model|::ValueRead {outcome:|model|::Outcome::InvalidState,offset:at})
  at==frame_end -> (|model|::ValueRead {outcome:|model|::Outcome::Truncated,offset:at})
  _ -> token(input,source_length,source_unit,frame_end,at,size)
 }
 state token(input:&[u8;1024],length:u64,unit:u64,end:u64,at:u64,size:|integers|::IntegerSize)->|model|::ValueRead {
  let token:|model|::Read=|bytes|::read_le(input,end,at,1);
  transition token.value==0x0d || token.value==0x11 {
   true -> parse(input,length,unit,end,at,size)
   _ -> (|model|::ValueRead {outcome:|model|::Outcome::UnsupportedSyntax,offset:at})
  }
 }
 state parse(input:&[u8;1024],length:u64,unit:u64,end:u64,at:u64,size:|integers|::IntegerSize)->|model|::ValueRead {
  let parsed:|model|::ValueRead=|values|::atom(input,end,at,unit,|model|::Path {},false);
  let next:u64=parsed.next;
  transition {
   parsed.outcome!=|model|::Outcome::Success -> (|model|::ValueRead {outcome:parsed.outcome,offset:parsed.offset})
   next<=at || next>end -> (|model|::ValueRead {outcome:|model|::Outcome::InvalidState,offset:at})
   _ -> validate(input,length,unit,at,size,parsed)
  }
 }
 state validate(input:&[u8;1024],length:u64,unit:u64,at:u64,size:|integers|::IntegerSize,parsed:|model|::ValueRead)->|model|::ValueRead {
  let value:|model|::Value=literal_width(parsed.value,size);
  // Reuse the canonical byte validator. This detached local is neither a
  // caller object nor a published stable identity, and it cannot escape.
  let mut temporary:|model|::ObjectStore=|model|::ObjectStore {};
  temporary.space.object_count=1;temporary.space.objects[0].value=value;
  let bytes:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,&temporary,0);
  transition bytes.outcome {
   |byte_storage|::ByteOutcome::Success -> (|model|::ValueRead {value:value,next:parsed.next})
   |byte_storage|::ByteOutcome::Capacity -> (|model|::ValueRead {outcome:|model|::Outcome::Capacity,offset:at})
   |byte_storage|::ByteOutcome::Encoding -> (|model|::ValueRead {outcome:|model|::Outcome::BadEncoding,offset:at})
   _ -> (|model|::ValueRead {outcome:|model|::Outcome::InvalidState,offset:at})
  }
 }
}
machine literal_width(value:|model|::Value,size:|integers|::IntegerSize)->|model|::Value {
 transition value {|model|::Value::Buffer {buffer_storage} -> buffer(buffer_storage,size) _ -> (value)}
 state buffer(storage:|model|::BufferStorage,size:|integers|::IntegerSize)->|model|::Value {
  transition storage {
   |model|::BufferStorage::Source {declared_size,buffer_initializer} -> normalized(declared_size,buffer_initializer,size)
   _ -> (|model|::Value::Uninitialized)
  }
 }
 state normalized(declared:u64,span:|model|::Span,size:|integers|::IntegerSize)->|model|::Value {
  let length:u64=|integers|::normalize(size,declared);
  |model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:length,buffer_initializer:span}}
 }
}
