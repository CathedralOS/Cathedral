use {aml}/model.omg;
use execution_model.omg;
use generic_target_model.omg;
use generic_targets.omg;
use generic_target_values.omg;
use generic_values.omg;
use generic_binding_plan.omg;
use {integer_helpers}/integers.omg;
// Determine only inert publication metadata before mutation. The unchanged
// mutation kernel performs all admission/allocation and returns the scalar
// outcome into a local semantic-case output; publish_target ignores the
// predicted binding on every failure. No numeric status encoding is used.
pub machine write_generic_target(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,target:|execution_model|::Target,operand:|execution_model|::Operand,copy:bool)->|execution_model|::ExecutionOutcome {
 let length:u64=frame.source_length;let unit:u64=frame.body.unit;let size:|integers|::IntegerSize=frame.size;
 let selection:|generic_target_model|::TargetSelection=|generic_targets|::select_target(frame,target);
 let normalized:|execution_model|::Operand=|generic_values|::normalized_operand(store,size,operand);
 let action:|generic_target_model|::TargetAction=|generic_target_values|::classify_target(store,selection,normalized,copy);
 let count:u64=store.space.object_count;
 let binding:|execution_model|::Binding=|generic_binding_plan|::prospective_binding(count,action,normalized);
 let mut outcome:|execution_model|::ExecutionOutcome=|execution_model|::ExecutionOutcome::InvalidState;
 mutate_selected(input,length,unit,size,store,action,normalized,&mut outcome);
 let published:|execution_model|::ExecutionOutcome=|generic_targets|::publish_target(frame,selection,|execution_model|::BindingResult {outcome:outcome,binding:binding});published
}
machine mutate_selected(input:&[u8;1024],length:u64,unit:u64,size:|integers|::IntegerSize,store:&mut |model|::ObjectStore,action:|generic_target_model|::TargetAction,operand:|execution_model|::Operand,outcome:&mut |execution_model|::ExecutionOutcome) {
 let result:|execution_model|::BindingResult=|generic_target_values|::apply_target_action(input,length,unit,size,store,action,operand);outcome=result.outcome;
}
