// SPDX-License-Identifier: MIT OR Apache-2.0
// Bounded canonical data transport. Object IDs are relative to the supplied
// ObjectStore. Byte copies own their destination block; Package copies retain
// child IDs (explicit shallow-copy profile, not general ACPI package cloning).
use {omega}/language/core/nat.omg;
use {aml}/model.omg;
use {aml}/object_references.omg;
use {aml}/byte_storage.omg;
use execution_model.omg;
use frames.omg;
use {integer_helpers}/integers.omg;

pub machine binding_operand(binding:|execution_model|::Binding)->|execution_model|::Operand {
 transition binding {|execution_model|::Binding::Uninitialized -> (|execution_model|::Operand::Uninitialized) |execution_model|::Binding::Integer {number} -> (|execution_model|::Operand::Integer {number:number}) |execution_model|::Binding::Shared {shared_id} -> (|execution_model|::Operand::Object {object_id:shared_id}) |execution_model|::Binding::Cell {cell_id} -> (|execution_model|::Operand::Object {object_id:cell_id})}
}
pub machine object_outcome(outcome:|model|::Outcome)->|execution_model|::ExecutionOutcome {
 transition outcome {|model|::Outcome::Success -> (|execution_model|::ExecutionOutcome::Success) |model|::Outcome::Capacity -> (|execution_model|::ExecutionOutcome::Capacity) |model|::Outcome::WorkLimit -> (|execution_model|::ExecutionOutcome::WorkLimit) |model|::Outcome::MissingObject -> (|execution_model|::ExecutionOutcome::MissingObject) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}
}
pub machine bytes_outcome(outcome:|byte_storage|::ByteOutcome)->|execution_model|::ExecutionOutcome {
 transition outcome {|byte_storage|::ByteOutcome::Success -> (|execution_model|::ExecutionOutcome::Success) |byte_storage|::ByteOutcome::Capacity -> (|execution_model|::ExecutionOutcome::Capacity) |byte_storage|::ByteOutcome::WorkLimit -> (|execution_model|::ExecutionOutcome::WorkLimit) |byte_storage|::ByteOutcome::UnsupportedValue -> (|execution_model|::ExecutionOutcome::UnsupportedValue) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}
}
pub machine read_value(store:&|model|::ObjectStore,operand:|execution_model|::Operand)->|execution_model|::ValueResult {
 transition operand {|execution_model|::Operand::Uninitialized -> (|execution_model|::ValueResult {value:|model|::Value::Uninitialized}) |execution_model|::Operand::Integer {number} -> (|execution_model|::ValueResult {value:|model|::Value::Integer {number:number}}) |execution_model|::Operand::Object {object_id} -> object_value(store,object_id)}
 state object_value(store:&|model|::ObjectStore,id:u64)->|execution_model|::ValueResult {
  let found:|model|::ReferenceState=|object_references|::unwrap_transparent(&store.space,id,64);
  let outcome:|execution_model|::ExecutionOutcome=object_outcome(found.outcome);
  transition outcome==|execution_model|::ExecutionOutcome::Success && found.object<64 {true -> selected(store,found.object) _ -> (|execution_model|::ValueResult {outcome:outcome})}
 }
 state selected(store:&|model|::ObjectStore,id:u64)->|execution_model|::ValueResult {|execution_model|::ValueResult {value:store.space.objects[id].value,has_object:true,object:id}}
}
// Runtime integer projection never transports canonical ValueResult.
pub machine integer_operand(store:&|model|::ObjectStore,size:|integers|::IntegerSize,operand:|execution_model|::Operand)->|execution_model|::SlotResult {
 transition operand {|execution_model|::Operand::Uninitialized -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::Uninitialized}) |execution_model|::Operand::Integer {number} -> scalar(size,number) |execution_model|::Operand::Object {object_id} -> object(store,size,object_id)}
 state scalar(size:|integers|::IntegerSize,number:u64)->|execution_model|::SlotResult {let value:u64=|integers|::normalize(size,number);|execution_model|::SlotResult {slot:|execution_model|::Slot {initialized:true,number:value}}}
 state object(store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64)->|execution_model|::SlotResult {
  let found:|model|::ReferenceState=|object_references|::unwrap_transparent(&store.space,id,64);let outcome:|execution_model|::ExecutionOutcome=object_outcome(found.outcome);let id_found:u64=found.object;
  transition outcome==|execution_model|::ExecutionOutcome::Success && id_found<64 {true -> selected(store,size,id_found) _ -> (|execution_model|::SlotResult {outcome:outcome})}
 }
 state selected(store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64)->|execution_model|::SlotResult {let result:|execution_model|::SlotResult=|frames|::scalar_slot(size,store.space.objects[id].value);result}
}
// Validation returns only the typed outcome. Runtime callers need no admitted
// canonical payload carried through byte/package/reference validation states.
pub machine validate_operand(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
 transition operand {|execution_model|::Operand::Uninitialized -> (|execution_model|::ExecutionOutcome::Uninitialized) |execution_model|::Operand::Integer {number} -> (|execution_model|::ExecutionOutcome::Success) |execution_model|::Operand::Object {object_id} -> object(input,length,unit,store,object_id)}
 state object(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,id:u64)->|execution_model|::ExecutionOutcome {
  let found:|model|::ReferenceState=|object_references|::unwrap_transparent(&store.space,id,64);let outcome:|execution_model|::ExecutionOutcome=object_outcome(found.outcome);let id_found:u64=found.object;
  transition outcome==|execution_model|::ExecutionOutcome::Success && id_found<64 {true -> value(input,length,unit,store,id_found,store.space.objects[id_found].value) _ -> (outcome)}
 }
 state value(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,id:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  let outcome:|execution_model|::ExecutionOutcome=validate_payload(input,length,unit,store,true,id,value);outcome
 }
}
// One payload policy serves both runtime scalar outcomes and external rich
// metadata. Only the rich wrapper retains the admitted ValueResult.
machine validate_payload(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,has_object:bool,id:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
 transition value {
  |model|::Value::Integer {number} -> (|execution_model|::ExecutionOutcome::Success)
  |model|::Value::String {string_storage} -> bytes(input,length,unit,store,has_object,id,value)
  |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,has_object,id,value)
  |model|::Value::Package {first,count} -> package(store,first,count)
  |model|::Value::Reference {kind,object_id} -> reference(store,object_id)
  |model|::Value::Uninitialized -> (|execution_model|::ExecutionOutcome::Uninitialized)
  |model|::Value::FieldUnit {binding,declaration,field} -> (|execution_model|::ExecutionOutcome::UnresolvedRegion)
  |model|::Value::OperationRegion {space,base,length,scope} -> (|execution_model|::ExecutionOutcome::UnresolvedRegion)
  _ -> (|execution_model|::ExecutionOutcome::UnsupportedValue)
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,has_object:bool,id:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  let snapshot:|byte_storage|::ByteRead=byte_snapshot(input,length,unit,store,|execution_model|::ValueResult {value:value,has_object:has_object,object:id});let outcome:|execution_model|::ExecutionOutcome=bytes_outcome(snapshot.outcome);outcome
 }
 state reference(store:&|model|::ObjectStore,id:u64)->|execution_model|::ExecutionOutcome {let count:u64=store.space.object_count;transition count<=64 && id<count && id<64 {true -> (|execution_model|::ExecutionOutcome::Success) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}}
 state package(store:&|model|::ObjectStore,first:u64,count:u64)->|execution_model|::ExecutionOutcome {transition {count>64 -> (|execution_model|::ExecutionOutcome::Capacity) count==0 -> (|execution_model|::ExecutionOutcome::Success) _ -> chain(store,first,count)}}
 state chain(store:&|model|::ObjectStore,first:u64,count:u64)->|execution_model|::ExecutionOutcome {let checked:PackageCheck=gv_package_walk(store,0,count,PackageCheck {object:first});checked.outcome}
}
pub machine byte_snapshot(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,value:|execution_model|::ValueResult)->|byte_storage|::ByteRead {
 transition value.has_object {true -> object(input,length,unit,store,value.object) _ -> inline_value(input,length,unit,value.value)}
 state object(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,id:u64)->|byte_storage|::ByteRead {let result:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,id);result}
 state inline_value(input:&[u8;1024],length:u64,unit:u64,value:|model|::Value)->|byte_storage|::ByteRead {
  // Only immutable Source descriptors may be transported inline. An Owned
  // locator without its containing ObjectStore slot cannot establish ownership.
  transition value {|model|::Value::String {string_storage} -> string_source(input,length,unit,value,string_storage) |model|::Value::Buffer {buffer_storage} -> buffer_source(input,length,unit,value,buffer_storage) _ -> (|byte_storage|::ByteRead {outcome:|byte_storage|::ByteOutcome::UnsupportedValue})}
 }
 state string_source(input:&[u8;1024],length:u64,unit:u64,value:|model|::Value,storage:|model|::StringStorage)->|byte_storage|::ByteRead {
  transition storage {|model|::StringStorage::Source {string_source} -> snapshot(input,length,unit,value) _ -> (|byte_storage|::ByteRead {outcome:|byte_storage|::ByteOutcome::InvalidState})}
 }
 state buffer_source(input:&[u8;1024],length:u64,unit:u64,value:|model|::Value,storage:|model|::BufferStorage)->|byte_storage|::ByteRead {
  transition storage {|model|::BufferStorage::Source {declared_size,buffer_initializer} -> snapshot(input,length,unit,value) _ -> (|byte_storage|::ByteRead {outcome:|byte_storage|::ByteOutcome::InvalidState})}
 }
 state snapshot(input:&[u8;1024],length:u64,unit:u64,value:|model|::Value)->|byte_storage|::ByteRead {
  let mut local:|model|::ObjectStore=|model|::ObjectStore {};local.space.object_count=1;local.space.objects[0].value=value;
  let result:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,&local,0);result
 }
}
pub machine admit_data(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,operand:|execution_model|::Operand)->|execution_model|::ValueResult {
 let found:|execution_model|::ValueResult=read_value(store,operand);
 let result:|execution_model|::ValueResult=admit_value(input,length,unit,store,found);result
}
// External canonical values are admitted outside the scalar/ID Runtime.
pub machine admit_value(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,found:|execution_model|::ValueResult)->|execution_model|::ValueResult {
 transition found.outcome==|execution_model|::ExecutionOutcome::Success {true -> validate(input,length,unit,store,found) _ -> (found)}
 state validate(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,found:|execution_model|::ValueResult)->|execution_model|::ValueResult {
  let outcome:|execution_model|::ExecutionOutcome=validate_payload(input,length,unit,store,found.has_object,found.object,found.value);
  let mut admitted:|execution_model|::ValueResult=found;admitted.outcome=outcome;admitted
 }
}
data PackageCheck [copy] {outcome:|execution_model|::ExecutionOutcome;object:u64;visited:u64;}
machine gv_package_walk(store:&|model|::ObjectStore,index:u64,count:u64,prior:PackageCheck)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->PackageCheck {
 let next:PackageCheck=gv_package_step(store,index,count,prior);
 transition index<count {true -> gv_package_walk(store,index+1,count,next) _ -> (prior)}
}
machine gv_package_step(store:&|model|::ObjectStore,index:u64,count:u64,prior:PackageCheck)->PackageCheck {
 transition prior.outcome==|execution_model|::ExecutionOutcome::Success && index<count {true -> bounded(store,index,count,prior,prior.object) _ -> (prior)}
 state bounded(store:&|model|::ObjectStore,index:u64,count:u64,prior:PackageCheck,id:u64)->PackageCheck {
  let capacity:u64=store.space.object_count;
  transition index<64 && id<64 && capacity<=64 && id<capacity {true -> inspect(store,index,count,prior,id) _ -> (PackageCheck {outcome:|execution_model|::ExecutionOutcome::InvalidState})}
 }
 state inspect(store:&|model|::ObjectStore,index:u64,count:u64,prior:PackageCheck,id:u64)->PackageCheck {
  let bit:u64=((1 as u64 in Wrapping) << (id as u64 in Wrapping)) as u64;
  transition (prior.visited & bit)==0 {true -> link(store,index,count,prior.visited|bit,id) _ -> (PackageCheck {outcome:|execution_model|::ExecutionOutcome::InvalidState})}
 }
 state link(store:&|model|::ObjectStore,index:u64,count:u64,visited:u64,id:u64)->PackageCheck {
  let object:|model|::Object=store.space.objects[id];
  transition {index+1==count && !object.has_next -> (PackageCheck {visited:visited})
   index+1<count && object.has_next -> (PackageCheck {object:object.next,visited:visited})
   _ -> (PackageCheck {outcome:|execution_model|::ExecutionOutcome::InvalidState})}
 }
}
pub machine destination_allowed(store:&|model|::ObjectStore,id:u64)->|execution_model|::ExecutionOutcome {
 let count:u64=store.space.object_count;
 transition count<=64 && id<count && id<64 {true -> value(store.space.objects[id].value) _ -> (|execution_model|::ExecutionOutcome::MissingObject)}
 state value(value:|model|::Value)->|execution_model|::ExecutionOutcome {
  transition value {|model|::Value::Integer {number} -> (|execution_model|::ExecutionOutcome::Success) |model|::Value::Uninitialized -> (|execution_model|::ExecutionOutcome::Success) |model|::Value::String {string_storage} -> (|execution_model|::ExecutionOutcome::Success) |model|::Value::Buffer {buffer_storage} -> (|execution_model|::ExecutionOutcome::Success) |model|::Value::Package {first,count} -> (|execution_model|::ExecutionOutcome::Success) |model|::Value::Reference {kind,object_id} -> (|execution_model|::ExecutionOutcome::Success) |model|::Value::FieldUnit {binding,declaration,field} -> (|execution_model|::ExecutionOutcome::UnresolvedRegion) |model|::Value::OperationRegion {space,base,length,scope} -> (|execution_model|::ExecutionOutcome::UnresolvedRegion) _ -> (|execution_model|::ExecutionOutcome::UnsupportedValue)}
 }
}
// Validate and stage source bytes before modifying destination, including self-copy.
pub machine copy_into(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,destination:u64,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
 let permitted:|execution_model|::ExecutionOutcome=gv_destination_valid(input,length,unit,store,destination);
 transition permitted==|execution_model|::ExecutionOutcome::Success {true -> source(input,length,unit,store,destination,operand) _ -> (permitted)}
 state source(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,destination:u64,operand:|execution_model|::Operand)->|execution_model|::ExecutionOutcome {
  let found:|execution_model|::ValueResult=admit_data(input,length,unit,store,operand);
  transition found.outcome==|execution_model|::ExecutionOutcome::Success {true -> kind(input,length,unit,store,destination,found,found.value) _ -> (found.outcome)}
 }
 state kind(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,destination:u64,found:|execution_model|::ValueResult,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  transition value {|model|::Value::String {string_storage} -> bytes(input,length,unit,store,destination,found) |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,destination,found) _ -> plain(store,destination,value)}
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,destination:u64,found:|execution_model|::ValueResult)->|execution_model|::ExecutionOutcome {
  let snapshot:|byte_storage|::ByteRead=byte_snapshot(input,length,unit,store,found);
  let result:|execution_model|::ExecutionOutcome=gv_install_bytes(store,destination,snapshot);result
 }
 state plain(store:&mut |model|::ObjectStore,destination:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  let outcome:|execution_model|::ExecutionOutcome=gv_publish_plain(store,destination,value);outcome
 }
}
machine gv_install_bytes(store:&mut |model|::ObjectStore,destination:u64,snapshot:|byte_storage|::ByteRead)->|execution_model|::ExecutionOutcome {
 let permitted:|execution_model|::ExecutionOutcome=destination_allowed(store,destination);
 let size:u64=snapshot.length;
 transition {permitted!=|execution_model|::ExecutionOutcome::Success -> (permitted) snapshot.outcome!=|byte_storage|::ByteOutcome::Success -> bytes_error(snapshot.outcome) size>256 -> (|execution_model|::ExecutionOutcome::Capacity) _ -> commit(store,destination,snapshot)}
 state bytes_error(outcome:|byte_storage|::ByteOutcome)->|execution_model|::ExecutionOutcome {let result:|execution_model|::ExecutionOutcome=bytes_outcome(outcome);result}
 state commit(store:&mut |model|::ObjectStore,destination:u64,snapshot:|byte_storage|::ByteRead)->|execution_model|::ExecutionOutcome {
  transition destination<64 {true -> validated(store,destination,snapshot) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}
 }
 state validated(store:&mut |model|::ObjectStore,destination:u64,snapshot:|byte_storage|::ByteRead)->|execution_model|::ExecutionOutcome {
  let good:bool=gv_snapshot_ascii(&snapshot.bytes,0,snapshot.length,true);
  transition destination<64 && (snapshot.kind!=|byte_storage|::ByteKind::String || good) {true -> write_bytes(store,destination,snapshot) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}
 }
 state write_bytes(store:&mut |model|::ObjectStore,destination:u64,snapshot:|byte_storage|::ByteRead)->|execution_model|::ExecutionOutcome {
  let value:|model|::Value=gv_owned_payload(snapshot.kind,destination);
  store.bytes.blocks[destination]=|model|::ByteBlock {initialized:true,length:snapshot.length,bytes:snapshot.bytes};
  store.space.objects[destination].value=value;|execution_model|::ExecutionOutcome::Success
 }
}
machine gv_owned_payload(kind:|byte_storage|::ByteKind,id:u64)->|model|::Value {
 transition kind {|byte_storage|::ByteKind::String -> (|model|::Value::String {string_storage:|model|::StringStorage::Owned {string_owner:id}}) |byte_storage|::ByteKind::Buffer -> (|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:id}})}
}
pub machine copied_binding(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,old:|execution_model|::Binding,operand:|execution_model|::Operand)->|execution_model|::BindingResult {
 transition old {|execution_model|::Binding::Cell {cell_id} -> existing(input,length,unit,store,old,cell_id,operand) _ -> detached(input,length,unit,store,operand)}
 state existing(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,old:|execution_model|::Binding,id:u64,operand:|execution_model|::Operand)->|execution_model|::BindingResult {
  let outcome:|execution_model|::ExecutionOutcome=copy_into(input,length,unit,store,id,operand);|execution_model|::BindingResult {outcome:outcome,binding:old}
 }
 state detached(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,operand:|execution_model|::Operand)->|execution_model|::BindingResult {
  let found:|execution_model|::ValueResult=admit_data(input,length,unit,store,operand);
  transition found.outcome==|execution_model|::ExecutionOutcome::Success {true -> kind(input,length,unit,store,found,found.value) _ -> (|execution_model|::BindingResult {outcome:found.outcome})}
 }
 state kind(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,found:|execution_model|::ValueResult,value:|model|::Value)->|execution_model|::BindingResult {
  transition value {|model|::Value::String {string_storage} -> bytes(input,length,unit,store,found) |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,found) |model|::Value::Integer {number} -> (|execution_model|::BindingResult {binding:|execution_model|::Binding::Integer {number:number}}) _ -> plain(store,value)}
 }
 state plain(store:&mut |model|::ObjectStore,value:|model|::Value)->|execution_model|::BindingResult {
  let count:u64=store.space.object_count;
  transition count<64 {true -> plain_commit(store,value,count) _ -> (|execution_model|::BindingResult {outcome:|execution_model|::ExecutionOutcome::Capacity})}
 }
 state plain_commit(store:&mut |model|::ObjectStore,value:|model|::Value,id:u64)->|execution_model|::BindingResult {
  transition id<64 {true -> plain_write(store,value,id) _ -> (|execution_model|::BindingResult {outcome:|execution_model|::ExecutionOutcome::Capacity})}
 }
 state plain_write(store:&mut |model|::ObjectStore,value:|model|::Value,id:u64)->|execution_model|::BindingResult {
  store.space.objects[id]=|model|::Object {value:value};store.bytes.blocks[id]=|model|::ByteBlock {};store.space.object_count=id+1;
  |execution_model|::BindingResult {binding:|execution_model|::Binding::Cell {cell_id:id}}
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,found:|execution_model|::ValueResult)->|execution_model|::BindingResult {
  let count:u64=store.space.object_count;
  transition count<64 {true -> stage(input,length,unit,store,found,count) _ -> (|execution_model|::BindingResult {outcome:|execution_model|::ExecutionOutcome::Capacity})}
 }
 state stage(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,found:|execution_model|::ValueResult,id:u64)->|execution_model|::BindingResult {
  let snapshot:|byte_storage|::ByteRead=byte_snapshot(input,length,unit,store,found);
  transition snapshot.outcome==|byte_storage|::ByteOutcome::Success {true -> commit(store,id,snapshot) _ -> (|execution_model|::BindingResult {outcome:|execution_model|::ExecutionOutcome::InvalidState})}
 }
 state commit(store:&mut |model|::ObjectStore,id:u64,snapshot:|byte_storage|::ByteRead)->|execution_model|::BindingResult {
  transition id<64 {true -> write_new(store,id,snapshot) _ -> (|execution_model|::BindingResult {outcome:|execution_model|::ExecutionOutcome::Capacity})}
 }
 state write_new(store:&mut |model|::ObjectStore,id:u64,snapshot:|byte_storage|::ByteRead)->|execution_model|::BindingResult {
  // All possible failures precede publication of this new byte object.
  let value:|model|::Value=gv_owned_payload(snapshot.kind,id);
  store.space.objects[id]=|model|::Object {value:value};store.bytes.blocks[id]=|model|::ByteBlock {initialized:true,length:snapshot.length,bytes:snapshot.bytes};store.space.object_count=id+1;
  |execution_model|::BindingResult {binding:|execution_model|::Binding::Cell {cell_id:id}}
 }
}

machine gv_snapshot_ascii(bytes:&[u8;256],index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=gv_snapshot_byte(bytes,index,count);transition index<count {true -> gv_snapshot_ascii(bytes,index+1,count,prior && good) _ -> (prior)}}
machine gv_snapshot_byte(bytes:&[u8;256],index:u64,count:u64)->bool {transition index<count && index<256 {true -> (bytes[index]>0 && bytes[index]<128) _ -> (true)}}

// Width normalization creates only an inline scalar, never a new object identity.
pub machine normalized_operand(store:&|model|::ObjectStore,size:|integers|::IntegerSize,operand:|execution_model|::Operand)->|execution_model|::Operand {
 let result:|execution_model|::SlotResult=integer_operand(store,size,operand);
 transition result.outcome==|execution_model|::ExecutionOutcome::Success {true -> (|execution_model|::Operand::Integer {number:result.slot.number}) _ -> (operand)}
}

machine gv_destination_valid(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,id:u64)->|execution_model|::ExecutionOutcome {
 let kind:|execution_model|::ExecutionOutcome=destination_allowed(store,id);
 transition kind==|execution_model|::ExecutionOutcome::Success && id<64 {true -> value(input,length,unit,store,id,store.space.objects[id].value) _ -> (kind)}
 state value(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,id:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  transition value {|model|::Value::String {string_storage} -> bytes(input,length,unit,store,id) |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,id) _ -> (|execution_model|::ExecutionOutcome::Success)}
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,id:u64)->|execution_model|::ExecutionOutcome {let snapshot:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,id);let outcome:|execution_model|::ExecutionOutcome=bytes_outcome(snapshot.outcome);outcome}
}

// Integer source is already admitted and normalized by the caller. Destination
// validation and plain publication are shared with the generic copy path.
pub machine copy_integer_into(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,destination:u64,number:u64)->|execution_model|::ExecutionOutcome {
 let permitted:|execution_model|::ExecutionOutcome=gv_destination_valid(input,length,unit,store,destination);
 transition permitted==|execution_model|::ExecutionOutcome::Success {true -> publish(store,destination,number) _ -> (permitted)}
 state publish(store:&mut |model|::ObjectStore,destination:u64,number:u64)->|execution_model|::ExecutionOutcome {let outcome:|execution_model|::ExecutionOutcome=gv_publish_plain(store,destination,|model|::Value::Integer {number:number});outcome}
}
machine gv_publish_plain(store:&mut |model|::ObjectStore,destination:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
 transition destination<64 {true -> commit(store,destination,value) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}
 state commit(store:&mut |model|::ObjectStore,destination:u64,value:|model|::Value)->|execution_model|::ExecutionOutcome {
  store.space.objects[destination].value=value;store.bytes.blocks[destination]=|model|::ByteBlock {};|execution_model|::ExecutionOutcome::Success
 }
}
