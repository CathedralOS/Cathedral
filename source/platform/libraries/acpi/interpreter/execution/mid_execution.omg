use {aml}/object_conversions.omg;
// SPDX-License-Identifier: MIT OR Apache-2.0
// Modified do_mid composition from rust-osdev/acpi 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5,
// src/aml/mod.rs:2137. Copyright 2018 Isaac Woods. Primary bounds and conversion
// rules follow ACPI 6.6 19.6.86 and 19.3.5. No provider or field access.
use {aml}/model.omg;
use {aml}/object_references.omg;
use {aml}/object_mid.omg;
use {aml}/implicit_conversions.omg;
use execution_model.omg;
use named_store.omg;
use generic_target_bridge.omg;
use generic_targets.omg;
use generic_target_values.omg;
use generic_target_model.omg;
use operands.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/conversions.omg;

// Preparation contains detached bytes. All mutation below is staged until
// allocation, target conversion and parent contribution have succeeded.
data MidPrepared [copy] {outcome:|execution_model|::ExecutionOutcome;string:bool;length:u64;bytes:[u8;256];}
data MidStage [copy] {store:|model|::ObjectStore;frame:|execution_model|::Frame;}
pub machine retire_mid(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,source:|execution_model|::Operand,index:|execution_model|::Operand,requested:|execution_model|::Operand,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
 let start:|execution_model|::SlotResult=mid_integer(input,frame.source_length,frame.body.unit,store,frame.size,index);
 transition start.outcome==|execution_model|::ExecutionOutcome::Success {true -> length(input,store,frame,source,start.slot.number,requested,target) _ -> (start.outcome)}
 state length(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,source:|execution_model|::Operand,index:u64,requested:|execution_model|::Operand,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
  let length:|execution_model|::SlotResult=mid_integer(input,frame.source_length,frame.body.unit,store,frame.size,requested);
  transition length.outcome==|execution_model|::ExecutionOutcome::Success {true -> prepare(input,store,frame,source,index,length.slot.number,target) _ -> (length.outcome)}
 }
 state prepare(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,source:|execution_model|::Operand,index:u64,requested:u64,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
  let prepared:MidPrepared=mid_source(input,frame.source_length,frame.body.unit,store,frame.size,source,index,requested);
  transition prepared.outcome==|execution_model|::ExecutionOutcome::Success {true -> target(input,store,frame,prepared,target) _ -> (prepared.outcome)}
 }
 state target(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,prepared:MidPrepared,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
  let admitted:|execution_model|::ExecutionOutcome=mid_original_target(store,frame,target);
  transition admitted==|execution_model|::ExecutionOutcome::Success {true -> stage(input,store,frame,prepared,target) _ -> (admitted)}
 }
 state stage(input:&[u8;1024],store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,prepared:MidPrepared,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
  let mut staged:MidStage=MidStage {store:store,frame:frame};
  let result:|execution_model|::ExecutionOutcome=mid_apply(input,&mut staged,prepared,target);
  transition result==|execution_model|::ExecutionOutcome::Success {true -> publish(store,frame,staged) _ -> (result)}
 }
 state publish(store:&mut |model|::ObjectStore,frame:&mut |execution_model|::Frame,staged:MidStage)->|execution_model|::ExecutionOutcome {
  store=staged.store;frame=staged.frame;|execution_model|::ExecutionOutcome::Success
 }
}
// Allocation must not make an originally invalid target identity valid. The
// fresh result changes no existing object or binding, so the canonical bridge
// will select the same action after this preflight and private allocation.
machine mid_original_target(store:&|model|::ObjectStore,frame:&|execution_model|::Frame,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
 let selected:|generic_target_model|::TargetSelection=|generic_targets|::select_target(frame,target);
 let action:|generic_target_model|::TargetAction=|generic_target_values|::classify_target(store,selected,|execution_model|::Operand::Uninitialized,false);
 transition action {
  |generic_target_model|::TargetAction::Failure {outcome} -> (outcome)
  |generic_target_model|::TargetAction::CopyTo {object_id,result_binding} -> existing(store,object_id)
  |generic_target_model|::TargetAction::StoreNamed {object_id} -> existing(store,object_id)
  |generic_target_model|::TargetAction::Replace {binding} -> binding(store,binding)
  |generic_target_model|::TargetAction::NoWrite -> (|execution_model|::ExecutionOutcome::Success)
 }
 state binding(store:&|model|::ObjectStore,binding:|execution_model|::Binding)->|execution_model|::ExecutionOutcome {
  transition binding {|execution_model|::Binding::Cell {cell_id} -> existing(store,cell_id) _ -> (|execution_model|::ExecutionOutcome::Success)}
 }
 state existing(store:&|model|::ObjectStore,id:u64)->|execution_model|::ExecutionOutcome {
  let count:u64=store.space.object_count;
  transition count<=64 && id<count && id<64 {true -> (|execution_model|::ExecutionOutcome::Success) _ -> (|execution_model|::ExecutionOutcome::MissingObject)}
 }
}
machine mid_integer(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,operand:|execution_model|::Operand)->|execution_model|::SlotResult {
 transition operand {
  |execution_model|::Operand::Uninitialized -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::Uninitialized})
  |execution_model|::Operand::Integer {number} -> scalar(size,number)
  |execution_model|::Operand::Object {object_id} -> object(input,length,unit,store,size,object_id)
 }
 state scalar(size:|integers|::IntegerSize,number:u64)->|execution_model|::SlotResult {let value:u64=|integers|::normalize(size,number);|execution_model|::SlotResult {slot:|execution_model|::Slot {initialized:true,number:value}}}
 state object(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64)->|execution_model|::SlotResult {
  let found:|model|::ReferenceState=|object_references|::unwrap_transparent(&store.space,id,64);
  transition found.outcome==|model|::Outcome::Success {true -> convert(input,length,unit,store,size,found.object) _ -> failed(found.outcome)}
 }
 state failed(outcome:|model|::Outcome)->|execution_model|::SlotResult {let error:|execution_model|::ExecutionOutcome=mid_reference_error(outcome);|execution_model|::SlotResult {outcome:error}}
 state convert(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64)->|execution_model|::SlotResult {
  let converted:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,id,size,|implicit_conversions|::ConversionTarget::Integer);
  transition converted {|implicit_conversions|::ImplicitResult::Integer {number} -> (|execution_model|::SlotResult {slot:|execution_model|::Slot {initialized:true,number:number}})
   |implicit_conversions|::ImplicitResult::Failure {reason} -> failed_conversion(reason) _ -> (|execution_model|::SlotResult {outcome:|execution_model|::ExecutionOutcome::InvalidState})}
 }
 state failed_conversion(reason:|object_conversions|::ConversionFailure)->|execution_model|::SlotResult {
  let error:|execution_model|::ExecutionOutcome=|named_store|::conversion_outcome(reason);|execution_model|::SlotResult {outcome:error}
 }
}
machine mid_reference_error(outcome:|model|::Outcome)->|execution_model|::ExecutionOutcome {
 transition outcome {|model|::Outcome::ReferenceCycle -> (|execution_model|::ExecutionOutcome::ReferenceCycle) |model|::Outcome::WorkLimit -> (|execution_model|::ExecutionOutcome::WorkLimit) _ -> (|execution_model|::ExecutionOutcome::InvalidState)}
}
machine mid_source(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,operand:|execution_model|::Operand,index:u64,requested:u64)->MidPrepared {
 transition operand {|execution_model|::Operand::Uninitialized -> (MidPrepared {outcome:|execution_model|::ExecutionOutcome::Uninitialized})
  |execution_model|::Operand::Integer {number} -> scalar(size,number,index,requested)
  |execution_model|::Operand::Object {object_id} -> object(input,length,unit,store,size,object_id,index,requested)}
 state object(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64,index:u64,requested:u64)->MidPrepared {
  let found:|model|::ReferenceState=|object_references|::unwrap_transparent(&store.space,id,64);
  transition found.outcome==|model|::Outcome::Success && found.object<64 {true -> value(input,length,unit,store,size,found.object,index,requested) _ -> failed(found.outcome)}
 }
 state failed(outcome:|model|::Outcome)->MidPrepared {let error:|execution_model|::ExecutionOutcome=mid_reference_error(outcome);MidPrepared {outcome:error}}
 state value(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,size:|integers|::IntegerSize,id:u64,index:u64,requested:u64)->MidPrepared {
  transition store.space.objects[id].value {|model|::Value::Integer {number} -> scalar(size,number,index,requested)
   |model|::Value::Uninitialized -> (MidPrepared {outcome:|execution_model|::ExecutionOutcome::Uninitialized}) _ -> bytes(input,length,unit,store,id,index,requested)}
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,id:u64,index:u64,requested:u64)->MidPrepared {
  let portion:|object_mid|::Portion=|object_mid|::extract(input,length,unit,store,id,index,requested);
  transition portion {|object_mid|::Portion::Buffer {length,bytes} -> (MidPrepared {length:length,bytes:bytes})
   |object_mid|::Portion::String {length,bytes} -> (MidPrepared {string:true,length:length,bytes:bytes})
   |object_mid|::Portion::Failure {reason} -> failed_conversion(reason)}
 }
 state failed_conversion(reason:|object_conversions|::ConversionFailure)->MidPrepared {
  let error:|execution_model|::ExecutionOutcome=|named_store|::conversion_outcome(reason);MidPrepared {outcome:error}
 }
 // Integer's highest-priority allowed source conversion is Buffer (Table19.6).
 state scalar(size:|integers|::IntegerSize,number:u64,index:u64,requested:u64)->MidPrepared {
  let normalized:u64=|integers|::normalize(size,number);let mut bytes:[u8;256];
  let encoded:|integers|::IntegerResult=|conversions|::integer_to_buffer(size,normalized,&mut bytes);
  let mut prepared:MidPrepared=MidPrepared {};
  let copied:|integers|::IntegerResult=|conversions|::mid(&bytes,encoded.value,index,requested,&mut prepared.bytes);
  prepared.length=copied.value;
  transition encoded.error==0 && copied.error==0 {true -> (prepared) _ -> (MidPrepared {outcome:|execution_model|::ExecutionOutcome::Capacity})}
 }
}
machine mid_apply(input:&[u8;1024],staged:&mut MidStage,prepared:MidPrepared,target:|execution_model|::Target)->|execution_model|::ExecutionOutcome {
 let id:u64=staged.store.space.object_count;
 transition id<64 && staged.store.space.count<=32 && prepared.length<=256 {true -> allocate(input,staged,prepared,target,id) _ -> (|execution_model|::ExecutionOutcome::Capacity)}
 state allocate(input:&[u8;1024],staged:&mut MidStage,prepared:MidPrepared,target:|execution_model|::Target,id:u64)->|execution_model|::ExecutionOutcome {
  let value:|model|::Value=mid_value(prepared.string,id);
  staged.store.space.objects[id]=|model|::Object {value:value};
  staged.store.bytes.blocks[id]=|model|::ByteBlock {initialized:true,length:prepared.length,bytes:prepared.bytes};
  staged.store.space.object_count=id+1;
  let written:|execution_model|::ExecutionOutcome=|generic_target_bridge|::write_generic_target(input,&mut staged.store,&mut staged.frame,target,|execution_model|::Operand::Object {object_id:id},false);
  transition written==|execution_model|::ExecutionOutcome::Success {true -> contribute(staged,id) _ -> (written)}
 }
 state contribute(staged:&mut MidStage,id:u64)->|execution_model|::ExecutionOutcome {
  let result:|execution_model|::ExecutionOutcome=|operands|::contribute_operand(&mut staged.frame,|execution_model|::Operand::Object {object_id:id});result
 }
}
machine mid_value(string:bool,id:u64)->|model|::Value {
 transition string {true -> (|model|::Value::String {string_storage:|model|::StringStorage::Owned {string_owner:id}})
  _ -> (|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:id}})}
}
