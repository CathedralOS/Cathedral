use execution_model.omg;
pub data TargetSelection [copy] {
 case Null; case Debug; case Named(object_id:u64);
 case Local(local_index:u64,local_binding:|execution_model|::Binding);
 case Argument(argument_index:u64,argument_binding:|execution_model|::Binding);
 case Failure(outcome:|execution_model|::ExecutionOutcome);
}

// Inert result of read-only argument target classification.
pub data ArgumentAction [copy] {
 case Replace(binding:|execution_model|::Binding);
 case CopyReferent(binding:|execution_model|::Binding,object_id:u64);
 case Failure(outcome:|execution_model|::ExecutionOutcome);
}

// Inert target policy decision, not a writable capability.
pub data TargetAction [copy] {
 case NoWrite;
 case Replace(binding:|execution_model|::Binding);
 case CopyTo(object_id:u64,result_binding:|execution_model|::Binding);
 case StoreNamed(object_id:u64);
 case Failure(outcome:|execution_model|::ExecutionOutcome);
}
