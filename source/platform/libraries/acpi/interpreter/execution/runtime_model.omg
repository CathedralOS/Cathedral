use execution_model.omg;
pub data Runtime [copy] {
    outcome: |execution_model|::ExecutionOutcome; frames: [|execution_model|::Frame; 4]; count: u64;
    unit: u64; length: u64; steps: u64; finished: bool; has_result:bool; result: |execution_model|::Operand;
    fault_offset: u64;
}
