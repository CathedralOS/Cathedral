use {aml}/field_model.omg;
use {access}/geometry.omg;
use {access}/model.omg;
use {integers}/integers.omg;
use model.omg as model_file;
use write.omg;
use transfer_model.omg;

// Admission checks the complete footprint and exact payload before issuing any
// relative request. Lock-requiring transfers await a future admitted adapter.
pub machine begin(kind:|field_model|::DeclarationKind,field:&|field_model|::Field,region_bytes:u64,size:|integers|::IntegerSize,payload:&[u8;256],length:u64,correlation:u64)->|transfer_model|::WriteTransfer {
 let planned:|model|::PlanResult=|geometry|::plan(kind,field,region_bytes,size);
 transition planned {
  |model|::PlanResult::Failure {error} -> (|transfer_model|::WriteTransfer {failure:|transfer_model|::TransferFailure::Admission {error:|model_file|::WriteError::Geometry {cause:error}}})
  |model|::PlanResult::Ready {plan} -> payload(field,region_bytes,size,payload,length,correlation,plan)
 }
 state payload(field:&|field_model|::Field,region_bytes:u64,size:|integers|::IntegerSize,payload:&[u8;256],length:u64,correlation:u64,plan:|model|::Plan)->|transfer_model|::WriteTransfer {
  let admitted:|model_file|::ChunkWriteResult=|write|::assemble_chunk(|field_model|::DeclarationKind::Field,field,region_bytes,size,payload,length,0,|model|::Previous::Value {word:0});
  transition admitted {
   |model_file|::ChunkWriteResult::Failure {error} -> (|transfer_model|::WriteTransfer {failure:|transfer_model|::TransferFailure::Admission {error:error}})
   |model_file|::ChunkWriteResult::Write {record,lock} -> lock(field,region_bytes,size,payload,length,correlation,plan,lock)
  }
 }
 state lock(field:&|field_model|::Field,region_bytes:u64,size:|integers|::IntegerSize,payload:&[u8;256],length:u64,correlation:u64,plan:|model|::Plan,lock:|model|::LockRequirement)->|transfer_model|::WriteTransfer {
  transition lock==|model|::LockRequirement::NotRequested {true -> start(field,region_bytes,size,payload,length,correlation,plan) _ -> (|transfer_model|::WriteTransfer {failure:|transfer_model|::TransferFailure::UnmetLock})}
 }
 state start(field:&|field_model|::Field,region_bytes:u64,size:|integers|::IntegerSize,payload:&[u8;256],length:u64,correlation:u64,plan:|model|::Plan)->|transfer_model|::WriteTransfer {
  let mut transfer:|transfer_model|::WriteTransfer=|transfer_model|::WriteTransfer {field:field,region_bytes:region_bytes,size:size,payload:payload,length:length,plan:plan,correlation:correlation};
  prepare(&mut transfer);transfer
 }
}
pub machine progress(transfer:&|transfer_model|::WriteTransfer)->|transfer_model|::TransferProgress {
 transition transfer.state {
  |transfer_model|::TransferState::Failed -> (|transfer_model|::TransferProgress::Failure {reason:transfer.failure,reads:transfer.reads,writes:transfer.writes})
  |transfer_model|::TransferState::Finished -> (|transfer_model|::TransferProgress::Finished {reads:transfer.reads,writes:transfer.writes})
  _ -> (|transfer_model|::TransferProgress::Pending {request:transfer.request})
 }
}
pub machine same_request(a:|transfer_model|::Request,b:|transfer_model|::Request)->bool {
 a.kind==b.kind && a.correlation==b.correlation && a.serial==b.serial && a.chunk==b.chunk && a.offset==b.offset && a.width==b.width && a.value==b.value
}
// Rejected kind, identity, duplicate and closed-transfer responses mutate no
// state. A matching provider failure is accepted and terminal; prior ack counts
// remain visible and never imply rollback or absence of effects from a failed call.
pub machine complete(transfer:&mut |transfer_model|::WriteTransfer,completion:|transfer_model|::Completion)->|transfer_model|::Acceptance {
 transition transfer.state==|transfer_model|::TransferState::Reading || transfer.state==|transfer_model|::TransferState::Writing {
  true -> active(transfer,completion)
  _ -> (|transfer_model|::Acceptance::Rejected)
 }
 state active(transfer:&mut |transfer_model|::WriteTransfer,completion:|transfer_model|::Completion)->|transfer_model|::Acceptance {
  transition completion {
   |transfer_model|::Completion::Failure {request,cause} -> failed(transfer,request,cause)
   |transfer_model|::Completion::Word {request,value} -> read(transfer,request,value)
   |transfer_model|::Completion::Written {request} -> written(transfer,request)
  }
 }
 state failed(transfer:&mut |transfer_model|::WriteTransfer,request:|transfer_model|::Request,cause:|transfer_model|::ProviderFailure)->|transfer_model|::Acceptance {
  let same:bool=same_request(transfer.request,request);
  transition same {true -> fail(transfer,cause) _ -> (|transfer_model|::Acceptance::Rejected)}
 }
 state fail(transfer:&mut |transfer_model|::WriteTransfer,cause:|transfer_model|::ProviderFailure)->|transfer_model|::Acceptance {
  transfer.state=|transfer_model|::TransferState::Failed;transfer.failure=|transfer_model|::TransferFailure::Provider {cause:cause};|transfer_model|::Acceptance::Accepted
 }
 state read(transfer:&mut |transfer_model|::WriteTransfer,request:|transfer_model|::Request,value:u64)->|transfer_model|::Acceptance {
  let same:bool=same_request(transfer.request,request);
  transition same && transfer.state==|transfer_model|::TransferState::Reading && transfer.reads<257 {
   true -> read_word(transfer,value) _ -> (|transfer_model|::Acceptance::Rejected)
  }
 }
 state read_word(transfer:&mut |transfer_model|::WriteTransfer,value:u64)->|transfer_model|::Acceptance {
  transfer.reads=transfer.reads+1;issue_write(transfer,|model|::Previous::Value {word:value});|transfer_model|::Acceptance::Accepted
 }
 state written(transfer:&mut |transfer_model|::WriteTransfer,request:|transfer_model|::Request)->|transfer_model|::Acceptance {
  let same:bool=same_request(transfer.request,request);
  transition same && transfer.state==|transfer_model|::TransferState::Writing && transfer.writes<257 {
   true -> next(transfer) _ -> (|transfer_model|::Acceptance::Rejected)
  }
 }
 state next(transfer:&mut |transfer_model|::WriteTransfer)->|transfer_model|::Acceptance {
  transfer.writes=transfer.writes+1;prepare(transfer);|transfer_model|::Acceptance::Accepted
 }
}
machine prepare(transfer:&mut |transfer_model|::WriteTransfer) {
 let count:u64=transfer.plan.count;let index:u64=transfer.writes;
 transition count>0 && count<=257 && index<=count {
  true -> selected(transfer,index,count) _ -> invalid(transfer)
 }
 state selected(transfer:&mut |transfer_model|::WriteTransfer,index:u64,count:u64) {
  transition index==count {true -> finished(transfer) _ -> bounded(transfer,index)}
 }
 state finished(transfer:&mut |transfer_model|::WriteTransfer) {transfer.state=|transfer_model|::TransferState::Finished;}
 state bounded(transfer:&mut |transfer_model|::WriteTransfer,index:u64) {
  transition index<257 {true -> chunk(transfer,index) _ -> invalid(transfer)}
 }
 state chunk(transfer:&mut |transfer_model|::WriteTransfer,index:u64) {
  transition transfer.plan.update==|field_model|::UpdateRule::Preserve && transfer.plan.chunks[index].partial {
   true -> read(transfer,index) _ -> write(transfer)
  }
 }
 state read(transfer:&mut |transfer_model|::WriteTransfer,index:u64) {
  transition index<257 && transfer.issued<514 {true -> issue(transfer,index) _ -> invalid(transfer)}
 }
 state issue(transfer:&mut |transfer_model|::WriteTransfer,index:u64) {
  let serial:u64=transfer.issued;let offset:u64=transfer.plan.chunks[index].offset;let width:u64=transfer.plan.chunks[index].width;
  transfer.request=|transfer_model|::Request {kind:|transfer_model|::RequestKind::Read,correlation:transfer.correlation,serial:serial,chunk:index,offset:offset,width:width};
  transfer.issued=serial+1;transfer.state=|transfer_model|::TransferState::Reading;
 }
 state write(transfer:&mut |transfer_model|::WriteTransfer) {issue_write(transfer,|model|::Previous::Absent);}
 state invalid(transfer:&mut |transfer_model|::WriteTransfer) {transfer.state=|transfer_model|::TransferState::Failed;transfer.failure=|transfer_model|::TransferFailure::InvalidState;}
}
machine issue_write(transfer:&mut |transfer_model|::WriteTransfer,previous:|model|::Previous) {
 let index:u64=transfer.writes;let count:u64=transfer.plan.count;
 transition count<=257 && index<count && index<257 && transfer.issued<514 && transfer.plan.lock==|model|::LockRequirement::NotRequested {
  true -> chunk(transfer,previous,index) _ -> invalid(transfer)
 }
 // The retained plan/payload were admitted once by begin. Reuse the same
 // package-private merge kernel as bulk/single-chunk assembly; do not re-plan
 // the entire field for each acknowledgement.
 state chunk(transfer:&mut |transfer_model|::WriteTransfer,previous:|model|::Previous,index:u64) {
  let chunk:|model|::Chunk=transfer.plan.chunks[index];
  let composed:|model|::WordResult=|write|::chunk_value(chunk,transfer.plan.update,&transfer.payload,transfer.length,previous);
  transition composed {
   |model|::WordResult::Failure {error} -> failed(transfer,|model_file|::WriteError::Chunk {index:index,cause:error})
   |model|::WordResult::Word {value} -> issue(transfer,chunk.offset,chunk.width,value)
  }
 }
 state failed(transfer:&mut |transfer_model|::WriteTransfer,error:|model_file|::WriteError) {transfer.state=|transfer_model|::TransferState::Failed;transfer.failure=|transfer_model|::TransferFailure::Admission {error:error};}
 state issue(transfer:&mut |transfer_model|::WriteTransfer,offset:u64,width:u64,value:u64) {
  let serial:u64=transfer.issued;
  transfer.request=|transfer_model|::Request {kind:|transfer_model|::RequestKind::Write,correlation:transfer.correlation,serial:serial,chunk:transfer.writes,offset:offset,width:width,value:value};
  transfer.issued=serial+1;transfer.state=|transfer_model|::TransferState::Writing;
 }
 state invalid(transfer:&mut |transfer_model|::WriteTransfer) {transfer.state=|transfer_model|::TransferState::Failed;transfer.failure=|transfer_model|::TransferFailure::InvalidState;}
}
