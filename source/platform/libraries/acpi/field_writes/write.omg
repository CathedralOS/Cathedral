// SPDX-License-Identifier: MIT OR Apache-2.0
// Partial single-pass do_field_write arithmetic from rust-osdev/acpi
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5; copyright 2018 Isaac Woods.
// Payload is already converted to one logical field-sized vector, not an AML Buffer.
use {omega}/language/core/nat.omg;
use {access}/geometry.omg;
use {access}/chunks.omg;
use {access}/model.omg;
use {aml}/field_model.omg;
use {integers}/integers.omg;
use {integers}/buffer_fields.omg;
use model.omg as model_file;
data Records [copy] {records:[|model_file|::NativeWrite;257];}
// Re-admit the complete field footprint before selecting one native chunk.
// The caller supplies only this chunk's prior word, never a batch of reads.
pub machine assemble_chunk(kind:|field_model|::DeclarationKind,field:&|field_model|::Field,region_bytes:u64,size:|integers|::IntegerSize,payload:&[u8;256],payload_length:u64,index:u64,previous:|model|::Previous)->|model_file|::ChunkWriteResult {
 let geometry:|model|::PlanResult=|geometry|::plan(kind,field,region_bytes,size);
 transition geometry {
  |model|::PlanResult::Failure {error} -> (|model_file|::ChunkWriteResult::Failure {error:|model_file|::WriteError::Geometry {cause:error}})
  |model|::PlanResult::Ready {plan} -> payload(&plan,payload,payload_length,index,previous)
 }
 state payload(plan:&|model|::Plan,payload:&[u8;256],payload_length:u64,index:u64,previous:|model|::Previous)->|model_file|::ChunkWriteResult {
  let bits:u64=plan.bit_length;
  transition bits<=2048 {true -> length(plan,payload,payload_length,index,previous,(bits+7)/8) _ -> (|model_file|::ChunkWriteResult::Failure {error:|model_file|::WriteError::PayloadLength})}
 }
 state length(plan:&|model|::Plan,payload:&[u8;256],payload_length:u64,index:u64,previous:|model|::Previous,expected:u64)->|model_file|::ChunkWriteResult {
  transition payload_length<=256 && payload_length==expected {true -> selected(plan,payload,payload_length,index,previous) _ -> (|model_file|::ChunkWriteResult::Failure {error:|model_file|::WriteError::PayloadLength})}
 }
 state selected(plan:&|model|::Plan,payload:&[u8;256],payload_length:u64,index:u64,previous:|model|::Previous)->|model_file|::ChunkWriteResult {
  let count:u64=plan.count;
  transition count<=257 && index<count && index<257 {
   true -> compose(plan.chunks[index],plan.update,plan.lock,payload,payload_length,index,previous)
   _ -> (|model_file|::ChunkWriteResult::Failure {error:|model_file|::WriteError::Chunk {index:index,cause:|model|::Error::InvalidChunk}})
  }
 }
 state compose(chunk:|model|::Chunk,update:|field_model|::UpdateRule,lock:|model|::LockRequirement,payload:&[u8;256],payload_length:u64,index:u64,previous:|model|::Previous)->|model_file|::ChunkWriteResult {
  let merged:|model|::WordResult=chunk_value(chunk,update,payload,payload_length,previous);
  transition merged {
   |model|::WordResult::Failure {error} -> (|model_file|::ChunkWriteResult::Failure {error:|model_file|::WriteError::Chunk {index:index,cause:error}})
   |model|::WordResult::Word {value} -> (|model_file|::ChunkWriteResult::Write {record:|model_file|::NativeWrite {offset:chunk.offset,width:chunk.width,value:value},lock:lock})
  }
 }
}
pub machine assemble(kind:|field_model|::DeclarationKind,field:&|field_model|::Field,region_bytes:u64,size:|integers|::IntegerSize,payload:&[u8;256],payload_length:u64,previous:&[|model|::Previous;257],supplied_count:u64)->|model_file|::WriteResult {
 let geometry:|model|::PlanResult=|geometry|::plan(kind,field,region_bytes,size);
 transition geometry {
  |model|::PlanResult::Failure {error} -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::Geometry {cause:error}})
  |model|::PlanResult::Ready {plan} -> payload(&plan,payload,payload_length,previous,supplied_count)
 }
 state payload(plan:&|model|::Plan,payload:&[u8;256],payload_length:u64,previous:&[|model|::Previous;257],supplied_count:u64)->|model_file|::WriteResult {
  let bits:u64=plan.bit_length;
  transition bits<=2048 {true -> length(plan,payload,payload_length,previous,supplied_count,(bits+7)/8) _ -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::PayloadLength})}
 }
 state length(plan:&|model|::Plan,payload:&[u8;256],payload_length:u64,previous:&[|model|::Previous;257],supplied_count:u64,expected:u64)->|model_file|::WriteResult {
  transition payload_length<=256 && payload_length==expected {true -> count(plan,payload,payload_length,previous,supplied_count) _ -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::PayloadLength})}
 }
 state count(plan:&|model|::Plan,payload:&[u8;256],payload_length:u64,previous:&[|model|::Previous;257],supplied_count:u64)->|model_file|::WriteResult {
  let expected:u64=plan.count;
  transition supplied_count<=257 && supplied_count==expected {true -> fill(plan,payload,payload_length,previous,supplied_count) _ -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::CountMismatch})}
 }
 state fill(plan:&|model|::Plan,payload:&[u8;256],payload_length:u64,previous:&[|model|::Previous;257],count:u64)->|model_file|::WriteResult {
  let initial:|model_file|::WriteResult=|model_file|::WriteResult::Writes {count:count,lock:plan.lock};
  let completed:|model_file|::WriteResult=fill_chunks(initial,plan,payload,payload_length,previous,0,count);completed
 }
}
machine fill_chunks(current:|model_file|::WriteResult,plan:&|model|::Plan,payload:&[u8;256],length:u64,previous:&[|model|::Previous;257],index:u64,limit:u64)
terminates by(index,limit)->|nat|::Nat::BoundedDistance;
->|model_file|::WriteResult {
 let next:|model_file|::WriteResult=fill_if(current,plan,payload,length,previous,index,limit);
 transition index<limit {true -> fill_chunks(next,plan,payload,length,previous,index+1,limit) _ -> (current)}
}
machine fill_if(current:|model_file|::WriteResult,plan:&|model|::Plan,payload:&[u8;256],length:u64,previous:&[|model|::Previous;257],index:u64,limit:u64)->|model_file|::WriteResult {
 transition index<limit {true -> bounded(current,plan,payload,length,previous,index) _ -> (current)}
 state bounded(current:|model_file|::WriteResult,plan:&|model|::Plan,payload:&[u8;256],length:u64,previous:&[|model|::Previous;257],index:u64)->|model_file|::WriteResult {
  transition index<257 {true -> shape(current,plan,payload,length,previous,index) _ -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::Chunk {index:index,cause:|model|::Error::InvalidChunk}})}
 }
 state shape(current:|model_file|::WriteResult,plan:&|model|::Plan,payload:&[u8;256],length:u64,previous:&[|model|::Previous;257],index:u64)->|model_file|::WriteResult {
  transition current {
   |model_file|::WriteResult::Failure {error} -> (|model_file|::WriteResult::Failure {error:error})
   |model_file|::WriteResult::Writes {count,records,lock} -> chunk(plan,payload,length,previous,index,count,records,lock)
  }
 }
 state chunk(plan:&|model|::Plan,payload:&[u8;256],length:u64,previous:&[|model|::Previous;257],index:u64,count:u64,records:[|model_file|::NativeWrite;257],lock:|model|::LockRequirement)->|model_file|::WriteResult {
  transition index<257 {true -> extract(plan,payload,length,previous[index],index,count,records,lock,plan.chunks[index]) _ -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::Chunk {index:index,cause:|model|::Error::InvalidChunk}})}
 }
 state extract(plan:&|model|::Plan,payload:&[u8;256],length:u64,previous:|model|::Previous,index:u64,count:u64,records:[|model_file|::NativeWrite;257],lock:|model|::LockRequirement,chunk:|model|::Chunk)->|model_file|::WriteResult {
  let merged:|model|::WordResult=chunk_value(chunk,plan.update,payload,length,previous);
  transition merged {
   |model|::WordResult::Failure {error} -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::Chunk {index:index,cause:error}})
   |model|::WordResult::Word {value} -> store(index,count,records,lock,chunk,value)
  }
 }
 state store(index:u64,count:u64,records:[|model_file|::NativeWrite;257],lock:|model|::LockRequirement,chunk:|model|::Chunk,value:u64)->|model_file|::WriteResult {
  transition index<257 {true -> write(index,count,records,lock,chunk,value) _ -> (|model_file|::WriteResult::Failure {error:|model_file|::WriteError::Chunk {index:index,cause:|model|::Error::InvalidChunk}})}
 }
 state write(index:u64,count:u64,records:[|model_file|::NativeWrite;257],lock:|model|::LockRequirement,chunk:|model|::Chunk,value:u64)->|model_file|::WriteResult {
  let mut next:Records=Records {records:records};next.records[index]=|model_file|::NativeWrite {offset:chunk.offset,width:chunk.width,value:value};
  |model_file|::WriteResult::Writes {count:count,records:next.records,lock:lock}
 }
}
// Both public forms share the same extraction and surrounding-bit merge.
machine chunk_value(chunk:|model|::Chunk,update:|field_model|::UpdateRule,payload:&[u8;256],length:u64,previous:|model|::Previous)->|model|::WordResult {
 let bits:u64=chunk.bit_count;let size:|integers|::IntegerSize=extraction_size(bits);
 let value:|integers|::IntegerResult=|buffer_fields|::field_to_integer(size,payload,length,chunk.field_bit,bits);
 transition value.error==0 {true -> merge(chunk,update,previous,value.value) _ -> (|model|::WordResult::Failure {error:|model|::Error::InvalidChunk})}
 state merge(chunk:|model|::Chunk,update:|field_model|::UpdateRule,previous:|model|::Previous,value:u64)->|model|::WordResult {
  let merged:|model|::WordResult=|chunks|::merge(chunk,update,previous,value);merged
 }
}
// Extraction uses the smallest canonical integer size that covers this chunk.
machine extraction_size(bits:u64)->|integers|::IntegerSize {transition bits<=32 {true -> (|integers|::IntegerSize::FourBytes) _ -> (|integers|::IntegerSize::EightBytes)}}
