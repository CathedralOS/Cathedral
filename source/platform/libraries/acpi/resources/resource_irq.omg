// Modified bounded view of pin Irqs mask expansion and ExtendedIRQ numbers.
use {omega}/language/core/nat.omg;
use resource_model.omg;
use resource_bytes.omg;
pub machine irq_at(input:&[u8;4096],length:u64,interrupts:|resource_model|::Interrupts,index:u64)->|resource_model|::NumberResult {
 transition length<=4096 {
  true -> representation(input,length,interrupts,index) _ -> (|resource_model|::NumberResult{})
 }
 state representation(input:&[u8;4096],length:u64,interrupts:|resource_model|::Interrupts,index:u64) {
  transition interrupts {|resource_model|::Interrupts::Mask{bits} -> mask(bits,index) |resource_model|::Interrupts::Table{entries,count} -> table(input,length,entries,count,index)}
 }
 state mask(bits:u16,index:u64) {let value:|resource_model|::NumberResult=mask_scan(bits,index,0,16,0,|resource_model|::NumberResult{});value}
 state table(input:&[u8;4096],length:u64,entries:|resource_model|::Span,count:u64,index:u64) {
  let start:u64=entries.start;let end:u64=entries.end;
  transition start<=end && end<=length && count>0 && count<=255 && index<count {true -> extent(input,start,end,count,index) _ -> (|resource_model|::NumberResult{})}
 }
 state extent(input:&[u8;4096],start:u64,end:u64,count:u64,index:u64) {
  transition start<=end && count<=255 && index<255 {true -> read(input,start,end,count,index) _ -> (|resource_model|::NumberResult{})}
 }
 state read(input:&[u8;4096],start:u64,end:u64,count:u64,index:u64) {
  let value:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,index*4,4);
  transition end-start==count*4 {true -> (value) _ -> (|resource_model|::NumberResult{})}
 }
}
machine mask_scan(bits:u16,wanted:u64,bit:u64,limit:u64,count:u64,found:|resource_model|::NumberResult)
terminates by (bit,limit)->|nat|::Nat::BoundedDistance;
->|resource_model|::NumberResult {
 let next:|resource_model|::NumberResult=mask_lookup(bits,wanted,bit,count,found);let next_count:u64=mask_count(bits,bit,count);
 transition bit<limit {true -> mask_scan(bits,wanted,bit+1,limit,next_count,next) _ -> (found)}
}
machine mask_lookup(bits:u16,wanted:u64,bit:u64,count:u64,found:|resource_model|::NumberResult)->|resource_model|::NumberResult {
 transition bit<16 {true -> selected(bits,wanted,bit,count,found) _ -> (found)}
 state selected(bits:u16,wanted:u64,bit:u64,count:u64,found:|resource_model|::NumberResult) {
  transition ((bits as u64)>>bit)&1!=0 && count==wanted {true -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Success,value:bit}) _ -> (found)}
 }
}
machine mask_count(bits:u16,bit:u64,count:u64)->u64 {
 transition bit<16 && count<=16 {true -> selected(bits,bit,count) _ -> (count)}
 state selected(bits:u16,bit:u64,count:u64) {transition ((bits as u64)>>bit)&1!=0 {true -> (count+1) _ -> (count)}}
}
