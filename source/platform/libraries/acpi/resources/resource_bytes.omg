// Bounded initialized-byte adapter; no addresses or mapping authority.
use {omega}/language/core/nat.omg;
use {acpi}/fixed_bytes.omg;
use resource_model.omg;
pub machine read(input:&[u8;4096],end:u64,at:u64,width:u64)->|resource_model|::NumberResult {
 transition width {1 -> byte(input,end,at) 2 -> word(input,end,at) 4 -> dword(input,end,at) 8 -> qword(input,end,at) _ -> (|resource_model|::NumberResult{})}
 state byte(input:&[u8;4096],end:u64,at:u64) {let r:|fixed_bytes|::U8Result=|fixed_bytes|::read_u8(input,end,at);transition r.error==0 {true -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Success,value:r.value as u64}) _ -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Truncated})}}
 state word(input:&[u8;4096],end:u64,at:u64) {let r:|fixed_bytes|::U16Result=|fixed_bytes|::read_u16(input,end,at);transition r.error==0 {true -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Success,value:r.value as u64}) _ -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Truncated})}}
 state dword(input:&[u8;4096],end:u64,at:u64) {let r:|fixed_bytes|::U32Result=|fixed_bytes|::read_u32(input,end,at);transition r.error==0 {true -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Success,value:r.value as u64}) _ -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Truncated})}}
 state qword(input:&[u8;4096],end:u64,at:u64) {let r:|fixed_bytes|::U64Result=|fixed_bytes|::read_u64(input,end,at);transition r.error==0 {true -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Success,value:r.value}) _ -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Truncated})}}
}
// Internal decoder utility: only called after the full descriptor is bounded.
// Its explicit relative checks also make direct calls safe, returning no bytes.
pub machine relative(input:&[u8;4096],end:u64,at:u64,delta:u64,width:u64)->|resource_model|::NumberResult {
 transition end<=4096 && at<=end {true -> room(input,end,at,delta,width) _ -> (|resource_model|::NumberResult{})}
 state room(input:&[u8;4096],end:u64,at:u64,delta:u64,width:u64) {
  transition delta<=end-at {true -> fetch(input,end,at+delta,width) _ -> (|resource_model|::NumberResult{outcome:|resource_model|::Outcome::Truncated})}
 }
 state fetch(input:&[u8;4096],end:u64,at:u64,width:u64) {let r:|resource_model|::NumberResult=read(input,end,at,width);r}
}
pub machine envelope(input:&[u8;4096],length:u64,at:u64)->|resource_model|::Envelope {
 transition length<=4096 && at<=length {true -> lead(input,length,at) _ -> (|resource_model|::Envelope{})}
 state lead(input:&[u8;4096],length:u64,at:u64) {
  let r:|resource_model|::NumberResult=read(input,length,at,1);
  transition r.outcome==|resource_model|::Outcome::Success && at<4096 {true -> format(input,length,at,((r.value & 255) as u8)) _ -> (|resource_model|::Envelope{outcome:|resource_model|::Outcome::Truncated})}
 }
 state format(input:&[u8;4096],length:u64,at:u64,lead:u8) {
  transition lead&128==0 {true -> extent(length,at,at+1,false,(lead>>3)&15,(lead&7)as u64) _ -> large(input,length,at,lead)}
 }
 state large(input:&[u8;4096],length:u64,at:u64,lead:u8) {
  let r:|resource_model|::NumberResult=relative(input,length,at,1,2);
  transition r.outcome==|resource_model|::Outcome::Success && at<=4093 {true -> extent(length,at,at+3,true,lead&127,r.value) _ -> (|resource_model|::Envelope{outcome:|resource_model|::Outcome::Truncated})}
 }
 state extent(length:u64,at:u64,body:u64,large:bool,tag:u8,size:u64) {
  transition body<=length {true -> payload(length,at,body,large,tag,size) _ -> (|resource_model|::Envelope{outcome:|resource_model|::Outcome::Truncated})}
 }
 state payload(length:u64,at:u64,body:u64,large:bool,tag:u8,size:u64) {
  transition size<=length-body {true -> (|resource_model|::Envelope{outcome:|resource_model|::Outcome::Success,large:large,tag:tag,start:at,body:body,end:body+size,length:size}) _ -> (|resource_model|::Envelope{outcome:|resource_model|::Outcome::Truncated})}
 }
}
pub machine optional_source(input:&[u8;4096],end:u64,at:u64)->|resource_model|::SourceResult {
 transition end<=4096 && at<=end {true -> present(input,end,at) _ -> (|resource_model|::SourceResult{})}
 state present(input:&[u8;4096],end:u64,at:u64) {
  transition at==end {true -> (|resource_model|::SourceResult{outcome:|resource_model|::Outcome::Success}) _ -> room(input,end,at)}
 }
 state room(input:&[u8;4096],end:u64,at:u64) {
  transition end-at>=2 && at<4095 {true -> scan(input,end,at) _ -> (|resource_model|::SourceResult{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state scan(input:&[u8;4096],end:u64,at:u64) {
  let index:|resource_model|::NumberResult=read(input,end,at,1);
  let good:bool=source_ascii_scan(input,at+1,end,true);
  transition good {true -> (|resource_model|::SourceResult{outcome:|resource_model|::Outcome::Success,source:|resource_model|::Source{present:true,index:((index.value & 255) as u8),name:|resource_model|::Span{start:at+1,end:end-1}}}) _ -> (|resource_model|::SourceResult{outcome:|resource_model|::Outcome::BadEncoding})}
 }
}
machine source_ascii_scan(input:&[u8;4096],at:u64,end:u64,prior:bool)
terminates by (at,end)->|nat|::Nat::BoundedDistance;
->bool {
 let valid:bool=source_ascii_byte(input,at,end);
 transition at<end {true -> source_ascii_scan(input,at+1,end,prior && valid) _ -> (prior)}
}
machine source_ascii_byte(input:&[u8;4096],at:u64,end:u64)->bool {
 transition at<end && at<4096 {true -> checked(input,at,end) _ -> (true)}
 state checked(input:&[u8;4096],at:u64,end:u64) {
  transition at+1==end {true -> (input[at]==0) _ -> (input[at]>0 && input[at]<128)}
 }
}

// Required controller source: explicit ASCII/final-NUL Cathedral byte profile.
// The index lives in the fixed connection header, not before the source bytes.
pub machine controller_source(input:&[u8;4096],at:u64,end:u64,index:u8)->|resource_model|::SourceResult {
 transition at<end && end<=4096 {true -> validate(input,at,end,index) _ -> (|resource_model|::SourceResult{outcome:|resource_model|::Outcome::BadEncoding})}
 state validate(input:&[u8;4096],at:u64,end:u64,index:u8) {
  let good:bool=source_ascii_scan(input,at,end,true);
  transition good {true -> (|resource_model|::SourceResult{outcome:|resource_model|::Outcome::Success,source:|resource_model|::Source{present:true,index:index,name:|resource_model|::Span{start:at,end:end-1}}}) _ -> (|resource_model|::SourceResult{outcome:|resource_model|::Outcome::BadEncoding})}
 }
}
