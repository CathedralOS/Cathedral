use resource_model.omg;
use resource_connections.omg;
use resource_bytes.omg;
pub machine parse_one(input:&[u8;4096],length:u64,at:u64)->|resource_model|::Parsed {
 let e:|resource_model|::Envelope=|resource_bytes|::envelope(input,length,at);
 transition e.outcome==|resource_model|::Outcome::Success {true -> bounded(input,e) _ -> (|resource_model|::Parsed{outcome:e.outcome})}
 state bounded(input:&[u8;4096],e:|resource_model|::Envelope) {
  let body:u64=e.body;let end:u64=e.end;let size:u64=e.length;
  transition body<=end && end<=4096 {true -> format(input,e,body,end,size) _ -> (|resource_model|::Parsed{})}
 }
 state format(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {
  transition e.large {true -> large(input,e,body,end,size) _ -> small(input,e,body,end,size)}
 }
 state small(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {
  transition e.tag {
   4 -> irq(input,e,body,end,size) 5 -> dma(input,e,body,end,size) 8 -> io(input,e,body,end,size)
   15 -> endtag(input,e,body,end,size)
   6 -> unsupported(e) 7 -> unsupported(e) 9 -> unsupported(e) 10 -> unsupported(e) 14 -> unsupported(e)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})
  }
 }
 state large(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {
  transition e.tag {
   6 -> memory(input,e,body,end,size) 7 -> address(input,e,body,end,size,4) 8 -> address(input,e,body,end,size,2)
   9 -> extended(input,e,body,end,size) 10 -> address(input,e,body,end,size,8)
   1 -> unsupported(e) 2 -> unsupported(e) 4 -> unsupported(e) 5 -> unsupported(e)
   11 -> unsupported(e) 12 -> connection(input,e) 13 -> unsupported(e) 14 -> connection(input,e)
   15 -> unsupported(e) 16 -> unsupported(e) 17 -> unsupported(e) 18 -> unsupported(e) 19 -> unsupported(e)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})
  }
 }
 state connection(input:&[u8;4096],e:|resource_model|::Envelope) {let value:|resource_model|::Parsed=|resource_connections|::parse_connection(input,e.end,e.start);value}
 state unsupported(e:|resource_model|::Envelope) {|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::Unsupported{large:e.large,tag:e.tag,encoding:|resource_model|::Span{start:e.start,end:e.end}}}}
 state irq(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {let value:|resource_model|::Parsed=decode_irq(input,e,body,end,size);value}
 state dma(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {let value:|resource_model|::Parsed=decode_dma(input,e,body,end,size);value}
 state io(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {let value:|resource_model|::Parsed=decode_io(input,e,body,end,size);value}
 state memory(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {let value:|resource_model|::Parsed=decode_memory(input,e,body,end,size);value}
 state address(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64,width:u64) {let value:|resource_model|::Parsed=decode_address(input,e,body,end,size,width);value}
 state extended(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {let value:|resource_model|::Parsed=decode_extended(input,e,body,end,size);value}
 state endtag(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64) {
  let byte:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,0,1);
  transition size==1 {true -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:end},next:end,resource:|resource_model|::Resource::EndTag{checksum:((byte.value & 255) as u8)}}) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
}
machine decode_irq(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64)->|resource_model|::Parsed {
 let mask:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,0,2);
 transition size {2 -> ready(e,mask.value,1) 3 -> flags(input,e,body,end,mask.value) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 state flags(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,mask:u64) {
  let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,2,1);
  transition flags.value&192==0 && ((flags.value&9)==1 || (flags.value&9)==8) {true -> ready(e,mask,flags.value) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state ready(e:|resource_model|::Envelope,mask:u64,flags:u64) {
  let trigger:|resource_model|::Trigger=interrupt_trigger(flags&1!=0);let polarity:|resource_model|::Polarity=interrupt_polarity(flags&8!=0);
  |resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::IrqResource{irq:|resource_model|::Irq{interrupts:|resource_model|::Interrupts::Mask{bits:((mask & 65535) as u16)},trigger:trigger,polarity:polarity,shared:flags&16!=0,wake:flags&32!=0,flags:((flags & 255) as u8)}}}
 }
}
machine interrupt_trigger(edge:bool)->|resource_model|::Trigger {transition edge {true -> (|resource_model|::Trigger::Edge) _ -> (|resource_model|::Trigger::Level)}}
machine interrupt_polarity(low:bool)->|resource_model|::Polarity {transition low {true -> (|resource_model|::Polarity::ActiveLow) _ -> (|resource_model|::Polarity::ActiveHigh)}}
machine decode_dma(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64)->|resource_model|::Parsed {
 let mask:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,0,1);let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,1,1);
 transition size==2 && flags.value&128==0 && flags.value&3!=3 {true -> ready(e,mask.value,flags.value) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 state ready(e:|resource_model|::Envelope,mask:u64,flags:u64) {
  let speed:|resource_model|::DmaSpeed=dma_speed((flags>>5)&3);let width:|resource_model|::DmaWidth=dma_width(flags&3);
  |resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::DmaResource{dma:|resource_model|::Dma{channels:((mask & 255) as u8),speed:speed,width:width,bus_master:flags&4!=0,flags:((flags & 255) as u8)}}}
 }
}
machine dma_speed(code:u64)->|resource_model|::DmaSpeed {transition code {1 -> (|resource_model|::DmaSpeed::TypeA) 2 -> (|resource_model|::DmaSpeed::TypeB) 3 -> (|resource_model|::DmaSpeed::TypeF) _ -> (|resource_model|::DmaSpeed::Compatibility)}}
machine dma_width(code:u64)->|resource_model|::DmaWidth {transition code {1 -> (|resource_model|::DmaWidth::Bits8And16) 2 -> (|resource_model|::DmaWidth::Bits16) _ -> (|resource_model|::DmaWidth::Bits8)}}
machine decode_io(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64)->|resource_model|::Parsed {
 let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,0,1);let minimum:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,1,2);let maximum:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,3,2);let alignment:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,5,1);let length:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,6,1);
 transition size==7 && flags.value&254==0 {
  true -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::IoResource{io:|resource_model|::Io{decodes_full:flags.value&1!=0,minimum:((minimum.value & 65535) as u16),maximum:((maximum.value & 65535) as u16),alignment:((alignment.value & 255) as u8),length:((length.value & 255) as u8)}}})
  _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})
 }
}
machine decode_memory(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64)->|resource_model|::Parsed {
 let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,0,1);let base:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,1,4);let length:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,5,4);
 transition size==9 {
  true -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::FixedMemoryResource{memory:|resource_model|::FixedMemory{writable:flags.value&1!=0,base:((base.value & 4294967295) as u32),length:((length.value & 4294967295) as u32),flags:((flags.value & 255) as u8)}}})
  _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})
 }
}
machine decode_address(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64,width:u64)->|resource_model|::Parsed {
 transition width<=8 && body<=4096 {true -> extent(input,e,body,end,size,width) _ -> (|resource_model|::Parsed{})}
 state extent(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64,width:u64) {
  let core:u64=3+width*5;
  transition size>=core {true -> kind(input,e,body,end,width,core) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state kind(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,width:u64,core:u64) {
  let kind:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,0,1);let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,1,1);
  transition {kind.value<3 && flags.value&240==0 -> values(input,e,body,end,width,core,kind.value,flags.value)
   kind.value==10 || kind.value>=192 -> unsupported(e)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state unsupported(e:|resource_model|::Envelope) {|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::Unsupported{large:true,tag:e.tag,encoding:|resource_model|::Span{start:e.start,end:e.end}}}}
 state values(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,width:u64,core:u64,kind:u64,flags:u64) {
  transition body<=4096 && core<=43 && width<=8 {true -> decode(input,e,body,end,width,core,kind,flags) _ -> (|resource_model|::Parsed{})}
 }
 state decode(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,width:u64,core:u64,kind:u64,flags:u64) {
  let types:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,2,1);
  let granularity:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,3,width);let minimum:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,3+width,width);let maximum:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,3+width*2,width);let translation:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,3+width*3,width);let length:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,3+width*4,width);
  let source:|resource_model|::SourceResult=|resource_bytes|::optional_source(input,end,body+core);let address_kind:|resource_model|::AddressKind=address_kind(kind);
  transition source.outcome==|resource_model|::Outcome::Success {
   true -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::AddressResource{address:|resource_model|::Address{width:((width & 255) as u8),kind:address_kind,maximum_fixed:flags&8!=0,minimum_fixed:flags&4!=0,subtractive:flags&2!=0,general_flags:((flags & 255) as u8),type_flags:((types.value & 255) as u8),granularity:granularity.value,minimum:minimum.value,maximum:maximum.value,translation:translation.value,length:length.value,source:source.source}}})
   _ -> (|resource_model|::Parsed{outcome:source.outcome})
  }
 }
}
machine address_kind(code:u64)->|resource_model|::AddressKind {transition code {1 -> (|resource_model|::AddressKind::IoRange) 2 -> (|resource_model|::AddressKind::BusNumber) _ -> (|resource_model|::AddressKind::Memory)}}
machine decode_extended(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64)->|resource_model|::Parsed {
 let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,0,1);let count:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,body,1,1);
 transition size>=6 && flags.value&224==0 && count.value>0 && count.value<=255 && body<=4096 {true -> extent(input,e,body,end,size,flags.value,count.value) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 state extent(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64,flags:u64,count:u64) {
  transition count<=255 && body<=4096 {true -> array(input,e,body,end,size,flags,count,2+count*4) _ -> (|resource_model|::Parsed{})}
 }
 state array(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,size:u64,flags:u64,count:u64,core:u64) {
  transition size>=core && core<=1022 && body<=4096 {true -> ready(input,e,body,end,flags,count,core) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state ready(input:&[u8;4096],e:|resource_model|::Envelope,body:u64,end:u64,flags:u64,count:u64,core:u64) {
  let source:|resource_model|::SourceResult=|resource_bytes|::optional_source(input,end,body+core);let trigger:|resource_model|::Trigger=interrupt_trigger(flags&2!=0);let polarity:|resource_model|::Polarity=interrupt_polarity(flags&4!=0);
  transition source.outcome==|resource_model|::Outcome::Success {
   true -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::IrqResource{irq:|resource_model|::Irq{extended:true,is_consumer:flags&1!=0,trigger:trigger,polarity:polarity,shared:flags&8!=0,wake:flags&16!=0,flags:((flags & 255) as u8),interrupts:|resource_model|::Interrupts::Table{entries:|resource_model|::Span{start:body+2,end:body+core},count:count},source:source.source}}})
   _ -> (|resource_model|::Parsed{outcome:source.outcome})
  }
 }
}
