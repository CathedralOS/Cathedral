// Modified acpi resource.rs, pin 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5.
// Upstream copyright 2018 Isaac Woods; bounded Cathedral adaptation 2026.
// ACPI 6.6 Tables 6.54–6.56; spans are initialized bytes, never IO authority.
use resource_model.omg;
use resource_bytes.omg;
// Public entry independently validates the envelope; forged offsets cannot enter.
pub machine parse_connection(input:&[u8;4096],length:u64,at:u64)->|resource_model|::Parsed {
 let e:|resource_model|::Envelope=|resource_bytes|::envelope(input,length,at);
 transition e.outcome==|resource_model|::Outcome::Success {true -> connection_kind(input,e) _ -> (|resource_model|::Parsed{outcome:e.outcome})}
 state connection_kind(input:&[u8;4096],e:|resource_model|::Envelope) {
  transition e.large {true -> dispatch(input,e) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state dispatch(input:&[u8;4096],e:|resource_model|::Envelope) {
  transition e.tag {12 -> gpio(input,e) 14 -> serial(input,e) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state gpio(input:&[u8;4096],e:|resource_model|::Envelope) {let r:|resource_model|::Parsed=decode_gpio_connection(input,e,e.start,e.end,e.length);r}
 state serial(input:&[u8;4096],e:|resource_model|::Envelope) {let r:|resource_model|::Parsed=decode_serial_connection(input,e,e.start,e.end,e.length);r}
}
data GpioHeader [copy] {kind:u64;general:u64;flags:u64;pin_config:u64;drive:u64;debounce:u64;pin_offset:u64;source_offset:u64;vendor_offset:u64;vendor_length:u64;}
machine decode_gpio_connection(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,size:u64)->|resource_model|::Parsed {
 transition size>=20 && start<=end && end<=4096 {true -> header(input,e,start,end) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 state header(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64) {
  let rev:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,3,1);let kind:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,4,1);
  let general:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,5,2);let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,7,2);
  let config:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,9,1);let drive:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,10,2);let debounce:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,12,2);
  let pins:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,14,2);let index:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,16,1);let source:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,17,2);
  let vendor:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,19,2);let length:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,21,2);
  let h:GpioHeader=GpioHeader{kind:kind.value,general:general.value,flags:flags.value,pin_config:config.value,drive:drive.value,debounce:debounce.value,pin_offset:pins.value,source_offset:source.value,vendor_offset:vendor.value,vendor_length:length.value};
  transition rev.value==1 && index.value==0 && general.value&65534==0 && kind.value<=1 {true -> flags(input,e,start,end,h) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state flags(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,h:GpioHeader) {
  let flags:u64=h.flags;
  transition {h.kind==0 && flags&65504==0 && (flags>>1)&3!=3 && ((flags>>1)&3!=2 || flags&1!=0) -> offsets(input,e,start,end,h,h.pin_offset,h.source_offset,h.vendor_offset,h.vendor_length)
   h.kind==1 && flags&65524==0 -> offsets(input,e,start,end,h,h.pin_offset,h.source_offset,h.vendor_offset,h.vendor_length)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state offsets(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,h:GpioHeader,pins:u64,source:u64,vendor:u64,length:u64) {
  transition start<=end && end<=4096 && pins>=23 && pins<source && source<vendor && vendor<=end-start {
   true -> extents(input,e,start,end,h,pins,source,vendor,length)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state extents(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,h:GpioHeader,pins:u64,source:u64,vendor:u64,length:u64) {
  transition (source-pins)&1==0 && length==end-start-vendor {true -> source_name(input,e,start,h,pins,source,vendor) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state source_name(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,h:GpioHeader,pins:u64,source:u64,vendor:u64) {
  transition start<=4096 && vendor<=4096 && source<=4096 && pins<=4096 {true -> source_bytes(input,e,start,h,pins,source,vendor) _ -> (|resource_model|::Parsed{})}
 }
 state source_bytes(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,h:GpioHeader,pins:u64,source:u64,vendor:u64) {
  let name:|resource_model|::SourceResult=|resource_bytes|::controller_source(input,start+source,start+vendor,0);
  transition name.outcome==|resource_model|::Outcome::Success {true -> configuration(e,start,h,pins,source,vendor,name) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state configuration(e:|resource_model|::Envelope,start:u64,h:GpioHeader,pins:u64,source:u64,vendor:u64,name:|resource_model|::SourceResult) {
  transition {h.pin_config<=3 -> ready(e,start,h,pins,source,vendor,name)
   h.pin_config>=128 -> unsupported(e)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state unsupported(e:|resource_model|::Envelope) {|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::Unsupported{large:true,tag:e.tag,encoding:|resource_model|::Span{start:e.start,end:e.end}}}}
 state ready(e:|resource_model|::Envelope,start:u64,h:GpioHeader,pins:u64,source:u64,vendor:u64,name:|resource_model|::SourceResult) {
  let config:|resource_model|::PinConfiguration=gpio_pin_configuration(h.pin_config);let connection:|resource_model|::GpioConnection=gpio_connection_kind(h.kind,h.flags);
  |resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::GpioResource{gpio:|resource_model|::Gpio{is_consumer:h.general&1!=0,shared:h.flags&8!=0,pin_configuration:config,drive_strength:((h.drive&65535)as u16),debounce_timeout:((h.debounce&65535)as u16),pins:|resource_model|::Span{start:start+pins,end:start+source},pin_count:(source-pins)/2,source:name.source,vendor:|resource_model|::Span{start:start+vendor,end:e.end},connection:connection,general_flags:((h.general&65535)as u16),connection_flags:((h.flags&65535)as u16)}}}
 }
}
machine gpio_pin_configuration(value:u64)->|resource_model|::PinConfiguration {transition value {1 -> (|resource_model|::PinConfiguration::PullUp) 2 -> (|resource_model|::PinConfiguration::PullDown) 3 -> (|resource_model|::PinConfiguration::NoPull) _ -> (|resource_model|::PinConfiguration::Default)}}
machine gpio_connection_kind(kind:u64,flags:u64)->|resource_model|::GpioConnection {
 transition kind==0 {true -> interrupt(flags) _ -> io(flags)}
 state interrupt(flags:u64) {let trigger:|resource_model|::Trigger=gpio_trigger(flags&1!=0);let polarity:|resource_model|::GpioPolarity=gpio_polarity((flags>>1)&3);|resource_model|::GpioConnection::Interrupt{trigger:trigger,polarity:polarity,wake:flags&16!=0}}
 state io(flags:u64) {let restriction:|resource_model|::IoRestriction=gpio_restriction(flags&3);|resource_model|::GpioConnection::Io{restriction:restriction}}
}
machine gpio_trigger(edge:bool)->|resource_model|::Trigger {transition edge {true -> (|resource_model|::Trigger::Edge) _ -> (|resource_model|::Trigger::Level)}}
machine gpio_polarity(value:u64)->|resource_model|::GpioPolarity {transition value {1 -> (|resource_model|::GpioPolarity::ActiveLow) 2 -> (|resource_model|::GpioPolarity::ActiveBoth) _ -> (|resource_model|::GpioPolarity::ActiveHigh)}}
machine gpio_restriction(value:u64)->|resource_model|::IoRestriction {transition value {1 -> (|resource_model|::IoRestriction::InputOnly) 2 -> (|resource_model|::IoRestriction::OutputOnly) 3 -> (|resource_model|::IoRestriction::Preserve) _ -> (|resource_model|::IoRestriction::None)}}
machine decode_serial_connection(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,size:u64)->|resource_model|::Parsed {
 transition size>=9 && start<=end && end<=4096 {true -> header(input,e,start,end,size) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 state header(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,size:u64) {
  let bus:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,5,1);
  transition {bus.value==1 -> i2c(input,e,start,end,size)
   bus.value==2 || bus.value==3 || bus.value==4 || bus.value>=192 -> unsupported(e)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state unsupported(e:|resource_model|::Envelope) {|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::Unsupported{large:true,tag:e.tag,encoding:|resource_model|::Span{start:e.start,end:e.end}}}}
 state i2c(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,size:u64) {
  transition size>=15 {true -> i2c_header(input,e,start,end) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state i2c_header(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64) {
  let rev:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,3,1);let flags:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,6,1);let mode:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,7,1);
  let type_rev:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,9,1);let type_length:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,10,2);let address:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,16,2);
  transition rev.value==2 && flags.value&248==0 && mode.value&254==0 && type_rev.value==1 && ((mode.value==0 && address.value<=127) || (mode.value==1 && address.value<=1023)) {
   true -> extent(input,e,start,end,flags.value,mode.value,type_length.value,address.value)
   _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state extent(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,flags:u64,mode:u64,length:u64,address:u64) {
  transition start<=end && end<=4096 && end-start>=18 {true -> data_extent(input,e,start,end,flags,mode,length,address) _ -> (|resource_model|::Parsed{})}
 }
 state data_extent(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,flags:u64,mode:u64,length:u64,address:u64) {
  transition length>=6 && length<end-start-12 {true -> source_name(input,e,start,end,flags,mode,length,address) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
 state source_name(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,flags:u64,mode:u64,length:u64,address:u64) {
  transition start<=4096 && length<=4096 {true -> source_bytes(input,e,start,end,flags,mode,length,address) _ -> (|resource_model|::Parsed{})}
 }
 state source_bytes(input:&[u8;4096],e:|resource_model|::Envelope,start:u64,end:u64,flags:u64,mode:u64,length:u64,address:u64) {
  let index:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,4,1);let source:|resource_model|::SourceResult=|resource_bytes|::controller_source(input,start+12+length,end,((index.value&255)as u8));
  let speed:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,12,4);let lvr:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,8,1);let addressing:|resource_model|::AddressingMode=i2c_addressing_mode(mode);
  transition source.outcome==|resource_model|::Outcome::Success {true -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::Success,encoding:|resource_model|::Span{start:e.start,end:e.end},next:e.end,resource:|resource_model|::Resource::I2cResource{i2c:|resource_model|::I2c{is_consumer:flags&2!=0,shared:flags&4!=0,device_initiated:flags&1!=0,addressing:addressing,speed:((speed.value&4294967295)as u32),address:((address&65535)as u16),legacy_virtual_register:((lvr.value&255)as u8),source:source.source,vendor:|resource_model|::Span{start:start+18,end:start+12+length},general_flags:((flags&255)as u8)}}}) _ -> (|resource_model|::Parsed{outcome:|resource_model|::Outcome::BadEncoding})}
 }
}
machine i2c_addressing_mode(value:u64)->|resource_model|::AddressingMode {transition value==1 {true -> (|resource_model|::AddressingMode::Bits10) _ -> (|resource_model|::AddressingMode::Bits7)}}
// Raw pin numbers include 0xffff (ACPI No Pin). The caller owns interpretation.
pub machine pin_at(input:&[u8;4096],length:u64,pins:|resource_model|::Span,index:u64)->|resource_model|::NumberResult {
 let start:u64=pins.start;let end:u64=pins.end;
 transition length<=4096 && start<=end && end<=length {true -> extent(input,length,start,end,index) _ -> (|resource_model|::NumberResult{})}
 state extent(input:&[u8;4096],length:u64,start:u64,end:u64,index:u64) {
  transition (end-start)&1==0 && index<(end-start)/2 {true -> fetch(input,end,start,index) _ -> (|resource_model|::NumberResult{})}
 }
 state fetch(input:&[u8;4096],end:u64,start:u64,index:u64) {
  transition index<2048 {true -> bounded(input,end,start,index) _ -> (|resource_model|::NumberResult{})}
 }
 state bounded(input:&[u8;4096],end:u64,start:u64,index:u64) {let r:|resource_model|::NumberResult=|resource_bytes|::relative(input,end,start,index*2,2);r}
}
