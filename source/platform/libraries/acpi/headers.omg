// Modified representation of acpi src/rsdp.rs and src/sdt/mod.rs at
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. See headers.PORT.md.
// Numeric physical addresses are inert data. These are decoded values, not ABI overlays.
module headers;
pub const RSDP_V1_LENGTH: u64 = 20;
pub const RSDP_EXT_LENGTH: u64 = 36;
pub const SDT_HEADER_LENGTH: u64 = 36;
pub const INPUT_CAPACITY: u64 = 4096;
pub data Signature [copy] { raw: u32; }
pub data Rsdp [copy] {
    signature: [u8; 8]; checksum: u8; oem_id: [u8; 6]; revision: u8;
    rsdt_address: u32; length: u32; xsdt_address: u64; ext_checksum: u8; reserved: [u8; 3];
}
pub data SdtHeader [copy] {
    signature: Signature; length: u32; revision: u8; checksum: u8;
    oem_id: [u8; 6]; oem_table_id: [u8; 8]; oem_revision: u32;
    creator_id: u32; creator_revision: u32;
}
pub data RsdpResult [copy] { error: u8; value: Rsdp; }
pub data SdtResult [copy] { error: u8; value: SdtHeader; }
pub data RootResult [copy] { error: u8; header: SdtHeader; entry_size: u8; entry_count: u64; }
pub data EntryResult [copy] { error: u8; address: u64; }
pub data ChecksumResult [copy] { error: u8; sum: u8; }
pub data RootPointer [copy] { available: bool; address: u64; entry_size: u8; }
// All parsers return initialized records. error0 alone means success.
pub const ERROR_OK: u8 = 0;
pub const ERROR_INPUT_CAPACITY: u8 = 1;
pub const ERROR_TRUNCATED: u8 = 2;
pub const ERROR_SIGNATURE: u8 = 3;
pub const ERROR_REVISION: u8 = 4;
pub const ERROR_LENGTH: u8 = 5;
pub const ERROR_CHECKSUM: u8 = 6;
pub const ERROR_ENTRY_REMAINDER: u8 = 9;
pub const ERROR_ENTRY_INDEX: u8 = 10;
