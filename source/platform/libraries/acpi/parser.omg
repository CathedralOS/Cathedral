// Modified acpi validation/discovery logic; primary ACPI6.6 length/checksum checks
// replace unchecked casts and the pin's lenient checksum policy. See headers.PORT.md.
use headers.omg;
use bytes.omg;

pub machine parse_rsdp(input: &[u8; 4096], length: u64) -> |headers|::RsdpResult {
    transition { length > 4096 -> (|headers|::RsdpResult { error: 1 })
        length < 20 -> (|headers|::RsdpResult { error: 2 }) _ -> signature(input, length) }
    state signature(input: &[u8; 4096], length: u64) -> |headers|::RsdpResult {
        transition input[0] == 82 && input[1] == 83 && input[2] == 68 && input[3] == 32 &&
                   input[4] == 80 && input[5] == 84 && input[6] == 82 && input[7] == 32 {
            true -> common(input, length) _ -> (|headers|::RsdpResult { error: 3 })
        }
    }
    state common(input: &[u8; 4096], length: u64) -> |headers|::RsdpResult {
        let base: |headers|::Rsdp = |headers|::Rsdp { signature: [82, 83, 68, 32, 80, 84, 82, 32], checksum: input[8],
            oem_id: [input[9], input[10], input[11], input[12], input[13], input[14]],
            revision: input[15], rsdt_address: |bytes|::le32(input, 16), length: 20 };
        let check: |headers|::ChecksumResult = |bytes|::checksum(input, 20);
        transition { check.error != 0 || check.sum != 0 -> (|headers|::RsdpResult { error: 6 })
            _ -> version(input, length, base) }
    }
    state version(input: &[u8; 4096], length: u64, base: |headers|::Rsdp) -> |headers|::RsdpResult {
        transition base.revision {
            0 -> (|headers|::RsdpResult { value: base })
            2 -> extended(input, length, base)
            _ -> (|headers|::RsdpResult { error: 4 })
        }
    }
    state extended(input: &[u8; 4096], length: u64, base: |headers|::Rsdp) -> |headers|::RsdpResult {
        transition length >= 36 { true -> extent(input, length, base) _ -> (|headers|::RsdpResult { error: 2 }) }
    }
    state extent(input: &[u8; 4096], length: u64, base: |headers|::Rsdp) -> |headers|::RsdpResult {
        let declared: u32 = |bytes|::le32(input, 20);
        let exceeds: bool = (declared as u64) > length;
        transition { declared < 36 -> (|headers|::RsdpResult { error: 5 })
            exceeds -> (|headers|::RsdpResult { error: 2 })
            _ -> validate_extended(input, declared, base) }
    }
    state validate_extended(input: &[u8; 4096], declared: u32, base: |headers|::Rsdp) -> |headers|::RsdpResult {
        let check: |headers|::ChecksumResult = |bytes|::checksum(input, declared as u64);
        let xsdt_address: u64 = |bytes|::le64(input, 24);
        transition { check.error != 0 || check.sum != 0 -> (|headers|::RsdpResult { error: 6 })
            _ -> (|headers|::RsdpResult { value: |headers|::Rsdp { signature: base.signature, checksum: base.checksum,
                oem_id: base.oem_id, revision: base.revision, rsdt_address: base.rsdt_address,
                length: declared, xsdt_address: xsdt_address, ext_checksum: input[32],
                reserved: [input[33], input[34], input[35]] } }) }
    }
}

pub machine parse_sdt(input: &[u8; 4096], length: u64, expected: |headers|::Signature) -> |headers|::SdtResult {
    transition { length > 4096 -> (|headers|::SdtResult { error: 1 })
        length < 36 -> (|headers|::SdtResult { error: 2 }) _ -> decode(input, length, expected) }
    state decode(input: &[u8; 4096], length: u64, expected: |headers|::Signature) -> |headers|::SdtResult {
        let value: |headers|::SdtHeader = |headers|::SdtHeader { signature: |headers|::Signature { raw: |bytes|::le32(input, 0) },
            length: |bytes|::le32(input, 4), revision: input[8], checksum: input[9],
            oem_id: [input[10], input[11], input[12], input[13], input[14], input[15]],
            oem_table_id: [input[16], input[17], input[18], input[19], input[20], input[21], input[22], input[23]],
            oem_revision: |bytes|::le32(input, 24), creator_id: |bytes|::le32(input, 28), creator_revision: |bytes|::le32(input, 32) };
        transition { value.signature.raw != expected.raw -> (|headers|::SdtResult { error: 3 })
            value.length < 36 -> (|headers|::SdtResult { error: 5 }) _ -> bounds(input, length, value) }
    }
    state bounds(input: &[u8; 4096], length: u64, value: |headers|::SdtHeader) -> |headers|::SdtResult {
        transition (value.length as u64) <= length { true -> validate(input, value) _ -> (|headers|::SdtResult { error: 2 }) }
    }
    state validate(input: &[u8; 4096], value: |headers|::SdtHeader) -> |headers|::SdtResult {
        let check: |headers|::ChecksumResult = |bytes|::checksum(input, value.length as u64);
        transition { check.error != 0 || check.sum != 0 -> (|headers|::SdtResult { error: 6 }) _ -> (|headers|::SdtResult { value: value }) }
    }
}
pub machine root_signature(xsdt: bool) -> |headers|::Signature {
    transition xsdt { true -> (|headers|::SIGNATURE_XSDT) _ -> (|headers|::SIGNATURE_RSDT) }
}
pub machine parse_root(input: &[u8; 4096], length: u64, xsdt: bool) -> |headers|::RootResult {
    let expected: |headers|::Signature = root_signature(xsdt);
    let parsed: |headers|::SdtResult = parse_sdt(input, length, expected);
    transition parsed.error == 0 { true -> shape(parsed.value, xsdt) _ -> (|headers|::RootResult { error: parsed.error }) }
    state shape(header: |headers|::SdtHeader, xsdt: bool) -> |headers|::RootResult {
        transition { header.revision != 1 -> (|headers|::RootResult { error: 4 })
            header.length < 36 -> (|headers|::RootResult { error: 5 }) _ -> entries(header, xsdt) }
    }
    state entries(header: |headers|::SdtHeader, xsdt: bool) -> |headers|::RootResult {
        let payload: u32 = header.length - 36;
        transition xsdt { true -> xsdt_entries(header, payload) _ -> rsdt_entries(header, payload) }
    }
    state xsdt_entries(header: |headers|::SdtHeader, payload: u32) -> |headers|::RootResult {
        transition (payload % 8) == 0 {
            true -> (|headers|::RootResult { header: header, entry_size: 8, entry_count: (payload / 8) as u64 })
            _ -> (|headers|::RootResult { error: 9 }) }
    }
    state rsdt_entries(header: |headers|::SdtHeader, payload: u32) -> |headers|::RootResult {
        transition (payload % 4) == 0 {
            true -> (|headers|::RootResult { header: header, entry_size: 4, entry_count: (payload / 4) as u64 })
            _ -> (|headers|::RootResult { error: 9 }) }
    }
}
// This accessor validates the source again. A caller-constructed result record
// cannot authorize out-of-range reads; decoded physical addresses remain numbers.
pub machine root_entry(input: &[u8; 4096], length: u64, xsdt: bool, index: u64) -> |headers|::EntryResult {
    let parsed: |headers|::RootResult = parse_root(input, length, xsdt);
    transition parsed.error == 0 { true -> bounds(input, parsed, xsdt, index) _ -> (|headers|::EntryResult { error: parsed.error }) }
    state bounds(input: &[u8; 4096], parsed: |headers|::RootResult, xsdt: bool, index: u64) -> |headers|::EntryResult {
        transition index < parsed.entry_count { true -> width(input, xsdt, index) _ -> (|headers|::EntryResult { error: 10 }) }
    }
    state width(input: &[u8; 4096], xsdt: bool, index: u64) -> |headers|::EntryResult {
        transition xsdt { true -> wide(input, index) _ -> narrow(input, index) }
    }
    state wide(input: &[u8; 4096], index: u64) -> |headers|::EntryResult {
        transition index <= 506 { true -> read_wide(input, index) _ -> (|headers|::EntryResult { error: 10 }) }
    }
    state read_wide(input: &[u8; 4096], index: u64) -> |headers|::EntryResult {
        let offset: u64 = 36 + index * 8;
        transition offset <= 4088 { true -> finish_wide(input, offset) _ -> (|headers|::EntryResult { error: 10 }) }
    }
    state finish_wide(input: &[u8; 4096], offset: u64) -> |headers|::EntryResult {
        let address: u64 = |bytes|::le64(input, offset);
        |headers|::EntryResult { address: address }
    }
    state narrow(input: &[u8; 4096], index: u64) -> |headers|::EntryResult {
        transition index <= 1014 { true -> read_narrow(input, index) _ -> (|headers|::EntryResult { error: 10 }) }
    }
    state read_narrow(input: &[u8; 4096], index: u64) -> |headers|::EntryResult {
        let offset: u64 = 36 + index * 4;
        transition offset <= 4092 { true -> finish_narrow(input, offset) _ -> (|headers|::EntryResult { error: 10 }) }
    }
    state finish_narrow(input: &[u8; 4096], offset: u64) -> |headers|::EntryResult {
        let address: u32 = |bytes|::le32(input, offset);
        |headers|::EntryResult { address: address as u64 }
    }
}
pub machine select_root(parsed: |headers|::RsdpResult, ignore_xsdt: bool) -> |headers|::RootPointer {
    transition parsed.error == 0 { true -> choose(parsed.value, ignore_xsdt) _ -> (|headers|::RootPointer {}) }
    state choose(value: |headers|::Rsdp, ignore_xsdt: bool) -> |headers|::RootPointer {
        transition value.revision == 2 && value.xsdt_address != 0 && !ignore_xsdt {
            true -> (|headers|::RootPointer { available: true, address: value.xsdt_address, entry_size: 8 })
            _ -> (|headers|::RootPointer { available: value.rsdt_address != 0, address: value.rsdt_address as u64, entry_size: 4 })
        }
    }
}
