// ACPI 6.6 sections 19.6.7 and 19.6.64. Detached bounded sequencing only.
use {omega}/language/core/nat.omg;
use {access}/geometry.omg;
use {access}/chunks.omg;
use {access}/model.omg;
use {aml}/field_model.omg;
use {integers}/integers.omg;
use model.omg as model_file;
data Builder [copy] {failed:bool;recipe:|model_file|::Recipe;}

pub machine plan(request:&|model_file|::Request)->|model_file|::ProtocolResult {
 transition request.kind {
  |field_model|::DeclarationKind::Bank -> outer(request,request.region_bytes)
  |field_model|::DeclarationKind::Index -> outer(request,18446744073709551615)
  _ -> (|model_file|::ProtocolResult::Failure {component:|model_file|::Component::Field,error:|model|::Error::UnsupportedKind})
 }
 state outer(request:&|model_file|::Request,region:u64)->|model_file|::ProtocolResult {
  let result:|model|::PlanResult=|geometry|::plan(|field_model|::DeclarationKind::Field,&request.field,region,request.size);
  transition result {
   |model|::PlanResult::Ready {plan} -> selector(request,plan)
   |model|::PlanResult::Failure {error} -> (|model_file|::ProtocolResult::Failure {component:|model_file|::Component::Field,error:error})
  }
 }
 state selector(request:&|model_file|::Request,outer:|model|::Plan)->|model_file|::ProtocolResult {
  let result:|model|::PlanResult=|geometry|::plan(request.selector.kind,&request.selector.field,request.selector.region_bytes,request.size);
  transition result {
   |model|::PlanResult::Ready {plan} -> data(request,outer,plan)
   |model|::PlanResult::Failure {error} -> (|model_file|::ProtocolResult::Failure {component:|model_file|::Component::Selector,error:error})
  }
 }
 state data(request:&|model_file|::Request,outer:|model|::Plan,selector:|model|::Plan)->|model_file|::ProtocolResult {
  transition request.kind {
   |field_model|::DeclarationKind::Index -> data_geometry(request,outer,selector)
   _ -> selected(request,outer,selector,|model|::Plan {})
  }
 }
 state data_geometry(request:&|model_file|::Request,outer:|model|::Plan,selector:|model|::Plan)->|model_file|::ProtocolResult {
  let result:|model|::PlanResult=|geometry|::plan(request.data.kind,&request.data.field,request.data.region_bytes,request.size);
  transition result {
   |model|::PlanResult::Ready {plan} -> selected(request,outer,selector,plan)
   |model|::PlanResult::Failure {error} -> (|model_file|::ProtocolResult::Failure {component:|model_file|::Component::Data,error:error})
  }
 }
 state selected(request:&|model_file|::Request,outer:|model|::Plan,selector:|model|::Plan,data:|model|::Plan)->|model_file|::ProtocolResult {
  let bank:u64=bank_value(request);
  transition request.kind {
   |field_model|::DeclarationKind::Bank -> fits(request,outer,selector,data,bank,bank)
   _ -> last(request,outer,selector,data,bank,outer.count)
  }
 }
 state last(request:&|model_file|::Request,outer:|model|::Plan,selector:|model|::Plan,data:|model|::Plan,bank:u64,count:u64)->|model_file|::ProtocolResult {
  transition count>0 && count<=257 {
   true -> last_at(request,outer,selector,data,bank,count-1)
   _ -> (|model_file|::ProtocolResult::Failure {component:|model_file|::Component::Field,error:|model|::Error::InvalidChunk})
  }
 }
 state last_at(request:&|model_file|::Request,outer:|model|::Plan,selector:|model|::Plan,data:|model|::Plan,bank:u64,index:u64)->|model_file|::ProtocolResult {
  transition index<257 {
   true -> fits(request,outer,selector,data,bank,outer.chunks[index].offset)
   _ -> (|model_file|::ProtocolResult::Failure {component:|model_file|::Component::Field,error:|model|::Error::InvalidChunk})
  }
 }
 state fits(request:&|model_file|::Request,outer:|model|::Plan,selector:|model|::Plan,data:|model|::Plan,bank:u64,maximum:u64)->|model_file|::ProtocolResult {
  let fits:bool=selector_fits(selector.bit_length,maximum);
  transition fits {
   true -> initialize(request,outer,selector,data,bank)
   _ -> (|model_file|::ProtocolResult::SelectorOverflow)
  }
 }
 state initialize(request:&|model_file|::Request,outer:|model|::Plan,selector:|model|::Plan,data:|model|::Plan,bank:u64)->|model_file|::ProtocolResult {
  let lock:|model|::LockRequirement=combined_lock(outer.lock,selector.lock,data.lock);
  let initial:Builder=Builder {recipe:|model_file|::Recipe {kind:request.kind,direction:request.direction,outer:outer,selector:selector,data:data,bank_value:bank,lock:lock}};
  let built:Builder=sequence(initial,0,outer.count);
  transition built.failed {
   true -> (|model_file|::ProtocolResult::Failure {component:|model_file|::Component::Field,error:|model|::Error::Capacity})
   _ -> (|model_file|::ProtocolResult::Ready {recipe:built.recipe})
  }
 }
}

machine bank_value(request:&|model_file|::Request)->u64 {
 transition request.kind {
  |field_model|::DeclarationKind::Bank -> normalized(request)
  _ -> (0)
 }
 state normalized(request:&|model_file|::Request)->u64 {let value:u64=|integers|::normalize(request.size,request.bank_value);value}
}
machine selector_fits(bits:u64,value:u64)->bool {
 transition bits>=64 {true -> (true) _ -> small(bits,value)}
 state small(bits:u64,value:u64)->bool {let mask:u64=|chunks|::low_mask(bits);value<=mask}
}
machine combined_lock(a:|model|::LockRequirement,b:|model|::LockRequirement,c:|model|::LockRequirement)->|model|::LockRequirement {
 transition a==|model|::LockRequirement::UnmetGlobalLock || b==|model|::LockRequirement::UnmetGlobalLock || c==|model|::LockRequirement::UnmetGlobalLock {
  true -> (|model|::LockRequirement::UnmetGlobalLock) _ -> (|model|::LockRequirement::NotRequested)
 }
}
machine sequence(current:Builder,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->Builder {
 let next:Builder=step(current,index);
 transition index<count {true -> sequence(next,index+1,count) _ -> (current)}
}
machine step(current:Builder,index:u64)->Builder {
 let count:u64=current.recipe.outer.count;
 transition !current.failed && index<count && index<257 {
  true -> selected(current,index)
  _ -> (current)
 }
 state selected(current:Builder,index:u64)->Builder {
  let value:u64=selector_value(&current.recipe,index);
  let read:bool=needs_read(&current.recipe,index);
  let next:Builder=read_action(current,index,value,read);
  transition next.recipe.direction {
   |model_file|::Direction::Write -> write(next,index,value)
   _ -> (next)
  }
 }
 state write(current:Builder,index:u64,value:u64)->Builder {let next:Builder=write_action(current,index,value);next}
}
machine selector_value(recipe:&|model_file|::Recipe,index:u64)->u64 {
 transition recipe.kind {
  |field_model|::DeclarationKind::Bank -> (recipe.bank_value)
  _ -> indexed(recipe,index)
 }
 state indexed(recipe:&|model_file|::Recipe,index:u64)->u64 {
  transition index<257 {true -> (recipe.outer.chunks[index].offset) _ -> (0)}
 }
}
machine needs_read(recipe:&|model_file|::Recipe,index:u64)->bool {
 transition recipe.direction {|model_file|::Direction::Read -> (true) _ -> preserve(recipe,index)}
 state preserve(recipe:&|model_file|::Recipe,index:u64)->bool {
  transition index<257 {
   true -> (recipe.outer.update==|field_model|::UpdateRule::Preserve && recipe.outer.chunks[index].partial)
   _ -> (false)
  }
 }
}
machine read_action(current:Builder,index:u64,value:u64,read:bool)->Builder {
 transition read {true -> selected(current,index,value) _ -> (current)}
 state selected(current:Builder,index:u64,value:u64)->Builder {
  let next:Builder=append(current,|model_file|::Action::Select {value:value});
  append(next,|model_file|::Action::ReadDatum {chunk:index})
 }
}
machine write_action(current:Builder,index:u64,value:u64)->Builder {
 let next:Builder=append(current,|model_file|::Action::Select {value:value});
 append(next,|model_file|::Action::WriteDatum {chunk:index})
}
machine append(current:Builder,action:|model_file|::Action)->Builder {
 let count:u64=current.recipe.count;
 transition !current.failed && count<1028 {
  true -> store(current,action,count)
  _ -> failed(current)
 }
 state store(current:Builder,action:|model_file|::Action,count:u64)->Builder {
  transition count<1028 {true -> write(current,action,count) _ -> failed(current)}
 }
 state write(current:Builder,action:|model_file|::Action,count:u64)->Builder {
  let mut next:Builder=current;next.recipe.actions[count]=action;next.recipe.count=next_count(count);next
 }
 state failed(current:Builder)->Builder {let mut next:Builder=current;next.failed=true;next}
}

machine next_count(count:u64)->u64 {transition count<1028 {true -> (count+1) _ -> (count)}}
