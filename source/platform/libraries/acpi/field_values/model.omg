use {access}/model.omg;
use {integers}/integers.omg;
pub data ReadError [copy] {case Geometry(cause:|model|::Error);case CountMismatch;case InternalChunk;}
// Numeric data only. An unmet lock requirement is never a held-lock receipt.
pub data ReadResult [copy] {
 case Failure(error:ReadError);
 case Integer(value:u64,size:|integers|::IntegerSize,lock:|model|::LockRequirement);
 case Buffer(length:u64,bytes:[u8;256],lock:|model|::LockRequirement);
}
