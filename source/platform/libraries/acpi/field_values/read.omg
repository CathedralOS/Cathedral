// Partial pure do_field_read assembly from rust-osdev/acpi
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5; copyright 2018 Isaac Woods.
// No region access, lock acquisition, evaluator integration or object installation.
use {omega}/language/core/nat.omg;
use {access}/geometry.omg;
use {access}/chunks.omg;
use {access}/model.omg;
use {aml}/field_model.omg;
use {integers}/integers.omg;
use {integers}/conversions.omg;
use {integers}/buffer_fields.omg;
use model.omg as model_file;
data Bytes [copy] {bytes:[u8;256];}
pub machine assemble(kind:|field_model|::DeclarationKind,field:&|field_model|::Field,region_bytes:u64,size:|integers|::IntegerSize,words:&[u64;257],supplied_count:u64)->|model_file|::ReadResult {
 let geometry:|model|::PlanResult=|geometry|::plan(kind,field,region_bytes,size);
 transition geometry {
  |model|::PlanResult::Failure {error} -> (|model_file|::ReadResult::Failure {error:|model_file|::ReadError::Geometry {cause:error}})
  |model|::PlanResult::Ready {plan} -> count(&plan,words,supplied_count)
 }
 state count(plan:&|model|::Plan,words:&[u64;257],supplied_count:u64)->|model_file|::ReadResult {
  let expected:u64=plan.count;
  transition supplied_count<=257 && supplied_count==expected {true -> fill(plan,words,supplied_count) _ -> (|model_file|::ReadResult::Failure {error:|model_file|::ReadError::CountMismatch})}
 }
 state fill(plan:&|model|::Plan,words:&[u64;257],count:u64)->|model_file|::ReadResult {
  let mut output:Bytes=Bytes {};
  let complete:bool=fill_chunks(plan,words,&mut output.bytes,0,count,true);
  transition complete {true -> shape(plan,output) _ -> (|model_file|::ReadResult::Failure {error:|model_file|::ReadError::InternalChunk})}
 }
 state shape(plan:&|model|::Plan,output:Bytes)->|model_file|::ReadResult {
  transition plan.shape {
   |model|::ReadShape::Integer {size} -> integer(plan,&output.bytes,size)
   |model|::ReadShape::Buffer {bytes} -> buffer(plan,output,bytes)
  }
 }
 state integer(plan:&|model|::Plan,bytes:&[u8;256],size:|integers|::IntegerSize)->|model_file|::ReadResult {
  let value:|integers|::IntegerResult=|buffer_fields|::field_to_integer(size,bytes,256,0,plan.bit_length);
  transition value.error==0 {true -> (|model_file|::ReadResult::Integer {value:value.value,size:size,lock:plan.lock}) _ -> (|model_file|::ReadResult::Failure {error:|model_file|::ReadError::InternalChunk})}
 }
 state buffer(plan:&|model|::Plan,output:Bytes,length:u64)->|model_file|::ReadResult {
  transition length<=256 {true -> (|model_file|::ReadResult::Buffer {length:length,bytes:output.bytes,lock:plan.lock}) _ -> (|model_file|::ReadResult::Failure {error:|model_file|::ReadError::InternalChunk})}
 }

}
machine fill_chunks(plan:&|model|::Plan,words:&[u64;257],output:&mut [u8;256],index:u64,count:u64,prior:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {
 let complete:bool=fill_if(plan,words,output,index,count);
 transition index<count {true -> fill_chunks(plan,words,output,index+1,count,prior && complete) _ -> (prior)}
}
machine fill_if(plan:&|model|::Plan,words:&[u64;257],output:&mut [u8;256],index:u64,count:u64)->bool {
 transition index<count {true -> step(plan,words,output,index) _ -> (true)}
 state step(plan:&|model|::Plan,words:&[u64;257],output:&mut [u8;256],index:u64)->bool {let copied:bool=fill_chunk(plan,words,output,index);copied}
}
machine fill_chunk(plan:&|model|::Plan,words:&[u64;257],output:&mut [u8;256],index:u64)->bool {
 transition index<257 {true -> extract(plan.chunks[index],words[index],output) _ -> (false)}
 state extract(chunk:|model|::Chunk,raw:u64,output:&mut [u8;256])->bool {
  let extracted:|model|::WordResult=|chunks|::extract(chunk,raw);
  transition extracted {|model|::WordResult::Word {value} -> encoded(chunk,value,output) _ -> (false)}
 }
 state encoded(chunk:|model|::Chunk,value:u64,output:&mut [u8;256])->bool {
  let mut input:Bytes=Bytes {};let encoded:|integers|::IntegerResult=|conversions|::integer_to_buffer(|integers|::IntegerSize::EightBytes,value,&mut input.bytes);
  let copied:u8=|buffer_fields|::copy_bits(&input.bytes,8,0,output,256,chunk.field_bit,chunk.bit_count);
  encoded.error==0 && copied==0
 }
}
