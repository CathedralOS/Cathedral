// SPDX-License-Identifier: MIT OR Apache-2.0
// Modified pure _PRT decode/selection from rust-osdev/acpi
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5; copyright 2018 Isaac Woods.
// Strict ACPI6.6: four members, DWORD widths, functionFFFF, NameReference/Zero.
use {omega}/language/core/nat.omg;
use {aml}/model.omg;
use {aml}/names.omg;
use {aml}/namespace.omg;
use {aml}/object_references.omg;
use model.omg as model_file;
data RowRead [copy] {outcome:|model|::Outcome;fault:|model_file|::Fault;route:|model_file|::Route;}

// The caller supplies an already-evaluated package ID. No evaluation occurs.
pub machine decode(store:&|model|::ObjectStore,object:u64,budget:u64)->|model_file|::Decode {
 let count:u64=store.space.object_count;let entries:u64=store.space.count;
 transition count<=64 && entries<=32 && object<count && object<64 && budget<=64 {
  true -> payload(store,object,budget,store.space.objects[object].value)
  _ -> (|model_file|::Decode {outcome:|model|::Outcome::InvalidState,fault:|model_file|::Fault::Package})
 }
 state payload(store:&|model|::ObjectStore,object:u64,budget:u64,value:|model|::Value)->|model_file|::Decode {
  transition value {|model|::Value::Package {first,count} -> count(store,object,budget,count) _ -> (|model_file|::Decode {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Package})}
 }
 state count(store:&|model|::ObjectStore,object:u64,budget:u64,count:u64)->|model_file|::Decode {
  transition {count>32 -> (|model_file|::Decode {outcome:|model|::Outcome::Capacity,fault:|model_file|::Fault::Table})
   budget<count -> (|model_file|::Decode {outcome:|model|::Outcome::WorkLimit,fault:|model_file|::Fault::Package})
   count==0 -> (|model_file|::Decode {})
   _ -> rows(store,object,budget,count)}
 }
 state rows(store:&|model|::ObjectStore,object:u64,budget:u64,count:u64)->|model_file|::Decode {
  let initial:|model_file|::Decode=|model_file|::Decode {};let result:|model_file|::Decode=pr_rows(store,object,budget,initial,0,count);
  transition result.outcome==|model|::Outcome::Success {true -> (result) _ -> (|model_file|::Decode {outcome:result.outcome,fault:result.fault,row:result.row})}
 }
}
machine pr_rows(store:&|model|::ObjectStore,package:u64,budget:u64,prior:|model_file|::Decode,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->|model_file|::Decode {
 let next:|model_file|::Decode=pr_row_step(store,package,budget,prior,index,count);
 transition index<count {true -> pr_rows(store,package,budget,next,index+1,count) _ -> (prior)}
}
machine pr_row_step(store:&|model|::ObjectStore,package:u64,budget:u64,prior:|model_file|::Decode,index:u64,count:u64)->|model_file|::Decode {
 transition index<count && index<32 && prior.outcome==|model|::Outcome::Success {true -> member(store,package,budget,prior,index) _ -> (prior)}
 state member(store:&|model|::ObjectStore,package:u64,budget:u64,prior:|model_file|::Decode,index:u64)->|model_file|::Decode {
  let found:|model|::ReferenceState=|object_references|::package_element(&store.space,package,index,budget);
  transition found.outcome==|model|::Outcome::Success {true -> parsed(store,found.object,budget,prior,index) _ -> (|model_file|::Decode {outcome:found.outcome,fault:|model_file|::Fault::Package,row:index})}
 }
 state parsed(store:&|model|::ObjectStore,object:u64,budget:u64,prior:|model_file|::Decode,index:u64)->|model_file|::Decode {
  let row:RowRead=pr_parse_row(store,object,budget);
  transition row.outcome==|model|::Outcome::Success {true -> insert(prior,index,row) _ -> (|model_file|::Decode {outcome:row.outcome,fault:row.fault,row:index})}
 }
 state insert(prior:|model_file|::Decode,index:u64,row:RowRead)->|model_file|::Decode {
  transition index<32 {true -> write(prior,index,row) _ -> (|model_file|::Decode {outcome:|model|::Outcome::Capacity,fault:|model_file|::Fault::Table,row:index})}
 }
 state write(prior:|model_file|::Decode,index:u64,row:RowRead)->|model_file|::Decode {
  let mut result:|model_file|::Decode=prior;result.routes.entries[index]=row.route;let next:u64=pr_count(index);result.routes.count=next;result
 }
}
// Validate one row privately before adding it to the candidate table.
machine pr_parse_row(store:&|model|::ObjectStore,object:u64,budget:u64)->RowRead {
 transition object<store.space.object_count && object<64 {true -> payload(store,object,budget,store.space.objects[object].value) _ -> (RowRead {outcome:|model|::Outcome::InvalidState,fault:|model_file|::Fault::Package})}
 state payload(store:&|model|::ObjectStore,object:u64,budget:u64,value:|model|::Value)->RowRead {
  transition value {|model|::Value::Package {first,count} -> shape(store,object,budget,count) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Package})}
 }
 state shape(store:&|model|::ObjectStore,object:u64,budget:u64,count:u64)->RowRead {
  transition count==4 {true -> first(store,object,budget) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Package})}
 }
 state first(store:&|model|::ObjectStore,object:u64,budget:u64)->RowRead {
  let a:|model|::ReferenceState=|object_references|::package_element(&store.space,object,0,budget);
  let b:|model|::ReferenceState=|object_references|::package_element(&store.space,object,1,budget);
  let c:|model|::ReferenceState=|object_references|::package_element(&store.space,object,2,budget);
  let d:|model|::ReferenceState=|object_references|::package_element(&store.space,object,3,budget);
  transition {a.outcome!=|model|::Outcome::Success -> (RowRead {outcome:a.outcome,fault:|model_file|::Fault::Package})
   b.outcome!=|model|::Outcome::Success -> (RowRead {outcome:b.outcome,fault:|model_file|::Fault::Package})
   c.outcome!=|model|::Outcome::Success -> (RowRead {outcome:c.outcome,fault:|model_file|::Fault::Package})
   d.outcome!=|model|::Outcome::Success -> (RowRead {outcome:d.outcome,fault:|model_file|::Fault::Package})
   _ -> bounded(store,a.object,b.object,c.object,d.object,budget)}
 }
 state bounded(store:&|model|::ObjectStore,a:u64,b:u64,c:u64,d:u64,budget:u64)->RowRead {
  transition a<64 && b<64 && c<64 && d<64 {true -> address(store,a,b,c,d,budget) _ -> (RowRead {outcome:|model|::Outcome::InvalidState,fault:|model_file|::Fault::Package})}
 }
 state address(store:&|model|::ObjectStore,a:u64,b:u64,c:u64,d:u64,budget:u64)->RowRead {
  let field:|model|::Value=store.space.objects[a].value;
  transition field {|model|::Value::Integer {number} -> address_number(store,b,c,d,budget,number) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Address})}
 }
 state address_number(store:&|model|::ObjectStore,b:u64,c:u64,d:u64,budget:u64,address:u64)->RowRead {
  transition address<=4294967295 && address&65535==65535 {true -> pin(store,b,c,d,budget,address>>16) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Address})}
 }
 state pin(store:&|model|::ObjectStore,b:u64,c:u64,d:u64,budget:u64,device:u64)->RowRead {
  transition b<64 {true -> pin_value(store,store.space.objects[b].value,c,d,budget,device) _ -> (RowRead {outcome:|model|::Outcome::InvalidState,fault:|model_file|::Fault::Pin})}
 }
 state pin_value(store:&|model|::ObjectStore,field:|model|::Value,c:u64,d:u64,budget:u64,device:u64)->RowRead {
  transition field {|model|::Value::Integer {number} -> pin_number(store,c,d,budget,device,number) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Pin})}
 }
 state pin_number(store:&|model|::ObjectStore,c:u64,d:u64,budget:u64,device:u64,pin:u64)->RowRead {
  transition pin<4 && d<64 {true -> source_index(store,c,budget,|model_file|::Route {device:device as u16,pin:pin as u8},store.space.objects[d].value) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Pin})}
 }
 state source_index(store:&|model|::ObjectStore,c:u64,budget:u64,route:|model_file|::Route,field:|model|::Value)->RowRead {
  transition field {|model|::Value::Integer {number} -> source_index_number(store,c,budget,route,number) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::SourceIndex})}
 }
 state source_index_number(store:&|model|::ObjectStore,c:u64,budget:u64,route:|model_file|::Route,index:u64)->RowRead {
  transition index<=4294967295 {true -> source(store,c,budget,route,index as u32) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::SourceIndex})}
 }
 state source(store:&|model|::ObjectStore,c:u64,budget:u64,route:|model_file|::Route,index:u32)->RowRead {
  let source:|model|::ReferenceState=|object_references|::unwrap_all(&store.space,c,budget);
  transition source.outcome==|model|::Outcome::Success && source.object<64 {true -> source_value(store,store.space.objects[source.object].value,route,index) _ -> (RowRead {outcome:source.outcome,fault:|model_file|::Fault::Source})}
 }
 state source_value(store:&|model|::ObjectStore,field:|model|::Value,route:|model_file|::Route,index:u32)->RowRead {
  transition field {
   |model|::Value::Integer {number} -> zero(number,route,index)
   |model|::Value::NameReference {name,scope} -> link(store,name,scope,route,index)
   _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Source})
  }
 }
 state zero(number:u64,route:|model_file|::Route,index:u32)->RowRead {
  transition number==0 {true -> (RowRead {route:|model_file|::Route {device:route.device,pin:route.pin,target:|model_file|::Target::Gsi {number:index}}}) _ -> (RowRead {outcome:|model|::Outcome::BadEncoding,fault:|model_file|::Fault::Source})}
 }
 state link(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path,route:|model_file|::Route,index:u32)->RowRead {
  let found:|model|::Lookup=resolve_level(store,name,scope);
  transition found.outcome==|model|::Outcome::Success {true -> (RowRead {route:|model_file|::Route {device:route.device,pin:route.pin,target:|model_file|::Target::Link {path:found.path,source_index:index}}}) _ -> (RowRead {outcome:found.outcome,fault:|model_file|::Fault::LinkLevel})}
 }
}
// Level search deliberately ignores ordinary object slots. Non-search paths
// resolve against the declared scope and must identify an existing level.
pub machine resolve_level(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path)->|model|::Lookup {
 let resolved:|model|::PathResult=|names|::resolve(name,scope);
 transition resolved.outcome==|model|::Outcome::Success {true -> declared(store,name,scope,resolved.value) _ -> (|model|::Lookup {outcome:resolved.outcome})}
 state declared(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path,absolute:|model|::Path)->|model|::Lookup {
  let declared:|model|::Lookup=|namespace|::level(store.space,scope);
  transition declared.outcome==|model|::Outcome::Success {true -> choose(store,name,scope,absolute) _ -> (declared)}
 }
 state choose(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path,absolute:|model|::Path)->|model|::Lookup {
  transition !name.absolute && name.parents==0 && name.count==1 {true -> search(store,name,scope) _ -> exact(store,absolute)}
 }
 state search(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path)->|model|::Lookup {
  let initial:|model|::Lookup=|model|::Lookup {outcome:|model|::Outcome::MissingLevel};let result:|model|::Lookup=pr_level_walk(store,name,scope,initial,0,17);result
 }
 state exact(store:&|model|::ObjectStore,absolute:|model|::Path)->|model|::Lookup {let result:|model|::Lookup=|namespace|::level(store.space,absolute);result}
}
machine pr_level_walk(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path,prior:|model|::Lookup,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->|model|::Lookup {
 let next:|model|::Lookup=pr_level_step(store,name,scope,prior,index,count);
 let upper:|model|::PathResult=|names|::parent(scope);let parent:|model|::Path=pr_parent(scope,upper);
 transition index<count {true -> pr_level_walk(store,name,parent,next,index+1,count) _ -> (prior)}
}
machine pr_parent(scope:|model|::Path,upper:|model|::PathResult)->|model|::Path {transition upper.outcome==|model|::Outcome::Success {true -> (upper.value) _ -> (scope)}}
machine pr_level_step(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path,prior:|model|::Lookup,index:u64,count:u64)->|model|::Lookup {
 transition index<count && prior.outcome!=|model|::Outcome::Success {true -> resolve(store,name,scope) _ -> (prior)}
 state resolve(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path)->|model|::Lookup {
  let resolved:|model|::PathResult=|names|::resolve(name,scope);
  transition resolved.outcome==|model|::Outcome::Success {true -> lookup(store,resolved.value) _ -> (|model|::Lookup {outcome:resolved.outcome})}
 }
 state lookup(store:&|model|::ObjectStore,path:|model|::Path)->|model|::Lookup {let result:|model|::Lookup=|namespace|::level(store.space,path);result}
}
// Strict tables contain wildcard functions only, so every queried function
// shares the same route. Query function is intentionally absent from this API.
pub machine select(routes:&|model_file|::Routes,device:u16,pin:u8)->|model_file|::Selection {
 let count:u64=routes.count;
 transition count<=32 && pin<4 {true -> valid(routes,device,pin,count) _ -> (|model_file|::Selection {outcome:|model|::Outcome::InvalidState,fault:|model_file|::Fault::Table})}
 state valid(routes:&|model_file|::Routes,device:u16,pin:u8,count:u64)->|model_file|::Selection {
  let good:bool=pr_valid_table(routes,true,0,count);transition good {true -> scan(routes,device,pin,count) _ -> (|model_file|::Selection {outcome:|model|::Outcome::InvalidState,fault:|model_file|::Fault::Table})}
 }
 state scan(routes:&|model_file|::Routes,device:u16,pin:u8,count:u64)->|model_file|::Selection {
  let initial:|model_file|::Selection=|model_file|::Selection {outcome:|model|::Outcome::MissingObject};let result:|model_file|::Selection=pr_select(routes,device,pin,initial,0,count);result
 }
}
machine pr_select(routes:&|model_file|::Routes,device:u16,pin:u8,prior:|model_file|::Selection,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->|model_file|::Selection {
 let next:|model_file|::Selection=pr_select_step(routes,device,pin,prior,index,count);
 transition index<count {true -> pr_select(routes,device,pin,next,index+1,count) _ -> (prior)}
}
machine pr_select_step(routes:&|model_file|::Routes,device:u16,pin:u8,prior:|model_file|::Selection,index:u64,count:u64)->|model_file|::Selection {
 transition index<count && index<32 && prior.outcome!=|model|::Outcome::Success {true -> row(routes.entries[index],device,pin,index,prior) _ -> (prior)}
 state row(route:|model_file|::Route,device:u16,pin:u8,index:u64,prior:|model_file|::Selection)->|model_file|::Selection {
  transition route.device==device && route.pin==pin {true -> (|model_file|::Selection {row:index,target:route.target}) _ -> (prior)}
 }
}
pub machine crs_request(target:|model_file|::Target)->|model_file|::Request {
 transition target {|model_file|::Target::Link {path,source_index} -> link(path,source_index) _ -> (|model_file|::Request {outcome:|model|::Outcome::InvalidState})}
 state link(path:|model|::Path,source_index:u32)->|model_file|::Request {
  let result:|model|::PathResult=|namespace|::child(path,0x5352435f);
  transition result.outcome==|model|::Outcome::Success {true -> (|model_file|::Request {path:result.value,source_index:source_index}) _ -> (|model_file|::Request {outcome:result.outcome})}
 }
}

machine pr_count(index:u64)->u64 {transition index<32 {true -> (index+1) _ -> (0)}}

machine pr_valid_table(routes:&|model_file|::Routes,prior:bool,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {let good:bool=pr_valid_slot(routes,index,count);transition index<count {true -> pr_valid_table(routes,prior && good,index+1,count) _ -> (prior)}}
machine pr_valid_slot(routes:&|model_file|::Routes,index:u64,count:u64)->bool {
 transition index<count && index<32 {true -> row(routes.entries[index]) _ -> (true)}
 state row(route:|model_file|::Route)->bool {
  let target:bool=pr_valid_target(route.target);route.pin<4 && target
 }
}
machine pr_valid_target(target:|model_file|::Target)->bool {
 transition target {|model_file|::Target::Gsi {number} -> (true) |model_file|::Target::Link {path,source_index} -> link(path) _ -> (false)}
 state link(path:|model|::Path)->bool {let good:bool=|names|::path_valid(path);good && path.absolute && path.parents==0}
}
