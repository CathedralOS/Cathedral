pub machine decode_mcfg(input: &[u8; 4096], length: u64, offset: u64, header: SdtHeader) -> McfgResult {
    transition offset <= 4096 { true -> fields(input, length, offset, header) _ -> (McfgResult { error: 2 }) }
    state fields(input: &[u8; 4096], length: u64, offset: u64, header: SdtHeader) -> McfgResult {
        let o_reserved: u64 = offset + 36;
        let r_reserved: U64Result = read_u64(input, length, o_reserved);
        transition r_reserved.error == 0 {
            true -> (McfgResult { value: Mcfg {
                header: header,
                reserved: r_reserved.value } })
            _ -> (McfgResult { error: 2 })
        }
    }
}
pub machine decode_mcfg_entry(input: &[u8; 4096], length: u64, offset: u64) -> McfgEntryResult {
    transition offset <= 4096 { true -> fields(input, length, offset) _ -> (McfgEntryResult { error: 2 }) }
    state fields(input: &[u8; 4096], length: u64, offset: u64) -> McfgEntryResult {
        let o_base_address: u64 = offset + 0;
        let o_pci_segment_group: u64 = offset + 8;
        let o_bus_number_start: u64 = offset + 10;
        let o_bus_number_end: u64 = offset + 11;
        let o_reserved: u64 = offset + 12;
        let r_base_address: U64Result = read_u64(input, length, o_base_address);
        let r_pci_segment_group: U16Result = read_u16(input, length, o_pci_segment_group);
        let r_bus_number_start: U8Result = read_u8(input, length, o_bus_number_start);
        let r_bus_number_end: U8Result = read_u8(input, length, o_bus_number_end);
        let r_reserved: U32Result = read_u32(input, length, o_reserved);
        transition r_base_address.error == 0 && r_pci_segment_group.error == 0 && r_bus_number_start.error == 0 && r_bus_number_end.error == 0 && r_reserved.error == 0 {
            true -> (McfgEntryResult { value: McfgEntry {
                base_address: r_base_address.value,
                pci_segment_group: r_pci_segment_group.value,
                bus_number_start: r_bus_number_start.value,
                bus_number_end: r_bus_number_end.value,
                reserved: r_reserved.value } })
            _ -> (McfgEntryResult { error: 2 })
        }
    }
}
pub machine decode_hpet_table(input: &[u8; 4096], length: u64, offset: u64, header: SdtHeader) -> HpetTableResult {
    transition offset <= 4096 { true -> fields(input, length, offset, header) _ -> (HpetTableResult { error: 2 }) }
    state fields(input: &[u8; 4096], length: u64, offset: u64, header: SdtHeader) -> HpetTableResult {
        let o_event_timer_block_id: u64 = offset + 36;
        let o_base_address: u64 = offset + 40;
        let o_hpet_number: u64 = offset + 52;
        let o_clock_tick_unit: u64 = offset + 53;
        let o_page_protection_and_oem: u64 = offset + 55;
        let r_event_timer_block_id: U32Result = read_u32(input, length, o_event_timer_block_id);
        let r_base_address: RawGasResult = parse_gas(input, length, o_base_address);
        let r_hpet_number: U8Result = read_u8(input, length, o_hpet_number);
        let r_clock_tick_unit: U16Result = read_u16(input, length, o_clock_tick_unit);
        let r_page_protection_and_oem: U8Result = read_u8(input, length, o_page_protection_and_oem);
        transition r_event_timer_block_id.error == 0 && r_base_address.error == 0 && r_hpet_number.error == 0 && r_clock_tick_unit.error == 0 && r_page_protection_and_oem.error == 0 {
            true -> (HpetTableResult { value: HpetTable {
                header: header,
                event_timer_block_id: r_event_timer_block_id.value,
                base_address: r_base_address.value,
                hpet_number: r_hpet_number.value,
                clock_tick_unit: r_clock_tick_unit.value,
                page_protection_and_oem: r_page_protection_and_oem.value } })
            _ -> (HpetTableResult { error: 2 })
        }
    }
}
