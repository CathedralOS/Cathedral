 state name(input:&[u8;1024],value:&mut |model|::LoadState,package:|model|::Envelope,kind:|model|::LevelKind)->|model|::Outcome {
  let name:|model|::PathResult=scoped_name(input,package.end,package.body,value.scope,kind);
  transition name.outcome==|model|::Outcome::Success {true -> kind(input,value,package,name,kind) _ -> call_fail_1(value,name.outcome,name.offset)}
 }
 state kind(input:&[u8;1024],value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind)->|model|::Outcome {
  transition kind {
   |model|::LevelKind::Processor -> processor(input,value,package,name,kind)
   |model|::LevelKind::PowerResource -> power(input,value,package,name,kind)
   |model|::LevelKind::Device -> call_create_2(value,package,name,kind,|model|::Value::Device,name.next,true)
   |model|::LevelKind::ThermalZone -> call_create_3(value,package,name,kind,|model|::Value::ThermalZone,name.next,true)
   _ -> call_create_4(value,package,name,kind,|model|::Value::Uninitialized,name.next,false)
  }
 }
 state processor(input:&[u8;1024],value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind)->|model|::Outcome {
  let fields:|model|::Read=|bytes|::read_le(input,package.end,name.next,6);
  transition fields.outcome==|model|::Outcome::Success {true -> processor_value(value,package,name,kind,fields) _ -> call_fail_5(value,fields.outcome,fields.offset)}
 }
 state processor_value(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind,fields:|model|::Read)->|model|::Outcome {
  let object:|model|::Value=|model|::Value::Processor {id:(fields.value&255) as u8,address:((fields.value>>8)&0xffffffff) as u32,length:((fields.value>>40)&255) as u8};
  let result:|model|::Outcome=create(value,package,name,kind,object,fields.next,true);result
 }
 state power(input:&[u8;1024],value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind)->|model|::Outcome {
  let fields:|model|::Read=|bytes|::read_le(input,package.end,name.next,3);
  transition fields.outcome==|model|::Outcome::Success {true -> power_value(value,package,name,kind,fields) _ -> call_fail_6(value,fields.outcome,fields.offset)}
 }
 state power_value(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind,fields:|model|::Read)->|model|::Outcome {
  let object:|model|::Value=|model|::Value::PowerResource {system_level:(fields.value&255) as u8,order:((fields.value>>8)&65535) as u16};
  let result:|model|::Outcome=create(value,package,name,kind,object,fields.next,true);result
 }

 state call_fail_0(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}

 state call_fail_1(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}

 state call_create_2(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind,object:|model|::Value,next:u64,with_object:bool) -> |model|::Outcome {let result:|model|::Outcome=create(value,package,name,kind,object,next,with_object);result}

 state call_create_3(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind,object:|model|::Value,next:u64,with_object:bool) -> |model|::Outcome {let result:|model|::Outcome=create(value,package,name,kind,object,next,with_object);result}

 state call_create_4(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind,object:|model|::Value,next:u64,with_object:bool) -> |model|::Outcome {let result:|model|::Outcome=create(value,package,name,kind,object,next,with_object);result}

 state call_fail_5(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}

 state call_fail_6(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}
}
machine create(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind,object:|model|::Value,next:u64,with_object:bool)->|model|::Outcome {
 transition value.depth<8 {true -> level(value,package,name,kind,object,next,with_object) _ -> call_fail_0(value,|model|::Outcome::Depth,value.at)}
 state level(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,kind:|model|::LevelKind,object:|model|::Value,next:u64,with_object:bool)->|model|::Outcome {
  let added:|model|::NamespaceResult=|namespace|::add_level(value.space,name.value,kind);
  transition added.outcome==|model|::Outcome::Success {true -> object(value,package,name,object,next,with_object,added.space) _ -> call_fail_1(value,added.outcome,value.at)}
 }
 state object(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,object:|model|::Value,next:u64,with_object:bool,space:|model|::Namespace)->|model|::Outcome {
  transition with_object {true -> insert_object(value,package,name,object,next,space) _ -> call_push_2(value,package,name.value,next,space)}
 }
 state insert_object(value:&mut |model|::LoadState,package:|model|::Envelope,name:|model|::PathResult,object:|model|::Value,next:u64,space:|model|::Namespace)->|model|::Outcome {
  let inserted:|model|::NamespaceResult=|namespace|::insert(space,name.value,object);
  transition inserted.outcome==|model|::Outcome::Success {true -> call_push_3(value,package,name.value,next,inserted.space) _ -> call_fail_4(value,inserted.outcome,value.at)}
 }

 state call_fail_0(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}

 state call_fail_1(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}

 state call_push_2(value:&mut |model|::LoadState,package:|model|::Envelope,scope:|model|::Path,next:u64,space:|model|::Namespace) -> |model|::Outcome {let result:|model|::Outcome=push(value,package,scope,next,space);result}

 state call_push_3(value:&mut |model|::LoadState,package:|model|::Envelope,scope:|model|::Path,next:u64,space:|model|::Namespace) -> |model|::Outcome {let result:|model|::Outcome=push(value,package,scope,next,space);result}

 state call_fail_4(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}
}
machine push(value:&mut |model|::LoadState,package:|model|::Envelope,scope:|model|::Path,next:u64,space:|model|::Namespace)->|model|::Outcome {
 let index:u64=value.depth;
 transition index<8 {true -> commit(value,package,scope,next,space,index) _ -> call_fail_0(value,|model|::Outcome::Depth,value.at)}
 state commit(value:&mut |model|::LoadState,package:|model|::Envelope,scope:|model|::Path,next:u64,space:|model|::Namespace,index:u64)->|model|::Outcome {
  let frame:|model|::ScopeFrame=|model|::ScopeFrame {scope:value.scope,end:value.end};
  value.frames[index]=frame;value.depth=index+1;value.scope=scope;value.at=next;value.end=package.end;value.space=space;|model|::Outcome::Success
 }

 state call_fail_0(value:&mut |model|::LoadState,outcome:|model|::Outcome,offset:u64) -> |model|::Outcome {let result:|model|::Outcome=fail(value,outcome,offset);result}
}

machine scoped_name(input:&[u8;1024],end:u64,at:u64,scope:|model|::Path,kind:|model|::LevelKind)->|model|::PathResult {
 let raw:|model|::PathResult=|names|::namestring(input,end,at);
 transition raw.outcome==|model|::Outcome::Success {true -> full(raw,scope,kind) _ -> (raw)}
 state full(raw:|model|::PathResult,scope:|model|::Path,kind:|model|::LevelKind)->|model|::PathResult {
  let result:|model|::PathResult=|names|::resolve(raw.value,scope);let mut out:|model|::PathResult=result;out.next=raw.next;
  transition kind {|model|::LevelKind::Scope -> (out) _ -> nonempty(raw,out)}
 }
 state nonempty(raw:|model|::PathResult,out:|model|::PathResult)->|model|::PathResult {transition raw.value.count>0 {true -> (out) _ -> (|model|::PathResult {outcome:|model|::Outcome::InvalidName,offset:raw.next})}
 }
}

machine loader_capture(input:&[u8;1024],length:u64,unit:u64,space:|model|::Namespace,definitions:&mut |model|::MethodDefinitions,term_budget:u64,value_budget:u64)->|model|::LoadState {
 transition length<=1024 && term_budget<=1024 && value_budget<=1024 {
  true -> run(input,length,unit,space,definitions,term_budget,value_budget) _ -> (|model|::LoadState {outcome:|model|::Outcome::Capacity,space:space,done:true})
 }
 state run(input:&[u8;1024],length:u64,unit:u64,space:|model|::Namespace,definitions:&mut |model|::MethodDefinitions,term_budget:u64,value_budget:u64)->|model|::LoadState {
  let scope:|model|::Path=|names|::root();let mut current:|model|::LoadState=|model|::LoadState {space:space,end:length,unit:unit,scope:scope,value_budget:value_budget};
  let outcome:|model|::Outcome=load_loop(input,&mut current,definitions,0,term_budget);
  transition current.done {true -> result(space,current) _ -> exhausted(space,current)}
 }
 state result(original:|model|::Namespace,current:|model|::LoadState)->|model|::LoadState {
  transition current.outcome==|model|::Outcome::Success {true -> (current) _ -> rollback(original,current)}
 }
 state exhausted(original:|model|::Namespace,current:|model|::LoadState)->|model|::LoadState {
  let mut out:|model|::LoadState=current;out.space=original;out.outcome=|model|::Outcome::WorkLimit;out.offset=current.at;out.done=true;out.external_count=0;out
 }
 state rollback(original:|model|::Namespace,current:|model|::LoadState)->|model|::LoadState {let mut out:|model|::LoadState=current;out.space=original;out.external_count=0;out}
}
machine load_loop(input:&[u8;1024],value:&mut |model|::LoadState,definitions:&mut |model|::MethodDefinitions,index:u64,count:u64)
terminates by (index,count) -> |nat|::Nat::BoundedDistance;
-> |model|::Outcome {
 let next:|model|::Outcome=load_tick(input,value,definitions,index,count);
 transition index<count {true -> load_loop(input,value,definitions,index+1,count) _ -> (value.outcome)}
}
machine load_tick(input:&[u8;1024],value:&mut |model|::LoadState,definitions:&mut |model|::MethodDefinitions,index:u64,count:u64)->|model|::Outcome {
 transition index<count {true -> tick(input,value,definitions) _ -> (value.outcome)}
 state tick(input:&[u8;1024],value:&mut |model|::LoadState,definitions:&mut |model|::MethodDefinitions)->|model|::Outcome {let result:|model|::Outcome=load_step(input,value,definitions);result}
}

// Compatibility entry: newly captured observations are intentionally discarded.
// Existing namespace-only callers retain the original signature and outcomes.
pub machine load(input:&[u8;1024],length:u64,unit:u64,space:|model|::Namespace,term_budget:u64,value_budget:u64)->|model|::LoadState {
 let mut definitions:|model|::MethodDefinitions;
 let result:|model|::LoadState=loader_capture(input,length,unit,space,&mut definitions,term_budget,value_budget);result
}
// Callers retain matching immutable source units. The namespace and sidecar are
// one transaction; errors return both original inputs, never partial captures.
pub machine load_with_definitions(input:&[u8;1024],length:u64,unit:u64,space:|model|::Namespace,definitions:|model|::MethodDefinitions,term_budget:u64,value_budget:u64)->|model|::ObservedLoad {
 let mut candidate:|model|::MethodDefinitions=definitions;
 let loaded:|model|::LoadState=loader_capture(input,length,unit,space,&mut candidate,term_budget,value_budget);
 transition loaded.outcome==|model|::Outcome::Success {true -> (|model|::ObservedLoad {load:loaded,definitions:candidate}) _ -> (|model|::ObservedLoad {load:loaded,definitions:definitions})}
}
