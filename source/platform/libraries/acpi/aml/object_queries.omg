// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5; copyright 2018 Isaac Woods.
// Bounded initialized metadata only; no interpreter, handler or live services.
use {omega}/language/core/nat.omg;
use model.omg;
use namespace.omg;
use object_references.omg;
use byte_storage.omg;

pub data QueryResult [copy] {
 case Value(object:u64,number:u64);
 case ResolutionFailure(resolution_error:|model|::Outcome);
 case UnsupportedValue;
 case InvalidStorage(storage_error:|byte_storage|::ByteOutcome);
}

// Both lexical and object-ID edges consume the same inspection budget. Zero
// budget never inspects an object. A repeated target is rejected before follow.
pub machine resolve_object(space:&|model|::Namespace,object:u64,budget:u64)->|model|::ReferenceState {
 let count:u64=space.object_count;let entries:u64=space.count;
 transition count<=64 && entries<=32 && object<count && object<64 && budget<=64 {
  true -> walk(space,object,budget)
  _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,object:object,done:true})
 }
 state walk(space:&|model|::Namespace,object:u64,budget:u64)->|model|::ReferenceState {
  let result:|model|::ReferenceState=oq_walk(space,|model|::ReferenceState {object:object},0,budget);
  transition result.done {true -> (result) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::WorkLimit,object:result.object,visited:result.visited,done:true})}
 }
}
machine oq_walk(space:&|model|::Namespace,current:|model|::ReferenceState,index:u64,count:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->|model|::ReferenceState {
 let next:|model|::ReferenceState=oq_step(space,current,index,count);
 transition index<count {true -> oq_walk(space,next,index+1,count) _ -> (current)}
}
machine oq_step(space:&|model|::Namespace,current:|model|::ReferenceState,index:u64,count:u64)->|model|::ReferenceState {
 transition current.done || index>=count {true -> (current) _ -> inspect(space,current,current.object)}
 state inspect(space:&|model|::Namespace,current:|model|::ReferenceState,object:u64)->|model|::ReferenceState {
  transition object<space.object_count && object<64 {true -> payload(space,current,object) _ -> failure(current,|model|::Outcome::InvalidState)}
 }
 state payload(space:&|model|::Namespace,current:|model|::ReferenceState,object:u64)->|model|::ReferenceState {
  let seen:u64=current.visited|((1 as u64)<<object);let value:|model|::Value=space.objects[object].value;
  transition value {
   |model|::Value::Reference {kind,object_id} -> target(space,object_id,seen)
   |model|::Value::NameReference {name,scope} -> lookup(space,object,seen,name,scope)
   _ -> (|model|::ReferenceState {object:object,visited:seen,done:true})
  }
 }
 state lookup(space:&|model|::Namespace,object:u64,seen:u64,name:|model|::Path,scope:|model|::Path)->|model|::ReferenceState {
  let copied:|model|::Namespace=|model|::Namespace {count:space.count,object_count:space.object_count,entries:space.entries,objects:space.objects};
  let found:|model|::Lookup=|namespace|::search(copied,name,scope);
  transition found.outcome==|model|::Outcome::Success {true -> target(space,found.object,seen) _ -> (|model|::ReferenceState {outcome:found.outcome,object:object,visited:seen,done:true})}
 }
 state target(space:&|model|::Namespace,object:u64,seen:u64)->|model|::ReferenceState {
  transition object<space.object_count && object<64 {true -> cycle(object,seen) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,object:object,visited:seen,done:true})}
 }
 state cycle(object:u64,seen:u64)->|model|::ReferenceState {
  let mask:u64=(1 as u64)<<object;
  transition seen&mask!=0 {true -> (|model|::ReferenceState {outcome:|model|::Outcome::ReferenceCycle,object:object,visited:seen,done:true}) _ -> (|model|::ReferenceState {object:object,visited:seen})}
 }
 state failure(current:|model|::ReferenceState,outcome:|model|::Outcome)->|model|::ReferenceState {
  |model|::ReferenceState {outcome:outcome,object:current.object,visited:current.visited,done:true}
 }
}

// Reports the canonical payload kind after resolution. It does not validate
// unrelated payload bytes, method provenance or runtime service availability.
pub machine object_type(space:&|model|::Namespace,object:u64,budget:u64)->QueryResult {
 let resolved:|model|::ReferenceState=resolve_object(space,object,budget);
 transition resolved.outcome==|model|::Outcome::Success {true -> value(space,resolved.object) _ -> (QueryResult::ResolutionFailure {resolution_error:resolved.outcome})}
 state value(space:&|model|::Namespace,object:u64)->QueryResult {
  transition object<space.object_count && object<64 {true -> classify(object,space.objects[object].value) _ -> (QueryResult::ResolutionFailure {resolution_error:|model|::Outcome::InvalidState})}
 }
 state classify(object:u64,value:|model|::Value)->QueryResult {
  transition value {
   |model|::Value::Uninitialized -> (QueryResult::Value {object:object,number:0})
   |model|::Value::Integer {number} -> (QueryResult::Value {object:object,number:1})
   |model|::Value::String {string_storage} -> (QueryResult::Value {object:object,number:2})
   |model|::Value::Buffer {buffer_storage} -> (QueryResult::Value {object:object,number:3})
   |model|::Value::Package {first,count} -> (QueryResult::Value {object:object,number:4})
   |model|::Value::FieldUnit {binding,declaration,field} -> (QueryResult::Value {object:object,number:5})
   |model|::Value::Device -> (QueryResult::Value {object:object,number:6})
   |model|::Value::Event -> (QueryResult::Value {object:object,number:7})
   |model|::Value::Method {flags,body} -> (QueryResult::Value {object:object,number:8})
   |model|::Value::Mutex {sync_level} -> (QueryResult::Value {object:object,number:9})
   |model|::Value::OperationRegion {space,base,length,scope} -> (QueryResult::Value {object:object,number:10})
   |model|::Value::PowerResource {system_level,order} -> (QueryResult::Value {object:object,number:11})
   |model|::Value::Processor {id,address,length} -> (QueryResult::Value {object:object,number:12})
   |model|::Value::ThermalZone -> (QueryResult::Value {object:object,number:13})
   |model|::Value::BufferField {backing_object,bit_offset,bit_length} -> (QueryResult::Value {object:object,number:14})
   _ -> (QueryResult::ResolutionFailure {resolution_error:|model|::Outcome::InvalidState})
  }
 }
}

// Package size validates all advertised sibling links with a separate 64-node
// bound. Byte size validates the full current owned/source payload via storage.
pub machine size_of(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,budget:u64)->QueryResult {
 let resolved:|model|::ReferenceState=resolve_object(&store.space,object,budget);
 transition resolved.outcome==|model|::Outcome::Success {true -> value(input,length,unit,store,resolved.object) _ -> (QueryResult::ResolutionFailure {resolution_error:resolved.outcome})}
 state value(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64)->QueryResult {
  transition object<store.space.object_count && object<64 {true -> classify(input,length,unit,store,object,store.space.objects[object].value) _ -> (QueryResult::ResolutionFailure {resolution_error:|model|::Outcome::InvalidState})}
 }
 state classify(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,value:|model|::Value)->QueryResult {
  transition value {
   |model|::Value::String {string_storage} -> bytes(input,length,unit,store,object)
   |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,object)
   |model|::Value::Package {first,count} -> package(store,object,count)
   _ -> (QueryResult::UnsupportedValue)
  }
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64)->QueryResult {
  let measured:|byte_storage|::ByteResult=|byte_storage|::byte_length(input,length,unit,store,object);
  transition measured.outcome==|byte_storage|::ByteOutcome::Success {true -> (QueryResult::Value {object:object,number:measured.length}) _ -> (QueryResult::InvalidStorage {storage_error:measured.outcome})}
 }
 state package(store:&|model|::ObjectStore,object:u64,count:u64)->QueryResult {
  transition count==0 {true -> (QueryResult::Value {object:object,number:0}) _ -> validate(store,object,count)}
 }
 state validate(store:&|model|::ObjectStore,object:u64,count:u64)->QueryResult {
  let selected:|model|::ReferenceState=|object_references|::package_element(&store.space,object,0,64);
  transition selected.outcome==|model|::Outcome::Success {true -> (QueryResult::Value {object:object,number:count}) _ -> (QueryResult::ResolutionFailure {resolution_error:selected.outcome})}
 }
}
