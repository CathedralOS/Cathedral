// SPDX-License-Identifier: MIT OR Apache-2.0
// Primary logical data policy alongside rust-osdev/acpi do_logical_op,
// pin 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// Direct, already evaluated IDs only. No reference/field evaluation or retirement.
use model.omg;
use implicit_conversions.omg;
use object_conversions.omg;
use object_comparison.omg;
use {integer_helpers}/integers.omg;
pub data LogicalResult [copy] {
 case Failure(reason:|object_conversions|::ConversionFailure);
 case Integer(number:u64);
}
pub machine binary(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,op:|integers|::Logical)->LogicalResult {
 transition op {
  |integers|::Logical::And -> truth(input,length,unit,store,left,right,size,op)
  |integers|::Logical::Or -> truth(input,length,unit,store,left,right,size,op)
  _ -> relation(input,length,unit,store,left,right,size,op)
 }
 state truth(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,op:|integers|::Logical)->LogicalResult {
  let a:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,left,size,|implicit_conversions|::ConversionTarget::Integer);
  transition a {
   |implicit_conversions|::ImplicitResult::Failure {reason} -> (LogicalResult::Failure {reason:reason})
   |implicit_conversions|::ImplicitResult::Integer {number} -> other(input,length,unit,store,right,size,op,number)
   _ -> (LogicalResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
  }
 }
 state other(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,right:u64,size:|integers|::IntegerSize,op:|integers|::Logical,a:u64)->LogicalResult {
  let b:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,right,size,|implicit_conversions|::ConversionTarget::Integer);
  transition b {
   |implicit_conversions|::ImplicitResult::Failure {reason} -> (LogicalResult::Failure {reason:reason})
   |implicit_conversions|::ImplicitResult::Integer {number} -> integers(size,op,a,number)
   _ -> (LogicalResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
  }
 }
 state integers(size:|integers|::IntegerSize,op:|integers|::Logical,a:u64,b:u64)->LogicalResult {
  let value:u64=|integers|::logical(size,op,a,b);LogicalResult::Integer {number:value}
 }
 state relation(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,op:|integers|::Logical)->LogicalResult {
  let comparison:|object_comparison|::ObjectComparison=|object_comparison|::compare(input,length,unit,store,left,right,size);
  let result:LogicalResult=ol_relation(comparison,size,op);result
 }
}
pub machine negate(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,size:|integers|::IntegerSize)->LogicalResult {
 let value:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,source,size,|implicit_conversions|::ConversionTarget::Integer);
 transition value {
  |implicit_conversions|::ImplicitResult::Failure {reason} -> (LogicalResult::Failure {reason:reason})
  |implicit_conversions|::ImplicitResult::Integer {number} -> invert(size,number)
  _ -> (LogicalResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
 state invert(size:|integers|::IntegerSize,number:u64)->LogicalResult {
  let value:u64=|integers|::logical_not(size,number);LogicalResult::Integer {number:value}
 }
}
machine ol_relation(comparison:|object_comparison|::ObjectComparison,size:|integers|::IntegerSize,op:|integers|::Logical)->LogicalResult {
 transition comparison {
  |object_comparison|::ObjectComparison::Failure {reason} -> (LogicalResult::Failure {reason:reason})
  |object_comparison|::ObjectComparison::Less -> truth(size,op==|integers|::Logical::NotEqual || op==|integers|::Logical::Less || op==|integers|::Logical::LessEqual)
  |object_comparison|::ObjectComparison::Equal -> truth(size,op==|integers|::Logical::Equal || op==|integers|::Logical::LessEqual || op==|integers|::Logical::GreaterEqual)
  |object_comparison|::ObjectComparison::Greater -> truth(size,op==|integers|::Logical::NotEqual || op==|integers|::Logical::Greater || op==|integers|::Logical::GreaterEqual)
 }
 state truth(size:|integers|::IntegerSize,yes:bool)->LogicalResult {
  let mask:u64=|integers|::integer_mask(size);
  transition yes {true -> (LogicalResult::Integer {number:mask}) _ -> (LogicalResult::Integer {number:0})}
 }
}
