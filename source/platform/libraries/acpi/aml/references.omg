use {omega}/language/core/nat.omg;
use model.omg;
use namespace.omg;
pub machine resolve_reference(space:|model|::Namespace,object:u64,budget:u64)->|model|::ReferenceState {
 transition object<space.object_count && space.object_count<=64 && budget<=64 {
  true -> run(space,object,budget) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,done:true})
 }
 state run(space:|model|::Namespace,object:u64,budget:u64)->|model|::ReferenceState {
  let initial:|model|::ReferenceState=|model|::ReferenceState {object:object};let result:|model|::ReferenceState=reference_scan(space,initial,0,budget);
  transition result.done {true -> (result) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::WorkLimit,object:result.object,visited:result.visited,done:true})}
 }
}
machine reference_scan(space:|model|::Namespace,value:|model|::ReferenceState,index:u64,count:u64)
terminates by (index,count) -> |nat|::Nat::BoundedDistance;
-> |model|::ReferenceState {
 let next:|model|::ReferenceState=reference_step(space,value);
 transition index<count {true -> reference_scan(space,next,index+1,count) _ -> (value)}
}
machine reference_step(space:|model|::Namespace,value:|model|::ReferenceState)->|model|::ReferenceState {
 transition value.done {true -> (value) _ -> bounds(space,value)}
 state bounds(space:|model|::Namespace,value:|model|::ReferenceState)->|model|::ReferenceState {
  transition value.object<space.object_count && value.object<64 {true -> seen(space,value) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,done:true})}
 }
 state seen(space:|model|::Namespace,value:|model|::ReferenceState)->|model|::ReferenceState {
  let mask:u64=(1 as u64)<<value.object;
  transition value.visited&mask==0 {true -> inspect(space,value,mask) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::ReferenceCycle,object:value.object,visited:value.visited,done:true})}
 }
 state inspect(space:|model|::Namespace,value:|model|::ReferenceState,mask:u64)->|model|::ReferenceState {
  let object:|model|::Object=|namespace|::object_at(space,value.object);let referred_value:|model|::Value=object.value;
  let target:ReferenceTarget=reference_target(referred_value);
  transition target.has_name {
   true -> lookup(space,value,mask,target.name,target.scope)
   _ -> (|model|::ReferenceState {object:value.object,visited:value.visited|mask,done:true})
  }
 }
 state lookup(space:|model|::Namespace,value:|model|::ReferenceState,mask:u64,name:|model|::Path,scope:|model|::Path)->|model|::ReferenceState {
  let found:|model|::Lookup=|namespace|::search(space,name,scope);
  transition found.outcome==|model|::Outcome::Success {
   true -> (|model|::ReferenceState {object:found.object,visited:value.visited|mask})
   _ -> (|model|::ReferenceState {outcome:found.outcome,object:value.object,visited:value.visited|mask,done:true})
  }
 }
}

data ReferenceTarget [copy] {has_name:bool;name:|model|::Path;scope:|model|::Path;}
machine reference_target(value:|model|::Value)->ReferenceTarget {
 transition value {|model|::Value::NameReference {name,scope} -> named(name,scope) _ -> (ReferenceTarget {})}
 state named(name:|model|::Path,scope:|model|::Path)->ReferenceTarget {ReferenceTarget {has_name:true,name:name,scope:scope}}
}
