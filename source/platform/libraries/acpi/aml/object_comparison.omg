// SPDX-License-Identifier: MIT OR Apache-2.0
// Primary AML comparison policy over the licensed rust-osdev/acpi helper port.
// Direct IDs only; callers supply reference/field evaluation separately.
use model.omg;
use implicit_conversions.omg;
use object_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/byte_comparison.omg;
pub data ObjectComparison [copy] {
 case Failure(reason:|object_conversions|::ConversionFailure);
 case Less;
 case Equal;
 case Greater;
}
pub machine compare(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize)->ObjectComparison {
 let count:u64=store.space.object_count;
 transition count<=64 && left<count && left<64 {true -> kind(input,length,unit,store,left,right,size,store.space.objects[left].value) _ -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state kind(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,value:|model|::Value)->ObjectComparison {
  transition value {
   |model|::Value::Integer {number} -> selected(input,length,unit,store,left,right,size,|implicit_conversions|::ConversionTarget::Integer)
   |model|::Value::Buffer {buffer_storage} -> selected(input,length,unit,store,left,right,size,|implicit_conversions|::ConversionTarget::Buffer)
   |model|::Value::String {string_storage} -> selected(input,length,unit,store,left,right,size,|implicit_conversions|::ConversionTarget::String)
   _ -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  }
 }
 state selected(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget)->ObjectComparison {
  let a:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,left,size,target);
  transition a {|implicit_conversions|::ImplicitResult::Failure {reason} -> (ObjectComparison::Failure {reason:reason}) _ -> other(input,length,unit,store,right,size,target,a)}
 }
 state other(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,right:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget,a:|implicit_conversions|::ImplicitResult)->ObjectComparison {
  let b:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,right,size,target);
  transition b {|implicit_conversions|::ImplicitResult::Failure {reason} -> (ObjectComparison::Failure {reason:reason}) _ -> order(a,b)}
 }
 state order(a:|implicit_conversions|::ImplicitResult,b:|implicit_conversions|::ImplicitResult)->ObjectComparison {let result:ObjectComparison=oc_order(a,b);result}
}
machine oc_order(a:|implicit_conversions|::ImplicitResult,b:|implicit_conversions|::ImplicitResult)->ObjectComparison {
 transition a {
  |implicit_conversions|::ImplicitResult::Integer {number} -> integer(number,b)
  |implicit_conversions|::ImplicitResult::Buffer {length,bytes} -> buffer(&bytes,length,b)
  |implicit_conversions|::ImplicitResult::String {length,bytes} -> string(&bytes,length,b)
  _ -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
 state integer(a:u64,b:|implicit_conversions|::ImplicitResult)->ObjectComparison {
  transition b {|implicit_conversions|::ImplicitResult::Integer {number} -> numbers(a,number) _ -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state numbers(a:u64,b:u64)->ObjectComparison {transition {a<b -> (ObjectComparison::Less) a>b -> (ObjectComparison::Greater) _ -> (ObjectComparison::Equal)}}
 state buffer(a:&[u8;256],length:u64,b:|implicit_conversions|::ImplicitResult)->ObjectComparison {
  transition b {|implicit_conversions|::ImplicitResult::Buffer {length as right_length,bytes} -> buffers(a,length,&bytes,right_length) _ -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state buffers(a:&[u8;256],a_length:u64,b:&[u8;256],b_length:u64)->ObjectComparison {
  let order:|byte_comparison|::Comparison=|byte_comparison|::compare_buffers(a,a_length,b,b_length,|byte_comparison|::BufferOrdering::Lexicographic);let result:ObjectComparison=oc_bytes(order);result
 }
 state string(a:&[u8;256],length:u64,b:|implicit_conversions|::ImplicitResult)->ObjectComparison {
  transition b {|implicit_conversions|::ImplicitResult::String {length as right_length,bytes} -> strings(a,length,&bytes,right_length) _ -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state strings(a:&[u8;256],a_length:u64,b:&[u8;256],b_length:u64)->ObjectComparison {
  let order:|byte_comparison|::Comparison=|byte_comparison|::compare_strings(a,a_length,b,b_length);let result:ObjectComparison=oc_bytes(order);result
 }
}
machine oc_bytes(order:|byte_comparison|::Comparison)->ObjectComparison {
 transition order {
  |byte_comparison|::Comparison::Less -> (ObjectComparison::Less)
  |byte_comparison|::Comparison::Equal -> (ObjectComparison::Equal)
  |byte_comparison|::Comparison::Greater -> (ObjectComparison::Greater)
  |byte_comparison|::Comparison::Capacity -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
  |byte_comparison|::Comparison::Encoding -> (ObjectComparison::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
 }
}
