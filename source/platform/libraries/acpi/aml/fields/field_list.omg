// Compatibility entry into the canonical AML-owned field syntax.
module field_list;
use aml::field_elements;
use aml::model::Path;
use aml::field_model::ListState;
pub machine parse_list(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:Path,flags:u8,bit_limit:u64,budget:u64)->ListState {
 let result:ListState=field_elements::parse_list(input,end,at,unit,scope,flags,bit_limit,budget);result
}
