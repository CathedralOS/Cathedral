// Primary data operations alongside rust-osdev/acpi do_binary_maths,
// do_unary_maths, do_from_bcd and do_to_bcd. Copyright 2018 Isaac Woods.
// Pin 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5; direct evaluated IDs only.
use model.omg;
use implicit_conversions.omg;
use object_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/bcd.omg;
pub data Unary [copy] {case BitwiseNot;case FindSetLeft;case FindSetRight;case FromBcd;case ToBcd;}
pub data MathFailure [copy] {
 case Conversion(reason:|object_conversions|::ConversionFailure);
 case DivideByZero;
 case InvalidBcd;
 case Overflow;
}
pub data MathResult [copy] {
 case Failure(reason:MathFailure);
 case Integer(number:u64);
 case Division(quotient:u64,remainder:u64);
}
pub machine binary(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,op:|integers|::Binary)->MathResult {
 let a:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,left,size,|implicit_conversions|::ConversionTarget::Integer);
 transition a {
  |implicit_conversions|::ImplicitResult::Failure {reason} -> (MathResult::Failure {reason:MathFailure::Conversion {reason:reason}})
  |implicit_conversions|::ImplicitResult::Integer {number} -> other(input,length,unit,store,right,size,op,number)
  _ -> invalid()
 }
 state other(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,right:u64,size:|integers|::IntegerSize,op:|integers|::Binary,a:u64)->MathResult {
  let b:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,right,size,|implicit_conversions|::ConversionTarget::Integer);
  transition b {
   |implicit_conversions|::ImplicitResult::Failure {reason} -> (MathResult::Failure {reason:MathFailure::Conversion {reason:reason}})
   |implicit_conversions|::ImplicitResult::Integer {number} -> apply(size,op,a,number)
   _ -> invalid()
  }
 }
 state apply(size:|integers|::IntegerSize,op:|integers|::Binary,a:u64,b:u64)->MathResult {
  let value:|integers|::IntegerResult=|integers|::binary(size,op,a,b);let result:MathResult=omath_result(value,op==|integers|::Binary::Divide);result
 }
 state invalid()->MathResult {MathResult::Failure {reason:MathFailure::Conversion {reason:|object_conversions|::ConversionFailure::InvalidState}}}
}
pub machine unary(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,size:|integers|::IntegerSize,op:Unary)->MathResult {
 let value:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,source,size,|implicit_conversions|::ConversionTarget::Integer);
 transition value {
  |implicit_conversions|::ImplicitResult::Failure {reason} -> (MathResult::Failure {reason:MathFailure::Conversion {reason:reason}})
  |implicit_conversions|::ImplicitResult::Integer {number} -> apply(size,op,number)
  _ -> (MathResult::Failure {reason:MathFailure::Conversion {reason:|object_conversions|::ConversionFailure::InvalidState}})
 }
 state apply(size:|integers|::IntegerSize,op:Unary,number:u64)->MathResult {
  transition op {
   Unary::BitwiseNot -> invert(size,number)
   Unary::FindSetLeft -> left(size,number)
   Unary::FindSetRight -> right(size,number)
   Unary::FromBcd -> decode(size,number)
   Unary::ToBcd -> encode(size,number)
  }
 }
 state invert(size:|integers|::IntegerSize,number:u64)->MathResult {let result:u64=|integers|::bitwise_not(size,number);MathResult::Integer {number:result}}
 state left(size:|integers|::IntegerSize,number:u64)->MathResult {let result:u64=|integers|::find_set_left(size,number);MathResult::Integer {number:result}}
 state right(size:|integers|::IntegerSize,number:u64)->MathResult {let result:u64=|integers|::find_set_right(size,number);MathResult::Integer {number:result}}
 state decode(size:|integers|::IntegerSize,number:u64)->MathResult {let value:|integers|::IntegerResult=|bcd|::from_bcd(size,number);let result:MathResult=omath_result(value,false);result}
 state encode(size:|integers|::IntegerSize,number:u64)->MathResult {let value:|integers|::IntegerResult=|bcd|::to_bcd(size,number);let result:MathResult=omath_result(value,false);result}
}
machine omath_result(value:|integers|::IntegerResult,division:bool)->MathResult {
 transition {
  value.error==0 -> success(value,division)
  value.error==|integers|::ERROR_DIVIDE_BY_ZERO -> (MathResult::Failure {reason:MathFailure::DivideByZero})
  value.error==|integers|::ERROR_INVALID_BCD -> (MathResult::Failure {reason:MathFailure::InvalidBcd})
  value.error==|integers|::ERROR_OVERFLOW -> (MathResult::Failure {reason:MathFailure::Overflow})
  _ -> (MathResult::Failure {reason:MathFailure::Conversion {reason:|object_conversions|::ConversionFailure::InvalidState}})
 }
 state success(value:|integers|::IntegerResult,division:bool)->MathResult {
  transition division {true -> (MathResult::Division {quotient:value.value,remainder:value.remainder}) _ -> (MathResult::Integer {number:value.value})}
 }
}
