// Package construction portion of rust-osdev/acpi do_index, pin
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// Ordinary stable identities only; no AML evaluation, target Store or authority.
use model.omg;
use object_references.omg;

// Complete advertised chain admission precedes allocation. The selected payload
// remains untouched and unresolved. A RefOf wrapper consumes one fresh slot;
// even that slot's old byte block is retained, unused by the Reference payload.
pub machine make_package_index(store:&mut |model|::ObjectStore,package:u64,index:u64)->|model|::Read {
 let selected:|model|::ReferenceState=|object_references|::package_element(&store.space,package,index,64);
 transition selected.outcome==|model|::Outcome::Success {
  true -> allocate(store,selected.object)
  _ -> (|model|::Read {outcome:selected.outcome})
 }
 state allocate(store:&mut |model|::ObjectStore,target:u64)->|model|::Read {
  let allocated:|model|::NamespaceResult=|object_references|::allocate_reference(store.space,|model|::ReferenceKind::RefOf,target);
  transition allocated.outcome==|model|::Outcome::Success {
   true -> commit(store,allocated)
   _ -> (|model|::Read {outcome:allocated.outcome})
  }
 }
 state commit(store:&mut |model|::ObjectStore,allocated:|model|::NamespaceResult)->|model|::Read {
  store.space=allocated.space;|model|::Read {value:allocated.object}
 }
}
