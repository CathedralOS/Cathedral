// Namespace::remove_level, rust-osdev/acpi 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5.
// Copyright 2018 Isaac Woods. Bounded flat namespace adaptation.
use {omega}/language/core/nat.omg;
use model.omg;
use names.omg;

// Remove only the level and its descendants. An object at the same path belongs
// to the parent level and survives. Object slots/IDs and byte backing never move.
// Preflight covers the entire active namespace; every failure is nonmutating.
pub machine remove_level(space:&mut |model|::Namespace,path:|model|::Path)->|model|::Outcome {
 let entries:u64=space.count;let objects:u64=space.object_count;
 transition entries>0 && entries<=32 && objects<=64 {
  true -> path(space,path,entries,objects) _ -> (|model|::Outcome::InvalidState)
 }
 state path(space:&mut |model|::Namespace,path:|model|::Path,entries:u64,objects:u64)->|model|::Outcome {
  transition path.absolute {true -> valid_path(space,path,entries,objects) _ -> (|model|::Outcome::NotAbsolute)}
 }
 state valid_path(space:&mut |model|::Namespace,path:|model|::Path,entries:u64,objects:u64)->|model|::Outcome {
  let valid:bool=|names|::path_valid(path);
  transition valid {true -> structure(space,path,entries,objects) _ -> (|model|::Outcome::InvalidName)}
 }
 state structure(space:&mut |model|::Namespace,path:|model|::Path,entries:u64,objects:u64)->|model|::Outcome {
  let valid:bool=nr_validate(space,0,entries,objects,true);
  let root_path:|model|::Path=|names|::root();let rooted:bool=nr_has_level(space,root_path,0,entries,false);
  transition valid && rooted {true -> root_case(space,path,entries) _ -> (|model|::Outcome::InvalidState)}
 }
 state root_case(space:&mut |model|::Namespace,path:|model|::Path,entries:u64)->|model|::Outcome {
  let count:u64=path.count;
  transition count==0 {true -> (|model|::Outcome::Success) _ -> parent_case(space,path,entries)}
 }
 state parent_case(space:&mut |model|::Namespace,path:|model|::Path,entries:u64)->|model|::Outcome {
  let up:|model|::PathResult=|names|::parent(path);let exists:bool=nr_has_level(space,up.value,0,entries,false);
  transition up.outcome==|model|::Outcome::Success && exists {true -> target(space,path,entries) _ -> (|model|::Outcome::MissingLevel)}
 }
 state target(space:&mut |model|::Namespace,path:|model|::Path,entries:u64)->|model|::Outcome {
  let exists:bool=nr_has_level(space,path,0,entries,false);
  transition exists {true -> stage(space,path,entries) _ -> (|model|::Outcome::Success)}
 }
 state stage(space:&mut |model|::Namespace,path:|model|::Path,entries:u64)->|model|::Outcome {
  let mut staged:[|model|::Entry;32];let count:u64=nr_filter(space,path,&mut staged,0,entries,0);
  space.entries=staged;space.count=count;|model|::Outcome::Success
 }
}
machine nr_has_level(space:&|model|::Namespace,path:|model|::Path,index:u64,count:u64,found:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {
 let next:bool=nr_level_at(space,path,index,count,found);
 transition index<count {true -> nr_has_level(space,path,index+1,count,next) _ -> (found)}
}
machine nr_level_at(space:&|model|::Namespace,path:|model|::Path,index:u64,count:u64,found:bool)->bool {
 transition index<count && index<32 && !found {true -> check(space.entries[index],path) _ -> (found)}
 state check(entry:|model|::Entry,path:|model|::Path)->bool {entry.has_level && |names|::path_equal(entry.path,path)}
}
machine nr_validate(space:&|model|::Namespace,index:u64,count:u64,objects:u64,valid:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {
 let next:bool=nr_validate_at(space,index,count,objects,valid);
 transition index<count {true -> nr_validate(space,index+1,count,objects,next) _ -> (valid)}
}
machine nr_validate_at(space:&|model|::Namespace,index:u64,count:u64,objects:u64,valid:bool)->bool {
 transition index<count && index<32 && valid {true -> inspect_entry(space,space.entries[index],index,count,objects) _ -> (valid)}
 state inspect_entry(space:&|model|::Namespace,value:|model|::Entry,index:u64,count:u64,objects:u64)->bool {
  let id:u64=value.object;let valid:bool=|names|::path_valid(value.path);
  transition value.path.absolute && valid && (value.has_level || value.has_object) && (!value.has_object || id<objects) {
   true -> hierarchy(space,value,index,count) _ -> (false)
  }
 }
 state hierarchy(space:&|model|::Namespace,value:|model|::Entry,index:u64,count:u64)->bool {
  let size:u64=value.path.count;
  transition size==0 {true -> unique(space,value.path,index) _ -> parent_check(space,value.path,index,count)}
 }
 state parent_check(space:&|model|::Namespace,path:|model|::Path,index:u64,count:u64)->bool {
  let up:|model|::PathResult=|names|::parent(path);let exists:bool=nr_has_level(space,up.value,0,count,false);
  transition up.outcome==|model|::Outcome::Success && exists {true -> unique(space,path,index) _ -> (false)}
 }
 state unique(space:&|model|::Namespace,path:|model|::Path,index:u64)->bool {let same:bool=nr_duplicate(space,path,0,index,false);!same}
}
machine nr_duplicate(space:&|model|::Namespace,path:|model|::Path,index:u64,count:u64,found:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {
 let next:bool=nr_duplicate_at(space,path,index,count,found);
 transition index<count {true -> nr_duplicate(space,path,index+1,count,next) _ -> (found)}
}
machine nr_duplicate_at(space:&|model|::Namespace,path:|model|::Path,index:u64,count:u64,found:bool)->bool {
 transition index<count && index<32 && !found {true -> compare(space.entries[index].path,path) _ -> (found)}
 state compare(left:|model|::Path,right:|model|::Path)->bool {|names|::path_equal(left,right)}
}
machine nr_prefix(prefix:|model|::Path,path:|model|::Path)->bool {
 let a:u64=prefix.count;let b:u64=path.count;
 transition a<=b && b<=16 {true -> scan(prefix,path,a) _ -> (false)}
 state scan(prefix:|model|::Path,path:|model|::Path,count:u64)->bool {let result:bool=nr_prefix_loop(prefix,path,0,count,true);result}
}
machine nr_prefix_loop(prefix:|model|::Path,path:|model|::Path,index:u64,count:u64,same:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->bool {
 let next:bool=nr_prefix_at(prefix,path,index,count,same);
 transition index<count {true -> nr_prefix_loop(prefix,path,index+1,count,next) _ -> (same)}
}
machine nr_prefix_at(prefix:|model|::Path,path:|model|::Path,index:u64,count:u64,same:bool)->bool {
 transition index<count && index<16 && same {true -> (prefix.segments[index]==path.segments[index]) _ -> (same)}
}
machine nr_filter(space:&|model|::Namespace,path:|model|::Path,out:&mut [|model|::Entry;32],index:u64,count:u64,kept:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->u64 {
 let next:u64=nr_filter_at(space,path,out,index,count,kept);
 transition index<count {true -> nr_filter(space,path,out,index+1,count,next) _ -> (kept)}
}
machine nr_filter_at(space:&|model|::Namespace,path:|model|::Path,out:&mut [|model|::Entry;32],index:u64,count:u64,kept:u64)->u64 {
 transition index<count && index<32 {true -> inspect_entry(path,out,space.entries[index],kept) _ -> (kept)}
 state inspect_entry(path:|model|::Path,out:&mut [|model|::Entry;32],value:|model|::Entry,kept:u64)->u64 {
  let inside:bool=nr_prefix(path,value.path);let same:bool=|names|::path_equal(path,value.path);
  transition { !inside -> retain(out,value,kept) same && value.has_object -> clear_level(out,value,kept) _ -> (kept)}
 }
 state clear_level(out:&mut [|model|::Entry;32],value:|model|::Entry,kept:u64)->u64 {
  let mut changed:|model|::Entry=value;changed.has_level=false;changed.level=|model|::LevelKind::Scope;
  let result:u64=nr_keep(out,changed,kept);result
 }
 state retain(out:&mut [|model|::Entry;32],value:|model|::Entry,kept:u64)->u64 {let result:u64=nr_keep(out,value,kept);result}
}
machine nr_keep(out:&mut [|model|::Entry;32],value:|model|::Entry,kept:u64)->u64 {
 transition kept<32 {true -> put(out,value,kept) _ -> (kept)}
 state put(out:&mut [|model|::Entry;32],value:|model|::Entry,kept:u64)->u64 {out[kept]=value;kept+1}
}
