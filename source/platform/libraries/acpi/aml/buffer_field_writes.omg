// Already-converted ordinary bytes only. No operation-region/IO/Store dispatch.
use model.omg;
use byte_storage.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/conversions.omg;
use {integer_helpers}/buffer_fields.omg;
// Failure leaves the entire store unchanged. Payload is staged before mutation;
// outer field references require caller resolution, backing references follow
// canonical read_bytes transparency. Source-backed values materialize on commit.
pub machine write(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,payload:&[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
 transition payload_length<=256 {true -> snapshot(input,length,unit,store,field,payload,payload_length) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::Capacity})}
 state snapshot(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,payload:&[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
  let mut bytes:[u8;256];let copied:|integers|::IntegerResult=|conversions|::mid(payload,payload_length,0,payload_length,&mut bytes);
  transition copied.error==0 {true -> admission(input,length,unit,store,field,bytes,payload_length) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::InvalidState})}
 }
 state admission(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,payload:[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
  let count:u64=store.space.object_count;
  transition count<=64 && field<count && field<64 {true -> field_value(input,length,unit,store,store.space.objects[field].value,payload,payload_length) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::InvalidState})}
 }
 state field_value(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,value:|model|::Value,payload:[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
  transition value {
   |model|::Value::BufferField {backing_object,bit_offset,bit_length} -> backing(input,length,unit,store,backing_object,bit_offset,bit_length,payload,payload_length)
   _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::UnsupportedValue})
  }
 }
 state backing(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,object:u64,start:u64,count:u64,payload:[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
  let found:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,object);
  transition found.outcome==|byte_storage|::ByteOutcome::Success {true -> extent(store,found,start,count,payload,payload_length) _ -> (|byte_storage|::ByteResult {outcome:found.outcome})}
 }
 state extent(store:&mut |model|::ObjectStore,found:|byte_storage|::ByteRead,start:u64,count:u64,payload:[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
  let length:u64=found.length;
  transition length<=256 {true -> start_bound(store,found,start,count,payload,payload_length,length*8) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::Capacity})}
 }
 state start_bound(store:&mut |model|::ObjectStore,found:|byte_storage|::ByteRead,start:u64,count:u64,payload:[u8;256],payload_length:u64,bits:u64)->|byte_storage|::ByteResult {
  transition start<=bits && count>0 {true -> count_bound(store,found,start,count,payload,payload_length,bits-start) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::Bounds})}
 }
 state count_bound(store:&mut |model|::ObjectStore,found:|byte_storage|::ByteRead,start:u64,count:u64,payload:[u8;256],payload_length:u64,remaining:u64)->|byte_storage|::ByteResult {
  transition count<=remaining {true -> stage(store,found,start,count,payload,payload_length) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::Bounds})}
 }
 state stage(store:&mut |model|::ObjectStore,found:|byte_storage|::ByteRead,start:u64,count:u64,payload:[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
  let mut staged:|byte_storage|::ByteRead=found;
  let error:u8=|buffer_fields|::copy_bits(&payload,payload_length,0,&mut staged.bytes,staged.length,start,count);
  transition error==0 {true -> encoding(store,staged) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::Bounds})}
 }
 state encoding(store:&mut |model|::ObjectStore,staged:|byte_storage|::ByteRead)->|byte_storage|::ByteResult {
  transition staged.kind==|byte_storage|::ByteKind::String {true -> string(store,staged) _ -> commit(store,staged)}
 }
 state string(store:&mut |model|::ObjectStore,staged:|byte_storage|::ByteRead)->|byte_storage|::ByteResult {
  let mut validated:[u8;256];let checked:|integers|::IntegerResult=|conversions|::string_to_buffer(&staged.bytes,staged.length,false,&mut validated);
  transition checked.error==0 {true -> commit(store,staged) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::Encoding})}
 }
 state commit(store:&mut |model|::ObjectStore,staged:|byte_storage|::ByteRead)->|byte_storage|::ByteResult {
  let target:u64=staged.object;let count:u64=store.space.object_count;let length:u64=staged.length;
  transition target<count && target<64 && count<=64 && length<=256 {true -> owned(store,target,staged) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::InvalidState})}
 }
 state owned(store:&mut |model|::ObjectStore,target:u64,staged:|byte_storage|::ByteRead)->|byte_storage|::ByteResult {
  transition staged.kind {
   |byte_storage|::ByteKind::Buffer -> publish(store,target,staged,|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Owned {buffer_owner:target}})
   |byte_storage|::ByteKind::String -> publish(store,target,staged,|model|::Value::String {string_storage:|model|::StringStorage::Owned {string_owner:target}})
  }
 }
 state publish(store:&mut |model|::ObjectStore,target:u64,staged:|byte_storage|::ByteRead,value:|model|::Value)->|byte_storage|::ByteResult {
  store.bytes.blocks[target]=|model|::ByteBlock {initialized:true,length:staged.length,bytes:staged.bytes};
  store.space.objects[target].value=value;
  |byte_storage|::ByteResult {object:target,length:staged.length}
 }
}
