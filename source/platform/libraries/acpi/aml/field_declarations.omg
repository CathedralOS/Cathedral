// SPDX-License-Identifier: MIT OR Apache-2.0
// Field/IndexField/BankField syntax adapted from rust-osdev/acpi
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5; copyright 2018 Isaac Woods.
// Cathedral bounded metadata adaptation 2026. No namespace installation or I/O.
use model.omg;
use bytes.omg;
use names.omg;
use values.omg;
use field_model.omg;
use field_elements.omg;

pub machine parse_declaration(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,bit_limit:u64,budget:u64)->|field_model|::DeclarationResult {
 let good_scope:bool=|names|::path_valid(scope);
 transition end<=1024 && at<=end && budget<=1024 && good_scope && scope.absolute && scope.parents==0 {
  true -> start(input,end,at,unit,scope,bit_limit,budget) _ -> (|field_model|::DeclarationResult {outcome:|model|::Outcome::InvalidState,offset:at})
 }
 state start(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,bit_limit:u64,budget:u64)->|field_model|::DeclarationResult {
  let mut out:|field_model|::DeclarationResult=|field_model|::DeclarationResult {offset:at,declaration:|field_model|::Declaration {scope:scope,source:|model|::Span {unit:unit,start:at}}};
  let result:|model|::Outcome=declaration_header(input,end,at,&mut out);out.outcome=result;
  transition result==|model|::Outcome::Success {true -> fields(input,out,bit_limit,budget) _ -> (out)}
 }
 state fields(input:&[u8;1024],value:|field_model|::DeclarationResult,bit_limit:u64,budget:u64)->|field_model|::DeclarationResult {
  let parsed:|field_model|::ListState=|field_elements|::parse_list(input,value.declaration.source.end,value.next,value.declaration.source.unit,value.declaration.scope,value.declaration.flags,bit_limit,budget);
  let mut out:|field_model|::DeclarationResult=value;out.list=parsed;out.outcome=parsed.outcome;out.offset=parsed.offset;
  transition parsed.outcome==|model|::Outcome::Success {true -> complete(out) _ -> (out)}
 }
 state complete(value:|field_model|::DeclarationResult)->|field_model|::DeclarationResult {let mut out:|field_model|::DeclarationResult=value;out.next=out.declaration.source.end;out}
}
machine declaration_header(input:&[u8;1024],end:u64,at:u64,out:&mut |field_model|::DeclarationResult)->|model|::Outcome {
 let op:|model|::Read=|bytes|::opcode(input,end,at);
 transition op.outcome==|model|::Outcome::Success {true -> kind(input,end,op,out) _ -> (op.outcome)}
 state kind(input:&[u8;1024],end:u64,op:|model|::Read,out:&mut |field_model|::DeclarationResult)->|model|::Outcome {
  transition op.value {
   0x5b81 -> body(input,end,op.next,out,|field_model|::DeclarationKind::Field)
   0x5b86 -> body(input,end,op.next,out,|field_model|::DeclarationKind::Index)
   0x5b87 -> body(input,end,op.next,out,|field_model|::DeclarationKind::Bank)
   _ -> (|model|::Outcome::UnsupportedSyntax)
  }
 }
 state body(input:&[u8;1024],end:u64,at:u64,out:&mut |field_model|::DeclarationResult,kind:|field_model|::DeclarationKind)->|model|::Outcome {
  let body:|model|::Envelope=|bytes|::envelope(input,end,at);out.declaration.kind=kind;out.offset=at;
  transition body.outcome==|model|::Outcome::Success {true -> first(input,out,body) _ -> (body.outcome)}
 }
 state first(input:&[u8;1024],out:&mut |field_model|::DeclarationResult,body:|model|::Envelope)->|model|::Outcome {
  out.declaration.source.end=body.end;out.offset=body.body;
  let name:|model|::PathResult=|names|::namestring(input,body.end,body.body);
  transition name.outcome==|model|::Outcome::Success {true -> first_valid(input,out,name) _ -> (name.outcome)}
 }
 state first_valid(input:&[u8;1024],out:&mut |field_model|::DeclarationResult,name:|model|::PathResult)->|model|::Outcome {
  transition name.value.count>0 {true -> first_store(input,out,name) _ -> (|model|::Outcome::InvalidName)}
 }
 state first_store(input:&[u8;1024],out:&mut |field_model|::DeclarationResult,name:|model|::PathResult)->|model|::Outcome {
  out.declaration.primary_name=name.value;out.next=name.next;out.offset=name.next;
  transition out.declaration.kind {|field_model|::DeclarationKind::Field -> flags(input,out) _ -> second(input,out)}
 }
 state second(input:&[u8;1024],out:&mut |field_model|::DeclarationResult)->|model|::Outcome {
  let name:|model|::PathResult=|names|::namestring(input,out.declaration.source.end,out.next);
  transition name.outcome==|model|::Outcome::Success {true -> second_valid(input,out,name) _ -> (name.outcome)}
 }
 state second_valid(input:&[u8;1024],out:&mut |field_model|::DeclarationResult,name:|model|::PathResult)->|model|::Outcome {
  transition name.value.count>0 {true -> second_store(input,out,name) _ -> (|model|::Outcome::InvalidName)}
 }
 state second_store(input:&[u8;1024],out:&mut |field_model|::DeclarationResult,name:|model|::PathResult)->|model|::Outcome {
  out.declaration.secondary_name=name.value;out.next=name.next;out.offset=name.next;
  transition out.declaration.kind {|field_model|::DeclarationKind::Bank -> bank(input,out) _ -> flags(input,out)}
 }
 state bank(input:&[u8;1024],out:&mut |field_model|::DeclarationResult)->|model|::Outcome {
  let value:|model|::Read=|values|::integer(input,out.declaration.source.end,out.next);
  transition value.outcome {
   |model|::Outcome::Success -> bank_store(input,out,value)
   |model|::Outcome::UnsupportedSyntax -> bank_pending(out)
   _ -> (value.outcome)
  }
 }
 state bank_store(input:&[u8;1024],out:&mut |field_model|::DeclarationResult,value:|model|::Read)->|model|::Outcome {out.declaration.bank_value=value.value;out.next=value.next;out.offset=value.next;transition {_ -> flags(input,out)}}
 state bank_pending(out:&mut |field_model|::DeclarationResult)->|model|::Outcome {
  out.pending=|field_model|::Pending::BankTermArgRemainder {unparsed:|model|::Span {unit:out.declaration.source.unit,start:out.next,end:out.declaration.source.end}};
  |model|::Outcome::UnsupportedSyntax
 }
 state flags(input:&[u8;1024],out:&mut |field_model|::DeclarationResult)->|model|::Outcome {
  let flags:|model|::Read=|bytes|::read_le(input,out.declaration.source.end,out.next,1);
  transition flags.outcome==|model|::Outcome::Success {true -> flags_store(out,flags) _ -> (flags.outcome)}
 }
 state flags_store(out:&mut |field_model|::DeclarationResult,flags:|model|::Read)->|model|::Outcome {
  out.declaration.flags=(flags.value&255) as u8;out.next=flags.next;
  out.declaration.field_list=|model|::Span {unit:out.declaration.source.unit,start:flags.next,end:out.declaration.source.end};|model|::Outcome::Success
 }
}
