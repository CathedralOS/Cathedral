// Modified do_to_dec_hex_string value composition from rust-osdev/acpi
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// Direct data only: no operand/reference resolution, target store or retirement.
use model.omg;
use byte_storage.omg;
use object_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/string_numbers.omg;
use {integer_helpers}/conversions.omg;

pub data NumericStringResult [copy] {
 case Failure(reason:|object_conversions|::ConversionFailure);
 case String(length:u64,bytes:[u8;256]);
}

pub machine convert(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,format:|string_numbers|::NumberFormat)->NumericStringResult {
 let count:u64=store.space.object_count;
 transition count<=64 && object<count && object<64 {
  true -> selected(input,length,unit,store,object,size,format)
  _ -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
 state selected(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,format:|string_numbers|::NumberFormat)->NumericStringResult {
  transition store.space.objects[object].value {
   |model|::Value::Integer {number} -> integer(number,size,format)
   |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,object,format,false)
   |model|::Value::String {string_storage} -> bytes(input,length,unit,store,object,format,true)
   _ -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  }
 }
 state integer(number:u64,size:|integers|::IntegerSize,format:|string_numbers|::NumberFormat)->NumericStringResult {
  let mut output:[u8;256];
  let result:|integers|::IntegerResult=|string_numbers|::integer_to_string(size,number,format,256,&mut output);
  let out:NumericStringResult=ns_formatted(result,output);out
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,format:|string_numbers|::NumberFormat,string:bool)->NumericStringResult {
  let snapshot:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,object);
  let failure:NumericStringResult=ns_storage_failure(snapshot.outcome);
  transition snapshot.outcome==|byte_storage|::ByteOutcome::Success {true -> format_bytes(snapshot,format,string) _ -> (failure)}
 }
 state format_bytes(snapshot:|byte_storage|::ByteRead,format:|string_numbers|::NumberFormat,string:bool)->NumericStringResult {
  let count:u64=snapshot.length;
  transition string {true -> identity(snapshot,count) _ -> numeric(snapshot,count,format)}
 }
 state identity(snapshot:|byte_storage|::ByteRead,count:u64)->NumericStringResult {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|conversions|::mid(&snapshot.bytes,count,0,count,&mut output);
  let out:NumericStringResult=ns_formatted(copied,output);out
 }
 state numeric(snapshot:|byte_storage|::ByteRead,count:u64,format:|string_numbers|::NumberFormat)->NumericStringResult {
  let mut output:[u8;256];let formatted:|integers|::IntegerResult=|string_numbers|::buffer_to_numeric_string(&snapshot.bytes,count,format,256,&mut output);
  let out:NumericStringResult=ns_formatted(formatted,output);out
 }
}
machine ns_formatted(result:|integers|::IntegerResult,bytes:[u8;256])->NumericStringResult {
 transition result.error {
  0 -> (NumericStringResult::String {length:result.value,bytes:bytes})
  4 -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
  7 -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
  _ -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
machine ns_storage_failure(error:|byte_storage|::ByteOutcome)->NumericStringResult {
 transition error {
  |byte_storage|::ByteOutcome::Capacity -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
  |byte_storage|::ByteOutcome::Bounds -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::Bounds})
  |byte_storage|::ByteOutcome::Encoding -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
  |byte_storage|::ByteOutcome::UnsupportedValue -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  |byte_storage|::ByteOutcome::ReferenceCycle -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::ReferenceCycle})
  |byte_storage|::ByteOutcome::WorkLimit -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::WorkLimit})
  _ -> (NumericStringResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
