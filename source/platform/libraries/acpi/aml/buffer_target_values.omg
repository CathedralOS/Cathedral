// SPDX-License-Identifier: MIT OR Apache-2.0
// Pure target-sized component alongside rust-osdev/acpi Object::
// replace_with_implicit_casting, pin 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5.
// Copyright 2018 Isaac Woods. ACPI 6.6 Table 19.7 existing Buffer extent profile.
use model.omg;
use byte_storage.omg;
use object_conversions.omg;
use implicit_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/conversions.omg;

// extent 0..256 is ordinary caller-supplied geometry, not evidence of a target.
// ID/count -> extent -> source type -> full String admission -> preparation.
// Empty String at a positive extent remains a local profile exclusion.
// No lookup, allocation, reference evaluation, target mutation or Store execution.
pub machine prepare_buffer_extent(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,size:|integers|::IntegerSize,extent:u64)->|implicit_conversions|::ImplicitResult {
 let count:u64=store.space.object_count;
 transition count<=64 && source<count && source<64 {true -> bounded(input,length,unit,store,source,size,extent) _ -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state bounded(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,size:|integers|::IntegerSize,extent:u64)->|implicit_conversions|::ImplicitResult {
  transition {extent>256 -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity}) _ -> selected(input,length,unit,store,source,size,extent)}
 }
 state selected(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,size:|integers|::IntegerSize,extent:u64)->|implicit_conversions|::ImplicitResult {
  transition store.space.objects[source].value {
   |model|::Value::Integer {number} -> integer(number,size,extent)
   |model|::Value::String {string_storage} -> string(input,length,unit,store,source,extent)
   _ -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  }
 }
 state integer(number:u64,size:|integers|::IntegerSize,extent:u64)->|implicit_conversions|::ImplicitResult {
  let mut bytes:[u8;256];let packed:|integers|::IntegerResult=|conversions|::integer_to_buffer(size,number,&mut bytes);
  let result:|implicit_conversions|::ImplicitResult=fit(&bytes,packed.value,extent);
  transition packed.error==0 {true -> (result) _ -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state string(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,extent:u64)->|implicit_conversions|::ImplicitResult {
  let bytes:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,source);let failure:|implicit_conversions|::ImplicitResult=storage_failure(bytes.outcome);
  transition bytes.outcome==|byte_storage|::ByteOutcome::Success {true -> nonempty(bytes,extent) _ -> (failure)}
 }
 state nonempty(bytes:|byte_storage|::ByteRead,extent:u64)->|implicit_conversions|::ImplicitResult {
  let count:u64=bytes.length;
  transition count>0 || extent==0 {true -> string_value(bytes,count,extent) _ -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Empty})}
 }
 state string_value(bytes:|byte_storage|::ByteRead,count:u64,extent:u64)->|implicit_conversions|::ImplicitResult {let result:|implicit_conversions|::ImplicitResult=fit(&bytes.bytes,count,extent);result}
}
// Initialized zeros provide String termination when it fits, full-target padding,
// and zero output tails. A 256-character String never needs a 257-byte temporary.
machine fit(bytes:&[u8;256],count:u64,extent:u64)->|implicit_conversions|::ImplicitResult {
 let mut output:[u8;256];let copied:|integers|::IntegerResult=|conversions|::mid(bytes,count,0,extent,&mut output);
 transition copied.error==0 {true -> (|implicit_conversions|::ImplicitResult::Buffer {length:extent,bytes:output}) _ -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
}
machine storage_failure(outcome:|byte_storage|::ByteOutcome)->|implicit_conversions|::ImplicitResult {
 transition outcome {
  |byte_storage|::ByteOutcome::Capacity -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
  |byte_storage|::ByteOutcome::Bounds -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Bounds})
  |byte_storage|::ByteOutcome::Encoding -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
  |byte_storage|::ByteOutcome::UnsupportedValue -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  |byte_storage|::ByteOutcome::ReferenceCycle -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::ReferenceCycle})
  |byte_storage|::ByteOutcome::WorkLimit -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::WorkLimit})
  _ -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
