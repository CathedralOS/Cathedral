use {omega}/language/core/nat.omg;
use model.omg;
use bytes.omg;
use names.omg;
use values.omg;
use field_model.omg;
use field_flags.omg;

pub machine parse_list(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,flags:u8,bit_limit:u64,budget:u64)->|field_model|::ListState {
 let checked:|field_model|::AccessResult=|field_flags|::decode_flags(flags);let valid:bool=|names|::path_valid(scope);
 transition end<=1024 && at<=end && budget<=1024 && scope.absolute && scope.parents==0 && valid {
  true -> start(input,end,at,unit,scope,checked,bit_limit,budget) _ -> (|field_model|::ListState {outcome:|model|::Outcome::InvalidState,offset:at})
 }
 state start(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,checked:|field_model|::AccessResult,bit_limit:u64,budget:u64)->|field_model|::ListState {
  let mut out:|field_model|::ListState=|field_model|::ListState {outcome:checked.outcome,offset:at,at:at,end:end,unit:unit,scope:scope,access:checked.access,bit_limit:bit_limit,done:checked.outcome==|model|::Outcome::Success && at==end};
  let result:|model|::Outcome=field_list_driver(input,&mut out,0,budget);
  transition result==|model|::Outcome::Success && out.at!=out.end {true -> exhausted(out) _ -> (out)}
 }
 state exhausted(value:|field_model|::ListState)->|field_model|::ListState {let mut out:|field_model|::ListState=value;out.outcome=|model|::Outcome::WorkLimit;out.offset=out.at;out}
}
machine field_list_driver(input:&[u8;1024],out:&mut |field_model|::ListState,index:u64,budget:u64)
terminates by (index,budget) -> |nat|::Nat::BoundedDistance;
-> |model|::Outcome {
 let result:|model|::Outcome=field_list_turn(input,out,index,budget);
 transition index<budget {true -> field_list_driver(input,out,index+1,budget) _ -> (result)}
}
machine field_list_turn(input:&[u8;1024],out:&mut |field_model|::ListState,index:u64,budget:u64)->|model|::Outcome {
 transition index<budget && out.outcome==|model|::Outcome::Success && out.at<out.end {
  true -> consume(input,out) _ -> (out.outcome)
 }
 state consume(input:&[u8;1024],out:&mut |field_model|::ListState)->|model|::Outcome {
  out.offset=out.at;let lead:|model|::Read=|bytes|::read_le(input,out.end,out.at,1);
  let result:|model|::Outcome=field_element(input,out,lead);out.outcome=result;out.done=out.at==out.end;result
 }
}
machine field_element(input:&[u8;1024],out:&mut |field_model|::ListState,lead:|model|::Read)->|model|::Outcome {
 transition lead.outcome==|model|::Outcome::Success {
  true -> choose(input,out,lead) _ -> (lead.outcome)
 }
 state choose(input:&[u8;1024],out:&mut |field_model|::ListState,lead:|model|::Read)->|model|::Outcome {
  transition lead.value {
   0 -> reserved(input,out,lead.next)
   1 -> access(input,out,lead.next,false)
   2 -> connect(input,out,lead.next)
   3 -> access(input,out,lead.next,true)
   _ -> named(input,out)
  }
 }
 state reserved(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64)->|model|::Outcome {let result:|model|::Outcome=reserved_field(input,out,at);result}
 state access(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64,extended:bool)->|model|::Outcome {let result:|model|::Outcome=access_field(input,out,at,extended);result}
 state connect(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64)->|model|::Outcome {let result:|model|::Outcome=connect_field(input,out,at);result}
 state named(input:&[u8;1024],out:&mut |field_model|::ListState)->|model|::Outcome {let result:|model|::Outcome=named_field(input,out);result}
}
machine advance_bits(offset:u64,limit:u64,length:u64)->|model|::Read {
 transition offset<=limit {true -> room(offset,limit,length) _ -> (|model|::Read {outcome:|model|::Outcome::InvalidState})}
 state room(offset:u64,limit:u64,length:u64)->|model|::Read {
  let available:u64=limit-offset;
  transition length<=available {true -> (|model|::Read {value:offset+length}) _ -> (|model|::Read {outcome:|model|::Outcome::Capacity})}
 }
}
machine reserved_field(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64)->|model|::Outcome {
 let size:|model|::Read=|bytes|::pkg_length(input,out.end,at);
 transition size.outcome==|model|::Outcome::Success {true -> append(out,size) _ -> (size.outcome)}
 state append(out:&mut |field_model|::ListState,size:|model|::Read)->|model|::Outcome {
  let offset:u64=out.bit_offset;let limit:u64=out.bit_limit;let length:u64=size.value;
  let next:|model|::Read=advance_bits(offset,limit,length);
  transition next.outcome==|model|::Outcome::Success {true -> advance(out,size,next.value) _ -> (next.outcome)}
 }
 state advance(out:&mut |field_model|::ListState,size:|model|::Read,next:u64)->|model|::Outcome {out.bit_offset=next;out.at=size.next;|model|::Outcome::Success}
}
machine named_field(input:&[u8;1024],out:&mut |field_model|::ListState)->|model|::Outcome {
 let segment:|model|::Read=|bytes|::read_le(input,out.end,out.at,4);let good:bool=|names|::segment_valid((segment.value&0xffffffff) as u32);
 transition segment.outcome==|model|::Outcome::Success {true -> name(input,out,segment,good) _ -> (segment.outcome)}
 state name(input:&[u8;1024],out:&mut |field_model|::ListState,segment:|model|::Read,good:bool)->|model|::Outcome {
  transition good {true -> length(input,out,segment) _ -> (|model|::Outcome::InvalidName)}
 }
 state length(input:&[u8;1024],out:&mut |field_model|::ListState,segment:|model|::Read)->|model|::Outcome {
  let mut relative:|model|::Path=|model|::Path {count:1};relative.segments[0]=(segment.value&0xffffffff) as u32;
  let path:|model|::PathResult=|names|::resolve(relative,out.scope);let size:|model|::Read=|bytes|::pkg_length(input,out.end,segment.next);
  transition path.outcome==|model|::Outcome::Success {true -> size_checked(out,path.value,size) _ -> (path.outcome)}
 }
 state size_checked(out:&mut |field_model|::ListState,path:|model|::Path,size:|model|::Read)->|model|::Outcome {
  transition size.outcome==|model|::Outcome::Success {true -> bounds(out,path,size) _ -> (size.outcome)}
 }
 state bounds(out:&mut |field_model|::ListState,path:|model|::Path,size:|model|::Read)->|model|::Outcome {
  let offset:u64=out.bit_offset;let limit:u64=out.bit_limit;let length:u64=size.value;
  let next:|model|::Read=advance_bits(offset,limit,length);
  transition next.outcome==|model|::Outcome::Success {true -> store(out,path,size,next.value) _ -> (next.outcome)}
 }
 state store(out:&mut |field_model|::ListState,path:|model|::Path,size:|model|::Read,next:u64)->|model|::Outcome {
  let field:|field_model|::Field=|field_model|::Field {name:path,bit_offset:out.bit_offset,bit_length:size.value,access:out.access,connection:out.connection,source:|model|::Span {unit:out.unit,start:out.at,end:size.next}};
  let index:u64=out.count;
  transition index<32 {true -> slot(out,field,size,next,index) _ -> (|model|::Outcome::Capacity)}
 }
 state slot(out:&mut |field_model|::ListState,field:|field_model|::Field,size:|model|::Read,next:u64,index:u64)->|model|::Outcome {
  out.fields[index]=field;out.count=index+1;out.bit_offset=next;out.at=size.next;|model|::Outcome::Success
 }

}
machine access_field(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64,extended:bool)->|model|::Outcome {
 let width:u64=match extended {true -> 3 _ -> 2};let bytes:|model|::Read=|bytes|::read_le(input,out.end,at,width);
 transition bytes.outcome==|model|::Outcome::Success {true -> apply(out,bytes,extended) _ -> (bytes.outcome)}
 state apply(out:&mut |field_model|::ListState,bytes:|model|::Read,extended:bool)->|model|::Outcome {
  let type_byte:u8=(bytes.value&255) as u8;let attribute:u8=((bytes.value>>8)&255) as u8;let length:u8=((bytes.value>>16)&255) as u8;
  let changed:|field_model|::AccessResult=|field_flags|::change_access(out.access,type_byte,attribute,extended,length);
  transition changed.outcome==|model|::Outcome::Success {true -> store(out,bytes.next,changed.access) _ -> (changed.outcome)}
 }
 state store(out:&mut |field_model|::ListState,next:u64,value:|field_model|::Access)->|model|::Outcome {out.access=value;out.at=next;|model|::Outcome::Success}
}
machine connect_field(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64)->|model|::Outcome {
 let lead:|model|::Read=|bytes|::read_le(input,out.end,at,1);
 transition lead.outcome==|model|::Outcome::Success {true -> choose(input,out,at,lead) _ -> (lead.outcome)}
 state choose(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64,lead:|model|::Read)->|model|::Outcome {
  transition lead.value==0x11 {true -> buffer(input,out,at,lead.next) _ -> name(input,out,at)}
 }
 state name(input:&[u8;1024],out:&mut |field_model|::ListState,at:u64)->|model|::Outcome {
  let name:|model|::PathResult=|names|::namestring(input,out.end,at);
  transition name.outcome==|model|::Outcome::Success {true -> name_valid(out,name) _ -> (name.outcome)}
 }
 state name_valid(out:&mut |field_model|::ListState,name:|model|::PathResult)->|model|::Outcome {transition name.value.count>0 {true -> install_name(out,name) _ -> (|model|::Outcome::InvalidName)}}
 state install_name(out:&mut |field_model|::ListState,name:|model|::PathResult)->|model|::Outcome {out.connection=|field_model|::Connection::Name {connection_name:name.value};out.at=name.next;|model|::Outcome::Success}
 state buffer(input:&[u8;1024],out:&mut |field_model|::ListState,start:u64,at:u64)->|model|::Outcome {
  let body:|model|::Envelope=|bytes|::envelope(input,out.end,at);
  transition body.outcome==|model|::Outcome::Success {true -> size(input,out,start,body) _ -> (body.outcome)}
 }
 state size(input:&[u8;1024],out:&mut |field_model|::ListState,start:u64,body:|model|::Envelope)->|model|::Outcome {
  let size:|model|::Read=|values|::integer(input,body.end,body.body);
  transition size.outcome {
   |model|::Outcome::Success -> known(out,start,body,size)
   |model|::Outcome::UnsupportedSyntax -> pending(out,start,body)
   _ -> (size.outcome)
  }
 }
 state known(out:&mut |field_model|::ListState,start:u64,body:|model|::Envelope,size:|model|::Read)->|model|::Outcome {
  out.connection=|field_model|::Connection::Buffer {buffer_encoding:|model|::Span {unit:out.unit,start:start,end:body.end},size_known:true,declared_size:size.value,initializer:|model|::Span {unit:out.unit,start:size.next,end:body.end}};
  out.at=body.end;|model|::Outcome::Success
 }
 state pending(out:&mut |field_model|::ListState,start:u64,body:|model|::Envelope)->|model|::Outcome {
  out.connection=|field_model|::Connection::Buffer {buffer_encoding:|model|::Span {unit:out.unit,start:start,end:body.end}};out.at=body.end;|model|::Outcome::Success
 }
}
