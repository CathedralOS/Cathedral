use {omega}/language/core/nat.omg;
use model.omg;
use bytes.omg;
use names.omg;
use namespace.omg;
pub machine integer(input:&[u8;1024],end:u64,at:u64)->|model|::Read {
 let token:|model|::Read=|bytes|::opcode(input,end,at);
 transition token.outcome==|model|::Outcome::Success {true -> choose(input,end,at,token) _ -> (token)}
 state choose(input:&[u8;1024],end:u64,at:u64,token:|model|::Read)->|model|::Read {
  transition token.value {
   0 -> (|model|::Read {next:token.next}) 1 -> (|model|::Read {value:1,next:token.next})
   255 -> (|model|::Read {value:0xffffffffffffffff,next:token.next})
   0x5b30 -> (|model|::Read {value:2,next:token.next})
   10 -> call_read_le_0(input,end,token.next,1) 11 -> call_read_le_1(input,end,token.next,2)
   12 -> call_read_le_2(input,end,token.next,4) 14 -> call_read_le_3(input,end,token.next,8)
   _ -> (|model|::Read {outcome:|model|::Outcome::UnsupportedSyntax,offset:at})
  }
 }

 state call_read_le_0(input: &[u8; 1024], end: u64, at: u64, width: u64) -> |model|::Read {let result:|model|::Read=|bytes|::read_le(input,end,at,width);result}

 state call_read_le_1(input: &[u8; 1024], end: u64, at: u64, width: u64) -> |model|::Read {let result:|model|::Read=|bytes|::read_le(input,end,at,width);result}

 state call_read_le_2(input: &[u8; 1024], end: u64, at: u64, width: u64) -> |model|::Read {let result:|model|::Read=|bytes|::read_le(input,end,at,width);result}

 state call_read_le_3(input: &[u8; 1024], end: u64, at: u64, width: u64) -> |model|::Read {let result:|model|::Read=|bytes|::read_le(input,end,at,width);result}
}
pub machine atom(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,allow_reference:bool)->|model|::ValueRead {
 let literal:|model|::Read=integer(input,end,at);
 transition literal.outcome==|model|::Outcome::Success {
  true -> (|model|::ValueRead {value:|model|::Value::Integer {number:literal.value},next:literal.next})
  _ -> other(input,end,at,unit,scope,allow_reference,literal)
 }
 state other(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,allow_reference:bool,literal:|model|::Read)->|model|::ValueRead {
  let token:|model|::Read=|bytes|::read_le(input,end,at,1);
  transition token.outcome==|model|::Outcome::Success {true -> choose(input,end,at,unit,scope,allow_reference,token) _ -> (|model|::ValueRead {outcome:token.outcome,offset:token.offset})}
 }
 state choose(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,allow_reference:bool,token:|model|::Read)->|model|::ValueRead {
  transition token.value {13 -> string(input,end,token.next,unit) 17 -> buffer(input,end,token.next,unit) _ -> reference(input,end,at,scope,allow_reference)}
 }
 state reference(input:&[u8;1024],end:u64,at:u64,scope:|model|::Path,allow_reference:bool)->|model|::ValueRead {
  transition allow_reference {true -> parse_reference(input,end,at,scope) _ -> (|model|::ValueRead {outcome:|model|::Outcome::UnsupportedSyntax,offset:at})}
 }
 state parse_reference(input:&[u8;1024],end:u64,at:u64,scope:|model|::Path)->|model|::ValueRead {
  let parsed:|model|::PathResult=|names|::namestring(input,end,at);
  transition parsed.outcome==|model|::Outcome::Success && parsed.value.count>0 {
   true -> (|model|::ValueRead {value:|model|::Value::NameReference {name:parsed.value,scope:scope},next:parsed.next})
   _ -> reference_failure(parsed)
  }
 }
 state reference_failure(parsed:|model|::PathResult)->|model|::ValueRead {transition parsed.outcome==|model|::Outcome::Success {true -> (|model|::ValueRead {outcome:|model|::Outcome::InvalidName,offset:parsed.next}) _ -> (|model|::ValueRead {outcome:parsed.outcome,offset:parsed.offset})}}
 state string(input:&[u8;1024],end:u64,at:u64,unit:u64)->|model|::ValueRead {
  let initial:|model|::Read=|model|::Read {next:at};let parsed:|model|::Read=string_loop(input,end,at,initial);
  transition parsed.outcome==|model|::Outcome::Success && parsed.value==1 {
   true -> string_value(at,unit,parsed) _ -> string_failure(parsed)
  }
 }
 state string_failure(parsed:|model|::Read)->|model|::ValueRead {transition parsed.outcome==|model|::Outcome::Success {true -> (|model|::ValueRead {outcome:|model|::Outcome::Truncated,offset:parsed.next}) _ -> (|model|::ValueRead {outcome:parsed.outcome,offset:parsed.next})}}
 state string_value(at:u64,unit:u64,parsed:|model|::Read)->|model|::ValueRead {
  transition parsed.next>0 {true -> (|model|::ValueRead {value:|model|::Value::String {string_storage:|model|::StringStorage::Source {string_source:|model|::Span {unit:unit,start:at,end:parsed.next-1}}},next:parsed.next}) _ -> (|model|::ValueRead {outcome:|model|::Outcome::BadEncoding,offset:at})}
 }
 state buffer(input:&[u8;1024],end:u64,at:u64,unit:u64)->|model|::ValueRead {
  let package:|model|::Envelope=|bytes|::envelope(input,end,at);
  transition package.outcome==|model|::Outcome::Success {true -> buffer_size(input,package,unit) _ -> (|model|::ValueRead {outcome:package.outcome,offset:package.offset})}
 }
 state buffer_size(input:&[u8;1024],package:|model|::Envelope,unit:u64)->|model|::ValueRead {
  let size:|model|::Read=integer(input,package.end,package.body);
  transition size.outcome==|model|::Outcome::Success {
   true -> (|model|::ValueRead {value:|model|::Value::Buffer {buffer_storage:|model|::BufferStorage::Source {declared_size:size.value,buffer_initializer:|model|::Span {unit:unit,start:size.next,end:package.end}}},next:package.end})
   _ -> (|model|::ValueRead {outcome:size.outcome,offset:size.offset})
  }
 }
}
machine string_loop(input:&[u8;1024],end:u64,index:u64,value:|model|::Read)
terminates by (index,end) -> |nat|::Nat::BoundedDistance;
-> |model|::Read {
 let next:|model|::Read=string_step(input,end,index,value);
 transition index<end {true -> string_loop(input,end,index+1,next) _ -> (value)}
}
machine string_step(input:&[u8;1024],end:u64,index:u64,value:|model|::Read)->|model|::Read {
 let byte:|model|::Read=|bytes|::read_le(input,end,index,1);
 transition value.value==0 && value.outcome==|model|::Outcome::Success && byte.outcome==|model|::Outcome::Success {
  true -> classify(byte) _ -> (value)
 }
 state classify(byte:|model|::Read)->|model|::Read {
  transition byte.value {0 -> (|model|::Read {value:1,next:byte.next}) _ -> ascii(byte)}
 }
 state ascii(byte:|model|::Read)->|model|::Read {
  transition byte.value<=127 {true -> (|model|::Read {next:byte.next}) _ -> (|model|::Read {outcome:|model|::Outcome::BadEncoding,next:byte.next})}
 }
}
machine frame_at(value:|model|::ValueState,index:u64)->|model|::PackageFrame {transition index<8 {true -> (value.frames[index]) _ -> (|model|::PackageFrame {})}}
machine frame_set(value:|model|::ValueState,index:u64,frame:|model|::PackageFrame)->|model|::ValueState {
 transition index<8 {true -> set(value,index,frame) _ -> (value)}
 state set(value:|model|::ValueState,index:u64,frame:|model|::PackageFrame)->|model|::ValueState {let mut out:|model|::ValueState=value;out.frames[index]=frame;out}
}
machine fail(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64)->|model|::ValueState {let mut out:|model|::ValueState=value;out.outcome=outcome;out.offset=offset;out.done=true;out}
pub machine parse_value(input:&[u8;1024],end:u64,at:u64,unit:u64,scope:|model|::Path,space:|model|::Namespace,allow_reference:bool,budget:u64)->|model|::ValueState {
 let initial:|model|::ValueState=|model|::ValueState {space:space,at:at,end:end,unit:unit,scope:scope,allow_reference:allow_reference};
 transition end<=1024 && at<=end && budget<=1024 {
  true -> run(input,initial,budget) _ -> (|model|::ValueState {outcome:|model|::Outcome::InvalidState,space:space,offset:at,done:true})
 }
 state run(input:&[u8;1024],initial:|model|::ValueState,budget:u64)->|model|::ValueState {
  let result:|model|::ValueState=value_loop(input,initial,0,budget);
  transition result.done {true -> (result) _ -> exhausted(result)}
 }
 state exhausted(value:|model|::ValueState)->|model|::ValueState {let result:|model|::ValueState=fail(value,|model|::Outcome::WorkLimit,value.at);result}
}
machine value_loop(input:&[u8;1024],value:|model|::ValueState,index:u64,count:u64)
terminates by (index,count) -> |nat|::Nat::BoundedDistance;
-> |model|::ValueState {
 let next:|model|::ValueState=value_step(input,value);
 transition index<count {true -> value_loop(input,next,index+1,count) _ -> (value)}
}
machine value_step(input:&[u8;1024],value:|model|::ValueState)->|model|::ValueState {
 transition value.done {true -> (value) _ -> active(input,value)}
 state active(input:&[u8;1024],value:|model|::ValueState)->|model|::ValueState {
  transition value.depth>0 && value.depth<=8 {true -> package(input,value) _ -> item(input,value,value.end)}
 }
 state package(input:&[u8;1024],value:|model|::ValueState)->|model|::ValueState {
  let frame:|model|::PackageFrame=frame_at(value,value.depth-1);
  transition frame.remaining==0 {true -> close(value,frame) _ -> remaining(input,value,frame)}
 }
 state close(value:|model|::ValueState,frame:|model|::PackageFrame)->|model|::ValueState {
  transition value.at==frame.end {true -> pop(value,frame) _ -> call_fail_0(value,|model|::Outcome::BadEncoding,value.at)}
 }
 state pop(value:|model|::ValueState,frame:|model|::PackageFrame)->|model|::ValueState {
  let mut out:|model|::ValueState=value;out.depth=value.depth-1;let result:|model|::ValueState=attach(out,frame.object);result
 }
 state remaining(input:&[u8;1024],value:|model|::ValueState,frame:|model|::PackageFrame)->|model|::ValueState {
  transition value.at==frame.end {true -> missing(value) _ -> item(input,value,frame.end)}
 }
 state missing(value:|model|::ValueState)->|model|::ValueState {let empty:|model|::Value=|model|::Value::Uninitialized;let result:|model|::ValueState=store(value,empty,value.at);result}
 state item(input:&[u8;1024],value:|model|::ValueState,end:u64)->|model|::ValueState {
  let token:|model|::Read=|bytes|::read_le(input,end,value.at,1);
  transition token.outcome==|model|::Outcome::Success {true -> classify(input,value,end,token) _ -> call_fail_1(value,token.outcome,token.offset)}
 }
 state classify(input:&[u8;1024],value:|model|::ValueState,end:u64,token:|model|::Read)->|model|::ValueState {
  transition token.value {18 -> open(input,value,end,token,false) 19 -> open(input,value,end,token,true) _ -> literal(input,value,end)}
 }
 state literal(input:&[u8;1024],value:|model|::ValueState,end:u64)->|model|::ValueState {
  let parsed:|model|::ValueRead=atom(input,end,value.at,value.unit,value.scope,value.allow_reference||value.depth>0);
  transition parsed.outcome==|model|::Outcome::Success {true -> call_store_2(value,parsed.value,parsed.next) _ -> call_fail_3(value,parsed.outcome,parsed.offset)}
 }
 state open(input:&[u8;1024],value:|model|::ValueState,end:u64,token:|model|::Read,variable:bool)->|model|::ValueState {
  let package:|model|::Envelope=|bytes|::envelope(input,end,token.next);
  transition package.outcome==|model|::Outcome::Success {true -> count(input,value,package,variable) _ -> call_fail_4(value,package.outcome,package.offset)}
 }
 state count(input:&[u8;1024],value:|model|::ValueState,package:|model|::Envelope,variable:bool)->|model|::ValueState {
  transition variable {true -> variable_count(input,value,package) _ -> fixed_count(input,value,package)}
 }
 state fixed_count(input:&[u8;1024],value:|model|::ValueState,package:|model|::Envelope)->|model|::ValueState {
  let count:|model|::Read=|bytes|::read_le(input,package.end,package.body,1);let result:|model|::ValueState=open_package(value,package,count);result
 }
 state variable_count(input:&[u8;1024],value:|model|::ValueState,package:|model|::Envelope)->|model|::ValueState {
  let count:|model|::Read=integer(input,package.end,package.body);let result:|model|::ValueState=open_package(value,package,count);result
 }

 state call_fail_0(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}

 state call_fail_1(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}

 state call_store_2(value:|model|::ValueState,object:|model|::Value,next:u64) -> |model|::ValueState {let result:|model|::ValueState=store(value,object,next);result}

 state call_fail_3(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}

 state call_fail_4(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}
}
machine open_package(value:|model|::ValueState,package:|model|::Envelope,count:|model|::Read)->|model|::ValueState {
 transition count.outcome==|model|::Outcome::Success {true -> depth(value,package,count) _ -> call_fail_0(value,count.outcome,count.offset)}
 state depth(value:|model|::ValueState,package:|model|::Envelope,count:|model|::Read)->|model|::ValueState {
  transition value.depth<8 {true -> capacity(value,package,count) _ -> call_fail_1(value,|model|::Outcome::Depth,value.at)}
 }
 state capacity(value:|model|::ValueState,package:|model|::Envelope,count:|model|::Read)->|model|::ValueState {
  transition count.value<64 {true -> allocate_package(value,package,count) _ -> call_fail_2(value,|model|::Outcome::Capacity,value.at)}
 }
 state allocate_package(value:|model|::ValueState,package:|model|::Envelope,count:|model|::Read)->|model|::ValueState {
  let object:|model|::Value=|model|::Value::Package {count:count.value};let allocated:|model|::NamespaceResult=|namespace|::allocate(value.space,object);
  transition allocated.outcome==|model|::Outcome::Success {true -> push(value,package,count,allocated) _ -> call_fail_3(value,allocated.outcome,value.at)}
 }
 state push(value:|model|::ValueState,package:|model|::Envelope,count:|model|::Read,allocated:|model|::NamespaceResult)->|model|::ValueState {
  let frame:|model|::PackageFrame=|model|::PackageFrame {object:allocated.object,end:package.end,remaining:count.value,first:true};
  let mut out:|model|::ValueState=frame_set(value,value.depth,frame);out.space=allocated.space;out.depth=increment_depth(value.depth);out.at=count.next;out
 }

 state call_fail_0(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}

 state call_fail_1(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}

 state call_fail_2(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}

 state call_fail_3(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}
}
machine increment_depth(value:u64)->u64 {transition value<8 {true -> (value+1) _ -> (value)}}
machine store(value:|model|::ValueState,object:|model|::Value,next:u64)->|model|::ValueState {
 let allocated:|model|::NamespaceResult=|namespace|::allocate(value.space,object);
 transition allocated.outcome==|model|::Outcome::Success {true -> ready(value,next,allocated) _ -> call_fail_0(value,allocated.outcome,value.at)}
 state ready(value:|model|::ValueState,next:u64,allocated:|model|::NamespaceResult)->|model|::ValueState {
  let mut out:|model|::ValueState=value;out.space=allocated.space;out.at=next;let result:|model|::ValueState=attach(out,allocated.object);result
 }

 state call_fail_0(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}
}
machine attach(value:|model|::ValueState,object:u64)->|model|::ValueState {
 transition value.depth>0 && value.depth<=8 {true -> package(value,object) _ -> done(value,object)}
 state done(value:|model|::ValueState,object:u64)->|model|::ValueState {let mut out:|model|::ValueState=value;out.done=true;out.object=object;out}
 state package(value:|model|::ValueState,object:u64)->|model|::ValueState {
  let frame:|model|::PackageFrame=frame_at(value,value.depth-1);
  transition frame.remaining>0 {true -> link(value,object,frame) _ -> call_fail_0(value,|model|::Outcome::BadEncoding,value.at)}
 }
 state link(value:|model|::ValueState,object:u64,frame:|model|::PackageFrame)->|model|::ValueState {
  transition frame.first {true -> first(value,object,frame) _ -> next(value,object,frame)}
 }
 state first(value:|model|::ValueState,object:u64,frame:|model|::PackageFrame)->|model|::ValueState {
  let package:|model|::Object=|namespace|::object_at(value.space,frame.object);
  transition package.value {|model|::Value::Package {first,count} -> first_update(value,object,frame,count) _ -> call_fail_1(value,|model|::Outcome::InvalidState,value.at)}
 }
 state first_update(value:|model|::ValueState,object:u64,frame:|model|::PackageFrame,count:u64)->|model|::ValueState {
  let mut out:|model|::ValueState=value;let package:|model|::Object=|model|::Object {value:|model|::Value::Package {first:object,count:count}};
  out.space=|namespace|::object_set(value.space,frame.object,package);let result:|model|::ValueState=advance_frame(out,object,frame);result
 }
 state next(value:|model|::ValueState,object:u64,frame:|model|::PackageFrame)->|model|::ValueState {
  let mut prior:|model|::Object=|namespace|::object_at(value.space,frame.last);prior.has_next=true;prior.next=object;
  let mut out:|model|::ValueState=value;out.space=|namespace|::object_set(value.space,frame.last,prior);let result:|model|::ValueState=advance_frame(out,object,frame);result
 }

 state call_fail_0(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}

 state call_fail_1(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}
}
machine advance_frame(value:|model|::ValueState,object:u64,frame:|model|::PackageFrame)->|model|::ValueState {
 transition frame.remaining>0 && value.depth>0 {true -> commit(value,object,frame) _ -> call_fail_0(value,|model|::Outcome::InvalidState,value.at)}
 state commit(value:|model|::ValueState,object:u64,frame:|model|::PackageFrame)->|model|::ValueState {
  let mut next:|model|::PackageFrame=frame;next.remaining=frame.remaining-1;next.first=false;next.last=object;
  let result:|model|::ValueState=frame_set(value,value.depth-1,next);result
 }

 state call_fail_0(value:|model|::ValueState,outcome:|model|::Outcome,offset:u64) -> |model|::ValueState {let result:|model|::ValueState=fail(value,outcome,offset);result}
}
