use model.omg;
use byte_storage.omg;
use object_conversions.omg;
use {integer_helpers}/conversions.omg;
use {integer_helpers}/integers.omg;
pub data Portion [copy] {
 case Failure(reason:|object_conversions|::ConversionFailure);
 case Buffer(length:u64,bytes:[u8;256]);
 case String(length:u64,bytes:[u8;256]);
}
// Index and requested are already evaluated unsigned AML Integer values.
// Evaluation, width normalization and reference resolution belong to the caller.
pub machine extract(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,index:u64,requested:u64)->Portion {
 let count:u64=store.space.object_count;
 transition count<=64 && source<count && source<64 {true -> kind(input,length,unit,store,source,index,requested) _ -> (Portion::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state kind(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,index:u64,requested:u64)->Portion {
  transition store.space.objects[source].value {
   |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,source,index,requested)
   |model|::Value::String {string_storage} -> bytes(input,length,unit,store,source,index,requested)
   _ -> (Portion::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  }
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,index:u64,requested:u64)->Portion {
  let read:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,source);
  transition read.outcome==|byte_storage|::ByteOutcome::Success {true -> copy(read,index,requested) _ -> failed(read.outcome)}
 }
 state failed(error:|byte_storage|::ByteOutcome)->Portion {let reason:|object_conversions|::ConversionFailure=om_storage_failure(error);Portion::Failure {reason:reason}}
 state copy(read:|byte_storage|::ByteRead,index:u64,requested:u64)->Portion {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|conversions|::mid(&read.bytes,read.length,index,requested,&mut output);
  transition copied.error==0 {true -> result(read.kind,copied.value,output) _ -> (Portion::Failure {reason:|object_conversions|::ConversionFailure::Capacity})}
 }
 state result(kind:|byte_storage|::ByteKind,length:u64,bytes:[u8;256])->Portion {
  transition kind {|byte_storage|::ByteKind::Buffer -> (Portion::Buffer {length:length,bytes:bytes}) |byte_storage|::ByteKind::String -> (Portion::String {length:length,bytes:bytes})}
 }
}
machine om_storage_failure(error:|byte_storage|::ByteOutcome)->|object_conversions|::ConversionFailure {
 transition error {|byte_storage|::ByteOutcome::Capacity -> (|object_conversions|::ConversionFailure::Capacity) |byte_storage|::ByteOutcome::Bounds -> (|object_conversions|::ConversionFailure::Bounds)
 |byte_storage|::ByteOutcome::Encoding -> (|object_conversions|::ConversionFailure::Encoding) |byte_storage|::ByteOutcome::UnsupportedValue -> (|object_conversions|::ConversionFailure::UnsupportedValue)
 |byte_storage|::ByteOutcome::ReferenceCycle -> (|object_conversions|::ConversionFailure::ReferenceCycle) |byte_storage|::ByteOutcome::WorkLimit -> (|object_conversions|::ConversionFailure::WorkLimit)
 _ -> (|object_conversions|::ConversionFailure::InvalidState)}
}
