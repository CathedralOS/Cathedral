// SPDX-License-Identifier: MIT OR Apache-2.0
// Description-aware Concatenate component alongside rust-osdev/acpi do_concat,
// pin 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// Primary ACPI 6.6 Tables 19.30/19.31; direct data only, no opcode/target dispatch.
use model.omg;
use object_concat.omg;
use object_descriptions.omg;
use object_conversions.omg;
use implicit_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/conversions.omg;
use {integer_helpers}/byte_concat.omg;

pub machine concatenate(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize)->|object_concat|::Concatenated {
 let count:u64=store.space.object_count;
 transition count<=64 && left<count && left<64 {true -> admit(input,length,unit,store,left,right,size) _ -> (|object_concat|::Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state admit(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize)->|object_concat|::Concatenated {
  let target:|implicit_conversions|::ConversionTarget=cd_target(store.space.objects[left].value);
  let a:|implicit_conversions|::ImplicitResult=cd_admit(input,length,unit,store,left,size,target);
  transition a {|implicit_conversions|::ImplicitResult::Failure {reason} -> (|object_concat|::Concatenated::Failure {reason:reason}) _ -> select(input,length,unit,store,left,right,size,target,a)}
 }
 state select(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget,a:|implicit_conversions|::ImplicitResult)->|object_concat|::Concatenated {
  let left_basic:bool=cd_basic(store,left);let right_basic:bool=cd_basic(store,right);
  transition left_basic && right_basic {true -> delegated(input,length,unit,store,left,right,size) _ -> described(input,length,unit,store,right,size,target,a)}
 }
 state delegated(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize)->|object_concat|::Concatenated {
  // Bounded pure left admission repeats inside the established all-basic API.
  let result:|object_concat|::Concatenated=|object_concat|::concatenate(input,length,unit,store,left,right,size);result
 }
 state described(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,right:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget,a:|implicit_conversions|::ImplicitResult)->|object_concat|::Concatenated {
  let b:|implicit_conversions|::ImplicitResult=cd_admit(input,length,unit,store,right,size,target);
  let result:|object_concat|::Concatenated=cd_append(a,b);result
 }
}
machine cd_target(value:|model|::Value)->|implicit_conversions|::ConversionTarget {
 transition value {|model|::Value::Integer {number} -> (|implicit_conversions|::ConversionTarget::Integer) |model|::Value::Buffer {buffer_storage} -> (|implicit_conversions|::ConversionTarget::Buffer) _ -> (|implicit_conversions|::ConversionTarget::String)}
}
machine cd_basic(store:&|model|::ObjectStore,object:u64)->bool {
 let count:u64=store.space.object_count;
 transition count<=64 && object<count && object<64 {true -> kind(store.space.objects[object].value) _ -> (false)}
 state kind(value:|model|::Value)->bool {transition value {|model|::Value::Integer {number} -> (true) |model|::Value::Buffer {buffer_storage} -> (true) |model|::Value::String {string_storage} -> (true) _ -> (false)}}
}
machine cd_admit(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget)->|implicit_conversions|::ImplicitResult {
 let basic:bool=cd_basic(store,object);
 transition basic {true -> converted(input,length,unit,store,object,size,target) _ -> described(store,object,target)}
 state converted(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget)->|implicit_conversions|::ImplicitResult {let result:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,object,size,target);result}
 state described(store:&|model|::ObjectStore,object:u64,target:|implicit_conversions|::ConversionTarget)->|implicit_conversions|::ImplicitResult {
  // describe validates the slot even when cd_basic rejected its bounds.
  // Integer x nonbasic is a local excluded profile, not a normative ACPI error.
  let label:|object_descriptions|::Description=|object_descriptions|::describe(store,object);let result:|implicit_conversions|::ImplicitResult=cd_label(label,target);result
 }
}
machine cd_label(label:|object_descriptions|::Description,target:|implicit_conversions|::ConversionTarget)->|implicit_conversions|::ImplicitResult {
 transition label {
  |object_descriptions|::Description::Failure {reason} -> (|implicit_conversions|::ImplicitResult::Failure {reason:reason})
  |object_descriptions|::Description::String {length,bytes} -> selected(length,bytes,target)
 }
 state selected(length:u64,bytes:[u8;256],target:|implicit_conversions|::ConversionTarget)->|implicit_conversions|::ImplicitResult {
  transition target {
   |implicit_conversions|::ConversionTarget::String -> (|implicit_conversions|::ImplicitResult::String {length:length,bytes:bytes})
   |implicit_conversions|::ConversionTarget::Buffer -> buffer(length,bytes)
   |implicit_conversions|::ConversionTarget::Integer -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  }
 }
 state buffer(length:u64,bytes:[u8;256])->|implicit_conversions|::ImplicitResult {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|conversions|::string_to_buffer(&bytes,length,true,&mut output);
  transition {copied.error==0 -> (|implicit_conversions|::ImplicitResult::Buffer {length:copied.value,bytes:output}) copied.error==4 -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity}) copied.error==7 -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding}) _ -> (|implicit_conversions|::ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
}
machine cd_append(a:|implicit_conversions|::ImplicitResult,b:|implicit_conversions|::ImplicitResult)->|object_concat|::Concatenated {
 transition b {|implicit_conversions|::ImplicitResult::Failure {reason} -> (|object_concat|::Concatenated::Failure {reason:reason}) _ -> selected(a,b)}
 state selected(a:|implicit_conversions|::ImplicitResult,b:|implicit_conversions|::ImplicitResult)->|object_concat|::Concatenated {
  transition a {
   |implicit_conversions|::ImplicitResult::String {length,bytes} -> string(&bytes,length,b)
   |implicit_conversions|::ImplicitResult::Buffer {length,bytes} -> buffer(&bytes,length,b)
   _ -> (|object_concat|::Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
  }
 }
 state string(a:&[u8;256],length:u64,b:|implicit_conversions|::ImplicitResult)->|object_concat|::Concatenated {
  transition b {|implicit_conversions|::ImplicitResult::String {length as n,bytes} -> append(a,length,&bytes,n,true) _ -> (|object_concat|::Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state buffer(a:&[u8;256],length:u64,b:|implicit_conversions|::ImplicitResult)->|object_concat|::Concatenated {
  transition b {|implicit_conversions|::ImplicitResult::Buffer {length as n,bytes} -> append(a,length,&bytes,n,false) _ -> (|object_concat|::Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state append(a:&[u8;256],length:u64,b:&[u8;256],n:u64,string:bool)->|object_concat|::Concatenated {
  transition string {true -> strings(a,length,b,n) _ -> buffers(a,length,b,n)}
 }
 state strings(a:&[u8;256],length:u64,b:&[u8;256],n:u64)->|object_concat|::Concatenated {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|byte_concat|::concat_strings(a,length,b,n,&mut output,256);let result:|object_concat|::Concatenated=cd_output(copied,output,true);result
 }
 state buffers(a:&[u8;256],length:u64,b:&[u8;256],n:u64)->|object_concat|::Concatenated {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|byte_concat|::concat_buffers(a,length,b,n,&mut output,256);let result:|object_concat|::Concatenated=cd_output(copied,output,false);result
 }
}
machine cd_output(copied:|integers|::IntegerResult,bytes:[u8;256],string:bool)->|object_concat|::Concatenated {
 transition {copied.error==0 -> success(copied.value,bytes,string) copied.error==4 -> (|object_concat|::Concatenated::Failure {reason:|object_conversions|::ConversionFailure::Capacity}) copied.error==7 -> (|object_concat|::Concatenated::Failure {reason:|object_conversions|::ConversionFailure::Encoding}) _ -> (|object_concat|::Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state success(length:u64,bytes:[u8;256],string:bool)->|object_concat|::Concatenated {
  transition string {true -> (|object_concat|::Concatenated::String {length:length,bytes:bytes}) _ -> (|object_concat|::Concatenated::Buffer {length:length,bytes:bytes})}
 }
}
