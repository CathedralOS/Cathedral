// SPDX-License-Identifier: MIT OR Apache-2.0
// Primary basic-data Concatenate policy over licensed rust-osdev/acpi helpers.
// Direct Integer/String/Buffer IDs only; other object type-name formatting and
// reference/field evaluation are separate caller policies.
use model.omg;
use implicit_conversions.omg;
use object_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/byte_concat.omg;
pub data Concatenated [copy] {
 case Failure(reason:|object_conversions|::ConversionFailure);
 case Buffer(length:u64,bytes:[u8;256]);
 case String(length:u64,bytes:[u8;256]);
}
pub machine concatenate(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize)->Concatenated {
 let count:u64=store.space.object_count;
 transition count<=64 && left<count && left<64 {true -> kind(input,length,unit,store,left,right,size,store.space.objects[left].value) _ -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state kind(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,value:|model|::Value)->Concatenated {
  transition value {
   |model|::Value::Integer {number} -> selected(input,length,unit,store,left,right,size,|implicit_conversions|::ConversionTarget::Integer)
   |model|::Value::Buffer {buffer_storage} -> selected(input,length,unit,store,left,right,size,|implicit_conversions|::ConversionTarget::Buffer)
   |model|::Value::String {string_storage} -> selected(input,length,unit,store,left,right,size,|implicit_conversions|::ConversionTarget::String)
   _ -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  }
 }
 state selected(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,left:u64,right:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget)->Concatenated {
  let a:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,left,size,target);
  transition a {|implicit_conversions|::ImplicitResult::Failure {reason} -> (Concatenated::Failure {reason:reason}) _ -> other(input,length,unit,store,right,size,target,a)}
 }
 state other(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,right:u64,size:|integers|::IntegerSize,target:|implicit_conversions|::ConversionTarget,a:|implicit_conversions|::ImplicitResult)->Concatenated {
  let b:|implicit_conversions|::ImplicitResult=|implicit_conversions|::convert(input,length,unit,store,right,size,target);
  transition b {|implicit_conversions|::ImplicitResult::Failure {reason} -> (Concatenated::Failure {reason:reason}) _ -> append(a,b,size)}
 }
 state append(a:|implicit_conversions|::ImplicitResult,b:|implicit_conversions|::ImplicitResult,size:|integers|::IntegerSize)->Concatenated {let result:Concatenated=oct_append(a,b,size);result}
}
machine oct_append(a:|implicit_conversions|::ImplicitResult,b:|implicit_conversions|::ImplicitResult,size:|integers|::IntegerSize)->Concatenated {
 transition a {
  |implicit_conversions|::ImplicitResult::Integer {number} -> integer(number,b,size)
  |implicit_conversions|::ImplicitResult::Buffer {length,bytes} -> buffer(&bytes,length,b)
  |implicit_conversions|::ImplicitResult::String {length,bytes} -> string(&bytes,length,b)
  _ -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
 state integer(a:u64,b:|implicit_conversions|::ImplicitResult,size:|integers|::IntegerSize)->Concatenated {
  transition b {|implicit_conversions|::ImplicitResult::Integer {number} -> numbers(a,number,size) _ -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state numbers(a:u64,b:u64,size:|integers|::IntegerSize)->Concatenated {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|byte_concat|::concat_integers(size,a,b,&mut output,256);
  let result:Concatenated=oct_result(copied,output,false);result
 }
 state buffer(a:&[u8;256],length:u64,b:|implicit_conversions|::ImplicitResult)->Concatenated {
  transition b {|implicit_conversions|::ImplicitResult::Buffer {length as right_length,bytes} -> buffers(a,length,&bytes,right_length) _ -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state buffers(a:&[u8;256],a_length:u64,b:&[u8;256],b_length:u64)->Concatenated {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|byte_concat|::concat_buffers(a,a_length,b,b_length,&mut output,256);
  let result:Concatenated=oct_result(copied,output,false);result
 }
 state string(a:&[u8;256],length:u64,b:|implicit_conversions|::ImplicitResult)->Concatenated {
  transition b {|implicit_conversions|::ImplicitResult::String {length as right_length,bytes} -> strings(a,length,&bytes,right_length) _ -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state strings(a:&[u8;256],a_length:u64,b:&[u8;256],b_length:u64)->Concatenated {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|byte_concat|::concat_strings(a,a_length,b,b_length,&mut output,256);
  let result:Concatenated=oct_result(copied,output,true);result
 }
}
machine oct_result(copied:|integers|::IntegerResult,bytes:[u8;256],string:bool)->Concatenated {
 transition {copied.error==0 -> success(copied.value,bytes,string) copied.error==4 -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::Capacity}) copied.error==7 -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::Encoding}) _ -> (Concatenated::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state success(length:u64,bytes:[u8;256],string:bool)->Concatenated {
  transition string {true -> (Concatenated::String {length:length,bytes:bytes}) _ -> (Concatenated::Buffer {length:length,bytes:bytes})}
 }
}
