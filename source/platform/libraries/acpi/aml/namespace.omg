use {omega}/language/core/nat.omg;
use model.omg;
use names.omg;
pub machine empty() -> |model|::Namespace {
 let mut out:|model|::Namespace;let path:|model|::Path=|names|::root();
 out.entries[0]=|model|::Entry {path:path,has_level:true};out.count=1;out
}
pub machine entry_at(space:|model|::Namespace,index:u64)->|model|::Entry {transition index<32 {true -> (space.entries[index]) _ -> (|model|::Entry {})}}
pub machine object_at(space:|model|::Namespace,index:u64)->|model|::Object {transition index<64 {true -> (space.objects[index]) _ -> (|model|::Object {})}}
machine entry_set(space:|model|::Namespace,index:u64,entry:|model|::Entry)->|model|::Namespace {
 transition index<32 {true -> set(space,index,entry) _ -> (space)}
 state set(space:|model|::Namespace,index:u64,entry:|model|::Entry)->|model|::Namespace {let mut out:|model|::Namespace=space;out.entries[index]=entry;out}
}
pub machine object_set(space:|model|::Namespace,index:u64,object:|model|::Object)->|model|::Namespace {
 transition index<64 {true -> set(space,index,object) _ -> (space)}
 state set(space:|model|::Namespace,index:u64,object:|model|::Object)->|model|::Namespace {let mut out:|model|::Namespace=space;out.objects[index]=object;out}
}
pub machine locate(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {
 let entries:u64=space.count;let objects:u64=space.object_count;
 transition entries<=32 && objects<=64 && path.absolute && path.parents==0 && |names|::path_valid(path) {
  true -> scan(space,path) _ -> (|model|::Lookup {outcome:|model|::Outcome::InvalidState})
 }
 state scan(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {
  let initial:|model|::Lookup=|model|::Lookup {outcome:|model|::Outcome::MissingLevel,path:path};
  let result:|model|::Lookup=locate_loop(space,path,0,space.count,initial);result
 }
}
machine locate_loop(space:|model|::Namespace,path:|model|::Path,index:u64,count:u64,result:|model|::Lookup)
terminates by (index,count) -> |nat|::Nat::BoundedDistance;
-> |model|::Lookup {
 let next:|model|::Lookup=locate_step(space,path,index,result);
 transition index<count {true -> locate_loop(space,path,index+1,count,next) _ -> (result)}
}
machine locate_step(space:|model|::Namespace,path:|model|::Path,index:u64,result:|model|::Lookup)->|model|::Lookup {
 let entry:|model|::Entry=entry_at(space,index);let same:bool=|names|::path_equal(entry.path,path);
 transition index<space.count && same {true -> (|model|::Lookup {path:path,index:index,object:entry.object}) _ -> (result)}
}
machine get_absolute(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {
 let found:|model|::Lookup=locate(space,path);let entry:|model|::Entry=entry_at(space,found.index);
 let object:u64=entry.object;let count:u64=space.object_count;
 transition found.outcome==|model|::Outcome::Success && entry.has_object && object<count {
  true -> (found) _ -> (|model|::Lookup {outcome:|model|::Outcome::MissingObject,path:path})
 }
}
machine level_absolute(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {
 let found:|model|::Lookup=locate(space,path);let entry:|model|::Entry=entry_at(space,found.index);
 transition found.outcome==|model|::Outcome::Success && entry.has_level {true -> (found) _ -> (|model|::Lookup {outcome:|model|::Outcome::MissingLevel,path:path})}
}
pub machine search(space:|model|::Namespace,name:|model|::Path,scope:|model|::Path)->|model|::Lookup {
 let full:|model|::PathResult=|names|::resolve(name,scope);
 transition full.outcome==|model|::Outcome::Success {
  true -> choose(space,name,scope,full.value) _ -> (|model|::Lookup {outcome:full.outcome})
 }
 state choose(space:|model|::Namespace,name:|model|::Path,scope:|model|::Path,full:|model|::Path)->|model|::Lookup {
  transition !name.absolute && name.parents==0 && name.count==1 {
   true -> valid_start(space,name,scope) _ -> exact(space,full)
  }
 }
 state valid_start(space:|model|::Namespace,name:|model|::Path,scope:|model|::Path)->|model|::Lookup {let start:|model|::Lookup=level(space,scope);transition start.outcome==|model|::Outcome::Success {true -> upward(space,name,scope) _ -> (start)}}
 state upward(space:|model|::Namespace,name:|model|::Path,scope:|model|::Path)->|model|::Lookup {let initial:|model|::Lookup=|model|::Lookup {outcome:|model|::Outcome::MissingObject};let result:|model|::Lookup=search_loop(space,name,scope,initial,0,17);result}
 state exact(space:|model|::Namespace,full:|model|::Path)->|model|::Lookup {let result:|model|::Lookup=get(space,full);result}
}
machine search_loop(space:|model|::Namespace,name:|model|::Path,scope:|model|::Path,result:|model|::Lookup,index:u64,count:u64)
terminates by (index,count) -> |nat|::Nat::BoundedDistance;
-> |model|::Lookup {
 let full:|model|::PathResult=|names|::resolve(name,scope);let found:|model|::Lookup=get(space,full.value);
 let next:|model|::Lookup=first_lookup(result,found);let upper:|model|::PathResult=|names|::parent(scope);
 let parent_scope:|model|::Path=parent_or_root(scope,upper);
 transition index<count {true -> search_loop(space,name,parent_scope,next,index+1,count) _ -> (result)}
}
machine parent_or_root(scope:|model|::Path,upper:|model|::PathResult)->|model|::Path {transition upper.outcome==|model|::Outcome::Success {true -> (upper.value) _ -> (scope)}}
machine first_lookup(first:|model|::Lookup,next:|model|::Lookup)->|model|::Lookup {transition first.outcome==|model|::Outcome::Success {true -> (first) _ -> (next)}}
// Both namespace slots coexist at a path. Reopening a level preserves its kind.

machine merge_entry(old:|model|::Entry,candidate:|model|::Entry)->|model|::Entry {
 let levelled:|model|::Entry=merge_level(old,candidate);
 transition candidate.has_object {true -> object(levelled,candidate) _ -> (levelled)}
 state object(old:|model|::Entry,candidate:|model|::Entry)->|model|::Entry {let mut out:|model|::Entry=old;out.has_object=true;out.object=candidate.object;out.alias=candidate.alias;out}
}
machine merge_level(old:|model|::Entry,candidate:|model|::Entry)->|model|::Entry {
 transition !old.has_level && candidate.has_level {true -> level(old,candidate) _ -> (old)}
 state level(old:|model|::Entry,candidate:|model|::Entry)->|model|::Entry {let mut out:|model|::Entry=old;out.has_level=true;out.level=candidate.level;out}
}
machine add_level_absolute(space:|model|::Namespace,path:|model|::Path,kind:|model|::LevelKind)->|model|::NamespaceResult {
 transition |names|::path_valid(path) {true -> valid(space,path,kind) _ -> (|model|::NamespaceResult {outcome:|model|::Outcome::InvalidName,space:space})}
 state valid(space:|model|::Namespace,path:|model|::Path,kind:|model|::LevelKind)->|model|::NamespaceResult {transition path.count==0 {true -> (|model|::NamespaceResult {space:space}) _ -> put(space,path,kind)}
 }
 state put(space:|model|::Namespace,path:|model|::Path,kind:|model|::LevelKind)->|model|::NamespaceResult {
  let mut out:|model|::Namespace=space;let candidate:|model|::Entry=|model|::Entry {path:path,has_level:true,level:kind};let outcome:|model|::Outcome=bind_mut(&mut out,candidate,false);
  |model|::NamespaceResult {outcome:outcome,space:out}
 }
}
pub machine allocate(space:|model|::Namespace,value:|model|::Value)->|model|::NamespaceResult {
 let mut out:|model|::Namespace=space;let result:|model|::Read=allocate_mut(&mut out,value);
 |model|::NamespaceResult {outcome:result.outcome,space:out,object:result.value}
}
machine bind_absolute(space:|model|::Namespace,path:|model|::Path,object:u64)->|model|::NamespaceResult {
 let mut out:|model|::Namespace=space;let candidate:|model|::Entry=|model|::Entry {path:path,has_object:true,object:object};
 let outcome:|model|::Outcome=bind_mut(&mut out,candidate,false);
 |model|::NamespaceResult {outcome:outcome,space:out,object:object}
}
pub machine insert(space:|model|::Namespace,path:|model|::Path,value:|model|::Value)->|model|::NamespaceResult {
 let mut out:|model|::Namespace=space;let allocated:|model|::Read=allocate_mut(&mut out,value);
 transition allocated.outcome==|model|::Outcome::Success {true -> put(space,out,path,allocated) _ -> (|model|::NamespaceResult {outcome:allocated.outcome,space:space})}
 state put(original:|model|::Namespace,out:|model|::Namespace,path:|model|::Path,allocated:|model|::Read)->|model|::NamespaceResult {
  let mut current:|model|::Namespace=out;let candidate:|model|::Entry=|model|::Entry {path:path,has_object:true,object:allocated.value};let outcome:|model|::Outcome=bind_mut(&mut current,candidate,false);
  transition outcome==|model|::Outcome::Success {true -> (|model|::NamespaceResult {space:current,object:allocated.value}) _ -> (|model|::NamespaceResult {outcome:outcome,space:original})}
 }
}
pub machine alias(space:|model|::Namespace,source:|model|::Path,target:|model|::Path)->|model|::NamespaceResult {
 let found:|model|::Lookup=get(space,source);
 transition found.outcome==|model|::Outcome::Success {true -> put(space,target,found.object) _ -> (|model|::NamespaceResult {outcome:found.outcome,space:space})}
 state put(space:|model|::Namespace,target:|model|::Path,object:u64)->|model|::NamespaceResult {
  let mut out:|model|::Namespace=space;let candidate:|model|::Entry=|model|::Entry {path:target,has_object:true,object:object,alias:true};let outcome:|model|::Outcome=bind_mut(&mut out,candidate,true);
  |model|::NamespaceResult {outcome:outcome,space:out,object:object}
 }
}
pub machine child(scope:|model|::Path,segment:u32)->|model|::PathResult {
 let mut name:|model|::Path=|model|::Path {count:1};name.segments[0]=segment;let result:|model|::PathResult=|names|::resolve(name,scope);result
}
// Standard scopes only; OS identity, global mutex, and native methods require host policy.
pub machine predefined_scopes()->|model|::NamespaceResult {
 let start:|model|::Namespace=empty();let r:|model|::Path=|names|::root();
 let gpe:|model|::PathResult=child(r,0x4550475f);let sb:|model|::PathResult=child(r,0x5f42535f);let si:|model|::PathResult=child(r,0x5f49535f);let pr:|model|::PathResult=child(r,0x5f52505f);let tz:|model|::PathResult=child(r,0x5f5a545f);
 let a:|model|::NamespaceResult=add_level(start,gpe.value,|model|::LevelKind::Scope);
 let b:|model|::NamespaceResult=add_level(a.space,sb.value,|model|::LevelKind::Scope);
 let c:|model|::NamespaceResult=add_level(b.space,si.value,|model|::LevelKind::Scope);
 let d:|model|::NamespaceResult=add_level(c.space,pr.value,|model|::LevelKind::Scope);
 let e:|model|::NamespaceResult=add_level(d.space,tz.value,|model|::LevelKind::Scope);e
}

machine bump(value:u64)->u64 {transition value<64 {true -> (value+1) _ -> (value)}}

pub machine get(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {
 transition path.absolute {true -> checked(space,path) _ -> (|model|::Lookup {outcome:|model|::Outcome::NotAbsolute})}
 state checked(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {let result:|model|::Lookup=get_absolute(space,path);result}
}

pub machine level(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {
 transition path.absolute {true -> checked(space,path) _ -> (|model|::Lookup {outcome:|model|::Outcome::NotAbsolute})}
 state checked(space:|model|::Namespace,path:|model|::Path)->|model|::Lookup {let result:|model|::Lookup=level_absolute(space,path);result}
}

pub machine add_level(space:|model|::Namespace,path:|model|::Path,kind:|model|::LevelKind)->|model|::NamespaceResult {
 transition path.absolute {true -> checked(space,path,kind) _ -> (|model|::NamespaceResult {outcome:|model|::Outcome::NotAbsolute,space:space})}
 state checked(space:|model|::Namespace,path:|model|::Path,kind:|model|::LevelKind)->|model|::NamespaceResult {let result:|model|::NamespaceResult=add_level_absolute(space,path,kind);result}
}

pub machine bind(space:|model|::Namespace,path:|model|::Path,object:u64)->|model|::NamespaceResult {
 transition path.absolute {true -> checked(space,path,object) _ -> (|model|::NamespaceResult {outcome:|model|::Outcome::NotAbsolute,space:space})}
 state checked(space:|model|::Namespace,path:|model|::Path,object:u64)->|model|::NamespaceResult {let result:|model|::NamespaceResult=bind_absolute(space,path,object);result}
}

// These kernels mutate only supplied ordinary initialized storage. There is no
// firmware, pointer dereference, device access, or allocator authority here.
pub machine allocate_mut(space:&mut |model|::Namespace,value:|model|::Value)->|model|::Read {
 let entries:u64=space.count;let objects:u64=space.object_count;
 transition entries<=32 && objects<64 {true -> append(space,value) _ -> (|model|::Read {outcome:|model|::Outcome::Capacity})}
 state append(space:&mut |model|::Namespace,value:|model|::Value)->|model|::Read {
  let index:u64=space.object_count;
  transition index<64 {true -> commit(space,value,index) _ -> (|model|::Read {outcome:|model|::Outcome::Capacity})}
 }
 state commit(space:&mut |model|::Namespace,value:|model|::Value,index:u64)->|model|::Read {
  space.objects[index]=|model|::Object {value:value};space.object_count=index+1;|model|::Read {value:index}
 }
}
pub machine bind_mut(space:&mut |model|::Namespace,candidate:|model|::Entry,collision:bool)->|model|::Outcome {
 transition candidate.path.absolute {true -> valid(space,candidate,collision) _ -> (|model|::Outcome::NotAbsolute)}
 state valid(space:&mut |model|::Namespace,candidate:|model|::Entry,collision:bool)->|model|::Outcome {
  let object:u64=candidate.object;let count:u64=space.object_count;let entries:u64=space.count;
  transition |names|::path_valid(candidate.path) && candidate.path.count>0 && entries<=32 && count<=64 && (!candidate.has_object || object<count) {
   true -> parent_level(space,candidate,collision) _ -> (|model|::Outcome::InvalidState)
  }
 }
 state parent_level(space:&mut |model|::Namespace,candidate:|model|::Entry,collision:bool)->|model|::Outcome {
  let copied:|model|::Namespace=|model|::Namespace {count:space.count,object_count:space.object_count,entries:space.entries,objects:space.objects};let up:|model|::PathResult=|names|::parent(candidate.path);let parent_level:|model|::Lookup=level(copied,up.value);
  transition up.outcome==|model|::Outcome::Success && parent_level.outcome==|model|::Outcome::Success {true -> existing(space,candidate,collision) _ -> (|model|::Outcome::MissingLevel)}
 }
 state existing(space:&mut |model|::Namespace,candidate:|model|::Entry,collision:bool)->|model|::Outcome {
  let copied:|model|::Namespace=|model|::Namespace {count:space.count,object_count:space.object_count,entries:space.entries,objects:space.objects};let found:|model|::Lookup=locate(copied,candidate.path);let old:|model|::Entry=entry_at(copied,found.index);
  transition found.outcome==|model|::Outcome::Success {true -> replace(space,candidate,collision,found.index,old) _ -> room(space,candidate)}
 }
 state replace(space:&mut |model|::Namespace,candidate:|model|::Entry,collision:bool,index:u64,old:|model|::Entry)->|model|::Outcome {
  transition collision && old.has_object {true -> (|model|::Outcome::NameCollision) _ -> merge(space,candidate,index,old)}
 }
 state merge(space:&mut |model|::Namespace,candidate:|model|::Entry,index:u64,old:|model|::Entry)->|model|::Outcome {
  let merged:|model|::Entry=merge_entry(old,candidate);
  transition index<32 {true -> commit(space,index,merged) _ -> (|model|::Outcome::InvalidState)}
 }
 state commit(space:&mut |model|::Namespace,index:u64,merged:|model|::Entry)->|model|::Outcome {space.entries[index]=merged;|model|::Outcome::Success}
 state room(space:&mut |model|::Namespace,candidate:|model|::Entry)->|model|::Outcome {
  let index:u64=space.count;
  transition index<32 {true -> append(space,candidate,index) _ -> (|model|::Outcome::Capacity)}
 }
 state append(space:&mut |model|::Namespace,candidate:|model|::Entry,index:u64)->|model|::Outcome {space.entries[index]=candidate;space.count=index+1;|model|::Outcome::Success}
}
