// SPDX-License-Identifier: MIT OR Apache-2.0
// Direct BufferField Store component of rust-osdev/acpi do_store,
// pin 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// Primary Integer/Buffer/String source policy; no target/reference evaluation.
use model.omg;
use byte_storage.omg;
use buffer_field_writes.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/conversions.omg;
// Source is fully admitted and snapshotted before field/backing admission.
// Every failure leaves the complete store unchanged. Result identifies backing.
pub machine store_value(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,source:u64,size:|integers|::IntegerSize)->|byte_storage|::ByteResult {
 let count:u64=store.space.object_count;
 transition count<=64 && source<count && source<64 {true -> selected(input,length,unit,store,field,source,size,store.space.objects[source].value) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::InvalidState})}
 state selected(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,source:u64,size:|integers|::IntegerSize,value:|model|::Value)->|byte_storage|::ByteResult {
  transition value {
   |model|::Value::Integer {number} -> integer(input,length,unit,store,field,size,number)
   |model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,field,source)
   |model|::Value::String {string_storage} -> bytes(input,length,unit,store,field,source)
   _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::UnsupportedValue})
  }
 }
 state integer(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,size:|integers|::IntegerSize,number:u64)->|byte_storage|::ByteResult {
  let mut payload:[u8;256];let packed:|integers|::IntegerResult=|conversions|::integer_to_buffer(size,number,&mut payload);
  transition packed.error==0 {true -> apply(input,length,unit,store,field,payload,packed.value) _ -> (|byte_storage|::ByteResult {outcome:|byte_storage|::ByteOutcome::InvalidState})}
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,source:u64)->|byte_storage|::ByteResult {
  let payload:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,source);
  transition payload.outcome==|byte_storage|::ByteOutcome::Success {true -> apply(input,length,unit,store,field,payload.bytes,payload.length) _ -> (|byte_storage|::ByteResult {outcome:payload.outcome})}
 }
 state apply(input:&[u8;1024],length:u64,unit:u64,store:&mut |model|::ObjectStore,field:u64,payload:[u8;256],payload_length:u64)->|byte_storage|::ByteResult {
  let result:|byte_storage|::ByteResult=|buffer_field_writes|::write(input,length,unit,store,field,&payload,payload_length);result
 }
}
