// SPDX-License-Identifier: MIT OR Apache-2.0
// Primary ACPI 6.6 Table 19.7 policy over the licensed canonical conversion port.
// Detached Integer/String/Buffer values only, no reference or target dispatch.
use model.omg;
use byte_storage.omg;
use object_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/implicit_integer.omg;
use {integer_helpers}/implicit_strings.omg;
use {integer_helpers}/conversions.omg;
pub data ConversionTarget [copy] {case Integer;case Buffer;case String;}
pub data ImplicitResult [copy] {
 case Failure(reason:|object_conversions|::ConversionFailure);
 case Integer(number:u64);
 case Buffer(length:u64,bytes:[u8;256]);
 case String(length:u64,bytes:[u8;256]);
}
data SourceKind [copy] {case Integer(number:u64);case Buffer;case String;}

pub machine convert(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,target:ConversionTarget)->ImplicitResult {
 let count:u64=store.space.object_count;
 transition count<=64 && object<count && object<64 {true -> source(input,length,unit,store,object,size,target) _ -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state source(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,target:ConversionTarget)->ImplicitResult {
  transition store.space.objects[object].value {
   |model|::Value::Integer {number} -> selected(input,length,unit,store,object,size,target,SourceKind::Integer {number:number})
   |model|::Value::Buffer {buffer_storage} -> selected(input,length,unit,store,object,size,target,SourceKind::Buffer)
   |model|::Value::String {string_storage} -> selected(input,length,unit,store,object,size,target,SourceKind::String)
   _ -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  }
 }
 state selected(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,target:ConversionTarget,kind:SourceKind)->ImplicitResult {
  transition target {
   ConversionTarget::Integer -> integer(input,length,unit,store,object,size,kind)
   ConversionTarget::Buffer -> buffer(input,length,unit,store,object,size)
   ConversionTarget::String -> string(input,length,unit,store,object,size,kind)
  }
 }
 state integer(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,kind:SourceKind)->ImplicitResult {
  transition kind {SourceKind::String -> string_integer(input,length,unit,store,object,size) _ -> ordinary_integer(input,length,unit,store,object,size)}
 }
 state ordinary_integer(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize)->ImplicitResult {
  let value:|object_conversions|::ConversionResult=|object_conversions|::to_integer(input,length,unit,store,object,size);let result:ImplicitResult=ic_integer(value);result
 }
 state string_integer(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize)->ImplicitResult {
  let bytes:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,object);let result:ImplicitResult=ic_string_integer(bytes,size);result
 }
 state buffer(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize)->ImplicitResult {
  let value:|object_conversions|::ConversionResult=|object_conversions|::to_buffer(input,length,unit,store,object,size,|object_conversions|::BufferRule::ExplicitTerminated);
  let result:ImplicitResult=ic_buffer(value);result
 }
 state string(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,size:|integers|::IntegerSize,kind:SourceKind)->ImplicitResult {
  transition kind {SourceKind::Integer {number} -> integer_string(size,number) _ -> bytes_string(input,length,unit,store,object,kind)}
 }
 state integer_string(size:|integers|::IntegerSize,number:u64)->ImplicitResult {
  let formatted:|implicit_strings|::StringResult=|implicit_strings|::from_integer(size,number);let result:ImplicitResult=ic_string(formatted);result
 }
 state bytes_string(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,kind:SourceKind)->ImplicitResult {
  let bytes:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,object);let result:ImplicitResult=ic_bytes_string(bytes,kind);result
 }
}
machine ic_integer(value:|object_conversions|::ConversionResult)->ImplicitResult {
 transition value {
  |object_conversions|::ConversionResult::Integer {number} -> (ImplicitResult::Integer {number:number})
  |object_conversions|::ConversionResult::Failure {reason} -> (ImplicitResult::Failure {reason:reason})
  _ -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
machine ic_buffer(value:|object_conversions|::ConversionResult)->ImplicitResult {
 transition value {
  |object_conversions|::ConversionResult::Bytes {length,bytes} -> (ImplicitResult::Buffer {length:length,bytes:bytes})
  |object_conversions|::ConversionResult::Failure {reason} -> (ImplicitResult::Failure {reason:reason})
  _ -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
machine ic_string(value:|implicit_strings|::StringResult)->ImplicitResult {
 transition value {
  |implicit_strings|::StringResult::String {length,bytes} -> (ImplicitResult::String {length:length,bytes:bytes})
  |implicit_strings|::StringResult::Capacity -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
 }
}
machine ic_string_integer(bytes:|byte_storage|::ByteRead,size:|integers|::IntegerSize)->ImplicitResult {
 transition bytes.outcome==|byte_storage|::ByteOutcome::Success {true -> parse(bytes,size) _ -> failed(bytes.outcome)}
 state parse(bytes:|byte_storage|::ByteRead,size:|integers|::IntegerSize)->ImplicitResult {
  let value:|implicit_integer|::Conversion=|implicit_integer|::from_string(size,&bytes.bytes,bytes.length);
  transition value {|implicit_integer|::Conversion::Integer {value} -> (ImplicitResult::Integer {number:value}) |implicit_integer|::Conversion::Failure {reason} -> numeric_failure(reason)}
 }
 state numeric_failure(error:|implicit_integer|::Error)->ImplicitResult {
  transition error {
   |implicit_integer|::Error::Capacity -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
   |implicit_integer|::Error::Empty -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Empty})
   |implicit_integer|::Error::Encoding -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
  }
 }
 state failed(error:|byte_storage|::ByteOutcome)->ImplicitResult {let result:ImplicitResult=ic_storage_failure(error);result}
}
machine ic_bytes_string(bytes:|byte_storage|::ByteRead,kind:SourceKind)->ImplicitResult {
 transition bytes.outcome==|byte_storage|::ByteOutcome::Success {true -> selected(bytes,kind) _ -> failed(bytes.outcome)}
 state selected(bytes:|byte_storage|::ByteRead,kind:SourceKind)->ImplicitResult {
  transition kind {SourceKind::Buffer -> formatted(bytes) _ -> copied(bytes)}
 }
 state formatted(bytes:|byte_storage|::ByteRead)->ImplicitResult {
  let value:|implicit_strings|::StringResult=|implicit_strings|::from_buffer(&bytes.bytes,bytes.length);let result:ImplicitResult=ic_string(value);result
 }
 state copied(bytes:|byte_storage|::ByteRead)->ImplicitResult {
  let mut output:[u8;256];let copied:|integers|::IntegerResult=|conversions|::mid(&bytes.bytes,bytes.length,0,bytes.length,&mut output);
  transition copied.error==0 {true -> (ImplicitResult::String {length:copied.value,bytes:output}) _ -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 }
 state failed(error:|byte_storage|::ByteOutcome)->ImplicitResult {let result:ImplicitResult=ic_storage_failure(error);result}
}
machine ic_storage_failure(error:|byte_storage|::ByteOutcome)->ImplicitResult {
 transition error {
  |byte_storage|::ByteOutcome::Capacity -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
  |byte_storage|::ByteOutcome::Bounds -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Bounds})
  |byte_storage|::ByteOutcome::Encoding -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
  |byte_storage|::ByteOutcome::UnsupportedValue -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  |byte_storage|::ByteOutcome::ReferenceCycle -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::ReferenceCycle})
  |byte_storage|::ByteOutcome::WorkLimit -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::WorkLimit})
  _ -> (ImplicitResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
