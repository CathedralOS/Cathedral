// String-name component of rust-osdev/acpi do_deref_of at
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// Returns canonical identity only; no target evaluation or object mutation.
use model.omg;
use byte_storage.omg;
use name_text.omg;
use namespace.omg;
pub data LookupFailure [copy] {
 case InvalidState;
 case UnsupportedValue;
 case Storage(reason:|byte_storage|::ByteOutcome);
 case Name(reason:|model|::Outcome,offset:u64);
 case Search(reason:|model|::Outcome);
}
pub data StringLookup [copy] {
 case Failure(reason:LookupFailure);
 case Found(object:u64,path:|model|::Path);
}
pub machine lookup(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,scope:|model|::Path)->StringLookup {
 let objects:u64=store.space.object_count;let entries:u64=store.space.count;
 transition objects<=64 && entries<=32 && source<objects && source<64 {true -> kind(input,length,unit,store,source,scope) _ -> (StringLookup::Failure {reason:LookupFailure::InvalidState})}
 state kind(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,scope:|model|::Path)->StringLookup {
  transition store.space.objects[source].value {
   |model|::Value::String {string_storage} -> bytes(input,length,unit,store,source,scope)
   _ -> (StringLookup::Failure {reason:LookupFailure::UnsupportedValue})
  }
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,source:u64,scope:|model|::Path)->StringLookup {
  let read:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,source);
  transition read.outcome==|byte_storage|::ByteOutcome::Success {true -> name(store,read,scope) _ -> (StringLookup::Failure {reason:LookupFailure::Storage {reason:read.outcome}})}
 }
 state name(store:&|model|::ObjectStore,read:|byte_storage|::ByteRead,scope:|model|::Path)->StringLookup {
  let parsed:|model|::PathResult=|name_text|::parse(&read.bytes,read.length);
  transition parsed.outcome==|model|::Outcome::Success {true -> find(store,parsed.value,scope) _ -> (StringLookup::Failure {reason:LookupFailure::Name {reason:parsed.outcome,offset:parsed.offset}})}
 }
 state find(store:&|model|::ObjectStore,name:|model|::Path,scope:|model|::Path)->StringLookup {
  let space:|model|::Namespace=|model|::Namespace {count:store.space.count,object_count:store.space.object_count,entries:store.space.entries,objects:store.space.objects};
  let found:|model|::Lookup=|namespace|::search(space,name,scope);
  transition found.outcome==|model|::Outcome::Success {true -> (StringLookup::Found {object:found.object,path:found.path}) _ -> (StringLookup::Failure {reason:LookupFailure::Search {reason:found.outcome}})}
 }
}
