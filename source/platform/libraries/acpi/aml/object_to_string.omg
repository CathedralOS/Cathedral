// SPDX-License-Identifier: MIT OR Apache-2.0
// Modified pure component of rust-osdev/acpi do_to_string, pinned
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// ACPI 6.6 ToString: detached bounded ASCII String, excluding NUL.
use model.omg;
use byte_storage.omg;
use object_conversions.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/conversions.omg;
pub data StringResult [copy] {
 case Failure(reason:|object_conversions|::ConversionFailure);
 case String(length:u64,bytes:[u8;256]);
}
// Direct Buffer slot only; maximum is an already-evaluated unsigned Integer.
// No integer-width normalization, reference resolution, allocation or Store.
// Admit complete backing storage before selecting/validating the ASCII prefix.
pub machine to_string(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,maximum:u64)->StringResult {
 let count:u64=store.space.object_count;
 transition count<=64 && object<count && object<64 {true -> selected(input,length,unit,store,object,maximum) _ -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})}
 state selected(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,maximum:u64)->StringResult {
  let value:|model|::Value=store.space.objects[object].value;
  transition value {|model|::Value::Buffer {buffer_storage} -> bytes(input,length,unit,store,object,maximum) _ -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})}
 }
 state bytes(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,maximum:u64)->StringResult {
  let snapshot:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,object);
  let failure:StringResult=storage_failure(snapshot.outcome);
  transition snapshot.outcome==|byte_storage|::ByteOutcome::Success {true -> convert(snapshot,maximum) _ -> (failure)}
 }
 state convert(snapshot:|byte_storage|::ByteRead,maximum:u64)->StringResult {
  let count:u64=snapshot.length;let mut output:[u8;256];
  let result:|integers|::IntegerResult=|conversions|::buffer_to_string(&snapshot.bytes,count,maximum,&mut output);
  let failure:StringResult=numeric_failure(result.error);
  transition result.error==0 {true -> (StringResult::String {length:result.value,bytes:output}) _ -> (failure)}
 }
}
machine storage_failure(outcome:|byte_storage|::ByteOutcome)->StringResult {
 transition outcome {
  |byte_storage|::ByteOutcome::Capacity -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
  |byte_storage|::ByteOutcome::Bounds -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::Bounds})
  |byte_storage|::ByteOutcome::Encoding -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
  |byte_storage|::ByteOutcome::UnsupportedValue -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::UnsupportedValue})
  |byte_storage|::ByteOutcome::ReferenceCycle -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::ReferenceCycle})
  |byte_storage|::ByteOutcome::WorkLimit -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::WorkLimit})
  _ -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
machine numeric_failure(error:u8)->StringResult {
 transition error {
  4 -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::Capacity})
  7 -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::Encoding})
  _ -> (StringResult::Failure {reason:|object_conversions|::ConversionFailure::InvalidState})
 }
}
