// Modified WrappedObject reference/clone algorithms from rust-osdev/acpi
// 257aa561aa190f1cfe2de5d1a4f0af9d09ff1db5. Copyright 2018 Isaac Woods.
// Bounded stable IDs replace Arc identity; no ObjectToken, pointer or live service.
use {omega}/language/core/nat.omg;
use model.omg;
use namespace.omg;

pub machine unwrap_all(space:&|model|::Namespace,object:u64,budget:u64)->|model|::ReferenceState {
 let result:|model|::ReferenceState=or_unwrap(space,object,budget,false);result
}
pub machine unwrap_transparent(space:&|model|::Namespace,object:u64,budget:u64)->|model|::ReferenceState {
 let result:|model|::ReferenceState=or_unwrap(space,object,budget,true);result
}
machine or_unwrap(space:&|model|::Namespace,object:u64,budget:u64,transparent:bool)->|model|::ReferenceState {
 let capacity:u64=space.object_count;
 transition capacity<=64 && object<capacity && object<64 && budget<=64 {
  true -> run(space,object,budget,transparent)
  _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,object:object,done:true})
 }
 state run(space:&|model|::Namespace,object:u64,budget:u64,transparent:bool)->|model|::ReferenceState {
  let initial:|model|::ReferenceState=|model|::ReferenceState {object:object};
  let result:|model|::ReferenceState=or_reference_walk(space,initial,0,budget,transparent);
  transition result.done {true -> (result) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::WorkLimit,object:result.object,visited:result.visited,done:true})}
 }
}
machine or_reference_walk(space:&|model|::Namespace,value:|model|::ReferenceState,index:u64,count:u64,transparent:bool)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->|model|::ReferenceState {
 let next:|model|::ReferenceState=or_reference_bounded_step(space,value,index,count,transparent);
 transition index<count {true -> or_reference_walk(space,next,index+1,count,transparent) _ -> (value)}
}
machine or_reference_bounded_step(space:&|model|::Namespace,value:|model|::ReferenceState,index:u64,count:u64,transparent:bool)->|model|::ReferenceState {
 transition index<count {true -> step(space,value,transparent) _ -> (value)}
 state step(space:&|model|::Namespace,value:|model|::ReferenceState,transparent:bool)->|model|::ReferenceState {
  let next:|model|::ReferenceState=or_reference_step(space,value,transparent);next
 }
}
machine or_reference_step(space:&|model|::Namespace,value:|model|::ReferenceState,transparent:bool)->|model|::ReferenceState {
 transition value.done {true -> (value) _ -> inspect(space,value,transparent,value.object)}
 state inspect(space:&|model|::Namespace,value:|model|::ReferenceState,transparent:bool,index:u64)->|model|::ReferenceState {
  transition index<space.object_count && index<64 {true -> payload(space,value,transparent,index) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,object:index,visited:value.visited,done:true})}
 }
 state payload(space:&|model|::Namespace,value:|model|::ReferenceState,transparent:bool,index:u64)->|model|::ReferenceState {
  let mask:u64=(1 as u64)<<index;let seen:u64=value.visited|mask;
  let payload:|model|::Value=space.objects[index].value;
  transition payload {
   |model|::Value::Reference {kind,object_id} -> reference(space,index,object_id,seen,kind,transparent)
   _ -> (|model|::ReferenceState {object:index,visited:seen,done:true})
  }
 }
 state reference(space:&|model|::Namespace,from:u64,target:u64,seen:u64,kind:|model|::ReferenceKind,transparent:bool)->|model|::ReferenceState {
  let follow:bool=!transparent || kind==|model|::ReferenceKind::Named || kind==|model|::ReferenceKind::Local || kind==|model|::ReferenceKind::Arg;
  transition follow {true -> bounds(space,target,seen) _ -> (|model|::ReferenceState {object:from,visited:seen,done:true})}
 }
 state bounds(space:&|model|::Namespace,target:u64,seen:u64)->|model|::ReferenceState {
  transition target<space.object_count && target<64 {true -> cycle(target,seen) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,object:target,visited:seen,done:true})}
 }
 state cycle(target:u64,seen:u64)->|model|::ReferenceState {
  let mask:u64=(1 as u64)<<target;
  transition seen&mask!=0 {true -> (|model|::ReferenceState {outcome:|model|::Outcome::ReferenceCycle,object:target,visited:seen,done:true}) _ -> (|model|::ReferenceState {object:target,visited:seen})}
 }
}
// Validates the target before allocating one fresh identity. Namespace entries
// and existing objects are unchanged on failure; references do not rebind names.
pub machine allocate_reference(space:|model|::Namespace,kind:|model|::ReferenceKind,target:u64)->|model|::NamespaceResult {
 let count:u64=space.object_count;
 transition count<=64 && target<count && target<64 {
  true -> allocate(space,kind,target)
  _ -> (|model|::NamespaceResult {outcome:|model|::Outcome::InvalidState,space:space})
 }
 state allocate(space:|model|::Namespace,kind:|model|::ReferenceKind,target:u64)->|model|::NamespaceResult {
  let payload:|model|::Value=|model|::Value::Reference {kind:kind,object_id:target};
  let result:|model|::NamespaceResult=|namespace|::allocate(space,payload);result
 }
}
// The payload clone is shallow. Both sibling links stay attached to their
// original object identities. Method-definition observations are separate:
// this namespace-only operation does not establish executable method provenance.
pub machine copy_value(space:|model|::Namespace,destination:u64,source:u64)->|model|::NamespaceResult {
 let count:u64=space.object_count;
 transition count<=64 && destination<count && source<count && destination<64 && source<64 {
  true -> copy(space,destination,source)
  _ -> (|model|::NamespaceResult {outcome:|model|::Outcome::InvalidState,space:space})
 }
 state copy(space:|model|::Namespace,destination:u64,source:u64)->|model|::NamespaceResult {
  let payload:|model|::Value=space.objects[source].value;
  let source_owned:bool=or_owned_bytes(payload);let destination_owned:bool=or_owned_bytes(space.objects[destination].value);
  transition source_owned || destination_owned {
   true -> (|model|::NamespaceResult {outcome:|model|::Outcome::InvalidState,space:space})
   _ -> publish(space,destination,payload)
  }
 }
 state publish(space:|model|::Namespace,destination:u64,payload:|model|::Value)->|model|::NamespaceResult {
  let mut out:|model|::Namespace=space;
  out.objects[destination].value=payload;
  |model|::NamespaceResult {space:out,object:destination}
 }
}
// Complete advertised-chain validation precedes publishing a selected element.
// This does not unwrap Reference values or resolve lexical NameReference values.
pub machine package_element(space:&|model|::Namespace,package:u64,index:u64,budget:u64)->|model|::ReferenceState {
 let capacity:u64=space.object_count;
 transition capacity<=64 && package<capacity && package<64 && budget<=64 {
  true -> payload(space,package,index,budget)
  _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,done:true})
 }
 state payload(space:&|model|::Namespace,package:u64,index:u64,budget:u64)->|model|::ReferenceState {
  let value:|model|::Value=space.objects[package].value;
  transition value {|model|::Value::Package {first,count} -> length(space,first,count,index,budget) _ -> (|model|::ReferenceState {outcome:|model|::Outcome::InvalidState,done:true})}
 }
 state length(space:&|model|::Namespace,first:u64,count:u64,index:u64,budget:u64)->|model|::ReferenceState {
  transition {count>64 -> (|model|::ReferenceState {outcome:|model|::Outcome::Capacity,done:true})
   index>=count -> (|model|::ReferenceState {outcome:|model|::Outcome::MissingObject,done:true})
   budget<count -> (|model|::ReferenceState {outcome:|model|::Outcome::WorkLimit,done:true})
   _ -> walk(space,first,count,index)}
 }
 state walk(space:&|model|::Namespace,first:u64,count:u64,index:u64)->|model|::ReferenceState {
  let initial:PackageWalk=PackageWalk {at:first};
  let result:PackageWalk=or_package_walk(space,initial,0,count,index);
  transition result.outcome==|model|::Outcome::Success && result.done {
   true -> (|model|::ReferenceState {object:result.selected,visited:result.visited,done:true})
   _ -> (|model|::ReferenceState {outcome:result.outcome,visited:result.visited,done:true})
  }
 }
}
data PackageWalk [copy] {outcome:|model|::Outcome;at:u64;visited:u64;selected:u64;done:bool;}
machine or_package_walk(space:&|model|::Namespace,value:PackageWalk,index:u64,count:u64,selected:u64)
terminates by(index,count)->|nat|::Nat::BoundedDistance;
->PackageWalk {
 let next:PackageWalk=or_package_step(space,value,index,count,selected);
 transition index<count {true -> or_package_walk(space,next,index+1,count,selected) _ -> (value)}
}
machine or_package_step(space:&|model|::Namespace,value:PackageWalk,index:u64,count:u64,selected:u64)->PackageWalk {
 transition value.done || index>=count {true -> (value) _ -> bounds(space,value,index,count,selected,value.at)}
 state bounds(space:&|model|::Namespace,value:PackageWalk,index:u64,count:u64,selected:u64,at:u64)->PackageWalk {
  transition at<space.object_count && at<64 {true -> seen(space,value,index,count,selected,at) _ -> failure(value,|model|::Outcome::InvalidState)}
 }
 state seen(space:&|model|::Namespace,value:PackageWalk,index:u64,count:u64,selected:u64,at:u64)->PackageWalk {
  let mask:u64=(1 as u64)<<at;
  transition value.visited&mask==0 {true -> item(space,value,index,count,selected,at,mask) _ -> failure(value,|model|::Outcome::ReferenceCycle)}
 }
 state item(space:&|model|::Namespace,value:PackageWalk,index:u64,count:u64,selected:u64,at:u64,mask:u64)->PackageWalk {
  let object:|model|::Object=space.objects[at];let mut next:PackageWalk=value;next.visited=value.visited|mask;
  transition index==selected {true -> select(next,index,count,at,object) _ -> link(next,index,count,object)}
 }
 state select(value:PackageWalk,index:u64,count:u64,at:u64,object:|model|::Object)->PackageWalk {
  let mut next:PackageWalk=value;next.selected=at;transition {_ -> link(next,index,count,object)}
 }
 state link(value:PackageWalk,index:u64,count:u64,object:|model|::Object)->PackageWalk {
  transition index+1<count {true -> more(value,object) _ -> last(value,object)}
 }
 state more(value:PackageWalk,object:|model|::Object)->PackageWalk {
  transition object.has_next {true -> advance(value,object.next) _ -> failure(value,|model|::Outcome::BadEncoding)}
 }
 state advance(value:PackageWalk,at:u64)->PackageWalk {let mut next:PackageWalk=value;next.at=at;next}
 state last(value:PackageWalk,object:|model|::Object)->PackageWalk {
  transition object.has_next {true -> failure(value,|model|::Outcome::BadEncoding) _ -> done(value)}
 }
 state done(value:PackageWalk)->PackageWalk {let mut next:PackageWalk=value;next.done=true;next}
 state failure(value:PackageWalk,outcome:|model|::Outcome)->PackageWalk {let mut next:PackageWalk=value;next.outcome=outcome;next.done=true;next}
}

// Namespace-only copying cannot maintain the paired mutable byte arena.
machine or_owned_bytes(value:|model|::Value)->bool {
 transition value {|model|::Value::String {string_storage} -> string(string_storage) |model|::Value::Buffer {buffer_storage} -> buffer(buffer_storage) _ -> (false)}
 state string(storage:|model|::StringStorage)->bool {transition storage {|model|::StringStorage::Owned {string_owner} -> (true) _ -> (false)}}
 state buffer(storage:|model|::BufferStorage)->bool {transition storage {|model|::BufferStorage::Owned {buffer_owner} -> (true) _ -> (false)}}
}
