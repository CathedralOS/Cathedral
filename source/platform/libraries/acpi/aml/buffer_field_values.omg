// Detached observations only. No allocation, object mutation, region or IO access.
use model.omg;
use byte_storage.omg;
use {integer_helpers}/integers.omg;
use {integer_helpers}/buffer_fields.omg;
pub data FieldReadFailure [copy] {
 case InvalidState; case UnsupportedValue; case Bounds; case Capacity;
 case Encoding; case ReferenceCycle; case WorkLimit;
}
pub data FieldValueRead [copy] {
 case Failure(reason:FieldReadFailure);
 case Integer(number:u64);
 case Buffer(length:u64,bytes:[u8;256]);
}
// The caller resolves outer references. Backing references use read_bytes' own
// transparent policy; a RefOf/Index wrapper is not silently dereferenced here.
pub machine read(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,field:u64,size:|integers|::IntegerSize)->FieldValueRead {
 let count:u64=store.space.object_count;
 transition count<=64 && field<count && field<64 {true -> payload(input,length,unit,store,store.space.objects[field].value,size) _ -> (FieldValueRead::Failure {reason:FieldReadFailure::InvalidState})}
 state payload(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,value:|model|::Value,size:|integers|::IntegerSize)->FieldValueRead {
  transition value {
   |model|::Value::BufferField {backing_object,bit_offset,bit_length} -> backing(input,length,unit,store,backing_object,bit_offset,bit_length,size)
   _ -> (FieldValueRead::Failure {reason:FieldReadFailure::UnsupportedValue})
  }
 }
 state backing(input:&[u8;1024],length:u64,unit:u64,store:&|model|::ObjectStore,object:u64,start:u64,count:u64,size:|integers|::IntegerSize)->FieldValueRead {
  let snapshot:|byte_storage|::ByteRead=|byte_storage|::read_bytes(input,length,unit,store,object);
  transition snapshot.outcome==|byte_storage|::ByteOutcome::Success {true -> extent(snapshot,start,count,size) _ -> failure(snapshot.outcome)}
 }
 state failure(outcome:|byte_storage|::ByteOutcome)->FieldValueRead {let result:FieldValueRead=field_value_failure(outcome);result}
 state extent(snapshot:|byte_storage|::ByteRead,start:u64,count:u64,size:|integers|::IntegerSize)->FieldValueRead {
  let length:u64=snapshot.length;
  transition length<=256 {true -> start_bound(snapshot,start,count,size,length*8) _ -> (FieldValueRead::Failure {reason:FieldReadFailure::Capacity})}
 }
 state start_bound(snapshot:|byte_storage|::ByteRead,start:u64,count:u64,size:|integers|::IntegerSize,bits:u64)->FieldValueRead {
  transition start<=bits && count>0 {true -> count_bound(snapshot,start,count,size,bits-start) _ -> (FieldValueRead::Failure {reason:FieldReadFailure::Bounds})}
 }
 state count_bound(snapshot:|byte_storage|::ByteRead,start:u64,count:u64,size:|integers|::IntegerSize,remaining:u64)->FieldValueRead {
  transition count<=remaining {true -> shape(snapshot,start,count,size) _ -> (FieldValueRead::Failure {reason:FieldReadFailure::Bounds})}
 }
 state shape(snapshot:|byte_storage|::ByteRead,start:u64,count:u64,size:|integers|::IntegerSize)->FieldValueRead {
  let width:u64=|integers|::integer_bits(size);
  transition count<=width {true -> integer(snapshot,start,count,size) _ -> buffer(snapshot,start,count)}
 }
 state integer(snapshot:|byte_storage|::ByteRead,start:u64,count:u64,size:|integers|::IntegerSize)->FieldValueRead {
  let result:|integers|::IntegerResult=|buffer_fields|::field_to_integer(size,&snapshot.bytes,snapshot.length,start,count);
  transition result.error==0 {true -> (FieldValueRead::Integer {number:result.value}) _ -> (FieldValueRead::Failure {reason:FieldReadFailure::InvalidState})}
 }
 state buffer(snapshot:|byte_storage|::ByteRead,start:u64,count:u64)->FieldValueRead {
  transition count<=2048 {true -> buffer_copy(snapshot,start,count) _ -> (FieldValueRead::Failure {reason:FieldReadFailure::Capacity})}
 }
 state buffer_copy(snapshot:|byte_storage|::ByteRead,start:u64,count:u64)->FieldValueRead {
  let length:u64=(count+7)/8;let mut output:[u8;256];
  let error:u8=|buffer_fields|::copy_bits(&snapshot.bytes,snapshot.length,start,&mut output,length,0,count);
  transition error==0 {true -> (FieldValueRead::Buffer {length:length,bytes:output}) _ -> (FieldValueRead::Failure {reason:FieldReadFailure::InvalidState})}
 }
}
machine field_value_failure(outcome:|byte_storage|::ByteOutcome)->FieldValueRead {
 transition outcome {
  |byte_storage|::ByteOutcome::UnsupportedValue -> (FieldValueRead::Failure {reason:FieldReadFailure::UnsupportedValue})
  |byte_storage|::ByteOutcome::Bounds -> (FieldValueRead::Failure {reason:FieldReadFailure::Bounds})
  |byte_storage|::ByteOutcome::Capacity -> (FieldValueRead::Failure {reason:FieldReadFailure::Capacity})
  |byte_storage|::ByteOutcome::Encoding -> (FieldValueRead::Failure {reason:FieldReadFailure::Encoding})
  |byte_storage|::ByteOutcome::ReferenceCycle -> (FieldValueRead::Failure {reason:FieldReadFailure::ReferenceCycle})
  |byte_storage|::ByteOutcome::WorkLimit -> (FieldValueRead::Failure {reason:FieldReadFailure::WorkLimit})
  _ -> (FieldValueRead::Failure {reason:FieldReadFailure::InvalidState})
 }
}
