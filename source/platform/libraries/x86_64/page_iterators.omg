// Modified detached PageRange/Inclusive cursor transitions from x86_64
// cc35c876d3badb57df54a66e22f7768a52be95f2. See page-iterators.PORT.md.
// Ordinary cursor numbers confer no mapping, pointer or frame authority.
use addresses.omg;
use pages.omg;
use encrypted_frames.omg;

// Index zero models next/next_back as well as nth(0)/nth_back(0). Rejected
// selection without failed means exhaustion. Failed retains every preceding
// cursor update but never yields the value whose next update panicked.
pub machine step(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->|encrypted_frames|::IteratorResult {
 let first:bool=|pages|::start_valid(start,size,false);
 let last:bool=|pages|::start_valid(end,size,false);
 transition first && last && size>0 {
  true -> admitted(start,end,size,inclusive,index,reverse)
  _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})
 }
 state admitted(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->|encrypted_frames|::IteratorResult {
  transition start>end || (!inclusive && start==end) {
   true -> (|encrypted_frames|::IteratorResult {start:start,end:end})
   _ -> length(start,end,size,inclusive,index,reverse)
  }
 }
 state length(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->|encrypted_frames|::IteratorResult {
  let difference:|addresses|::NumberResult=|pages|::difference(end,start,size,false);
  transition difference {
   |addresses|::NumberResult::Value {value} -> count(start,end,size,inclusive,index,reverse,value)
   _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})
  }
 }
 state count(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool,difference:u64)->|encrypted_frames|::IteratorResult {
  let count:|addresses|::NumberResult=|addresses|::checked_add(difference,inclusive as u64);
  transition count {
   |addresses|::NumberResult::Value {value} -> select(start,end,size,inclusive,index,reverse,value)
   _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})
  }
 }
 state select(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool,count:u64)->|encrypted_frames|::IteratorResult {
  transition {
   count==0 -> (|encrypted_frames|::IteratorResult {start:start,end:end})
   index<count -> within(start,end,size,inclusive,index,reverse)
   _ -> exhaust(start,end,size,inclusive,count-1,reverse)
  }
 }
 state within(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->|encrypted_frames|::IteratorResult {
  let result:|encrypted_frames|::IteratorResult=selected_step(start,end,size,inclusive,index,reverse);result
 }
 state exhaust(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->|encrypted_frames|::IteratorResult {
  let result:|encrypted_frames|::IteratorResult=selected_step(start,end,size,inclusive,index,reverse);
  transition result.failed {true -> (result) _ -> after_last(result,size,inclusive,reverse)}
 }
 state after_last(result:|encrypted_frames|::IteratorResult,size:u64,inclusive:bool,reverse:bool)->|encrypted_frames|::IteratorResult {
  transition result.selection {
   |addresses|::NumberResult::Value {value} -> extra(result.start,result.end,size,inclusive,reverse)
   _ -> (result)
  }
 }
 state extra(start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->|encrypted_frames|::IteratorResult {
  let result:|encrypted_frames|::IteratorResult=next_step(start,end,size,inclusive,reverse);result
 }
}

machine selected_step(start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->|encrypted_frames|::IteratorResult {
 transition reverse {true -> reverse_gap(start,end,size,inclusive,index) _ -> forward_gap(start,end,size,inclusive,index)}
 state forward_gap(start:u64,end:u64,size:u64,inclusive:bool,index:u64)->|encrypted_frames|::IteratorResult {
  let distance:|addresses|::NumberResult=|pages|::steps_between(start,18446603336221196288,size);
  let count:u64=before_gap(distance,index);
  let result:|encrypted_frames|::IteratorResult=move_then_next(start,end,size,inclusive,count,false);result
 }
 state reverse_gap(start:u64,end:u64,size:u64,inclusive:bool,index:u64)->|encrypted_frames|::IteratorResult {
  let boundary:|addresses|::NumberResult=|pages|::containing(140737488351232,size,false);
  transition boundary {
   |addresses|::NumberResult::Value {value} -> measured(start,end,size,inclusive,index,value)
   _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})
  }
 }
 state measured(start:u64,end:u64,size:u64,inclusive:bool,index:u64,boundary:u64)->|encrypted_frames|::IteratorResult {
  let distance:|addresses|::NumberResult=|pages|::steps_between(boundary,end,size);
  let count:u64=before_gap(distance,index);
  let result:|encrypted_frames|::IteratorResult=move_then_next(start,end,size,inclusive,count,true);result
 }
}
// A gap-crossing nth first moves to its adjacent canonical page, then its
// ordinary next operation fails. It must not jump across using dense Step.
machine before_gap(distance:|addresses|::NumberResult,index:u64)->u64 {
 transition distance {|addresses|::NumberResult::Value {value} -> selected(value,index) _ -> (index)}
 state selected(distance:u64,index:u64)->u64 {
  transition distance>0 && distance<=index {true -> (distance-1) _ -> (index)}
 }
}
machine move_then_next(start:u64,end:u64,size:u64,inclusive:bool,count:u64,reverse:bool)->|encrypted_frames|::IteratorResult {
 transition reverse {true -> back(start,end,size,inclusive,count) _ -> front(start,end,size,inclusive,count)}
 state front(start:u64,end:u64,size:u64,inclusive:bool,count:u64)->|encrypted_frames|::IteratorResult {
  let moved:|addresses|::NumberResult=raw_move(start,size,count,false);
  transition moved {|addresses|::NumberResult::Value {value} -> next(value,end,size,inclusive,false) _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})}
 }
 state back(start:u64,end:u64,size:u64,inclusive:bool,count:u64)->|encrypted_frames|::IteratorResult {
  let moved:|addresses|::NumberResult=raw_move(end,size,count,true);
  transition moved {|addresses|::NumberResult::Value {value} -> next(start,value,size,inclusive,true) _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})}
 }
 state next(start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->|encrypted_frames|::IteratorResult {
  let result:|encrypted_frames|::IteratorResult=next_step(start,end,size,inclusive,reverse);result
 }
}
machine next_step(start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->|encrypted_frames|::IteratorResult {
 transition start>end || (!inclusive && start==end) {true -> (|encrypted_frames|::IteratorResult {start:start,end:end}) _ -> direction(start,end,size,inclusive,reverse)}
 state direction(start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->|encrypted_frames|::IteratorResult {
  transition reverse {true -> backwards(start,end,size,inclusive) _ -> forward(start,end,size,inclusive)}
 }
 state backwards(start:u64,end:u64,size:u64,inclusive:bool)->|encrypted_frames|::IteratorResult {
  transition inclusive && end==0 {true -> advance(start,end,size,end) _ -> decrement(start,end,size,inclusive)}
 }
 state decrement(start:u64,end:u64,size:u64,inclusive:bool)->|encrypted_frames|::IteratorResult {
  let moved:|addresses|::NumberResult=raw_move(end,size,1,true);
  transition moved {|addresses|::NumberResult::Value {value} -> back_result(start,end,value,inclusive) _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})}
 }
 state back_result(start:u64,old_end:u64,end:u64,inclusive:bool)->|encrypted_frames|::IteratorResult {
  transition inclusive {true -> (|encrypted_frames|::IteratorResult {start:start,end:end,selection:|addresses|::NumberResult::Value {value:old_end}}) _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,selection:|addresses|::NumberResult::Value {value:end}})}
 }
 state forward(start:u64,end:u64,size:u64,inclusive:bool)->|encrypted_frames|::IteratorResult {
  let maximum:|addresses|::NumberResult=|pages|::containing(|addresses|::INTEGER_MAX,size,false);
  transition maximum {|addresses|::NumberResult::Value {value} -> compare(start,end,size,inclusive,value) _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})}
 }
 state compare(start:u64,end:u64,size:u64,inclusive:bool,maximum:u64)->|encrypted_frames|::IteratorResult {
  transition inclusive && start>=maximum {true -> decrement_last(start,end,size) _ -> advance(start,end,size,start)}
 }
 state decrement_last(start:u64,end:u64,size:u64)->|encrypted_frames|::IteratorResult {
  let moved:|addresses|::NumberResult=raw_move(end,size,1,true);
  transition moved {|addresses|::NumberResult::Value {value} -> (|encrypted_frames|::IteratorResult {start:start,end:value,selection:|addresses|::NumberResult::Value {value:start}}) _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})}
 }
 state advance(start:u64,end:u64,size:u64,selected:u64)->|encrypted_frames|::IteratorResult {
  let moved:|addresses|::NumberResult=raw_move(start,size,1,false);
  transition moved {|addresses|::NumberResult::Value {value} -> (|encrypted_frames|::IteratorResult {start:value,end:end,selection:|addresses|::NumberResult::Value {value:selected}}) _ -> (|encrypted_frames|::IteratorResult {start:start,end:end,failed:true})}
 }
}

// Inputs are admitted by step. Select only the requested virtual arithmetic
// before calling its existing checked helper; pages::arithmetic also computes
// unused physical alternatives, expanding the caller's analysis needlessly.
machine raw_move(address:u64,size:u64,count:u64,reverse:bool)->|addresses|::NumberResult {
 transition size>0 {true -> bounded(address,size,count,reverse) _ -> (|addresses|::NumberResult::Rejected)}
 state bounded(address:u64,size:u64,count:u64,reverse:bool)->|addresses|::NumberResult {
  transition count<=|addresses|::INTEGER_MAX/size {true -> selected(address,size*count,reverse) _ -> (|addresses|::NumberResult::Rejected)}
 }
 state selected(address:u64,bytes:u64,reverse:bool)->|addresses|::NumberResult {
  transition reverse {true -> subtract(address,bytes) _ -> add(address,bytes)}
 }
 state subtract(address:u64,bytes:u64)->|addresses|::NumberResult {let value:|addresses|::NumberResult=|addresses|::virtual_sub(address,bytes);value}
 state add(address:u64,bytes:u64)->|addresses|::NumberResult {let value:|addresses|::NumberResult=|addresses|::virtual_add(address,bytes);value}
}
