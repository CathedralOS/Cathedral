// Modified numeric frame.rs algorithms from x86_64 cc35c876d3badb57df54a66e22f7768a52be95f2.
// Explicit detached profile and numeric cursor observations, never frame authority.
use addresses.omg;
use pages.omg;
use memory_encryption.omg;

pub data IteratorResult [copy] { start:u64; end:u64; selection:|addresses|::NumberResult; failed:bool; }
pub machine start_valid(profile:|memory_encryption|::State,address:u64,size:u64)->bool {
 let mask:u64=profile.bit_mask & |addresses|::PHYSICAL_MAX;
 let physical:bool=|addresses|::physical_valid(address,mask);
 let geometry:bool=|pages|::start_valid(address,size,true);physical && geometry
}
pub machine from_start(profile:|memory_encryption|::State,address:u64,size:u64)->|addresses|::NumberResult {
 let valid:bool=start_valid(profile,address,size);
 transition valid {true -> (|addresses|::NumberResult::Value {value:address}) _ -> (|addresses|::NumberResult::Rejected)}
}
pub machine containing(profile:|memory_encryption|::State,address:u64,size:u64)->|addresses|::NumberResult {
 let mask:u64=profile.bit_mask & |addresses|::PHYSICAL_MAX;
 let valid:bool=|pages|::page_size_valid(size);
 transition valid {true -> align(address,size,mask) _ -> (|addresses|::NumberResult::Rejected)}
 state align(address:u64,size:u64,mask:u64)->|addresses|::NumberResult {let result:|addresses|::NumberResult=|addresses|::physical_align(address,size,false,mask);result}
}
pub machine from_pfn(profile:|memory_encryption|::State,pfn:u64,size:u64)->|addresses|::NumberResult {
 let valid:bool=|pages|::page_size_valid(size);
 transition valid && size>0 {true -> bounded(profile,pfn,size) _ -> (|addresses|::NumberResult::Rejected)}
 state bounded(profile:|memory_encryption|::State,pfn:u64,size:u64)->|addresses|::NumberResult {
  transition pfn<=|addresses|::INTEGER_MAX/size {true -> product(profile,pfn*size) _ -> (|addresses|::NumberResult::Rejected)}
 }
 state product(profile:|memory_encryption|::State,address:u64)->|addresses|::NumberResult {let result:|addresses|::NumberResult=|memory_encryption|::physical_check(&profile,address);result}
}
pub machine pfn(profile:|memory_encryption|::State,address:u64,size:u64)->|addresses|::NumberResult {
 let valid:bool=start_valid(profile,address,size);
 transition valid && size>0 {true -> (|addresses|::NumberResult::Value {value:address/size}) _ -> (|addresses|::NumberResult::Rejected)}
}
pub machine arithmetic(profile:|memory_encryption|::State,address:u64,size:u64,count:u64,backwards:bool)->|addresses|::NumberResult {
 let valid:bool=start_valid(profile,address,size);
 transition valid && size>0 {true -> bounded(profile,address,size,count,backwards) _ -> (|addresses|::NumberResult::Rejected)}
 state bounded(profile:|memory_encryption|::State,address:u64,size:u64,count:u64,backwards:bool)->|addresses|::NumberResult {
  transition count<=|addresses|::INTEGER_MAX/size {true -> calculate(profile,address,count*size,backwards) _ -> (|addresses|::NumberResult::Rejected)}
 }
 state calculate(profile:|memory_encryption|::State,address:u64,bytes:u64,backwards:bool)->|addresses|::NumberResult {
  let mask:u64=profile.bit_mask & |addresses|::PHYSICAL_MAX;
  transition backwards {true -> subtract(address,bytes,mask) _ -> add(address,bytes,mask)}
 }
 state subtract(address:u64,bytes:u64,mask:u64)->|addresses|::NumberResult {let result:|addresses|::NumberResult=|addresses|::physical_sub(address,bytes,mask);result}
 state add(address:u64,bytes:u64,mask:u64)->|addresses|::NumberResult {let result:|addresses|::NumberResult=|addresses|::physical_add(address,bytes,mask);result}
}
pub machine arithmetic_overflowing(profile:|memory_encryption|::State,address:u64,size:u64,count:u64,backwards:bool)->|addresses|::OverflowingStep {
 let result:|addresses|::NumberResult=arithmetic(profile,address,size,count,backwards);
 transition result {|addresses|::NumberResult::Value {value} -> (|addresses|::OverflowingStep {value:value}) _ -> (|addresses|::OverflowingStep {value:address,overflow:true})}
}
pub machine difference(profile:|memory_encryption|::State,end:u64,start:u64,size:u64)->|addresses|::NumberResult {
 let first:bool=start_valid(profile,start,size);let last:bool=start_valid(profile,end,size);
 transition first && last && size>0 && end>=start {true -> (|addresses|::NumberResult::Value {value:(end-start)/size}) _ -> (|addresses|::NumberResult::Rejected)}
}
pub machine range_count(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool)->|addresses|::NumberResult {
 let first:bool=start_valid(profile,start,size);let last:bool=start_valid(profile,end,size);
 transition first && last {true -> count(start,end,size,inclusive) _ -> (|addresses|::NumberResult::Rejected)}
 state count(start:u64,end:u64,size:u64,inclusive:bool)->|addresses|::NumberResult {
  let result:|addresses|::NumberResult=|pages|::range_count(start,end,size,inclusive,true);result
 }
}
pub machine range_bytes(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool)->|addresses|::NumberResult {
 let count:|addresses|::NumberResult=range_count(profile,start,end,size,inclusive);
 transition count {|addresses|::NumberResult::Value {value} -> multiply(value,size) _ -> (|addresses|::NumberResult::Rejected)}
 state multiply(count:u64,size:u64)->|addresses|::NumberResult {
  transition size>0 && count<=|addresses|::INTEGER_MAX/size {true -> (|addresses|::NumberResult::Value {value:count*size}) _ -> (|addresses|::NumberResult::Rejected)}
 }
}
// Bounded numeric selection does not execute a successor update. It never skips
// excluded address bands and is deliberately distinct from iterator_step below.
pub machine range_at(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->|addresses|::NumberResult {
 let count:|addresses|::NumberResult=range_count(profile,start,end,size,inclusive);
 transition count {|addresses|::NumberResult::Value {value} -> bounded(profile,start,size,index,reverse,value) _ -> (|addresses|::NumberResult::Rejected)}
 state bounded(profile:|memory_encryption|::State,start:u64,size:u64,index:u64,reverse:bool,count:u64)->|addresses|::NumberResult {
  transition index<count {true -> choose(profile,start,size,index,reverse,count-index-1) _ -> (|addresses|::NumberResult::Rejected)}
 }
 state choose(profile:|memory_encryption|::State,start:u64,size:u64,index:u64,reverse:bool,back:u64)->|addresses|::NumberResult {
  transition reverse {true -> select(profile,start,size,back) _ -> select(profile,start,size,index)}
 }
 state select(profile:|memory_encryption|::State,start:u64,size:u64,index:u64)->|addresses|::NumberResult {let result:|addresses|::NumberResult=arithmetic(profile,start,size,index,false);result}
}
// Equivalent detached nth/nth_back cursor ordering. Failed models a caught
// panic/rejected arithmetic; Rejected without failed means exhausted. Numeric
// cursor updates completed before a failure are retained in the result.
pub machine iterator_step(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->IteratorResult {
 let count:|addresses|::NumberResult=range_count(profile,start,end,size,inclusive);
 transition count {|addresses|::NumberResult::Value {value} -> admitted(profile,start,end,size,inclusive,index,reverse,value) _ -> (IteratorResult {start:start,end:end,failed:true})}
 state admitted(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool,count:u64)->IteratorResult {
  transition count==0 {true -> (IteratorResult {start:start,end:end}) _ -> select(profile,start,end,size,inclusive,index,reverse,count)}
 }
 state select(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool,count:u64)->IteratorResult {
  transition index<count {true -> within(profile,start,end,size,inclusive,index,reverse) _ -> exhaust(profile,start,end,size,inclusive,count-1,reverse)}
 }
 state within(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->IteratorResult {
  let result:IteratorResult=ef_iterator_within(profile,start,end,size,inclusive,index,reverse);result
 }
 state exhaust(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,last:u64,reverse:bool)->IteratorResult {
  let selected:IteratorResult=ef_iterator_within(profile,start,end,size,inclusive,last,reverse);
  transition selected.failed {true -> (selected) _ -> finish(profile,selected,size,inclusive,reverse)}
 }
 state finish(profile:|memory_encryption|::State,selected:IteratorResult,size:u64,inclusive:bool,reverse:bool)->IteratorResult {
  transition selected.selection {|addresses|::NumberResult::Value {value} -> next(profile,selected.start,selected.end,size,inclusive,reverse) _ -> (selected)}
 }
 state next(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->IteratorResult {
  let result:IteratorResult=ef_iterator_next(profile,start,end,size,inclusive,reverse);result
 }
}
machine ef_iterator_within(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64,reverse:bool)->IteratorResult {
 transition reverse {true -> back(profile,start,end,size,inclusive,index) _ -> front(profile,start,end,size,inclusive,index)}
 state front(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64)->IteratorResult {
  let moved:|addresses|::NumberResult=arithmetic(profile,start,size,index,false);
  transition moved {|addresses|::NumberResult::Value {value} -> next(profile,value,end,size,inclusive,false) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
 state back(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,index:u64)->IteratorResult {
  let moved:|addresses|::NumberResult=arithmetic(profile,end,size,index,true);
  transition moved {|addresses|::NumberResult::Value {value} -> next(profile,start,value,size,inclusive,true) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
 state next(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->IteratorResult {
  let result:IteratorResult=ef_iterator_next(profile,start,end,size,inclusive,reverse);result
 }
}
machine ef_iterator_next(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->IteratorResult {
 transition start>end || (!inclusive && start==end) {true -> (IteratorResult {start:start,end:end}) _ -> direction(profile,start,end,size,inclusive,reverse)}
 state direction(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool,reverse:bool)->IteratorResult {
  transition reverse {true -> backwards(profile,start,end,size,inclusive) _ -> forward(profile,start,end,size,inclusive)}
 }
 state backwards(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool)->IteratorResult {
  transition inclusive && end==0 {true -> advance_front(profile,start,end,size,end) _ -> decrement(profile,start,end,size,inclusive)}
 }
 state decrement(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool)->IteratorResult {
  let moved:|addresses|::NumberResult=arithmetic(profile,end,size,1,true);
  transition moved {|addresses|::NumberResult::Value {value} -> back_result(start,end,value,inclusive) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
 state back_result(start:u64,old_end:u64,end:u64,inclusive:bool)->IteratorResult {
  transition inclusive {true -> (IteratorResult {start:start,end:end,selection:|addresses|::NumberResult::Value {value:old_end}}) _ -> (IteratorResult {start:start,end:end,selection:|addresses|::NumberResult::Value {value:end}})}
 }
 state forward(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,inclusive:bool)->IteratorResult {
  transition inclusive {true -> maximum(profile,start,end,size) _ -> advance_front(profile,start,end,size,start)}
 }
 state maximum(profile:|memory_encryption|::State,start:u64,end:u64,size:u64)->IteratorResult {
  let top:|addresses|::NumberResult=|memory_encryption|::physical_truncate(&profile,|addresses|::INTEGER_MAX);
  transition top {|addresses|::NumberResult::Value {value} -> top_address(profile,start,end,size,value) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
 state top_address(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,top:u64)->IteratorResult {
  let mask:u64=profile.bit_mask & |addresses|::PHYSICAL_MAX;
  transition size>0 {true -> subtract_top(profile,start,end,size,top,mask,size-1) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
 state subtract_top(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,top:u64,mask:u64,amount:u64)->IteratorResult {
  let maximum:|addresses|::NumberResult=|addresses|::physical_sub(top,amount,mask);
  transition maximum {|addresses|::NumberResult::Value {value} -> compare(profile,start,end,size,value) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
 state compare(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,maximum:u64)->IteratorResult {
  transition start<maximum {true -> advance_front(profile,start,end,size,start) _ -> decrement_last(profile,start,end,size)}
 }
 state decrement_last(profile:|memory_encryption|::State,start:u64,end:u64,size:u64)->IteratorResult {
  let moved:|addresses|::NumberResult=arithmetic(profile,end,size,1,true);
  transition moved {|addresses|::NumberResult::Value {value} -> (IteratorResult {start:start,end:value,selection:|addresses|::NumberResult::Value {value:start}}) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
 state advance_front(profile:|memory_encryption|::State,start:u64,end:u64,size:u64,selected:u64)->IteratorResult {
  let moved:|addresses|::NumberResult=arithmetic(profile,start,size,1,false);
  transition moved {|addresses|::NumberResult::Value {value} -> (IteratorResult {start:value,end:end,selection:|addresses|::NumberResult::Value {value:selected}}) _ -> (IteratorResult {start:start,end:end,failed:true})}
 }
}
