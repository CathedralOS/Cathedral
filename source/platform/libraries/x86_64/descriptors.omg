module descriptors;
use facts::x86_descriptors;
use facts::x86_descriptors::Descriptor;
use facts::x86_descriptors::TaskStateSegment;
use facts::x86_descriptors::TssDescriptorWords;
use facts::x86_descriptors::SelectorErrorCode;
use facts::x86_registers::SegmentSelector;
use facts::x86_interrupt_stacks;

pub data IoMapResult [copy] { error: u8; detail: u64; expected_base: u16; got_base: u16; limit: u16; }
pub data GdtAppendPlan [copy] { error: u8; index: u16; next_length: u16; selector: SegmentSelector; }

pub machine tss_new() -> TaskStateSegment {
    TaskStateSegment { reserved_1: 0, privilege_stack_table: [0, 0, 0], reserved_2: 0,
        interrupt_stack_table: [0, 0, 0, 0, 0, 0, 0], reserved_3: 0, reserved_4: 0, iomap_base: 104 }
}
// Existing policy assigns hardware indices 1..7; array slot is zero-based.
pub machine ist_slot(stack: &X86IstStackClass) -> u8 { (stack.ist_index - 1) as u8 }
pub machine user_segment(bits: u64) -> Descriptor { Descriptor::UserSegment { low: bits } }
pub machine system_segment(low: u64, high: u64) -> Descriptor { Descriptor::SystemSegment { low: low, high: high } }
pub machine descriptor_low(value: Descriptor) -> u64 {
    transition value {
        Descriptor::UserSegment { low } -> (low)
        Descriptor::SystemSegment { low, high } -> (low)
    }
}
pub machine descriptor_word_count(value: Descriptor) -> u8 {
    transition value {
        Descriptor::UserSegment { low } -> (1)
        Descriptor::SystemSegment { low, high } -> (2)
    }
}
pub machine descriptor_dpl(value: Descriptor) -> u8 {
    let low: u64 = descriptor_low(value);
    ((low >> 45) & 3) as u8
}
pub machine kernel_code_segment() -> Descriptor { Descriptor::UserSegment { low: x86_descriptors::DESCRIPTOR_KERNEL_CODE64.raw } }
pub machine kernel_data_segment() -> Descriptor { Descriptor::UserSegment { low: x86_descriptors::DESCRIPTOR_KERNEL_DATA.raw } }
pub machine user_code_segment() -> Descriptor { Descriptor::UserSegment { low: x86_descriptors::DESCRIPTOR_USER_CODE64.raw } }
pub machine user_data_segment() -> Descriptor { Descriptor::UserSegment { low: x86_descriptors::DESCRIPTOR_USER_DATA.raw } }
pub machine gdt_capacity_valid(capacity: u16) -> bool { capacity >= 1 && capacity <= 8192 }
pub machine gdt_raw_metadata_valid(length: u16, capacity: u16, first_word: u64) -> bool {
    capacity >= 1 && capacity <= 8192 && length >= 1 && length <= capacity && first_word == 0
}
pub machine gdt_limit(length: u16 [1..=8192]) -> u16 { (((length as u32) * 8 - 1) & 65535) as u16 }
// error 1 = invalid table geometry; 2 = full. Descriptor cases establish
// whether one or two words are needed; an invalid shape is unrepresentable.
// Returned indices/selector are intended detached writes, not storage access.
pub machine gdt_append_plan(length: u16, capacity: u16, value: Descriptor) -> GdtAppendPlan {
    transition capacity >= 1 && capacity <= 8192 && length >= 1 && length <= capacity {
        true -> room(length, capacity, value)
        _ -> (GdtAppendPlan { error: 1, index: 0, next_length: length, selector: SegmentSelector { raw: 0 } })
    }
    state room(length: u16, capacity: u16, value: Descriptor) {
        let words: u8 = descriptor_word_count(value);
        let next: u32 = (length as u32) + (words as u32);
        transition next <= (capacity as u32) {
            true -> ready(length, next, value)
            _ -> (GdtAppendPlan { error: 2, index: 0, next_length: length, selector: SegmentSelector { raw: 0 } })
        }
    }
    state ready(length: u16, next: u32, value: Descriptor) {
        let dpl: u8 = descriptor_dpl(value);
        GdtAppendPlan { error: 0, index: length, next_length: (next & 65535) as u16,
            selector: SegmentSelector { raw: (length << 3) | (dpl as u16) } }
    }
}
// Numeric source algorithm. Every bit of base is preserved without interpreting
// it as a canonical, backed, stable or dereferenceable pointer.
pub machine tss_descriptor(base: u64, limit: u16) -> TssDescriptorWords {
    TssDescriptorWords { low: (limit as u64) | ((base & 16777215) << 16) |
        (((base >> 24) & 255) << 56) | 150633093005312, high: base >> 32 }
}
pub machine tss_descriptor_base(value: &TssDescriptorWords) -> u64 {
    ((value.low >> 16) & 16777215) | (((value.low >> 56) & 255) << 24) | ((value.high & 4294967295) << 32)
}
pub machine tss_descriptor_limit(value: &TssDescriptorWords) -> u16 { (value.low & 65535) as u16 }
pub machine tss_descriptor_shape_valid(value: &TssDescriptorWords) -> bool {
    (value.low & 72056494526300160) == 150633093005312 && (value.high >> 32) == 0
}
// Source validation order: length, ordering, distance, terminator, declared base.
// A last_byte argument is an observed byte, not a promise about unread storage.
pub machine iomap_validate_observed(tss_base: u64, map_base: u64, length: u64, last_byte: u8, declared_base: u16) -> IoMapResult {
    transition length <= 8193 {
        true -> ordering(tss_base, map_base, length, last_byte, declared_base)
        _ -> (IoMapResult { error: 4, detail: length, expected_base: 0, got_base: declared_base, limit: 0 })
    }
    state ordering(tss_base: u64, map_base: u64, length: u64, last_byte: u8, declared_base: u16) {
        transition map_base >= tss_base {
            true -> distance(tss_base, map_base, length, last_byte, declared_base)
            _ -> (IoMapResult { error: 1, detail: 0, expected_base: 0, got_base: declared_base, limit: 0 })
        }
    }
    state distance(tss_base: u64, map_base: u64, length: u64, last_byte: u8, declared_base: u16) {
        let distance: u64 = map_base - tss_base;
        transition distance <= 57343 {
            true -> terminator(distance, length, last_byte, declared_base)
            _ -> (IoMapResult { error: 2, detail: distance, expected_base: 0, got_base: declared_base, limit: 0 })
        }
    }
    state terminator(distance: u64, length: u64, last_byte: u8, declared_base: u16) {
        transition length == 0 || last_byte == 255 {
            true -> declared(distance, length, declared_base)
            _ -> (IoMapResult { error: 3, detail: last_byte as u64, expected_base: 0, got_base: declared_base, limit: 0 })
        }
    }
    state declared(distance: u64, length: u64, declared_base: u16) {
        transition distance == (declared_base as u64) {
            true -> extent(distance, length, declared_base)
            _ -> (IoMapResult { error: 5, detail: 0, expected_base: (distance & 65535) as u16, got_base: declared_base, limit: 0 })
        }
    }
    state extent(distance: u64, length: u64, declared_base: u16) {
        let end: u64 = distance + length;
        transition end >= 104 {
            true -> (IoMapResult { error: 0, detail: 0, expected_base: declared_base, got_base: declared_base, limit: ((end - 1) & 65535) as u16 })
            _ -> (IoMapResult { error: 0, detail: 0, expected_base: declared_base, got_base: declared_base, limit: 103 })
        }
    }
}
// Borrow is the ordinary initialized byte input; numeric map_base does not
// manufacture that borrow. Runtime slices are deliberately not reconstructed.
pub machine iomap_validate(input: &[u8; 8193], tss_base: u64, map_base: u64, length: u64, declared_base: u16) -> IoMapResult {
    transition length >= 1 && length <= 8193 {
        true -> read_last(input, tss_base, map_base, length, declared_base)
        _ -> unchecked_length(tss_base, map_base, length, declared_base)
    }
    state read_last(input: &[u8; 8193], tss_base: u64, map_base: u64, length: u64, declared_base: u16) {
        let index: u64 = length - 1;
        transition index < 8193 {
            true -> observed(input, tss_base, map_base, length, declared_base, index)
            _ -> (IoMapResult { error: 4, detail: length, expected_base: 0, got_base: declared_base, limit: 0 })
        }
    }
    state observed(input: &[u8; 8193], tss_base: u64, map_base: u64, length: u64, declared_base: u16, index: u64) {
        let result: IoMapResult = iomap_validate_observed(tss_base, map_base, length, input[index], declared_base);
        result
    }
    state unchecked_length(tss_base: u64, map_base: u64, length: u64, declared_base: u16) {
        let result: IoMapResult = iomap_validate_observed(tss_base, map_base, length, 255, declared_base);
        result
    }
}
pub machine selector_error_valid(bits: u64) -> bool { bits <= 65535 }
pub machine selector_error_truncate(bits: u64) -> SelectorErrorCode { SelectorErrorCode { raw: bits & 65535 } }
pub machine selector_error_external(value: &SelectorErrorCode) -> bool { (value.raw & 1) != 0 }
pub machine selector_error_table(value: &SelectorErrorCode) -> u8 {
    transition (value.raw >> 1) & 3 {
        0 -> (0)
        2 -> (2)
        _ -> (1)
    }
}
pub machine selector_error_index(value: &SelectorErrorCode) -> u16 { ((value.raw >> 3) & 8191) as u16 }
pub machine selector_error_is_null(value: &SelectorErrorCode) -> bool { value.raw == 0 }
