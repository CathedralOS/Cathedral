// Modified pure orchestration of pinned x86_64 RecursivePageTable Mapper methods.
// Reuses canonical capture/request/effect types; see recursive-routes.PORT.md.
// Captures, allocations and edits are numeric proposals, never live custody.
use pages.omg;
use page_entries.omg;
use mapping_plans.omg;

use mapping_routes.omg;

pub machine plan(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, page: u64, size: u64, request: |mapping_routes|::Request) -> |mapping_routes|::RoutePlan {
    let valid_page: bool = |pages|::start_valid(page, size, false);
    let valid_request: bool = request_valid(request, size);
    transition valid_page && valid_request {
        true -> begin(path, allocations, page, size, request)
        _ -> (|mapping_routes|::RoutePlan {})
    }
    state begin(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, page: u64, size: u64, request: |mapping_routes|::Request) -> |mapping_routes|::RoutePlan {
        let edits: |mapping_routes|::Edits = |mapping_routes|::Edits { table_ids: path.table_ids, words: path.words,
            indices: [((page >> 39) & 511) as u16, ((page >> 30) & 511) as u16,
                ((page >> 21) & 511) as u16, ((page >> 12) & 511) as u16] };
        let target: u8 = target_index(size, request);
        let outcome: |mapping_routes|::Outcome = route(path, allocations, &mut edits, size, request, target);
        |mapping_routes|::RoutePlan { edits: edits, outcome: outcome }
    }
}
machine request_valid(request: |mapping_routes|::Request, size: u64) -> bool {
    transition request {
        |mapping_routes|::Request::Map { frame, flags, parent_flags } -> frame_valid(frame, size)
        |mapping_routes|::Request::SetParent { level, table_flags } -> (level >= 2 && level <= 4)
        _ -> (true)
    }
    state frame_valid(frame: u64, size: u64) -> bool {
        let valid: bool = |pages|::start_valid(frame, size, true);
        valid
    }
}
machine target_index(size: u64, request: |mapping_routes|::Request) -> u8 {
    transition request {
        |mapping_routes|::Request::SetParent { level, table_flags } -> parent(level)
        _ -> leaf(size)
    }
    state leaf(size: u64) -> u8 {
        transition size { 1073741824 -> (1) 2097152 -> (2) _ -> (3) }
    }
    state parent(level: u8) -> u8 {
        transition level <= 4 { true -> (4 - level) _ -> (4) }
    }
}
machine route(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
    let leaf: u8 = target_index(size, |mapping_routes|::Request::Translate);
    transition {
        target > leaf -> (|mapping_routes|::Outcome::ParentHugePage)
        target == leaf && is_parent_request(request) -> (|mapping_routes|::Outcome::ParentHugePage)
        target == 0 -> complete(edits, size, request, 0)
        _ -> first(path, allocations, edits, size, request, target)
    }
    state first(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = parent_step(path, allocations, edits, request, 0);
        transition result {
            |mapping_routes|::Outcome::Continue -> second(path, allocations, edits, size, request, target)
            _ -> (result)
        }
    }
    state second(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        transition target == 1 { true -> complete(edits, size, request, 1) _ -> descend_second(path, allocations, edits, size, request, target) }
    }
    state descend_second(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = parent_step(path, allocations, edits, request, 1);
        transition result { |mapping_routes|::Outcome::Continue -> third(path, allocations, edits, size, request, target) _ -> (result) }
    }
    state third(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        transition target == 2 { true -> complete(edits, size, request, 2) _ -> descend_third(path, allocations, edits, size, request) }
    }
    state descend_third(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = parent_step(path, allocations, edits, request, 2);
        transition result { |mapping_routes|::Outcome::Continue -> complete(edits, size, request, 3) _ -> (result) }
    }
    state complete(edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, index: u8 [0..=3]) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = finish(edits, size, request, index);
        result
    }
}
machine is_parent_request(request: |mapping_routes|::Request) -> bool {
    transition request { |mapping_routes|::Request::SetParent { level, table_flags } -> (true) _ -> (false) }
}
machine parent_step(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, request: |mapping_routes|::Request, index: u8 [0..=2]) -> |mapping_routes|::Outcome {
    edits.visited = index + 1;
    let word: u64 = edits.words[index];
    transition request {
        |mapping_routes|::Request::Map { frame, flags, parent_flags } -> mapping(path, allocations, edits, index, word, parent_flags)
        |mapping_routes|::Request::Unmap -> existing(path, edits, index, word)
        _ -> nonzero(path, edits, index, word)
    }
    state mapping(path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], word: u64, flags: u64) -> |mapping_routes|::Outcome {
        let supplied: |mapping_plans|::FrameSupply = allocation(allocations, edits, word);
        let child: |mapping_plans|::ChildPlan = prepare_child(word, flags, supplied);
        record_word(edits, index, child.word, child.write);
        transition child {
            |mapping_plans|::ChildPlan::Ready { address, zero_child } -> ready_child(path, edits, index, address, zero_child)
            _ -> (|mapping_routes|::Outcome::ChildFailure { child: child })
        }
    }
    state nonzero(path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], word: u64) -> |mapping_routes|::Outcome {
        let address: u64 = |page_entries|::address(word);
        transition word == 0 {
            true -> (|mapping_routes|::Outcome::ParentNotMapped)
            _ -> ready_child(path, edits, index, address, false)
        }
    }
    state existing(path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], word: u64) -> |mapping_routes|::Outcome {
        let address: u64 = |page_entries|::address(word);
        let present: bool = (word & 1) != 0;
        let huge: bool = (word & 128) != 0;
        transition {
            !present -> (|mapping_routes|::Outcome::ParentNotMapped)
            huge -> (|mapping_routes|::Outcome::ParentHugePage)
            _ -> ready_child(path, edits, index, address, false)
        }
    }
    state ready_child(path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], address: u64, zero: bool) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = child_ready(path, edits, index, address, zero);
        result
    }
}
machine allocation(allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, word: u64) -> |mapping_plans|::FrameSupply {
    let count: u8 = edits.allocation_calls;
    transition word == 0 && count < 3 {
        true -> consume(allocations, edits, count)
        _ -> (|mapping_plans|::FrameSupply::Unavailable)
    }
    state consume(allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, count: u8 [0..=2]) -> |mapping_plans|::FrameSupply {
        let supplied: |mapping_plans|::FrameSupply = allocations.frames[count];
        edits.allocation_calls = count + 1;
        supplied
    }
}
machine record_word(edits: &mut |mapping_routes|::Edits, index: u8 [0..=3], word: u64, write: bool) {
    edits.words[index] = word;
    transition write { true -> record(edits, index) _ -> {} }
    state record(edits: &mut |mapping_routes|::Edits, index: u8 [0..=3]) {
        edits.write_mask = edits.write_mask | ((1 as u8) << index);
    }
}
machine child_ready(path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], address: u64, zero: bool) -> |mapping_routes|::Outcome {
    let next: u8 [1..=3] = index + 1;
    transition zero {
        true -> cleared(edits, next, address)
        _ -> capture(path, edits, next, address)
    }
    state cleared(edits: &mut |mapping_routes|::Edits, next: u8 [1..=3], address: u64) -> |mapping_routes|::Outcome {
        edits.table_ids[next] = address;
        edits.words[next] = 0;
        edits.zero_mask = edits.zero_mask | ((1 as u8) << next);
        |mapping_routes|::Outcome::Continue
    }
    state capture(path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, next: u8 [1..=3], address: u64) -> |mapping_routes|::Outcome {
        let supplied: u64 = path.table_ids[next];
        transition supplied == address {
            true -> (|mapping_routes|::Outcome::Continue)
            _ -> (|mapping_routes|::Outcome::CaptureMismatch { expected: address, supplied: supplied })
        }
    }
}
machine finish(edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, index: u8 [0..=3]) -> |mapping_routes|::Outcome {
    edits.visited = index + 1;
    let word: u64 = edits.words[index];
    let leaf: |mapping_plans|::LeafPlan = leaf_decision(word, size, request);
    record_word(edits, index, leaf.word, leaf.write);
    |mapping_routes|::Outcome::Leaf { leaf: leaf }
}
machine leaf_decision(word: u64, size: u64, request: |mapping_routes|::Request) -> |mapping_plans|::LeafPlan {
    transition request {
        |mapping_routes|::Request::Map { frame, flags, parent_flags } -> mapping(word, size, frame, flags)
        |mapping_routes|::Request::Unmap -> unmapping(word, size)
        |mapping_routes|::Request::Update { new_flags } -> updating(word, size, new_flags)
        |mapping_routes|::Request::SetParent { level, table_flags } -> updating(word, 4096, table_flags)
        _ -> translating(word, size)
    }
    state mapping(word: u64, size: u64, frame: u64, flags: u64) -> |mapping_plans|::LeafPlan { let result: |mapping_plans|::LeafPlan = |mapping_plans|::map_leaf(word, frame, size, flags); result }
    state unmapping(word: u64, size: u64) -> |mapping_plans|::LeafPlan { let result: |mapping_plans|::LeafPlan = |mapping_plans|::unmap_leaf(word, size); result }
    state updating(word: u64, size: u64, flags: u64) -> |mapping_plans|::LeafPlan { let result: |mapping_plans|::LeafPlan = |mapping_plans|::update_leaf_flags(word, size, flags); result }
    state translating(word: u64, size: u64) -> |mapping_plans|::LeafPlan { let result: |mapping_plans|::LeafPlan = |mapping_plans|::translate_leaf(word, size); result }
}

// Pinned recursive child creation differs from ordinary mapped child creation:
// new links force PRESENT|WRITABLE; existing links need not be PRESENT.
pub machine prepare_child(word: u64, insert_flags: u64, supply: |mapping_plans|::FrameSupply) -> |mapping_plans|::ChildPlan {
    transition word == 0 { true -> allocate(insert_flags, supply) _ -> existing(word, insert_flags) }
    state allocate(flags: u64, supply: |mapping_plans|::FrameSupply) -> |mapping_plans|::ChildPlan {
        transition supply {
            |mapping_plans|::FrameSupply::Unavailable -> (|mapping_plans|::ChildPlan::AllocationFailed { word: 0, write: false })
            |mapping_plans|::FrameSupply::Supplied { address } -> frame(address, flags)
        }
    }
    state frame(address: u64, flags: u64) -> |mapping_plans|::ChildPlan {
        transition address <= |page_entries|::ADDRESS_MASK && (address & 4095) == 0 {
            true -> input_flags(address, flags)
            _ -> (|mapping_plans|::ChildPlan::InvalidSuppliedFrame { word: 0, write: false })
        }
    }
    state input_flags(address: u64, flags: u64) -> |mapping_plans|::ChildPlan {
        let huge: bool = (flags & 128) != 0;
        transition huge {
            true -> (|mapping_plans|::ChildPlan::InvalidHugeInput { word: 0, write: false })
            _ -> classify(address | flags | 3, true, true)
        }
    }
    state existing(word: u64, flags: u64) -> |mapping_plans|::ChildPlan {
        let old_flags: u64 = |page_entries|::flags(word);
        let write: bool = flags != 0 && (old_flags & flags) != flags;
        transition write { true -> classify(word | flags, true, false) _ -> classify(word, false, false) }
    }
    state classify(word: u64, write: bool, created: bool) -> |mapping_plans|::ChildPlan {
        let huge: bool = (word & 128) != 0;
        let address: u64 = |page_entries|::address(word);
        transition huge {
            true -> (|mapping_plans|::ChildPlan::HugeParent { word: word, write: write })
            _ -> (|mapping_plans|::ChildPlan::Ready { word: word, write: write, address: address, zero_child: created })
        }
    }
}
