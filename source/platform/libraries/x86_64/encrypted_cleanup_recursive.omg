// SPDX-License-Identifier: MIT OR Apache-2.0
// Profile numeric RecursivePageTable cleanup orchestration, x86_64
// cc35c876d3badb57df54a66e22f7768a52be95f2. See recursive-cleanup.PORT.md.
// Excluded-slot geometry delegates to recursive_cleanup with original captures.
// See encrypted-cleanup.PORT.md; no live access or frame reclamation.
use addresses.omg;
use cleanup_ranges.omg;
use cleanup_branch.omg;

use memory_encryption.omg;
use recursive_cleanup.omg;
use encrypted_cleanup_ranges.omg;
pub machine begin(first: u64, last: u64, budget: u64, recursive_index: u16) -> |recursive_cleanup|::RecursiveCursor {
    |recursive_cleanup|::begin(first, last, budget, recursive_index)
}
pub machine resume(cursor: |recursive_cleanup|::RecursiveCursor, budget: u64) -> |recursive_cleanup|::RecursiveCursor { |recursive_cleanup|::resume(cursor, budget) }
pub machine step(profile: |memory_encryption|::State, cursor: |recursive_cleanup|::RecursiveCursor, words: &[u64; 4], table_ids: &[u64; 4], other_nonzero: &[bool; 4]) -> |recursive_cleanup|::RecursiveStep {
    transition cursor.recursive_index < 512 {
        true -> status(profile, cursor, words, table_ids, other_nonzero)
        _ -> (|recursive_cleanup|::RecursiveStep {})
    }
    state status(profile: |memory_encryption|::State, cursor: |recursive_cleanup|::RecursiveCursor, words: &[u64; 4], table_ids: &[u64; 4], other_nonzero: &[bool; 4]) {
        transition cursor.range.status {
            |cleanup_ranges|::RangeStatus::Active -> checked(profile, cursor, words, table_ids, other_nonzero)
            _ -> (|recursive_cleanup|::RecursiveStep { cursor: cursor })
        }
    }
    state checked(profile: |memory_encryption|::State, cursor: |recursive_cleanup|::RecursiveCursor, words: &[u64; 4], table_ids: &[u64; 4], other_nonzero: &[bool; 4]) {
        let checked: |cleanup_ranges|::Cursor = |cleanup_ranges|::begin(cursor.range.next_page, cursor.range.last_page, cursor.range.budget);
        let next: |recursive_cleanup|::RecursiveCursor = |recursive_cleanup|::RecursiveCursor { range: checked, recursive_index: cursor.recursive_index };
        transition checked.status {
            |cleanup_ranges|::RangeStatus::Active -> selected(profile, next, words, table_ids, other_nonzero)
            _ -> (|recursive_cleanup|::RecursiveStep { cursor: next })
        }
    }
    state selected(profile: |memory_encryption|::State, cursor: |recursive_cleanup|::RecursiveCursor, words: &[u64; 4], table_ids: &[u64; 4], other_nonzero: &[bool; 4]) {
        let index: u16 = ((cursor.range.next_page >> 39) & 511) as u16;
        transition index == cursor.recursive_index {
            true -> excluded(cursor, words, table_ids, other_nonzero)
            _ -> ordinary(profile, cursor, words, table_ids, other_nonzero)
        }
    }
    state excluded(cursor: |recursive_cleanup|::RecursiveCursor, words: &[u64; 4], table_ids: &[u64; 4], other_nonzero: &[bool; 4]) {
        let result: |recursive_cleanup|::RecursiveStep = |recursive_cleanup|::step(cursor, words, table_ids, other_nonzero);
        result
    }
    state ordinary(profile: |memory_encryption|::State, cursor: |recursive_cleanup|::RecursiveCursor, words: &[u64; 4], table_ids: &[u64; 4], other_nonzero: &[bool; 4]) {
        let result: |cleanup_ranges|::RangeStep = |encrypted_cleanup_ranges|::step(profile, cursor.range, words, table_ids, other_nonzero);
        |recursive_cleanup|::RecursiveStep { cursor: |recursive_cleanup|::RecursiveCursor { range: result.cursor, recursive_index: cursor.recursive_index },
            has_plan: result.has_plan, branch: result.branch }
    }
}
