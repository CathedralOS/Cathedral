// Modified pure orchestration of pinned x86_64 MappedPageTable Mapper methods.
// Captures, allocations and edits are numeric proposals, never live custody.
use memory_encryption.omg;
use encrypted_mapping_plans.omg;
use pages.omg;
use page_entries.omg;
use mapping_plans.omg;

use mapping_routes.omg;

pub machine plan(profile: |memory_encryption|::State, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, page: u64, size: u64, request: |mapping_routes|::Request) -> |mapping_routes|::RoutePlan {
    let address_mask: u64 = profile.address_mask;
    let physical_mask: u64 = profile.bit_mask;
    let valid_page: bool = |pages|::start_valid(page, size, false);
    let valid_request: bool = request_valid(address_mask, physical_mask, request, size);
    transition valid_page && valid_request {
        true -> begin(address_mask, physical_mask, path, allocations, page, size, request)
        _ -> (|mapping_routes|::RoutePlan {})
    }
    state begin(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, page: u64, size: u64, request: |mapping_routes|::Request) -> |mapping_routes|::RoutePlan {
        let edits: |mapping_routes|::Edits = |mapping_routes|::Edits { table_ids: path.table_ids, words: path.words,
            indices: [((page >> 39) & 511) as u16, ((page >> 30) & 511) as u16,
                ((page >> 21) & 511) as u16, ((page >> 12) & 511) as u16] };
        let target: u8 = target_index(size, request);
        let outcome: |mapping_routes|::Outcome = route(address_mask, physical_mask, path, allocations, &mut edits, size, request, target);
        |mapping_routes|::RoutePlan { edits: edits, outcome: outcome }
    }
}
machine request_valid(address_mask: u64, physical_mask: u64, request: |mapping_routes|::Request, size: u64) -> bool {
    transition request {
        |mapping_routes|::Request::Map { frame, flags, parent_flags } -> frame_valid(address_mask, physical_mask, frame, size)
        |mapping_routes|::Request::SetParent { level, table_flags } -> (level >= 2 && level <= 4)
        _ -> (true)
    }
    state frame_valid(address_mask: u64, physical_mask: u64, frame: u64, size: u64) -> bool {
        let profile: |memory_encryption|::State = |memory_encryption|::State { address_mask: address_mask, bit_mask: physical_mask };
        let valid: bool = |encrypted_mapping_plans|::frame_valid(profile, frame, size);
        valid
    }
}
machine target_index(size: u64, request: |mapping_routes|::Request) -> u8 {
    transition request {
        |mapping_routes|::Request::SetParent { level, table_flags } -> parent(level)
        _ -> leaf(size)
    }
    state leaf(size: u64) -> u8 {
        transition size { 1073741824 -> (1) 2097152 -> (2) _ -> (3) }
    }
    state parent(level: u8) -> u8 {
        transition level <= 4 { true -> (4 - level) _ -> (4) }
    }
}
machine route(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
    let leaf: u8 = target_index(size, |mapping_routes|::Request::Translate);
    transition {
        target > leaf -> (|mapping_routes|::Outcome::ParentHugePage)
        target == leaf && is_parent_request(request) -> (|mapping_routes|::Outcome::ParentHugePage)
        target == 0 -> complete(address_mask, physical_mask, edits, size, request, 0)
        _ -> first(address_mask, physical_mask, path, allocations, edits, size, request, target)
    }
    state first(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = parent_step(address_mask, physical_mask, path, allocations, edits, request, 0);
        transition result {
            |mapping_routes|::Outcome::Continue -> second(address_mask, physical_mask, path, allocations, edits, size, request, target)
            _ -> (result)
        }
    }
    state second(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        transition target == 1 { true -> complete(address_mask, physical_mask, edits, size, request, 1) _ -> descend_second(address_mask, physical_mask, path, allocations, edits, size, request, target) }
    }
    state descend_second(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = parent_step(address_mask, physical_mask, path, allocations, edits, request, 1);
        transition result { |mapping_routes|::Outcome::Continue -> third(address_mask, physical_mask, path, allocations, edits, size, request, target) _ -> (result) }
    }
    state third(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, target: u8) -> |mapping_routes|::Outcome {
        transition target == 2 { true -> complete(address_mask, physical_mask, edits, size, request, 2) _ -> descend_third(address_mask, physical_mask, path, allocations, edits, size, request) }
    }
    state descend_third(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = parent_step(address_mask, physical_mask, path, allocations, edits, request, 2);
        transition result { |mapping_routes|::Outcome::Continue -> complete(address_mask, physical_mask, edits, size, request, 3) _ -> (result) }
    }
    state complete(address_mask: u64, physical_mask: u64, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, index: u8 [0..=3]) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = finish(address_mask, physical_mask, edits, size, request, index);
        result
    }
}
machine is_parent_request(request: |mapping_routes|::Request) -> bool {
    transition request { |mapping_routes|::Request::SetParent { level, table_flags } -> (true) _ -> (false) }
}
machine parent_step(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, request: |mapping_routes|::Request, index: u8 [0..=2]) -> |mapping_routes|::Outcome {
    edits.visited = index + 1;
    let word: u64 = edits.words[index];
    transition request {
        |mapping_routes|::Request::Map { frame, flags, parent_flags } -> mapping(address_mask, physical_mask, path, allocations, edits, index, word, parent_flags)
        _ -> existing(address_mask, physical_mask, path, edits, index, word)
    }
    state mapping(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], word: u64, flags: u64) -> |mapping_routes|::Outcome {
        let supplied: |mapping_plans|::FrameSupply = allocation(allocations, edits, word);
        let profile: |memory_encryption|::State = |memory_encryption|::State { address_mask: address_mask, bit_mask: physical_mask };
        let child: |mapping_plans|::ChildPlan = |encrypted_mapping_plans|::prepare_child(profile, false, word, flags, supplied);
        record_word(edits, index, child.word, child.write);
        transition child {
            |mapping_plans|::ChildPlan::Ready { address, zero_child } -> ready_child(address_mask, physical_mask, path, edits, index, address, zero_child)
            _ -> (|mapping_routes|::Outcome::ChildFailure { child: child })
        }
    }
    state existing(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], word: u64) -> |mapping_routes|::Outcome {
        let address: u64 = word & address_mask;
        let present: bool = (word & 1) != 0;
        let huge: bool = (word & 128) != 0;
        transition {
            !present -> (|mapping_routes|::Outcome::ParentNotMapped)
            huge -> (|mapping_routes|::Outcome::ParentHugePage)
            _ -> ready_child(address_mask, physical_mask, path, edits, index, address, false)
        }
    }
    state ready_child(address_mask: u64, physical_mask: u64, path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], address: u64, zero: bool) -> |mapping_routes|::Outcome {
        let result: |mapping_routes|::Outcome = child_ready(path, edits, index, address, zero);
        result
    }
}
machine allocation(allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, word: u64) -> |mapping_plans|::FrameSupply {
    let count: u8 = edits.allocation_calls;
    transition word == 0 && count < 3 {
        true -> consume(allocations, edits, count)
        _ -> (|mapping_plans|::FrameSupply::Unavailable)
    }
    state consume(allocations: &|mapping_routes|::AllocationInputs, edits: &mut |mapping_routes|::Edits, count: u8 [0..=2]) -> |mapping_plans|::FrameSupply {
        let supplied: |mapping_plans|::FrameSupply = allocations.frames[count];
        edits.allocation_calls = count + 1;
        supplied
    }
}
machine record_word(edits: &mut |mapping_routes|::Edits, index: u8 [0..=3], word: u64, write: bool) {
    edits.words[index] = word;
    transition write { true -> record(edits, index) _ -> {} }
    state record(edits: &mut |mapping_routes|::Edits, index: u8 [0..=3]) {
        edits.write_mask = edits.write_mask | ((1 as u8) << index);
    }
}
machine child_ready(path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, index: u8 [0..=2], address: u64, zero: bool) -> |mapping_routes|::Outcome {
    let next: u8 [1..=3] = index + 1;
    transition zero {
        true -> cleared(edits, next, address)
        _ -> capture(path, edits, next, address)
    }
    state cleared(edits: &mut |mapping_routes|::Edits, next: u8 [1..=3], address: u64) -> |mapping_routes|::Outcome {
        edits.table_ids[next] = address;
        edits.words[next] = 0;
        edits.zero_mask = edits.zero_mask | ((1 as u8) << next);
        |mapping_routes|::Outcome::Continue
    }
    state capture(path: &|mapping_routes|::CapturedPath, edits: &mut |mapping_routes|::Edits, next: u8 [1..=3], address: u64) -> |mapping_routes|::Outcome {
        let supplied: u64 = path.table_ids[next];
        transition supplied == address {
            true -> (|mapping_routes|::Outcome::Continue)
            _ -> (|mapping_routes|::Outcome::CaptureMismatch { expected: address, supplied: supplied })
        }
    }
}
machine finish(address_mask: u64, physical_mask: u64, edits: &mut |mapping_routes|::Edits, size: u64, request: |mapping_routes|::Request, index: u8 [0..=3]) -> |mapping_routes|::Outcome {
    edits.visited = index + 1;
    let word: u64 = edits.words[index];
    let leaf: |mapping_plans|::LeafPlan = leaf_decision(address_mask, physical_mask, word, size, request);
    record_word(edits, index, leaf.word, leaf.write);
    |mapping_routes|::Outcome::Leaf { leaf: leaf }
}
machine leaf_decision(address_mask: u64, physical_mask: u64, word: u64, size: u64, request: |mapping_routes|::Request) -> |mapping_plans|::LeafPlan {
    transition request {
        |mapping_routes|::Request::Map { frame, flags, parent_flags } -> mapping(address_mask, physical_mask, word, size, frame, flags)
        |mapping_routes|::Request::Unmap -> unmapping(address_mask, physical_mask, word, size)
        |mapping_routes|::Request::Update { new_flags } -> updating(address_mask, physical_mask, word, size, new_flags)
        |mapping_routes|::Request::SetParent { level, table_flags } -> updating(address_mask, physical_mask, word, 4096, table_flags)
        _ -> translating(address_mask, physical_mask, word, size)
    }
    state mapping(address_mask: u64, physical_mask: u64, word: u64, size: u64, frame: u64, flags: u64) -> |mapping_plans|::LeafPlan { let profile: |memory_encryption|::State = |memory_encryption|::State { address_mask: address_mask, bit_mask: physical_mask };  let result: |mapping_plans|::LeafPlan = |encrypted_mapping_plans|::map_leaf(profile, word, frame, size, flags); result }
    state unmapping(address_mask: u64, physical_mask: u64, word: u64, size: u64) -> |mapping_plans|::LeafPlan { let profile: |memory_encryption|::State = |memory_encryption|::State { address_mask: address_mask, bit_mask: physical_mask };  let result: |mapping_plans|::LeafPlan = |encrypted_mapping_plans|::unmap_leaf(profile, word, size); result }
    state updating(address_mask: u64, physical_mask: u64, word: u64, size: u64, flags: u64) -> |mapping_plans|::LeafPlan { let profile: |memory_encryption|::State = |memory_encryption|::State { address_mask: address_mask, bit_mask: physical_mask };  let result: |mapping_plans|::LeafPlan = |encrypted_mapping_plans|::update_leaf_flags(profile, word, size, flags); result }
    state translating(address_mask: u64, physical_mask: u64, word: u64, size: u64) -> |mapping_plans|::LeafPlan { let profile: |memory_encryption|::State = |memory_encryption|::State { address_mask: address_mask, bit_mask: physical_mask };  let result: |mapping_plans|::LeafPlan = |encrypted_mapping_plans|::translate_leaf(profile, word, size); result }
}
