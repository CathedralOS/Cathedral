// Explicit-profile Translate::translate_addr default arithmetic from x86_64
// cc35c876d3badb57df54a66e22f7768a52be95f2. No live mapping or access authority.
use memory_encryption.omg;
use translation.omg;
use addresses.omg;
use pages.omg;

// The pinned default accepts any offset, even >=size; validate the typed frame
// shape then use the existing masked physical addition. A bit inside a huge
// frame's offset may therefore reject even when its frame base was valid.
pub machine translated_address_pinned(profile: &|memory_encryption|::State, observation: |translation|::Translation) -> |addresses|::NumberResult {
    transition observation {
        |translation|::Translation::Mapped { frame, size, offset, flags } -> shape(profile, frame, size, offset)
        _ -> (|addresses|::NumberResult::Rejected)
    }
    state shape(profile: &|memory_encryption|::State, frame: u64, size: u64, offset: u64) -> |addresses|::NumberResult {
        let valid: bool = |pages|::start_valid(frame, size, true);
        transition valid {
            true -> add(profile, frame, offset)
            _ -> (|addresses|::NumberResult::Rejected)
        }
    }
    state add(profile: &|memory_encryption|::State, frame: u64, offset: u64) -> |addresses|::NumberResult {
        let mask: u64 = profile.bit_mask & |addresses|::PHYSICAL_MAX;
        let result: |addresses|::NumberResult = |addresses|::physical_add(frame, offset, mask);
        result
    }
}
