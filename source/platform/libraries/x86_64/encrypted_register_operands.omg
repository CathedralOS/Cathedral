// Explicit encryption-profile composition of pinned CR3/APIC pure expressions.
// No live register access. See encrypted-registers.PORT.md.
use memory_encryption.omg;
use addresses.omg;
use register_operands.omg;
use {facts}/x86_registers.omg;
use {facts}/x86_tlb_operands.omg;

pub data ObservedCr3 {
    case Rejected;
    case Value(observation: |register_operands|::Cr3Observation);
}
// The pin uses strict PhysAddr::new here: a configured bit in the masked
// observed frame is rejected, rather than silently removed.
pub machine cr3_observed(profile: &|memory_encryption|::State, raw: u64) -> ObservedCr3 {
    let observation: |register_operands|::Cr3Observation = |register_operands|::cr3_observed(raw);
    let checked: |addresses|::NumberResult = |memory_encryption|::physical_check(profile, observation.frame);
    transition checked {
        |addresses|::NumberResult::Value { value } -> (ObservedCr3::Value { observation: observation })
        _ -> (ObservedCr3::Rejected)
    }
}
pub machine cr3_raw_operand(profile: &|memory_encryption|::State, frame: u64, low: u16, no_flush: bool) -> |addresses|::NumberResult {
    let checked: |addresses|::NumberResult = |memory_encryption|::physical_check(profile, frame);
    transition checked {
        |addresses|::NumberResult::Value { value } -> compose(frame, low, no_flush)
        _ -> (|addresses|::NumberResult::Rejected)
    }
    state compose(frame: u64, low: u16, no_flush: bool) -> |addresses|::NumberResult {
        let result: |addresses|::NumberResult = |register_operands|::cr3_raw_operand(frame, low, no_flush);
        result
    }
}
pub machine cr3_flags_operand(profile: &|memory_encryption|::State, frame: u64, flags: |x86_registers|::Cr3Flags) -> |addresses|::NumberResult {
    cr3_raw_operand(profile, frame, (flags.raw & 65535) as u16, false)
}
pub machine cr3_pcid_operand(profile: &|memory_encryption|::State, frame: u64, pcid: |x86_tlb_operands|::Pcid, no_flush: bool) -> |addresses|::NumberResult {
    cr3_raw_operand(profile, frame, pcid.value, no_flush)
}
// APIC uses PhysAddr::new_truncate, unlike CR3. Only the latest encryption bit
// is removed; historical PTE mask bits do not belong to this physical operation.
pub machine apic_observed(profile: &|memory_encryption|::State, raw: u64) -> |register_operands|::ApicObservation {
    let observation: |register_operands|::ApicObservation = |register_operands|::apic_observed(raw);
    observation.frame = observation.frame & ~profile.bit_mask;
    observation
}
pub machine apic_raw_operand(profile: &|memory_encryption|::State, frame: u64, flags: u64) -> |addresses|::NumberResult {
    let checked: |addresses|::NumberResult = |memory_encryption|::physical_check(profile, frame);
    transition checked {
        |addresses|::NumberResult::Value { value } -> compose(frame, flags)
        _ -> (|addresses|::NumberResult::Rejected)
    }
    state compose(frame: u64, flags: u64) -> |addresses|::NumberResult {
        let result: |addresses|::NumberResult = |register_operands|::apic_raw_operand(frame, flags);
        result
    }
}
pub machine apic_preserving_operand(profile: &|memory_encryption|::State, old: u64, frame: u64, flags: |x86_registers|::ApicBaseFlags) -> |addresses|::NumberResult {
    let checked: |addresses|::NumberResult = |memory_encryption|::physical_check(profile, frame);
    transition checked {
        |addresses|::NumberResult::Value { value } -> compose(old, frame, flags)
        _ -> (|addresses|::NumberResult::Rejected)
    }
    state compose(old: u64, frame: u64, flags: |x86_registers|::ApicBaseFlags) -> |addresses|::NumberResult {
        let result: |addresses|::NumberResult = |register_operands|::apic_preserving_operand(old, frame, flags);
        result
    }
}
