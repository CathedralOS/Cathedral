pub machine features_equal(a: Features, b: Features) -> bool { a.low == b.low && a.high == b.high }
pub machine features_empty(value: Features) -> bool { value.low == 0 && value.high == 0 }
pub machine features_all(value: Features) -> bool {
    let all: u64 = 0xffffffffffffffff;
    value.low == all && value.high == all
}
pub machine features_contains(value: Features, mask: Features) -> bool { (value.low & mask.low) == mask.low && (value.high & mask.high) == mask.high }
pub machine features_intersects(value: Features, mask: Features) -> bool { (value.low & mask.low) != 0 || (value.high & mask.high) != 0 }
pub machine features_intersection(a: Features, b: Features) -> Features { Features { low: a.low & b.low, high: a.high & b.high } }
pub machine features_union(a: Features, b: Features) -> Features { Features { low: a.low | b.low, high: a.high | b.high } }
pub machine features_difference(a: Features, b: Features) -> Features {
    Features { low: a.low & (b.low ^ 0xffffffffffffffff), high: a.high & (b.high ^ 0xffffffffffffffff) }
}
pub machine features_toggle(a: Features, b: Features) -> Features { Features { low: a.low ^ b.low, high: a.high ^ b.high } }
pub machine features_complement(value: Features) -> Features { Features { low: value.low ^ 0xffffffffffffffff, high: value.high ^ 0xffffffffffffffff } }
pub machine features_set(value: Features, mask: Features, enabled: bool) -> Features {
    transition enabled { true -> insert(value, mask) _ -> remove(value, mask) }
    state insert(value: Features, mask: Features) -> Features { let out: Features = features_union(value, mask); out }
    state remove(value: Features, mask: Features) -> Features { let out: Features = features_difference(value, mask); out }
}
pub machine feature_has(value: Features, index: u8) -> bool {
    transition index < 64 {
      true -> ((value.low & ((1 as u64) << (index as u64))) != 0)
      _ -> high(value, index)
    }
    state high(value: Features, index: u8) -> bool {
      transition index < 128 { true -> ((value.high & ((1 as u64) << ((index as u64) - 64))) != 0) _ -> (false) }
    }
}
pub data FeatureWord [copy] { ok: bool; value: u32; }
pub machine feature_word(value: Features, selector: u32) -> FeatureWord {
    transition selector {
      0 -> (FeatureWord { ok: true, value: (value.low & 0xffffffff) as u32 })
      1 -> (FeatureWord { ok: true, value: ((value.low >> 32) & 0xffffffff) as u32 })
      2 -> (FeatureWord { ok: true, value: (value.high & 0xffffffff) as u32 })
      3 -> (FeatureWord { ok: true, value: ((value.high >> 32) & 0xffffffff) as u32 })
      _ -> (FeatureWord {})
    }
}
pub machine feature_from_words(a: u32, b: u32, c: u32, d: u32) -> Features {
    Features { low: (a as u64) | ((b as u64) << 32), high: (c as u64) | ((d as u64) << 32) }
}

// Exact pinned dependency matrix, including its all-of tunnel prerequisites.
pub machine net_requirements_satisfied(value: Features) -> bool {
    (!((value.low & 128) != 0) || (((value.low & 2) != 0))) &&
    (!((value.low & 256) != 0) || (((value.low & 2) != 0))) &&
    (!((value.low & 512) != 0) || (((value.low & 128) != 0) || ((value.low & 256) != 0))) &&
    (!((value.low & 1024) != 0) || (((value.low & 2) != 0))) &&
    (!((value.low & 18014398509481984) != 0) || (((value.low & 2) != 0))) &&
    (!((value.low & 36028797018963968) != 0) || (((value.low & 2) != 0))) &&
    (!((value.high & 2) != 0) || (((value.low & 128) != 0) && ((value.low & 256) != 0) && ((value.low & 18014398509481984) != 0) && ((value.low & 36028797018963968) != 0))) &&
    (!((value.high & 4) != 0) || (((value.high & 2) != 0))) &&
    (!((value.low & 2048) != 0) || (((value.low & 1) != 0))) &&
    (!((value.low & 4096) != 0) || (((value.low & 1) != 0))) &&
    (!((value.low & 8192) != 0) || (((value.low & 2048) != 0) || ((value.low & 4096) != 0))) &&
    (!((value.low & 16384) != 0) || (((value.low & 1) != 0))) &&
    (!((value.low & 72057594037927936) != 0) || (((value.low & 1) != 0))) &&
    (!((value.high & 8) != 0) || (((value.low & 2048) != 0) && ((value.low & 4096) != 0) && ((value.low & 72057594037927936) != 0))) &&
    (!((value.high & 16) != 0) || (((value.high & 8) != 0))) &&
    (!((value.low & 262144) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.low & 524288) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.low & 2097152) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.low & 4194304) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.low & 8388608) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.low & 9007199254740992) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.low & 2305843009213693952) != 0) || (((value.low & 2048) != 0) || ((value.low & 4096) != 0))) &&
    (!((value.low & 1152921504606846976) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.low & 4503599627370496) != 0) || (((value.low & 131072) != 0))) &&
    (!((value.high & 1) != 0) || (((value.low & 131072) != 0) && ((value.low & 1152921504606846976) != 0))) &&
    (!((value.low & 2251799813685248) != 0) || (((value.low & 131072) != 0) && (((value.low & 1152921504606846976) != 0) || ((value.low & 144115188075855872) != 0))))
}
pub machine net_recommendations_satisfied(value: Features) -> bool {
    (!((value.low & 144115188075855872) != 0) || ((value.low & 131072) != 0)) &&
    (!((value.low & 1048576) != 0) || ((value.low & 131072) != 0))
}

pub data NegotiatedFeatures [copy] { ok: bool; value: Features; }
pub machine negotiate_features(offered: Features, supported: Features, required: Features, network: bool, modern: bool) -> NegotiatedFeatures {
    let accepted: Features = features_intersection(offered, supported);
    NegotiatedFeatures { ok: features_contains(accepted, required) &&
      (!network || net_requirements_satisfied(accepted)) && (!modern || feature_has(accepted, 32)), value: accepted }
}
