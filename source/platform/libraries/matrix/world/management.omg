module management;
// Owner-delegated management of one sibling slot. A query mints a local ticket
// for the exact task; revocation, regrant and task replacement invalidate it.
// The program authenticates the manager's connection; the slot is owner policy.
use protocol::main;

public data Delegation [copy] {
    live: bool;
    incarnation: u64;
    target: u64 [0..=3];
    // The last task this manager observed, with the ticket minted for it.
    observed: bool;
    ticket: u64;
    task: u64;
}
public data Management {
    grants: [Delegation; 4];
    next: [u64; 4];
}
public data Target [copy] {
    case Slot(index: u64 [0..=3]);
    case Refused(code: u64);
}
// Requires a live manager and a different target, both below `slots`.
public machine grant(managers: &mut Management, manager: u64, incarnation: u64, target: u64, slots: u64) -> u64 {
    transition manager < slots && target < slots && manager < 4u64 && target < 4u64 && manager != target && incarnation != 0u64 {
        true -> granted(managers, manager, incarnation, target)
        _ -> (DENIED)
    }
    machine granted(managers: &mut Management, manager: u64, incarnation: u64, target: u64) -> u64 requires manager < 4u64 && target < 4u64 {
        let mut delegation: Delegation;
        delegation.live = true;
        delegation.incarnation = incarnation;
        delegation.target = target;
        managers.grants[manager] = delegation;
        0u64
    }
}
public machine revoke(managers: &mut Management, manager: u64) {
    transition manager < 4u64 {
        true -> revoked(managers, manager)
        _ -> done()
    }
    machine revoked(managers: &mut Management, manager: u64) requires manager < 4u64 {
        let empty: Delegation;
        managers.grants[manager] = empty;
    }
}
// A slot's occupant left: its own grant ends, its ticket counter restarts so a
// new connection cannot learn how many tasks its predecessor saw, and every
// manager watching that slot forgets what it observed.
public machine disconnected(managers: &mut Management, slot: u64) {
    revoke(managers, slot);
    transition slot < 4u64 {
        true -> reset(managers, slot)
        _ -> done()
    }
    machine reset(managers: &mut Management, slot: u64) requires slot < 4u64 {
        managers.next[slot] = 0u64;
        forget_target(managers, slot, 0u64);
    }
}
machine forget_target(managers: &mut Management, slot: u64, index: u64) requires slot < 4u64 && index <= 4u64 {
    transition index < 4u64 {
        true -> checked(managers, slot, index)
        _ -> done()
    }
    machine checked(managers: &mut Management, slot: u64, index: u64) requires slot < 4u64 && index < 4u64 {
        transition managers.grants[index].live && managers.grants[index].target == slot {
            true -> forgotten(managers, slot, index)
            _ -> forget_target(managers, slot, index + 1u64)
        }
    }
    machine forgotten(managers: &mut Management, slot: u64, index: u64) requires slot < 4u64 && index < 4u64 {
        managers.grants[index].observed = false;
        transition { _ -> forget_target(managers, slot, index + 1u64) }
    }
}
public machine target(managers: &Management, manager: u64, incarnation: u64) -> Target {
    transition manager < 4u64 {
        true -> checked(managers, manager, incarnation)
        _ -> (Target::Refused { code: DENIED })
    }
    machine checked(managers: &Management, manager: u64, incarnation: u64) -> Target requires manager < 4u64 {
        transition managers.grants[manager].live && managers.grants[manager].incarnation == incarnation {
            true -> (Target::Slot { index: managers.grants[manager].target })
            _ -> (Target::Refused { code: DENIED })
        }
    }
}
// [0, ticket] for the task now in the target slot: a new task gets a new
// ticket, the same task keeps its ticket, an empty slot clears it.
public machine query(managers: &mut Management, manager: u64, incarnation: u64, has_task: bool, task: u64) -> [u64; 8] {
    transition manager < 4u64 && managers.grants[manager].live && managers.grants[manager].incarnation == incarnation {
        true -> granted(managers, manager, has_task, task)
        _ -> (error(DENIED))
    }
    machine granted(managers: &mut Management, manager: u64, has_task: bool, task: u64) -> [u64; 8] requires manager < 4u64 {
        let serial: u64 = managers.next[manager];
        transition {
            !has_task -> cleared(managers, manager)
            managers.grants[manager].observed && managers.grants[manager].task == task -> (ticketed(managers.grants[manager].ticket))
            serial < 0xffffffffffffffffu64 -> minted(managers, manager, task, serial + 1u64)
            _ -> (error(NO_MEMORY))
        }
    }
    machine cleared(managers: &mut Management, manager: u64) -> [u64; 8] requires manager < 4u64 {
        managers.grants[manager].observed = false;
        ok()
    }
    machine minted(managers: &mut Management, manager: u64, task: u64, ticket: u64) -> [u64; 8] requires manager < 4u64 {
        managers.next[manager] = ticket;
        managers.grants[manager].observed = true;
        managers.grants[manager].ticket = ticket;
        managers.grants[manager].task = task;
        ticketed(ticket)
    }
}
// The target slot, only for the exact task the ticket was minted for.
public machine authorize(managers: &Management, manager: u64, incarnation: u64, ticket: u64, has_current: bool, current: u64) -> Target {
    transition manager < 4u64 && managers.grants[manager].live && managers.grants[manager].incarnation == incarnation
        && managers.grants[manager].observed && managers.grants[manager].ticket == ticket && has_current
        && managers.grants[manager].task == current {
        true -> (slot_of(managers, manager))
        _ -> (Target::Refused { code: DENIED })
    }
}
machine slot_of(managers: &Management, manager: u64) -> Target requires manager < 4u64 {
    Target::Slot { index: managers.grants[manager].target }
}
machine ticketed(ticket: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[1] = ticket;
    words
}
machine error(code: u64) -> [u64; 8] {
    let mut words: [u64; 8];
    words[0] = code;
    words
}
machine ok() -> [u64; 8] {
    let words: [u64; 8];
    words
}
machine done() {}
