module input::pointer;
// Per-stream hit testing, selection and drag capture. A press selects the
// stream's group onto the child under it and captures that child until release;
// coordinates delivered to a child are relative to its own placement.
use protocol::main;
use level::World;
use names::Name;
use children::Pushed;
use input::main::Admitted;

public machine route(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, select: bool) -> u64 {
    transition geometry::valid_grant(world.parent) && buttons <= 7u64 {
        true -> admitting(world, channel, x, y, buttons, select)
        _ -> (DENIED)
    }
    machine admitting(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, select: bool) -> u64 {
        let admitted: Admitted = input::main::admit(&mut world.input, channel);
        transition admitted {
            Admitted::Slot { index } -> stream(world, channel, x, y, buttons, select, index)
            Admitted::Failed { code } -> (code)
        }
    }
    // A stream blocked by an interrupted hold stays silent until its release.
    machine stream(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, select: bool, index: u64 [0..=3]) -> u64 {
        transition world.input.streams[index].blocked {
            true -> blocked(world, buttons, index)
            _ -> clamped(world, channel, geometry::within(x, world.parent.width),
                geometry::within(y, world.parent.height), buttons, select, index)
        }
    }
    machine blocked(world: &mut World, buttons: u64, index: u64 [0..=3]) -> u64 {
        transition buttons == 0u64 { true -> unblocked(world, index) _ -> (0u64) }
    }
    machine unblocked(world: &mut World, index: u64 [0..=3]) -> u64 {
        world.input.streams[index].blocked = false;
        0u64
    }
    machine clamped(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, select: bool, index: u64 [0..=3]) -> u64 {
        let hit: u64 = level::hit_pointer(world, x, y);
        let target: u64 = captured_or(world, index, hit);
        transition target != 0u64 && target <= 4u64 {
            true -> preflight(world, channel, x, y, buttons, select, index, hit, target - 1u64)
            _ -> pressed(world, channel, x, y, buttons, select, index, hit, 0u64)
        }
    }
    machine captured_or(world: &World, index: u64 [0..=3], hit: u64) -> u64 {
        transition world.input.streams[index].buttons != 0u64 {
            true -> (world.input.streams[index].capture)
            _ -> (hit)
        }
    }
    machine preflight(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, select: bool, index: u64 [0..=3], hit: u64, slot: u64) -> u64 requires slot < 4u64 {
        let group: u64 [0..=3] = world.input.streams[index].group;
        let code: u64 = children::can_push(&world.children[slot], index, group, world.input.groups[group].id);
        transition code == 0u64 {
            true -> pressed(world, channel, x, y, buttons, select, index, hit, slot + 1u64)
            _ -> (code)
        }
    }
    // A fresh press selects and captures; the hit may be nothing at all.
    machine pressed(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, select: bool, index: u64 [0..=3], hit: u64, target: u64) -> u64 {
        transition world.input.streams[index].buttons == 0u64 && buttons != 0u64 {
            true -> selecting(world, channel, x, y, buttons, select, index, hit, target)
            _ -> moved(world, channel, x, y, buttons, index, target)
        }
    }
    machine selecting(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, select: bool, index: u64 [0..=3], hit: u64, target: u64) -> u64 {
        transition select {
            true -> selected(world, channel, x, y, buttons, index, hit, target)
            _ -> captured(world, channel, x, y, buttons, index, hit, target)
        }
    }
    machine selected(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, index: u64 [0..=3], hit: u64, target: u64) -> u64 {
        let group: u64 [0..=3] = world.input.streams[index].group;
        level::select_group(world, group, hit);
        transition { _ -> captured(world, channel, x, y, buttons, index, hit, target) }
    }
    machine captured(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, index: u64 [0..=3], hit: u64, target: u64) -> u64 {
        world.input.streams[index].capture = hit;
        transition { _ -> moved(world, channel, x, y, buttons, index, target) }
    }
    machine moved(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, index: u64 [0..=3], target: u64) -> u64 {
        world.input.streams[index].buttons = buttons;
        transition target != 0u64 && target <= 4u64 {
            true -> delivering(world, channel, x, y, buttons, index, target - 1u64)
            _ -> released(world, buttons, index)
        }
    }
    machine delivering(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, index: u64 [0..=3], slot: u64) -> u64 requires slot < 4u64 {
        transition geometry::valid_grant(world.children[slot].grant) {
            true -> translated(world, channel, x, y, buttons, index, slot)
            _ -> released(world, buttons, index)
        }
    }
    machine translated(world: &mut World, channel: Name, x: u64, y: u64, buttons: u64, index: u64 [0..=3], slot: u64) -> u64 requires slot < 4u64 {
        let local_x: u64 = geometry::within(past(x, world.children[slot].rect.x), world.children[slot].grant.width);
        let local_y: u64 = geometry::within(past(y, world.children[slot].rect.y), world.children[slot].grant.height);
        let group: u64 [0..=3] = world.input.streams[index].group;
        let group_name: Name = world.input.groups[group].id;
        let pushed: Pushed = children::push(&mut world.children[slot], index, channel, group, group_name, POINTER, local_x, local_y, buttons);
        transition pushed {
            Pushed::Delivered -> released(world, buttons, index)
            // This source may hold keys in another child; interrupt every recipient.
            Pushed::Dropped -> cancelled(world, index)
            Pushed::Refused { code } -> (code)
        }
    }
    machine cancelled(world: &mut World, index: u64 [0..=3]) -> u64 {
        level::cancel_stream(world, index);
        0u64
    }
    machine released(world: &mut World, buttons: u64, index: u64 [0..=3]) -> u64 {
        transition buttons == 0u64 { true -> uncaptured(world, index) _ -> (0u64) }
    }
    machine uncaptured(world: &mut World, index: u64 [0..=3]) -> u64 {
        world.input.streams[index].capture = 0u64;
        0u64
    }
}
machine past(value: u64, origin: u64) -> u64 {
    transition value > origin { true -> (value - origin) _ -> (0u64) }
}
