module events;
// Bounded FIFO for one supplied input stream inside one child. Sixteen ordinary
// events plus one reserved boundary slot. Overflow collapses this stream to a
// CANCEL boundary and cannot disturb another stream. Entries keep their global
// order number so a child can drain several streams in arrival order per group.
// Each event packs into one word beside its order: kind in three bits, then
// thirteen bits each of x and y (extents stay below 4096), then the value. A
// described channel announces its description once, before its first event,
// apart from queue pressure.
use protocol::main;
use names::Name;
use description::Description;

public const CAPACITY: u64 = 17u64;
public data Queue {
    // Child-local channel name; zero until the first delivery binds this stream.
    channel: u64;
    // The supplying stream, as the world names it.
    source: Name;
    // Child-local group name.
    group: u64;
    described: Description;
    describe_pending: bool;
    entries: [u64; 17];
    orders: [u64; 17];
    len: u64 [0..=17];
}
public machine pack(kind: u64, x: u64, y: u64, value: u64) -> u64 {
    (kind & 7u64) | (((x & 0x1fffu64) as u64 in Wrapping) << 3u64) as u64
        | (((y & 0x1fffu64) as u64 in Wrapping) << 16u64) as u64
        | (((value & 0xffffu64) as u64 in Wrapping) << 29u64) as u64
}
public machine kind_of(entry: u64) -> u64 { entry & 7u64 }
public machine x_of(entry: u64) -> u64 { (entry >> 3u64) & 0x1fffu64 }
public machine y_of(entry: u64) -> u64 { (entry >> 16u64) & 0x1fffu64 }
public machine value_of(entry: u64) -> u64 { (entry >> 29u64) & 0xffffu64 }

public machine pending(queue: &Queue) -> bool { queue.len != 0u64 }
// Order numbers start at one, so zero means no entry.
public machine first_order(queue: &Queue) -> u64 {
    transition queue.len != 0u64 { true -> (queue.orders[0]) _ -> (0u64) }
}
public machine last_order(queue: &Queue) -> u64 {
    transition queue.len != 0u64 { true -> (queue.orders[queue.len - 1u64]) _ -> (0u64) }
}
public machine retiring(queue: &Queue) -> bool { queue.len == 1u64 && kind_of(queue.entries[0]) == RETIRED }

// True when the event was queued; false when the stream overflowed and collapsed.
public machine push(queue: &mut Queue, kind: u64, x: u64, y: u64, value: u64, order: u64, coalesce: bool) -> bool {
    transition coalesce && kind == POINTER && queue.len >= 2u64 {
        true -> coalescing(queue, kind, x, y, value, order)
        _ -> appending(queue, kind, x, y, value, order)
    }
    // Two trailing motions with the same buttons merge into the newest position.
    machine coalescing(queue: &mut Queue, kind: u64, x: u64, y: u64, value: u64, order: u64) -> bool requires queue.len >= 2u64 {
        let tail: u64 = queue.len - 1u64;
        let before: u64 = queue.len - 2u64;
        transition kind_of(queue.entries[tail]) == POINTER && kind_of(queue.entries[before]) == POINTER
            && value_of(queue.entries[tail]) == value && value_of(queue.entries[before]) == value {
            true -> merged(queue, tail, x, y, value, order)
            _ -> appending(queue, kind, x, y, value, order)
        }
    }
    machine merged(queue: &mut Queue, tail: u64, x: u64, y: u64, value: u64, order: u64) -> bool requires tail < 17u64 {
        queue.entries[tail] = pack(POINTER, x, y, value);
        queue.orders[tail] = order;
        true
    }
    machine appending(queue: &mut Queue, kind: u64, x: u64, y: u64, value: u64, order: u64) -> bool {
        transition queue.len < 16u64 {
            true -> append(queue, kind, x, y, value, order)
            _ -> overflow(queue, order)
        }
    }
    machine append(queue: &mut Queue, kind: u64, x: u64, y: u64, value: u64, order: u64) -> bool requires queue.len < 16u64 {
        let at: u64 = queue.len;
        queue.entries[at] = pack(kind, x, y, value);
        queue.orders[at] = order;
        queue.len = at + 1u64;
        true
    }
    machine overflow(queue: &mut Queue, order: u64) -> bool {
        cancel(queue, order);
        false
    }
}
// Collapse pending input to one CANCEL boundary; a retiring stream keeps RETIRED.
public machine cancel(queue: &mut Queue, order: u64) {
    transition queue.channel != 0u64 && !retiring(queue) {
        true -> boundary(queue, CANCEL, order)
        _ -> done()
    }
}
public machine retire(queue: &mut Queue, order: u64) {
    transition queue.channel != 0u64 {
        true -> boundary(queue, RETIRED, order)
        _ -> done()
    }
}
machine boundary(queue: &mut Queue, kind: u64, order: u64) {
    queue.entries[0] = pack(kind, 0u64, 0u64, 0u64);
    queue.orders[0] = order;
    queue.len = 1u64;
}
// Deliver the pending description, else the oldest entry, as a NEXT packet for
// the given view epoch. A drained RETIRED boundary forgets the whole stream. An
// empty queue reports NONE.
public machine next(queue: &mut Queue, epoch: u64) -> [u64; 8] {
    transition {
        queue.describe_pending -> announced(queue, epoch)
        queue.len != 0u64 -> popped(queue, epoch)
        _ -> (empty_packet(epoch))
    }
    machine announced(queue: &mut Queue, epoch: u64) -> [u64; 8] {
        queue.describe_pending = false;
        let mut packet: [u64; 8];
        packet[1] = epoch;
        packet[2] = DESCRIBED;
        packet[3] = queue.described.first;
        packet[4] = queue.described.second;
        packet[5] = queue.described.controls;
        packet[6] = queue.channel;
        packet[7] = queue.group;
        packet
    }
    machine popped(queue: &mut Queue, epoch: u64) -> [u64; 8] requires queue.len >= 1u64 {
        let entry: u64 = queue.entries[0];
        let mut packet: [u64; 8];
        packet[1] = epoch;
        packet[2] = kind_of(entry);
        packet[3] = x_of(entry);
        packet[4] = y_of(entry);
        packet[5] = value_of(entry);
        packet[6] = queue.channel;
        packet[7] = queue.group;
        let remaining: u64 = queue.len - 1u64;
        shift(queue, 0u64);
        queue.len = remaining;
        transition packet[2] == RETIRED {
            true -> forgotten(queue, packet)
            _ -> (packet)
        }
    }
    machine forgotten(queue: &mut Queue, packet: [u64; 8]) -> [u64; 8] {
        let empty: Queue;
        queue.channel = empty.channel;
        queue.source = empty.source;
        queue.group = empty.group;
        queue.described = empty.described;
        queue.describe_pending = false;
        queue.len = 0u64;
        packet
    }
}
machine empty_packet(epoch: u64) -> [u64; 8] {
    let mut packet: [u64; 8];
    packet[1] = epoch;
    packet[2] = NONE;
    packet
}
// Move entries one place toward the front, from `index` to the last entry.
machine shift(queue: &mut Queue, index: u64) requires index < 17u64 {
    transition index + 1u64 < queue.len {
        true -> moved(queue, index)
        _ -> done()
    }
    machine moved(queue: &mut Queue, index: u64) requires index < 16u64 {
        queue.entries[index] = queue.entries[index + 1u64];
        queue.orders[index] = queue.orders[index + 1u64];
        transition { _ -> shift(queue, index + 1u64) }
    }
}
// Drop queued key events and end with a CANCEL_KEYS boundary; pointer entries stay.
public machine cancel_keys(queue: &mut Queue, order: u64) {
    transition queue.channel != 0u64 && !retiring(queue) {
        true -> compact(queue, 0u64, 0u64, order)
        _ -> done()
    }
    machine compact(queue: &mut Queue, index: u64, keep: u64, order: u64) requires keep <= index && index <= 17u64 {
        transition index < queue.len {
            true -> examine(queue, index, keep, order)
            _ -> ended(queue, keep, order)
        }
    }
    machine examine(queue: &mut Queue, index: u64, keep: u64, order: u64) requires keep <= index && index < 17u64 {
        let kind: u64 = kind_of(queue.entries[index]);
        transition kind == KEY || kind == CANCEL_KEYS {
            true -> compact(queue, index + 1u64, keep, order)
            _ -> kept(queue, index, keep, order)
        }
    }
    machine kept(queue: &mut Queue, index: u64, keep: u64, order: u64) requires keep <= index && index < 17u64 {
        queue.entries[keep] = queue.entries[index];
        queue.orders[keep] = queue.orders[index];
        transition { _ -> compact(queue, index + 1u64, keep + 1u64, order) }
    }
    // Ordinary entries number at most sixteen, so the boundary always fits.
    machine ended(queue: &mut Queue, keep: u64, order: u64) requires keep <= 17u64 {
        transition keep < 17u64 {
            true -> closed(queue, keep, order)
            _ -> done()
        }
    }
    machine closed(queue: &mut Queue, keep: u64, order: u64) requires keep < 17u64 {
        queue.entries[keep] = pack(CANCEL_KEYS, 0u64, 0u64, 0u64);
        queue.orders[keep] = order;
        queue.len = keep + 1u64;
    }
}
machine done() {}
