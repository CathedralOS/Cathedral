module upstream;
// Apply one parent POLL snapshot: adopt its view, then route the one event it
// carries under the parent's stream and group names. A snapshot that cannot be
// honoured drops the parent grant rather than guessing; a later snapshot regrants.
use protocol::main;
use level::World;
use geometry::Grant;
use names::Name;
use input::main::Admitted;
use input::pointer;
use input::keys;

public machine inherit_poll(world: &mut World, reply: &[u64; 8]) -> Grant {
    let grant: Grant = snapshot(reply);
    level::inherit(world, grant);
    transition geometry::valid_grant(grant) {
        true -> event(world, grant, reply[5] & 255u64, reply[6], reply[7], (reply[5] >> 8u64) & 7u64,
            reply[5] >> 32u64, (reply[5] >> 17u64) & 0x7fffu64)
        _ -> (grant)
    }
    machine event(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, channel: u64, group: u64) -> Grant {
        transition kind == NONE || kind == GROUP_RETIRED {
            true -> routed(world, grant, kind, x, y, value, names::upstream(channel), 0u64)
            _ -> binding(world, grant, kind, x, y, value, names::upstream(channel), names::upstream(group))
        }
    }
    machine binding(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, channel: Name, group: Name) -> Grant {
        let admitted: Admitted = input::main::bind(&mut world.input, channel, group);
        transition admitted {
            Admitted::Slot { index } -> routed(world, grant, kind, x, y, value, channel, 0u64)
            Admitted::Failed { code } -> lost(world)
        }
    }
    machine routed(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, channel: Name, ignored: u64) -> Grant {
        transition {
            kind == NONE -> (grant)
            kind == POINTER -> pointed(world, grant, kind, x, y, value, channel)
            kind == KEY -> keyed(world, grant, kind, x, y, value, channel)
            kind == CANCEL -> stream_cancelled(world, grant, kind, x, y, value, channel)
            kind == CANCEL_KEYS -> keys_cancelled(world, grant, kind, x, y, value, channel)
            _ -> lost(world)
        }
    }
    machine pointed(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, channel: Name) -> Grant {
        let status: u64 = pointer::route(world, channel, x, y, value, true);
        transition { _ -> outcome(world, grant, status, channel, kind, x, y, value) }
    }
    machine keyed(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, channel: Name) -> Grant {
        let status: u64 = keys::route(world, channel, x, y);
        transition { _ -> outcome(world, grant, status, channel, kind, x, y, value) }
    }
    machine stream_cancelled(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, channel: Name) -> Grant {
        let status: u64 = stream_cancel(world, channel);
        transition { _ -> outcome(world, grant, status, channel, kind, x, y, value) }
    }
    machine keys_cancelled(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, channel: Name) -> Grant {
        let status: u64 = key_cancel(world, channel);
        transition { _ -> outcome(world, grant, status, channel, kind, x, y, value) }
    }
    // Running out of child-local names drops only this stream, not the grant.
    machine outcome(world: &mut World, grant: Grant, status: u64, channel: Name, kind: u64, x: u64, y: u64, value: u64) -> Grant {
        transition {
            status == 0u64 -> (grant)
            status == NO_MEMORY -> capacity_loss(world, grant, channel, kind, x, y, value)
            _ -> lost(world)
        }
    }
    machine lost(world: &mut World) -> Grant {
        level::inherit(world, geometry::no_grant());
        geometry::no_grant()
    }
}
machine snapshot(reply: &[u64; 8]) -> Grant {
    transition reply[0] == 0u64 {
        true -> (Grant { epoch: reply[1], width: reply[2], height: reply[3], keys: reply[4] & VALID_KEY_MASK })
        _ -> (geometry::no_grant())
    }
}
// A delivered CANCEL already ends the upstream stream's held state; its sender
// suppresses residual holds, so this world must not wait for releases.
machine stream_cancel(world: &mut World, channel: Name) -> u64 {
    let admitted: Admitted = input::main::admit(&mut world.input, channel);
    transition admitted {
        Admitted::Slot { index } -> cancelled(world, channel, index)
        Admitted::Failed { code } -> (code)
    }
    machine cancelled(world: &mut World, channel: Name, index: u64 [0..=3]) -> u64 {
        level::cancel_stream(world, index);
        let group: u64 [0..=3] = world.input.streams[index].group;
        let mut stream: input::main::Stream;
        stream.id = channel;
        stream.group = group;
        world.input.streams[index] = stream;
        0u64
    }
}
machine key_cancel(world: &mut World, channel: Name) -> u64 {
    let admitted: Admitted = input::main::admit(&mut world.input, channel);
    transition admitted {
        Admitted::Slot { index } -> cancelled(world, channel, index, 0u64)
        Admitted::Failed { code } -> (code)
    }
    machine cancelled(world: &mut World, channel: Name, index: u64 [0..=3], slot: u64) -> u64 requires slot <= 4u64 {
        transition slot < 4u64 {
            true -> child(world, channel, index, slot)
            _ -> cleared(world, index)
        }
    }
    machine child(world: &mut World, channel: Name, index: u64 [0..=3], slot: u64) -> u64 requires slot < 4u64 {
        children::cancel_keys(&mut world.children[slot], index, channel);
        transition { _ -> cancelled(world, channel, index, slot + 1u64) }
    }
    machine cleared(world: &mut World, index: u64 [0..=3]) -> u64 {
        world.input.streams[index].held = 0u64;
        world.input.streams[index].suppressed = 0u64;
        0u64
    }
}
// Remember the stream's new button or key state, then interrupt its delivery.
machine capacity_loss(world: &mut World, grant: Grant, channel: Name, kind: u64, x: u64, y: u64, value: u64) -> Grant {
    transition { _ -> find(world, grant, channel, kind, x, y, value, 0u64) }
    machine find(world: &mut World, grant: Grant, channel: Name, kind: u64, x: u64, y: u64, value: u64, index: u64) -> Grant requires index <= 4u64 {
        transition index < 4u64 {
            true -> compared(world, grant, channel, kind, x, y, value, index)
            _ -> (grant)
        }
    }
    machine compared(world: &mut World, grant: Grant, channel: Name, kind: u64, x: u64, y: u64, value: u64, index: u64) -> Grant requires index < 4u64 {
        transition names::same(world.input.streams[index].id, channel) {
            true -> remembered(world, grant, kind, x, y, value, index)
            _ -> find(world, grant, channel, kind, x, y, value, index + 1u64)
        }
    }
    machine remembered(world: &mut World, grant: Grant, kind: u64, x: u64, y: u64, value: u64, index: u64) -> Grant requires index < 4u64 {
        transition {
            kind == POINTER -> buttons(world, grant, value, index)
            kind == KEY && x >= 1u64 && x <= 64u64 -> keys(world, grant, 1u64 << (x - 1u64), y, index)
            _ -> interrupted(world, grant, index)
        }
    }
    machine buttons(world: &mut World, grant: Grant, value: u64, index: u64) -> Grant requires index < 4u64 {
        world.input.streams[index].buttons = value;
        transition { _ -> interrupted(world, grant, index) }
    }
    machine keys(world: &mut World, grant: Grant, bit: u64, state: u64, index: u64) -> Grant requires index < 4u64 {
        transition state == RELEASE {
            true -> released(world, grant, bit, index)
            _ -> pressed(world, grant, bit, index)
        }
    }
    machine released(world: &mut World, grant: Grant, bit: u64, index: u64) -> Grant requires index < 4u64 {
        world.input.streams[index].held = world.input.streams[index].held & ~bit;
        transition { _ -> interrupted(world, grant, index) }
    }
    machine pressed(world: &mut World, grant: Grant, bit: u64, index: u64) -> Grant requires index < 4u64 {
        world.input.streams[index].held = world.input.streams[index].held | bit;
        transition { _ -> interrupted(world, grant, index) }
    }
    machine interrupted(world: &mut World, grant: Grant, index: u64) -> Grant requires index < 4u64 {
        level::cancel_stream(world, index);
        grant
    }
}
