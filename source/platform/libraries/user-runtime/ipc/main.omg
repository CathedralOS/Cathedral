module ipc::main;
// Copied IPC is the kernel's setup/typed-grant transport, not a replacement for
// the platform shared mailbox. Handles are local names; bytes convey no rights.
use kernel::Gate;
use kernel::Kernel;

public data Channel {
    sender: u64;
    receiver: u64;
}
public data Opened {
    case Ready(channel: Channel);
    case Failed(code: u64);
}
public data Received [copy] {
    case Message(bytes: u64 [0..=64]);
    case Failed(code: u64);
    case InvalidLength;
}

public machine open(gate: &Gate) -> Opened reaches Kernel invokes Kernel; {
    let mut record: [u64; 8];
    let status: u64 = Kernel::channel(gate, &mut record);
    transition status == 0u64 {
        true -> opened(record)
        _ -> (Opened::Failed { code: status })
    }
    machine opened(record: [u64; 8]) -> Opened {
        Opened::Ready { channel: Channel { sender: record[0], receiver: record[1] } }
    }
}

public machine send(gate: &Gate, sender: u64, message: &[u64; 8], bytes: u64 [0..=64]) -> u64
    reaches Kernel invokes Kernel; {
    Kernel::send(gate, sender, message, bytes)
}

public machine receive(gate: &Gate, receiver: u64, message: &mut [u64; 8]) -> Received
    reaches Kernel blocks; invokes Kernel; {
    let result: u64 = block Kernel::receive(gate, receiver, message);
    transition result <= 64u64 {
        true -> (Received::Message { bytes: result })
        _ -> failure(result)
    }
    machine failure(result: u64) -> Received {
        transition result >= 0x8000000000000000u64 {
            true -> (Received::Failed { code: result })
            _ -> (Received::InvalidLength)
        }
    }
}

// Consume the local pair. Releasing one endpoint never skips the other on error.
public machine close(gate: &Gate, channel: Channel) -> u64 reaches Kernel invokes Kernel; {
    let first: u64 = Kernel::close(gate, channel.sender);
    let second: u64 = Kernel::close(gate, channel.receiver);
    transition first == 0u64 {
        true -> (second)
        _ -> (first)
    }
}
