use connection/requests.omg;
use kernel.omg;
use connection/main.omg;

// Every phase uses the same cleanup, including half a frame/grant and half setup.
// Clear custody first. Failure to release one name never skips the remaining ones.
public machine release(gate: &|kernel|::Gate, peer: &mut |main|::Peer) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let sender: u64 = peer.sender;
    let receiver: u64 = peer.receiver;
    let writer: u64 = peer.writer.handle;
    let reader: u64 = peer.reader.handle;
    let wait: u64 = peer.bell.wait;
    let signal: u64 = peer.bell.signal;
    let control: u64 = peer.bell.control;
    let remote: u64 = peer.signal;
    let grant: u64 = peer.grant;
    let kind: u64 = peer.grant_kind;
    peer.sender = 0u64;
    peer.receiver = 0u64;
    peer.writer.handle = 0u64;
    peer.reader.handle = 0u64;
    peer.bell.wait = 0u64;
    peer.bell.signal = 0u64;
    peer.bell.control = 0u64;
    peer.signal = 0u64;
    peer.grant = 0u64;
    peer.grant_kind = 0u64;
    peer.pipeline = false;
    |requests|::clear(&mut peer.requests);
    close_endpoint(gate, sender);
    close_endpoint(gate, receiver);
    block release_memory(gate, writer);
    block release_memory(gate, reader);
    close_bell(gate, control);
    drop_notification(gate, wait);
    drop_notification(gate, signal);
    drop_notification(gate, control);
    drop_notification(gate, remote);
    block release_grant(gate, kind, grant);
}
public machine release_grant(gate: &|kernel|::Gate, kind: u64, handle: u64) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition {
        kind == 1u64 -> block release_memory(gate, handle)
        kind == 2u64 -> close_endpoint(gate, handle)
        _ -> drop_notification(gate, handle)
    }
}
machine close_endpoint(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
    transition handle != 0u64 {
        true -> close(gate, handle)
        _ -> done()
    }
    machine close(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
        let ignored: u64 = |kernel|::Kernel::close(gate, handle);
    }
}
machine release_memory(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
    transition handle != 0u64 {
        true -> block release(gate, handle)
        _ -> done()
    }
    machine release(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
        let ignored: u64 = block |kernel|::Kernel::memory_release(gate, handle);
    }
}
machine close_bell(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
    transition handle != 0u64 {
        true -> close(gate, handle)
        _ -> done()
    }
    machine close(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
        let ignored: u64 = |kernel|::Kernel::notify_control(gate, handle, 0u64);
    }
}
machine drop_notification(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
    transition handle != 0u64 {
        true -> release(gate, handle)
        _ -> done()
    }
    machine release(gate: &|kernel|::Gate, handle: u64) reaches |kernel|::Kernel {
        let ignored: u64 = |kernel|::Kernel::notify_drop(gate, handle);
    }
}
machine done() {}
