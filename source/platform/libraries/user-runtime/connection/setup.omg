// Existing v4 handshake, in order. Each received right enters custody before
// validation can fail; the public connection entrance releases every partial phase.
use kernel.omg;
use connection/main.omg;
use memory/main.omg as memory_main;
use notification/main.omg as notification_main;
use time.omg;

public machine connect(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block start(gate, peer);
    transition status == 0u64 {
        true -> block resume(gate, peer, deadline)
        _ -> (status)
    }
}
// The client's first step, which never waits: the writer, the bell and the
// hello. A caller that must keep serving while the peer gets round to
// answering resumes once the peer's first reply is ready.
public machine start(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let allocation: |memory_main|::Allocation = block |memory_main|::allocate(gate, 1u64);
    transition allocation {
        |memory_main|::Allocation::Ready { writer } -> allocated(gate, peer, writer)
        |memory_main|::Allocation::Failed { code } -> (code)
    }
    machine allocated(gate: &|kernel|::Gate, peer: &mut |main|::Peer, writer: |memory_main|::Writer) -> u64 reaches |kernel|::Kernel {
        peer.writer = writer;
        let creation: |notification_main|::Creation = |notification_main|::create(gate);
        transition creation {
            |notification_main|::Creation::Ready { bell } -> opened(gate, peer, bell)
            |notification_main|::Creation::Failed { code } -> (code)
        }
    }
}
// The rest of the handshake, from the peer's first acknowledgement.
public machine resume(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    block writer(gate, peer, deadline)
}
machine opened(gate: &|kernel|::Gate, peer: &mut |main|::Peer, bell: |notification_main|::Bell) -> u64 reaches |kernel|::Kernel {
    peer.bell = bell;
    transition peer.pipeline { true -> pipeline(gate, peer) _ -> ordinary(gate, peer) }
}
machine pipeline(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 8];
    packet[0] = 0x6172646568746163u64;
    packet[1] = 0x6465726168732e6cu64;
    packet[2] = 0x6e696c657069702eu64;
    packet[3] = 0x34762e65u64;
    exact(|kernel|::Kernel::send(gate, peer.sender, &packet, 28u64), 28u64)
}
machine ordinary(gate: &|kernel|::Gate, peer: &|main|::Peer) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 8];
    // source-rs/platform/contracts/connection.rs: "cathedral.shared.v4".
    packet[0] = 0x6172646568746163u64;
    packet[1] = 0x6465726168732e6cu64;
    packet[2] = 0x34762eu64;
    exact(|kernel|::Kernel::send(gate, peer.sender, &packet, 19u64), 19u64)
}
machine writer(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block ack(gate, peer.receiver, deadline);
    transition status == 0u64 {
        true -> block delegated(gate, peer, deadline)
        _ -> (status)
    }
    machine delegated(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = |memory_main|::delegate(gate, peer.writer.handle, peer.sender);
        transition status == 0u64 {
            true -> block bell(gate, peer, deadline)
            _ -> (status)
        }
    }
}
machine bell(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block ack(gate, peer.receiver, deadline);
    transition status == 0u64 {
        true -> block delegated(gate, peer, deadline)
        _ -> (status)
    }
    machine delegated(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let mut packet: [u64; 10];
        packet[1] = peer.bell.signal;
        let status: u64 = |kernel|::Kernel::notify_send(gate, peer.sender, &packet);
        transition status == 0u64 {
            true -> block released(gate, peer, deadline)
            _ -> (status)
        }
    }
    machine released(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let signal: u64 = peer.bell.signal;
        peer.bell.signal = 0u64;
        let status: u64 = |kernel|::Kernel::notify_drop(gate, signal);
        transition status == 0u64 {
            true -> block reader(gate, peer, deadline)
            _ -> (status)
        }
    }
}
machine reader(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block ready(gate, peer.receiver, deadline);
    transition status == 0u64 {
        true -> block accepted(gate, peer, deadline)
        _ -> (status)
    }
    machine accepted(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let acceptance: |memory_main|::Acceptance = block |memory_main|::accept(gate, peer.receiver);
        transition acceptance {
            |memory_main|::Acceptance::Ready { reader } -> block installed(gate, peer, deadline, reader)
            |memory_main|::Acceptance::Failed { code } -> (code)
        }
    }
    machine installed(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64, reader: |memory_main|::Reader) -> u64 reaches |kernel|::Kernel {
        peer.reader = reader;
        let mut packet: [u64; 8];
        packet[0] = 0x722e646572616873u64;
        packet[1] = 0x34762e79646165u64;
        let status: u64 = exact(|kernel|::Kernel::send(gate, peer.sender, &packet, 15u64), 15u64);
        transition status == 0u64 {
            true -> block signal(gate, peer, deadline)
            _ -> (status)
        }
    }
}
machine signal(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block ready(gate, peer.receiver, deadline);
    transition status == 0u64 {
        true -> block accepted(gate, peer, deadline)
        _ -> (status)
    }
    machine accepted(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let mut packet: [u64; 10];
        let status: u64 = block |kernel|::Kernel::notify_receive(gate, peer.receiver, &mut packet);
        transition status < |kernel|::ERROR_BASE {
            true -> block installed(gate, peer, deadline, status, packet)
            _ -> (status)
        }
    }
    machine installed(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64, status: u64, packet: [u64; 10]) -> u64 reaches |kernel|::Kernel {
        peer.signal = packet[1];
        transition status == 0u64 && packet[0] == 0u64 && packet[1] != 0u64 {
            true -> block checked(gate, peer, deadline)
            _ -> (|kernel|::IO_ERROR)
        }
    }
    machine checked(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let status: u64 = |kernel|::Kernel::notify_signal(gate, peer.signal);
        transition status == 0u64 {
            true -> block commit(gate, peer, deadline)
            _ -> (status)
        }
    }
}
machine commit(gate: &|kernel|::Gate, peer: &mut |main|::Peer, deadline: u64) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 8];
    packet[0] = 0x632e646572616873u64;
    packet[1] = 0x34762e74696d6d6fu64;
    let status: u64 = exact(|kernel|::Kernel::send(gate, peer.sender, &packet, 16u64), 16u64);
    transition status == 0u64 {
        true -> block ack(gate, peer.receiver, deadline)
        _ -> (status)
    }
}
public machine ack(gate: &|kernel|::Gate, receiver: u64, deadline: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block ready(gate, receiver, deadline);
    transition status == 0u64 {
        true -> block received(gate, receiver)
        _ -> (status)
    }
    machine received(gate: &|kernel|::Gate, receiver: u64) -> u64 reaches |kernel|::Kernel {
        let mut packet: [u64; 8];
        let status: u64 = block |kernel|::Kernel::receive(gate, receiver, &mut packet);
        transition status == 15u64 && packet[0] == 0x722e646572616873u64 && packet[1] == 0x34762e79646165u64 {
            true -> (0u64)
            _ -> unexpected(status)
        }
    }
}
public machine ready(gate: &|kernel|::Gate, receiver: u64, deadline: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let clock: u64 = |kernel|::Kernel::clock(gate);
    let tick: |time|::Tick = |time|::read(gate, clock);
    transition tick {
        |time|::Tick::Read { value } -> block checked(gate, receiver, deadline, value)
        |time|::Tick::Failed { code } -> (code)
    }
    machine checked(gate: &|kernel|::Gate, receiver: u64, deadline: u64, now: u64) -> u64 reaches |kernel|::Kernel {
        transition |time|::reached(now, deadline) {
            true -> (|kernel|::TIMED_OUT)
            _ -> block waited(gate, receiver, deadline)
        }
    }
    machine waited(gate: &|kernel|::Gate, receiver: u64, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let mut interests: [u64; 8];
        interests[1] = receiver;
        block |kernel|::Kernel::wait(gate, &interests, 1u64, deadline)
    }
}
machine exact(status: u64, expected: u64) -> u64 {
    transition status == expected {
        true -> (0u64)
        _ -> unexpected(status)
    }
}
machine unexpected(status: u64) -> u64 {
    transition status >= |kernel|::ERROR_BASE {
        true -> (status)
        _ -> (|kernel|::IO_ERROR)
    }
}
