// Open the installed broker -> acquire interaction -> keep using that same
// request stream. No global discovery, connection reset or implicit grant.
use kernel.omg;
use {protocol}/services.omg;
use main.omg;
use connection/main.omg as connection_main;
use connection/call.omg;
use services/acquire.omg;

public data Services { broker: |connection_main|::Peer; wake: u64; }
public data Reply {
    case Received(words: [u64; 8]);
    case Failed(code: u64);
}
public machine open(gate: &|kernel|::Gate, binding: &mut Services, environment: &|main|::Environment, deadline: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition environment.count == 2u64 {
        true -> block |connection_main|::connect(gate, &mut binding.broker,
            environment.endpoints[0], environment.endpoints[1], deadline)
        _ -> (|kernel|::INVALID_ARGUMENT)
    }
}
// The matrix asks for independent poll/visual work at connection setup. Other
// app service clients keep the ordinary one-request open above.
public machine open_pipeline(gate: &|kernel|::Gate, binding: &mut Services, environment: &|main|::Environment, deadline: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition environment.count == 2u64 {
        true -> block |connection_main|::connect_pipeline(gate, &mut binding.broker,
            environment.endpoints[0], environment.endpoints[1], deadline)
        _ -> (|kernel|::INVALID_ARGUMENT)
    }
}
public machine interaction(gate: &|kernel|::Gate, binding: &mut Services, clock: u64, minimum: u64, maximum: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition minimum > 0u64 && minimum <= 1u64 && maximum >= 1u64 {
        true -> block selected(gate, binding, clock, minimum, maximum)
        _ -> (|services|::INCOMPATIBLE)
    }
    machine selected(gate: &|kernel|::Gate, binding: &mut Services, clock: u64, minimum: u64, maximum: u64) -> u64 reaches |kernel|::Kernel {
        transition {
            binding.broker.fault != 0u64 -> (binding.broker.fault)
            binding.wake != 0u64 -> (0u64)
            _ -> block |acquire|::interaction(gate, binding, clock, minimum, maximum)
        }
    }
}
// Plain broker operations, including refusals, retain correlation. Unexpected
// attachments retire this connection and release the received right.
public machine exchange(gate: &|kernel|::Gate, binding: &mut Services, clock: u64, words: &[u64; 8]) -> Reply
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let result: |call|::CallReply = block |call|::exchange(gate, &mut binding.broker, clock, words);
    transition result {
        |call|::CallReply::Received { frame, notification } -> block received(gate, binding, frame, notification)
        |call|::CallReply::Object { frame, object } -> block unexpected_object(gate, binding, object)
        |call|::CallReply::Endpoint { frame, endpoint } -> block unexpected_endpoint(gate, binding, endpoint)
        |call|::CallReply::Failed { code } -> (Reply::Failed { code: code })
    }
}
public machine unexpected_endpoint(gate: &|kernel|::Gate, binding: &mut Services, endpoint: u64) -> Reply
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    block close(gate, binding);
    Reply::Failed { code: |kernel|::IO_ERROR }
}
// Finish a plain service reply after either the blocking helper or an app-owned
// multiplexed wait. Attachment validation and release stay at this boundary.
public machine received(gate: &|kernel|::Gate, binding: &mut Services, frame: |connection_main|::Frame, notification: u64) -> Reply
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition frame.bytes == 64u64 && notification == 0u64 {
        true -> (Reply::Received { words: frame.payload })
        _ -> block malformed(gate, binding, notification)
    }
}
machine malformed(gate: &|kernel|::Gate, binding: &mut Services, notification: u64) -> Reply reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    block close(gate, binding);
    Reply::Failed { code: |kernel|::IO_ERROR }
}
public machine close(gate: &|kernel|::Gate, binding: &mut Services) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let wake: u64 = binding.wake;
    binding.wake = 0u64;
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, wake);
    let closed: u64 = block |connection_main|::close(gate, &mut binding.broker);
}

public machine unexpected_object(gate: &|kernel|::Gate, binding: &mut Services, object: u64) -> Reply
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    block close(gate, binding);
    Reply::Failed { code: |kernel|::IO_ERROR }
}
