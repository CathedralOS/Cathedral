// A complete refusal is an ordinary answer. A malformed reply or wrong grant
// poisons only this binding; no late grant can be consumed by a later request.
use kernel.omg;
use {protocol}/services.omg;
use services/main.omg;
use connection/main.omg as connection_main;
use connection/call.omg;

public machine interaction(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64, minimum: u64, maximum: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let words: [u64; 8] = |services|::request(|services|::INTERACTION, minimum, maximum, 0u64);
    let result: |call|::CallReply = block |call|::exchange(gate, &mut binding.broker, clock, &words);
    transition result {
        |call|::CallReply::Received { frame, notification } -> block received(gate, binding, frame, notification)
        |call|::CallReply::Object { frame, object } -> block unexpected_object(gate, binding, object)
        |call|::CallReply::Endpoint { frame, endpoint } -> block unexpected_endpoint(gate, binding, endpoint)
        |call|::CallReply::Failed { code } -> (code)
    }
}
machine unexpected_endpoint(gate: &|kernel|::Gate, binding: &mut |main|::Services, endpoint: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    block |main|::close(gate, binding);
    |kernel|::IO_ERROR
}
public machine received(gate: &|kernel|::Gate, binding: &mut |main|::Services, frame: |connection_main|::Frame, notification: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition frame.bytes == 64u64 && frame.payload[2] == 0u64 && frame.payload[3] == 0u64
        && frame.payload[4] == 0u64 && frame.payload[5] == 0u64 && frame.payload[6] == 0u64 && frame.payload[7] == 0u64 {
        true -> block answer(gate, binding, frame.payload[0], frame.payload[1], notification)
        _ -> block malformed(gate, binding, notification)
    }
}
machine answer(gate: &|kernel|::Gate, binding: &mut |main|::Services, code: u64, version: u64, notification: u64) -> u64 reaches |kernel|::Kernel {
    transition {
        code != 0u64 && version == 0u64 && notification == 0u64 -> (code)
        code == 0u64 && version == 1u64 && notification != 0u64 -> block granted(gate, binding, notification)
        _ -> block malformed(gate, binding, notification)
    }
}
machine granted(gate: &|kernel|::Gate, binding: &mut |main|::Services, notification: u64) -> u64 reaches |kernel|::Kernel {
    // Check wait authority without retaining a borrow into provider memory. A
    // consumed initial hint is harmless: the app polls presentation after acquire.
    let status: u64 = block |kernel|::Kernel::notify_wait(gate, notification, 0u64, 1u64);
    transition status <= 1u64 {
        true -> retained(binding, notification)
        _ -> block malformed(gate, binding, notification)
    }
}
machine retained(binding: &mut |main|::Services, notification: u64) -> u64 {
    binding.wake = notification;
    0u64
}
machine malformed(gate: &|kernel|::Gate, binding: &mut |main|::Services, notification: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    block |main|::close(gate, binding);
    |kernel|::IO_ERROR
}

machine unexpected_object(gate: &|kernel|::Gate, binding: &mut |main|::Services, object: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    block |main|::close(gate, binding);
    |kernel|::IO_ERROR
}
