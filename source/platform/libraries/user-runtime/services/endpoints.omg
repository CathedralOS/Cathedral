// Acquire one explicitly requested endpoint from the installed broker. A half
// pair remains caller-owned: close it if the second acquisition is refused.
// Decoding is separate so event loops can service owner control while waiting.
use connection/main.omg as connection_main;
use kernel.omg;
use connection/call.omg;
use services/main.omg;
use {protocol}/services.omg;

public data Part {
    case Granted(endpoint: u64);
    case Refused(code: u64);
}
public machine acquire(gate: &|kernel|::Gate, binding: &mut |main|::Services, clock: u64,
    contract: u64, part: u64) -> Part reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let words: [u64; 8] = |services|::request(contract, 1u64, 1u64, part);
    let reply: |call|::CallReply = block |call|::exchange(gate, &mut binding.broker, clock, &words);
    transition reply {
        |call|::CallReply::Object { frame, object } -> block invalid_object(gate, binding, object)
        |call|::CallReply::Endpoint { frame, endpoint } -> block endpoint_reply(gate, binding, frame, endpoint)
        |call|::CallReply::Received { frame, notification } -> block plain_reply(gate, binding, frame, notification)
        |call|::CallReply::Failed { code } -> (Part::Refused { code: code })
    }
}
public machine endpoint_reply(gate: &|kernel|::Gate, binding: &mut |main|::Services, frame: |connection_main|::Frame, endpoint: u64) -> Part reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition valid(frame) && frame.payload[0] == 0u64 && frame.payload[1] == 1u64 && endpoint != 0u64 {
        true -> (Part::Granted { endpoint: endpoint })
        _ -> block invalid_endpoint(gate, binding, endpoint)
    }
}
machine invalid_endpoint(gate: &|kernel|::Gate, binding: &mut |main|::Services, endpoint: u64) -> Part reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::close(gate, endpoint);
    transition { _ -> block malformed(gate, binding) }
}
public machine plain_reply(gate: &|kernel|::Gate, binding: &mut |main|::Services, frame: |connection_main|::Frame, notification: u64) -> Part reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition valid(frame) && frame.payload[0] != 0u64 && frame.payload[1] == 0u64 && notification == 0u64 {
        true -> (Part::Refused { code: frame.payload[0] })
        _ -> block invalid_notification(gate, binding, notification)
    }
}
machine invalid_notification(gate: &|kernel|::Gate, binding: &mut |main|::Services, notification: u64) -> Part reaches |kernel|::Kernel {
    let ignored: u64 = |kernel|::Kernel::notify_drop(gate, notification);
    transition { _ -> block malformed(gate, binding) }
}
machine malformed(gate: &|kernel|::Gate, binding: &mut |main|::Services) -> Part reaches |kernel|::Kernel {
    block |main|::close(gate, binding);
    Part::Refused { code: |kernel|::IO_ERROR }
}
machine valid(frame: |connection_main|::Frame) -> bool {
    frame.bytes == 64u64 && frame.payload[2] == 0u64 && frame.payload[3] == 0u64
        && frame.payload[4] == 0u64 && frame.payload[5] == 0u64 && frame.payload[6] == 0u64 && frame.payload[7] == 0u64
}

public machine invalid_object(gate: &|kernel|::Gate, binding: &mut |main|::Services, object: u64) -> Part reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    transition { _ -> block malformed(gate, binding) }
}
