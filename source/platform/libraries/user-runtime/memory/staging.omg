// Allocate once -> fill bounded chunks -> seal/unmap -> hand off immutable
// custody. No private mapping or source borrow survives an operation.
use kernel.omg;
use memory/object.omg;

public data Buffer { handle: u64; bytes: u64; }
public data Allocation {
    case Ready(buffer: Buffer);
    case Failed(code: u64);
}
public machine allocate(gate: &|kernel|::Gate, bytes: u64 [1..=1048576]) -> Allocation
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let pages: u64 = (bytes + 4095u64) / 4096u64;
    transition pages >= 1u64 && pages <= 512u64 {
        true -> block create(gate, bytes, pages)
        _ -> (Allocation::Failed { code: |kernel|::INVALID_ARGUMENT })
    }
    machine create(gate: &|kernel|::Gate, bytes: u64, pages: u64 [1..=512]) -> Allocation reaches |kernel|::Kernel {
        let handle: u64 = block |kernel|::Kernel::memory_allocate(gate, pages);
        transition handle != 0u64 && handle < |kernel|::ERROR_BASE {
            true -> (Allocation::Ready { buffer: Buffer { handle: handle, bytes: bytes } })
            _ -> (Allocation::Failed { code: handle })
        }
    }
}
public machine write(gate: &|kernel|::Gate, buffer: &Buffer, offset: u64, words: &[u64; 1024], bytes: u64 [1..=8192]) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition offset <= buffer.bytes && bytes <= buffer.bytes - offset {
        true -> block |kernel|::Kernel::private_write(gate, buffer.handle, offset, words, bytes)
        _ -> (|kernel|::INVALID_ARGUMENT)
    }
}
// Takes custody on success AND failure. A failed unmap after sealing cannot
// leave a writable-looking staging value or leak its already frozen allocation.
public machine seal(gate: &|kernel|::Gate, buffer: &mut Buffer) -> |object|::Creation
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let handle: u64 = buffer.handle;
    buffer.handle = 0u64;
    buffer.bytes = 0u64;
    let status: u64 = block |kernel|::Kernel::object_freeze(gate, handle);
    transition status == 0u64 {
        true -> (|object|::Creation::Ready { object: |object|::Object { handle: handle } })
        _ -> block failed(gate, handle, status)
    }
    machine failed(gate: &|kernel|::Gate, handle: u64, status: u64) -> |object|::Creation reaches |kernel|::Kernel {
        let released: u64 = block |kernel|::Kernel::memory_release(gate, handle);
        |object|::Creation::Failed { code: status }
    }
}
public machine release(gate: &|kernel|::Gate, buffer: &mut Buffer) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let handle: u64 = buffer.handle;
    buffer.handle = 0u64;
    buffer.bytes = 0u64;
    block |kernel|::Kernel::memory_release(gate, handle)
}
