module kernel;
public const ERROR_BASE: u64 = 0x8000000000000000u64;
public const WOULD_BLOCK: u64 = 0xfffffffffffffff5u64;
public const TOO_SMALL: u64 = 0xffffffffffffffa6u64;
public const IO_ERROR: u64 = 0xfffffffffffffffbu64;
public const PEER_CLOSED: u64 = 0xffffffffffffffe0u64;
public const TIMED_OUT: u64 = 0xffffffffffffff92u64;
public const NOTIFY_SIGNALED: u64 = 0u64;
public const NOTIFY_TIMED_OUT: u64 = 1u64;
public const DENIED: u64 = 0xfffffffffffffff3u64;
public const BUSY: u64 = 0xfffffffffffffff0u64;
public const INVALID_ARGUMENT: u64 = 0xffffffffffffffeau64;
public const NO_MEMORY: u64 = 0xfffffffffffffff4u64;
public const NO_PROCESS_CAPACITY: u64 = 0xffffffffffffff37u64;
// The most frames one dynamic admission may take, and the frames each dynamic
// slot is worth; owner: source-rs/kernel/contracts/user.rs.
public const MAX_ADMISSION_FRAMES: u64 = 800u64;
public const ADMISSION_ALLOWANCE_FRAMES: u64 = 288u64;
// A page, and the stack a program gets when its image declares none and the
// most it may declare; owner: source-rs/kernel/core/user_tasks/address_space/address_space.rs.
public const PAGE_BYTES: u64 = 4096u64;
public const DEFAULT_STACK_PAGES: u64 = 8u64;
public const MAX_STACK_PAGES: u64 = 256u64;
public const BAD_HANDLE: u64 = 0xfffffffffffffff7u64;
public const BAD_EXECUTABLE: u64 = 0xfffffffffffffff8u64;
// Temporary native boundary, not a matrix service bundle. The table comes from
// this executable's read-only image; the kernel still authenticates every handle.
public data Gate {
    yield_now: addr;
    environment: addr;
    channel: addr;
    send: addr;
    receive: addr;
    close: addr;
    write: addr;
    clock: addr;
    clock_read: addr;
    wait: addr;
    memory_allocate: addr;
    memory_share: addr;
    memory_release: addr;
    shared_read: addr;
    shared_write: addr;
    shared_send: addr;
    shared_receive: addr;
    notify_create: addr;
    notify_drop: addr;
    notify_signal: addr;
    notify_wait: addr;
    notify_control: addr;
    notify_send: addr;
    notify_receive: addr;
    bootstrap: addr;
    endpoint_receive: addr;
    object_create: addr;
    object_send: addr;
    object_receive: addr;
    object_read: addr;
    private_write: addr;
    object_freeze: addr;
    wait_many: addr;
    launch_at: addr;
    launch_port: addr;
    task_connect: addr;
    spawn_tree: addr;
    task_cancel: addr;
    task_wait: addr;
    endpoint_send: addr;
    resource_budget: addr;
    notification_budget: addr;
    image_at: addr;
    image_from_object: addr;
    image_release: addr;
    task_reserve: addr;
    task_release: addr;
    pool_assign: addr;
    image_allow: addr;
    cpu_assign: addr;
    physical_assign: addr;
    resource_assign: addr;
    link_handle: addr;
    link_connect: addr;
    resource_grow: addr;
    physical_budget: addr;
    pool_available: addr;
    clock_stamp: addr;
}

public boundary trait Kernel {
    // Same caller-bound clock grant. Returns ticks, monotonic microseconds and
    // this account's measured CPU microseconds in buffer[0..3].
    machine clock_stamp(gate: &Gate, handle: u64, buffer: &mut [u64; 8]) -> u64 reaches;
    machine wait_many(gate: &Gate, records: &[u64; 96], count: u64 [0..=48], deadline: u64) -> u64 reaches blocks;
    machine yield_now(gate: &Gate) -> u64 reaches blocks;
    machine environment(gate: &Gate, buffer: &mut [u64; 8]) -> u64 reaches;
    machine channel(gate: &Gate, buffer: &mut [u64; 8]) -> u64 reaches;
    machine send(gate: &Gate, handle: u64, buffer: &[u64; 8], bytes: u64 [0..=64]) -> u64 reaches;
    machine receive(gate: &Gate, handle: u64, buffer: &mut [u64; 8]) -> u64 reaches blocks;
    machine close(gate: &Gate, handle: u64) -> u64 reaches;
    machine write(gate: &Gate, buffer: &[u64; 8], bytes: u64 [0..=64]) -> u64 reaches;
    machine clock(gate: &Gate) -> u64 reaches;
    machine clock_read(gate: &Gate, handle: u64, buffer: &mut [u64; 8]) -> u64 reaches;
    machine wait(gate: &Gate, records: &[u64; 8], count: u64 [0..=4], deadline: u64) -> u64 reaches blocks;
    machine memory_allocate(gate: &Gate, pages: u64 [1..=512]) -> u64 reaches blocks;
    machine memory_share(gate: &Gate, handle: u64) -> u64 reaches blocks;
    machine memory_release(gate: &Gate, handle: u64) -> u64 reaches blocks;
    machine shared_read(gate: &Gate, handle: u64, index: u64, words: &mut [u64; 8], count: u64 [1..=8]) -> u64 reaches blocks;
    machine shared_write(gate: &Gate, handle: u64, index: u64, words: &[u64; 8], count: u64 [1..=8]) -> u64 reaches blocks;
    machine shared_send(gate: &Gate, endpoint: u64, packet: &[u64; 10]) -> u64 reaches;
    machine shared_receive(gate: &Gate, endpoint: u64, packet: &mut [u64; 10]) -> u64 reaches blocks;
    machine notify_create(gate: &Gate, record: &mut [u64; 8]) -> u64 reaches;
    machine notify_drop(gate: &Gate, handle: u64) -> u64 reaches;
    machine notify_signal(gate: &Gate, handle: u64) -> u64 reaches;
    machine notify_wait(gate: &Gate, handle: u64, deadline: u64, timed: u64 [0..=1]) -> u64 reaches blocks;
    machine notify_control(gate: &Gate, handle: u64, action: u64 [0..=2]) -> u64 reaches;
    machine notify_send(gate: &Gate, endpoint: u64, packet: &[u64; 10]) -> u64 reaches;
    machine notify_receive(gate: &Gate, endpoint: u64, packet: &mut [u64; 10]) -> u64 reaches blocks;
    machine bootstrap(gate: &Gate, index: u64) -> u64 reaches;
    machine endpoint_receive(gate: &Gate, endpoint: u64, packet: &mut [u64; 10]) -> u64 reaches blocks;
    machine object_create(gate: &Gate, words: &[u64; 2048], bytes: u64 [1..=16384]) -> u64 reaches blocks;
    machine object_receive(gate: &Gate, endpoint: u64, packet: &mut [u64; 10]) -> u64 reaches blocks;
    machine object_read(gate: &Gate, handle: u64, index: u64, words: &mut [u64; 8], count: u64 [1..=8]) -> u64 reaches blocks;
    machine object_send(gate: &Gate, endpoint: u64, packet: &[u64; 10]) -> u64 reaches;
    machine private_write(gate: &Gate, handle: u64, offset: u64, words: &[u64; 1024], bytes: u64 [1..=8192]) -> u64 reaches blocks;
    machine object_freeze(gate: &Gate, handle: u64) -> u64 reaches blocks;
    // Child tasks: lent launch authority -> admitted child -> owner control -> collection.
    // The 22-word spawn record is argument, endpoint count, five endpoints, loan count
    // and fourteen loans; unused words stay zero. Exit records occupy five words.
    machine launch_at(gate: &Gate, index: u64) -> u64 reaches;
    machine launch_port(gate: &Gate, launch: u64) -> u64 reaches;
    machine task_connect(gate: &Gate, port: u64) -> u64 reaches;
    machine spawn_tree(gate: &Gate, launch: u64, record: &[u64; 22]) -> u64 reaches blocks;
    machine task_cancel(gate: &Gate, child: u64) -> u64 reaches blocks;
    machine task_wait(gate: &Gate, child: u64, record: &mut [u64; 8]) -> u64 reaches blocks;
    machine endpoint_send(gate: &Gate, endpoint: u64, packet: &[u64; 10]) -> u64 reaches;
    // Own account only: limits then usage for private pages, reader pages and
    // channels; notification reservation, charged objects, handle limit and use.
    machine resource_budget(gate: &Gate, record: &mut [u64; 8]) -> u64 reaches;
    machine notification_budget(gate: &Gate, record: &mut [u64; 8]) -> u64 reaches;
    // Executables and funded reservations: an image grant from the owner's
    // catalogue or a sealed object, a reservation over quotas/slots/load ceiling/
    // physical frames (six words), its release, and the idle launch's pool,
    // allowed images, CPU, frames and three absolute limits.
    machine image_at(gate: &Gate, index: u64) -> u64 reaches;
    machine image_from_object(gate: &Gate, object: u64, role: u64) -> u64 reaches;
    machine image_release(gate: &Gate, image: u64) -> u64 reaches;
    machine task_reserve(gate: &Gate, executable: u64, request: &[u64; 6]) -> u64 reaches;
    machine task_release(gate: &Gate, launch: u64) -> u64 reaches;
    machine pool_assign(gate: &Gate, launch: u64, count: u64) -> u64 reaches;
    machine image_allow(gate: &Gate, launch: u64, image: u64) -> u64 reaches;
    machine cpu_assign(gate: &Gate, launch: u64, limit: u64) -> u64 reaches;
    machine physical_assign(gate: &Gate, launch: u64, frames: u64) -> u64 reaches;
    machine resource_assign(gate: &Gate, launch: u64, limits: &[u64; 3]) -> u64 reaches;
    // Boot-approved provider links: the link the composition supplied at an
    // index, and a client connection over it whose endpoints are the returned
    // bootstrap index and the next one.
    machine link_handle(gate: &Gate, index: u64) -> u64 reaches;
    machine link_connect(gate: &Gate, link: u64) -> u64 reaches;
    // Funding a live launch: conserving growth of an owned launch by five
    // increments (private pages, reader pages, channels, descendant slots,
    // physical frames); this account's reserved then charged frames; and the
    // process slots it holds unused.
    machine resource_grow(gate: &Gate, launch: u64, delta: &[u64; 5]) -> u64 reaches;
    machine physical_budget(gate: &Gate, record: &mut [u64; 8]) -> u64 reaches;
    machine pool_available(gate: &Gate) -> u64 reaches;
}
