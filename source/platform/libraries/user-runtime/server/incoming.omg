use server/attachments.omg;
// Join a mailbox frame and optional sealed reader by ID, in either arrival order.
// The server owns the reader until reply/retirement. There is no copied fallback.
use kernel.omg;
use server/main.omg;
use connection/mailbox.omg;
use time.omg;
public machine poll(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64) -> |main|::Event
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition listener.peer.partial && |time|::reached(now, listener.peer.partial_deadline) {
        true -> (|main|::Event::Failed { code: |kernel|::TIMED_OUT })
        _ -> block drain(gate, listener, now)
    }
}
machine drain(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64) -> |main|::Event reaches |kernel|::Kernel {
    let hint: u64 = block |kernel|::Kernel::notify_wait(gate, listener.peer.bell.wait, now, 1u64);
    let transfer: u64 = block |attachments|::receive(gate, listener, now);
    transition transfer == 0u64 || transfer == |kernel|::TIMED_OUT || transfer == |kernel|::PEER_CLOSED {
        true -> block frame(gate, listener, now, hint, transfer)
        _ -> (|main|::Event::Failed { code: transfer })
    }
}
machine frame(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64, hint: u64, transfer: u64) -> |main|::Event reaches |kernel|::Kernel {
    transition listener.peer.has_frame {
        true -> reconcile(gate, listener, now, hint, transfer)
        _ -> block receive(gate, listener, now, hint, transfer)
    }
    machine receive(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64, hint: u64, transfer: u64) -> |main|::Event reaches |kernel|::Kernel {
        let status: u64 = block |mailbox|::receive(gate, &mut listener.peer);
        transition status == 0u64 || status == |kernel|::WOULD_BLOCK {
            true -> reconcile(gate, listener, now, hint, transfer)
            _ -> (|main|::Event::Failed { code: status })
        }
    }
}
machine reconcile(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64, hint: u64, transfer: u64) -> |main|::Event reaches |kernel|::Kernel {
    transition listener.peer.has_frame {
        true -> identified(gate, listener, now, hint, transfer)
        _ -> incomplete(listener, now, hint, transfer)
    }
}
machine identified(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64, hint: u64, transfer: u64) -> |main|::Event reaches |kernel|::Kernel {
    transition listener.peer.frame.id > listener.last {
        true -> attachment(gate, listener, now, hint, transfer)
        _ -> (|main|::Event::Failed { code: |kernel|::IO_ERROR })
    }
}
machine attachment(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64, hint: u64, transfer: u64) -> |main|::Event reaches |kernel|::Kernel {
    transition {
        listener.peer.frame.attachment == 0u64 && listener.peer.grant == 0u64 -> accepted(gate, listener)
        listener.peer.frame.attachment == 1u64 && listener.objects -> object(gate, listener, now, hint, transfer)
        _ -> (|main|::Event::Failed { code: |kernel|::IO_ERROR })
    }
}
machine object(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64, hint: u64, transfer: u64) -> |main|::Event reaches |kernel|::Kernel {
    transition listener.peer.grant != 0u64 {
        true -> matched(gate, listener)
        _ -> incomplete(listener, now, hint, transfer)
    }
    machine matched(gate: &|kernel|::Gate, listener: &mut |main|::Server) -> |main|::Event reaches |kernel|::Kernel {
        transition listener.peer.grant_id == listener.peer.frame.id {
            true -> accepted(gate, listener)
            _ -> (|main|::Event::Failed { code: |kernel|::IO_ERROR })
        }
    }
}
machine accepted(gate: &|kernel|::Gate, listener: &mut |main|::Server) -> |main|::Event reaches |kernel|::Kernel {
    listener.last = listener.peer.frame.id;
    listener.pending = listener.last;
    listener.object = listener.peer.grant;
    listener.peer.grant = 0u64;
    listener.peer.grant_kind = 0u64;
    listener.peer.grant_id = 0u64;
    listener.peer.has_frame = false;
    listener.peer.partial = false;
    let status: u64 = |kernel|::Kernel::notify_signal(gate, listener.peer.signal);
    transition status == 0u64 {
        true -> (|main|::Event::Request { frame: listener.peer.frame })
        _ -> (|main|::Event::Failed { code: status })
    }
}
machine incomplete(listener: &mut |main|::Server, now: u64, hint: u64, transfer: u64) -> |main|::Event {
    transition hint > 1u64 || transfer == |kernel|::PEER_CLOSED {
        true -> (|main|::Event::Failed { code: |kernel|::PEER_CLOSED })
        _ -> partial(listener, now)
    }
}
machine partial(listener: &mut |main|::Server, now: u64) -> |main|::Event {
    transition !listener.peer.partial && (listener.peer.has_frame || listener.peer.grant != 0u64) {
        true -> armed(listener, now)
        _ -> (|main|::Event::Pending)
    }
    machine armed(listener: &mut |main|::Server, now: u64) -> |main|::Event {
        listener.peer.partial = true;
        listener.peer.partial_deadline = |time|::after(now, 300u64);
        |main|::Event::Pending
    }
}
