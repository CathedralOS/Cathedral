// One available handshake message per turn. No step waits for its next message.
use kernel.omg;
use connection/main.omg;
use memory/main.omg as memory_main;
use notification/main.omg as notification_main;
use time.omg;
public data Phase [copy] {
    case Open;
    case Reader;
    case Signal;
    case ReaderAck;
    case Commit;
    case Complete;
}
public data Opening { phase: Phase; deadline: u64; }
public machine start(opening: &mut Opening, deadline: u64) {
    opening.phase = Phase::Open;
    opening.deadline = deadline;
}
public machine poll(gate: &|kernel|::Gate, peer: &mut |main|::Peer, opening: &mut Opening, now: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition |time|::reached(now, opening.deadline) {
        true -> (|kernel|::TIMED_OUT)
        _ -> block available(gate, peer, opening, now)
    }
}
machine available(gate: &|kernel|::Gate, peer: &mut |main|::Peer, opening: &mut Opening, now: u64) -> u64 reaches |kernel|::Kernel {
    let mut interests: [u64; 8];
    interests[1] = peer.receiver;
    let status: u64 = block |kernel|::Kernel::wait(gate, &interests, 1u64, now);
    transition {
        status == 0u64 -> block step(gate, peer, opening)
        status == |kernel|::TIMED_OUT -> (|kernel|::WOULD_BLOCK)
        _ -> (status)
    }
}
machine step(gate: &|kernel|::Gate, peer: &mut |main|::Peer, opening: &mut Opening) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block dispatch(gate, peer, opening.phase);
    transition status == 0u64 {
        true -> next(opening)
        _ -> (status)
    }
}
machine dispatch(gate: &|kernel|::Gate, peer: &mut |main|::Peer, phase: Phase) -> u64 reaches |kernel|::Kernel {
    transition phase {
        Phase::Open -> block begin(gate, peer)
        Phase::Reader -> block reader(gate, peer)
        Phase::Signal -> block signal(gate, peer)
        Phase::ReaderAck -> block bell(gate, peer)
        Phase::Commit -> block commit(gate, peer)
        Phase::Complete -> (|kernel|::IO_ERROR)
    }
}
machine next(opening: &mut Opening) -> u64 {
    transition opening.phase {
        Phase::Open -> advance(opening, Phase::Reader)
        Phase::Reader -> advance(opening, Phase::Signal)
        Phase::Signal -> advance(opening, Phase::ReaderAck)
        Phase::ReaderAck -> advance(opening, Phase::Commit)
        Phase::Commit -> complete(opening)
        _ -> (|kernel|::IO_ERROR)
    }
    machine advance(opening: &mut Opening, phase: Phase) -> u64 {
        opening.phase = phase;
        |kernel|::WOULD_BLOCK
    }
    machine complete(opening: &mut Opening) -> u64 {
        opening.phase = Phase::Complete;
        0u64
    }
}
machine begin(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 8];
    let status: u64 = block |kernel|::Kernel::receive(gate, peer.receiver, &mut packet);
    let ordinary: bool = status == 19u64 && packet[0] == 0x6172646568746163u64
        && packet[1] == 0x6465726168732e6cu64 && packet[2] == 0x34762eu64;
    let pipeline: bool = status == 28u64
        && packet[0] == 0x6172646568746163u64
        && packet[1] == 0x6465726168732e6cu64
        && packet[2] == 0x6e696c657069702eu64
        && packet[3] == 0x34762e65u64;
    transition ordinary || (peer.pipeline && pipeline) {
        true -> block accepted(gate, peer, pipeline)
        _ -> (|kernel|::IO_ERROR)
    }
}
machine accepted(gate: &|kernel|::Gate, peer: &mut |main|::Peer, pipeline: bool) -> u64 reaches |kernel|::Kernel {
    peer.pipeline = pipeline;
    block allocate(gate, peer)
}
machine allocate(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
    let result: |memory_main|::Allocation = block |memory_main|::allocate(gate, 1u64);
    transition result {
        |memory_main|::Allocation::Ready { writer } -> allocated(gate, peer, writer)
        |memory_main|::Allocation::Failed { code } -> (code)
    }
    machine allocated(gate: &|kernel|::Gate, peer: &mut |main|::Peer, writer: |memory_main|::Writer) -> u64 reaches |kernel|::Kernel {
        peer.writer = writer;
        let result: |notification_main|::Creation = |notification_main|::create(gate);
        transition result {
            |notification_main|::Creation::Ready { bell } -> acknowledged(gate, peer, bell)
            |notification_main|::Creation::Failed { code } -> (code)
        }
    }
    machine acknowledged(gate: &|kernel|::Gate, peer: &mut |main|::Peer, bell: |notification_main|::Bell) -> u64 reaches |kernel|::Kernel {
        peer.bell = bell;
        acknowledge(gate, peer.sender)
    }
}
machine reader(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
    let result: |memory_main|::Acceptance = block |memory_main|::accept(gate, peer.receiver);
    transition result {
        |memory_main|::Acceptance::Ready { reader } -> retained(gate, peer, reader)
        |memory_main|::Acceptance::Failed { code } -> (code)
    }
    machine retained(gate: &|kernel|::Gate, peer: &mut |main|::Peer, reader: |memory_main|::Reader) -> u64 reaches |kernel|::Kernel {
        peer.reader = reader;
        acknowledge(gate, peer.sender)
    }
}
machine signal(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 10];
    let status: u64 = block |kernel|::Kernel::notify_receive(gate, peer.receiver, &mut packet);
    transition status < |kernel|::ERROR_BASE {
        true -> retained(gate, peer, status, packet)
        _ -> (status)
    }
    machine retained(gate: &|kernel|::Gate, peer: &mut |main|::Peer, status: u64, packet: [u64; 10]) -> u64 reaches |kernel|::Kernel {
        peer.signal = packet[1];
        transition status == 0u64 && packet[0] == 0u64 && packet[1] != 0u64 {
            true -> checked(gate, peer)
            _ -> (|kernel|::IO_ERROR)
        }
    }
    machine checked(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
        let status: u64 = |kernel|::Kernel::notify_signal(gate, peer.signal);
        transition status == 0u64 {
            true -> |memory_main|::delegate(gate, peer.writer.handle, peer.sender)
            _ -> (status)
        }
    }
}
machine bell(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 8];
    let status: u64 = block |kernel|::Kernel::receive(gate, peer.receiver, &mut packet);
    transition status == 15u64 && packet[0] == 0x722e646572616873u64 && packet[1] == 0x34762e79646165u64 {
        true -> delegate(gate, peer)
        _ -> (|kernel|::IO_ERROR)
    }
    machine delegate(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
        let mut packet: [u64; 10];
        packet[1] = peer.bell.signal;
        let status: u64 = |kernel|::Kernel::notify_send(gate, peer.sender, &packet);
        transition status == 0u64 {
            true -> released(gate, peer)
            _ -> (status)
        }
    }
    machine released(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
        let handle: u64 = peer.bell.signal;
        peer.bell.signal = 0u64;
        |kernel|::Kernel::notify_drop(gate, handle)
    }
}
machine commit(gate: &|kernel|::Gate, peer: &mut |main|::Peer) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 8];
    let status: u64 = block |kernel|::Kernel::receive(gate, peer.receiver, &mut packet);
    transition status == 16u64 && packet[0] == 0x632e646572616873u64 && packet[1] == 0x34762e74696d6d6fu64 {
        true -> acknowledge(gate, peer.sender)
        _ -> (|kernel|::IO_ERROR)
    }
}
machine acknowledge(gate: &|kernel|::Gate, sender: u64) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 8];
    packet[0] = 0x722e646572616873u64;
    packet[1] = 0x34762e79646165u64;
    let status: u64 = |kernel|::Kernel::send(gate, sender, &packet, 15u64);
    transition status == 15u64 { true -> (0u64) _ -> (|kernel|::IO_ERROR) }
}
