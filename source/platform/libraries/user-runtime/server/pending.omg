use connection/mailbox.omg;
use server/attachments.omg;
// Do not consume a second request while work on the first one remains outstanding.
use kernel.omg;
use server/main.omg;
public machine check(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition listener.ready && listener.pending != 0u64 {
        true -> block live(gate, listener, now)
        _ -> (|kernel|::BUSY)
    }
}
machine live(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64) -> u64 reaches |kernel|::Kernel {
    let hint: u64 = block |kernel|::Kernel::notify_wait(gate, listener.peer.bell.wait, now, 1u64);
    let mut interests: [u64; 8];
    interests[1] = listener.peer.receiver;
    let status: u64 = block |kernel|::Kernel::wait(gate, &interests, 1u64, now);
    transition {
        hint > 1u64 -> (|kernel|::PEER_CLOSED)
        status == |kernel|::TIMED_OUT -> block mailbox(gate, listener)
        status == 0u64 -> block queued(gate, listener, now)
        _ -> (status)
    }
}
machine mailbox(gate: &|kernel|::Gate, listener: &mut |main|::Server) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |mailbox|::receive(gate, &mut listener.peer);
    transition {
        status == |kernel|::WOULD_BLOCK -> (0u64)
        status == 0u64 -> (|kernel|::IO_ERROR)
        _ -> (status)
    }
}
// Readiness also means endpoint closure. Inspect the typed receive before
// classifying a ready endpoint as an illegal second request.
machine queued(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64) -> u64 reaches |kernel|::Kernel {
    let status: u64 = block |attachments|::receive(gate, listener, now);
    transition status == 0u64 { true -> (|kernel|::IO_ERROR) _ -> (status) }
}
