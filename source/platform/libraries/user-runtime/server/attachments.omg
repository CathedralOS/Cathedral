// Receive only a sealed object. Retain before validation so every error refunds it.
use kernel.omg;
use server/main.omg;
public machine receive(gate: &|kernel|::Gate, listener: &mut |main|::Server, now: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let mut interests: [u64; 8];
    interests[1] = listener.peer.receiver;
    let status: u64 = block |kernel|::Kernel::wait(gate, &interests, 1u64, now);
    transition status == 0u64 {
        true -> block receive_packet(gate, listener)
        _ -> (status)
    }
}
machine receive_packet(gate: &|kernel|::Gate, listener: &mut |main|::Server) -> u64 reaches |kernel|::Kernel {
    let mut packet: [u64; 10];
    let status: u64 = block |kernel|::Kernel::object_receive(gate, listener.peer.receiver, &mut packet);
    transition status < |kernel|::ERROR_BASE {
        true -> block received(gate, listener, status, packet)
        _ -> rejected(status)
    }
}
// A different packet family is not a request payload fallback.
machine rejected(status: u64) -> u64 {
    transition status == |kernel|::TOO_SMALL { true -> (|kernel|::IO_ERROR) _ -> (status) }
}
machine received(gate: &|kernel|::Gate, listener: &mut |main|::Server, status: u64, packet: [u64; 10]) -> u64 reaches |kernel|::Kernel {
    transition listener.peer.grant != 0u64 {
        true -> block duplicate(gate, packet[1])
        _ -> retained(listener, status, packet)
    }
}
machine retained(listener: &mut |main|::Server, status: u64, packet: [u64; 10]) -> u64 {
    listener.peer.grant = packet[1];
    listener.peer.grant_kind = 1u64;
    listener.peer.grant_id = packet[2];
    transition listener.objects && status == 8u64 && packet[0] == 8u64 && packet[1] != 0u64 && packet[2] > listener.last {
        true -> (0u64)
        _ -> (|kernel|::IO_ERROR)
    }
}
machine duplicate(gate: &|kernel|::Gate, object: u64) -> u64 reaches |kernel|::Kernel {
    let ignored: u64 = block |kernel|::Kernel::memory_release(gate, object);
    |kernel|::IO_ERROR
}
