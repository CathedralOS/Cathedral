// Installed control endpoints are separate from the app's service environment.
// Reading their names never creates authority or restores a retired endpoint.
use kernel.omg;
use server/main.omg;

public machine open(gate: &|kernel|::Gate, listener: &mut |main|::Server, deadline: u64) -> u64
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let receiver: u64 = |kernel|::Kernel::bootstrap(gate, 0u64);
    transition receiver < |kernel|::ERROR_BASE {
        true -> block sender(gate, listener, receiver, deadline)
        _ -> (receiver)
    }
    machine sender(gate: &|kernel|::Gate, listener: &mut |main|::Server, receiver: u64, deadline: u64) -> u64 reaches |kernel|::Kernel {
        let sender: u64 = |kernel|::Kernel::bootstrap(gate, 1u64);
        transition sender < |kernel|::ERROR_BASE {
            true -> block |main|::accept(gate, listener, sender, receiver, deadline)
            _ -> failed(gate, receiver, sender)
        }
    }
    machine failed(gate: &|kernel|::Gate, receiver: u64, code: u64) -> u64 reaches |kernel|::Kernel {
        let ignored: u64 = |kernel|::Kernel::close(gate, receiver);
        code
    }
}
