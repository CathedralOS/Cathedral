module admission::pending;
// Submit/observe child construction without parking the provider's service loop.
// main owns bundle allocation, control setup and release; task owns the receipt.
// Pending has no wake right yet: poll once per service turn and arrange a bounded
// timer wake. retirement::poll cancels across turns; drain is its blocking bridge.
use kernel::Gate;
use kernel::Kernel;
use kernel;
use admission::main::Admitted;
use admission::main::prepare_bundle;
use admission::main::finish_admission;
use admission::main::release;
use task::main::Admission;
use admission::retirement::Retirement;

public data Progress [copy] {
    case Pending;
    case Ready;
    case Failed(code: u64);
}

public machine begin(gate: &Gate, child: &mut Admitted, launch: u64, argument: u64,
    loans: &[u64; 14], loan_count: u64 [0..=14], granted: u64) -> u64 reaches Kernel blocks invokes Kernel {
    let status: u64 = block prepare_bundle(gate, child, granted);
    transition status == 0u64 {
        true -> block submit(gate, child, launch, argument, loans, loan_count)
        _ -> (status)
    }
}
machine submit(gate: &Gate, child: &mut Admitted, launch: u64, argument: u64,
    loans: &[u64; 14], loan_count: u64 [0..=14]) -> u64 reaches Kernel {
    let mut endpoints: [u64; 5];
    endpoints[0] = child.handoff[0];
    endpoints[1] = child.handoff[1];
    let receipt: u64 = task::main::begin_spawn(gate, launch, argument, &endpoints, 2u64, loans, loan_count);
    transition receipt != 0u64 && receipt < kernel::ERROR_BASE {
        true -> retain(child, launch, receipt)
        _ -> block failed(gate, child, receipt)
    }
    machine retain(child: &mut Admitted, launch: u64, receipt: u64) -> u64 {
        child.pending = receipt;
        child.launch = launch;
        0u64
    }
    machine failed(gate: &Gate, child: &mut Admitted, code: u64) -> u64 reaches Kernel {
        block release(gate, child);
        code
    }
}

public machine poll(gate: &Gate, child: &mut Admitted, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> Progress
    reaches Kernel blocks invokes Kernel {
    transition child.pending != 0u64 {
        true -> block observe(gate, child, clock, window, objects)
        _ -> (Progress::Failed { code: kernel::INVALID_ARGUMENT })
    }
}
machine observe(gate: &Gate, child: &mut Admitted, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> Progress reaches Kernel {
    let result: Admission = task::main::poll_spawn(gate, child.pending, false);
    transition result {
        Admission::Pending -> (Progress::Pending)
        Admission::Started { ticket } -> block finish(gate, child, ticket, clock, window, objects)
        Admission::Failed { code } -> block failed(gate, child, code)
        Admission::Rejected { code } -> (Progress::Failed { code: code })
    }
    machine finish(gate: &Gate, child: &mut Admitted, ticket: u64, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> Progress reaches Kernel {
        child.pending = 0u64;
        let launch: u64 = child.launch;
        let status: u64 = block finish_admission(gate, child, launch, ticket, clock, window, objects);
        transition status == 0u64 {
            true -> (Progress::Ready)
            _ -> (Progress::Failed { code: status })
        }
    }
    machine failed(gate: &Gate, child: &mut Admitted, code: u64) -> Progress reaches Kernel {
        child.pending = 0u64;
        block release(gate, child);
        Progress::Failed { code: code }
    }
}

// release must drain submitted work before dropping bundle names. If publication
// already won, collect that child as well; never orphan it on a cancellation race.
public machine drain(gate: &Gate, child: &mut Admitted) reaches Kernel blocks invokes Kernel {
    transition child.pending != 0u64 {
        true -> block cancel(gate, child)
        _ -> done()
    }
}
machine cancel(gate: &Gate, child: &mut Admitted) reaches Kernel {
    let result: Retirement = block admission::retirement::wait(gate, child);
}
machine done() {}
