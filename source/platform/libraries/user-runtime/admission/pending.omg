// Submit/observe child construction without parking the provider's service loop.
// main owns bundle allocation, control setup and release; task owns the receipt.
// Pending has no wake right yet: poll once per service turn and arrange a bounded
// timer wake. retirement::poll cancels across turns; drain is its blocking bridge.
use kernel.omg;
use admission/publication.omg;
use admission/main.omg;
use task/main.omg as task_main;
use admission/retirement.omg;

public data Progress [copy] {
    case Pending;
    case Ready;
    case Failed(code: u64);
}

public machine begin(gate: &|kernel|::Gate, child: &mut |main|::Admitted, launch: u64, argument: u64,
    loans: &[u64; 14], loan_count: u64 [0..=14], granted: u64) -> u64 reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let status: u64 = block |main|::prepare_bundle(gate, child, granted);
    transition status == 0u64 {
        true -> block submit(gate, child, launch, argument, loans, loan_count)
        _ -> (status)
    }
}
machine submit(gate: &|kernel|::Gate, child: &mut |main|::Admitted, launch: u64, argument: u64,
    loans: &[u64; 14], loan_count: u64 [0..=14]) -> u64 reaches |kernel|::Kernel {
    let mut endpoints: [u64; 5];
    endpoints[0] = child.handoff[0];
    endpoints[1] = child.handoff[1];
    let receipt: u64 = |task_main|::begin_spawn(gate, launch, argument, &endpoints, 2u64, loans, loan_count);
    transition receipt != 0u64 && receipt < |kernel|::ERROR_BASE {
        true -> retain(child, launch, receipt)
        _ -> block failed(gate, child, receipt)
    }
    machine retain(child: &mut |main|::Admitted, launch: u64, receipt: u64) -> u64 {
        child.pending = receipt;
        child.launch = launch;
        0u64
    }
    machine failed(gate: &|kernel|::Gate, child: &mut |main|::Admitted, code: u64) -> u64 reaches |kernel|::Kernel {
        block |main|::release(gate, child);
        code
    }
}

// Failed can retain a published child or an unconsumed receipt. Retire it across
// turns and release its bundle before reusing this Admitted value.
public machine poll(gate: &|kernel|::Gate, child: &mut |main|::Admitted, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> Progress
    reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition child.pending != 0u64 {
        true -> block observe(gate, child, clock, window, objects)
        _ -> (Progress::Failed { code: |kernel|::INVALID_ARGUMENT })
    }
}
machine observe(gate: &|kernel|::Gate, child: &mut |main|::Admitted, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> Progress reaches |kernel|::Kernel {
    let result: |task_main|::Admission = |task_main|::poll_spawn(gate, child.pending, false);
    transition result {
        |task_main|::Admission::Pending -> (Progress::Pending)
        |task_main|::Admission::Started { ticket } -> published(gate, child, ticket, clock, window, objects)
        |task_main|::Admission::Failed { code } -> block failed(gate, child, code)
        |task_main|::Admission::Rejected { code } -> (Progress::Failed { code: code })
    }
    machine published(gate: &|kernel|::Gate, child: &mut |main|::Admitted, ticket: u64, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> Progress reaches |kernel|::Kernel {
        child.pending = 0u64;
        let launch: u64 = child.launch;
        let status: u64 = |publication|::finish(gate, child, launch, ticket, clock, window, objects);
        transition status == 0u64 {
            true -> (Progress::Ready)
            _ -> (Progress::Failed { code: status })
        }
    }
    machine failed(gate: &|kernel|::Gate, child: &mut |main|::Admitted, code: u64) -> Progress reaches |kernel|::Kernel {
        child.pending = 0u64;
        block |main|::release(gate, child);
        Progress::Failed { code: code }
    }
}

// release must drain submitted work before dropping bundle names. If publication
// already won, collect that child as well; never orphan it on a cancellation race.
public machine drain(gate: &|kernel|::Gate, child: &mut |main|::Admitted) reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    transition child.pending != 0u64 {
        true -> block cancel(gate, child)
        _ -> done()
    }
}
machine cancel(gate: &|kernel|::Gate, child: &mut |main|::Admitted) reaches |kernel|::Kernel {
    let result: |retirement|::Retirement = block |retirement|::wait(gate, child);
}
machine done() {}
