// Install the published task's control and listener. A failure preserves custody:
// the asynchronous caller must collect it; synchronous admission does that itself.
use admission/main.omg;
use kernel.omg;
use ipc/main.omg as ipc_main;
use task/main.omg as task_main;
use server/main.omg as server_main;
use time.omg;

// Publication moved the broker ends. Establish control and start the handshake
// deadline now, after loading, for either admission path.
public machine finish(gate: &|kernel|::Gate, child: &mut |main|::Admitted, launch: u64, ticket: u64, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> u64 reaches |kernel|::Kernel invokes |kernel|::Kernel {
    child.task = ticket;
    child.live = true;
    child.handoff[0] = 0u64;
    child.handoff[1] = 0u64;
    let control: |task_main|::Control = |task_main|::control(gate, launch);
    transition control {
        |task_main|::Control::Ready { channel } -> timed(gate, child, channel, clock, window, objects)
        |task_main|::Control::Failed { code } -> (code)
    }
    machine timed(gate: &|kernel|::Gate, child: &mut |main|::Admitted, control: |ipc_main|::Channel, clock: u64, window: u64 [0..=9223372036854775807], objects: bool) -> u64
        reaches |kernel|::Kernel {
        child.control = control;
        let tick: |time|::Tick = |time|::read(gate, clock);
        transition tick {
            |time|::Tick::Read { value } -> listen(child, |time|::after(value, window), objects)
            |time|::Tick::Failed { code } -> (code)
        }
    }
    machine listen(child: &mut |main|::Admitted, deadline: u64, objects: bool) -> u64 {
        let status: u64 = |server_main|::begin(&mut child.listener, child.data.sender, child.data.receiver, deadline, objects);
        transition status == 0u64 {
            true -> handed(child)
            _ -> (status)
        }
    }
    machine handed(child: &mut |main|::Admitted) -> u64 {
        child.data.sender = 0u64;
        child.data.receiver = 0u64;
        0u64
    }
}
