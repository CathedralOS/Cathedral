// One cancellation/collection visit. The caller retains the entire Admitted
// bundle, stops serving/admitting this slot, and returns to its loop on Pending.
// Ready means no construction or child remains; release may now close the bundle.
// Bundle release still contains blocking memory operations. No clock or yield is
// hidden here, and a rejected observation leaves custody unchanged.
use kernel.omg;
use admission/main.omg;
use task/main.omg as task_main;

public data Outcome [copy] {
    case Empty;
    case Aborted(code: u64);
    case Collected(exit: |task_main|::Exit);
}
public data Retirement [copy] {
    case Pending;
    case Ready(outcome: Outcome);
    case Failed(code: u64);
}
public machine poll(gate: &|kernel|::Gate, child: &mut |main|::Admitted) -> Retirement reaches |kernel|::Kernel invokes |kernel|::Kernel {
    transition {
        child.pending != 0u64 -> construction(gate, child)
        child.live -> stopping(gate, child)
        _ -> (Retirement::Ready { outcome: Outcome::Empty })
    }
}
// Explicit blocking compatibility for callers that have no service loop to
// return to. All custody transitions still belong to the same single visit.
public machine wait(gate: &|kernel|::Gate, child: &mut |main|::Admitted) -> Retirement reaches |kernel|::Kernel blocks invokes |kernel|::Kernel {
    let result: Retirement = poll(gate, child);
    transition result {
        Retirement::Pending -> block later(gate, child)
        _ -> (result)
    }
    machine later(gate: &|kernel|::Gate, child: &mut |main|::Admitted) -> Retirement reaches |kernel|::Kernel {
        let status: u64 = block |kernel|::Kernel::yield_now(gate);
        transition { _ -> block wait(gate, child) }
    }
}
machine construction(gate: &|kernel|::Gate, child: &mut |main|::Admitted) -> Retirement reaches |kernel|::Kernel {
    let result: |task_main|::Admission = |task_main|::poll_spawn(gate, child.pending, true);
    transition result {
        |task_main|::Admission::Pending -> (Retirement::Pending)
        |task_main|::Admission::Rejected { code } -> (Retirement::Failed { code: code })
        |task_main|::Admission::Failed { code } -> aborted(child, code)
        |task_main|::Admission::Started { ticket } -> committed(gate, child, ticket)
    }
    machine aborted(child: &mut |main|::Admitted, code: u64) -> Retirement {
        child.pending = 0u64;
        Retirement::Ready { outcome: Outcome::Aborted { code: code } }
    }
    machine committed(gate: &|kernel|::Gate, child: &mut |main|::Admitted, ticket: u64) -> Retirement reaches |kernel|::Kernel {
        // Publication won. The child owns the moved endpoints even though this
        // caller never opened its control or installed a service listener.
        child.pending = 0u64;
        child.task = ticket;
        child.live = true;
        child.handoff[0] = 0u64;
        child.handoff[1] = 0u64;
        stopping(gate, child)
    }
}
machine stopping(gate: &|kernel|::Gate, child: &mut |main|::Admitted) -> Retirement reaches |kernel|::Kernel {
    let status: u64 = |task_main|::cancel_begin(gate, child.task);
    transition status == 0u64 {
        true -> collecting(gate, child)
        _ -> (Retirement::Failed { code: status })
    }
}
machine collecting(gate: &|kernel|::Gate, child: &mut |main|::Admitted) -> Retirement reaches |kernel|::Kernel {
    let result: |task_main|::Completion = |task_main|::try_wait(gate, child.task);
    transition result {
        |task_main|::Completion::Pending -> (Retirement::Pending)
        |task_main|::Completion::Failed { code } -> (Retirement::Failed { code: code })
        |task_main|::Completion::Ready { outcome } -> collected(child, outcome)
    }
    machine collected(child: &mut |main|::Admitted, outcome: |task_main|::Exit) -> Retirement {
        child.live = false;
        child.task = 0u64;
        Retirement::Ready { outcome: Outcome::Collected { exit: outcome } }
    }
}
