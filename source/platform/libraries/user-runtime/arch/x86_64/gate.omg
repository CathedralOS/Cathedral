// Temporary native realization of the Rust reference kernel ABI. The process
// entry supplies this immutable table from its own executable, not from a peer.
// TableFunction removes the table argument from the native call. No address
// becomes a reference: all buffer arguments are ordinary borrowed arrays.
use {omega}/language/core/external_binding.omg;
use kernel.omg;

linux_x86_64 machine yield_leaf(gate: &|kernel|::Gate) -> u64
    satisfies |kernel|::Kernel::yield_now via |external_binding|::ForeignBinding::TableFunction(yield_now) blocks;
linux_x86_64 machine environment_leaf(gate: &|kernel|::Gate, buffer: &mut [u64; 8]) -> u64
    satisfies |kernel|::Kernel::environment via |external_binding|::ForeignBinding::TableFunction(environment);
linux_x86_64 machine channel_leaf(gate: &|kernel|::Gate, buffer: &mut [u64; 8]) -> u64
    satisfies |kernel|::Kernel::channel via |external_binding|::ForeignBinding::TableFunction(channel);
linux_x86_64 machine send_leaf(gate: &|kernel|::Gate, handle: u64, buffer: &[u64; 8], bytes: u64 [0..=64]) -> u64
    satisfies |kernel|::Kernel::send via |external_binding|::ForeignBinding::TableFunction(send);
linux_x86_64 machine receive_leaf(gate: &|kernel|::Gate, handle: u64, buffer: &mut [u64; 8]) -> u64
    satisfies |kernel|::Kernel::receive via |external_binding|::ForeignBinding::TableFunction(receive) blocks;
linux_x86_64 machine close_leaf(gate: &|kernel|::Gate, handle: u64) -> u64
    satisfies |kernel|::Kernel::close via |external_binding|::ForeignBinding::TableFunction(close);
linux_x86_64 machine write_leaf(gate: &|kernel|::Gate, buffer: &[u64; 8], bytes: u64 [0..=64]) -> u64
    satisfies |kernel|::Kernel::write via |external_binding|::ForeignBinding::TableFunction(write);
linux_x86_64 machine clock_leaf(gate: &|kernel|::Gate) -> u64
    satisfies |kernel|::Kernel::clock via |external_binding|::ForeignBinding::TableFunction(clock);
linux_x86_64 machine clock_stamp_leaf(gate: &|kernel|::Gate, handle: u64, buffer: &mut [u64; 8]) -> u64
