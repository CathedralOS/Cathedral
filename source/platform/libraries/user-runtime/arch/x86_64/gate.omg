linux_x86_64 machine clock_read_leaf(gate: &|kernel|::Gate, handle: u64, buffer: &mut [u64; 8]) -> u64
    satisfies |kernel|::Kernel::clock_read via |external_binding|::ForeignBinding::TableFunction(clock_read);
linux_x86_64 machine wait_leaf(gate: &|kernel|::Gate, records: &[u64; 8], count: u64 [0..=4], deadline: u64) -> u64
    satisfies |kernel|::Kernel::wait via |external_binding|::ForeignBinding::TableFunction(wait) blocks;

