    machine wait_many(gate: &|kernel|::Gate, records: &[u64; 96], count: u64 [0..=48], deadline: u64) -> u64 blocks {
        block Gate::wait_many_leaf(gate, records, count, deadline)
    }
    machine launch_at(gate: &|kernel|::Gate, index: u64) -> u64 {
