// Boot-approved provider links: the owner's composition names them by index
// and the kernel pairs the two sides. Connecting one yields this task's client
// ends; a still-live accepted link answers BUSY until the other side retires.
// This grants no lifecycle or device rights. Wire owner:
// source-rs/platform/libraries/user-runtime/link.rs.
use kernel.omg;
use ipc/main.omg;

public machine at(gate: &|kernel|::Gate, index: u64) -> u64 reaches |kernel|::Kernel invokes |kernel|::Kernel {
    |kernel|::Kernel::link_handle(gate, index)
}
// The client's send end is the returned bootstrap index, its receive end the next.
public machine connect(gate: &|kernel|::Gate, link: u64) -> |main|::Opened reaches |kernel|::Kernel invokes |kernel|::Kernel {
    let first: u64 = |kernel|::Kernel::link_connect(gate, link);
    transition first < |kernel|::ERROR_BASE {
        true -> named(gate, first, first + 1u64)
        _ -> (|main|::Opened::Failed { code: first })
    }
    machine named(gate: &|kernel|::Gate, first: u64, second: u64) -> |main|::Opened reaches |kernel|::Kernel {
        let sender: u64 = |kernel|::Kernel::bootstrap(gate, first);
        let receiver: u64 = |kernel|::Kernel::bootstrap(gate, second);
        transition sender < |kernel|::ERROR_BASE && receiver < |kernel|::ERROR_BASE {
            true -> (|main|::Opened::Ready { channel: |main|::Channel { sender: sender, receiver: receiver } })
            _ -> (|main|::Opened::Failed { code: |kernel|::BAD_HANDLE })
        }
    }
}
