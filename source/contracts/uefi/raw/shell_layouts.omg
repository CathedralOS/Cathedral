// Required UEFI x64 geometry, not an observed Omega layout.
module shell_layouts;
use omega::language::core::layout;

pub data ListEntryX64Layout {}
pub ListEntryX64Policy: ListEntryX64Layout satisfies Layout;
pub machine ListEntryX64Layout::plan(schema: Schema) -> Plan satisfies Layout::plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    Plan { entries: entries, entry_count: 2, size_fixed: 16, size_is_dynamic: false, align: 8 }
}

