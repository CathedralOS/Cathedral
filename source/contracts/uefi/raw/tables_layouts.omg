module tables_layouts;
use omega::language::core::layout;

// PORT-BLOCKED[omega:layout-reflection-capacity]: reflect all 45 BootServices
// semantic members; current Schema.fields has only 32 slots. Keep complete
// named fields and requested placement rather than substitute an array schema.

pub data HeaderX64Layout { }
pub HeaderX64LayoutEvidence: HeaderX64Layout satisfies Layout;

pub machine HeaderX64Layout::plan(schema: Schema) -> Plan satisfies Layout::plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 12 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 16 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 20 } };
    Plan { entries: entries, entry_count: 5, size_fixed: 24, size_is_dynamic: false, align: 8 }
}

