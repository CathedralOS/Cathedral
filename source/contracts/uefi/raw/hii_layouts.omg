// Fixed HII geometry; storage carriers do not establish union semantics.
module hii_layouts;
use omega::language::core::layout;

pub data HiiPackageHeaderX64Layout { }
pub HiiPackageHeaderX64Policy: HiiPackageHeaderX64Layout satisfies Layout;
pub machine HiiPackageHeaderX64Layout::plan(schema: Schema) -> Plan satisfies Layout::plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 1 }
}

