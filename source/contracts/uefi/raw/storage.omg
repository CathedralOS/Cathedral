// Derived from https://github.com/rust-osdev/uefi-rs at
// c0facddf9ba42b74906a37fca2869e6cdbc8da6a; exact source map in storage.PORT.md.
// Modified for Cathedral: Omega raw carriers, inert address slots, explicit
// foreign geometry, named constants, and zero-length tail prefix markers.
// No pointer, protocol GUID, token, or descriptor grants device/firmware access.
module storage;
use scalars::Guid;
use scalars::Char16;
use scalars::Boolean;
use scalars::Event;
use scalars::Handle;
use status::Status;
use time::Time;

// Zero-length arrays preserve the upstream ABI prefix boundary only. Their
// declarations do not provide variable-tail length, bounds, or live access.
// PORT-BLOCKED[omega:variable-tail-layout]: general validated runtime-tail
// placement/projection still needs its specified source form and consumer.

pub data Lba [copy] { raw: u64; }
pub data FileProtocolRevision [copy] { raw: u64; }
pub data FileAttribute [copy] { raw: u64; }
pub data FileMode [copy] { raw: u64; }
pub data AtaPassThruAttributes [copy] { raw: u32; }
pub data AtaPassThruCommandProtocol [copy] { raw: u8; }
pub data AtaPassThruLength [copy] { raw: u8; }
pub data ScsiIoType [copy] { raw: u8; }
pub data ScsiIoDataDirection [copy] { raw: u8; }
pub data ScsiIoHostAdapterStatus [copy] { raw: u8; }
pub data ScsiIoTargetStatus [copy] { raw: u8; }
pub data NvmExpressCommandCdwValidity [copy] { raw: u8; }
pub data NvmExpressPassThruAttributes [copy] { raw: u32; }
pub data NvmExpressQueueType [copy] { raw: u8; }
pub data FvAttributes [copy] { raw: u64; }
pub data FvFileAttributes [copy] { raw: u32; }
pub data FvWritePolicy [copy] { raw: u32; }
pub data FvFiletype [copy] { raw: u8; }
pub data SectionType [copy] { raw: u8; }
pub data CapsuleSupport [copy] { raw: u64; }
pub data FmpDep [copy] { raw: u8; }
pub data ImageAttributes [copy] { raw: u64; }
pub data ImageCompatibilities [copy] { raw: u64; }
pub data ImageUpdatable [copy] { raw: u32; }
pub data PackageAttributes [copy] { raw: u64; }
pub data FirmwareVolumeAttributes [copy] { raw: u32; }

// Upstream uefi-raw/src/protocol/file_system.rs; repr(C).
pub data SimpleFileSystemProtocol {
    revision: u64;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self, root: *mut *mut FileProtocolV1) -> Status
    open_volume: addr;
}

// Upstream uefi-raw/src/protocol/file_system.rs; repr(C).
pub data FileProtocolV1 {
    revision: FileProtocolRevision;
    // Upstream: unsafe extern "efiapi" fn( this: *mut Self, new_handle: *mut *mut Self, file_name: *const Char16, open_mode: FileMode, attributes: FileAttribute, ) -> Status
    open: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self) -> Status
    close: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self) -> Status
    delete: addr;
    // Upstream: unsafe extern "efiapi" fn( this: *mut Self, buffer_size: *mut usize, buffer: *mut c_void, ) -> Status
    read: addr;
    // Upstream: unsafe extern "efiapi" fn( this: *mut Self, buffer_size: *mut usize, buffer: *const c_void, ) -> Status
    write: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *const Self, position: *mut u64) -> Status
    get_position: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self, position: u64) -> Status
    set_position: addr;
    // Upstream: unsafe extern "efiapi" fn( this: *mut Self, information_type: *const Guid, buffer_size: *mut usize, buffer: *mut c_void, ) -> Status
    get_info: addr;
    // Upstream: unsafe extern "efiapi" fn( this: *mut Self, information_type: *const Guid, buffer_size: usize, buffer: *const c_void, ) -> Status
    set_info: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self) -> Status
    flush: addr;
}

// Upstream uefi-raw/src/protocol/file_system.rs; repr(C).
pub data FileProtocolV2 {
    v1: FileProtocolV1;
    // Upstream: unsafe extern "efiapi" fn( this: *mut Self, new_handle: *mut *mut Self, file_name: *const Char16, open_mode: FileMode, attributes: FileAttribute, token: *mut FileIoToken, ) -> Status
    open_ex: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self, token: *mut FileIoToken) -> Status
    read_ex: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self, token: *mut FileIoToken) -> Status
    write_ex: addr;
    // Upstream: unsafe extern "efiapi" fn(this: *mut Self, token: *mut FileIoToken) -> Status
    flush_ex: addr;
}

