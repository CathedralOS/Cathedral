// c0facddf9ba42b74906a37fca2869e6cdbc8da6a, uefi-raw/src/table/{header,system,
// configuration,boot,runtime}.rs and uefi/src/table/cfg.rs.
// Modified for Cathedral: Rust-to-Omega transcription, inert address slots,
// explicit x86-64 layout expectations, and named scalar constants.
// See tables.PORT.md and ../../../../THIRD_PARTY_NOTICES.md.
// No field, GUID, handle, or layout plan grants firmware-call or memory authority.

module tables;

use scalars::Guid;
use scalars::Handle;
use revision::Revision;

// X64 policies live in tables_layouts.omg; declarations alone do not select ABI.
// PORT-BLOCKED[omega:layout-address-carrier]: layout materialization must support
// inert addr fields; current authored Omega UEFI tables substitute u64 carriers.
// tables_layouts.omg records the separate 45-field reflection-capacity blocker.

pub data Header {
    signature: u64;
    revision: Revision;
    size: u32;
    crc: u32;
    reserved: u32;
}


pub data SystemTable {
    header: Header;
    firmware_vendor: addr;
    firmware_revision: u32;
    stdin_handle: Handle;
    stdin: addr;
    stdout_handle: Handle;
    stdout: addr;
    stderr_handle: Handle;
    stderr: addr;
    runtime_services: addr;
    boot_services: addr;
    number_of_configuration_table_entries: u64;
    configuration_table: addr;
}


pub data ConfigurationTable {
    vendor_guid: Guid;
    vendor_table: addr;
}


pub data BootServices {
    header: Header;
    // Upstream signature: unsafe extern "efiapi" fn(new_tpl: Tpl) -> Tpl
    raise_tpl: addr;
    // Upstream signature: unsafe extern "efiapi" fn(old_tpl: Tpl)
    restore_tpl: addr;
    // Upstream signature: unsafe extern "efiapi" fn( alloc_ty: AllocateType, mem_ty: MemoryType, count: usize, addr: *mut PhysicalAddress, ) -> Status
    allocate_pages: addr;
    // Upstream signature: unsafe extern "efiapi" fn(addr: PhysicalAddress, pages: usize) -> Status
    free_pages: addr;
    // Upstream signature: unsafe extern "efiapi" fn( size: *mut usize, map: *mut MemoryDescriptor, key: *mut usize, desc_size: *mut usize, desc_version: *mut u32, ) -> Status
    get_memory_map: addr;
    // Upstream signature: unsafe extern "efiapi" fn( pool_type: MemoryType, size: usize, buffer: *mut *mut u8, ) -> Status
    allocate_pool: addr;
    // Upstream signature: unsafe extern "efiapi" fn(buffer: *mut u8) -> Status
    free_pool: addr;
    // Upstream signature: unsafe extern "efiapi" fn( ty: EventType, notify_tpl: Tpl, notify_func: Option<EventNotifyFn>, notify_ctx: *mut c_void, out_event: *mut Event, ) -> Status
    create_event: addr;
    // Upstream signature: unsafe extern "efiapi" fn(event: Event, ty: TimerDelay, trigger_time: u64) -> Status
    set_timer: addr;
    // Upstream signature: unsafe extern "efiapi" fn( number_of_events: usize, events: *const Event, out_index: *mut usize, ) -> Status
    wait_for_event: addr;
    // Upstream signature: unsafe extern "efiapi" fn(event: Event) -> Status
    signal_event: addr;
    // Upstream signature: unsafe extern "efiapi" fn(event: Event) -> Status
    close_event: addr;
    // Upstream signature: unsafe extern "efiapi" fn(event: Event) -> Status
    check_event: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: *mut Handle, guid: *const Guid, interface_type: InterfaceType, interface: *const c_void, ) -> Status
    install_protocol_interface: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: Handle, protocol: *const Guid, old_interface: *const c_void, new_interface: *const c_void, ) -> Status
    reinstall_protocol_interface: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: Handle, protocol: *const Guid, interface: *const c_void, ) -> Status
    uninstall_protocol_interface: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: Handle, proto: *const Guid, out_proto: *mut *mut c_void, ) -> Status
    handle_protocol: addr;
    // Upstream signature: *mut c_void
    reserved: addr;
    // Upstream signature: unsafe extern "efiapi" fn( protocol: *const Guid, event: Event, registration: *mut *mut c_void, ) -> Status
    register_protocol_notify: addr;
    // Upstream signature: unsafe extern "efiapi" fn( search_ty: i32, proto: *const Guid, key: *const c_void, buf_sz: *mut usize, buf: *mut Handle, ) -> Status
    locate_handle: addr;
    // Upstream signature: unsafe extern "efiapi" fn( proto: *const Guid, device_path: *mut *const DevicePathProtocol, out_handle: *mut Handle, ) -> Status
    locate_device_path: addr;
    // Upstream signature: unsafe extern "efiapi" fn(guid_entry: *const Guid, table_ptr: *const c_void) -> Status
    install_configuration_table: addr;
    // Upstream signature: unsafe extern "efiapi" fn( boot_policy: Boolean, parent_image_handle: Handle, device_path: *const DevicePathProtocol, source_buffer: *const u8, source_size: usize, image_handle: *mut Handle, ) -> Status
    load_image: addr;
    // Upstream signature: unsafe extern "efiapi" fn( image_handle: Handle, exit_data_size: *mut usize, exit_data: *mut *mut Char16, ) -> Status
    start_image: addr;
    // Upstream signature: unsafe extern "efiapi" fn( image_handle: Handle, exit_status: Status, exit_data_size: usize, exit_data: *mut Char16, ) -> Status
    exit: addr;
    // Upstream signature: unsafe extern "efiapi" fn(image_handle: Handle) -> Status
    unload_image: addr;
    // Upstream signature: unsafe extern "efiapi" fn(image_handle: Handle, map_key: usize) -> Status
    exit_boot_services: addr;
    // Upstream signature: unsafe extern "efiapi" fn(count: *mut u64) -> Status
    get_next_monotonic_count: addr;
    // Upstream signature: unsafe extern "efiapi" fn(microseconds: usize) -> Status
    stall: addr;
    // Upstream signature: unsafe extern "efiapi" fn( timeout: usize, watchdog_code: u64, data_size: usize, watchdog_data: *const u16, ) -> Status
    set_watchdog_timer: addr;
    // Upstream signature: unsafe extern "efiapi" fn( controller: Handle, driver_image: *const Handle, remaining_device_path: *const DevicePathProtocol, recursive: Boolean, ) -> Status
    connect_controller: addr;
    // Upstream signature: unsafe extern "efiapi" fn( controller: Handle, driver_image: Handle, child: Handle, ) -> Status
    disconnect_controller: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: Handle, protocol: *const Guid, interface: *mut *mut c_void, agent_handle: Handle, controller_handle: Handle, attributes: u32, ) -> Status
    open_protocol: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: Handle, protocol: *const Guid, agent_handle: Handle, controller_handle: Handle, ) -> Status
    close_protocol: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: Handle, protocol: *const Guid, entry_buffer: *mut *mut OpenProtocolInformationEntry, entry_count: *mut usize, ) -> Status
    open_protocol_information: addr;
    // Upstream signature: unsafe extern "efiapi" fn( handle: Handle, protocol_buffer: *mut *mut *const Guid, protocol_buffer_count: *mut usize, ) -> Status
    protocols_per_handle: addr;
    // Upstream signature: unsafe extern "efiapi" fn( search_ty: i32, proto: *const Guid, key: *const c_void, no_handles: *mut usize, buf: *mut *mut Handle, ) -> Status
    locate_handle_buffer: addr;
    // Upstream signature: unsafe extern "efiapi" fn( proto: *const Guid, registration: *const c_void, out_proto: *mut *mut c_void, ) -> Status
    locate_protocol: addr;
    // Upstream signature: unsafe extern "C" fn(handle: *mut Handle, ...) -> Status
    install_multiple_protocol_interfaces: addr;
    // Upstream signature: unsafe extern "C" fn(handle: Handle, ...) -> Status
    uninstall_multiple_protocol_interfaces: addr;
    // Upstream signature: unsafe extern "efiapi" fn(data: *const c_void, data_size: usize, crc32: *mut u32) -> Status
    calculate_crc32: addr;
    // Upstream signature: unsafe extern "efiapi" fn(dest: *mut u8, src: *const u8, len: usize)
    copy_mem: addr;
    // Upstream signature: unsafe extern "efiapi" fn(buffer: *mut u8, len: usize, value: u8)
    set_mem: addr;
    // Upstream signature: unsafe extern "efiapi" fn( ty: EventType, notify_tpl: Tpl, notify_fn: Option<EventNotifyFn>, notify_ctx: *const c_void, event_group: *const Guid, out_event: *mut Event, ) -> Status
    create_event_ex: addr;
}

