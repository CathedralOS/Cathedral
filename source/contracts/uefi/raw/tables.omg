pub data RuntimeServices {
    header: Header;
    // Upstream signature: unsafe extern "efiapi" fn(time: *mut Time, capabilities: *mut TimeCapabilities) -> Status
    get_time: addr;
    // Upstream signature: unsafe extern "efiapi" fn(time: *const Time) -> Status
    set_time: addr;
    // Upstream signature: unsafe extern "efiapi" fn( enabled: *mut Boolean, pending: *mut Boolean, time: *mut Time, ) -> Status
    get_wakeup_time: addr;
    // Upstream signature: unsafe extern "efiapi" fn(enable: Boolean, time: *const Time) -> Status
    set_wakeup_time: addr;
    // Upstream signature: unsafe extern "efiapi" fn( map_size: usize, desc_size: usize, desc_version: u32, virtual_map: *const MemoryDescriptor, ) -> Status
    set_virtual_address_map: addr;
    // Upstream signature: unsafe extern "efiapi" fn(debug_disposition: usize, address: *mut *mut c_void) -> Status
    convert_pointer: addr;
    // Upstream signature: unsafe extern "efiapi" fn( variable_name: *const Char16, vendor_guid: *const Guid, attributes: *mut VariableAttributes, data_size: *mut usize, data: *mut u8, ) -> Status
    get_variable: addr;
    // Upstream signature: unsafe extern "efiapi" fn( variable_name_size: *mut usize, variable_name: *mut u16, vendor_guid: *mut Guid, ) -> Status
    get_next_variable_name: addr;
    // Upstream signature: unsafe extern "efiapi" fn( variable_name: *const Char16, vendor_guid: *const Guid, attributes: VariableAttributes, data_size: usize, data: *const u8, ) -> Status
    set_variable: addr;
    // Upstream signature: unsafe extern "efiapi" fn(high_count: *mut u32) -> Status
    get_next_high_monotonic_count: addr;
    // Upstream signature: unsafe extern "efiapi" fn( rt: ResetType, status: Status, data_size: usize, data: *const u8, ) -> !
    reset_system: addr;
    // Upstream signature: unsafe extern "efiapi" fn( capsule_header_array: *const *const CapsuleHeader, capsule_count: usize, scatter_gather_list: PhysicalAddress, ) -> Status
    update_capsule: addr;
    // Upstream signature: unsafe extern "efiapi" fn( capsule_header_array: *const *const CapsuleHeader, capsule_count: usize, maximum_capsule_size: *mut u64, reset_type: *mut ResetType, ) -> Status
    query_capsule_capabilities: addr;
    // Upstream signature: unsafe extern "efiapi" fn( attributes: VariableAttributes, maximum_variable_storage_size: *mut u64, remaining_variable_storage_size: *mut u64, maximum_variable_size: *mut u64, ) -> Status
    query_variable_info: addr;
}

