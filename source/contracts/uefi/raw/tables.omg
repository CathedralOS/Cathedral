pub data OpenProtocolInformationEntry {
    agent_handle: Handle;
    controller_handle: Handle;
    attributes: u32;
    open_count: u32;
}


pub data TimeCapabilities {
    resolution: u32;
    accuracy: u32;
    sets_to_zero: u8;
}


pub data PropertiesTable {
    version: u32;
    length: u32;
    memory_protection: MemoryProtectionAttribute;
}


// EventNotifyFn records a callback address only. Upstream signature:
// unsafe extern "efiapi" fn(event: Event, context: *mut c_void).
// Callback registration, context custody, and calling-policy installation belong
// to later admitted boundaries, never to this inert representation.
pub data EventNotifyFn { raw: addr; }

pub data ResetType [copy] { raw: u32; }
pub data VariableAttributes [copy] { raw: u32; }
pub data VariableVendor [copy] { raw: Guid; }
pub data MemoryProtectionAttribute [copy] { raw: u64; }

