// Modified for Cathedral: Rust repr/bitflags become explicit inert data and
// constants; function pointers become address fields, with no invocation right.
// See tcg.PORT.md and ../../../../THIRD_PARTY_NOTICES.md.
module tcg;
use scalars::Guid;

pub data AlgorithmId [copy] { value: u16; }
pub data EventType [copy] { value: u32; }
pub data Tcg2EventLogBitmap [copy] { bits: u32; }
// Upstream Tcg2EventLogFormat is the same carrier as Tcg2EventLogBitmap.
// Use Tcg2EventLogBitmap directly rather than creating a distinct nominal type.
pub data Tcg2HashAlgorithmBitmap [copy] { bits: u32; }
pub data Tcg2HashLogExtendEventFlags [copy] { bits: u64; }

pub data TcgVersion [copy] {
    major: u8;
    minor: u8;
    rev_major: u8;
    rev_minor: u8;
}
pub data TcgBootServiceCapability [copy] {
    size: u8;
    structure_version: TcgVersion;
    protocol_spec_version: TcgVersion;
    hash_algorithm_bitmap: u8;
    tpm_present_flag: u8;
    tpm_deactivated_flag: u8;
}
pub data TcgProtocol [copy] {
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, protocol_capability: *mut TcgBootServiceCapability, feature_flags: *mut u32, event_log_location: *mut PhysicalAddress, event_log_last_entry: *mut PhysicalAddress, ) -> Status
    status_check: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, hash_data: *const u8, hash_data_len: u64, algorithm_id: u32, hashed_data_len: *mut u64, hashed_data_result: *mut *mut u8, ) -> Status
    hash_all: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, event: *const c_void, event_number: *mut u32, flags: u32, ) -> Status
    log_event: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, tpm_input_parameter_block_size: u32, tpm_input_parameter_block: *const u8, tpm_output_parameter_block_size: u32, tpm_output_parameter_block: *mut u8, ) -> Status
    pass_through_to_tpm: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, hash_data: PhysicalAddress, hash_data_len: u64, algorithm_id: u32, event: *mut c_void, event_number: *mut u32, event_log_last_entry: *mut PhysicalAddress, ) -> Status
    hash_log_extend_event: addr;
}

pub data Tcg2Version [copy] {
    major: u8;
    minor: u8;
}
pub data Tcg2BootServiceCapability [copy] {
    size: u8;
    structure_version: Tcg2Version;
    protocol_version: Tcg2Version;
    hash_algorithm_bitmap: Tcg2HashAlgorithmBitmap;
    supported_event_logs: Tcg2EventLogBitmap;
    tpm_present_flag: u8;
    max_command_size: u16;
    max_response_size: u16;
    manufacturer_id: u32;
    number_of_pcr_banks: u32;
    active_pcr_banks: Tcg2HashAlgorithmBitmap;
}
// This semantic record requires PACKED physical offsets 0,4,6,10 (size14,
// align1), not its ordinary compiler-selected record layout. See vectors.
// tcg_layouts::Tcg2EventHeaderX64Layout supplies this fixed geometry.
// Selection/materialization remains separate from source typechecking.
pub data Tcg2EventHeader [copy] {
    header_size: u32;
    header_version: u16;
    pcr_index: u32;
    event_type: EventType;
}
pub data Tcg2Protocol [copy] {
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, protocol_capability: *mut Tcg2BootServiceCapability, ) -> Status
    get_capability: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, event_log_format: Tcg2EventLogFormat, event_log_location: *mut PhysicalAddress, event_log_last_entry: *mut PhysicalAddress, event_log_truncated: *mut Boolean, ) -> Status
    get_event_log: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, flags: Tcg2HashLogExtendEventFlags, data_to_hash: PhysicalAddress, data_to_hash_len: u64, event: *const c_void, ) -> Status
    hash_log_extend_event: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, input_parameter_block_size: u32, input_parameter_block: *const u8, output_parameter_block_size: u32, output_parameter_block: *mut u8, ) -> Status
    submit_command: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, active_pcr_banks: *mut Tcg2HashAlgorithmBitmap, ) -> Status
    get_active_pcr_banks: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, active_pcr_banks: Tcg2HashAlgorithmBitmap, ) -> Status
    set_active_pcr_banks: addr;
    // Upstream signature: unsafe extern "efiapi" fn( this: *mut Self, operation_present: *mut u32, response: *mut u32, ) -> Status
    get_result_of_set_active_pcr_banks: addr;
}

// Stored addresses above are opaque numbers. Establishing callable firmware
// backing, provider admission, output bounds and log lifetime is separate.
// PORT-BLOCKED[omega:named-calling-policy]: native TCG invocation needs the
// exact named Calling<C, Policy> conformance and checked pointer custody;
// raw table data never confers TPM access or attestation authority.

pub const TCG_PROTOCOL_GUID: Guid = Guid {
    data1: 0xf541796d, data2: 0xa62e, data3: 0x4954,
    data4: [0xa7, 0x75, 0x95, 0x84, 0xf6, 0x1b, 0x9c, 0xdd],
};
pub const TCG2_PROTOCOL_GUID: Guid = Guid {
    data1: 0x607f766c, data2: 0x7455, data3: 0x42be,
    data4: [0x93, 0x0b, 0xe4, 0xd7, 0x6d, 0xb2, 0x72, 0x0f],
};

