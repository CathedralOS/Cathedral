// source/contracts/uefi/boot_services.omg
//
// Milestone-2 boot-services ABI: GetMemoryMap → ExitBootServices → the origin of
// memory authority. Transcribed from the UEFI specification (cross-check:
// reference_code/rust-osdev/uefi-rs). FIELD MODEL (Omega extern brief §12,
// decided 2026-07-04): EFI_BOOT_SERVICES is a `data` struct of fn-ptr fields
// (header + services, in spec order); attached external leaves name the FIELD
// to call — no magic slot index, header handled for free, audit reads by name.
//
// Same package as uefi.omg (cathedral_contracts_uefi) → its symbols (EfiStatus,
// EfiHandle, EfiTableHeader) are visible directly, no `use`. PROVISIONAL until
// the Omega agent lands field-model dispatch + the M2 ladder.

// --- EFI_MEMORY_TYPE (the important values) --------------------------------
// Named `const` tags (u32), not a sum — robust to firmware writing memory kinds
// we don't model (a too-narrow EfiMemoryType sum would fail to read them). A
// full typed EfiMemoryType via case discriminants is the alternative if wanted.
pub const EFI_LOADER_DATA:         u32 = 2;
pub const EFI_BOOT_SERVICES_CODE:  u32 = 3;
pub const EFI_BOOT_SERVICES_DATA:  u32 = 4;
pub const EFI_CONVENTIONAL_MEMORY: u32 = 7;   // free RAM boot may claim after exit
pub const EFI_ACPI_RECLAIM:        u32 = 9;

// --- EFI_MEMORY_DESCRIPTOR -------------------------------------------------
// The `Uefi` policy pads `kind` to 8-align `physical_start`. sizeof is 40, BUT
// the map array MUST be strided by the runtime DescriptorSize (firmware may
// append fields) — never sizeof.
pub data EfiMemoryDescriptor {
    kind:            u32;   // EFI_MEMORY_TYPE
    physical_start:  u64;   // EFI_PHYSICAL_ADDRESS
    virtual_start:   u64;   // EFI_VIRTUAL_ADDRESS
    number_of_pages: u64;
    attribute:       u64;
}

// The map key GetMemoryMap returns; ExitBootServices only succeeds against the
// current key (the freshness contract).
pub data MapKey { raw: u64; }   // UINTN

// --- EFI_BOOT_SERVICES table (field model) ---------------------------------
// EFI_TABLE_HEADER then the boot services, in spec order — declared in full so
// the layout policy computes each field's offset and the FFI audit reads by
// NAME. We call get_memory_map (5th) and exit_boot_services (27th).
pub data BootServicesTable {
    hdr:                          EfiTableHeader;
    raise_tpl:                    addr;
    restore_tpl:                  addr;
    allocate_pages:               addr;
    free_pages:                   addr;
    get_memory_map:               addr;   // bound
    allocate_pool:                addr;
    free_pool:                    addr;
    create_event:                 addr;
    set_timer:                    addr;
    wait_for_event:               addr;
    signal_event:                 addr;
    close_event:                  addr;
    check_event:                  addr;
    install_protocol_interface:   addr;
    reinstall_protocol_interface: addr;
    uninstall_protocol_interface: addr;
    handle_protocol:              addr;
    reserved:                     addr;
    register_protocol_notify:     addr;
    locate_handle:                addr;
    locate_device_path:           addr;
    install_configuration_table:  addr;
    load_image:                   addr;
    start_image:                  addr;
    exit:                         addr;
    unload_image:                 addr;
    exit_boot_services:           addr;   // bound
}

pub boundary trait BootServices {
    // GetMemoryMap(IN OUT MemoryMapSize, OUT MemoryMap, OUT MapKey,
    //              OUT DescriptorSize, OUT DescriptorVersion). `map_size` is
    // in/out; `descriptor_size` returns the RUNTIME stride (never sizeof); a
    // too-small buffer returns EFI_BUFFER_TOO_SMALL with the needed size.
    machine get_memory_map(
        table:              &BootServicesTable,
        map_size:           &mut u64,
        // Cathedral preallocates a 64-KiB bootstrap buffer but initially
        // advertises only 16 KiB through map_size. The fixed-array reference
        // supplies the native pointer shape; map_size remains the firmware's
        // actual runtime bound and may be raised only by checked source policy.
        buffer:             &mut [u8; 65536],
        map_key:            &mut MapKey,
        descriptor_size:    &mut u64,
        descriptor_version: &mut u32
    ) -> EfiStatus;

    // ExitBootServices(ImageHandle, MapKey). Succeeds only against the current
    // key; EFI_INVALID_PARAMETER requires obtaining a whole new map/key pair
    // before retry. On success firmware is gone and the map is final.
    machine exit_boot_services(
        table:        &BootServicesTable,
        image_handle: EfiHandle,
        map_key:      MapKey
    ) -> EfiStatus;
}

// Each external leaf is attached to the layout-owning table type and names its
// fn-ptr field; the layout policy supplies the offsets (get_memory_map past the
// 24-byte header + 4 services, exit_boot_services past 26). These are TABLE
// FUNCTIONS, not vtable methods: the table pointer locates the callee and stays
// off the foreign wire. Protocol methods such as output_string do take This and
// use VtableField instead.
uefi_x64 machine BootServicesTable::get_memory_map_leaf(
    table:              &BootServicesTable,
    map_size:           &mut u64,
    buffer:             &mut [u8; 65536],
    map_key:            &mut MapKey,
    descriptor_size:    &mut u64,
    descriptor_version: &mut u32
) -> EfiStatus satisfies BootServices::get_memory_map via Binding::TableFunction(get_memory_map);

uefi_x64 machine BootServicesTable::exit_boot_services_leaf(
    table:        &BootServicesTable,
    image_handle: EfiHandle,
    map_key:      MapKey
) -> EfiStatus satisfies BootServices::exit_boot_services via Binding::TableFunction(exit_boot_services);

// --- Origin of memory authority -------------------------------------------
// FinalMemoryMap is the reserved carrier for the complete post-exit map. The M2
// path currently requires the best span to be nonempty, page-aligned, exactly
// convertible to bytes, and conservatively representable through its one-past
// end. It carries that guarded geometry across a successful exit directly,
// then obtains the first qualified Extent through core/'s admitted provider
// adapter. Every later memory authority descends from that receipt-backed root.
pub data FinalMemoryMap {
    buffer:          &[u8];   // the validated descriptor bytes
    descriptor_size: u64;     // the runtime stride
}
