// source/contracts/uefi/boot_services.omg
//
// Milestone-2 boot-services ABI: GetMemoryMap → ExitBootServices → the origin of
// memory authority. Transcribed from the UEFI specification (cross-check:
// reference_code/rust-osdev/uefi-rs). FIELD MODEL (Omega extern brief §12,
// decided 2026-07-04): EFI_BOOT_SERVICES is a `data` struct of fn-ptr fields
// (header + services, in spec order); attached external leaves name the FIELD
// to call — no magic slot index, header handled for free, audit reads by name.
//
// The sibling UEFI file owns the handle, status and common table header.

use {omega}/language/core/external_binding.omg;
use uefi.omg;
use {memory}/memory_map.omg;

// The map key GetMemoryMap returns; ExitBootServices only succeeds against the
// current key (the freshness contract).
public data MapKey [copy] { raw: u64; }   // UINTN; freshness is a call contract

// --- EFI_BOOT_SERVICES table (field model) ---------------------------------
// EFI_TABLE_HEADER then the boot services in spec order through the last field
// Cathedral currently binds. Keeping the complete consumed prefix lets the
// layout policy compute each offset and the FFI audit read by NAME. We call
// get_memory_map (5th) and exit_boot_services (27th).
public data BootServicesTable {
    hdr:                          |uefi|::EfiTableHeader;
    raise_tpl:                    address;
    restore_tpl:                  address;
    allocate_pages:               address;
    free_pages:                   address;
    get_memory_map:               address;   // bound
    allocate_pool:                address;
    free_pool:                    address;
    create_event:                 address;
    set_timer:                    address;
    wait_for_event:               address;
    signal_event:                 address;
    close_event:                  address;
    check_event:                  address;
    install_protocol_interface:   address;
    reinstall_protocol_interface: address;
    uninstall_protocol_interface: address;
    handle_protocol:              address;
    reserved:                     address;
    register_protocol_notify:     address;
    locate_handle:                address;
    locate_device_path:           address;
    install_configuration_table:  address;
    load_image:                   address;
    start_image:                  address;
    exit:                         address;
    unload_image:                 address;
    exit_boot_services:           address;   // bound
}

// Standard table identity plus the x86-64 prefix through ExitBootServices.
// Cathedral does not read the later EFI_BOOT_SERVICES fields yet, so its
// minimum is the end of the last bound field rather than a claim that this
// provisional source type models the complete revision-specific table.
public const EFI_BOOT_SERVICES_SIGNATURE: u64 = 0x5652_4553_544F_4F42;
public const EFI_BOOT_SERVICES_REQUIRED_SIZE: u32 = 240;

public boundary trait BootServices {
    // GetMemoryMap(IN OUT MemoryMapSize, OUT MemoryMap, OUT MapKey,
    //              OUT DescriptorSize, OUT DescriptorVersion). `map_size` is
    // in/out; `descriptor_size` returns the RUNTIME stride (never sizeof), and
    // `descriptor_version` identifies the descriptor layout revision. The
    // current Cathedral consumer accepts only EFI_MEMORY_DESCRIPTOR_VERSION
    // before interpreting bytes. A too-small buffer returns
    // EFI_BUFFER_TOO_SMALL with the needed size.
    machine get_memory_map(
        table:              &BootServicesTable,
        map_size:           &mut u64,
        // Cathedral preallocates a 64-KiB bootstrap buffer but initially
        // advertises only 16 KiB through map_size. The fixed-array reference
        // supplies the native pointer shape; map_size remains the firmware's
        // actual runtime bound and may be raised only by checked source policy.
        // The boot package supplies this view from explicitly 8-byte-aligned
        // storage; this ABI shape alone asserts no storage authority.
        buffer:             &mut [u8; 65536],
        map_key:            &mut MapKey,
        descriptor_size:    &mut u64,
        descriptor_version: &mut u32
    ) -> |uefi|::EfiStatus
    reaches;

    // ExitBootServices(ImageHandle, MapKey). Succeeds only against the current
    // key; EFI_INVALID_PARAMETER requires obtaining a whole new map/key pair
    // before retry. Cathedral permits one such whole-transaction retry, then
    // fails closed. On success firmware is gone and the map is final.
    machine exit_boot_services(
        table:        &BootServicesTable,
        image_handle: |uefi|::EfiHandle,
        map_key:      MapKey
    ) -> |uefi|::EfiStatus
    reaches;
}

// Each external leaf is attached to the layout-owning table type and names its
// fn-ptr field; the layout policy supplies the offsets (get_memory_map past the
// 24-byte header + 4 services, exit_boot_services past 26). These are TABLE
// FUNCTIONS, not vtable methods: the table pointer locates the callee and stays
// off the foreign wire. Protocol methods such as output_string do take This and
// use VtableField instead.
uefi_x86_64 machine BootServicesTable::get_memory_map_leaf(
    table:              &BootServicesTable,
    map_size:           &mut u64,
    buffer:             &mut [u8; 65536],
    map_key:            &mut MapKey,
    descriptor_size:    &mut u64,
    descriptor_version: &mut u32
) -> |uefi|::EfiStatus satisfies BootServices::get_memory_map via |external_binding|::ForeignBinding::TableFunction(get_memory_map);

uefi_x86_64 machine BootServicesTable::exit_boot_services_leaf(
    table:        &BootServicesTable,
    image_handle: |uefi|::EfiHandle,
    map_key:      MapKey
) -> |uefi|::EfiStatus satisfies BootServices::exit_boot_services via |external_binding|::ForeignBinding::TableFunction(exit_boot_services);

public UefiBootServicesProvider satisfies BootServices {
    machine get_memory_map(
        table: &BootServicesTable,
        map_size: &mut u64,
        buffer: &mut [u8; 65536],
        map_key: &mut MapKey,
        descriptor_size: &mut u64,
        descriptor_version: &mut u32
    ) -> |uefi|::EfiStatus {
        BootServicesTable::get_memory_map_leaf(
            table, map_size, buffer, map_key, descriptor_size, descriptor_version
        )
    }
    machine exit_boot_services(
        table: &BootServicesTable, image_handle: |uefi|::EfiHandle, map_key: MapKey
    ) -> |uefi|::EfiStatus {
        BootServicesTable::exit_boot_services_leaf(table, image_handle, map_key)
    }
}

// --- Origin of memory authority -------------------------------------------
// FinalMemoryMap is the reserved carrier for the complete post-exit map. The M2
// path currently requires the best span to be neither runtime-mapped,
// dynamically removable, nor specific-purpose; it must also be nonempty,
// page-aligned, exactly convertible to bytes, and conservatively representable
// through its one-past end. Before exit, a second pass requires
// every descriptor to have bounded, aligned physical and virtual geometry, and
// every other physical range to lie wholly outside that span. It then carries
// the guarded geometry across a successful exit directly and obtains the first
// qualified Extent through
// core/'s admitted provider adapter. Every later memory authority descends from
// that receipt-backed root.
public data FinalMemoryMap {
    buffer:          &[u8];   // the validated descriptor bytes
    descriptor_size: u64;     // the runtime stride
}
