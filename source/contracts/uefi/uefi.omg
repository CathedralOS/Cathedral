// source/contracts/uefi/uefi.omg
//
// The UEFI x86-64 boot ABI Cathedral targets at hand-off — transcribed from the
// UEFI specification (cross-check: reference_code/rust-osdev/uefi-rs). These are
// FOREIGN structs, so they are plain `data` (firmware structs never cross a
// schema-evolution edge → no identity numbers); their byte layout is supplied by
// the `Uefi` C-ABI layout policy at the use site (Omega programmable_layouts.md).
// Function-pointer protocol calls go through boundary traits whose attached
// external leaves name a fn-ptr FIELD of the table struct — the field model (Omega
// extern_boundary_and_format_domains.md §12, decided 2026-07-04).
//
// Typed firmware declarations are retained as source ABI definitions. Their
// presence does not install a physical entry or establish pointer validity.

use omega::language::core::extent; // ProgramStorageEntry
use omega::language::core::assembly;
use omega::language::core::program_image;
use std::calling;

// --- Scalars (UEFI spec) --------------------------------------------------

// EFI_STATUS is UINTN (pointer-width). On x86-64 that is 64-bit; 0 == success,
// high bit set == error.
public data EfiStatus [copy] { code: u64; }

public const EFI_SUCCESS:           EfiStatus = EfiStatus { code: 0 };
public const EFI_UNSUPPORTED:       EfiStatus = EfiStatus { code: 0x8000_0000_0000_0003 };
public const EFI_INVALID_PARAMETER: EfiStatus = EfiStatus { code: 0x8000_0000_0000_0002 };
public const EFI_BUFFER_TOO_SMALL:  EfiStatus = EfiStatus { code: 0x8000_0000_0000_0005 };

// EFI_HANDLE — an opaque firmware handle. We never dereference it, only hold and
// pass it (a gated token; extern brief §12.2 case 3, opaque).
public data EfiHandle [copy] { raw: addr; }

// The physical UEFI invocation identifies this loaded application, not an
// arbitrary handle whose numerical bits happen to be nonzero. UEFI installs
// LoadedImage on that handle before entry. Copying the handle grants no bytes.
public domain EfiHandle::LoadedApplication(handle)
established by UefiPhysicalEntry::enter;

// --- Simple Text Output protocol (con_out) --------------------------------
//
// An EFI protocol struct embeds its function pointers as inline fields — the
// object IS the vtable. The FIELD MODEL: declare the fn-ptr fields in spec order
// (the `Uefi` policy computes each offset), and the attached external leaf names
// the FIELD to call — no magic slot index. The string argument is a
// null-terminated [u16] (CHAR16*, UCS-2).

public data TextOutputProtocol {
    reset:         addr;   // EFI_TEXT_RESET (unused; present so output_string's offset is right)
    output_string: addr;   // EFI_TEXT_STRING — bound below
    // test_string, query_mode, set_mode, … follow (unread at milestone 1).
}

public boundary trait SimpleTextOutput {
    // Milestone-1's exact null-terminated greeting carrier. A bare slice is
    // deliberately not a native ABI: it leaves pointer/length/terminator
    // choices unstated. This fixed-array reference lowers as the firmware's
    // single CHAR16* parameter without publishing Omega's private slice shape.
    machine output_string(
        console: &TextOutputProtocol,
        string: &[u16; 19]
    ) -> EfiStatus;
}

// The leaf is attached to the layout-owning protocol type. Dispatch reads the
// named field and calls it under the selected UEFI/MS-x64 plan; there is no
// provider table, magic slot index, or import thunk.
uefi_x86_64 machine TextOutputProtocol::output_string_leaf(
    console: &TextOutputProtocol,
    string: &[u16; 19]
) -> EfiStatus satisfies SimpleTextOutput::output_string via ForeignBinding::VtableField(output_string);

// Selection chooses code. The console occurrence remains an explicit borrow,
// not state stored in the provider or a fabricated Binding value.
public UefiTextOutputProvider satisfies SimpleTextOutput {
    machine output_string(console: &TextOutputProtocol, string: &[u16; 19]) -> EfiStatus {
        TextOutputProtocol::output_string_leaf(console, string)
    }
}

// --- The System Table (firmware's root hand-off structure) ----------------
//
// Byte layout = the C ABI (Uefi policy). Only the header and the fields boot
// needs are named; the trailing service pointers are spec-defined and unread at
// milestone 1.

public data EfiTableHeader {
    signature:   u64;
    revision:    u32;
    header_size: u32;
    crc32:       u32;
    reserved:    u32;
}

// Standard table identity plus the complete x86-64 prefix Cathedral reads.
// HeaderSize may grow in a later compatible revision, but it must cover every
// declared EFI_SYSTEM_TABLE field through ConfigurationTable before boot
// projects BootServices from the firmware-vouched reference.
public const EFI_SYSTEM_TABLE_SIGNATURE: u64 = 0x5453_5953_2049_4249;
public const EFI_SYSTEM_TABLE_REQUIRED_SIZE: u32 = 120;
// Cathedral's x86-64 calling profile begins at UEFI 2.0. Later revisions are
// prefix-compatible when HeaderSize covers every consumed field.
public const EFI_MIN_SUPPORTED_REVISION: u32 = 0x0002_0000;

// Every field is listed in spec order — the C-ABI (`Uefi`) policy computes each
// offset from the field before it, so an unread field still has to be present or
// the ones after it land at the wrong offset.
public data EfiSystemTable {
    header:                  EfiTableHeader;
    firmware_vendor:         addr;              // CHAR16*
    firmware_revision:       u32;
    console_in_handle:       EfiHandle;
    con_in:                  addr;              // EFI_SIMPLE_TEXT_INPUT_PROTOCOL*
    console_out_handle:      EfiHandle;
    con_out:                 &TextOutputProtocol;  // milestone 1 dispatches through this
    standard_error_handle:   EfiHandle;
    std_err:                 addr;              // EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL*
    runtime_services:        addr;              // EFI_RUNTIME_SERVICES*
    boot_services:           &BootServicesTable; // milestone 2 dispatches through this (boot_services.omg)
    number_of_table_entries: u64;               // UINTN
    configuration_table:     addr;              // EFI_CONFIGURATION_TABLE*
}

// --- The firmware hand-off and semantic program-storage entry ---------------
//
// The firmware arrival and the kernel's semantic entry are different calls.
// This package owns the concrete firmware table layout, so its physical
// requirement names that exact type rather than recasting an opaque target
// table. Selecting its provider supplies code, not image/storage authority.
public boundary trait UefiPhysicalEntry {
    machine enter(handle: EfiHandle in LoadedApplication, table: &EfiSystemTable) -> EfiStatus
    requires addr::Bound == 18446744073709551616
    reaches SimpleTextOutput + LoadedImageAccess + BootServices + ExtentRootProvider + ProgramStorageEntry + ProgramImage + PortIo + MachineControl
    invokes SimpleTextOutput;
    invokes LoadedImageAccess;
    invokes BootServices;
    invokes ExtentRootProvider;
    invokes ProgramStorageEntry;
    invokes ProgramImage;
}

// One source policy describes both signatures. The compiler checks the exact
// requirement and adapts physical arrival to the selected ordinary callable;
// Cathedral obtains the roots before calling the semantic continuation.
// The policy owns its implementation directly; no attached data or member alias.
public UefiX86_64CallingPolicy satisfies CallingPolicy {
machine plan(
    signature: BoundarySignature
) -> BoundaryPlanResult
{
    transition signature.parameter_count == 2 {
        true -> select_surface(signature)
        _ -> reject()
    }

    state select_surface(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.has_result {
            true -> accept_physical(signature, signature.parameters[0],
                                    signature.parameters[1], signature.result)
            _ -> accept(
            signature,
            signature.parameters[0],
            signature.parameters[1]
        )
        }
    }

    state accept(
        signature: BoundarySignature,
        image: u64,
        initial_storage: u64
    ) -> BoundaryPlanResult {
        transition image < 256 && initial_storage < 256 {
            true -> build(signature, image, initial_storage)
            _ -> reject()
        }
    }

    state build(
        signature: BoundarySignature,
        image: u64,
        initial_storage: u64
    ) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::MicrosoftX64;
        output.call.parameter_count = 2;

        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[image].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[image].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = ValueLocation::Indirect {
            pointer: IndirectPointerLocation::Register {
                register: MachineRegister::X86Rcx,
            },
            has_copy: true,
            copy_stack_byte_offset: 32,
            byte_size: signature.shapes[image].byte_size,
            alignment: signature.shapes[image].alignment,
        };

        output.call.parameters[1].shape.class = AbiValueClass::Integer;
        output.call.parameters[1].shape.byte_size = signature.shapes[initial_storage].byte_size;
        output.call.parameters[1].shape.alignment = signature.shapes[initial_storage].alignment;
        output.call.parameters[1].location_count = 1;
        output.call.parameters[1].locations[0] = ValueLocation::Indirect {
            pointer: IndirectPointerLocation::Register {
                register: MachineRegister::X86Rdx,
            },
            has_copy: true,
            copy_stack_byte_offset: 48,
            byte_size: signature.shapes[initial_storage].byte_size,
            alignment: signature.shapes[initial_storage].alignment,
        };

        output.call.ordinary_clobbers.register_count = 7;
        output.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[4] = MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[5] = MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[6] = MachineRegister::X86R11;
        output.call.stack_alignment = 16;
        output.call.shadow_bytes = 32;
        output.call.entry_control = EntryControl::CallReturn;

        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: output }
    }

    state accept_physical(signature: BoundarySignature, handle: u64,
                          table: u64, status: u64) -> BoundaryPlanResult {
        transition handle < 256 && table < 256 && status < 256 {
            true -> build_physical(signature, handle, table, status)
            _ -> reject()
        }
    }

    state build_physical(signature: BoundarySignature, handle: u64,
                         table: u64, status: u64) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::MicrosoftX64;
        output.call.parameter_count = 2;
        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[handle].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[handle].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rcx,
            value_byte_offset: 0,
            byte_size: signature.shapes[handle].byte_size,
        };
        output.call.parameters[1].shape.class = AbiValueClass::Integer;
        output.call.parameters[1].shape.byte_size = signature.shapes[table].byte_size;
        output.call.parameters[1].shape.alignment = signature.shapes[table].alignment;
        output.call.parameters[1].location_count = 1;
        output.call.parameters[1].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rdx,
            value_byte_offset: 0,
            byte_size: signature.shapes[table].byte_size,
        };
        output.call.has_result = true;
        output.call.result.shape.class = AbiValueClass::Integer;
        output.call.result.shape.byte_size = signature.shapes[status].byte_size;
        output.call.result.shape.alignment = signature.shapes[status].alignment;
        output.call.result.location_count = 1;
        output.call.result.locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rax,
            value_byte_offset: 0,
            byte_size: signature.shapes[status].byte_size,
        };
        output.call.ordinary_clobbers.register_count = 7;
        output.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[4] = MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[5] = MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[6] = MachineRegister::X86R11;
        output.call.stack_alignment = 16;
        output.call.shadow_bytes = 32;
        output.call.entry_control = EntryControl::CallReturn;
        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: output }
    }

    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection {
                reason: "UefiApplication requires its physical arrival or two-root semantic signature",
            },
        }
    }
}
}

public boundary trait UefiApplication:
    ProgramStorageEntry + UefiPhysicalEntry + Calling<UefiX86_64CallingPolicy>
{
}

// The checked target adapter must validate physical firmware arrival and
// provide disjoint image/storage roots before crossing ProgramStorageEntry.
// Cathedral's Main::run is ordinary checked code with explicit context;
// declaring this schema alone neither installs it nor vouches for its inputs.
