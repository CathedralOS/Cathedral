// source/contracts/uefi/uefi.omg
//
// The UEFI x86-64 boot ABI Cathedral targets at hand-off — transcribed from the
// UEFI specification (cross-check: reference_code/rust-osdev/uefi-rs). These are
// FOREIGN structs, so they are plain `data` (firmware structs never cross a
// schema-evolution edge → no identity numbers); their byte layout is supplied by
// the `Uefi` C-ABI layout policy at the use site (Omega programmable_layouts.md).
// Function-pointer protocol calls go through boundary traits bound to a vtable
// slot (Omega extern_boundary_and_format_domains.md §12).
//
// BOOT-VERIFIED SHAPE (aligned to Omega samples/uefi_hello, ea51376cd,
// 2026-07-04 — milestone 1 boots under QEMU/OVMF). Cathedral names the ABI with
// typed wrappers where the single-file sample used raw `addr`; the typed form is
// the target, the sample is the proven-compiling shape.

package cathedral_contracts_uefi

// --- Scalars (UEFI spec) --------------------------------------------------

// EFI_STATUS is UINTN (pointer-width). On x86-64 that is 64-bit; 0 == success,
// high bit set == error.
pub data EfiStatus { code: u64; }

pub EFI_SUCCESS:           EfiStatus = EfiStatus { code: 0 };
pub EFI_INVALID_PARAMETER: EfiStatus = EfiStatus { code: 0x8000_0000_0000_0002 };

// EFI_HANDLE — an opaque firmware handle. We never dereference it, only hold and
// pass it (a gated token; extern brief §12.2 case 3, opaque).
pub data EfiHandle { raw: addr; }

// A pointer to an EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL (con_out).
pub data ConsolePtr { raw: addr; }

// A pointer to the EFI_BOOT_SERVICES table (SystemTable.boot_services).
// Reached at milestone 2 (GetMemoryMap / ExitBootServices — see boot_services.omg).
pub data BootServicesPtr { raw: addr; }

// --- Simple Text Output protocol (con_out) --------------------------------
//
// An EFI protocol struct embeds its function pointers as inline fields (there is
// no separate vtable pointer — the object *is* the vtable). OutputString is
// field index 1 (Reset is 0), so it binds to VtableSlot(1): read the fn pointer
// at that slot of the console object, call it MS-x64. `String` is a
// null-terminated [u16] (CHAR16*, UCS-2).

pub boundary trait SimpleTextOutput {
    machine output_string(console: ConsolePtr, string: &[u16]) -> EfiStatus
        effects device_io;
}

// The provides table binds the protocol call to the embedded function pointer:
// dispatch through the vtable slot (`mov rax, [rcx+8]; call rax`), no import
// thunk. Boot-verified.
uefi_x64 provides SimpleTextOutput {
    output_string -> VtableSlot(1)   // OutputString = field 1 of the protocol struct
}

// --- The System Table (firmware's root hand-off structure) ----------------
//
// Byte layout = the C ABI (Uefi policy). Only the header and the fields boot
// needs are named; the trailing service pointers are spec-defined and unread at
// milestone 1.

pub data EfiTableHeader {
    signature:   u64;
    revision:    u32;
    header_size: u32;
    crc32:       u32;
    reserved:    u32;
}

// Every field is listed in spec order — the C-ABI (`Uefi`) policy computes each
// offset from the field before it, so an unread field still has to be present or
// the ones after it land at the wrong offset.
pub data EfiSystemTable {
    header:                  EfiTableHeader;
    firmware_vendor:         addr;              // CHAR16*
    firmware_revision:       u32;
    console_in_handle:       EfiHandle;
    con_in:                  addr;              // EFI_SIMPLE_TEXT_INPUT_PROTOCOL*
    console_out_handle:      EfiHandle;
    con_out:                 ConsolePtr;        // milestone 1 reads this
    standard_error_handle:   EfiHandle;
    std_err:                 addr;              // EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL*
    runtime_services:        addr;              // EFI_RUNTIME_SERVICES*
    boot_services:           BootServicesPtr;   // milestone 2 reads this
    number_of_table_entries: u64;               // UINTN
    configuration_table:     addr;              // EFI_CONFIGURATION_TABLE*
}

// --- The firmware hand-off: main is an exported callable --------------------
//
// There is NO handoff token, NO entry-provider trait, and NO target block. The
// firmware entry is an EXPORTED CALLABLE — `boundary machine Main::run(&self,
// handle: EfiHandle, table: &EfiSystemTable) -> EfiStatus` in boot/uefi/main.omg
// (option A, boot-verified 2026-07-04). Firmware hands ImageHandle (RCX) and the
// SystemTable pointer (RDX); the parameter list is the boundary-trusted shape
// over those registers, and the boundary VOUCHES TRANSITIVELY for `table`'s
// declared layout — reading `con_out` through it needs no mint (no `validate` on
// the trusted boot path; `validate` remains for bytes code *chooses* to check —
// network, disk — not for the vouched firmware structure).
//
// The build target is set by orthogonal `Build` fields in build.omg
// (`b.freestanding = true`, `b.subsystem = EfiApplication`); the EFI/MS-x64
// calling plan is inferred from the subsystem (calling_plans.md §7). The
// AUDITED AXIOM LIST survives as designed — prose checked against the UEFI spec
// and surfaced by the build artifact next to the exported callable, never typed
// clauses (freestanding_boot_and_hardware_facts.md; the world-facts deflation):
//   axiom: CPU in long mode, paging on, identity-mapped
//   axiom: interrupts enabled; ≥ 128 KiB of 16-aligned stack
//   axiom: the SystemTable pointer is the live EFI system table (the boundary's
//          vouch; transitive through the declared shape).
