// Joint numeric validation before either semantic boot root is introduced.
// This creates no backing authority: firmware provenance, successful exit and
// exclusion of live stack/bootstrap storage remain the boot adapter's duties.
public data BootGeometry [copy] {
    image_base: u64;
    image_length: u64;
    storage_base: u64;
    storage_length: u64;
}

// Match the map walker's representable one-past endpoint policy. Adjacency is
// valid; an empty root, an overflowing endpoint or any overlap is not.
public domain BootGeometry::Separated(geometry)
requires geometry.image_length > 0 && geometry.storage_length > 0 &&
    embed(geometry.image_base) + embed(geometry.image_length) <= 18446744073709551615 &&
    embed(geometry.storage_base) + embed(geometry.storage_length) <= 18446744073709551615 &&
    (embed(geometry.image_base) + embed(geometry.image_length) <= embed(geometry.storage_base) ||
     embed(geometry.storage_base) + embed(geometry.storage_length) <= embed(geometry.image_base));

public data BootGeometryCheck {
    case Rejected;
    case Ready(geometry: BootGeometry in Separated);
}

public machine BootGeometry::check(geometry: BootGeometry) -> BootGeometryCheck {
    transition geometry.image_length > 0 && geometry.storage_length > 0 &&
        geometry.image_base <= 18446744073709551615 - geometry.image_length &&
        geometry.storage_base <= 18446744073709551615 - geometry.storage_length {
        true -> separate(geometry)
        _ -> BootGeometryCheck::Rejected
    }

    state separate(geometry: BootGeometry) -> BootGeometryCheck
    requires geometry.image_length > 0 && geometry.storage_length > 0 &&
        geometry.image_base <= 18446744073709551615 - geometry.image_length &&
        geometry.storage_base <= 18446744073709551615 - geometry.storage_length
    {
        let image_end: u64 = geometry.image_base + geometry.image_length;
        let storage_end: u64 = geometry.storage_base + geometry.storage_length;
        transition image_end <= geometry.storage_base || storage_end <= geometry.image_base {
            true -> BootGeometryCheck::Ready { geometry: geometry }
            _ -> BootGeometryCheck::Rejected
        }
    }
}

// Validate storage against the complete mapped image before excluding the
// retained tail. Checking only the resulting prefix would admit initial
// storage overlapping the live stack or other retained image contents.
// The boundary is numeric input; its provenance is the caller's obligation.
public machine BootGeometry::exclude_image_suffix(mapped: BootGeometry, retained_start: u64) -> BootGeometryCheck {
    let checked: BootGeometryCheck = BootGeometry::check(mapped);
    transition checked {
        BootGeometryCheck::Ready { geometry } -> locate(geometry, retained_start)
        BootGeometryCheck::Rejected -> BootGeometryCheck::Rejected
    }

    state locate(mapped: BootGeometry, retained_start: u64) -> BootGeometryCheck {
        transition retained_start > mapped.image_base {
            true -> partition(mapped, retained_start)
            _ -> BootGeometryCheck::Rejected
        }
    }

    state partition(mapped: BootGeometry, retained_start: u64) -> BootGeometryCheck
    requires retained_start > mapped.image_base
    {
        let prefix: u64 = retained_start - mapped.image_base;
        let residual: BootGeometry = BootGeometry {
            image_base: mapped.image_base,
            image_length: prefix,
            storage_base: mapped.storage_base,
            storage_length: mapped.storage_length,
        };
        transition prefix < mapped.image_length {
            true -> (BootGeometry::check(residual))
            _ -> BootGeometryCheck::Rejected
        }
    }
}
