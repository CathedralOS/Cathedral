// source/core/extent.omg
//
// Extent -- THE FIRST CAPABILITY: exclusive authority over a concrete address
// span. Every later memory authority descends from a qualified Extent rooted
// here at boot, so this is the origin of the authority graph
// (kernel_architecture, capability_lifecycle). Milestone 2 establishes the
// first one after ExitBootServices, from the firmware memory map.
//
// core/ stays firmware-neutral. The boot package supplies ordinary geometry
// discovered from its platform, then crosses Omega's owner-authored
// ExtentRootProvider requirement. This checked adapter is the selected provider
// implementation; the build admission receipt, not a direct call to this
// machine, establishes Extent::Granted on exactly one returned root.

use omega::language::core::extent;

pub const PAGE_SIZE: u64 = 4096;

pub data CathedralExtentRootProvider {}

pub machine CathedralExtentRootProvider::grant_root(root: Extent) -> Extent
satisfies ExtentRootProvider::grant
{
    root
}
