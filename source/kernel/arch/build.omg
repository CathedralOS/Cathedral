// Concrete ISA and board mechanisms. Boot selects the implemented target.
machine build(builder: &mut Build) {
    Build::package(builder, "cathedral_arch");
    Build::depend_as(builder, "std", Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "64a843d84e992cad23222769065e18cdc107e2d6",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
    Build::depend_as(builder, "facts", Source::Path { location: "../../platform/drivers/facts" });
}
