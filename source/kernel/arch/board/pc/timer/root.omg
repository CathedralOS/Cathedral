use {omega}/language/core/assembly.omg;
use board/pc/timer/pic.omg;
use isa/x86_64/interrupts/entry.omg;
use {omega}/language/core/interrupt.omg;

// A timer arrival owes one acknowledgement to its controller. This handler
// transfers that obligation to the PIC completion operation, then returns.
// Recording time and waking ordinary work will extend this bounded body.
public LegacyPicTimerRoot satisfies |entry|::CathedralTimerRoot {
    machine enter(
        acknowledgement: |interrupt|::InterruptAcknowledgement in |interrupt|::Pending
    )
        reaches |assembly|::PortIo
    {
        |pic|::PicTimerAcknowledgement::complete(acknowledgement);
    }
}
