module board::pc::timer::root;

use board::pc::timer::pic::PicTimerAcknowledgement;
use isa::x86_64::interrupts::entry::CathedralTimerRoot;
use omega::language::core::interrupt;

// A timer arrival owes one acknowledgement to its controller. This handler
// transfers that obligation to the PIC completion operation, then returns.
// Recording time and waking ordinary work will extend this bounded body.
public LegacyPicTimerRoot satisfies CathedralTimerRoot {
    machine enter(
        acknowledgement: InterruptAcknowledgement in Pending
    )
        reaches PortIo
    {
        PicTimerAcknowledgement::complete(acknowledgement);
    }
}
