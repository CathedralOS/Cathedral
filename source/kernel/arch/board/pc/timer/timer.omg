module board::pc::timer::timer;

use board::pc::timer::pic::Pic8259;
use board::pc::timer::pit::Pit8254;
use isa::x86_64::interrupts::interrupts::X86EntryStackAssignment;
// Bounded preparation for Cathedral's first QEMU/PC timer provider. This
// composes the checked PIC and PIT leaves while every interrupt input remains
// masked. It neither installs an entry nor admits a live timer occurrence;
// `Pic8259::unmask_timer` stays a separate, later operation ordered after the
// complete exception floor and timer root have been installed.

use facts::pit_8254;
use facts::pic_8259;
use facts::x86_interrupt_stacks;
use facts::x86_idt_gate;

// First-provider policy only. The PC-compatible 1,193,182 Hz PIT input divided
// by 11,932 yields approximately 99.9985 Hz, close to Cathedral's selected
// 100 Hz periodic QEMU/bootstrap rate. Production LAPIC timing remains
// calibrated, tickless, and one-shot.
public const LEGACY_BOOTSTRAP_TIMER_HZ: u32 = 100;
public const LEGACY_BOOTSTRAP_PIT_DIVISOR: u16 = 11_932;
public const LEGACY_BOOTSTRAP_PIT_DIVISOR_LOW: u8 = 0x9C;
public const LEGACY_BOOTSTRAP_PIT_DIVISOR_HIGH: u8 = 0x2E;

// Ordinary policy data for audit/reporting. It grants no PortIo authority and
// cannot program or unmask the device.
public data LegacyPitBootstrapRatePolicy {
    input_hz: u32;
    target_hz: u32;
    divisor: u16;
    divisor_low: u8;
    divisor_high: u8;
}

public machine legacy_pit_bootstrap_rate_policy() -> LegacyPitBootstrapRatePolicy {
    LegacyPitBootstrapRatePolicy {
        input_hz: PIT_INPUT_HZ,
        target_hz: LEGACY_BOOTSTRAP_TIMER_HZ,
        divisor: LEGACY_BOOTSTRAP_PIT_DIVISOR,
        divisor_low: LEGACY_BOOTSTRAP_PIT_DIVISOR_LOW,
        divisor_high: LEGACY_BOOTSTRAP_PIT_DIVISOR_HIGH,
    }
}

// The complete decided route/rate portion of the first timer policy. `entry`
// retains the remapped vector and coupled stack-class/IST assignment while
// `rate` retains the fixed QEMU/bootstrap PIT choice. This is ordinary data:
// it does not claim a gate, root, stack, controller state, acknowledgement,
// installation, or hardware authority.
public data LegacyBootstrapTimerRouteRatePolicy {
    entry: X86EntryStackAssignment;
    rate: LegacyPitBootstrapRatePolicy;
}

public machine legacy_bootstrap_timer_route_rate_policy()
    -> LegacyBootstrapTimerRouteRatePolicy
{
    LegacyBootstrapTimerRouteRatePolicy {
        entry: x86_legacy_timer_entry_stack(),
        rate: legacy_pit_bootstrap_rate_policy(),
    }
}

// Ordinary prepublication data for the complete timer fields Cathedral can
// already decide. The admitted resolver and boot-selected segment source must
// still vouch for `gate.entry` and `gate.selector` before materialization.
public data LegacyBootstrapTimerGatePolicyCandidate {
    route_rate: LegacyBootstrapTimerRouteRatePolicy;
    gate: X86IdtGate;
}

public data LegacyBootstrapTimerGatePolicyCheck {
    case Rejected;
    case PolicyConsistent(candidate: LegacyBootstrapTimerGatePolicyCandidate);
}

public machine legacy_validate_bootstrap_timer_gate_policy(
    candidate: LegacyBootstrapTimerGatePolicyCandidate
) -> LegacyBootstrapTimerGatePolicyCheck {
    let policy: LegacyBootstrapTimerRouteRatePolicy =
        legacy_bootstrap_timer_route_rate_policy();
    transition
        candidate.route_rate.entry.vector == policy.entry.vector &&
        candidate.route_rate.entry.stack.stack_class ==
            policy.entry.stack.stack_class &&
        candidate.route_rate.entry.stack.ist_index ==
            policy.entry.stack.ist_index &&
        candidate.route_rate.rate.input_hz == policy.rate.input_hz &&
        candidate.route_rate.rate.target_hz == policy.rate.target_hz &&
        candidate.route_rate.rate.divisor == policy.rate.divisor &&
        candidate.route_rate.rate.divisor_low == policy.rate.divisor_low &&
        candidate.route_rate.rate.divisor_high == policy.rate.divisor_high
    {
        true -> check_timer_gate_ist(policy, candidate)
        _ -> reject_timer_gate_policy()
    }

    machine check_timer_gate_ist(
        policy: LegacyBootstrapTimerRouteRatePolicy,
        candidate: LegacyBootstrapTimerGatePolicyCandidate
    ) -> LegacyBootstrapTimerGatePolicyCheck {
        transition candidate.gate.ist == policy.entry.stack.ist_index {
            true -> check_timer_gate_attributes(candidate)
            _ -> reject_timer_gate_policy()
        }
    }

    machine check_timer_gate_attributes(
        candidate: LegacyBootstrapTimerGatePolicyCandidate
    ) -> LegacyBootstrapTimerGatePolicyCheck {
        transition candidate.gate.type_attributes ==
            PRESENT_RING0_INTERRUPT_GATE {
            true -> check_timer_gate_reserved(candidate)
            _ -> reject_timer_gate_policy()
        }
    }

    machine check_timer_gate_reserved(
        candidate: LegacyBootstrapTimerGatePolicyCandidate
    ) -> LegacyBootstrapTimerGatePolicyCheck {
        transition candidate.gate.reserved == RESERVED_ZERO {
            true -> accept_timer_gate_policy(candidate)
            _ -> reject_timer_gate_policy()
        }
    }

    machine accept_timer_gate_policy(
        candidate: LegacyBootstrapTimerGatePolicyCandidate
    ) -> LegacyBootstrapTimerGatePolicyCheck {
        LegacyBootstrapTimerGatePolicyCheck::PolicyConsistent {
            candidate: candidate,
        }
    }

    machine reject_timer_gate_policy() -> LegacyBootstrapTimerGatePolicyCheck {
        LegacyBootstrapTimerGatePolicyCheck::Rejected
    }
}

public data LegacyPicPitTimerProvider {
    pic: Pic8259;
    pit: Pit8254;
}

// Establish the legacy controllers' safe pre-installation state in one
// checked transaction: first remap the PIC while masking every input, then
// program PIT channel 0 with Cathedral's fixed bootstrap divisor. IRQ0 remains
// masked on return.
public machine LegacyPicPitTimerProvider::prepare_masked(
    provider: &mut LegacyPicPitTimerProvider
)
reaches PortIo
{
    Pic8259::remap_masked(&mut provider.pic);
    Pit8254::program_channel0_rate_generator(
        &mut provider.pit,
        LEGACY_BOOTSTRAP_PIT_DIVISOR_LOW,
        LEGACY_BOOTSTRAP_PIT_DIVISOR_HIGH
    );
}

// The remapped legacy timer is the first member of the shared maskable-IRQ
// class. Later PIC/APIC roots cite the same class while owning distinct vector
// assignments.
public machine x86_legacy_timer_entry_stack() -> X86EntryStackAssignment {
    X86EntryStackAssignment {
        vector: PROTECTED_MASTER_VECTOR_BASE,
        stack: X86_MASKABLE_IRQ_STACK,
    }
}
