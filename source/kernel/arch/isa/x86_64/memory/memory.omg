use isa/x86_64/memory/validation/entries.omg;
use isa/x86_64/memory/validation/geometry.omg;
use isa/x86_64/memory/validation/walk.omg;
use {omega}/language/core/extent.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/access/access.omg;
use {facts}/x86_page_table_entry.omg;

// Inactive table construction owns actual RAM, not detached candidate images.
// One conserved allocation holds four consecutive pages; each field has one
// Stable array permission. The target remains borrowed from its existing owner.
// Nothing here installs translations or permits accessing the proposed virtual
// address. Activation must transfer table custody to a hardware-aware provider:
// CPU page walks cannot coexist with this exclusive Stable mutation contract.
public data InactivePageTables {
    pml4: [u64; 512];
    pdpt: [u64; 512];
    pd: [u64; 512];
    pt: [u64; 512];
}
public data InactivePageTablePlacement {}
public data PageTableBuilder {}

public data PreparedPageTables {
    case Ready(storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<InactivePageTablePlacement, InactivePageTables>);
    case Rejected(storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant);
}

public data PageTableReservation {
    padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    tables: PreparedPageTables;
    tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    verified: bool;
}

machine InactivePageTablePlacement::plan(schema: |layout|::Schema) -> |layout|::AccessPlan {
    let mut entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
    entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 4096 } };
    entries[2] = |layout|::FieldEntry { key: schema.fields[2].key, representation: |layout|::FieldPlan::At { offset: 8192 } };
    entries[3] = |layout|::FieldEntry { key: schema.fields[3].key, representation: |layout|::FieldPlan::At { offset: 12288 } };
    let layout: |layout|::LayoutPlan = |layout|::LayoutPlan { entries: entries, entry_count: 4, size_fixed: 16384, size_is_dynamic: false, align: 4096 };
    let first: |layout|::AccessPlan = |layout|::AccessPlan::with(|layout|::AccessPlan::inaccessible(layout), schema.fields[0].key,
        |layout|::FieldAccess::Stable { read: true, write: true, exposure: |layout|::Exposure::Exported });
    let second: |layout|::AccessPlan = |layout|::AccessPlan::with(first, schema.fields[1].key,
        |layout|::FieldAccess::Stable { read: true, write: true, exposure: |layout|::Exposure::Exported });
    let third: |layout|::AccessPlan = |layout|::AccessPlan::with(second, schema.fields[2].key,
        |layout|::FieldAccess::Stable { read: true, write: true, exposure: |layout|::Exposure::Exported });
    let services: [u64; 32];
    |layout|::AccessPlan::with_reach(
        |layout|::AccessPlan::with(third, schema.fields[3].key,
            |layout|::FieldAccess::Stable { read: true, write: true, exposure: |layout|::Exposure::Exported }),
        |layout|::BoundaryReach { services: services, service_count: 0 }
    )
}

public machine PageTableBuilder::prepare<Role>(
    storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant, target: &|extent|::Extent in |extent|::Granted, virtual_address: u64
) -> PageTableReservation
requires storage.length >= 20479 && address::Bound == 18446744073709551616
reaches |layout|::ResourceProfileSupply
invokes |layout|::ResourceProfileSupply
{
    let padding_length: u64 = (4096 - (storage.base as u64) % 4096) % 4096;
    let prefix: |extent|::VacantExtentParts = |extent|::split_vacant_extent(storage, padding_length);
    let parts: |extent|::VacantExtentParts = |extent|::split_vacant_extent(prefix.rest, 16384);
    let base: u64 = parts.taken.base as u64;
    let target_base: u64 = target.base as u64;
    transition base <= 4503599627354112 && target_base <= 4503599627366400 &&
        target_base % 4096 == 0 && target.length == 4096 {
        true -> decompose(prefix.taken, parts.taken, parts.rest, base, target_base, virtual_address)
        _ -> rejected(prefix.taken, parts.taken, parts.rest)
    }

    machine decompose(padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant, storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                    tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, base: u64, target: u64, virtual_address: u64)
        -> PageTableReservation
    requires base <= 4503599627354112 && target <= 4503599627366400
    {
        transition |geometry|::x86_decompose_bootstrap_virtual_address(virtual_address) {
            |geometry|::X86BootstrapVirtualAddressCheck::Canonical { indices } -> initialize(padding, storage, tail, base, target, indices)
            _ -> rejected(padding, storage, tail)
        }
    }

    machine initialize(padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant, storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                     tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, base: u64, target: u64,
                     indices: |geometry|::X86BootstrapVirtualAddressIndices) -> PageTableReservation
    requires base <= 4503599627354112 && target <= 4503599627366400
    {
        let words: [u64; 512];
        transition |layout|::NativeAccess<InactivePageTablePlacement, InactivePageTables, Role>::initialize(
            storage, InactivePageTables { pml4: words, pdpt: words, pd: words, pt: words }
        ) {
            |layout|::AccessOutcome::Ready { view } -> populate(padding, view, tail, base, target, indices)
            |layout|::AccessOutcome::Rejected { returned, reason } -> rejected(padding, returned.source, tail)
        }
    }

    machine populate(padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                   storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<InactivePageTablePlacement, InactivePageTables>,
                   tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, base: u64, target: u64,
                   indices: |geometry|::X86BootstrapVirtualAddressIndices) -> PageTableReservation
    requires base <= 4503599627354112 && target <= 4503599627366400
    {
        let mut retained: |extent|::Extent in |extent|::Granted & |extent|::Resident<InactivePageTablePlacement, InactivePageTables> = storage;
        let verified: bool = PageTableBuilder::populate(
            |access|::view_resident_mut<InactivePageTablePlacement, InactivePageTables>(&mut retained),
            base, target, indices
        );
        PageTableReservation {
            padding: padding, tables: PreparedPageTables::Ready { storage: retained },
            tail: tail, verified: verified,
        }
    }

    machine rejected(padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant, storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                   tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant) -> PageTableReservation {
        PageTableReservation {
            padding: padding, tables: PreparedPageTables::Rejected { storage: storage },
            tail: tail, verified: false,
        }
    }
}

machine PageTableBuilder::entry(target: u64, no_execute: bool) -> u64 {
    let entry: |x86_page_table_entry|::X86PageTableEntry = |x86_page_table_entry|::X86PageTableEntry {
        present: true, writable: true, user: false, write_through: false,
        cache_disable: false, accessed: false, dirty: false, page_size_or_pat: false,
        global: false, software_low: 0, frame_number: (target >> 12) & 1099511627775,
        software_high: 0, protection_key: 0, no_execute: no_execute,
    };
    |x86_page_table_entry|::x86_encode_page_table_entry(&entry)
}

machine PageTableBuilder::step(base: u64, index: u64, word: u64)
    -> |walk|::X86BootstrapPageTableWalkStep
requires 0 <= index && index <= 511 {
    let entry: |x86_page_table_entry|::X86PageTableEntry = |x86_page_table_entry|::x86_decode_page_table_entry(word);
    |walk|::X86BootstrapPageTableWalkStep {
        table_address: base, index: index, entry_address: base | (index * 8),
        entry: |entries|::X86BootstrapAddressBoundPageTableEntryCandidate {
            physical_address: entry.frame_number << 12, entry: entry,
        },
    }
}

machine PageTableBuilder::populate(view: &mut |layout|::Access<InactivePageTablePlacement, InactivePageTables>,
                                  base: u64, target: u64, indices: |geometry|::X86BootstrapVirtualAddressIndices) -> bool
requires base <= 4503599627354112 && target <= 4503599627366400
{
    |layout|::write(&mut view.pml4[indices.pml4_index], PageTableBuilder::entry(base + 4096, false));
    |layout|::write(&mut view.pdpt[indices.pdpt_index], PageTableBuilder::entry(base + 8192, false));
    |layout|::write(&mut view.pd[indices.pd_index], PageTableBuilder::entry(base + 12288, false));
    |layout|::write(&mut view.pt[indices.pt_index], PageTableBuilder::entry(target, true));
    let pml4: u64 = |layout|::read(&view.pml4[indices.pml4_index]);
    let pdpt: u64 = |layout|::read(&view.pdpt[indices.pdpt_index]);
    let pd: u64 = |layout|::read(&view.pd[indices.pd_index]);
    let pt: u64 = |layout|::read(&view.pt[indices.pt_index]);
    let empty: bool = PageTableBuilder::check_unused(view, &indices, 0);
    let candidate: |walk|::X86BootstrapFourKilobyteWalkEndpoints = |walk|::X86BootstrapFourKilobyteWalkEndpoints {
        virtual_page_address: indices.address, physical_frame_address: target,
        descriptor: |walk|::X86BootstrapFourLevelWalkDescriptor {
            pml4: PageTableBuilder::step(base, indices.pml4_index, pml4),
            pdpt: PageTableBuilder::step(base + 4096, indices.pdpt_index, pdpt),
            pd: PageTableBuilder::step(base + 8192, indices.pd_index, pd),
            pt: PageTableBuilder::step(base + 12288, indices.pt_index, pt),
            indices: indices,
        },
    };
    let matching: bool = pml4 == PageTableBuilder::entry(base + 4096, false) &&
        pdpt == PageTableBuilder::entry(base + 8192, false) && pd == PageTableBuilder::entry(base + 12288, false) &&
        pt == PageTableBuilder::entry(target, true);
    transition |walk|::x86_validate_bootstrap_four_kilobyte_walk_endpoints(candidate) {
        |walk|::X86BootstrapFourKilobyteWalkEndpointCheck::EndpointConsistent { candidate } -> (matching && empty)
        _ -> false
    }
}

// Read the actual resident pages, not the pre-placement zero initializer.
// Checking every unused slot also detects overlap between field placements.
machine PageTableBuilder::check_unused(view: &|layout|::Access<InactivePageTablePlacement, InactivePageTables>,
                                      indices: &|geometry|::X86BootstrapVirtualAddressIndices, index: u64) -> bool
requires index <= 512
{
    transition index < 512 { true -> inspect(view, indices, index) _ -> true }
    machine inspect(view: &|layout|::Access<InactivePageTablePlacement, InactivePageTables>,
                  indices: &|geometry|::X86BootstrapVirtualAddressIndices, index: u64) -> bool
    requires index < 512
    {
        let pml4: u64 = |layout|::read(&view.pml4[index]);
        let pdpt: u64 = |layout|::read(&view.pdpt[index]);
        let pd: u64 = |layout|::read(&view.pd[index]);
        let pt: u64 = |layout|::read(&view.pt[index]);
        transition (index == indices.pml4_index || pml4 == 0) &&
            (index == indices.pdpt_index || pdpt == 0) &&
            (index == indices.pd_index || pd == 0) && (index == indices.pt_index || pt == 0) {
            true -> next(view, indices, index + 1)
            _ -> false
        }
    }
    machine next(view: &|layout|::Access<InactivePageTablePlacement, InactivePageTables>,
               indices: &|geometry|::X86BootstrapVirtualAddressIndices, index: u64) -> bool
    requires index <= 512
    {
        transition index < 512 { true -> inspect(view, indices, index) _ -> true }
    }
}
