module isa::x86_64::memory::validation::entries;

use isa::x86_64::memory::validation::geometry::X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS;
use isa::x86_64::memory::validation::geometry::X86_PAGE_OFFSET_MASK;
use facts::x86_page_table_entry;

// Every non-address bit of one detached paging entry. Cathedral does not assign
// role semantics here: in particular, `page_size_or_pat` remains the hardware
// fact's role-dependent field, and the caller supplies every policy value.
public data X86BootstrapPageTableEntryNonAddressFields {
    present: bool;
    writable: bool;
    user: bool;
    write_through: bool;
    cache_disable: bool;
    accessed: bool;
    dirty: bool;
    page_size_or_pat: bool;
    global: bool;
    software_low: u8 [0..=7];
    software_high: u8 [0..=127];
    protection_key: u8 [0..=15];
    no_execute: bool;
}

// Ordinary detached encoding candidate. Retaining the numeric source address
// prevents the derived PFN from becoming a free-standing address claim.
public data X86BootstrapAddressBoundPageTableEntryCandidate {
    physical_address: u64;
    entry: X86PageTableEntry;
}

public data X86BootstrapAddressBoundPageTableEntryCheck {
    case Rejected;
    case Composed(candidate: X86BootstrapAddressBoundPageTableEntryCandidate);
}

// Bind bits 12..51 to one aligned address while copying every other PTE field
// explicitly. This establishes numeric consistency only. It does not validate
// a leaf/link role, select page size or hierarchy policy, prove a frame or
// backing exists, establish a mapping, or authorize placement/installation.
public machine x86_compose_bootstrap_address_bound_page_table_entry(
    physical_address: u64,
    fields: X86BootstrapPageTableEntryNonAddressFields
) -> X86BootstrapAddressBoundPageTableEntryCheck {
    let page_offset: u64 [0..=4095] = physical_address & X86_PAGE_OFFSET_MASK;
    transition page_offset == 0 &&
        physical_address <= X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS {
        true -> compose_address_bound_page_table_entry(physical_address, fields)
        _ -> reject_address_bound_page_table_entry()
    }

    state compose_address_bound_page_table_entry(
        physical_address: u64,
        fields: X86BootstrapPageTableEntryNonAddressFields
    ) -> X86BootstrapAddressBoundPageTableEntryCheck {
        let frame_number: u64 [0..=1099511627775] =
            (physical_address >> X86_PAGE_SHIFT) & X86_PAGE_FRAME_NUMBER_MAX;
        X86BootstrapAddressBoundPageTableEntryCheck::Composed {
            candidate: X86BootstrapAddressBoundPageTableEntryCandidate {
                physical_address: physical_address,
                entry: X86PageTableEntry {
                    present: fields.present,
                    writable: fields.writable,
                    user: fields.user,
                    write_through: fields.write_through,
                    cache_disable: fields.cache_disable,
                    accessed: fields.accessed,
                    dirty: fields.dirty,
                    page_size_or_pat: fields.page_size_or_pat,
                    global: fields.global,
                    software_low: fields.software_low,
                    frame_number: frame_number,
                    software_high: fields.software_high,
                    protection_key: fields.protection_key,
                    no_execute: fields.no_execute,
                },
            },
        }
    }

    state reject_address_bound_page_table_entry()
        -> X86BootstrapAddressBoundPageTableEntryCheck
    {
        X86BootstrapAddressBoundPageTableEntryCheck::Rejected
    }
}

// Revalidate a retained detached candidate before later role-specific policy
// consumes it. The address must still be aligned and inside the selected
// physical envelope, and the entry's PFN must be exactly derived from it. All
// non-address fields remain uninterpreted ordinary data.
public machine x86_validate_bootstrap_address_bound_page_table_entry(
    candidate: X86BootstrapAddressBoundPageTableEntryCandidate
) -> X86BootstrapAddressBoundPageTableEntryCheck {
    let page_offset: u64 [0..=4095] =
        candidate.physical_address & X86_PAGE_OFFSET_MASK;
    transition page_offset == 0 &&
        candidate.physical_address <= X86_MAX_ALIGNED_PHYSICAL_FRAME_ADDRESS {
        true -> check_address_bound_frame_number(candidate)
        _ -> reject_retained_address_bound_page_table_entry()
    }

    state check_address_bound_frame_number(
        candidate: X86BootstrapAddressBoundPageTableEntryCandidate
    ) -> X86BootstrapAddressBoundPageTableEntryCheck {
        let frame_number: u64 [0..=1099511627775] =
            (candidate.physical_address >> X86_PAGE_SHIFT) &
            X86_PAGE_FRAME_NUMBER_MAX;
        transition candidate.entry.frame_number == frame_number {
            true -> accept_retained_address_bound_page_table_entry(candidate)
            _ -> reject_retained_address_bound_page_table_entry()
        }
    }

    state accept_retained_address_bound_page_table_entry(
        candidate: X86BootstrapAddressBoundPageTableEntryCandidate
    ) -> X86BootstrapAddressBoundPageTableEntryCheck {
        X86BootstrapAddressBoundPageTableEntryCheck::Composed {
            candidate: candidate,
        }
    }

    state reject_retained_address_bound_page_table_entry()
        -> X86BootstrapAddressBoundPageTableEntryCheck
    {
        X86BootstrapAddressBoundPageTableEntryCheck::Rejected
    }
}
