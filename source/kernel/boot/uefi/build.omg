// The target's physical ABI selects Cathedral's source-owned adapter. The
// ProgramEntry slot independently names the two-root semantic continuation.

machine build(builder: &mut Build) {
    Build::application(builder, "cathedral");
    // Reach: the boot hand-off ABI + the kernel's checked Extent provider.
    // The boot package may name `uefi` and `core` and nothing else.
    Build::depend_as(builder, "uefi", Source::Path { location: "../../../contracts/uefi" });
    Build::depend_as(builder, "core", Source::Path { location: "../../core" });
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, core::CathedralExtentRootProvider>(builder);
    Build::select_provider<uefi::SimpleTextOutput, uefi::UefiTextOutputProvider>(builder);
    Build::select_provider<uefi::BootServices, uefi::UefiBootServicesProvider>(builder);
    Build::select_provider<uefi::UefiPhysicalEntry, CathedralBootstrap>(builder);
    Build::bind(builder, uefi_x86_64::ProgramEntry, Kernel::enter);

    builder.subsystem    = Subsystem::EfiApplication;   // import-free PE32+ firmware loads directly
    builder.freestanding = true;                         // empty host-provider set (no host runtime)
}
