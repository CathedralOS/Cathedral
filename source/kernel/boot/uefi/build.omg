// The target's physical ABI selects Cathedral's source-owned adapter. The
// ProgramEntry slot independently names the two-root semantic continuation.

machine build(builder: &mut Build) {
    Build::application(builder, "cathedral");
    // Reach: the boot hand-off ABI + the kernel's checked Extent provider.
    // Allocation policy is the ordinary checked alloc package.
    Build::depend_as(builder, "uefi", Source::Path { location: "../../../contracts/uefi" });
    Build::depend_as(builder, "memory", Source::Path { location: "../../../contracts/uefi/memory" });
    Build::depend_as(builder, "core", Source::Path { location: "../../core" });
    Build::depend_as(builder, "arch", Source::Path { location: "../../arch" });
    Build::depend_as(builder, "memory_map", Source::Path { location: "memory_map" });
    Build::depend_as(builder, "alloc", Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "849161c59ff74176dafc3f8de5ff66148581de22",
        selection: PackageSelection::Named { package: "alloc" }
    });
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, core::memory::extent::CathedralExtentRootProvider>(builder);
    Build::accept_boundary<VacantContentTransfer>(builder);
    Build::select_provider<VacantContentTransfer, BootVacantStorageProvider>(builder);
    Build::accept_boundary<BootMemorySupply>(builder);
    Build::accept_boundary<FirmwareMemorySupply>(builder);
    Build::select_provider<BootMemorySupply, BootMemoryProfileProvider>(builder);
    Build::select_provider<FirmwareMemorySupply, FirmwareMemoryProfileProvider>(builder);
    Build::accept_boundary<HardwareTableSupply>(builder);
    Build::select_provider<HardwareTableSupply, HardwareTableProfileProvider>(builder);
    Build::accept_boundary<MappedRegionSupply>(builder);
    Build::select_provider<MappedRegionSupply, MappedRegionProfileProvider>(builder);
    Build::accept_boundary<BootVirtualReservation>(builder);
    Build::select_provider<BootVirtualReservation, BootstrapVirtualReservationProvider>(builder);
    Build::accept_boundary<BootTranslation>(builder);
    Build::select_provider<BootTranslation, BootstrapTranslationProvider>(builder);
    Build::select_provider<PlacementLifecycle, KernelMemoryPlacement>(builder);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder);
    Build::select_provider<uefi::SimpleTextOutput, uefi::UefiTextOutputProvider>(builder);
    Build::select_provider<uefi::BootServices, uefi::UefiBootServicesProvider>(builder);
    Build::select_provider<uefi::LoadedImageAccess, uefi::UefiLoadedImageProvider>(builder);
    Build::select_provider<uefi::UefiPhysicalEntry, CathedralBootstrap>(builder);
    Build::bind(builder, uefi_x86_64::ProgramEntry, Kernel::enter);

    builder.subsystem    = Subsystem::EfiApplication;   // import-free PE32+ firmware loads directly
    builder.freestanding = true;                         // empty host-provider set (no host runtime)
}
