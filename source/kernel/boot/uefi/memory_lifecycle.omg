use omega::language::core::extent;
use omega::language::core::layout;

public data KernelWord { value: u64; }
public data KernelWordPlacement {}
data KernelMemory {}

// Build selects a closed implementation declaration. This map fixes the
// kernel's policy/schema pair; the library owns the actual memory operations.
KernelMemoryPlacement satisfies PlacementLifecycle<KernelWordPlacement, KernelWord> {
    machine initialize(
        storage: Extent in Granted & Vacant,
        value: KernelWord
    ) -> PlacementOutcome<
        Extent in Granted & Resident<KernelWordPlacement, KernelWord>,
        PlacementReturn<Extent in Granted & Vacant, KernelWord>,
        PlacementInitializationFailure
    >
    reaches ResourceProfileSupply
    {
        NativePlacement<KernelWordPlacement, KernelWord>::initialize(storage, value)
    }

    machine move_out(
        storage: Extent in Granted & Resident<KernelWordPlacement, KernelWord>
    ) -> PlacementExtraction<Extent in Granted & Vacant, KernelWord>
    reaches ResourceProfileSupply
    {
        NativePlacement<KernelWordPlacement, KernelWord>::move_out(storage)
    }
}

machine KernelWordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(&schema), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan {
            entries: entries, entry_count: 1, size_fixed: 8,
            size_is_dynamic: false, align: 8,
        },
        access: access,
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

data KernelMemoryObservation {
    initial: u64;
    updated: u64;
}

data KernelMemoryResult {
    storage: Extent in Granted & Vacant;
    initialized: bool;
    initial: u64;
    updated: u64;
    extracted: u64;
}

// The input is the real retained firmware allocation, never an address-created
// substitute. Ready must encode the value before lending its resident storage;
// rejection returns the original vacant allocation and unconsumed value.
// Neither branch drops the allocation's unused tail.
machine KernelMemory::exercise(storage: Extent in Granted & Vacant) -> KernelMemoryResult
reaches ResourceProfileSupply + PlacementLifecycle
{
    transition Placed::initialize_owned<KernelWordPlacement, KernelWord>(
        storage, KernelWord { value: 17 }
    ) {
        PlacementOutcome::Ready { view } -> use_resident(view)
        PlacementOutcome::Rejected { returned, reason } -> rejected(returned)
    }

    state use_resident(
        storage: Extent in Granted & Resident<KernelWordPlacement, KernelWord>
    ) -> KernelMemoryResult {
        let mut active: Extent in Granted & Resident<KernelWordPlacement, KernelWord> = storage;
        let observation: KernelMemoryObservation = KernelMemory::overwrite(
            Placed::view_resident_mut<KernelWordPlacement, KernelWord>(&mut active), 29
        );
        let returned: PlacementReturn<Extent in Granted & Vacant, KernelWord> =
            Placed::move_out_owned<KernelWordPlacement, KernelWord>(active);
        KernelMemoryResult {
            storage: returned.source, initialized: true,
            initial: observation.initial, updated: observation.updated,
            extracted: returned.custody.value,
        }
    }

    state rejected(
        returned: PlacementReturn<Extent in Granted & Vacant, KernelWord>
    ) -> KernelMemoryResult {
        KernelMemoryResult {
            storage: returned.source, initialized: false,
            initial: 0, updated: 0, extracted: returned.custody.value,
        }
    }
}

// Exercise empty, interior and exhausted partitions on the real allocation
// before accessing it. Reconstructed geometry must retain the original backing
// through checked common-root ancestry, not through a fresh provider grant.
machine KernelMemory::reunite_partition(
    storage: Extent in Granted & Vacant, requested: u64
) -> Extent
requires requested <= storage.length
ensures result in Granted & Vacant,
        result.base == storage.base,
        result.length == storage.length,
        Granted::content(old(&storage)) == Granted::content(&result),
        Vacant::content(old(&storage)) == Vacant::content(&result)
{
    let parts: VacantExtentParts = split_vacant_extent(storage, requested);
    let { base as prefix_base, length as prefix_length } = parts.taken;
    let { base as remainder_base, length as remainder_length } = parts.rest;
    Extent { base: prefix_base, length: prefix_length + remainder_length }
}

// Keep the mutation across a helper boundary. The view ends before whole-value
// extraction; ending this loan alone cannot turn resident content into vacancy.
machine KernelMemory::overwrite(
    view: &mut Placed<KernelWordPlacement, KernelWord>, replacement: u64
) -> KernelMemoryObservation {
    let initial: u64 = placed_read(&view.value);
    placed_write(&mut view.value, replacement);
    let updated: u64 = placed_read(&view.value);
    KernelMemoryObservation { initial: initial, updated: updated }
}

// Preserve all three descendants, including rejected initialization paths.
// This boot witness does not merge independently received formal roots: the
// allocator's modular return/reset contract is a separate owner decision.
data KernelMemoryPair {
    first: Extent in Granted & Vacant;
    second: Extent in Granted & Vacant;
    tail: Extent in Granted & Vacant;
    verified: bool;
}

// The caller retains the tail variable while each brief borrow returns one
// independently owned child. No provider call or numeric address creates it.
machine KernelMemory::carve(
    tail: &mut Extent in Granted & Vacant, available: u64, requested: u64
) -> Extent in Granted & Vacant
requires available == tail.length && requested <= available
ensures result.length == requested, tail.length == available - requested
{
    let previous: Extent in Granted & Vacant = tail;
    let parts: VacantExtentParts = split_vacant_extent(previous, requested);
    tail = parts.rest;
    parts.taken
}

// Initialize two disjoint children concurrently, mutate each through the same
// ordinary placement path, and read the first again after mutating the second.
// A wrong alias, lost borrow restoration or native address calculation cannot
// pass merely by returning the requested scalar lengths.
machine KernelMemory::exercise_pair(storage: Extent in Granted & Vacant) -> KernelMemoryPair
requires storage.length >= 16
reaches ResourceProfileSupply + PlacementLifecycle
{
    let available: u64 = storage.length;
    let mut tail: Extent in Granted & Vacant = storage;
    let first: Extent in Granted & Vacant = KernelMemory::carve(&mut tail, available, 8);
    let second: Extent in Granted & Vacant = KernelMemory::carve(&mut tail, available - 8, 8);
    transition Placed::initialize_owned<KernelWordPlacement, KernelWord>(
        first, KernelWord { value: 17 }
    ) {
        PlacementOutcome::Ready { view } -> initialize_second(view, second, tail)
        PlacementOutcome::Rejected { returned, reason } -> KernelMemoryPair {
            first: returned.source, second: second, tail: tail, verified: false,
        }
    }

    state initialize_second(
        first: Extent in Granted & Resident<KernelWordPlacement, KernelWord>,
        second: Extent in Granted & Vacant, tail: Extent in Granted & Vacant
    ) -> KernelMemoryPair {
        transition Placed::initialize_owned<KernelWordPlacement, KernelWord>(
            second, KernelWord { value: 41 }
        ) {
            PlacementOutcome::Ready { view } -> observe(first, view, tail)
            PlacementOutcome::Rejected { returned, reason } -> reject_second(first, returned, tail)
        }
    }

    state reject_second(
        first: Extent in Granted & Resident<KernelWordPlacement, KernelWord>,
        second: PlacementReturn<Extent in Granted & Vacant, KernelWord>,
        tail: Extent in Granted & Vacant
    ) -> KernelMemoryPair {
        let returned: PlacementReturn<Extent in Granted & Vacant, KernelWord> =
            Placed::move_out_owned<KernelWordPlacement, KernelWord>(first);
        KernelMemoryPair {
            first: returned.source, second: second.source, tail: tail, verified: false,
        }
    }

    state observe(
        first: Extent in Granted & Resident<KernelWordPlacement, KernelWord>,
        second: Extent in Granted & Resident<KernelWordPlacement, KernelWord>,
        tail: Extent in Granted & Vacant
    ) -> KernelMemoryPair {
        let mut first_active: Extent in Granted & Resident<KernelWordPlacement, KernelWord> = first;
        let mut second_active: Extent in Granted & Resident<KernelWordPlacement, KernelWord> = second;
        let first_observation: KernelMemoryObservation = KernelMemory::overwrite(
            Placed::view_resident_mut<KernelWordPlacement, KernelWord>(&mut first_active), 29
        );
        let second_observation: KernelMemoryObservation = KernelMemory::overwrite(
            Placed::view_resident_mut<KernelWordPlacement, KernelWord>(&mut second_active), 73
        );
        let first_after_second: u64 = KernelMemory::read(
            Placed::view_resident_mut<KernelWordPlacement, KernelWord>(&mut first_active)
        );
        let first_returned: PlacementReturn<Extent in Granted & Vacant, KernelWord> =
            Placed::move_out_owned<KernelWordPlacement, KernelWord>(first_active);
        let second_returned: PlacementReturn<Extent in Granted & Vacant, KernelWord> =
            Placed::move_out_owned<KernelWordPlacement, KernelWord>(second_active);
        let verified: bool = first_observation.initial == 17 && first_observation.updated == 29 &&
            second_observation.initial == 41 && second_observation.updated == 73 &&
            first_after_second == 29 && first_returned.custody.value == 29 &&
            second_returned.custody.value == 73;
        KernelMemoryPair {
            first: first_returned.source, second: second_returned.source,
            tail: tail, verified: verified,
        }
    }
}

machine KernelMemory::read(view: &mut Placed<KernelWordPlacement, KernelWord>) -> u64 {
    placed_read(&view.value)
}
