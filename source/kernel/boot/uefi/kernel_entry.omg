use omega::language::core::extent;
use omega::language::core::assembly;

data KernelState {
    entered: bool;
    image_bytes: u64;
    initial_storage_bytes: u64;
}

// This selected provider belongs to the boot transaction, not to the allocator.
// Its admitted premise is that the initial root is the fresh ConventionalMemory
// range selected from the final map after successful ExitBootServices. It has
// no established Omega resident, and the image/private stack are disjoint.
// This does not zero memory or establish a Stable access profile. Ordinary
// direct calls to this adapter cannot introduce Vacant. Admission covers this
// closed boot artifact's initial-storage call, not arbitrary Granted inputs;
// selecting this provider never justifies a future call on occupied storage.
BootVacantStorageProvider satisfies VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
    ensures result in Granted,
            Granted::content(old(&storage)) == Granted::content(&result)
    {
        storage
    }
}

// The semantic entry is independent of the firmware ABI. A valid installed
// caller must transfer both roots; declaring or taking the address of this
// machine does not mint them. Reporting happens only after the selected bridge
// has transferred both roots, and idle retains both claims for the OS lifetime.
machine Kernel::enter(context: &mut KernelState, image: Extent in Granted,
                      initial_storage: Extent in Granted)
reaches PortIo + MachineControl + VacantContentTransfer
invokes VacantContentTransfer;
{
    // The installed occurrence receives fresh zero state, not firmware data or
    // a globally addressable record. Keep its borrow with the retained roots.
    transition !context.entered && context.image_bytes == 0 && context.initial_storage_bytes == 0 {
        true -> establish(context, image, initial_storage)
        _ -> retain(context, image, initial_storage)
    }

    state establish(context: &mut KernelState, image: Extent in Granted,
                    initial_storage: Extent in Granted) {
        context.image_bytes = image.length;
        context.initial_storage_bytes = initial_storage.length;
        context.entered = true;
        transition { _ -> announce(context, image, initial_storage, 1000000) }
    }

    // Drain the preceding ownership report before one 16-byte FIFO burst.
    // A missing UART suppresses diagnostics, never ownership or kernel entry.
    state announce(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted,
                   remaining: u64) {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> report(context, image, initial_storage)
            _ -> wait(context, image, initial_storage, remaining)
        }
    }

    state wait(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted,
               remaining: u64) {
        transition remaining > 1 {
            true -> announce(context, image, initial_storage, remaining - 1)
            _ -> retain(context, image, initial_storage)
        }
    }

    state report(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted) {
        asm { out 1016, 75 }   // K
        asm { out 1016, 101 }  // e
        asm { out 1016, 114 }  // r
        asm { out 1016, 110 }  // n
        asm { out 1016, 101 }  // e
        asm { out 1016, 108 }  // l
        asm { out 1016, 32 }
        asm { out 1016, 101 }  // e
        asm { out 1016, 110 }  // n
        asm { out 1016, 116 }  // t
        asm { out 1016, 101 }  // e
        asm { out 1016, 114 }  // r
        asm { out 1016, 101 }  // e
        asm { out 1016, 100 }  // d
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        let vacant: Extent in Granted & Vacant = VacantContentTransfer::transfer(initial_storage);
        transition vacant.length >= 4096 {
            true -> reserve(context, image, vacant)
            _ -> retain_vacant(context, image, vacant)
        }
    }

    state reserve(context: &mut KernelState, image: Extent in Granted,
                  storage: Extent in Granted & Vacant)
    requires storage.length >= 4096
    {
        let parts: VacantExtentParts = split_vacant_extent(storage, 4096);
        // Observe the actual returned geometry before announcing success. The
        // comparison grants no custody; the checked split already conserved
        // Granted and Vacant independently. Both children stay owned below.
        transition parts.taken.length == 4096 &&
                   parts.rest.length <= context.initial_storage_bytes &&
                   context.initial_storage_bytes - parts.rest.length == 4096 {
            true -> memory_wait(context, image, parts, 1000000)
            _ -> retain_parts(context, image, parts)
        }
    }

    state memory_wait(context: &mut KernelState, image: Extent in Granted,
                      parts: VacantExtentParts, remaining: u64) {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> memory_report(context, image, parts)
            _ -> memory_retry(context, image, parts, remaining)
        }
    }

    state memory_retry(context: &mut KernelState, image: Extent in Granted,
                       parts: VacantExtentParts, remaining: u64) {
        transition remaining > 1 {
            true -> memory_wait(context, image, parts, remaining - 1)
            _ -> retain_parts(context, image, parts)
        }
    }

    state memory_report(context: &mut KernelState, image: Extent in Granted,
                        parts: VacantExtentParts) {
        asm { out 1016, 77 }  // M
        asm { out 1016, 101 } // e
        asm { out 1016, 109 } // m
        asm { out 1016, 111 } // o
        asm { out 1016, 114 } // r
        asm { out 1016, 121 } // y
        asm { out 1016, 32 }
        asm { out 1016, 115 } // s
        asm { out 1016, 112 } // p
        asm { out 1016, 108 } // l
        asm { out 1016, 105 } // i
        asm { out 1016, 116 } // t
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> retain_parts(context, image, parts) }
    }

    state retain_parts(context: &mut KernelState, image: Extent in Granted,
                       parts: VacantExtentParts) {
        asm { hlt }
        transition { _ -> retain_parts(context, image, parts) }
    }

    state retain_vacant(context: &mut KernelState, image: Extent in Granted,
                        storage: Extent in Granted & Vacant) {
        asm { hlt }
        transition { _ -> retain_vacant(context, image, storage) }
    }

    state retain(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted) {
        asm { hlt }
        transition { _ -> retain(context, image, initial_storage) }
    }
}
