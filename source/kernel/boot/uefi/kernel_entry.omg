use arch::isa::x86_64::memory::memory::PageTableBuilder;
use arch::isa::x86_64::memory::memory::PageTableReservation;
use arch::isa::x86_64::memory::profile::BootstrapPaging;
use arch::isa::x86_64::memory::profile::BootstrapPagingProfile;
use core::memory::geometry::BootGeometry;
use omega::language::core::extent;
use omega::language::core::assembly;
use omega::language::core::layout;
use memory_lifecycle;
use page_frame;
use boot_handoff;
use memory_map::firmware_root;
use boot_memory;
use paging_handoff;
use firmware_tables;
use mapping_exercise;
use mapping_activation;
use mapping_region;

data KernelState {
    entered: bool;
    image_bytes: u64;
    initial_storage_bytes: u64;
    initial_storage_base: u64;
    firmware_root: u64;
    boot_information: BootInformation;
}

data Kernel {}

// The privileged observer belongs to this boot composition. The shared core
// predicate consumes only a sample and grants no machine or mapping authority.
uefi_x86_64 machine Kernel::observe_paging() -> BootstrapPagingProfile
reaches MachineControl
{
    let mut control0: u64 = 0;
    let mut control4: u64 = 0;
    let mut extended_features: u64 = 0;
    let extended_feature_register: u32 = 3221225600;
    asm { read_cr0 control0 }
    asm { read_cr4 control4 }
    asm { rdmsr extended_features, extended_feature_register }
    BootstrapPagingProfile {
        control0: control0, control4: control4, extended_features: extended_features,
    }
}

// This selected provider belongs to the boot transaction, not to the allocator.
// Its admitted premise is that the initial root is the fresh ConventionalMemory
// range selected from the final map after successful ExitBootServices. It has
// no established Omega resident, and the image/private stack are disjoint.
// This does not zero memory or establish a Stable access profile. Ordinary
// direct calls to this adapter cannot introduce Vacant. Admission covers this
// closed boot artifact's initial-storage call, not arbitrary Granted inputs;
// selecting this provider never justifies a future call on occupied storage.
BootVacantStorageProvider satisfies VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
    ensures result in Granted,
            Granted::content(old(&storage)) == Granted::content(&result)
    {
        storage
    }
}

// The semantic entry is independent of the firmware ABI. A valid installed
// caller must transfer both roots; declaring or taking the address of this
// machine does not mint them. Reporting happens only after the selected bridge
// has transferred both roots, and idle retains both claims for the OS lifetime.
machine Kernel::enter(context: &mut KernelState, image: Extent in Granted,
                      initial_storage: Extent in Granted)
requires addr::Bound == 18446744073709551616
reaches PortIo + MachineControl + VacantContentTransfer + ResourceProfileSupply + PlacementLifecycle + ExtentRootProvider + BootVirtualReservation + BootTranslation
invokes ExtentRootProvider;
invokes VacantContentTransfer;
invokes ResourceProfileSupply;
invokes PlacementLifecycle;
invokes BootVirtualReservation;
invokes BootTranslation;
crashes Abort
{
    // The installed occurrence receives fresh zero state, not firmware data or
    // a globally addressable record. Keep its borrow with the retained roots.
    transition !context.entered && context.image_bytes == 0 && context.initial_storage_bytes == 0 &&
        context.initial_storage_base == 0 && context.firmware_root == 0 {
        true -> establish(context, image, initial_storage)
        _ -> retain(context, image, initial_storage)
    }

    state establish(context: &mut KernelState, image: Extent in Granted,
                    initial_storage: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        let copied: bool = BootHandoff::receive(&initial_storage, &mut context.boot_information);
        transition copied {
            true -> check_handoff(context, image, initial_storage)
            _ -> retain(context, image, initial_storage)
        }
    }

    state check_handoff(context: &mut KernelState, image: Extent in Granted,
                        initial_storage: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        // Packet geometry must describe the same image partition the entry
        // already owns. These comparisons supply no additional grant.
        transition context.boot_information.image_base == image.base as u64 &&
                   context.boot_information.retained_start >= context.boot_information.image_base &&
                   context.boot_information.retained_start - context.boot_information.image_base == image.length &&
                   context.boot_information.image_size >= image.length {
            true -> accept_handoff(context, image, initial_storage)
            _ -> retain(context, image, initial_storage)
        }
    }

    state accept_handoff(context: &mut KernelState, image: Extent in Granted,
                         initial_storage: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        context.image_bytes = image.length;
        context.initial_storage_bytes = initial_storage.length;
        context.initial_storage_base = initial_storage.base as u64;
        context.entered = true;
        // The complete final map is now ordinary invocation-owned context.
        // The temporary external packet contains no Omega resident and can be
        // overwritten by the subsequent vacant-storage allocator.
        transition { _ -> handoff_wait(context, image, initial_storage, 1000000) }
    }

    state handoff_wait(context: &mut KernelState, image: Extent in Granted,
                       initial_storage: Extent in Granted, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> handoff_report(context, image, initial_storage)
            _ -> handoff_retry(context, image, initial_storage, remaining)
        }
    }

    state handoff_retry(context: &mut KernelState, image: Extent in Granted,
                        initial_storage: Extent in Granted, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> handoff_wait(context, image, initial_storage, remaining - 1)
            _ -> retain(context, image, initial_storage)
        }
    }

    state handoff_report(context: &mut KernelState, image: Extent in Granted,
                         initial_storage: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 66 } // Boot map ready
        asm { out 1016, 111 }
        asm { out 1016, 111 }
        asm { out 1016, 116 }
        asm { out 1016, 32 }
        asm { out 1016, 109 }
        asm { out 1016, 97 }
        asm { out 1016, 112 }
        asm { out 1016, 32 }
        asm { out 1016, 114 }
        asm { out 1016, 101 }
        asm { out 1016, 97 }
        asm { out 1016, 100 }
        asm { out 1016, 121 }
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> announce(context, image, initial_storage, 1000000) }
    }

    // Drain the preceding ownership report before one 16-byte FIFO burst.
    // A missing UART suppresses diagnostics, never ownership or kernel entry.
    state announce(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted,
                   remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> report(context, image, initial_storage)
            _ -> wait(context, image, initial_storage, remaining)
        }
    }

    state wait(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted,
               remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> announce(context, image, initial_storage, remaining - 1)
            _ -> retain(context, image, initial_storage)
        }
    }

    state report(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 75 }   // K
        asm { out 1016, 101 }  // e
        asm { out 1016, 114 }  // r
        asm { out 1016, 110 }  // n
        asm { out 1016, 101 }  // e
        asm { out 1016, 108 }  // l
        asm { out 1016, 32 }
        asm { out 1016, 101 }  // e
        asm { out 1016, 110 }  // n
        asm { out 1016, 116 }  // t
        asm { out 1016, 101 }  // e
        asm { out 1016, 114 }  // r
        asm { out 1016, 101 }  // e
        asm { out 1016, 100 }  // d
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        let vacant: Extent in Granted & Vacant = VacantContentTransfer::transfer(initial_storage);
        transition vacant.length >= 4096 {
            true -> reserve(context, image, vacant)
            _ -> retain_vacant(context, image, vacant)
        }
    }

    state reserve(context: &mut KernelState, image: Extent in Granted,
                  storage: Extent in Granted & Vacant)
    requires addr::Bound == 18446744073709551616 && storage.length >= 4096
    {
        let parts: VacantExtentParts = split_vacant_extent(storage, 4096);
        let profile: ResourceProfile = ResourceProfileSupply<BootMemory>::profile(
            (&parts.taken) as &Extent in Granted
        );
        // Observe the actual returned geometry before announcing success. The
        // comparison grants no custody; the checked split already conserved
        // Granted and Vacant independently. Both children stay owned below.
        transition profile.region_count == 1 &&
                   profile.regions[0].range.length == parts.taken.length &&
                   parts.taken.length == 4096 &&
                   parts.rest.length <= context.initial_storage_bytes &&
                   context.initial_storage_bytes - parts.rest.length == 4096 {
            true -> memory_wait(context, image, parts, 1000000)
            _ -> retain_parts(context, image, parts)
        }
    }

    state memory_wait(context: &mut KernelState, image: Extent in Granted,
                      parts: VacantExtentParts, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> memory_report(context, image, parts)
            _ -> memory_retry(context, image, parts, remaining)
        }
    }

    state memory_retry(context: &mut KernelState, image: Extent in Granted,
                       parts: VacantExtentParts, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> memory_wait(context, image, parts, remaining - 1)
            _ -> retain_parts(context, image, parts)
        }
    }

    state memory_report(context: &mut KernelState, image: Extent in Granted,
                        parts: VacantExtentParts)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 77 }  // M
        asm { out 1016, 101 } // e
        asm { out 1016, 109 } // m
        asm { out 1016, 111 } // o
        asm { out 1016, 114 } // r
        asm { out 1016, 121 } // y
        asm { out 1016, 32 }
        asm { out 1016, 115 } // s
        asm { out 1016, 112 } // p
        asm { out 1016, 108 } // l
        asm { out 1016, 105 } // i
        asm { out 1016, 116 } // t
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> exercise_memory(context, image, parts) }
    }

    state exercise_memory(context: &mut KernelState, image: Extent in Granted,
                          parts: VacantExtentParts)
    requires addr::Bound == 18446744073709551616
    {
        let original_base: addr = parts.taken.base;
        let original_length: u64 = parts.taken.length;
        let empty: Extent in Granted & Vacant = KernelMemory::reunite_partition(parts.taken, 0);
        let interior: Extent in Granted & Vacant = KernelMemory::reunite_partition(empty, original_length / 2);
        let full: Extent in Granted & Vacant = KernelMemory::reunite_partition(interior, original_length);
        let result: KernelMemoryResult = KernelMemory::exercise(full);
        // These are runtime observations, not establishment of custody. The
        // lifecycle's checked result must already conserve the original claim.
        let verified: bool = result.initialized &&
            result.initial == 17 && result.updated == 29 && result.extracted == 29 &&
            result.storage.base == original_base && result.storage.length == original_length;
        let recovered: VacantExtentParts = VacantExtentParts {
            taken: result.storage, rest: parts.rest,
        };
        transition verified {
            true -> verified_wait(context, image, recovered, 1000000)
            _ -> retain_parts(context, image, recovered)
        }
    }

    state verified_wait(context: &mut KernelState, image: Extent in Granted,
                        parts: VacantExtentParts, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> verified_report(context, image, parts)
            _ -> verified_retry(context, image, parts, remaining)
        }
    }

    state verified_retry(context: &mut KernelState, image: Extent in Granted,
                         parts: VacantExtentParts, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> verified_wait(context, image, parts, remaining - 1)
            _ -> retain_parts(context, image, parts)
        }
    }

    state verified_report(context: &mut KernelState, image: Extent in Granted,
                          parts: VacantExtentParts)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 77 }  // M
        asm { out 1016, 101 } // e
        asm { out 1016, 109 } // m
        asm { out 1016, 111 } // o
        asm { out 1016, 114 } // r
        asm { out 1016, 121 } // y
        asm { out 1016, 32 }
        asm { out 1016, 99 }  // c
        asm { out 1016, 104 } // h
        asm { out 1016, 101 } // e
        asm { out 1016, 99 }  // c
        asm { out 1016, 107 } // k
        asm { out 1016, 101 } // e
        asm { out 1016, 100 } // d
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition parts.taken.length >= 16 {
            true -> exercise_pair(context, image, parts)
            _ -> retain_parts(context, image, parts)
        }
    }

    state exercise_pair(context: &mut KernelState, image: Extent in Granted,
                        parts: VacantExtentParts)
    requires addr::Bound == 18446744073709551616 && parts.taken.length >= 16
    {
        let length: u64 = parts.taken.length;
        let base: addr = parts.taken.base;
        let pair: KernelMemoryPair = KernelMemory::exercise_pair(parts.taken);
        let verified: bool = pair.verified && pair.first.base == base &&
            pair.first.length == 8 && pair.second.length == 8 && pair.tail.length == length - 16;
        transition verified {
            true -> paired_wait(context, image, pair, parts.rest, 1000000)
            _ -> retain_pair(context, image, pair, parts.rest)
        }
    }

    state paired_wait(context: &mut KernelState, image: Extent in Granted,
                      pair: KernelMemoryPair, rest: Extent in Granted & Vacant,
                      remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> paired_report(context, image, pair, rest)
            _ -> paired_retry(context, image, pair, rest, remaining)
        }
    }

    state paired_retry(context: &mut KernelState, image: Extent in Granted,
                       pair: KernelMemoryPair, rest: Extent in Granted & Vacant,
                       remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> paired_wait(context, image, pair, rest, remaining - 1)
            _ -> retain_pair(context, image, pair, rest)
        }
    }

    state paired_report(context: &mut KernelState, image: Extent in Granted,
                        pair: KernelMemoryPair, rest: Extent in Granted & Vacant)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 77 }  // M
        asm { out 1016, 101 } // e
        asm { out 1016, 109 } // m
        asm { out 1016, 111 } // o
        asm { out 1016, 114 } // r
        asm { out 1016, 121 } // y
        asm { out 1016, 32 }
        asm { out 1016, 112 } // p
        asm { out 1016, 97 }  // a
        asm { out 1016, 105 } // i
        asm { out 1016, 114 } // r
        asm { out 1016, 101 } // e
        asm { out 1016, 100 } // d
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition rest.length >= 8199 {
            true -> prepare_page(context, image, pair, rest)
            _ -> retain_pair(context, image, pair, rest)
        }
    }

    state prepare_page(context: &mut KernelState, image: Extent in Granted,
                       pair: KernelMemoryPair, rest: Extent in Granted & Vacant)
    requires addr::Bound == 18446744073709551616 && rest.length >= 8199
    {
        // Retain an ordinary leading reservation so alignment is exercised
        // after a non-page-sized allocation, not only on firmware-aligned input.
        let parts: VacantExtentParts = split_vacant_extent(rest, 8);
        let page: BootPage = BootPage {
            leading: parts.taken, reservation: PageFrame::prepare(parts.rest),
        };
        transition page.reservation.verified {
            true -> page_wait(context, image, pair, page, 1000000)
            _ -> retain_page(context, image, pair, page)
        }
    }

    state page_wait(context: &mut KernelState, image: Extent in Granted,
                    pair: KernelMemoryPair, page: BootPage, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> page_report(context, image, pair, page)
            _ -> page_retry(context, image, pair, page, remaining)
        }
    }

    state page_retry(context: &mut KernelState, image: Extent in Granted,
                     pair: KernelMemoryPair, page: BootPage, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> page_wait(context, image, pair, page, remaining - 1)
            _ -> retain_page(context, image, pair, page)
        }
    }

    state page_report(context: &mut KernelState, image: Extent in Granted,
                      pair: KernelMemoryPair, page: BootPage)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 80 }  // P
        asm { out 1016, 97 }  // a
        asm { out 1016, 103 } // g
        asm { out 1016, 101 } // e
        asm { out 1016, 32 }
        asm { out 1016, 114 } // r
        asm { out 1016, 101 } // e
        asm { out 1016, 97 }  // a
        asm { out 1016, 100 } // d
        asm { out 1016, 121 } // y
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition page.reservation.tail.length >= 20479 {
            true -> prepare_tables(context, image, pair, page)
            _ -> retain_page(context, image, pair, page)
        }
    }

    state prepare_tables(context: &mut KernelState, image: Extent in Granted,
                         pair: KernelMemoryPair, page: BootPage)
    requires addr::Bound == 18446744073709551616 && page.reservation.tail.length >= 20479
    {
        transition page.reservation.page {
            PreparedPage::Ready { storage } -> build_tables(context, image, pair,
                page.leading, page.reservation.padding, storage, page.reservation.tail)
            PreparedPage::Rejected { storage } -> retain_page(context, image, pair, BootPage {
                leading: page.leading, reservation: PageReservation {
                    padding: page.reservation.padding, page: PreparedPage::Rejected { storage: storage },
                    tail: page.reservation.tail, verified: false,
                },
            })
        }
    }

    state build_tables(context: &mut KernelState, image: Extent in Granted,
                       pair: KernelMemoryPair, leading: Extent in Granted & Vacant,
                       padding: Extent in Granted & Vacant,
                       target: Extent in Granted & Resident<KernelPagePlacement, KernelPage>,
                       tail: Extent in Granted & Vacant)
    requires addr::Bound == 18446744073709551616 && tail.length >= 20479
    {
        // This is an inactive candidate for a single virtual page, not a
        // replacement for the firmware mappings of our live image and stack.
        let reservation: PageTableReservation = PageTableBuilder::prepare<BootMemory>(
            tail, &target as &Extent in Granted, 1073741824
        );
        let verified: bool = reservation.verified;
        let tables: BootPageTables = BootPageTables {
            leading: leading, target_padding: padding, target: target, reservation: reservation,
        };
        transition verified {
            true -> tables_wait(context, image, pair, tables, 1000000)
            _ -> retain_tables(context, image, pair, tables)
        }
    }

    state tables_wait(context: &mut KernelState, image: Extent in Granted,
                      pair: KernelMemoryPair, tables: BootPageTables, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> tables_report(context, image, pair, tables)
            _ -> tables_retry(context, image, pair, tables, remaining)
        }
    }

    state tables_retry(context: &mut KernelState, image: Extent in Granted,
                       pair: KernelMemoryPair, tables: BootPageTables, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> tables_wait(context, image, pair, tables, remaining - 1)
            _ -> retain_tables(context, image, pair, tables)
        }
    }

    state tables_report(context: &mut KernelState, image: Extent in Granted,
                        pair: KernelMemoryPair, tables: BootPageTables)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 84 } // T
        asm { out 1016, 97 } // a
        asm { out 1016, 98 } // b
        asm { out 1016, 108 } // l
        asm { out 1016, 101 } // e
        asm { out 1016, 115 } // s
        asm { out 1016, 32 }
        asm { out 1016, 114 } // r
        asm { out 1016, 101 } // e
        asm { out 1016, 97 } // a
        asm { out 1016, 100 } // d
        asm { out 1016, 121 } // y
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> inspect_paging(context, image, pair, tables) }
    }

    state inspect_paging(context: &mut KernelState, image: Extent in Granted,
                         pair: KernelMemoryPair, tables: BootPageTables)
    requires addr::Bound == 18446744073709551616
    {
        let profile: BootstrapPagingProfile = Kernel::observe_paging();
        transition BootstrapPaging::supported(&profile) {
            true -> paging_wait(context, image, pair, tables, 1000000)
            _ -> retain_tables(context, image, pair, tables)
        }
    }

    state paging_wait(context: &mut KernelState, image: Extent in Granted,
                      pair: KernelMemoryPair, tables: BootPageTables, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> paging_report(context, image, pair, tables)
            _ -> paging_retry(context, image, pair, tables, remaining)
        }
    }

    state paging_retry(context: &mut KernelState, image: Extent in Granted,
                       pair: KernelMemoryPair, tables: BootPageTables, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> paging_wait(context, image, pair, tables, remaining - 1)
            _ -> retain_tables(context, image, pair, tables)
        }
    }

    state paging_report(context: &mut KernelState, image: Extent in Granted,
                        pair: KernelMemoryPair, tables: BootPageTables)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 67 } // CPU checked
        asm { out 1016, 80 }
        asm { out 1016, 85 }
        asm { out 1016, 32 }
        asm { out 1016, 99 }
        asm { out 1016, 104 }
        asm { out 1016, 101 }
        asm { out 1016, 99 }
        asm { out 1016, 107 }
        asm { out 1016, 101 }
        asm { out 1016, 100 }
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> locate_firmware_root(context, image, pair, tables) }
    }

    state locate_firmware_root(context: &mut KernelState, image: Extent in Granted,
                               pair: KernelMemoryPair, tables: BootPageTables)
    requires addr::Bound == 18446744073709551616
    {
        let mut control3: u64 = 0;
        asm { read_cr3 control3 }
        let root: u64 = FirmwareRootMap::frame(control3);
        let excluded: BootGeometry = BootGeometry {
            image_base: context.boot_information.image_base,
            image_length: context.boot_information.image_size,
            storage_base: context.initial_storage_base,
            storage_length: context.initial_storage_bytes,
        };
        let located: bool = FirmwareRootMap::contains(&context.boot_information.bytes,
            context.boot_information.map_size, context.boot_information.descriptor_size, root, &excluded);
        // Numeric eligibility precedes the separately admitted grant. It does
        // not itself establish readable backing or a retained table closure.
        context.firmware_root = root;
        transition located {
            true -> root_wait(context, image, pair, tables, 1000000)
            _ -> retain_tables(context, image, pair, tables)
        }
    }

    state root_wait(context: &mut KernelState, image: Extent in Granted,
                    pair: KernelMemoryPair, tables: BootPageTables, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> root_report(context, image, pair, tables)
            _ -> root_retry(context, image, pair, tables, remaining)
        }
    }

    state root_retry(context: &mut KernelState, image: Extent in Granted,
                     pair: KernelMemoryPair, tables: BootPageTables, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> root_wait(context, image, pair, tables, remaining - 1)
            _ -> retain_tables(context, image, pair, tables)
        }
    }

    state root_report(context: &mut KernelState, image: Extent in Granted,
                      pair: KernelMemoryPair, tables: BootPageTables)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 82 } // Root located
        asm { out 1016, 111 }
        asm { out 1016, 111 }
        asm { out 1016, 116 }
        asm { out 1016, 32 }
        asm { out 1016, 108 }
        asm { out 1016, 111 }
        asm { out 1016, 99 }
        asm { out 1016, 97 }
        asm { out 1016, 116 }
        asm { out 1016, 101 }
        asm { out 1016, 100 }
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> admit_firmware_root(context, image, pair, tables) }
    }

    state admit_firmware_root(context: &mut KernelState, image: Extent in Granted,
                             pair: KernelMemoryPair, tables: BootPageTables)
    requires addr::Bound == 18446744073709551616
    {
        let root: u64 = context.firmware_root;
        transition root != 0 && root % 4096 == 0 && root <= 4503599627366400 {
            true -> grant_firmware_root(context, image, pair, tables, root)
            _ -> retain_tables(context, image, pair, tables)
        }
    }

    state grant_firmware_root(context: &mut KernelState, image: Extent in Granted,
                             pair: KernelMemoryPair, tables: BootPageTables, root: u64)
    requires addr::Bound == 18446744073709551616 && root != 0 &&
             root % 4096 == 0 && root <= 4503599627366400
    {
        // This is the third, disjoint root in the closed boot transaction.
        // Admission extends the root provider's premise to this accepted live
        // CR3 frame: identity-mapped readable physical RAM retained after exit.
        // No allocator, remap or firmware call may reuse/revoke it. The map
        // checks exclude all initial-storage descendants and the full image.
        // Every following success/failure path retains this linear claim.
        let retained_root: Extent in Granted = ExtentRootProvider::grant(
            Extent { base: root as addr, length: 4096 }
        );
        let snapshot: FirmwareRootSnapshot = PagingHandoff::snapshot<FirmwareMemory>(&retained_root);
        transition snapshot {
            FirmwareRootSnapshot::Ready { entries } ->
                check_firmware_root(context, image, pair, tables, retained_root, entries)
            FirmwareRootSnapshot::Unavailable ->
                retain_firmware_root(context, image, pair, tables, retained_root)
        }
    }

    state check_firmware_root(context: &mut KernelState, image: Extent in Granted,
                             pair: KernelMemoryPair, tables: BootPageTables,
                             retained_root: Extent in Granted, entries: [u64; 512])
    requires addr::Bound == 18446744073709551616
    {
        let populated: bool = PagingHandoff::has_present_entry(&entries);
        transition populated {
            true -> root_read_wait(context, image, pair, tables, retained_root, 1000000)
            _ -> retain_firmware_root(context, image, pair, tables, retained_root)
        }
    }

    state root_read_wait(context: &mut KernelState, image: Extent in Granted,
                         pair: KernelMemoryPair, tables: BootPageTables,
                         retained_root: Extent in Granted, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> root_read_report(context, image, pair, tables, retained_root)
            _ -> root_read_retry(context, image, pair, tables, retained_root, remaining)
        }
    }

    state root_read_retry(context: &mut KernelState, image: Extent in Granted,
                          pair: KernelMemoryPair, tables: BootPageTables,
                          retained_root: Extent in Granted, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> root_read_wait(context, image, pair, tables, retained_root, remaining - 1)
            _ -> retain_firmware_root(context, image, pair, tables, retained_root)
        }
    }

    state root_read_report(context: &mut KernelState, image: Extent in Granted,
                           pair: KernelMemoryPair, tables: BootPageTables,
                           retained_root: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 82 } // Root read
        asm { out 1016, 111 }
        asm { out 1016, 111 }
        asm { out 1016, 116 }
        asm { out 1016, 32 }
        asm { out 1016, 114 }
        asm { out 1016, 101 }
        asm { out 1016, 97 }
        asm { out 1016, 100 }
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> collect_firmware_tables(context, image, pair, tables, retained_root) }
    }

    state collect_firmware_tables(context: &mut KernelState, image: Extent in Granted,
                                  pair: KernelMemoryPair, tables: BootPageTables,
                                  retained_root: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        let excluded: BootGeometry = BootGeometry {
            image_base: context.boot_information.image_base,
            image_length: context.boot_information.image_size,
            storage_base: context.initial_storage_base,
            storage_length: context.initial_storage_bytes,
        };
        let inventory: FirmwareTableInventory = FirmwareTables::collect(
            retained_root, &context.boot_information, &excluded);
        transition inventory.complete {
            true -> closure_wait(context, image, pair, tables, inventory, 1000000)
            _ -> retain_firmware_tables(context, image, pair, tables, inventory)
        }
    }

    state closure_wait(context: &mut KernelState, image: Extent in Granted,
                       pair: KernelMemoryPair, tables: BootPageTables,
                       inventory: FirmwareTableInventory, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> closure_report(context, image, pair, tables, inventory)
            _ -> closure_retry(context, image, pair, tables, inventory, remaining)
        }
    }

    state closure_retry(context: &mut KernelState, image: Extent in Granted,
                        pair: KernelMemoryPair, tables: BootPageTables,
                        inventory: FirmwareTableInventory, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> closure_wait(context, image, pair, tables, inventory, remaining - 1)
            _ -> retain_firmware_tables(context, image, pair, tables, inventory)
        }
    }

    state closure_report(context: &mut KernelState, image: Extent in Granted,
                         pair: KernelMemoryPair, tables: BootPageTables,
                         inventory: FirmwareTableInventory)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 84 } // Tables retained
        asm { out 1016, 97 }
        asm { out 1016, 98 }
        asm { out 1016, 108 }
        asm { out 1016, 101 }
        asm { out 1016, 115 }
        asm { out 1016, 32 }
        asm { out 1016, 114 }
        asm { out 1016, 101 }
        asm { out 1016, 116 }
        asm { out 1016, 97 }
        asm { out 1016, 105 }
        asm { out 1016, 110 }
        asm { out 1016, 101 }
        asm { out 1016, 100 }
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> mapping(context, image, pair, tables, inventory) }
    }

    state mapping(context: &mut KernelState, image: Extent in Granted,
                  pair: KernelMemoryPair, tables: BootPageTables,
                  inventory: FirmwareTableInventory)
    requires addr::Bound == 18446744073709551616
    {
        // Per-occurrence root admission: issue a fresh claim in the continuing
        // kernel's VIRTUAL namespace, excluding every live image, stack,
        // callback and other claimant. Firmware's old identity mapping does
        // not own this namespace. This grant supplies no physical backing;
        // the independently retained source page supplies that separately.
        // Neither this address's geometry nor reserve below proves issuance.
        let reservation: Extent in Granted = ExtentRootProvider::grant(
            Extent { base: 0x40000000 as addr, length: MAPPING_BYTE_COUNT }
        );
        let destination: Extent in Granted & BootVirtualDestination = BootVirtualReservation::reserve(reservation);
        let attempt: MappingAttempt = MappingExercise::run(tables, destination, &inventory, context.firmware_root);
        let retired: bool = MappingExercise::retired(&attempt);
        let verified: bool = MappingExercise::verified(&attempt);
        // Observe independently of the provider's Boolean and private saved
        // CR3 word. Only a returned activation transaction can reach this marker.
        let mut observed: u64 = 0;
        asm { read_cr3 observed }
        transition retired && (observed & 0x000FFFFFFFFFF000) == context.firmware_root {
            true -> mapping_retired_wait(context, image, pair, inventory, attempt, verified, 1000000)
            _ -> retain_mapping(context, image, pair, inventory, attempt)
        }
    }

    state mapping_retired_wait(context: &mut KernelState, image: Extent in Granted,
                               pair: KernelMemoryPair, inventory: FirmwareTableInventory,
                               attempt: MappingAttempt, verified: bool, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> mapping_retired_report(context, image, pair, inventory, attempt, verified)
            _ -> mapping_retired_retry(context, image, pair, inventory, attempt, verified, remaining)
        }
    }

    state mapping_retired_retry(context: &mut KernelState, image: Extent in Granted,
                                pair: KernelMemoryPair, inventory: FirmwareTableInventory,
                                attempt: MappingAttempt, verified: bool, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> mapping_retired_wait(context, image, pair, inventory, attempt, verified, remaining - 1)
            _ -> retain_mapping(context, image, pair, inventory, attempt)
        }
    }

    state mapping_retired_report(context: &mut KernelState, image: Extent in Granted,
                                 pair: KernelMemoryPair, inventory: FirmwareTableInventory,
                                 attempt: MappingAttempt, verified: bool)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 77 } // Mapping retired
        asm { out 1016, 97 }
        asm { out 1016, 112 }
        asm { out 1016, 112 }
        asm { out 1016, 105 }
        asm { out 1016, 110 }
        asm { out 1016, 103 }
        asm { out 1016, 32 }
        asm { out 1016, 114 }
        asm { out 1016, 101 }
        asm { out 1016, 116 }
        asm { out 1016, 105 }
        asm { out 1016, 114 }
        asm { out 1016, 101 }
        asm { out 1016, 100 }
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> mapping_checked(context, image, pair, inventory, attempt, verified) }
    }

    state mapping_checked(context: &mut KernelState, image: Extent in Granted,
                          pair: KernelMemoryPair, inventory: FirmwareTableInventory,
                          attempt: MappingAttempt, verified: bool)
    requires addr::Bound == 18446744073709551616
    {
        transition verified {
            true -> mapping_wait(context, image, pair, inventory, attempt, 1000000)
            _ -> retain_mapping(context, image, pair, inventory, attempt)
        }
    }

    state mapping_wait(context: &mut KernelState, image: Extent in Granted,
                       pair: KernelMemoryPair, inventory: FirmwareTableInventory,
                       attempt: MappingAttempt, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        let mut status: u8 = 0;
        asm { in status, 1021 }
        transition (status & 32) != 0 {
            true -> mapping_report(context, image, pair, inventory, attempt)
            _ -> mapping_retry(context, image, pair, inventory, attempt, remaining)
        }
    }

    state mapping_retry(context: &mut KernelState, image: Extent in Granted,
                        pair: KernelMemoryPair, inventory: FirmwareTableInventory,
                        attempt: MappingAttempt, remaining: u64)
    requires addr::Bound == 18446744073709551616
    {
        transition remaining > 1 {
            true -> mapping_wait(context, image, pair, inventory, attempt, remaining - 1)
            _ -> retain_mapping(context, image, pair, inventory, attempt)
        }
    }

    state mapping_report(context: &mut KernelState, image: Extent in Granted,
                         pair: KernelMemoryPair, inventory: FirmwareTableInventory, attempt: MappingAttempt)
    requires addr::Bound == 18446744073709551616
    {
        asm { out 1016, 77 } // Mapping checked
        asm { out 1016, 97 }
        asm { out 1016, 112 }
        asm { out 1016, 112 }
        asm { out 1016, 105 }
        asm { out 1016, 110 }
        asm { out 1016, 103 }
        asm { out 1016, 32 }
        asm { out 1016, 99 }
        asm { out 1016, 104 }
        asm { out 1016, 101 }
        asm { out 1016, 99 }
        asm { out 1016, 107 }
        asm { out 1016, 101 }
        asm { out 1016, 100 }
        asm { out 1016, 13 }
        asm { out 1016, 10 }
        transition { _ -> retain_mapping(context, image, pair, inventory, attempt) }
    }

    state retain_mapping(context: &mut KernelState, image: Extent in Granted,
                         pair: KernelMemoryPair, inventory: FirmwareTableInventory, attempt: MappingAttempt)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_mapping(context, image, pair, inventory, attempt) }
    }

    state retain_firmware_tables(context: &mut KernelState, image: Extent in Granted,
                                 pair: KernelMemoryPair, tables: BootPageTables,
                                 inventory: FirmwareTableInventory)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_firmware_tables(context, image, pair, tables, inventory) }
    }

    state retain_firmware_root(context: &mut KernelState, image: Extent in Granted,
                               pair: KernelMemoryPair, tables: BootPageTables,
                               retained_root: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_firmware_root(context, image, pair, tables, retained_root) }
    }

    state retain_tables(context: &mut KernelState, image: Extent in Granted,
                        pair: KernelMemoryPair, tables: BootPageTables)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_tables(context, image, pair, tables) }
    }

    state retain_page(context: &mut KernelState, image: Extent in Granted,
                      pair: KernelMemoryPair, page: BootPage)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_page(context, image, pair, page) }
    }

    state retain_pair(context: &mut KernelState, image: Extent in Granted,
                      pair: KernelMemoryPair, rest: Extent in Granted & Vacant)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_pair(context, image, pair, rest) }
    }

    state retain_parts(context: &mut KernelState, image: Extent in Granted,
                       parts: VacantExtentParts)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_parts(context, image, parts) }
    }

    state retain_vacant(context: &mut KernelState, image: Extent in Granted,
                        storage: Extent in Granted & Vacant)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain_vacant(context, image, storage) }
    }

    state retain(context: &mut KernelState, image: Extent in Granted, initial_storage: Extent in Granted)
    requires addr::Bound == 18446744073709551616
    {
        asm { hlt }
        transition { _ -> retain(context, image, initial_storage) }
    }
}
