// Expected output contains: Segments ready
// Check the firmware table before using its services to discover and acquire
// memory. After firmware exit, execution continues with the kernel memory
// and descriptor-table checks selected by build.omg.
use firmware::firmware;
use lab::memory::main;

use uefi::uefi;
use uefi::boot_services;
use uefi::loaded_image;
use omega::language::core::extent;
use omega::language::core::assembly;
use omega::language::core::program_image;
use omega::language::core::layout;

// Firmware arrival is selected explicitly by build.omg. The receiving UEFI
// profile supplies the validity/lifetime of this exact incoming table borrow;
// the declaration itself neither creates that borrow nor grants any Extent.
public CathedralBootstrap satisfies UefiPhysicalEntry {
    machine enter(handle: EfiHandle in LoadedApplication, table: &EfiSystemTable) -> EfiStatus
    reaches SimpleTextOutput + LoadedImageAccess + BootServices + ExtentRootProvider + ProgramStorageEntry + ProgramImage + ResourceProfileSupply + PortIo + MachineControl
    invokes SimpleTextOutput
    invokes LoadedImageAccess
    invokes BootServices
    invokes ExtentRootProvider
    invokes ProgramStorageEntry
    invokes ProgramImage
    invokes ResourceProfileSupply
    requires addr::Bound == 18446744073709551616
    {
        transition table.header.signature == EFI_SYSTEM_TABLE_SIGNATURE &&
                   table.header.revision >= EFI_MIN_SUPPORTED_REVISION &&
                   table.header.header_size >= EFI_SYSTEM_TABLE_REQUIRED_SIZE &&
                   table.header.reserved == 0 {
            true -> boot(handle, table)
            _ -> (EFI_INVALID_PARAMETER)
        }

        machine boot(handle: EfiHandle in LoadedApplication, table: &EfiSystemTable) -> EfiStatus
        requires addr::Bound == 18446744073709551616
        {
            let mut context: Main;
            Main::run(&mut context, handle, table)
        }
    }
}
