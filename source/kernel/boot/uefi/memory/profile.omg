use omega::language::core::extent;
use omega::language::core::layout;

// A static supply role selects this closed boot composition's initial RAM.
// It is not a grant and cannot make unrelated firmware storage Stable.
public data BootMemory {}
public boundary trait BootMemorySupply: ResourceProfileSupply<BootMemory> {}

// Admitted only for the initial ConventionalMemory root retained after the
// successful firmware handoff and its conserved children. The boot mapping
// remains live and CPU-readable/writable. Stable access is exclusive only
// during construction and again after synchronous mapping retirement: no
// physical Stable loan crosses the temporary virtual alias, and replacement
// tables cease to use this supply when their Resident is extracted. Hardware
// then accesses them under HardwareTableSupply's External-only phase. The
// initial RAM and its identity aliases have compatible effective WB cache type
// for that closed transaction; neither Granted nor ConventionalMemory alone
// proves it. No firmware service or device loan may revoke the backing. This
// describes phase-bounded backing supply, not contents or a second root.
BootMemoryProfileProvider satisfies BootMemorySupply {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}
