use {omega}/language/core/extent.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/access/access.omg;
use lab/memory/mapping/firmware/root.omg;
use memory/profile.omg;

// Boot owns this first page and all skipped bytes until a later kernel owner
// takes them. Alignment is geometry, not authority: both splits conserve the
// original grant and vacancy, and only placement establishes resident content.
public data KernelPage { words: [u64; 512]; }
public data KernelPagePlacement {}
data PageFrame {}

data PreparedPage {
    case Ready(storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelPagePlacement, KernelPage>);
    case Rejected(storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant);
}

data PageReservation {
    padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    page: PreparedPage;
    tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    verified: bool;
}

data BootPage {
    leading: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    reservation: PageReservation;
}

machine KernelPagePlacement::plan(schema: |layout|::Schema) -> |layout|::AccessPlan {
    let mut entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry {
        key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 },
    };
    let services: [u64; 32];
    let layout: |layout|::LayoutPlan = |layout|::LayoutPlan {
        entries: entries, entry_count: 1, size_fixed: 4096,
        size_is_dynamic: false, align: 4096,
    };
    |layout|::AccessPlan::with_reach(
        |layout|::AccessPlan::with(|layout|::AccessPlan::inaccessible(layout), schema.fields[0].key,
            |layout|::FieldAccess::Stable { read: true, write: true, exposure: |layout|::Exposure::Exported }),
        |layout|::BoundaryReach { services: services, service_count: 0 }
    )
}

// Worst-case padding is 4095 bytes. Subtract it before reserving the page;
// never round an address up past its representable bound. The returned padding
// remains owned even when it is empty. This is not allocator reset or mapping.
machine PageFrame::prepare(storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant) -> PageReservation
requires storage.length >= 8191 && address::Bound == 18446744073709551616
reaches |layout|::ResourceProfileSupply
{
    let residue: u64 = (storage.base as u64) % 4096;
    let padding_length: u64 = (4096 - residue) % 4096;
    let prefix: |extent|::VacantExtentParts = |extent|::split_vacant_extent(storage, padding_length);
    let parts: |extent|::VacantExtentParts = |extent|::split_vacant_extent(prefix.rest, 4096);
    let geometry: bool = (parts.taken.base as u64) % 4096 == 0 && parts.taken.length == 4096;
    let mut words: [u64; 512];
    words[0] = 17;
    words[511] = 73;
    transition |layout|::NativeAccess<KernelPagePlacement, KernelPage, |profile|::BootMemory>::initialize(
        parts.taken, KernelPage { words: words }
    ) {
        |layout|::AccessOutcome::Ready { view } -> verify(prefix.taken, view, parts.rest, geometry)
        |layout|::AccessOutcome::Rejected { returned, reason } -> PageReservation {
            padding: prefix.taken, page: PreparedPage::Rejected { storage: returned.source },
            tail: parts.rest, verified: false,
        }
    }

    machine verify(
        padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
        storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelPagePlacement, KernelPage>,
        tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, geometry: bool
    ) -> PageReservation {
        let mut retained: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelPagePlacement, KernelPage> = storage;
        let indexed: bool = PageFrame::overwrite(
            |access|::view_resident_mut<KernelPagePlacement, KernelPage>(&mut retained)
        );
        // Exercise the same conservative External snapshot needed for the
        // active firmware root while its bytes still have a known oracle.
        // This borrows the existing grant; resident custody stays with retained.
        let snapshot: |root|::FirmwareRootSnapshot = |root|::PagingHandoff::snapshot<|profile|::BootMemory>(
            (&retained) as &|extent|::Extent in |extent|::Granted
        );
        let copied: bool = PageFrame::check_snapshot(snapshot);
        // Both supply roles coexist over this exact known backing. A stronger
        // neighboring RAM profile must not satisfy a request made through the
        // read-only External role. No memory access follows the rejected view.
        let isolated: bool = PageFrame::reject_unstable_supply(
            (&retained) as &|extent|::Extent in |extent|::Granted
        );
        transition |layout|::NativeAccess<KernelPagePlacement, KernelPage, |profile|::BootMemory>::move_out(retained) {
            |layout|::AccessExtraction::Moved { storage, value } -> clear(padding, storage, tail, geometry && indexed && copied && isolated, value)
        }
    }

    machine clear(padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant, storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, geometry: bool, observed: KernelPage) -> PageReservation {
        let valid: bool = geometry && PageFrame::check_image(&observed);
        let words: [u64; 512];
        transition |layout|::NativeAccess<KernelPagePlacement, KernelPage, |profile|::BootMemory>::initialize(storage, KernelPage { words: words }) {
            |layout|::AccessOutcome::Ready { view } -> check_cleared(padding, view, tail, valid)
            |layout|::AccessOutcome::Rejected { returned, reason } -> PageReservation {
                padding: padding, page: PreparedPage::Rejected { storage: returned.source },
                tail: tail, verified: false,
            }
        }
    }

    machine check_cleared(padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                        storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelPagePlacement, KernelPage>,
                        tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, valid: bool) -> PageReservation {
        transition |layout|::NativeAccess<KernelPagePlacement, KernelPage, |profile|::BootMemory>::move_out(storage) {
            |layout|::AccessExtraction::Moved { storage, value } -> retain(padding, storage, tail, valid, value)
        }
    }

    machine retain(padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant, storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                 tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, valid: bool, value: KernelPage) -> PageReservation {
        let cleared: bool = PageFrame::check_zero(&value, 0);
        // Reinstall the exact zero image just read back. Ready retains the
        // complete resident page; extraction never drops the original extent.
        transition |layout|::NativeAccess<KernelPagePlacement, KernelPage, |profile|::BootMemory>::initialize(storage, value) {
            |layout|::AccessOutcome::Ready { view } -> PageReservation {
                padding: padding, page: PreparedPage::Ready { storage: view },
                tail: tail, verified: valid && cleared,
            }
            |layout|::AccessOutcome::Rejected { returned, reason } -> PageReservation {
                padding: padding, page: PreparedPage::Rejected { storage: returned.source },
                tail: tail, verified: false,
            }
        }
    }
}

machine PageFrame::reject_unstable_supply(storage: &|extent|::Extent in |extent|::Granted) -> bool
reaches |layout|::ResourceProfileSupply
{
    transition |access|::view_extent<KernelPagePlacement, KernelPage, |root|::FirmwareMemory>(storage) {
        |layout|::AccessOutcome::Ready { view } -> false
        |layout|::AccessOutcome::Rejected { returned, reason } -> rejected(reason)
    }
    machine rejected(reason: |layout|::AccessInitializationFailure) -> bool {
        transition reason {
            |layout|::AccessInitializationFailure::IncompatibleSupply -> true
            _ -> false
        }
    }
}

machine PageFrame::check_snapshot(snapshot: |root|::FirmwareRootSnapshot) -> bool {
    transition snapshot {
        |root|::FirmwareRootSnapshot::Ready { entries } -> check(entries)
        |root|::FirmwareRootSnapshot::Unavailable -> false
    }
    machine check(entries: [u64; 512]) -> bool {
        let page: KernelPage = KernelPage { words: entries };
        PageFrame::check_image(&page)
    }
}

machine PageFrame::check_image(page: &KernelPage) -> bool {
    transition page.words[0] == 29 && page.words[511] == 97 {
        true -> interior(page, 1)
        _ -> false
    }
    machine interior(page: &KernelPage, index: u64) -> bool
    requires index <= 511
    {
        transition index < 511 {
            true -> advance(page, index)
            _ -> true
        }
    }
    machine advance(page: &KernelPage, index: u64) -> bool
    requires index < 511
    {
        transition page.words[index] == 0 { true -> interior(page, index + 1) _ -> false }
    }
}

// Each indexed event borrows the same resident page. Read the first word again
// after changing the last, then let whole extraction independently observe both.
machine PageFrame::overwrite(view: &mut |layout|::Access<KernelPagePlacement, KernelPage>) -> bool {
    let first: u64 = |layout|::read(&view.words[0]);
    let last: u64 = |layout|::read(&view.words[511]);
    PageFrame::write_word(view, 0, 29);
    PageFrame::write_word(view, 511, 97);
    let updated_first: u64 = |layout|::read(&view.words[0]);
    let updated_last: u64 = |layout|::read(&view.words[511]);
    first == 17 && last == 73 && updated_first == 29 && updated_last == 97
}

machine PageFrame::write_word(
    view: &mut |layout|::Access<KernelPagePlacement, KernelPage>, index: u64, value: u64
)
requires index < 512
{
    |layout|::write(&mut view.words[index], value);
}

machine PageFrame::check_zero(page: &KernelPage, index: u64) -> bool
requires index <= 512
{
    transition index < 512 { true -> inspect(page, index) _ -> true }
    machine inspect(page: &KernelPage, index: u64) -> bool
    requires index < 512
    {
        transition page.words[index] == 0 { true -> next(page, index + 1) _ -> false }
    }
    machine next(page: &KernelPage, index: u64) -> bool
    requires index <= 512
    {
        transition index < 512 { true -> inspect(page, index) _ -> true }
    }
}
