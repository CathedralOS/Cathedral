use {omega}/language/core/assembly.omg;
use {arch}/isa/x86_64/memory/clone.omg;
use {arch}/isa/x86_64/memory/memory.omg;
use {omega}/language/core/extent.omg;
use {omega}/language/core/layout.omg;
use lab/memory/mapping/firmware/firmware.omg;
use lab/memory/page.omg;
use memory/profile.omg;
use lab/memory/mapping/custody.omg;
use lab/memory/mapping/activation.omg;
use lab/memory/mapping/region.omg;

data BootPageTables {
    leading: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    target_padding: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    target: |extent|::Extent in |extent|::Granted & |extent|::Resident<|page|::KernelPagePlacement, |page|::KernelPage>;
    reservation: |memory|::PageTableReservation;
}

data MappingPadding {
    leading: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    target: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    baseline: |extent|::Extent in |extent|::Granted & |extent|::Resident<|page|::KernelPagePlacement, |page|::KernelPage>;
    tables: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
}

data MappingAttempt {
    case Unchanged(tables: BootPageTables, destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination);
    case SourceHeld(tables: BootPageTables, destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination,
                    source: |region|::MappingRegionPreparation);
    case Prepared(padding: MappingPadding, mapping: |activation|::BootMapping);
    case Retired(padding: MappingPadding, mapping: |activation|::BootMapping, verified: bool);
}

data MappingExercise {}

machine MappingExercise::retired(attempt: &MappingAttempt) -> bool {
    transition attempt {
        MappingAttempt::Retired { padding, mapping, verified } -> true
        _ -> false
    }
}

machine MappingExercise::verified(attempt: &MappingAttempt) -> bool {
    transition attempt {
        MappingAttempt::Retired { padding, mapping, verified } -> verified
        _ -> false
    }
}

machine MappingExercise::root(tables: &|memory|::PreparedPageTables) -> u64
requires address::Bound == 18446744073709551616
{
    transition tables {
        |memory|::PreparedPageTables::Ready { storage } -> (storage.base as u64)
        _ -> 0
    }
}

// The caller owns the virtual reservation independently of the physical region.
// Prepare from real retained snapshots; retire Stable construction; program
// External tables; activate; exercise the virtual alias; restore CR3; then
// read every physical page. Every recoverable refusal returns all claims.
machine MappingExercise::run(tables: BootPageTables, destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination,
                             inventory: &|firmware|::FirmwareTableInventory, firmware_root: u64) -> MappingAttempt
requires address::Bound == 18446744073709551616
reaches |layout|::ResourceProfileSupply + |assembly|::MachineControl + |activation|::BootTranslation
crashes Abort
{
    let root: u64 = MappingExercise::root(&tables.reservation.tables);
    transition tables.reservation.verified && root != 0 && tables.target.length == 4096 &&
        destination.length == |region|::MAPPING_BYTE_COUNT &&
        tables.reservation.tail.length >= |region|::MAPPING_BYTE_COUNT &&
        (tables.reservation.tail.base as u64) % 4096 == 0 {
        true -> allocate(tables, destination, inventory, firmware_root, root)
        _ -> (MappingAttempt::Unchanged { tables: tables, destination: destination })
    }
    machine allocate(tables: BootPageTables, destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination,
                   inventory: &|firmware|::FirmwareTableInventory, firmware_root: u64, root: u64) -> MappingAttempt
    requires address::Bound == 18446744073709551616 && tables.reservation.tail.length >= |region|::MAPPING_BYTE_COUNT
    {
        let verified: bool = tables.reservation.verified;
        let parts: |extent|::VacantExtentParts = |extent|::split_vacant_extent(tables.reservation.tail, |region|::MAPPING_BYTE_COUNT);
        let retained: BootPageTables = BootPageTables {
            leading: tables.leading, target_padding: tables.target_padding, target: tables.target,
            reservation: |memory|::PageTableReservation {
                padding: tables.reservation.padding, tables: tables.reservation.tables,
                tail: parts.rest, verified: verified,
            },
        };
        transition |region|::prepare_mapping_region(parts.taken) {
            |region|::MappingRegionPreparation::Ready { storage } -> clone(retained, storage, destination, inventory, firmware_root, root)
            |region|::MappingRegionPreparation::Rejected { storage } -> (MappingAttempt::SourceHeld {
                tables: retained, destination: destination,
                source: |region|::MappingRegionPreparation::Rejected { storage: storage },
            })
        }
    }
    machine clone(tables: BootPageTables,
                source: |extent|::Extent in |extent|::Granted & |extent|::Resident<|region|::MappingRegionPlacement, |region|::MappingRegion>,
                destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination,
                inventory: &|firmware|::FirmwareTableInventory, firmware_root: u64, root: u64) -> MappingAttempt
    requires address::Bound == 18446744073709551616
    {
        transition |custody|::MappingHandoff::clone(inventory, firmware_root, root,
            source.base as u64, destination.base as u64, source.length) {
            |custody|::MappingCloneResult::Ready { tables as image } -> extract(tables, source, destination, firmware_root, image)
            _ -> (MappingAttempt::SourceHeld {
                tables: tables, destination: destination,
                source: |region|::MappingRegionPreparation::Ready { storage: source },
            })
        }
    }
    machine extract(tables: BootPageTables,
                  source: |extent|::Extent in |extent|::Granted & |extent|::Resident<|region|::MappingRegionPlacement, |region|::MappingRegion>,
                  destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination,
                  firmware_root: u64, image: |clone|::X86ClonedPageTables) -> MappingAttempt
    requires address::Bound == 18446744073709551616
    {
        let padding: MappingPadding = MappingPadding {
            leading: tables.leading, target: tables.target_padding,
            baseline: tables.target,
            tables: tables.reservation.padding, tail: tables.reservation.tail,
        };
        transition tables.reservation.tables {
            |memory|::PreparedPageTables::Ready { storage } -> retire_resident(padding, source, destination, storage, firmware_root, image)
            |memory|::PreparedPageTables::Rejected { storage } -> (MappingAttempt::Prepared {
                padding: padding,
                mapping: |activation|::BootMapping { source: source, destination: destination, tables: storage, firmware_root: firmware_root },
            })
        }
    }
    machine retire_resident(padding: MappingPadding,
                          source: |extent|::Extent in |extent|::Granted & |extent|::Resident<|region|::MappingRegionPlacement, |region|::MappingRegion>,
                          destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination,
                          tables: |extent|::Extent in |extent|::Granted & |extent|::Resident<|memory|::InactivePageTablePlacement, |memory|::InactivePageTables>,
                          firmware_root: u64, image: |clone|::X86ClonedPageTables) -> MappingAttempt
    requires address::Bound == 18446744073709551616
    {
        transition |layout|::NativeAccess<|memory|::InactivePageTablePlacement, |memory|::InactivePageTables, |profile|::BootMemory>::move_out(tables) {
            |layout|::AccessExtraction::Moved { storage, value } -> program(padding, source, destination, storage, firmware_root, image)
        }
    }
    machine program(padding: MappingPadding,
                  source: |extent|::Extent in |extent|::Granted & |extent|::Resident<|region|::MappingRegionPlacement, |region|::MappingRegion>,
                  destination: |extent|::Extent in |extent|::Granted & |activation|::BootVirtualDestination, tables: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
                  firmware_root: u64, image: |clone|::X86ClonedPageTables) -> MappingAttempt
    requires address::Bound == 18446744073709551616
    {
        let mut pending: |activation|::BootMapping = |activation|::BootMapping {
            source: source, destination: destination, tables: tables,
            firmware_root: firmware_root,
        };
        let programmed: bool = |custody|::MappingHandoff::program(&mut pending.tables, &image);
        transition programmed && pending.tables.length == 16384 &&
            (pending.tables.base as u64) % 4096 == 0 && pending.tables.base as u64 <= 0x000FFFFFFFFFC000 &&
            pending.source.length == |region|::MAPPING_BYTE_COUNT && pending.destination.length == |region|::MAPPING_BYTE_COUNT {
            true -> activate(padding, pending)
            _ -> dormant(padding, pending)
        }
    }
    machine activate(padding: MappingPadding, pending: |activation|::BootMapping) -> MappingAttempt
    requires address::Bound == 18446744073709551616
    {
        let mut retained: |activation|::BootMapping = pending;
        let mapped: bool = |activation|::BootTranslation::exercise(&mut retained);
        let physical: bool = |region|::check_mapping_region(&mut retained.source);
        MappingAttempt::Retired { padding: padding, mapping: retained, verified: mapped && physical }
    }
    machine dormant(padding: MappingPadding, pending: |activation|::BootMapping) -> MappingAttempt {
        MappingAttempt::Prepared {
            padding: padding,
            mapping: pending,
        }
    }
}
