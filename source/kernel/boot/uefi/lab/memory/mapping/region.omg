use {omega}/language/core/extent.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/access/access.omg;
use memory/profile.omg;

// The boot composition chooses one bounded region. Allocation, leaf
// installation and access iterate this same geometry; no per-count compiler
// path or extra backing grant is involved.
public const MAPPING_PAGE_COUNT: u64 = 3;
public const MAPPING_WORD_COUNT: u64 = MAPPING_PAGE_COUNT * 512;
public const MAPPING_BYTE_COUNT: u64 = MAPPING_PAGE_COUNT * 4096;

public data MappingRegion { words: [u64; MAPPING_WORD_COUNT]; }
public data MappingRegionPlacement {}

data MappingRegionPreparation {
    case Ready(storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<MappingRegionPlacement, MappingRegion>);
    case Rejected(storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant);
}

machine MappingRegionPlacement::plan(schema: |layout|::Schema) -> |layout|::AccessPlan {
    let mut entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    let layout: |layout|::LayoutPlan = |layout|::LayoutPlan {
        entries: entries, entry_count: 1, size_fixed: schema.fields[0].size,
        size_is_dynamic: false, align: 4096,
    };
    |layout|::AccessPlan::with_reach(
        |layout|::AccessPlan::with(|layout|::AccessPlan::inaccessible(layout), schema.fields[0].key,
            |layout|::FieldAccess::Stable { read: true, write: true, exposure: |layout|::Exposure::Exported }),
        |layout|::BoundaryReach { services: services, service_count: 0 }
    )
}

// Initialize the complete physical region before any virtual alias exists.
// Rejection returns the exact allocation; it cannot be silently merged back
// into an unrelated formal tail or abandoned.
machine prepare_mapping_region(storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant) -> MappingRegionPreparation
reaches |layout|::ResourceProfileSupply
{
    let words: [u64; MAPPING_WORD_COUNT];
    transition |layout|::NativeAccess<MappingRegionPlacement, MappingRegion, |profile|::BootMemory>::initialize(
        storage, MappingRegion { words: words }
    ) {
        |layout|::AccessOutcome::Ready { view } -> (MappingRegionPreparation::Ready { storage: view })
        |layout|::AccessOutcome::Rejected { returned, reason } -> (MappingRegionPreparation::Rejected { storage: returned.source })
    }
}

// Only called after the scoped provider restored and checked the old CR3.
// Each page's distinct endpoints catch repeated/swapped physical frames;
// checking just one page or a shared value would not establish the range.
machine check_mapping_region(storage: &mut |extent|::Extent in |extent|::Granted & |extent|::Resident<MappingRegionPlacement, MappingRegion>) -> bool {
    let view: &mut |layout|::Access<MappingRegionPlacement, MappingRegion> =
        |access|::view_resident_mut<MappingRegionPlacement, MappingRegion>(storage);
    transition { _ -> page(view, 0) }
    machine page(view: &|layout|::Access<MappingRegionPlacement, MappingRegion>, next: u64) -> bool
    requires next <= MAPPING_PAGE_COUNT
    {
        transition next < MAPPING_PAGE_COUNT {
            true -> observe(view, next)
            _ -> true
        }
    }
    machine observe(view: &|layout|::Access<MappingRegionPlacement, MappingRegion>, next: u64) -> bool
    requires next < MAPPING_PAGE_COUNT
    {
        let first: u64 = |layout|::read(&view.words[next * 512]);
        let last: u64 = |layout|::read(&view.words[next * 512 + 511]);
        transition first == 73 + next && last == 97 + next {
            true -> page(view, next + 1)
            _ -> false
        }
    }
}
