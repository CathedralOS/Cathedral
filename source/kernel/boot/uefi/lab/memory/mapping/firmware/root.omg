use {omega}/language/core/extent.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/access/access.omg;

public data FirmwareMemory {}
public boundary trait FirmwareMemorySupply: |layout|::ResourceProfileSupply<FirmwareMemory> {}

// Admission covers the actual CR3 root and its reachable table pages accepted
// from this boot's complete final map, plus the known initial-storage page
// used to check role isolation. All are observed after exit with their grants
// retained. During this closed uniprocessor boot, firmware table topology is
// quiescent except for hardware accessed/dirty updates. Identity mapping and
// physical backing must remain valid for the lifetime of that grant. Hardware
// may update accessed/dirty bits; no Stable access or CPU write is promised.
// Selecting this role alone cannot turn arbitrary geometry into table access.
FirmwareMemoryProfileProvider satisfies FirmwareMemorySupply {
    machine profile(storage: &|extent|::Extent in |extent|::Granted) -> |layout|::ResourceProfile {
        let services: [u64; 32];
        let mut transfers: [|layout|::TransferRule; 16];
        transfers[0] = |layout|::TransferRule { width_bits: 64, alignment_bytes: 8 };
        let mut regions: [|layout|::ResourceRegion; 32];
        regions[0] = |layout|::ResourceRegion {
            range: |layout|::RelativeRange { offset: 0, length: storage.length },
            peer: |layout|::PeerWritability::HostileShared,
            stable: |layout|::StableCapability::None,
            external: |layout|::ExternalCapability::Access {
                read: |layout|::ExternalReadBehavior::Repeatable, write: false,
                transfers: |layout|::TransferRules { entries: transfers, rule_count: 1 },
            },
            atomic: |layout|::AtomicCapability::None,
            reach: |layout|::BoundaryReach { services: services, service_count: 0 },
        };
        |layout|::ResourceProfile { regions: regions, region_count: 1 }
    }
}

// The firmware root remains active while it is observed. Hardware may set
// accessed bits, so a Stable borrow would assert a property we do not own.
// This view copies full-width entries without claiming resident custody or
// changing their permissions. The caller must retain the original table
// closure and supply an admitted profile for this exact granted range.
public data FirmwarePageRoot {
    entries: [u64; 512];
}

public data FirmwarePageRootPlacement {}
data PagingHandoff {}

data FirmwareRootSnapshot {
    case Unavailable;
    case Ready(entries: [u64; 512]);
}

// The live root must contain at least one present entry to execute this kernel.
// This only checks an observed snapshot, not a coherent transitive hierarchy.
machine PagingHandoff::has_present_entry(entries: &[u64; 512]) -> bool {
    transition { _ -> scan(entries, 0, false) }
    machine scan(entries: &[u64; 512], next: u64, found: bool) -> bool
    requires next <= 512
    {
        transition next < 512 {
            true -> inspect(entries, next, found)
            _ -> found
        }
    }
    machine inspect(entries: &[u64; 512], next: u64, found: bool) -> bool
    requires next < 512
    {
        transition { _ -> scan(entries, next + 1, found || (entries[next] & 1) != 0) }
    }
}

machine FirmwarePageRootPlacement::plan(schema: |layout|::Schema) -> |layout|::AccessPlan {
    let mut fields: [|layout|::FieldEntry; 64];
    fields[0] = |layout|::FieldEntry {
        key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 },
    };
    let services: [u64; 32];
    let layout: |layout|::LayoutPlan = |layout|::LayoutPlan {
        entries: fields, entry_count: 1, size_fixed: 4096,
        size_is_dynamic: false, align: 4096,
    };
    |layout|::AccessPlan::with_reach(
        |layout|::AccessPlan::with(|layout|::AccessPlan::inaccessible(layout), schema.fields[0].key,
            |layout|::FieldAccess::External {
                read: |layout|::ExternalRead::Read, write: false, exposure: |layout|::Exposure::Exported,
            }),
        |layout|::BoundaryReach { services: services, service_count: 0 }
    )
}

machine PagingHandoff::snapshot<Role>(root: &|extent|::Extent in |extent|::Granted) -> FirmwareRootSnapshot
reaches |layout|::ResourceProfileSupply
{
    let entries: [u64; 512];
    let opened: |layout|::AccessOutcome<&|layout|::Access<FirmwarePageRootPlacement, FirmwarePageRoot>, |layout|::AccessBorrowReturn, |layout|::AccessInitializationFailure> =
        |access|::view_extent<FirmwarePageRootPlacement, FirmwarePageRoot, Role>(root);
    transition opened {
        |layout|::AccessOutcome::Ready { view } -> copy(view, 0, entries)
        |layout|::AccessOutcome::Rejected { returned, reason } -> FirmwareRootSnapshot::Unavailable
    }

    machine copy(view: &|layout|::Access<FirmwarePageRootPlacement, FirmwarePageRoot>,
               next: u64, entries: [u64; 512]) -> FirmwareRootSnapshot
    requires next <= 512
    {
        transition next < 512 {
            true -> read(view, next, entries)
            _ -> FirmwareRootSnapshot::Ready { entries: entries }
        }
    }

    machine read(view: &|layout|::Access<FirmwarePageRootPlacement, FirmwarePageRoot>,
               next: u64, entries: [u64; 512]) -> FirmwareRootSnapshot
    requires next < 512
    {
        let mut copied: [u64; 512] = entries;
        copied[next] = |layout|::read(&view.entries[next]);
        transition { _ -> copy(view, next + 1, copied) }
    }
}
