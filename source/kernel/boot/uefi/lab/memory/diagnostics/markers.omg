    asm { out 1016, 111 } // o
    asm { out 1016, 114 } // r
    asm { out 1016, 121 } // y
    asm { out 1016, 32 }
    asm { out 1016, 99 }  // c
    asm { out 1016, 104 } // h
    asm { out 1016, 101 } // e
    asm { out 1016, 99 }  // c
    asm { out 1016, 107 } // k
    asm { out 1016, 101 } // e
    asm { out 1016, 100 } // d
    asm { out 1016, 13 }
    asm { out 1016, 10 }
}

