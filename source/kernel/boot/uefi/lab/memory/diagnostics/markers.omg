// Fixed serial marker bursts. The lab waits for COM1 before each call;
// these leaves neither poll nor decide whether the memory step succeeded.
use omega::language::core::assembly;

public data BootMarkers {}

public machine BootMarkers::handoff_received() reaches PortIo {
    asm { out 1016, 66 } // Boot map ready
    asm { out 1016, 111 }
    asm { out 1016, 111 }
    asm { out 1016, 116 }
    asm { out 1016, 32 }
    asm { out 1016, 109 }
    asm { out 1016, 97 }
    asm { out 1016, 112 }
    asm { out 1016, 32 }
    asm { out 1016, 114 }
    asm { out 1016, 101 }
    asm { out 1016, 97 }
    asm { out 1016, 100 }
    asm { out 1016, 121 }
    asm { out 1016, 13 }
    asm { out 1016, 10 }
}

public machine BootMarkers::entered() reaches PortIo {
    asm { out 1016, 75 }   // K
    asm { out 1016, 101 }  // e
    asm { out 1016, 114 }  // r
    asm { out 1016, 110 }  // n
    asm { out 1016, 101 }  // e
    asm { out 1016, 108 }  // l
    asm { out 1016, 32 }
    asm { out 1016, 101 }  // e
    asm { out 1016, 110 }  // n
    asm { out 1016, 116 }  // t
    asm { out 1016, 101 }  // e
    asm { out 1016, 114 }  // r
    asm { out 1016, 101 }  // e
    asm { out 1016, 100 }  // d
    asm { out 1016, 13 }
    asm { out 1016, 10 }
}

public machine BootMarkers::partitioned() reaches PortIo {
    asm { out 1016, 77 }  // M
    asm { out 1016, 101 } // e
    asm { out 1016, 109 } // m
    asm { out 1016, 111 } // o
    asm { out 1016, 114 } // r
    asm { out 1016, 121 } // y
    asm { out 1016, 32 }
    asm { out 1016, 115 } // s
    asm { out 1016, 112 } // p
    asm { out 1016, 108 } // l
    asm { out 1016, 105 } // i
    asm { out 1016, 116 } // t
    asm { out 1016, 13 }
    asm { out 1016, 10 }
}

