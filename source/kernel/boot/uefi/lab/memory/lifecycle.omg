use {omega}/language/core/extent.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/access/access.omg;
use {alloc}/bump.omg;
use memory/profile.omg;

public data KernelWord { value: u64; }
public data KernelWordPlacement {}
data KernelMemory {}

// Initialize and extract kernel words using the memory library. Build selects
// this implementation for the KernelWordPlacement policy and KernelWord data.
KernelMemoryPlacement satisfies |layout|::AccessLifecycle<KernelWordPlacement, KernelWord> {
    machine initialize(
        storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
        value: KernelWord
    ) -> |layout|::AccessOutcome<
        |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord>,
        |layout|::AccessReturn<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord>,
        |layout|::AccessInitializationFailure
    >
    reaches |layout|::ResourceProfileSupply
    {
        |layout|::NativeAccess<KernelWordPlacement, KernelWord, |profile|::BootMemory>::initialize(storage, value)
    }

    machine move_out(
        storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord>
    ) -> |layout|::AccessExtraction<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord>
    reaches |layout|::ResourceProfileSupply
    {
        |layout|::NativeAccess<KernelWordPlacement, KernelWord, |profile|::BootMemory>::move_out(storage)
    }
}

machine KernelWordPlacement::plan(schema: |layout|::Schema) -> |layout|::AccessPlan {
    let mut entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry {
        key: schema.fields[0].key,
        representation: |layout|::FieldPlan::At { offset: 0 },
    };
    let layout: |layout|::LayoutPlan = |layout|::LayoutPlan {
        entries: entries, entry_count: 1, size_fixed: 8,
        size_is_dynamic: false, align: 8,
    };
    let access: |layout|::AccessPlan = |layout|::AccessPlan::with(
        |layout|::AccessPlan::inaccessible(layout), schema.fields[0].key,
        |layout|::FieldAccess::Stable { read: true, write: true, exposure: |layout|::Exposure::Exported }
    );
    let services: [u64; 32];
    |layout|::AccessPlan::with_reach(
        access,
        |layout|::BoundaryReach { services: services, service_count: 0 }
    )
}

data KernelMemoryObservation {
    initial: u64;
    updated: u64;
}

data KernelMemoryResult {
    storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    initialized: bool;
    initial: u64;
    updated: u64;
    extracted: u64;
}

// The input is the real retained firmware allocation, never an address-created
// substitute. Ready must encode the value before lending its resident storage;
// rejection returns the original vacant allocation and unconsumed value.
// Neither branch drops the allocation's unused tail.
machine KernelMemory::exercise(storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant) -> KernelMemoryResult
reaches |layout|::ResourceProfileSupply + |layout|::AccessLifecycle
{
    transition |access|::initialize_owned<KernelWordPlacement, KernelWord>(
        storage, KernelWord { value: 17 }
    ) {
        |layout|::AccessOutcome::Ready { view } -> use_resident(view)
        |layout|::AccessOutcome::Rejected { returned, reason } -> rejected(returned)
    }

    machine use_resident(
        storage: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord>
    ) -> KernelMemoryResult {
        let mut active: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord> = storage;
        let observation: KernelMemoryObservation = KernelMemory::overwrite(
            |access|::view_resident_mut<KernelWordPlacement, KernelWord>(&mut active), 29
        );
        let returned: |layout|::AccessReturn<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord> =
            |access|::move_out_owned<KernelWordPlacement, KernelWord>(active);
        KernelMemoryResult {
            storage: returned.source, initialized: true,
            initial: observation.initial, updated: observation.updated,
            extracted: returned.custody.value,
        }
    }

    machine rejected(
        returned: |layout|::AccessReturn<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord>
    ) -> KernelMemoryResult {
        KernelMemoryResult {
            storage: returned.source, initialized: false,
            initial: 0, updated: 0, extracted: returned.custody.value,
        }
    }
}

// Exercise empty, interior and exhausted partitions on the real allocation
// before accessing it. Reconstructed geometry must retain the original backing
// through checked common-root ancestry, not through a fresh provider grant.
machine KernelMemory::reunite_partition(
    storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant, requested: u64
) -> |extent|::Extent
requires requested <= storage.length
ensures result in |extent|::Granted & |extent|::Vacant,
        result.base == storage.base,
        result.length == storage.length,
        |extent|::Granted::content(old(&storage)) == |extent|::Granted::content(&result),
        |extent|::Vacant::content(old(&storage)) == |extent|::Vacant::content(&result)
{
    let parts: |extent|::VacantExtentParts = |extent|::split_vacant_extent(storage, requested);
    let { base as prefix_base, length as prefix_length } = parts.taken;
    let { base as remainder_base, length as remainder_length } = parts.rest;
    |extent|::Extent { base: prefix_base, length: prefix_length + remainder_length }
}

// Keep the mutation across a helper boundary. The view ends before whole-value
// extraction; ending this loan alone cannot turn resident content into vacancy.
machine KernelMemory::overwrite(
    view: &mut |layout|::Access<KernelWordPlacement, KernelWord>, replacement: u64
) -> KernelMemoryObservation {
    let initial: u64 = |layout|::read(&view.value);
    |layout|::write(&mut view.value, replacement);
    let updated: u64 = |layout|::read(&view.value);
    KernelMemoryObservation { initial: initial, updated: updated }
}

// Preserve all descendants, including rejected initialization paths and any
// allocation unexpectedly returned by the exhaustion probe. A failed runtime
// oracle must not discard that allocation's linear custody.
// This boot witness does not merge independently received formal roots: the
// allocator's modular return/reset contract is a separate owner decision.
data KernelAllocationProbe {
    attempt: |bump|::Attempt;
    preserved: bool;
}

data KernelMemoryPair {
    first: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    second: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant;
    probe: KernelAllocationProbe;
    verified: bool;
}

machine KernelMemory::allocation_exhausted(attempt: &|bump|::Attempt) -> bool {
    transition attempt {
        |bump|::Attempt::Exhausted -> true
        _ -> false
    }
}

// Initialize two disjoint children concurrently, mutate each through the same
// ordinary placement path, and read the first again after mutating the second.
// A wrong alias, lost borrow restoration or native address calculation cannot
// pass merely by returning the requested scalar lengths.
machine KernelMemory::exercise_pair(storage: |extent|::Extent in |extent|::Granted & |extent|::Vacant) -> KernelMemoryPair
requires storage.length >= 16
reaches |layout|::ResourceProfileSupply + |layout|::AccessLifecycle
{
    let available: u64 = storage.length;
    let mut strategy: |bump|::Bump = |bump|::Bump::open(storage);
    let first: |extent|::Extent in |extent|::Granted & |extent|::Vacant = |bump|::allocate(&mut strategy, 8, available);
    let second: |extent|::Extent in |extent|::Granted & |extent|::Vacant = |bump|::allocate(&mut strategy, 8, available - 8);
    // The original capacity exceeds the residual by sixteen bytes. Observe
    // rejection and unchanged geometry without using the observation to grant
    // custody or to establish another allocation's static capacity premise.
    let residual_base: address = strategy.tail.base;
    let residual_length: u64 = strategy.tail.length;
    let residual_capacity: u64 = strategy.remaining;
    let attempt: |bump|::Attempt = |bump|::try_allocate(&mut strategy, available);
    let preserved: bool = KernelMemory::allocation_exhausted(&attempt) &&
        strategy.tail.base == residual_base && strategy.tail.length == residual_length &&
        strategy.remaining == residual_capacity;
    let probe: KernelAllocationProbe = KernelAllocationProbe {
        attempt: attempt, preserved: preserved,
    };
    let tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant = strategy.tail;
    transition |access|::initialize_owned<KernelWordPlacement, KernelWord>(
        first, KernelWord { value: 17 }
    ) {
        |layout|::AccessOutcome::Ready { view } -> initialize_second(view, second, tail, probe)
        |layout|::AccessOutcome::Rejected { returned, reason } -> KernelMemoryPair {
            first: returned.source, second: second, tail: tail, probe: probe, verified: false,
        }
    }

    machine initialize_second(
        first: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord>,
        second: |extent|::Extent in |extent|::Granted & |extent|::Vacant, tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant,
        probe: KernelAllocationProbe
    ) -> KernelMemoryPair {
        transition |access|::initialize_owned<KernelWordPlacement, KernelWord>(
            second, KernelWord { value: 41 }
        ) {
            |layout|::AccessOutcome::Ready { view } -> observe(first, view, tail, probe)
            |layout|::AccessOutcome::Rejected { returned, reason } -> reject_second(first, returned, tail, probe)
        }
    }

    machine reject_second(
        first: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord>,
        second: |layout|::AccessReturn<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord>,
        tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, probe: KernelAllocationProbe
    ) -> KernelMemoryPair {
        let returned: |layout|::AccessReturn<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord> =
            |access|::move_out_owned<KernelWordPlacement, KernelWord>(first);
        KernelMemoryPair {
            first: returned.source, second: second.source, tail: tail, probe: probe, verified: false,
        }
    }

    machine observe(
        first: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord>,
        second: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord>,
        tail: |extent|::Extent in |extent|::Granted & |extent|::Vacant, probe: KernelAllocationProbe
    ) -> KernelMemoryPair {
        let mut first_active: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord> = first;
        let mut second_active: |extent|::Extent in |extent|::Granted & |extent|::Resident<KernelWordPlacement, KernelWord> = second;
        let first_observation: KernelMemoryObservation = KernelMemory::overwrite(
            |access|::view_resident_mut<KernelWordPlacement, KernelWord>(&mut first_active), 29
        );
        let second_observation: KernelMemoryObservation = KernelMemory::overwrite(
            |access|::view_resident_mut<KernelWordPlacement, KernelWord>(&mut second_active), 73
        );
        let first_after_second: u64 = KernelMemory::read(
            |access|::view_resident_mut<KernelWordPlacement, KernelWord>(&mut first_active)
        );
        let first_returned: |layout|::AccessReturn<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord> =
            |access|::move_out_owned<KernelWordPlacement, KernelWord>(first_active);
        let second_returned: |layout|::AccessReturn<|extent|::Extent in |extent|::Granted & |extent|::Vacant, KernelWord> =
            |access|::move_out_owned<KernelWordPlacement, KernelWord>(second_active);
        let verified: bool = probe.preserved &&
            first_observation.initial == 17 && first_observation.updated == 29 &&
            second_observation.initial == 41 && second_observation.updated == 73 &&
            first_after_second == 29 && first_returned.custody.value == 29 &&
            second_returned.custody.value == 73;
        KernelMemoryPair {
            first: first_returned.source, second: second_returned.source,
            tail: tail, probe: probe, verified: verified,
        }
    }
}

machine KernelMemory::read(view: &mut |layout|::Access<KernelWordPlacement, KernelWord>) -> u64 {
    |layout|::read(&view.value)
}
