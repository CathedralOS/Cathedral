use context.omg;
use serial.omg;
use {omega}/language/core/interrupt.omg;
use {omega}/language/core/static_interrupt.omg;
use {omega}/language/core/assembly.omg;
use {arch}/isa/x86_64/interrupts/entry.omg;
use {arch}/board/pc/timer/pic.omg;
use {arch}/board/pc/timer/timer.omg;
use {core}/timing/wake.omg;

public BootstrapTimerHandler satisfies |entry|::CathedralTimerRoot {
    machine enter(acknowledgement: |interrupt|::InterruptAcknowledgement in |interrupt|::Pending)
    reaches |assembly|::MachineControl + |assembly|::PortIo {
        publish_tick(&acknowledgement);
        complete_installed_interrupt<|pic|::PicTimerAcknowledgement::complete>(acknowledgement);
    }
}

// This CPU's masked timer is the sole tick writer. A fatal nested entry never
// returns. Stop before overflow: no wrapped value can become a wake timestamp.
machine publish_tick(acknowledgement: &|interrupt|::InterruptAcknowledgement)
requires acknowledgement in |interrupt|::InterruptAcknowledgement::Pending
reaches |assembly|::MachineControl {
    let context: &|context|::BootstrapInterruptContext =
        view_static_interrupt_context<|context|::BootstrapInterruptContext>(acknowledgement);
    let previous: u64 = context.ticks.load(NoOrdering);
    transition previous < 18446744073709551615u64 {
        true -> advance(context, previous)
        _ -> exhausted()
    }
    machine advance(context: &|context|::BootstrapInterruptContext, previous: u64)
    requires previous < 18446744073709551615u64 {
        let current: u64 = previous + 1;
        context.ticks.store(current, NoOrdering);
        |wake|::TimerRootWakeState::record_and_publish(&context.wake, current);
    }
    machine exhausted() ensures false {
        asm { cli; hlt }
        transition { _ -> exhausted() }
    }
}

public TimerEventLoop satisfies |static_interrupt|::StaticInterruptWork<|context|::BootstrapInterruptContext> {
    machine run(context: &|context|::BootstrapInterruptContext)
    reaches |assembly|::MachineControl + |assembly|::PortIo ensures false { timer_work(context) }
}

// Scope invokes Work only after publishing the complete table and retaining
// its code, context and stacks. PIC/PIT preparation leaves IRQs masked until
// the separate unmask. CLI plus clear/claim and STI;HLT close the lost-wake gap.
machine timer_work(context: &|context|::BootstrapInterruptContext)
reaches |assembly|::MachineControl + |assembly|::PortIo ensures false {
    let mut provider: |timer|::LegacyPicPitTimerProvider;
    |timer|::LegacyPicPitTimerProvider::prepare_masked(&mut provider);
    |pic|::Pic8259::unmask_timer(&mut provider.pic);
    transition { _ -> wait(context, 0u64, 0u64) }

    machine wait(context: &|context|::BootstrapInterruptContext, previous: u64, observed: u64)
    requires observed <= 8 {
        asm { cli }
        transition |wake|::TimerRootWakeState::claim_pending(&context.wake) {
            |wake|::TimerRootWakeClaim::Idle -> sleep(context, previous, observed)
            |wake|::TimerRootWakeClaim::Claimed { observed_time } -> received(context, previous, observed, observed_time)
        }
    }
    machine sleep(context: &|context|::BootstrapInterruptContext, previous: u64, observed: u64)
    requires observed <= 8 {
        asm { sti; hlt }
        transition { _ -> wait(context, previous, observed) }
    }
    machine received(context: &|context|::BootstrapInterruptContext, previous: u64,
                     observed: u64, current: u64)
    requires observed <= 8 {
        transition current >= previous
            && context.before == 0x13579BDF2468ACE0u64
            && context.after == 0xFEDCBA9876543210u64 {
            true -> compare(context, previous, observed, current)
            _ -> |serial|::timer_failed()
        }
    }
    machine compare(context: &|context|::BootstrapInterruptContext, previous: u64,
                    observed: u64, current: u64)
    requires observed <= 8 {
        transition current > previous {
            true -> advanced(context, current, observed)
            _ -> wait(context, previous, observed)
        }
    }
    machine advanced(context: &|context|::BootstrapInterruptContext, current: u64, observed: u64)
    requires observed <= 8 {
        transition observed < 8 {
            true -> count(context, current, observed)
            _ -> wait(context, current, observed)
        }
    }
    machine count(context: &|context|::BootstrapInterruptContext, current: u64, observed: u64)
    requires observed < 8 {
        |serial|::serial_byte(46);
        let next: u64 = observed + 1;
        transition next == 8 {
            true -> report(context, current, next)
            _ -> wait(context, current, next)
        }
    }
    machine report(context: &|context|::BootstrapInterruptContext, current: u64, observed: u64)
    requires observed <= 8 {
        |serial|::timer_wakes_observed();
        transition { _ -> wait(context, current, observed) }
    }
}
