use entries::fatal::FatalVector12;
use entries::fatal::FatalVector13;
use entries::fatal::FatalVector14;
use entries::fatal::FatalVector15;
use entries::fatal::FatalVector16;
use entries::fatal::FatalVector17;
use entries::fatal::FatalVector18;
use entries::fatal::FatalVector19;
use entries::fatal::FatalVector20;
use entries::fatal::FatalVector21;
