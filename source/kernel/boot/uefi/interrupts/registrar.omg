use {omega}/language/core/assembly.omg;
use {std}/calling.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/static_interrupt.omg;
use table.omg;
use context.omg;
use entries/fatal.omg;
use arrivals.omg;
use timer.omg;
use {arch}/isa/x86_64/interrupts/entry.omg;
use {arch}/isa/x86_64/interrupts/task_state.omg;
use {arch}/board/pc/timer/pic.omg;

public boundary trait BootstrapInterruptRegistrar: |calling|::Calling<BootstrapInterruptRegistrarCalling> {
    machine install<machine Fatal00, machine Fatal01, machine Fatal02, machine Fatal03, machine Fatal04, machine Fatal05, machine Fatal06, machine Fatal07, machine Fatal08, machine Fatal09, machine Fatal10, machine Fatal11, machine Fatal12, machine Fatal13, machine Fatal14, machine Fatal15, machine Fatal16, machine Fatal17, machine Fatal18, machine Fatal19, machine Fatal20, machine Fatal21, machine Fatal22, machine Fatal23, machine Fatal24, machine Fatal25, machine Fatal26, machine Fatal27, machine Fatal28, machine Fatal29, machine Fatal30, machine Fatal31, machine Timer>(
        table: &mut |table|::BootstrapIdt, storage: &mut |task_state|::TaskStateStorage,
        context: &|context|::BootstrapInterruptContext, profile: &|arrivals|::ProfileArrivalFrames
    ) -> bool
    requires machine Fatal00 satisfies |fatal|::FatalVector00::enter;
    requires machine Fatal01 satisfies |fatal|::FatalVector01::enter;
    requires machine Fatal02 satisfies |fatal|::FatalVector02::enter;
    requires machine Fatal03 satisfies |fatal|::FatalVector03::enter;
    requires machine Fatal04 satisfies |fatal|::FatalVector04::enter;
    requires machine Fatal05 satisfies |fatal|::FatalVector05::enter;
    requires machine Fatal06 satisfies |fatal|::FatalVector06::enter;
    requires machine Fatal07 satisfies |fatal|::FatalVector07::enter;
    requires machine Fatal08 satisfies |fatal|::FatalVector08::enter;
    requires machine Fatal09 satisfies |fatal|::FatalVector09::enter;
    requires machine Fatal10 satisfies |fatal|::FatalVector10::enter;
    requires machine Fatal11 satisfies |fatal|::FatalVector11::enter;
    requires machine Fatal12 satisfies |fatal|::FatalVector12::enter;
    requires machine Fatal13 satisfies |fatal|::FatalVector13::enter;
    requires machine Fatal14 satisfies |fatal|::FatalVector14::enter;
    requires machine Fatal15 satisfies |fatal|::FatalVector15::enter;
    requires machine Fatal16 satisfies |fatal|::FatalVector16::enter;
    requires machine Fatal17 satisfies |fatal|::FatalVector17::enter;
    requires machine Fatal18 satisfies |fatal|::FatalVector18::enter;
    requires machine Fatal19 satisfies |fatal|::FatalVector19::enter;
    requires machine Fatal20 satisfies |fatal|::FatalVector20::enter;
    requires machine Fatal21 satisfies |fatal|::FatalVector21::enter;
    requires machine Fatal22 satisfies |fatal|::FatalVector22::enter;
    requires machine Fatal23 satisfies |fatal|::FatalVector23::enter;
    requires machine Fatal24 satisfies |fatal|::FatalVector24::enter;
    requires machine Fatal25 satisfies |fatal|::FatalVector25::enter;
    requires machine Fatal26 satisfies |fatal|::FatalVector26::enter;
    requires machine Fatal27 satisfies |fatal|::FatalVector27::enter;
    requires machine Fatal28 satisfies |fatal|::FatalVector28::enter;
    requires machine Fatal29 satisfies |fatal|::FatalVector29::enter;
    requires machine Fatal30 satisfies |fatal|::FatalVector30::enter;
    requires machine Fatal31 satisfies |fatal|::FatalVector31::enter;
    requires machine Timer satisfies |entry|::CathedralTimerRoot::enter;
    reaches |assembly|::MachineControl + |assembly|::PortIo
    invokes |static_interrupt|::StaticInterruptTableValidation invokes |static_interrupt|::StaticInterruptWork
    crashes Trap
    ensures result == false;
}

public CheckedBootstrapInterruptRegistrar satisfies BootstrapInterruptRegistrar {
    machine install<machine Fatal00, machine Fatal01, machine Fatal02, machine Fatal03, machine Fatal04, machine Fatal05, machine Fatal06, machine Fatal07, machine Fatal08, machine Fatal09, machine Fatal10, machine Fatal11, machine Fatal12, machine Fatal13, machine Fatal14, machine Fatal15, machine Fatal16, machine Fatal17, machine Fatal18, machine Fatal19, machine Fatal20, machine Fatal21, machine Fatal22, machine Fatal23, machine Fatal24, machine Fatal25, machine Fatal26, machine Fatal27, machine Fatal28, machine Fatal29, machine Fatal30, machine Fatal31, machine Timer>(
        table: &mut |table|::BootstrapIdt, storage: &mut |task_state|::TaskStateStorage,
        context: &|context|::BootstrapInterruptContext, profile: &|arrivals|::ProfileArrivalFrames
    ) -> bool
    requires machine Fatal00 satisfies |fatal|::FatalVector00::enter;
    requires machine Fatal01 satisfies |fatal|::FatalVector01::enter;
    requires machine Fatal02 satisfies |fatal|::FatalVector02::enter;
    requires machine Fatal03 satisfies |fatal|::FatalVector03::enter;
    requires machine Fatal04 satisfies |fatal|::FatalVector04::enter;
    requires machine Fatal05 satisfies |fatal|::FatalVector05::enter;
    requires machine Fatal06 satisfies |fatal|::FatalVector06::enter;
    requires machine Fatal07 satisfies |fatal|::FatalVector07::enter;
    requires machine Fatal08 satisfies |fatal|::FatalVector08::enter;
    requires machine Fatal09 satisfies |fatal|::FatalVector09::enter;
    requires machine Fatal10 satisfies |fatal|::FatalVector10::enter;
    requires machine Fatal11 satisfies |fatal|::FatalVector11::enter;
    requires machine Fatal12 satisfies |fatal|::FatalVector12::enter;
    requires machine Fatal13 satisfies |fatal|::FatalVector13::enter;
    requires machine Fatal14 satisfies |fatal|::FatalVector14::enter;
    requires machine Fatal15 satisfies |fatal|::FatalVector15::enter;
    requires machine Fatal16 satisfies |fatal|::FatalVector16::enter;
    requires machine Fatal17 satisfies |fatal|::FatalVector17::enter;
    requires machine Fatal18 satisfies |fatal|::FatalVector18::enter;
    requires machine Fatal19 satisfies |fatal|::FatalVector19::enter;
    requires machine Fatal20 satisfies |fatal|::FatalVector20::enter;
    requires machine Fatal21 satisfies |fatal|::FatalVector21::enter;
    requires machine Fatal22 satisfies |fatal|::FatalVector22::enter;
    requires machine Fatal23 satisfies |fatal|::FatalVector23::enter;
    requires machine Fatal24 satisfies |fatal|::FatalVector24::enter;
    requires machine Fatal25 satisfies |fatal|::FatalVector25::enter;
    requires machine Fatal26 satisfies |fatal|::FatalVector26::enter;
    requires machine Fatal27 satisfies |fatal|::FatalVector27::enter;
    requires machine Fatal28 satisfies |fatal|::FatalVector28::enter;
    requires machine Fatal29 satisfies |fatal|::FatalVector29::enter;
    requires machine Fatal30 satisfies |fatal|::FatalVector30::enter;
    requires machine Fatal31 satisfies |fatal|::FatalVector31::enter;
    requires machine Timer satisfies |entry|::CathedralTimerRoot::enter;
    reaches |assembly|::MachineControl + |assembly|::PortIo
    invokes |static_interrupt|::StaticInterruptTableValidation invokes |static_interrupt|::StaticInterruptWork
    crashes Trap
    ensures result == false {
        let mut stacks: [|static_interrupt|::StaticInterruptStack; 4] = [
            |static_interrupt|::StaticInterruptStack { words: &mut storage.double_fault_stack[1..512], ist: 1u8 },
            |static_interrupt|::StaticInterruptStack { words: &mut storage.nmi_stack[1..512], ist: 2u8 },
            |static_interrupt|::StaticInterruptStack { words: &mut storage.machine_check_stack[1..512], ist: 3u8 },
            |static_interrupt|::StaticInterruptStack { words: &mut storage.irq_stack[1..512], ist: 4u8 }
        ];
        let arrivals: [|static_interrupt|::StaticInterruptArrival; 33] = |arrivals|::complete_arrivals(profile);
        |static_interrupt|::X86StaticInterruptScope::run<
            BootstrapInterruptRegistrar::install<Fatal00, Fatal01, Fatal02, Fatal03, Fatal04, Fatal05, Fatal06, Fatal07, Fatal08, Fatal09, Fatal10, Fatal11, Fatal12, Fatal13, Fatal14, Fatal15, Fatal16, Fatal17, Fatal18, Fatal19, Fatal20, Fatal21, Fatal22, Fatal23, Fatal24, Fatal25, Fatal26, Fatal27, Fatal28, Fatal29, Fatal30, Fatal31, Timer>, |table|::GateSlot32,
            |table|::BootstrapIdt, |context|::BootstrapInterruptContext, |table|::table_policy,
            |table|::BootstrapInterruptTableValidator::validate, |timer|::TimerEventLoop::run,
            |pic|::PicTimerAcknowledgement::complete, 5
        >(table, &mut storage.gdt, &storage.task_bytes,
            &mut stacks[..], &arrivals[..], context)
    }
}

// Match each of the 33 destinations to its exact callback requirement.
// Binder declaration order and nominal destination order are independent.
public BootstrapInterruptRegistrarCalling satisfies |calling|::CallingPolicy {
    machine plan(signature: |calling|::BoundarySignature) -> |calling|::BoundaryPlanResult {
        transition signature.parameter_count == 4 && signature.native_parameter_count == 4
            && signature.has_result && signature.callback_binder_count == 33
            && signature.callback_demand_count == 33 {
            true -> accept(signature)
            _ -> reject()
        }
        machine accept(signature: |calling|::BoundarySignature) -> |calling|::BoundaryPlanResult { build(signature) }
        machine build(signature: |calling|::BoundarySignature) -> |calling|::BoundaryPlanResult {
            let mut plan: |calling|::BoundaryEntryPlan;
            plan.call.convention = |calling|::CallingConvention::SystemVAMD64;
            plan.call.parameter_count = 4;
            plan.call.parameters[0].shape = |calling|::AbiValueShape { class: |calling|::AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[0].location_count = 1;
            plan.call.parameters[0].locations[0] = |calling|::ValueLocation::Register { register: |calling|::MachineRegister::X86Rdi, value_byte_offset: 0, byte_size: 8 };
            plan.call.parameters[1].shape = |calling|::AbiValueShape { class: |calling|::AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[1].location_count = 1;
            plan.call.parameters[1].locations[0] = |calling|::ValueLocation::Register { register: |calling|::MachineRegister::X86Rsi, value_byte_offset: 0, byte_size: 8 };
            plan.call.parameters[2].shape = |calling|::AbiValueShape { class: |calling|::AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[2].location_count = 1;
            plan.call.parameters[2].locations[0] = |calling|::ValueLocation::Register { register: |calling|::MachineRegister::X86Rdx, value_byte_offset: 0, byte_size: 8 };
            plan.call.parameters[3].shape = |calling|::AbiValueShape { class: |calling|::AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[3].location_count = 1;
            plan.call.parameters[3].locations[0] = |calling|::ValueLocation::Register { register: |calling|::MachineRegister::X86Rcx, value_byte_offset: 0, byte_size: 8 };
            plan.call.has_result = true;
            plan.call.result.shape = |calling|::AbiValueShape { class: |calling|::AbiValueClass::Integer, byte_size: 1, alignment: 1 };
            plan.call.result.location_count = 1;
            plan.call.result.locations[0] = |calling|::ValueLocation::Register { register: |calling|::MachineRegister::X86Rax, value_byte_offset: 0, byte_size: 1 };
            plan.call.callback_materialization_count = 33;
            plan.call.stack_alignment = 16;
            plan.call.entry_control = |calling|::EntryControl::CallReturn;
            plan.state.initial_regime = |calling|::MachineRegime::X86Long64;
            plan.state.permitted_transitive_use.general_registers = true;
            plan.state.permitted_transitive_use.flags = true;
            plan.state.permitted_transitive_use.instruction_pointer = true;
            plan.state.permitted_transitive_use.stack_pointer = true;
            plan.state.permitted_transitive_use.control_state = true;
            plan.state.stack = |calling|::EntryStack::ProviderSelected;
            plan.state.preemption = |calling|::Preemption::NotApplicable;
            transition materialize_slots(&mut plan, &signature, 0, 33) {
                true -> accepted_plan(plan)
                _ -> reject()
            }
        }
        machine accepted_plan(plan: |calling|::BoundaryEntryPlan) -> |calling|::BoundaryPlanResult {
            |calling|::BoundaryPlanResult::Accepted { plan: plan }
        }
        machine reject() -> |calling|::BoundaryPlanResult {
            |calling|::BoundaryPlanResult::Rejected { reason: |calling|::CallingPolicyRejection { reason: "complete exception floor requires four borrows, 33 exact slots and a Boolean refusal result" } }
        }

        machine materialize_slots(plan: &mut |calling|::BoundaryEntryPlan, signature: &|calling|::BoundarySignature,
            index: u64, remaining: u64) -> bool
        terminates by remaining {
            transition index < 33 && remaining > 0 {
                true -> inspect_slot(plan, signature, index, remaining)
                _ -> (index == 33)
            }
            machine inspect_slot(plan: &mut |calling|::BoundaryEntryPlan, signature: &|calling|::BoundarySignature,
                index: u64, remaining: u64) -> bool
            requires index < 33 && remaining > 0 {
                let requirement: u64 = signature.callback_demands[index].requirement;
                let binder: u64 = exact_binder(signature, requirement, 0, 33, false, 0);
                transition binder != 0 && no_earlier_demand(signature, requirement, index, 0, 33) {
                    true -> materialize_slot(plan, signature, index, remaining, binder)
                    _ -> false
                }
            }
            machine materialize_slot(plan: &mut |calling|::BoundaryEntryPlan, signature: &|calling|::BoundarySignature,
                index: u64, remaining: u64, binder: u64) -> bool
            requires index < 33 && remaining > 0 {
                plan.call.callback_materializations[index].binder = binder;
                plan.call.callback_materializations[index].destination = signature.callback_demands[index].destination;
                materialize_slots(plan, signature, index + 1, remaining - 1)
            }
        }
        // A second matching binder is ambiguous. Zero denotes refusal only;
        // actual compiler-issued binder identities are nonzero.
        machine exact_binder(signature: &|calling|::BoundarySignature, requirement: u64,
            index: u64, remaining: u64, found: bool, selected: u64) -> u64
        terminates by remaining {
            transition index < 33 && remaining > 0 {
                true -> inspect_binder(signature, requirement, index, remaining, found, selected)
                _ -> selected
            }
            machine inspect_binder(signature: &|calling|::BoundarySignature, requirement: u64,
                index: u64, remaining: u64, found: bool, selected: u64) -> u64
            requires index < 33 && remaining > 0 {
                transition signature.callback_binders[index].requirement == requirement {
                    true -> matched_binder(signature, requirement, index, remaining, found)
                    _ -> exact_binder(signature, requirement, index + 1, remaining - 1, found, selected)
                }
            }
            machine matched_binder(signature: &|calling|::BoundarySignature, requirement: u64,
                index: u64, remaining: u64, found: bool) -> u64
            requires index < 33 && remaining > 0 {
                transition found {
                    true -> 0
                    _ -> exact_binder(signature, requirement, index + 1, remaining - 1,
                        true, signature.callback_binders[index].binder)
                }
            }
        }
        // Distinct demands plus one unique binder per requirement make the
        // two 33-row rosters a bijection, with no omitted callback contract.
        machine no_earlier_demand(signature: &|calling|::BoundarySignature, requirement: u64,
            stop: u64, index: u64, remaining: u64) -> bool
        terminates by remaining {
            transition index < stop && index < 33 && remaining > 0 {
                true -> inspect_demand(signature, requirement, stop, index, remaining)
                _ -> (index == stop)
            }
            machine inspect_demand(signature: &|calling|::BoundarySignature, requirement: u64,
                stop: u64, index: u64, remaining: u64) -> bool
            requires index < 33 && remaining > 0 {
                transition signature.callback_demands[index].requirement == requirement {
                    true -> false
                    _ -> no_earlier_demand(signature, requirement, stop, index + 1, remaining - 1)
                }
            }
        }

    }
}
