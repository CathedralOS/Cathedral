use {omega}/language/core/static_interrupt.omg;

// Fatal handlers never inspect or return through a hardware frame.
// OpaqueFatal leaves error-word availability unspecified, including reserved slots.
public data ProfileArrivalFrames {
    vector09: |static_interrupt|::StaticInterruptFrame;
    vector15: |static_interrupt|::StaticInterruptFrame;
    vector22: |static_interrupt|::StaticInterruptFrame;
    vector23: |static_interrupt|::StaticInterruptFrame;
