    vector29: |static_interrupt|::StaticInterruptFrame;
    vector30: |static_interrupt|::StaticInterruptFrame;
    vector31: |static_interrupt|::StaticInterruptFrame;
}
public machine fatal_frames() -> ProfileArrivalFrames {
    ProfileArrivalFrames {
        vector09: |static_interrupt|::StaticInterruptFrame::OpaqueFatal,
        vector15: |static_interrupt|::StaticInterruptFrame::OpaqueFatal,
        vector22: |static_interrupt|::StaticInterruptFrame::OpaqueFatal,
        vector23: |static_interrupt|::StaticInterruptFrame::OpaqueFatal,
        vector24: |static_interrupt|::StaticInterruptFrame::OpaqueFatal,
