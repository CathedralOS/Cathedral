use {std}/calling.omg;

// The generated arrival code reads IDT, GDT and task-register state. Include
// those reads in each policy without claiming that it overwrites control state.

// The checked body cannot return. Its interrupted activation has no resumed
// continuation to preserve. InterruptReturn names the arrival family; the
// admitted fatal protocol never restores or returns through the opaque frame.
public InterruptedFatalCalling satisfies |calling|::CallingPolicy {
    machine plan(signature: |calling|::BoundarySignature) -> |calling|::BoundaryPlanResult {
        transition signature.parameter_count == 1 && !signature.has_result {
            true -> accept()
            _ -> reject()
        }
        machine accept() -> |calling|::BoundaryPlanResult {
            let mut plan: |calling|::BoundaryEntryPlan;
            plan.call.convention = |calling|::CallingConvention::SystemVAMD64;
            plan.call.parameter_count = 1;
            plan.call.parameters[0].shape = |calling|::AbiValueShape { class: |calling|::AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[0].location_count = 1;
            plan.call.parameters[0].locations[0] = |calling|::ValueLocation::Register { register: |calling|::MachineRegister::X86Rdi, value_byte_offset: 0, byte_size: 8 };
            plan.call.stack_alignment = 16;
            plan.call.entry_control = |calling|::EntryControl::InterruptReturn;
            plan.state.initial_regime = |calling|::MachineRegime::X86Long64;
            plan.state.permitted_transitive_use.general_registers = true;
            plan.state.permitted_transitive_use.flags = true;
            plan.state.permitted_transitive_use.instruction_pointer = true;
            plan.state.permitted_transitive_use.stack_pointer = true;
            plan.state.permitted_transitive_use.control_state = true;
            plan.state.stack = |calling|::EntryStack::Interrupted;
            plan.state.preemption = |calling|::Preemption::Masked;
            |calling|::BoundaryPlanResult::Accepted { plan: plan }
        }
        machine reject() -> |calling|::BoundaryPlanResult {
            |calling|::BoundaryPlanResult::Rejected { reason: |calling|::CallingPolicyRejection { reason: "fatal entry requires its installed context and cannot return" } }
        }
    }
}

