module entries::fatal;
use std::calling;
use context::BootstrapInterruptContext;
use entries::calling::InterruptedFatalCalling;
use entries::calling::DoubleFaultCalling;
use entries::calling::NmiFatalCalling;
use entries::calling::MachineCheckCalling;
use arch::isa::x86_64::interrupts::fatal::BootstrapFatalExceptionDiagnosticState;

// Installing the table binds this shared context to every handler.
// The CPU arrival frame does not supply the context argument.

public boundary trait FatalVector00: Calling<InterruptedFatalCalling> {
    machine enter(context: &BootstrapInterruptContext) reaches crashes Abort ensures false;
}
public FatalHandler00 satisfies FatalVector00 {
    machine enter(context: &BootstrapInterruptContext) reaches crashes Abort ensures false {
        BootstrapFatalExceptionDiagnosticState::record_and_abort(&context.fatal[0], 0u32);
    }
}

