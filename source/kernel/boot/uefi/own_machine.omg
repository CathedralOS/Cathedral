// source/boot/uefi/own_machine.omg
//
// MILESTONE 2 — own the machine. Get the firmware memory map, walk it for free
// RAM, ExitBootServices, and grant the jointly checked image and initial-storage
// extents — the origin of Cathedral's authority graph. Runs after the
// milestone-1 greeting (con_out still works before exit).
//
// MILESTONE 3 — the first driver speaks. After the grant, the 16550 UART (COM1)
// we now drive DIRECTLY — no firmware, no protocol — reports "Owned N MiB",
// then transfers both roots into the selected kernel. Reaching the report observes the
// M2 chain: the machine only arrives there after a successful map walk, a
// successful ExitBootServices, and the admitted grant.

use uefi::uefi;            // EfiHandle, EfiSystemTable, EfiStatus
use uefi::boot_services;   // MapKey, BootServicesTable and callable services
use memory::memory_map;    // EfiMemoryDescriptor and memory type/attribute data
use core::extent;          // PAGE_SIZE + checked ExtentRootProvider adapter
use core::boot_geometry;   // numeric joint geometry; never backing authority
use omega::language::core::assembly; // PortIo, MachineControl
use omega::language::core::extent;   // Extent, Granted, ExtentRootProvider
use omega::language::core::layout;
use boot_handoff;

// Conservative runtime geometry ceiling for one page-count multiplication.
// This is ordinary Cathedral policy over firmware data, not evidence that the
// described pages are RAM or owned. The final end check below also requires a
// representable u64 one-past address, intentionally rejecting the otherwise
// valid architectural edge ending exactly at 2^64.
const MAX_BOOTSTRAP_PAGE_COUNT: u64 = 4503599627370495;

// Per-burst work budget for a stuck or absent 16550. This bounds status reads,
// not elapsed time; exhaustion abandons the optional report and retains the
// granted roots through kernel entry without writing into a busy transmitter.
const MAX_UART_STATUS_POLLS: u64 = 1000000;

// The leading u64 gives the following byte array an 8-byte-aligned base under
// Omega's ordinary record layout. UEFI writes only `bytes`; `alignment_anchor`
// is representation padding made explicit in Cathedral source and carries no
// capability or validity fact.
public data UefiMemoryMapStorage {
    alignment_anchor: u64;
    bytes: [u8; 65536];
}

// Keep the jointly validated, separately granted roots together throughout
// reporting. Its fields retain the two linear debts; the container declares
// no additional nominal obligation. The semantic handoff consumes both fields.
data KernelRoots {
    image: Extent in Granted;
    initial_storage: Extent in Granted;
}

// Get the map, walk it, exit, grant, report.
// The physical x64 entry selects a 64-bit address representation explicitly.
// Carry that premise through the map transaction: it proves representation fit
// for EFI_PHYSICAL_ADDRESS, not mapping, RAM ownership or storage authority.
// UEFI 2.11 sections 2.3.4 and 7.2 retain those separate platform obligations.
// https://uefi.org/specs/UEFI/2.11/02_Overview.html#x64-platforms
//
// `context.map_buf.bytes` is fixed
// 64-KiB static storage behind an explicit 8-byte alignment anchor, not
// allocated memory and not an Extent. Cathedral advertises 16 KiB first and
// uses the remaining provision only after an exact EFI_BUFFER_TOO_SMALL result
// reports a requirement within the fixed ceiling.
machine Main::own_machine(context: &mut Main, handle: EfiHandle, table: &EfiSystemTable)
reaches BootServices + ExtentRootProvider + ProgramStorageEntry + ResourceProfileSupply + PortIo + MachineControl
requires addr::Bound == 18446744073709551616
{
    // The boundary vouches the reference shape, not arbitrary firmware field
    // contents. Fail closed before projecting or dispatching through Boot
    // Services unless the enclosing table has its standard identity, covers
    // the complete prefix Cathedral declares, and keeps Reserved zero.
    transition table.header.signature == EFI_SYSTEM_TABLE_SIGNATURE &&
               table.header.revision >= EFI_MIN_SUPPORTED_REVISION &&
               table.header.header_size >= EFI_SYSTEM_TABLE_REQUIRED_SIZE &&
               table.header.reserved == 0 {
        true -> validate_boot_services(context, handle, table)
        _    -> idle()
    }

    state validate_boot_services(context: &mut Main, handle: EfiHandle,
                                 table: &EfiSystemTable)
    requires addr::Bound == 18446744073709551616
    {
        let bs: &BootServicesTable = table.boot_services;
        transition bs.hdr.signature == EFI_BOOT_SERVICES_SIGNATURE &&
                   bs.hdr.revision == table.header.revision &&
                   bs.hdr.header_size >= EFI_BOOT_SERVICES_REQUIRED_SIZE &&
                   bs.hdr.reserved == 0 {
            true -> refresh_map(context, bs, handle, 0)
            _    -> idle()
        }
    }

    // Get a fresh map and its inseparable key. This state is also the only
    // retry target after ExitBootServices reports EFI_INVALID_PARAMETER: the
    // old key and every descriptor-derived candidate are discarded together.
    state refresh_map(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                      stale_retry_used: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition { _ -> get_map(context, bs, handle, stale_retry_used, 16384) }
    }

    state get_map(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                  stale_retry_used: u64,
                  attempted_capacity: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1 && 16384 <= attempted_capacity && attempted_capacity <= 65536
    {
        let mut map_size: u64 = attempted_capacity; // in = capacity, out = actual/needed
        let mut key: MapKey = MapKey { raw: 0 };
        let mut desc_size: u64 = 0;                 // out = the RUNTIME descriptor stride
        let mut desc_version: u32 = 0;
        let status: EfiStatus = BootServices::get_memory_map(
            bs,
            &mut map_size,
            &mut context.map_buf.bytes,
            &mut key,
            &mut desc_size,
            &mut desc_version
        );
        let status_code: u64 = status.code;
        context.final_map_size = map_size;
        context.final_descriptor_size = desc_size;

        // Sanity-gate the firmware's out-values BEFORE trusting them: the call
        // must report SUCCESS with the exact descriptor revision this source
        // understands, fit both the advertised capacity and physical backing,
        // and contain a whole number of naturally aligned runtime-sized
        // descriptors. A guard — not a vouched `ensures` — because
        // firmware genuinely can return malformed values; these conjuncts are
        // also the bound and alignment witnesses for the walk's recast.
        transition status_code == 0 &&
                   desc_version == EFI_MEMORY_DESCRIPTOR_VERSION &&
                   desc_size >= 40 && desc_size <= 65536 &&
                   desc_size % 8 == 0 &&
                   map_size >= desc_size &&
                   map_size <= attempted_capacity && map_size <= 65536 &&
                   map_size % desc_size == 0 {
            true -> walk(context, bs, handle, stale_retry_used,
                         map_size as u64 in Trapping, desc_size as u64 in Trapping,
                         key, 0, 0, 0, 0)
            _    -> map_failed(context, bs, handle, stale_retry_used,
                               attempted_capacity, status_code, map_size)
        }
    }

    // Only the exact capacity signal may expand the advertised window, and
    // only once. Key, descriptor size/version, and all buffer contents from the
    // failed call are ignored. A requirement above the static ceiling parks.
    state map_failed(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                     stale_retry_used: u64,
                     attempted_capacity: u64,
                     status_code: u64, required_size: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1 && 16384 <= attempted_capacity && attempted_capacity <= 65536
    {
        transition attempted_capacity == 16384 && status_code == EFI_BUFFER_TOO_SMALL.code && required_size > 16384 && required_size <= 65536 {
            true -> get_map(context, bs, handle, stale_retry_used, 65536)
            _    -> idle()
        }
    }

    // Walk descriptors: stride by the aligned RUNTIME desc_size (never sizeof),
    // recast each slice to &EfiMemoryDescriptor, and track the largest
    // conventional-memory span that is neither reserved for UEFI runtime
    // mapping, removable, nor earmarked for a specific-purpose consumer.
    // Split walk/step so each transition carries ONE inline guard: walk
    // decides the best-span update, step decides whether a WHOLE next
    // descriptor fits — bounding its END (`offset + 2*desc_size <= map_size`),
    // not just its start, which is what makes the loop edge's footprint
    // discharge (and is semantically free: EDK2 maps are whole descriptors).
    // The state contract retains the recast bound across the cycle. Its entry
    // edge supplies 0; the loop edge proves <= 65496 (65536 buffer bytes minus
    // the 40-byte descriptor footprint) before advancing. `in Trapping` on the walk
    // arithmetic: hostile out-values trip a trap instead of wrapping.
    state walk(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
               stale_retry_used: u64,
               map_size: u64 in Trapping, desc_size: u64 in Trapping, key: MapKey,
               offset: u64 in Trapping, best_start: u64, best_pages: u64,
               best_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1 && offset <= 65496
    {
        let d: &EfiMemoryDescriptor = &context.map_buf.bytes[offset] as &EfiMemoryDescriptor;
        let is_free: bool = d.kind == EFI_CONVENTIONAL_MEMORY &&
                            (d.attribute & EFI_MEMORY_RUNTIME.bits) == 0 &&
                            (d.attribute & EFI_MEMORY_HOT_PLUGGABLE.bits) == 0 &&
                            (d.attribute & EFI_MEMORY_SP.bits) == 0;
        transition is_free && d.number_of_pages > best_pages {
            true -> step(context, bs, handle, stale_retry_used, map_size, desc_size, key,
                         offset, d.physical_start, d.number_of_pages, offset)
            _    -> step(context, bs, handle, stale_retry_used, map_size, desc_size, key,
                         offset, best_start, best_pages, best_offset)
        }
    }

    state step(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
               stale_retry_used: u64,
               map_size: u64 in Trapping, desc_size: u64 in Trapping, key: MapKey,
               offset: u64 in Trapping, best_start: u64, best_pages: u64,
               best_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        // The second conjunct is implied by the first (map_size <= 65536,
        // desc_size >= 40) but spelled out so the loop edge's bound is a
        // DIRECT guard fact for the prover; it costs one always-true compare.
        transition offset + desc_size + desc_size <= map_size && offset + desc_size <= 65496 {
            true -> walk(context, bs, handle, stale_retry_used, map_size, desc_size, key,
                         offset + desc_size, best_start, best_pages, best_offset)
            _    -> validate_candidate(context, bs, handle, stale_retry_used,
                                       map_size, desc_size, key,
                                       best_start, best_pages, best_offset)
        }
    }

    // Before making the irreversible firmware exit, reject an absent or
    // malformed best span. These are only numeric consistency checks over the
    // current map transaction: they mint no RAM, physical-space, rights, or
    // backing fact. Page-count bounding makes the following multiplication
    // exact; alignment follows the UEFI page contract but is checked rather
    // than trusted from raw descriptor bytes.
    state validate_candidate(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                             stale_retry_used: u64,
                             map_size: u64 in Trapping,
                             desc_size: u64 in Trapping, key: MapKey,
                             best_start: u64, best_pages: u64,
                             best_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition best_pages > 0 &&
                   best_pages <= MAX_BOOTSTRAP_PAGE_COUNT &&
                   best_start % PAGE_SIZE == 0 {
            true -> validate_candidate_end(context, bs, handle, stale_retry_used,
                                           map_size, desc_size, key,
                                           best_start, best_pages, best_offset)
            _ -> idle()
        }
    }

    state validate_candidate_end(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                                 stale_retry_used: u64,
                                 map_size: u64 in Trapping,
                                 desc_size: u64 in Trapping, key: MapKey,
                                 best_start: u64,
                                 best_pages: u64,
                                 best_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1 && 1 <= best_pages && best_pages <= 4503599627370495
    {
        let checked_pages: u64 in Trapping = best_pages as u64 in Trapping;
        let checked_length: u64 in Trapping = checked_pages * PAGE_SIZE;
        let length: u64 = checked_length as u64;
        let max_address: u64 = 0xFFFF_FFFF_FFFF_FFFF;
        // The selected span must hold the complete handoff packet before we
        // make the irreversible ExitBootServices call.
        transition length >= BOOT_HANDOFF_BYTES && best_start <= max_address - length {
            true -> prepare_audit(context, bs, handle, stale_retry_used,
                                  map_size, desc_size, key, best_start,
                                  best_pages, length, best_offset)
            _ -> idle()
        }
    }

    // A descriptor's local type does not prove complete UEFI geometry or that
    // its physical range is disjoint from every other map record. Re-scan the
    // same fresh map before exit. Every record must use a standard or vendor-
    // reserved memory type, set only revision-1 standard/ISA attribute bits,
    // and have aligned, representable physical and virtual geometry. After
    // that validation, skip only the selected record's own
    // overlap comparison. Every other range must lie wholly to one side of the
    // chosen conventional span. No ordering assumption is made.
    state prepare_audit(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                        stale_retry_used: u64,
                        map_size: u64 in Trapping,
                        desc_size: u64 in Trapping, key: MapKey,
                        best_start: u64, best_pages: u64, length: u64,
                        best_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        let checked_start: u64 in Trapping = best_start as u64 in Trapping;
        let checked_length: u64 in Trapping = length as u64 in Trapping;
        let best_end: u64 in Trapping = checked_start + checked_length;
        transition { _ -> audit_descriptor(context, bs, handle, stale_retry_used,
                                           map_size, desc_size, key, best_start,
                                           best_pages, length, best_end,
                                           best_offset, 0) }
    }

    state audit_descriptor(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                           stale_retry_used: u64,
                           map_size: u64 in Trapping,
                           desc_size: u64 in Trapping, key: MapKey,
                           best_start: u64, best_pages: u64, length: u64,
                           best_end: u64 in Trapping,
                           best_offset: u64 in Trapping,
                           audit_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1 && audit_offset <= 65496
    {
        let d: &EfiMemoryDescriptor = &context.map_buf.bytes[audit_offset] as &EfiMemoryDescriptor;
        transition { _ -> audit_geometry(context, bs, handle, stale_retry_used,
                                         map_size, desc_size, key,
                                         best_start, best_pages, length,
                                         best_end, best_offset, audit_offset,
                                         d.kind, d.attribute,
                                         d.physical_start, d.virtual_start,
                                         d.number_of_pages) }
    }

    state audit_geometry(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                         stale_retry_used: u64,
                         map_size: u64 in Trapping,
                         desc_size: u64 in Trapping, key: MapKey,
                         best_start: u64, best_pages: u64, length: u64,
                         best_end: u64 in Trapping,
                         best_offset: u64 in Trapping,
                         audit_offset: u64 in Trapping,
                         other_kind: u32, other_attribute: u64,
                         other_start: u64,
                         other_virtual_start: u64,
                         other_pages: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition (other_kind < EFI_MAX_MEMORY_TYPE ||
                    other_kind >= EFI_OEM_MEMORY_TYPE_MIN) &&
                   (other_attribute & EFI_MEMORY_RESERVED_MASK.bits) == 0 &&
                   (other_attribute & EFI_MEMORY_ISA_MASK.bits) <=
                       (other_attribute & EFI_MEMORY_ISA_VALID.bits) &&
                   other_pages > 0 &&
                   other_pages <= MAX_BOOTSTRAP_PAGE_COUNT &&
                   other_start % PAGE_SIZE == 0 &&
                   other_virtual_start % PAGE_SIZE == 0 {
            true -> audit_geometry_end(context, bs, handle, stale_retry_used,
                                       map_size, desc_size, key,
                                       best_start, best_pages, length, best_end,
                                       best_offset, audit_offset,
                                       other_start, other_virtual_start,
                                       other_pages)
            _ -> idle()
        }
    }

    state audit_geometry_end(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                             stale_retry_used: u64,
                             map_size: u64 in Trapping,
                             desc_size: u64 in Trapping, key: MapKey,
                             best_start: u64, best_pages: u64, length: u64,
                             best_end: u64 in Trapping,
                             best_offset: u64 in Trapping,
                             audit_offset: u64 in Trapping,
                             other_start: u64, other_virtual_start: u64,
                             other_pages: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1 && 1 <= other_pages && other_pages <= 4503599627370495
    {
        let checked_pages: u64 in Trapping = other_pages as u64 in Trapping;
        let checked_length: u64 in Trapping = checked_pages * PAGE_SIZE;
        let other_length: u64 = checked_length as u64;
        let checked_other_length: u64 in Trapping = other_length as u64 in Trapping;
        let last_offset: u64 in Trapping = checked_other_length - 1;
        let exact_last_offset: u64 = last_offset as u64;
        let max_address: u64 = 0xFFFF_FFFF_FFFF_FFFF;
        transition other_start <= max_address - exact_last_offset &&
                   other_virtual_start <= max_address - exact_last_offset {
            true -> audit_overlap(context, bs, handle, stale_retry_used,
                                  map_size, desc_size, key,
                                  best_start, best_pages, length, best_end,
                                  best_offset, audit_offset,
                                  other_start, last_offset)
            _ -> idle()
        }
    }

    // The selected record has now passed the same complete descriptor-geometry
    // validation as every other record; skip only its overlap comparison.
    state audit_overlap(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                        stale_retry_used: u64,
                        map_size: u64 in Trapping,
                        desc_size: u64 in Trapping, key: MapKey,
                        best_start: u64, best_pages: u64, length: u64,
                        best_end: u64 in Trapping,
                        best_offset: u64 in Trapping,
                        audit_offset: u64 in Trapping,
                        other_start: u64, last_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition audit_offset == best_offset {
            true -> audit_step(context, bs, handle, stale_retry_used,
                               map_size, desc_size, key, best_start, best_pages,
                               length, best_end, best_offset, audit_offset)
            _ -> audit_classify(context, bs, handle, stale_retry_used,
                                map_size, desc_size, key,
                                best_start, best_pages, length, best_end,
                                best_offset, audit_offset,
                                other_start, last_offset)
        }
    }

    state audit_classify(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                         stale_retry_used: u64,
                         map_size: u64 in Trapping,
                         desc_size: u64 in Trapping, key: MapKey,
                         best_start: u64, best_pages: u64, length: u64,
                         best_end: u64 in Trapping,
                         best_offset: u64 in Trapping,
                         audit_offset: u64 in Trapping,
                         other_start: u64, last_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        let checked_start: u64 in Trapping = other_start as u64 in Trapping;
        let other_last: u64 in Trapping = checked_start + last_offset;
        transition other_start < best_start {
            true -> audit_left(context, bs, handle, stale_retry_used,
                               map_size, desc_size, key,
                               best_start, best_pages, length, best_end,
                               best_offset, audit_offset, other_last)
            _ -> audit_right(context, bs, handle, stale_retry_used,
                             map_size, desc_size, key,
                             best_start, best_pages, length, best_end,
                             best_offset, audit_offset, other_start)
        }
    }

    state audit_left(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                     stale_retry_used: u64,
                     map_size: u64 in Trapping,
                     desc_size: u64 in Trapping, key: MapKey,
                     best_start: u64, best_pages: u64, length: u64,
                     best_end: u64 in Trapping,
                     best_offset: u64 in Trapping,
                     audit_offset: u64 in Trapping,
                     other_last: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition other_last < best_start {
            true -> audit_step(context, bs, handle, stale_retry_used,
                               map_size, desc_size, key, best_start, best_pages,
                               length, best_end, best_offset, audit_offset)
            _ -> idle()
        }
    }

    state audit_right(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                      stale_retry_used: u64,
                      map_size: u64 in Trapping,
                      desc_size: u64 in Trapping, key: MapKey,
                      best_start: u64, best_pages: u64, length: u64,
                      best_end: u64 in Trapping,
                      best_offset: u64 in Trapping,
                      audit_offset: u64 in Trapping, other_start: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition other_start >= best_end {
            true -> audit_step(context, bs, handle, stale_retry_used,
                               map_size, desc_size, key, best_start, best_pages,
                               length, best_end, best_offset, audit_offset)
            _ -> idle()
        }
    }

    state audit_step(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                     stale_retry_used: u64,
                     map_size: u64 in Trapping,
                     desc_size: u64 in Trapping, key: MapKey,
                     best_start: u64, best_pages: u64, length: u64,
                     best_end: u64 in Trapping,
                     best_offset: u64 in Trapping,
                     audit_offset: u64 in Trapping)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition audit_offset + desc_size + desc_size <= map_size &&
                   audit_offset + desc_size <= 65496 {
            true -> audit_descriptor(context, bs, handle, stale_retry_used,
                                     map_size, desc_size, key,
                                     best_start, best_pages, length, best_end,
                                     best_offset, audit_offset + desc_size)
            _ -> prepare_entry(context, bs, handle, stale_retry_used,
                      key, best_start, best_pages, length)
        }
    }

    // Validate BOTH proposed semantic ranges before the irreversible exit.
    // This value is numeric evidence only: successful firmware completion and
    // surviving-stack/installation custody still establish the actual roots.
    // A stale key discards this preparation with the map it was derived from.
    state prepare_entry(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                        stale_retry_used: u64, key: MapKey,
                        best_start: u64, best_pages: u64, length: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        // The explicit address-model premise proves this captured address
        // fits firmware's 64-bit coordinates; host pointer width is irrelevant.
        let geometry: BootGeometry = BootGeometry {
            image_base: context.image_base as u64,
            image_length: context.image_size,
            storage_base: best_start,
            storage_length: length,
        };
        let checked: BootGeometryCheck = BootGeometry::exclude_image_suffix(
            geometry, context.image_retained_start
        );
        transition checked {
            BootGeometryCheck::Ready { geometry } -> exit(context, bs, handle,
                stale_retry_used, key, best_pages, geometry)
            BootGeometryCheck::Rejected -> idle()
        }
    }

    // Exit boot services against the current key. On success firmware is gone
    // and the map is final. EFI_INVALID_PARAMETER means the key became stale:
    // do not grant, discard the old map-derived candidate, and obtain a new map
    // and key before the one permitted retry. Any other firmware error parks
    // unowned.
    state exit(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
               stale_retry_used: u64, key: MapKey,
               best_pages: u64, geometry: BootGeometry in Separated)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        let exit_status: EfiStatus = BootServices::exit_boot_services(bs, handle, key);
        let exit_code: u64 = exit_status.code;
        transition exit_code == 0 {
            true -> own(context, geometry, best_pages)
            _    -> exit_failed(context, bs, handle, stale_retry_used, exit_code)
        }
    }

    // The first stale key gets the spec-required fresh map/exit pair. A second
    // stale rejection parks: hostile or broken firmware cannot keep Cathedral
    // in an unbounded bootstrap loop, and no rejected transaction can grant.
    state exit_failed(context: &mut Main, bs: &BootServicesTable, handle: EfiHandle,
                      stale_retry_used: u64, exit_code: u64)
    requires addr::Bound == 18446744073709551616 && stale_retry_used <= 1
    {
        transition stale_retry_used == 0 && exit_code == EFI_INVALID_PARAMETER.code {
            true -> refresh_map(context, bs, handle, 1)
            _    -> idle()
        }
    }

    // We own the machine. Construct inert range geometry from the exact
    // validated largest-span values, then cross the admitted owner-authored
    // provider requirement for each root. Reconstructing these fields alone
    // does not grant authority; the selected calls establish their claims.
    state own(context: &mut Main, geometry: BootGeometry in Separated, best_pages: u64)
    requires addr::Bound == 18446744073709551616
    {
        let image_geometry: Extent = Extent {
            base: geometry.image_base as addr,
            length: geometry.image_length,
        };
        let storage_geometry: Extent = Extent {
            base: geometry.storage_base as addr,
            length: geometry.storage_length,
        };
        let image: Extent = ExtentRootProvider::grant(image_geometry);
        let mut storage: Extent in Granted = ExtentRootProvider::grant(storage_geometry);
        let published: bool = BootHandoff::publish(&mut storage, &context.map_buf.bytes,
            context.final_map_size, context.final_descriptor_size,
            context.image_base as u64, context.image_size, context.image_retained_start);
        let roots: KernelRoots = KernelRoots { image: image, initial_storage: storage };
        transition published {
            true -> serial_init(roots, best_pages as u64 in Trapping)
            _ -> retain_roots(roots)
        }
    }

    state retain_roots(roots: KernelRoots) {
        asm { hlt }
        transition { _ -> retain_roots(roots) }
    }

    // --- MILESTONE 3: the serial report ------------------------------------
    //
    // Program COM1 ourselves — firmware is gone, this is OUR hardware now.
    // Register map = drivers/facts/uart_16550 (COM1 base 0x3F8 = 1016):
    // +1 IER (1017), +2 FCR (1018), +3 LCR (1019), +4 MCR (1020),
    // +5 LSR (1021). 115200 8N1, FIFOs enabled (16-byte) + cleared.
    state serial_init(roots: KernelRoots, best_pages: u64 in Trapping) {
        asm { out 1019, 128 }   // LCR: DLAB on — divisor latch reachable
        asm { out 1016, 1 }     // divisor low  = 1 -> 115200 baud
        asm { out 1017, 0 }     // divisor high = 0
        asm { out 1019, 3 }     // LCR: 8N1, DLAB off
        asm { out 1018, 7 }     // FCR: enable + clear both FIFOs
        asm { out 1020, 11 }    // MCR: DTR | RTS | OUT2
        transition { _ -> to_mib(roots, best_pages, 0) }
    }

    // Pages -> MiB by repeated subtraction (256 pages = 1 MiB; the runtime
    // lowering has no division yet). Stop at 100000 MiB because every larger
    // value shares the honest `99999+ MiB` report. The conversion therefore
    // takes at most 100000 rounds regardless of a hostile-but-valid span size.
    state to_mib(roots: KernelRoots,
                 pages: u64 in Trapping, mib: u64 in Trapping) {
        transition pages >= 256 && mib < 100000 {
            true -> to_mib(roots, pages - 256, mib + 1)
            _    -> owned_wait(roots, mib, MAX_UART_STATUS_POLLS)
        }
    }

    // The report writes in FIFO-SIZED BURSTS: one Line Status Register poll
    // (bit 5 = transmitter empty — with FIFOs on, the whole FIFO has drained),
    // then at most 16 data bytes. Burst 1 = "Owned " (6 bytes); burst 2 = the
    // decimal digits + " MiB\r\n" (<= 11 bytes). That is the 16550's real
    // hardware handshake — no firmware ever polls for us again. Each wait has
    // a finite status-read budget; an absent or wedged UART skips reporting
    // and enters the kernel without writing into a busy transmitter.
    state owned_wait(roots: KernelRoots, mib: u64 in Trapping,
                     remaining_polls: u64 in Trapping) {
        let mut lsr: u8 = 0;
        asm { in lsr, 1021 }
        transition (lsr & 32) == 0 {
            true -> owned_wait_busy(roots, mib, remaining_polls)
            _    -> owned_send(roots, mib)
        }
    }
    state owned_wait_busy(roots: KernelRoots, mib: u64 in Trapping,
                          remaining_polls: u64 in Trapping) {
        transition remaining_polls > 1 {
            true -> owned_wait(roots, mib, remaining_polls - 1)
            _    -> enter_kernel(roots)
        }
    }
    state owned_send(roots: KernelRoots, mib: u64 in Trapping) {
        asm { out 1016, 79 }    // 'O'
        asm { out 1016, 119 }   // 'w'
        asm { out 1016, 110 }   // 'n'
        asm { out 1016, 101 }   // 'e'
        asm { out 1016, 100 }   // 'd'
        asm { out 1016, 32 }    // ' '
        transition { _ -> digits_wait(roots, mib, MAX_UART_STATUS_POLLS) }
    }

    state digits_wait(roots: KernelRoots, mib: u64 in Trapping,
                      remaining_polls: u64 in Trapping) {
        let mut lsr: u8 = 0;
        asm { in lsr, 1021 }
        transition (lsr & 32) == 0 {
            true -> digits_wait_busy(roots, mib, remaining_polls)
            _    -> report_size(roots, mib)
        }
    }
    state digits_wait_busy(roots: KernelRoots, mib: u64 in Trapping,
                           remaining_polls: u64 in Trapping) {
        transition remaining_polls > 1 {
            true -> digits_wait(roots, mib, remaining_polls - 1)
            _    -> enter_kernel(roots)
        }
    }

    // Five digits plus the tail fit in one 16-byte FIFO burst. Larger roots
    // take an explicit lower-bound route instead of wrapping `48 + count` into
    // a non-digit byte.
    state report_size(roots: KernelRoots, mib: u64 in Trapping) {
        transition mib <= 99999 {
            true -> ten_thousands(roots, mib, 0)
            _ -> oversized_mib(roots)
        }
    }

    state oversized_mib(roots: KernelRoots) {
        asm { out 1016, 57 }    // '9'
        asm { out 1016, 57 }    // '9'
        asm { out 1016, 57 }    // '9'
        asm { out 1016, 57 }    // '9'
        asm { out 1016, 57 }    // '9'
        asm { out 1016, 43 }    // '+'
        transition { _ -> tail_send(roots) }
    }

    // Decimal by PLACE SUBTRACTION, most-significant first: each place counts
    // how many times it fits, emits its digit, forwards the remainder.
    // `printed` suppresses leading zeros; the ones place always prints. This
    // route receives only values that fit its five decimal places.
    state ten_thousands(roots: KernelRoots,
                        rest: u64 in Trapping, count: u64 in Trapping)
    requires count <= 9 && embed(rest) + embed(count) * 10000 <= 99999
    {
        transition rest >= 10000 {
            true -> ten_thousands(roots, rest - 10000, count + 1)
            _    -> ten_thousands_emit(roots, rest, count)
        }
    }
    state ten_thousands_emit(roots: KernelRoots,
                             rest: u64 in Trapping, count: u64 in Trapping) {
        transition count == 0 {
            true -> thousands(roots, rest, 0, 0)
            _    -> ten_thousands_digit(roots, rest, 48 + count)
        }
    }
    state ten_thousands_digit(roots: KernelRoots,
                              rest: u64 in Trapping, digit: u64 in Trapping)
    requires 48 <= digit && digit <= 57
    {
        let byte: u8 = digit as u8;
        asm { out 1016, byte }
        transition { _ -> thousands(roots, rest, 0, 1) }
    }

    state thousands(roots: KernelRoots, rest: u64 in Trapping,
                    count: u64 in Trapping, printed: u64)
    requires count <= 9 && embed(rest) + embed(count) * 1000 <= 9999
    {
        transition rest >= 1000 {
            true -> thousands(roots, rest - 1000, count + 1, printed)
            _    -> thousands_emit(roots, rest, count, printed)
        }
    }
    state thousands_emit(roots: KernelRoots, rest: u64 in Trapping,
                         count: u64 in Trapping, printed: u64) {
        transition count == 0 && printed == 0 {
            true -> hundreds(roots, rest, 0, 0)
            _    -> thousands_digit(roots, rest, 48 + count)
        }
    }
    state thousands_digit(roots: KernelRoots,
                          rest: u64 in Trapping, digit: u64 in Trapping)
    requires 48 <= digit && digit <= 57
    {
        let byte: u8 = digit as u8;
        asm { out 1016, byte }
        transition { _ -> hundreds(roots, rest, 0, 1) }
    }

    state hundreds(roots: KernelRoots, rest: u64 in Trapping,
                   count: u64 in Trapping, printed: u64)
    requires count <= 9 && embed(rest) + embed(count) * 100 <= 999
    {
        transition rest >= 100 {
            true -> hundreds(roots, rest - 100, count + 1, printed)
            _    -> hundreds_emit(roots, rest, count, printed)
        }
    }
    state hundreds_emit(roots: KernelRoots, rest: u64 in Trapping,
                        count: u64 in Trapping, printed: u64) {
        transition count == 0 && printed == 0 {
            true -> tens(roots, rest, 0, 0)
            _    -> hundreds_digit(roots, rest, 48 + count)
        }
    }
    state hundreds_digit(roots: KernelRoots,
                         rest: u64 in Trapping, digit: u64 in Trapping)
    requires 48 <= digit && digit <= 57
    {
        let byte: u8 = digit as u8;
        asm { out 1016, byte }
        transition { _ -> tens(roots, rest, 0, 1) }
    }

    state tens(roots: KernelRoots, rest: u64 in Trapping,
               count: u64 in Trapping, printed: u64)
    requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
    {
        transition rest >= 10 {
            true -> tens(roots, rest - 10, count + 1, printed)
            _    -> tens_emit(roots, rest, count, printed)
        }
    }
    state tens_emit(roots: KernelRoots, rest: u64 in Trapping,
                    count: u64 in Trapping, printed: u64) {
        transition count == 0 && printed == 0 {
            true -> ones_digit(roots, 48 + rest)
            _    -> tens_digit(roots, rest, 48 + count)
        }
    }
    state tens_digit(roots: KernelRoots,
                     rest: u64 in Trapping, digit: u64 in Trapping)
    requires 48 <= digit && digit <= 57
    {
        let byte: u8 = digit as u8;
        asm { out 1016, byte }
        transition { _ -> ones_digit(roots, 48 + rest) }
    }

    // The ones place always prints — "Owned 0 MiB" is an honest report of a
    // machine with no conventional span, never an empty number.
    state ones_digit(roots: KernelRoots, digit: u64 in Trapping)
    requires 48 <= digit && digit <= 57
    {
        let byte: u8 = digit as u8;
        asm { out 1016, byte }
        transition { _ -> tail_send(roots) }
    }

    state tail_send(roots: KernelRoots) {
        asm { out 1016, 32 }    // ' '
        asm { out 1016, 77 }    // 'M'
        asm { out 1016, 105 }   // 'i'
        asm { out 1016, 66 }    // 'B'
        asm { out 1016, 13 }    // CR
        asm { out 1016, 10 }    // LF
        transition { _ -> enter_kernel(roots) }
    }

    // Failure park. This route owns no Extent and remains inside firmware after
    // an unrecoverable map or exit error. `asm { hlt }` avoids an unbounded busy
    // loop; the self-re-entry re-halts after any wake. `hlt` is a known-contract
    // asm intrinsic reaching `MachineControl`, discharged by the freestanding
    // boot boundary.
    state idle() {
        asm { hlt }
        transition { _ -> idle() }
    }

    // The selected bridge consumes the existing claims. Build alone chooses
    // the destination; this source does not hardcode a kernel implementation.
    state enter_kernel(roots: KernelRoots) {
        let { image, initial_storage } = roots;
        ProgramStorageEntry::enter(image, initial_storage);
    }
}

// --- What this pressures in Omega (the M2/M3 ladder) ------------------------
//
// Milestone 2 exercises the M1 machinery in new shapes (Omega TASKS.md
// "Cathedral milestone-2 ladder"):
//   1. &mut params through a table-function call — get_memory_map takes five
//      out-params; the MS-x64 lowering passes their addresses.
//   2. TABLE-FUNCTION dispatch (extern §12.1 addendum) — BootServices is a
//      struct of fn-ptr fields; get_memory_map / exit_boot_services dispatch
//      through their FIELDS at plan offsets, and the table pointer stays OFF
//      the wire (EFI table services take no This — protocol methods like
//      output_string do, and stay This-call `VtableField` bindings).
//   3. Recast at a runtime offset — `&context.map_buf.bytes[offset] as &EfiMemoryDescriptor`
//      is the §5b borrow-recast, indexed by a runtime `offset` with a runtime
//      `desc_size` stride, bounds-guarded on the transitions.
//   4. A large static buffer field ([u8; 65536]) with a smaller runtime capacity
//      window in a data value.
//   5. Captured boundary-call results (`let status = ...`) — the result place
//      rides the call's operand list and stores through the import-call tail.
//   6. Owner-authorized bodyless authority — the build admits the selected
//      ExtentRootProvider plan, then state-local constrained parameters carry
//      its one linear `Granted` root without making it an entry prerequisite.
//
// Milestone 3 adds the privileged asm intrinsics (hlt / out / in — the
// privileged_effects_and_binary_trust brief) and drives the 16550 with them:
// LSR polling, FIFO-sized bursts, decimal by place subtraction (the runtime
// lowering has no division yet — a follow-on).
