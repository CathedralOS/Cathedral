// source/boot/uefi/own_machine.omg
//
// MILESTONE 2 — own the machine. Get the firmware memory map, walk it for free
// RAM, ExitBootServices, and obtain the FIRST qualified Extent from the largest
// free span — the origin of Cathedral's authority graph. Runs after the
// milestone-1 greeting (con_out still works before exit).
//
// MILESTONE 3 — the first driver speaks. After the grant, the 16550 UART (COM1)
// we now drive DIRECTLY — no firmware, no protocol — reports "Owned N MiB",
// then the core parks on `hlt`. Reaching the report is itself the proof of the
// M2 chain: the machine only arrives there after a successful map walk, a
// successful ExitBootServices, and the admitted grant.

use uefi::uefi;            // EfiHandle, EfiSystemTable, EfiStatus
use uefi::boot_services;   // EfiMemoryDescriptor, EFI_CONVENTIONAL_MEMORY, MapKey, BootServicesTable
use core::extent;          // PAGE_SIZE + checked ExtentRootProvider adapter
use omega::language::core::assembly; // PortIo, MachineControl
use omega::language::core::extent;   // Extent, Granted, ExtentRootProvider

// Get the map, walk it, exit, grant, report. `self.map_buf` is a fixed 16 KiB
// static field (no allocator yet — real firmware maps are ~4–8 KiB); the
// too-small retry loop is a follow-on.
machine Main::own_machine(&self, handle: EfiHandle, table: &EfiSystemTable)
reaches BootServices + ExtentRootProvider + PortIo + MachineControl
{
    let bs: &BootServicesTable = table.boot_services;          // transitive vouch, like con_out

    let mut map_size: u64 = 16384;               // in = buffer capacity, out = actual bytes
    let mut key: MapKey = MapKey { raw: 0 };
    let mut desc_size: u64 = 0;                   // out = the RUNTIME descriptor stride
    let mut desc_version: u32 = 0;
    let status: EfiStatus = self.boot_svc.get_memory_map(bs, &mut map_size, &mut self.map_buf,
                                                         &mut key, &mut desc_size, &mut desc_version);
    let status_code: u64 = status.code;

    // Sanity-gate the firmware's out-values BEFORE trusting them: the call must
    // report SUCCESS (on EFI_BUFFER_TOO_SMALL map_size comes back as the NEEDED
    // size, > capacity), a zero/short stride would walk garbage, and a stride
    // wider than the map is nonsense. A guard — not a vouched `ensures` —
    // because firmware genuinely can return these; the conjuncts are ALSO the
    // bound witnesses the walk's recast footprint discharges from (per-edge
    // meet: this entry edge proves them, the loop edge forwards them), spelled
    // INLINE on the transition because the prover matches guard conjuncts by
    // display.
    transition status_code == 0 && map_size <= 16384 && desc_size >= 40 && desc_size <= 16384 {
        true -> walk(bs, handle, map_size, desc_size, key, 0, 0, 0)
        _    -> idle()   // nonsense map; the too-small retry loop is a follow-on
    }

    // Walk descriptors: stride by the RUNTIME desc_size (never sizeof), recast
    // each slice to &EfiMemoryDescriptor, track the largest conventional-memory
    // span. Split walk/step so each transition carries ONE inline guard: walk
    // decides the best-span update, step decides whether a WHOLE next
    // descriptor fits — bounding its END (`offset + 2*desc_size <= map_size`),
    // not just its start, which is what makes the loop edge's footprint
    // discharge (and is semantically free: EDK2 maps are whole descriptors).
    // The recast offset's bound discharges through the PER-EDGE MEET over the
    // guard route: the entry edge passes the constant 0, the loop edge's
    // argument `offset + desc_size` carries the literal guard bound <= 16344
    // (= 16384 buffer - 40 descriptor footprint). `in Trapping` on the walk
    // arithmetic: hostile out-values trip a trap instead of wrapping.
    state walk(bs: &BootServicesTable, handle: EfiHandle,
               map_size: u64 in Trapping, desc_size: u64 in Trapping, key: MapKey,
               offset: u64 in Trapping, best_start: u64, best_pages: u64) {
        let d: &EfiMemoryDescriptor = &self.map_buf[offset] as &EfiMemoryDescriptor;
        let is_free: bool = d.kind == EFI_CONVENTIONAL_MEMORY;
        transition is_free && d.number_of_pages > best_pages {
            true -> step(bs, handle, map_size, desc_size, key,
                         offset, d.physical_start, d.number_of_pages)
            _    -> step(bs, handle, map_size, desc_size, key,
                         offset, best_start, best_pages)
        }
    }

    state step(bs: &BootServicesTable, handle: EfiHandle,
               map_size: u64 in Trapping, desc_size: u64 in Trapping, key: MapKey,
               offset: u64 in Trapping, best_start: u64, best_pages: u64) {
        // The second conjunct is implied by the first (map_size <= 16384,
        // desc_size >= 40) but spelled out so the loop edge's bound is a
        // DIRECT guard fact for the prover; it costs one always-true compare.
        transition offset + desc_size + desc_size <= map_size && offset + desc_size <= 16344 {
            true -> walk(bs, handle, map_size, desc_size, key,
                         offset + desc_size, best_start, best_pages)
            _    -> exit(bs, handle, key, best_start, best_pages)
        }
    }

    // Exit boot services against the current key. On success firmware is gone
    // and the map is final; on failure (stale key) do NOT grant — the machine is
    // not ours. (StaleMap retry = follow-on; the common case succeeds first try
    // when nothing allocates between GetMemoryMap and here.)
    state exit(bs: &BootServicesTable, handle: EfiHandle, key: MapKey, best_start: u64, best_pages: u64) {
        let exit_status: EfiStatus = self.boot_svc.exit_boot_services(bs, handle, key);
        let exit_code: u64 = exit_status.code;
        transition exit_code == 0 {
            true -> own(best_start, best_pages)
            _    -> idle()
        }
    }

    // We own the machine. Construct inert range geometry from the largest free
    // span, then cross the admitted owner-authored provider requirement.
    // Reconstructing these fields alone does not grant authority; exactly this
    // selected trait-slot call establishes the first qualified root.
    state own(best_start: u64, best_pages: u64) {
        let checked_pages: u64 in Trapping = best_pages as u64 in Trapping;
        let length: u64 in Trapping = checked_pages * PAGE_SIZE;
        let base: addr = best_start as addr;
        let geometry: Extent = Extent { base: base, length: length };
        let first_extent: Extent = self.memory.grant(geometry);
        transition { _ -> serial_init(first_extent, best_pages) }
    }

    // --- MILESTONE 3: the serial report ------------------------------------
    //
    // Program COM1 ourselves — firmware is gone, this is OUR hardware now.
    // Register map = drivers/facts/uart_16550 (COM1 base 0x3F8 = 1016):
    // +1 IER (1017), +2 FCR (1018), +3 LCR (1019), +4 MCR (1020),
    // +5 LSR (1021). 115200 8N1, FIFOs enabled (16-byte) + cleared.
    state serial_init(extent: Extent in Granted, best_pages: u64 in Trapping) {
        asm { out 1019, 128 }   // LCR: DLAB on — divisor latch reachable
        asm { out 1016, 1 }     // divisor low  = 1 -> 115200 baud
        asm { out 1017, 0 }     // divisor high = 0
        asm { out 1019, 3 }     // LCR: 8N1, DLAB off
        asm { out 1018, 7 }     // FCR: enable + clear both FIFOs
        asm { out 1020, 11 }    // MCR: DTR | RTS | OUT2
        transition { _ -> to_mib(extent, best_pages, 0) }
    }

    // Pages -> MiB by repeated subtraction (256 pages = 1 MiB; the runtime
    // lowering has no division yet). Bounded by the span size: ~4096 rounds
    // for a 4 GiB span.
    state to_mib(extent: Extent in Granted,
                 pages: u64 in Trapping, mib: u64 in Trapping) {
        transition pages >= 256 {
            true -> to_mib(extent, pages - 256, mib + 1)
            _    -> owned_wait(extent, mib)
        }
    }

    // The report writes in FIFO-SIZED BURSTS: one Line Status Register poll
    // (bit 5 = transmitter empty — with FIFOs on, the whole FIFO has drained),
    // then at most 16 data bytes. Burst 1 = "Owned " (6 bytes); burst 2 = the
    // decimal digits + " MiB\r\n" (<= 11 bytes). That is the 16550's real
    // hardware handshake — no firmware ever polls for us again.
    state owned_wait(extent: Extent in Granted, mib: u64 in Trapping) {
        let mut lsr: u8 = 0;
        asm { in lsr, 1021 }
        transition (lsr & 32) == 0 {
            true -> owned_wait(extent, mib)     // transmitter busy: keep polling
            _    -> owned_send(extent, mib)
        }
    }
    state owned_send(extent: Extent in Granted, mib: u64 in Trapping) {
        asm { out 1016, 79 }    // 'O'
        asm { out 1016, 119 }   // 'w'
        asm { out 1016, 110 }   // 'n'
        asm { out 1016, 101 }   // 'e'
        asm { out 1016, 100 }   // 'd'
        asm { out 1016, 32 }    // ' '
        transition { _ -> digits_wait(extent, mib) }
    }

    state digits_wait(extent: Extent in Granted, mib: u64 in Trapping) {
        let mut lsr: u8 = 0;
        asm { in lsr, 1021 }
        transition (lsr & 32) == 0 {
            true -> digits_wait(extent, mib)
            _    -> ten_thousands(extent, mib, 0)
        }
    }

    // Decimal by PLACE SUBTRACTION, most-significant first: each place counts
    // how many times it fits, emits its digit, forwards the remainder.
    // `printed` suppresses leading zeros; the ones place always prints. Caps
    // at 5 digits (99999 MiB ≈ 97 GiB) — wider machines are a follow-on.
    state ten_thousands(extent: Extent in Granted,
                        rest: u64 in Trapping, count: u64 in Trapping) {
        transition rest >= 10000 {
            true -> ten_thousands(extent, rest - 10000, count + 1)
            _    -> ten_thousands_emit(extent, rest, count)
        }
    }
    state ten_thousands_emit(extent: Extent in Granted,
                             rest: u64 in Trapping, count: u64 in Trapping) {
        transition count == 0 {
            true -> thousands(extent, rest, 0, 0)
            _    -> ten_thousands_digit(extent, rest, 48 + count)
        }
    }
    state ten_thousands_digit(extent: Extent in Granted,
                              rest: u64 in Trapping, digit: u64) {
        let byte: u8 = digit as u8 in Wrapping;
        asm { out 1016, byte }
        transition { _ -> thousands(extent, rest, 0, 1) }
    }

    state thousands(extent: Extent in Granted, rest: u64 in Trapping,
                    count: u64 in Trapping, printed: u64) {
        transition rest >= 1000 {
            true -> thousands(extent, rest - 1000, count + 1, printed)
            _    -> thousands_emit(extent, rest, count, printed)
        }
    }
    state thousands_emit(extent: Extent in Granted, rest: u64 in Trapping,
                         count: u64 in Trapping, printed: u64) {
        transition count == 0 && printed == 0 {
            true -> hundreds(extent, rest, 0, 0)
            _    -> thousands_digit(extent, rest, 48 + count)
        }
    }
    state thousands_digit(extent: Extent in Granted,
                          rest: u64 in Trapping, digit: u64) {
        let byte: u8 = digit as u8 in Wrapping;
        asm { out 1016, byte }
        transition { _ -> hundreds(extent, rest, 0, 1) }
    }

    state hundreds(extent: Extent in Granted, rest: u64 in Trapping,
                   count: u64 in Trapping, printed: u64) {
        transition rest >= 100 {
            true -> hundreds(extent, rest - 100, count + 1, printed)
            _    -> hundreds_emit(extent, rest, count, printed)
        }
    }
    state hundreds_emit(extent: Extent in Granted, rest: u64 in Trapping,
                        count: u64 in Trapping, printed: u64) {
        transition count == 0 && printed == 0 {
            true -> tens(extent, rest, 0, 0)
            _    -> hundreds_digit(extent, rest, 48 + count)
        }
    }
    state hundreds_digit(extent: Extent in Granted,
                         rest: u64 in Trapping, digit: u64) {
        let byte: u8 = digit as u8 in Wrapping;
        asm { out 1016, byte }
        transition { _ -> tens(extent, rest, 0, 1) }
    }

    state tens(extent: Extent in Granted, rest: u64 in Trapping,
               count: u64 in Trapping, printed: u64) {
        transition rest >= 10 {
            true -> tens(extent, rest - 10, count + 1, printed)
            _    -> tens_emit(extent, rest, count, printed)
        }
    }
    state tens_emit(extent: Extent in Granted, rest: u64 in Trapping,
                    count: u64 in Trapping, printed: u64) {
        transition count == 0 && printed == 0 {
            true -> ones_digit(extent, 48 + rest)
            _    -> tens_digit(extent, rest, 48 + count)
        }
    }
    state tens_digit(extent: Extent in Granted,
                     rest: u64 in Trapping, digit: u64) {
        let byte: u8 = digit as u8 in Wrapping;
        asm { out 1016, byte }
        transition { _ -> ones_digit(extent, 48 + rest) }
    }

    // The ones place always prints — "Owned 0 MiB" is an honest report of a
    // machine with no conventional span, never an empty number.
    state ones_digit(extent: Extent in Granted, digit: u64) {
        let byte: u8 = digit as u8 in Wrapping;
        asm { out 1016, byte }
        transition { _ -> tail_send(extent) }
    }

    state tail_send(extent: Extent in Granted) {
        asm { out 1016, 32 }    // ' '
        asm { out 1016, 77 }    // 'M'
        asm { out 1016, 105 }   // 'i'
        asm { out 1016, 66 }    // 'B'
        asm { out 1016, 13 }    // CR
        asm { out 1016, 10 }    // LF
        transition { _ -> owned_idle(extent) }
    }

    // Failure park. This route owns no Extent and may still be inside firmware
    // after a bad map or stale key. `asm { hlt }` avoids an unbounded busy loop;
    // the self-re-entry re-halts after any wake. `hlt` is a known-contract asm
    // intrinsic reaching `MachineControl`, discharged by the freestanding boot
    // boundary.
    state idle() {
        asm { hlt }
        transition { _ -> idle() }
    }

    // The first qualified root remains live for the owned machine's lifetime.
    // This is the no-split/no-merge M2 endpoint: one admitted root enters this
    // state and each wake transfers the same claim into the next iteration.
    state owned_idle(extent: Extent in Granted) {
        asm { hlt }
        transition { _ -> owned_idle(extent) }
    }
}

// --- What this pressures in Omega (the M2/M3 ladder) ------------------------
//
// Milestone 2 exercises the M1 machinery in new shapes (Omega TASKS.md
// "Cathedral milestone-2 ladder"):
//   1. &mut params through a table-function call — get_memory_map takes five
//      out-params; the MS-x64 lowering passes their addresses.
//   2. TABLE-FUNCTION dispatch (extern §12.1 addendum) — BootServices is a
//      struct of fn-ptr fields; get_memory_map / exit_boot_services dispatch
//      through their FIELDS at plan offsets, and the table pointer stays OFF
//      the wire (EFI table services take no This — protocol methods like
//      output_string do, and stay This-call `VtableField` bindings).
//   3. Recast at a runtime offset — `&self.map_buf[offset] as &EfiMemoryDescriptor`
//      is the §5b borrow-recast, indexed by a runtime `offset` with a runtime
//      `desc_size` stride, bounds-guarded on the transitions.
//   4. A larger static buffer field ([u8; 16384]) in a data value.
//   5. Captured boundary-call results (`let status = ...`) — the result place
//      rides the call's operand list and stores through the import-call tail.
//   6. Owner-authorized bodyless authority — the build admits the selected
//      ExtentRootProvider plan, then state-local constrained parameters carry
//      its one linear `Granted` root without making it an entry prerequisite.
//
// Milestone 3 adds the privileged asm intrinsics (hlt / out / in — the
// privileged_effects_and_binary_trust brief) and drives the 16550 with them:
// LSR polling, FIFO-sized bursts, decimal by place subtraction (the runtime
// lowering has no division yet — a follow-on).
