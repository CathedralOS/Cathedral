// source/boot/uefi/build.omg
//
// Milestone-1 UEFI boot application. BOOT-VERIFIED shape (aligned to the Omega
// sample samples/uefi_hello, ea51376cd, 2026-07-04). There is NO target block:
// `subsystem` and `freestanding` are orthogonal `Build` fields (the target block
// was retired — Omega build_and_package_model.md addendum). The EFI/MS-x64
// calling plan is INFERRED from the subsystem; `boundary(<Plan>)` would override
// it (calling_plans.md §7).

machine build(b: &mut Build) {
    // Reach: bind the local alias `uefi` to the boot hand-off ABI. main.omg may
    // name `uefi` and nothing else.
    b.depend("uefi", path("../../contracts/uefi"));   // hash-pinned once the store exists

    b.subsystem    = Subsystem::EfiApplication;   // import-free PE32+ firmware loads directly
    b.freestanding = true;                         // empty host-provider set (no host runtime)
}
