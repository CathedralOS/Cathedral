// source/boot/uefi/build.omg
//
// The UEFI boot application. BOOT-VERIFIED shape (typed tree, 2026-07-11).
// `target uefi_x64 {}` is the FRONTIER REGISTRATION (D15: a deployment target
// name is valid iff compiler-defined or build-defined) — an empty declaration,
// NOT the retired target{...} config block; `subsystem` and `freestanding`
// remain orthogonal `Build` fields (build_and_package_model.md addendum).
// `UefiApplication` now inherits the stable core ProgramStorageEntry
// requirement. Build entry-schema selection and the generated stub/geometry
// bridge are still compiler engineering; the current exported Main::run keeps
// the already-booted EFI/MS-x64 firmware ABI until that bridge is connected.

target uefi_x64 {
}

machine build(b: &mut Build) {
    // Reach: the boot hand-off ABI + the kernel's checked Extent provider.
    // The boot package may name `uefi` and `core` and nothing else.
    b.depend("uefi", path("../../contracts/uefi"));   // hash-pinned once the store exists
    b.depend("core", path("../../core"));              // shared Extent provider (milestone 2)
    b.accept_boundary<ExtentRootProvider>();           // exact selected root-provider receipt
    b.select_provider<ExtentRootProvider, CathedralExtentRootProvider>();

    b.subsystem    = Subsystem::EfiApplication;   // import-free PE32+ firmware loads directly
    b.freestanding = true;                         // empty host-provider set (no host runtime)
}
