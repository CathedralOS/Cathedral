// Pinned baud variant identities preserved separately from Config integer storage.
module baud;
pub data BaudRate [copy] {
    case Baud115200;
    case Baud57600;
    case Baud38400;
    case Baud9600;
    case Baud4800;
    case Baud2400;
    case Baud1200;
    case Baud600;
    case Baud300;
    case Baud150;
    case Baud110;
    case Custom(value: u32);
}
pub machine baud_to_integer(value: BaudRate) -> u32 {
    transition value {
        BaudRate::Baud115200 -> (115200)
        BaudRate::Baud57600 -> (57600)
        BaudRate::Baud38400 -> (38400)
        BaudRate::Baud9600 -> (9600)
        BaudRate::Baud4800 -> (4800)
        BaudRate::Baud2400 -> (2400)
        BaudRate::Baud1200 -> (1200)
        BaudRate::Baud600 -> (600)
        BaudRate::Baud300 -> (300)
        BaudRate::Baud150 -> (150)
        BaudRate::Baud110 -> (110)
        BaudRate::Custom { value } -> (value)
    }
}
pub machine baud_from_integer(value: u32) -> BaudRate {
    transition value {
        115200 -> (BaudRate::Baud115200)
        57600 -> (BaudRate::Baud57600)
        38400 -> (BaudRate::Baud38400)
        9600 -> (BaudRate::Baud9600)
        4800 -> (BaudRate::Baud4800)
        2400 -> (BaudRate::Baud2400)
        1200 -> (BaudRate::Baud1200)
        600 -> (BaudRate::Baud600)
        300 -> (BaudRate::Baud300)
        150 -> (BaudRate::Baud150)
        110 -> (BaudRate::Baud110)
        _ -> (BaudRate::Custom { value: value })
    }
}
