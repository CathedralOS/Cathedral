{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cathedral: Build & Run in QEMU",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "python tools/boot-harness-rs/run.py --release --window --fresh"
    },
    {
      "name": "Cathedral: Resume Saved Lab in QEMU",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "python tools/boot-harness-rs/run.py --release --window"
    },
    {
      "name": "Cathedral (Omega): Build & Boot in QEMU",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "python tools/boot-harness/run.py",
      "osx": {
        "command": "python3 tools/boot-harness/run.py"
      },
      "linux": {
        "command": "python3 tools/boot-harness/run.py"
      }
    }
  ]
}
